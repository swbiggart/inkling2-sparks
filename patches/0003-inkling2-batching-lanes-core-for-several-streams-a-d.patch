+    fn backendIdle(h: *LaneHost) bool {
+        const vt = h.core.backend.vtable;
+        const has = vt.idle_pending orelse return false;
+        const work = vt.idle orelse return false;
+        if (h.queued.items.len > 0 or h.admitted.items.len > 0 or h.cancels.items.len > 0 or h.closing) return false;
