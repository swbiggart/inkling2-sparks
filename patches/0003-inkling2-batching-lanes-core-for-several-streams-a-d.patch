+    var out: [U]f32 = undefined;
+    // allowed: 3, 40, 69, and bits past the row (70 .. 95, ids with no logits) that change nothing
+    var mask = [_]u32{ 1 << 3, 1 << 8, (1 << 5) | 0xffff_ffc0 };
