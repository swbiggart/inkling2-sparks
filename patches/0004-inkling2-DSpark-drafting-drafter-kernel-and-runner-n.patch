+        try c.zero(dr.state, S * mrank * 2);
+        {
+            var head_ids: [most_streams * block]i32 = @splat(0);
+            for (items, 0..) |it, s| head_ids[s * block] = @intCast(it.anchor);
+            try cuda.copy_source.enqueue(dr.d, dr.walk, std.mem.sliceAsBytes(head_ids[0 .. S * block]), c.stream);
+        }
+        const pair_ys: usize = pick_stride; // a stream's pair within a rank's
+        const rank_pairs: usize = S * pick_stride; // a rank's pairs
+        for (0..drafts) |s| {
+            {
+                var a: cuda.Args = .{};
+                a.add(dr.inv + s * 3 * mrank * 4);
+                a.add(dr.rnn_b);
+                a.add(dr.rnn_w);
+                a.add(@as(i64, 2 * mrank + 2 * H));
+                a.add(dr.w1);
+                a.add(dr.walk);
+                a.add(@as(i32, @intCast(s)));
+                a.add(dr.state);
+                a.add(dr.latent);
+                a.add(@as(i64, drafts * 3 * mrank));
+                try dr.launch(c, dr.k.mstep, .{ 1, S, 1 }, 3 * mrank, &a);
+            }
+            {
+                var a: cuda.Args = .{};
+                a.add(dr.base + s * dr.vn * 2);
+                a.add(dr.latent);
+                a.add(dr.fold_w);
+                a.add(dr.fold_b);
+                a.add(@as(i32, @intCast(dr.vn)));
+                a.add(@as(i32, @intCast(dr.valid)));
+                a.add(cap);
+                a.add(dr.best_v);
+                a.add(dr.best_i);
+                a.add(@as(i64, @intCast(drafts * dr.vn)));
+                try dr.launch(c, dr.k.mlogits, .{ logit_blocks, S, 1 }, 256, &a);
+            }
+            const mine = dr.pairs + @as(u64, dr.rank) * rank_pairs;
+            {
+                var a: cuda.Args = .{};
+                a.add(dr.best_v);
+                a.add(dr.best_i);
+                a.add(@as(i32, logit_blocks));
+                a.add(@as(i32, @intCast(dr.vlo)));
+                a.add(mine);
+                a.add(if (dr.world > 1) @as(u64, 0) else dr.walk);
+                a.add(@as(i32, @intCast(s)));
+                a.add(@as(i32, @intCast(pair_ys)));
+                try dr.launch(c, dr.k.mpick, .{ 1, S, 1 }, 32, &a);
+            }
+            if (dr.world > 1) {
+                if (dr.group) |g| try g.allGather(c.stream, mine, dr.pairs, rank_pairs);
+                var a: cuda.Args = .{};
+                a.add(dr.pairs);
+                a.add(@as(i32, @intCast(dr.world)));
+                a.add(@as(i32, @intCast(rank_pairs)));
+                a.add(dr.walk);
+                a.add(@as(i32, @intCast(s)));
+                a.add(@as(i32, @intCast(pair_ys)));
+                try dr.launch(c, dr.k.mmerge, .{ 1, S, 1 }, 32, &a);
+            }
+        }
+    }
+
+    /// The last draft's 7 tokens (synchronizes the stream).
+    pub fn proposals(dr: *const Drafter, c: *const Ctx, out: *[drafts]u32) !void {
+        return dr.proposalsMany(c, &.{out});
+    }
+
+    /// The last `draftMany`'s 7 tokens of each of its streams, in its order (synchronizes the stream).
+    pub fn proposalsMany(dr: *const Drafter, c: *const Ctx, out: []const *[drafts]u32) !void {
+        if (out.len == 0 or out.len > most_streams) return error.DraftStreams;
+        try c.stream.synchronize();
+        var got: [most_streams * block]i32 = undefined;
+        try cuda.memory.download(dr.d, dr.walk, std.mem.sliceAsBytes(got[0 .. out.len * block]));
+        for (out, 0..) |o, s| for (o, got[s * block + 1 ..][0..drafts]) |*t, g| {
+            t.* = @intCast(g);
+        };
+    }
+};
+
+/// rows [n] of x (ld elements) . w[v]^T for v < vn: out bf16 [n][vn] (cuda_head's row-invariant unembed kernel).
+fn unembedRows(c: *const Ctx, x: u64, ld: usize, w: u64, vn: usize, out: u64, n: usize) !void {
+    const tiles = [_]usize{ 1, 4, 16, 32 };
+    const i: usize = if (n == 1) 0 else if (n <= 4) 1 else if (n <= 16) 2 else 3;
+    var a: cuda.Args = .{};
+    a.add(x);
+    a.add(@as(i64, @intCast(ld)));
+    a.add(w);
+    a.add(out);
+    a.add(@as(i64, @intCast(vn)));
+    a.add(@as(i32, @intCast(n)));
+    a.add(@as(i32, @intCast(vn)));
+    a.add(@as(i32, H));
+    const grid: cuda.Dim3 = .{ .x = @intCast((vn + 7) / 8), .y = @intCast((n + tiles[i] - 1) / tiles[i]), .z = 1 };
+    try cuda.launch.launch(c.k.head.unembed_fns[i], .{ .grid = grid, .block = .{ .x = 8 * 32 } }, c.stream, &a);
+}
+
+/// `rows` rows of `width` bytes from src (src_pitch bytes apart) to dst (dst_pitch apart).
+pub fn copy2d(c: *const Ctx, dst: u64, dst_pitch: usize, src: u64, src_pitch: usize, width: usize, rows: usize) !void {
+    if (rows == 0) return;
+    const p: cuda.abi.Memcpy2D = .{ .src = src, .src_pitch = src_pitch, .dst = dst, .dst_pitch = dst_pitch, .width = width, .height = rows };
+    try c.d.check(c.d.api.cuMemcpy2DAsync_v2(&p, c.stream.handle), "cuMemcpy2DAsync");
+}
+
+pub const Options = struct {
+    rank: u32,
+    world: u32,
+    group: ?*const cuda.tp_group.Group,
+    context: usize,
+    cap: usize,
+    lane: *const cuda.qmmf.Lane,
+    /// The target's unembed rows of this rank's slice (bf16 [V/W, H]) when it holds exactly them (the vocab-split
+    /// head), shared instead of read again; 0: read from the checkpoint.
+    unembed: u64 = 0,
+};
+
+/// The rank's share of the drafter from `dir` (mtp.safetensors, the target's unembed rows, the folds file).
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, m: *const ink.describe.Model, o: Options) !*Drafter {
+    const W: usize = o.world;
+    if (heads_all % W != 0 or kv_all % W != 0 or inter_all % W != 0) return error.BadDraftSplit;
+    const V: usize = m.c.text.vocab;
+    if (V % W != 0) return error.BadDraftSplit;
+    const dr = try gpa.create(Drafter);
+    errdefer gpa.destroy(dr);
+    dr.* = .{ .gpa = gpa, .d = d, .k = try Kernels.load(d), .rank = o.rank, .world = o.world, .group = o.group, .hq = heads_all / W, .hk = kv_all / W, .inter = inter_all / W, .vn = V / W, .vlo = o.rank * (V / W), .valid = 0, .context = o.context, .cap = o.cap };
+    errdefer {
+        for (dr.own.items) |*b| b.free();
+        dr.own.deinit(gpa);
+        dr.k.mod.unload();
+    }
+    const U: usize = m.c.text.unpadded_vocab;
+    dr.valid = if (U > dr.vlo) @min(U - dr.vlo, dr.vn) else 0;
+    const path = try std.fs.path.join(gpa, &.{ dir, "mtp.safetensors" });
+    defer gpa.free(path);
+    var r = try ink.st.Reader.open(gpa, io, path);
+    defer r.close();
+    var packer = try cuda.modelopt.Packer.load(d);
+    defer packer.unload();
+    var s = try cuda.Stream.init(d, true);
+    defer s.deinit();
+    var P: Pack = .{ .dr = dr, .r = &r, .packer = &packer, .s = s };
+    const hq = dr.hq;
+    const hk = dr.hk;
+    const I = dr.inter;
+    const q0 = o.rank * hq * D;
+    const k0 = o.rank * hk * D;
+    const m0 = o.rank * I;
+    for (&dr.L, 0..) |*l, i| {
+        var nb: [8][96]u8 = undefined;
+        const n = struct {
+            fn of(b: *[96]u8, li: usize, leaf: []const u8) ![]const u8 {
+                return std.fmt.bufPrint(b, "layers.{d}.{s}", .{ li, leaf });
+            }
+        }.of;
+        l.in_norm = try P.gain(try n(&nb[0], i, "input_layernorm.weight"));
+        l.post_norm = try P.gain(try n(&nb[0], i, "post_attention_layernorm.weight"));
+        l.dflare = try P.gain(try n(&nb[0], i, "dflare_norm.weight"));
+        l.q_norm = try P.gain(try n(&nb[0], i, "self_attn.q_norm.weight"));
+        l.k_norm = try P.gain(try n(&nb[0], i, "self_attn.k_norm.weight"));
+        l.k_norm_ctx = try P.gain(try n(&nb[0], i, "self_attn.k_norm_ctx.weight"));
+        l.qkv = try P.rows(&.{ .{ try n(&nb[1], i, "self_attn.q_proj.weight"), q0, hq * D }, .{ try n(&nb[2], i, "self_attn.k_proj.weight"), k0, hk * D }, .{ try n(&nb[3], i, "self_attn.v_proj.weight"), k0, hk * D } }, H);
+        l.kv = try P.rows(&.{ .{ try n(&nb[1], i, "self_attn.k_proj_ctx.weight"), k0, hk * D }, .{ try n(&nb[2], i, "self_attn.v_proj_ctx.weight"), k0, hk * D } }, H);
+        l.o = try P.cols(try n(&nb[1], i, "self_attn.o_proj.weight"), H, heads_all * D, q0, hq * D);
+        l.gu = try P.rows(&.{ .{ try n(&nb[1], i, "mlp.gate_proj.weight"), m0, I }, .{ try n(&nb[2], i, "mlp.up_proj.weight"), m0, I } }, H);
+        l.down = try P.cols(try n(&nb[1], i, "mlp.down_proj.weight"), H, inter_all, m0, I);
+    }
+    {
+        const fw = try r.alloc(gpa, "fuse_weight", .bf16);
+        defer gpa.free(fw);
+        if (fw.len != 6 * ntaps * 2) return error.BadDraftCheckpoint;
+        // alpha = bf16(softmax(fp32 fuse_weight)) per stage, kept as fp32
+        var al: [6 * ntaps]f32 = undefined;
+        for (0..6) |st| {
+            var x: [ntaps]f32 = undefined;
+            var mx: f32 = -std.math.inf(f32);
+            for (&x, 0..) |*v, t| {
+                v.* = ink.st.bf16ToF32(std.mem.readInt(u16, fw[2 * (st * ntaps + t) ..][0..2], .little));
+                mx = @max(mx, v.*);
+            }
+            var z: f32 = 0;
+            for (&x) |*v| {
+                v.* = @exp(v.* - mx);
+                z += v.*;
+            }
+            for (x, 0..) |v, t| al[st * ntaps + t] = ink.st.bf16ToF32(ink.st.f32ToBf16(v / z));
+        }
+        dr.alpha = try dr.put(std.mem.sliceAsBytes(&al));
+    }
+    dr.mask = try P.raw("mask_embed", H * 2);
+    dr.norm = try P.gain("norm.weight");
+    dr.mdflare = try P.gain("markov_head.dflare_norm.weight");
+    dr.w1 = try P.raw("markov_head.markov_w1.weight", V * mrank * 2);
+    dr.rnn_w = try P.raw("markov_head.rnn_proj.weight", 3 * mrank * (2 * mrank + 2 * H) * 2);
+    dr.rnn_b = try P.raw("markov_head.rnn_proj.bias", 3 * mrank * 2);
+    dr.rnn_inv = try P.colsPacked("markov_head.rnn_proj.weight", 3 * mrank, 2 * mrank + 2 * H, 2 * mrank, 2 * H);
+    // the target's unembed rows of the rank's slice (shared with the target's head when it holds them) and the folds
+    if (o.unembed != 0) dr.unembed = o.unembed else {
+        const t = m.inv.find("model.llm.unembed.weight") orelse return error.MissingInkling2Tensor;
+        const up = try std.fs.path.join(gpa, &.{ dir, m.inv.files[t.file].name });
+        defer gpa.free(up);
+        const f = try std.Io.Dir.cwd().openFile(io, up, .{});
+        defer f.close(io);
+        const n = dr.vn * H * 2;
+        const host = try gpa.alloc(u8, n);
+        defer gpa.free(host);
+        if (try f.readPositionalAll(io, host, m.inv.offset(t) + dr.vlo * H * 2) != n) return error.ShortRead;
+        dr.unembed = try dr.put(host);
+    }
+    {
+        const fpath = if (std.c.getenv("TF_INK2_DSPARK_FOLD")) |v| try gpa.dupe(u8, std.mem.span(v)) else try std.fs.path.join(gpa, &.{ dir, "inkling2-dspark-fold.safetensors" });
+        defer gpa.free(fpath);
+        var fr = ink.st.Reader.open(gpa, io, fpath) catch |err| {
+            std.log.err("inkling2 dspark: the head folds {s}: {t} (make them with tf-inkling2-fold MODEL OUT --rank R --world W)", .{ fpath, err });
+            return err;
+        };
+        defer fr.close();
+        const ew = fr.find("fold_w") orelse return error.BadDraftFolds;
+        const eb = fr.find("fold_b") orelse return error.BadDraftFolds;
+        if (ew.dtype != .bf16 or ew.dim(0) != V or ew.dim(1) != mrank or eb.dim(0) != V) return error.BadDraftFolds;
+        const hw = try gpa.alloc(u8, dr.vn * mrank * 2);
+        defer gpa.free(hw);
+        try fr.readInto(ew, dr.vlo * mrank * 2, hw);
+        dr.fold_w = try dr.put(hw);
+        const hb = try gpa.alloc(u8, dr.vn * 2);
+        defer gpa.free(hb);
+        try fr.readInto(eb, dr.vlo * 2, hb);
+        dr.fold_b = try dr.put(hb);
+    }
+    // work buffers
+    const ncap = o.cap;
+    dr.taps = try dr.alloc(ntaps * ncap * H * 2);
+    try (cuda.DeviceBuffer{ .d = d, .ptr = dr.taps, .len = ntaps * ncap * H * 2, .borrowed = true }).fill8(0, null);
+    dr.mixed = try dr.alloc(ncap * H * 2);
+    dr.kvo = try dr.alloc(ncap * 2 * hk * D * 2);
+    const SB = most_streams * block; // block rows of every stream a pass drafts
+    const SD = most_streams * drafts;
+    dr.anchors = try dr.alloc(most_streams * H * 2);
+    dr.mask7 = try dr.alloc(drafts * H * 2);
+    for (0..drafts) |j| try (cuda.DeviceBuffer{ .d = d, .ptr = dr.mask7, .len = drafts * H * 2, .borrowed = true }).copyFrom(j * H * 2, dr.mask, H * 2, null);
+    dr.x = try dr.alloc(SB * H * 2);
+    dr.hn = try dr.alloc(SB * H * 2);
+    dr.hb = try dr.alloc(SB * H * 2);
+    dr.qkv = try dr.alloc(SB * (hq + 2 * hk) * D * 2);
+    dr.q = try dr.alloc(SB * hq * D * 2);
+    dr.bk = try dr.alloc(SB * hk * D * 2);
+    dr.att = try dr.alloc(SB * hq * D * 2);
+    dr.gu = try dr.alloc(SB * 2 * I * 2);
+    dr.act = try dr.alloc(SB * I * 2);
+    dr.part = try dr.alloc(W * SB * H * 4);
+    dr.nsplit_max = (o.context + block + split_keys - 1) / split_keys;
+    dr.ml = try dr.alloc(hq * dr.nsplit_max * block * 2 * 4);
+    dr.acc = try dr.alloc(hq * dr.nsplit_max * block * D * 4);
+    dr.rows7 = try dr.alloc(SD * H * 2);
+    dr.base = try dr.alloc(SD * dr.vn * 2);
+    dr.mx = try dr.alloc(SD * 2 * H * 2);
+    dr.inv = try dr.alloc(SD * 3 * mrank * 4);
+    dr.state = try dr.alloc(most_streams * mrank * 2);
+    dr.latent = try dr.alloc(most_streams * mrank * 2);
+    dr.best_v = try dr.alloc(most_streams * logit_blocks * 4);
+    dr.best_i = try dr.alloc(most_streams * logit_blocks * 4);
+    dr.pairs = try dr.alloc(W * most_streams * pick_stride);
+    dr.walk = try dr.alloc(most_streams * block * 4);
+    // the lane matmul's slice partials: the largest any call takes (one stream's block up to every stream's)
+    {
+        var most: usize = 0;
+        for (&dr.L) |*l| {
+            for (1..most_streams + 1) |n| for ([_]cuda.qmmf.Weight{ l.qkv, l.o, l.gu, l.down }) |w| {
+                most = @max(most, o.lane.partBytes(n * block, w));
+            };
+            for (1..ncap + 1) |rn| most = @max(most, o.lane.partBytes(rn, l.kv));
+        }
+        for (1..most_streams + 1) |n| most = @max(most, o.lane.partBytes(n * drafts, dr.rnn_inv));
+        dr.lane_part_bytes = most;
+        dr.lane_part = try dr.alloc(most);
+    }
+    try s.synchronize();
+    std.log.info("inkling2 dspark rank {d} of {d}: {d} q heads, {d} kv heads, MLP {d}, vocabulary {d}..{d}: {d:.2} GiB; a slot's caches {d:.3} GiB at {d} positions (the local layers' rings: {d} positions, {d} rows mirrored; {d} bytes a position)", .{ o.rank, o.world, hq, hk, I, dr.vlo, dr.vlo + dr.vn, @as(f64, @floatFromInt(dr.bytes)) / (1 << 30), @as(f64, @floatFromInt(dr.slotBytes())) / (1 << 30), o.context, ringRows(o.context, o.cap), localRows(o.context, o.cap), 2 * hk * D * 2 * @as(usize, if (ringRows(o.context, o.cap) < o.context) 1 else nlayers) });
+    return dr;
+}
+
+/// Reads checkpoint tensors (bf16) and packs the rank's cuts for the lane matmul.
+const Pack = struct {
+    dr: *Drafter,
+    r: *ink.st.Reader,
+    packer: *cuda.modelopt.Packer,
+    s: cuda.Stream,
+
+    fn entry(P: *Pack, name: []const u8) !ink.st.Entry {
+        const e = P.r.find(name) orelse {
+            std.log.err("inkling2 dspark: mtp.safetensors has no {s}", .{name});
+            return error.BadDraftCheckpoint;
+        };
+        if (e.dtype != .bf16) return error.BadDraftCheckpoint;
+        return e;
+    }
+
+    /// A bf16 tensor as stored (its byte count checked).
+    fn raw(P: *Pack, name: []const u8, n: usize) !u64 {
+        const e = try P.entry(name);
+        if (e.bytes() != n) return error.BadDraftCheckpoint;
+        const host = try P.dr.gpa.alloc(u8, n);
+        defer P.dr.gpa.free(host);
+        try P.r.readInto(e, 0, host);
+        return P.dr.put(host);
+    }
+
+    /// A bf16 gain vector as fp32.
+    fn gain(P: *Pack, name: []const u8) !u64 {
+        const e = try P.entry(name);
+        const n: usize = @intCast(e.count());
+        const host = try P.dr.gpa.alloc(u8, n * 2);
+        defer P.dr.gpa.free(host);
+        try P.r.readInto(e, 0, host);
+        const out = try P.dr.gpa.alloc(f32, n);
+        defer P.dr.gpa.free(out);
+        for (out, 0..) |*o, i| o.* = ink.st.bf16ToF32(std.mem.readInt(u16, host[2 * i ..][0..2], .little));
+        return P.dr.put(std.mem.sliceAsBytes(out));
+    }
+
+    /// Row cuts (name, first row, rows) of [*, k] tensors stacked and packed: a lane weight [sum rows, k].
+    fn rows(P: *Pack, cuts: []const struct { []const u8, usize, usize }, k: usize) !cuda.qmmf.Weight {
+        var n: usize = 0;
+        for (cuts) |c| n += c[2];
+        const host = try P.dr.gpa.alloc(u8, n * k * 2);
+        defer P.dr.gpa.free(host);
+        var at: usize = 0;
+        for (cuts) |c| {
+            const e = try P.entry(c[0]);
+            if (e.rank != 2 or e.dim(1) != k or c[1] + c[2] > e.dim(0)) return error.BadDraftCheckpoint;
+            try P.r.readInto(e, c[1] * k * 2, host[at..][0 .. c[2] * k * 2]);
+            at += c[2] * k * 2;
+        }
+        return P.pack(host, n, k);
+    }
+
+    /// Columns c0 .. c0 + kc of a [n, k] tensor, packed as a lane weight [n, kc].
+    fn cols(P: *Pack, name: []const u8, n: usize, k: usize, c0: usize, kc: usize) !cuda.qmmf.Weight {
+        const e = try P.entry(name);
+        if (e.rank != 2 or e.dim(0) != n or e.dim(1) != k) return error.BadDraftCheckpoint;
+        const all = try P.dr.gpa.alloc(u8, n * k * 2);
+        defer P.dr.gpa.free(all);
+        try P.r.readInto(e, 0, all);
+        const host = try P.dr.gpa.alloc(u8, n * kc * 2);
+        defer P.dr.gpa.free(host);
+        for (0..n) |i| @memcpy(host[i * kc * 2 ..][0 .. kc * 2], all[(i * k + c0) * 2 ..][0 .. kc * 2]);
+        return P.pack(host, n, kc);
+    }
+
+    fn colsPacked(P: *Pack, name: []const u8, n: usize, k: usize, c0: usize, kc: usize) !cuda.qmmf.Weight {
+        return P.cols(name, n, k, c0, kc);
+    }
+
+    fn pack(P: *Pack, host: []const u8, n: usize, k: usize) !cuda.qmmf.Weight {
+        if (k % cuda.qmmf.group != 0) return error.BadDraftCheckpoint;
+        var src = try cuda.DeviceBuffer.fromHost(P.dr.d, host);
+        defer src.free();
+        const out = try P.dr.alloc(cuda.modelopt.padded(n) * k * 2);
+        try P.packer.bf16Lane(P.s, src.ptr, out, n, k);
+        try P.s.synchronize();
+        return cuda.modelopt.bf16Weight(out, n, k);
+    }
+};
+
+test "inkling2 dspark: taps by target layer, local layers" {
+    try std.testing.expectEqual(@as(?usize, 0), tapOf(4));
+    try std.testing.expectEqual(@as(?usize, 6), tapOf(40));
+    try std.testing.expectEqual(@as(?usize, null), tapOf(5));
+    try std.testing.expect(!local[2] and local[0] and local[4]);
+    // a slot of fewer positions than a ring: every layer holds them all
+    try std.testing.expectEqual(@as(usize, 5 * 2 * 100 * 2 * 128 * 2), Caches.bytes(2, 100, 2048, false));
+    // W = 4 (2 key heads) at the release's 131,072 + 16: the global layer at every position, four mirrored rings of
+    // 3,072 positions in 4,096 rows
+    const ctx: usize = 131_088;
+    try std.testing.expectEqual(@as(usize, 3072), ringRows(ctx, 2048));
+    try std.testing.expectEqual(@as(usize, 4096), localRows(ctx, 2048));
+    try std.testing.expectEqual(@as(usize, 2 * (ctx + 4 * 4096) * 2 * 128 * 2), Caches.bytes(2, ctx, 2048, false));
+    // on the KV page pool the global layer is in the pool: the slot holds the four rings alone
+    try std.testing.expectEqual(@as(usize, 2 * (4 * 4096) * 2 * 128 * 2), Caches.bytes(2, ctx, 2048, true));
+}
+
+test "inkling2 dspark: on pages the global layer is the pool's, the rings packed without it" {
+    const row = 2 * 128 * 2;
+    const pg: Caches.Paged = .{ .k = 7 << 30, .v = 9 << 30, .table = 3 << 20, .page = 256 * 2 * 128 };
+    const cs: Caches = .{ .buf = .{ .d = undefined, .ptr = 1 << 20, .len = Caches.bytes(2, 10_000, 2048, true), .borrowed = true }, .context = 10_000, .ring = ringRows(10_000, 2048), .row = row, .pg = pg };
+    try std.testing.expectEqual(@as(usize, 0), cs.rows(2));
+    try std.testing.expectEqual(pg.k, cs.keys(2));
+    try std.testing.expectEqual(pg.v, cs.values(2));
+    try std.testing.expectEqual(cs.keys(0) + 2 * 2 * 4096 * row, cs.keys(3));
+    try std.testing.expectEqual(cs.buf.ptr + cs.buf.len, cs.values(4) + 4096 * row);
+    const kv = cs.pagedKv(40).?;
+    try std.testing.expect(kv.paged() and kv.slots == 40 * split_keys and kv.heads == 2 and kv.page == pg.page);
+}
+
+test "inkling2 dspark: the caches' layout and the mirrored ring" {
+    const row = 2 * 128 * 2;
+    const cs: Caches = .{ .buf = .{ .d = undefined, .ptr = 1 << 20, .len = Caches.bytes(2, 10_000, 2048, false), .borrowed = true }, .context = 10_000, .ring = ringRows(10_000, 2048), .row = row };
+    // layers 0, 1 rings, 2 global, 3, 4 rings; keys then values, packed
+    try std.testing.expectEqual(@as(u64, 1 << 20), cs.keys(0));
+    try std.testing.expectEqual(cs.keys(0) + 4096 * row, cs.values(0));
+    try std.testing.expectEqual(cs.keys(0) + 2 * 2 * 4096 * row, cs.keys(2));
+    try std.testing.expectEqual(cs.keys(2) + 10_000 * row, cs.values(2));
+    try std.testing.expectEqual(cs.keys(2) + 2 * 10_000 * row, cs.keys(3));
+    try std.testing.expectEqual(cs.buf.ptr + cs.buf.len, cs.values(4) + 4096 * row);
+    try std.testing.expectEqual(@as(usize, 3072), cs.wrap(0));
+    try std.testing.expectEqual(@as(usize, 0), cs.wrap(2));
+    // a draft's context (positions p - window .. p - 1) stays in the ring while the writes after it reach no further
+    // than one forward of `cap` rows from the anchor (in serving: a verify window, 8 rows), and sits in consecutive
+    // rows from (p - window) % ring, inside the ring and its mirror
+    var p: usize = window;
+    while (p < 9_000) : (p += 997) {
+        const newest = p + 2048 - 1;
+        for (p - window..p) |x| try std.testing.expect(newest - x < cs.ring);
+        try std.testing.expect((p - window) % cs.ring + window <= cs.rows(0));
+    }
+}
diff --git a/zig/src/families/inkling2/cuda_dspark_main.zig b/zig/src/families/inkling2/cuda_dspark_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..aef4231e5f4056009c4b7e1d0dc3ab99ce967768
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_dspark_main.zig
@@ -0,0 +1,232 @@
+//! tf-inkling2-draft: the CUDA drafter alone on a taps file (inkling2_dspark_ref.py gen: ids, n_prompt, taps
+//! [T, 8, 4608]): positions 0 .. P - 1 absorbed from the file's taps, then the block at anchor P (the token ids[P]),
+//! its intermediates written to OUT for `inkling2_dspark_ref.py check` against the torch reference's `dump`.
+//! With --all, every anchor from n_prompt on: the proposals and the accepted lengths against the file's tokens.
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const ic = @import("inkling2_cuda");
+
+const dspark = ic.dspark;
+const ops = ic.ops;
+const H = ic.weights.hidden;
+
+const usage =
+    \\usage: tf-inkling2-draft <model dir> <taps file> (--anchor P --out FILE | --all)
+    \\
+;
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len < 4) {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    }
+    var anchor: ?usize = null;
+    var out: ?[]const u8 = null;
+    var all = false;
+    var i: usize = 3;
+    while (i < args.len) : (i += 1) {
+        if (std.mem.eql(u8, args[i], "--anchor") and i + 1 < args.len) {
+            anchor = try std.fmt.parseInt(usize, args[i + 1], 10);
+            i += 1;
+        } else if (std.mem.eql(u8, args[i], "--out") and i + 1 < args.len) {
+            out = args[i + 1];
+            i += 1;
+        } else if (std.mem.eql(u8, args[i], "--all")) all = true else {
+            std.debug.print("{s}", .{usage});
+            return 2;
+        }
+    }
+    return run(init.gpa, init.io, args[1], args[2], anchor, out, all) catch |e| {
+        std.debug.print("FAIL tf-inkling2-draft: {t}\n", .{e});
+        return 1;
+    };
+}
+
+fn run(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, taps_path: []const u8, anchor: ?usize, out: ?[]const u8, all: bool) !u8 {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var dg: ink.Diag = .{};
+    var model = ink.describe.Model.fromDir(gpa, io, dir, .{ .world = 1 }, &dg) catch |err| {
+        std.log.err("{s}", .{dg.text()});
+        return err;
+    };
+    defer model.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    var gemms: ops.Gemms = .{ .gpa = gpa };
+    var scratch = try ops.Scratch.init(&driver, 64 << 20);
+    defer scratch.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    const c: ops.Ctx = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch };
+    // the taps file
+    var r = try ink.st.Reader.open(gpa, io, taps_path);
+    defer r.close();
+    const ids_raw = try r.alloc(gpa, "ids", .i64);
+    defer gpa.free(ids_raw);
+    const T = ids_raw.len / 8;
+    const ids = try gpa.alloc(u32, T);
+    defer gpa.free(ids);
+    for (ids, 0..) |*t, j| t.* = @intCast(std.mem.readInt(i64, ids_raw[8 * j ..][0..8], .little));
+    const np_raw = try r.alloc(gpa, "n_prompt", .i64);
+    defer gpa.free(np_raw);
+    const n0: usize = @intCast(std.mem.readInt(i64, np_raw[0..8], .little));
+    const te = r.find("taps") orelse return error.NoTaps;
+    const dr = try dspark.load(gpa, io, &driver, dir, &model, .{ .rank = 0, .world = 1, .group = null, .context = T + dspark.block, .cap = ic.engine.prompt_rows, .lane = &k.attn.lane });
+    defer dr.deinit();
+    // the embedding table's rows and gain for anchors (host reads)
+    const et = model.inv.find("model.llm.embed.weight") orelse return error.NoEmbed;
+    const ng = model.inv.find("model.llm.embed_norm.weight") orelse return error.NoEmbed;
+    const ep = try std.fs.path.join(gpa, &.{ dir, model.inv.files[et.file].name });
+    defer gpa.free(ep);
+    const ef = try std.Io.Dir.cwd().openFile(io, ep, .{});
+    defer ef.close(io);
+    var gain: [H]f32 = undefined;
+    {
+        const gp = try std.fs.path.join(gpa, &.{ dir, model.inv.files[ng.file].name });
+        defer gpa.free(gp);
+        const gf = try std.Io.Dir.cwd().openFile(io, gp, .{});
+        defer gf.close(io);
+        var raw: [H * 2]u8 = undefined;
+        if (try gf.readPositionalAll(io, &raw, model.inv.offset(ng)) != raw.len) return error.ShortRead;
+        for (&gain, 0..) |*g, j| g.* = ink.st.bf16ToF32(std.mem.readInt(u16, raw[2 * j ..][0..2], .little));
+    }
+    var gbuf = try cuda.DeviceBuffer.fromHost(&driver, std.mem.sliceAsBytes(&gain));
+    defer gbuf.free();
+    var rowbuf = try cuda.DeviceBuffer.alloc(&driver, H * 2);
+    defer rowbuf.free();
+    // absorb every position from the file's taps, a chunk at a time ([T, 8, H] -> the drafter's [8][cap][H])
+    const lo_pos: usize = 0;
+    const rows_with_taps: usize = @intCast(te.dim(0)); // a reply ending in EOS has no taps for its last token
+    // --all: positions up to the first anchor now, then each anchor's last position before its draft (a local layer's
+    // ring holds only the last positions, so a context absorbed far ahead of an anchor would evict its own)
+    const hi_pos: usize = if (all) @min(n0, rows_with_taps) else (anchor orelse return error.NoAnchor);
+    const host = try gpa.alloc(u8, dspark.ntaps * H * 2);
+    defer gpa.free(host);
+    var p0 = lo_pos;
+    while (p0 < hi_pos) {
+        const n = @min(hi_pos - p0, ic.engine.prompt_rows);
+        for (0..n) |j| {
+            try r.readInto(te, (p0 + j) * dspark.ntaps * H * 2, host);
+            for (0..dspark.ntaps) |t| {
+                const view: cuda.DeviceBuffer = .{ .d = &driver, .ptr = dr.tap(t) + j * H * 2, .len = H * 2, .borrowed = true };
+                try view.upload(0, host[t * H * 2 ..][0 .. H * 2]);
+            }
+        }
+        try dr.absorb(&c, 0, p0, n, 0, 0);
+        try stream.synchronize();
+        p0 += n;
+    }
+    if (!all) {
+        const p = hi_pos;
+        // f_rnn reads the taps' row of p - 1: put it at row 0
+        try r.readInto(te, (p - 1) * dspark.ntaps * H * 2, host);
+        for (0..dspark.ntaps) |t| {
+            const view: cuda.DeviceBuffer = .{ .d = &driver, .ptr = dr.tap(t), .len = H * 2, .borrowed = true };
+            try view.upload(0, host[t * H * 2 ..][0 .. H * 2]);
+        }
+        try embedRow(&c, io, ef, model.inv.offset(et), ids[p], rowbuf, gbuf.ptr, dr.x);
+        try dr.draft(&c, 0, p, ids[p], 0);
+        var props: [dspark.drafts]u32 = undefined;
+        try dr.proposals(&c, &props);
+        std.debug.print("proposals", .{});
+        for (props) |t| std.debug.print(" {d}", .{t});
+        std.debug.print("\ntargets  ", .{});
+        for (1..dspark.block) |j| std.debug.print(" {d}", .{if (p + j < T) ids[p + j] else 0});
+        std.debug.print("\n", .{});
+        var w = ink.st.Writer.init(gpa);
+        defer w.deinit();
+        try put(gpa, &w, &driver, "block.out", dr.hn, &.{ dspark.block, H }, .bf16);
+        try put(gpa, &w, &driver, "base", dr.base, &.{ dspark.drafts, dr.vn }, .bf16);
+        try put(gpa, &w, &driver, "frnn", dr.hb, &.{H}, .bf16);
+        try put(gpa, &w, &driver, "inv", dr.inv, &.{ dspark.drafts, 3 * dspark.mrank }, .f32);
+        try put(gpa, &w, &driver, "proposals", dr.walk + 4, &.{dspark.drafts}, .i32);
+        const cs = try dr.bind(0);
+        for (0..dspark.nlayers) |l| {
+            var nb: [32]u8 = undefined;
+            try putCtx(gpa, &w, &driver, try std.fmt.bufPrint(&nb, "ctx{d}.k", .{l}), cs, l, cs.keys(l), p);
+            try putCtx(gpa, &w, &driver, try std.fmt.bufPrint(&nb, "ctx{d}.v", .{l}), cs, l, cs.values(l), p);
+        }
+        try w.write(io, out orelse return error.NoOut);
+        return 0;
+    }
+    // every anchor: the accepted drafts (matching prefix) against the file's tokens
+    var hist: [dspark.block]usize = @splat(0);
+    var p = n0;
+    var total: usize = 0;
+    var absorbed = hi_pos;
+    while (p + dspark.drafts < T) : (p += 1) {
+        try r.readInto(te, (p - 1) * dspark.ntaps * H * 2, host);
+        for (0..dspark.ntaps) |t| {
+            const view: cuda.DeviceBuffer = .{ .d = &driver, .ptr = dr.tap(t), .len = H * 2, .borrowed = true };
+            try view.upload(0, host[t * H * 2 ..][0 .. H * 2]);
+        }
+        if (p - 1 == absorbed and p - 1 < rows_with_taps) {
+            try dr.absorb(&c, 0, p - 1, 1, 0, 0);
+            absorbed = p;
+        }
+        try embedRow(&c, io, ef, model.inv.offset(et), ids[p], rowbuf, gbuf.ptr, dr.x);
+        try dr.draft(&c, 0, p, ids[p], 0);
+        var props: [dspark.drafts]u32 = undefined;
+        try dr.proposals(&c, &props);
+        var m: usize = 0;
+        while (m < dspark.drafts and props[m] == ids[p + 1 + m]) m += 1;
+        hist[m] += 1;
+        total += 1;
+        std.debug.print("anchor {d}:", .{p});
+        for (props) |t| std.debug.print(" {d}", .{t});
+        std.debug.print(" | {d}\n", .{m});
+    }
+    std.debug.print("anchors {d}, accepted-prefix histogram at 7:", .{total});
+    for (hist, 0..) |h, j| std.debug.print(" {d}:{d}", .{ j, h });
+    std.debug.print("\n", .{});
+    return 0;
+}
+
+/// The normed embedding of token `id` (read from the table's file row) into `dst` [1][H] bf16.
+fn embedRow(c: *const ops.Ctx, io: std.Io, f: std.Io.File, table: u64, id: u32, row: cuda.DeviceBuffer, gain: u64, dst: u64) !void {
+    var raw: [H * 2]u8 = undefined;
+    if (try f.readPositionalAll(io, &raw, table + @as(u64, id) * H * 2) != raw.len) return error.ShortRead;
+    try c.stream.synchronize();
+    try row.upload(0, &raw);
+    try c.rms(ops.Mat.of(row.ptr, 1, H, .bf16), gain, ops.Mat.of(dst, 1, H, .bf16), 1e-6);
+}
+
+/// Layer l's context keys or values at positions 0 .. p - 1 in position order (a ring's mirror checked equal to its
+/// first rows); a local layer's ring holds only the last `ring` of them (the dump's first dimension says how many: `inkling2_dspark_ref.py check` compares the
+/// reference's last rows).
+fn putCtx(gpa: std.mem.Allocator, w: *ink.st.Writer, d: *const cuda.Driver, name: []const u8, cs: *const dspark.Caches, l: usize, table: u64, p: usize) !void {
+    const ring = cs.wrap(l);
+    if (ring == 0) return put(gpa, w, d, name, table, &.{ p, cs.row / 2 }, .bf16);
+    const n = @min(p, ring);
+    const all = try gpa.alloc(u8, cs.rows(l) * cs.row);
+    defer gpa.free(all);
+    try cuda.memory.download(d, table, all);
+    // the mirror: rows ring .. ring + window - 1 repeat rows 0 .. window - 1
+    const mirror = (cs.rows(l) - ring) * cs.row;
+    if (!std.mem.eql(u8, all[0..mirror], all[ring * cs.row ..][0..mirror])) {
+        std.debug.print("FAIL {s}: the ring's mirrored rows differ from their first rows\n", .{name});
+        return error.DraftMirror;
+    }
+    const host = try gpa.alloc(u8, n * cs.row);
+    errdefer gpa.free(host);
+    for (0..n) |i| {
+        const pos = p - n + i;
+        @memcpy(host[i * cs.row ..][0..cs.row], all[(pos % ring) * cs.row ..][0..cs.row]);
+    }
+    try w.addOwned(name, .bf16, &.{ n, cs.row / 2 }, host);
+}
+
+fn put(gpa: std.mem.Allocator, w: *ink.st.Writer, d: *const cuda.Driver, name: []const u8, ptr: u64, shape: []const u64, dt: ink.st.DType) !void {
+    var n: usize = dt.size();
+    for (shape) |x| n *= x;
+    const host = try gpa.alloc(u8, n);
+    errdefer gpa.free(host);
+    try cuda.memory.download(d, ptr, host);
+    try w.addOwned(name, dt, shape, host);
+}
diff --git a/zig/src/families/inkling2/fold.zig b/zig/src/families/inkling2/fold.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8f2b3a4a271b4572090eeb509db57d20b2c14cf9
--- /dev/null
+++ b/zig/src/families/inkling2/fold.zig
@@ -0,0 +1,422 @@
+//! The DSpark drafter's head folds (cuda_dspark.zig loads them): fold_w = unembed . hidden_out.weight [V, 256] and
+//! fold_b = unembed . hidden_out.bias [V], each element a sum over the hidden size H of bf16 x bf16 products in fp64,
+//! stored bf16. The products are exact in fp64; the sum runs h = 0 .. H-1 in that fixed order from +0. The store
+//! rounds fp64 to fp32 and then fp32 to bf16, each to nearest even: what torch's `.to(torch.bfloat16)` does to an
+//! fp64 tensor (its BFloat16 is built from a float), so the result matches `inkling2_dspark_ref.py fold` wherever the
+//! fp64 sums agree (they agree whenever the sum is exact in fp64, which a dot product of bf16 values almost always
+//! is; an inexact one can still differ from a BLAS's order in its last fp64 bit).
+//!
+//! Inputs: the checkpoint's `model.llm.unembed.weight` (bf16 [V, H], in the shard model.safetensors.index.json names)
+//! and mtp.safetensors' `markov_head.hidden_out.weight` (bf16 or f32 [H, 256]) and `.bias` ([H]). A rank folder holds
+//! only its own vocabulary rows; `rows` then names them (the rank's quarter at W = 4) and only those are computed.
+const std = @import("std");
+const st = @import("st.zig");
+
+pub const rank_dim = 256;
+pub const unembed_name = "model.llm.unembed.weight";
+pub const weight_name = "markov_head.hidden_out.weight";
+pub const bias_name = "markov_head.hidden_out.bias";
+
+const VL = 4; // f64 lanes a vector
+const Vec = @Vector(VL, f64);
+const tile_rows = 4;
+const tile_vecs = 4;
+const tile_cols = tile_vecs * VL; // 16 output columns a tile
+const cols = rank_dim + 1; // fold_w's 256 and fold_b as column 256
+const chunks = (cols + tile_cols - 1) / tile_cols; // 17
+const block_rows = 64; // rows a work item
+
+/// hidden_out as fp64, extended by the bias as column 256 and zero padding, laid out chunk by chunk:
+/// w[(k H + h) tile_cols + j] = column k tile_cols + j of row h.
+pub const Head = struct {
+    hidden: usize,
+    w: []f64,
+
+    pub fn init(gpa: std.mem.Allocator, hidden: usize, weight: []const f64, bias: []const f64) !Head {
+        if (weight.len != hidden * rank_dim or bias.len != hidden) return error.BadFoldInputs;
+        const w = try gpa.alloc(f64, chunks * hidden * tile_cols);
+        @memset(w, 0);
+        for (0..hidden) |h| {
+            for (0..cols) |c| {
+                const v = if (c < rank_dim) weight[h * rank_dim + c] else bias[h];
+                w[((c / tile_cols) * hidden + h) * tile_cols + c % tile_cols] = v;
+            }
+        }
+        return .{ .hidden = hidden, .w = w };
+    }
+
+    pub fn deinit(h: *Head, gpa: std.mem.Allocator) void {
+        gpa.free(h.w);
+    }
+};
+
+/// fp64 to bf16 bits as torch rounds an fp64 tensor to bf16: to fp32 (nearest even), then to bf16 (nearest even).
+pub fn f64ToBf16(x: f64) u16 {
+    return st.f32ToBf16(@floatCast(x));
+}
+
+/// The folds of `n` rows: `u` holds them as fp64 [n][H]; out_w gets [n][256] bf16 bits, out_b [n].
+pub fn rows(head: *const Head, u: []const f64, n: usize, out_w: []u16, out_b: []u16) void {
+    const H = head.hidden;
+    var q: usize = 0;
+    while (q < n) : (q += tile_rows) {
+        const nr: usize = @min(tile_rows, n - q);
+        var src: [tile_rows][]const f64 = undefined;
+        for (0..tile_rows) |r| src[r] = u[(q + @min(r, nr - 1)) * H ..][0..H];
+        for (0..chunks) |k| {
+            var acc: [tile_rows][tile_vecs]Vec = @splat(@splat(@splat(0.0)));
+            const wk = head.w[k * H * tile_cols ..][0 .. H * tile_cols];
+            for (0..H) |h| {
+                var wv: [tile_vecs]Vec = undefined;
+                inline for (0..tile_vecs) |c| wv[c] = wk[h * tile_cols + c * VL ..][0..VL].*;
+                inline for (0..tile_rows) |r| {
+                    const s: Vec = @splat(src[r][h]);
+                    inline for (0..tile_vecs) |c| acc[r][c] = acc[r][c] + s * wv[c];
+                }
+            }
+            for (0..nr) |r| {
+                const row = q + r;
+                inline for (0..tile_vecs) |c| {
+                    const a: [VL]f64 = acc[r][c];
+                    for (0..VL) |l| {
+                        const col = k * tile_cols + c * VL + l;
+                        if (col < rank_dim) out_w[row * rank_dim + col] = f64ToBf16(a[l]) else if (col == rank_dim) out_b[row] = f64ToBf16(a[l]);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Rows [lo, hi) of the unembed, read from `file` at `base` (the tensor's first byte), folded with `jobs` threads into
+/// out_w ([hi - lo][256] bf16 bits) and out_b ([hi - lo]). Returns the number of all-zero unembed rows seen.
+pub fn run(gpa: std.mem.Allocator, io: std.Io, file: std.Io.File, base: u64, head: *const Head, lo: usize, hi: usize, out_w: []u16, out_b: []u16, jobs: usize) !usize {
+    const Job = struct {
+        io: std.Io,
+        file: std.Io.File,
+        base: u64,
+        head: *const Head,
+        lo: usize,
+        hi: usize,
+        out_w: []u16,
+        out_b: []u16,
+        next: std.atomic.Value(usize) = .init(0),
+        zero: std.atomic.Value(usize) = .init(0),
+
+        fn work(j: *@This(), g: std.mem.Allocator, failed: *?anyerror) void {
+            j.loop(g) catch |e| {
+                failed.* = e;
+                j.next.store(j.hi, .release);
+            };
+        }
+
+        fn loop(j: *@This(), g: std.mem.Allocator) !void {
+            const H = j.head.hidden;
+            const raw = try g.alloc(u8, block_rows * H * 2);
+            defer g.free(raw);
+            const u = try g.alloc(f64, block_rows * H);
+            defer g.free(u);
+            while (true) {
+                const r0 = j.lo + j.next.fetchAdd(block_rows, .acq_rel);
+                if (r0 >= j.hi) return;
+                const n: usize = @min(block_rows, j.hi - r0);
+                const bytes = raw[0 .. n * H * 2];
+                if (try j.file.readPositionalAll(j.io, bytes, j.base + @as(u64, r0) * H * 2) != bytes.len) return error.ShortRead;
+                var zero: usize = 0;
+                for (0..n) |r| {
+                    var any: u16 = 0;
+                    for (0..H) |h| {
+                        const b = std.mem.readInt(u16, bytes[(r * H + h) * 2 ..][0..2], .little);
+                        any |= b & 0x7fff;
+                        u[r * H + h] = st.bf16ToF32(b);
+                    }
+                    if (any == 0) zero += 1;
+                }
+                _ = j.zero.fetchAdd(zero, .acq_rel);
+                const o = r0 - j.lo;
+                rows(j.head, u, n, j.out_w[o * rank_dim ..][0 .. n * rank_dim], j.out_b[o..][0..n]);
+            }
+        }
+    };
+    if (out_w.len != (hi - lo) * rank_dim or out_b.len != hi - lo) return error.BadFoldInputs;
+    var job: Job = .{ .io = io, .file = file, .base = base, .head = head, .lo = lo, .hi = hi, .out_w = out_w, .out_b = out_b };
+    const threads = try gpa.alloc(std.Thread, @max(1, jobs));
+    defer gpa.free(threads);
+    const failed = try gpa.alloc(?anyerror, threads.len);
+    defer gpa.free(failed);
+    @memset(failed, null);
+    var started: usize = 0;
+    defer for (threads[0..started]) |t| t.join();
+    for (threads, failed) |*t, *e| {
+        t.* = try std.Thread.spawn(.{}, Job.work, .{ &job, gpa, e });
+        started += 1;
+    }
+    for (threads[0..started]) |t| t.join();
+    started = 0;
+    for (failed) |f| if (f) |e| return e;
+    return job.zero.load(.acquire);
+}
+
+/// The safetensors header of a folds file over `vocab` rows (the bytes torch's save_file writes for
+/// {"fold_w", "fold_b"}: names sorted, no spaces, padded with spaces to 8 bytes); `meta` adds __metadata__ pairs.
+pub fn header(gpa: std.mem.Allocator, vocab: u64, meta: []const [2][]const u8) ![]u8 {
+    var out: std.ArrayList(u8) = .empty;
+    errdefer out.deinit(gpa);
+    try out.append(gpa, '{');
+    var buf: [256]u8 = undefined;
+    if (meta.len > 0) {
+        try out.appendSlice(gpa, "\"__metadata__\":{");
+        for (meta, 0..) |m, i| {
+            if (i > 0) try out.append(gpa, ',');
+            try out.appendSlice(gpa, try std.fmt.bufPrint(&buf, "\"{s}\":\"{s}\"", .{ m[0], m[1] }));
+        }
+        try out.appendSlice(gpa, "},");
+    }
+    const nb = vocab * 2;
+    const nw = vocab * rank_dim * 2;
+    try out.appendSlice(gpa, try std.fmt.bufPrint(&buf, "\"fold_b\":{{\"dtype\":\"BF16\",\"shape\":[{d}],\"data_offsets\":[0,{d}]}},", .{ vocab, nb }));
+    try out.appendSlice(gpa, try std.fmt.bufPrint(&buf, "\"fold_w\":{{\"dtype\":\"BF16\",\"shape\":[{d},{d}],\"data_offsets\":[{d},{d}]}}}}", .{ vocab, rank_dim, nb, nb + nw }));
+    while ((8 + out.items.len) % 8 != 0) try out.append(gpa, ' ');
+    const full = try gpa.alloc(u8, 8 + out.items.len);
+    std.mem.writeInt(u64, full[0..8], out.items.len, .little);
+    @memcpy(full[8..], out.items);
+    out.deinit(gpa);
+    return full;
+}
+
+/// `parts`, in order, become the file `out_path`, all or nothing; the one place the folds file is published. A new
+/// temporary file beside `out_path` (`.NAME.<16 hex>.tmp`, a fresh random name each try) is created exclusively
+/// (O_CREAT|O_EXCL: an existing name, a symlink included, is refused and never opened, so no link is followed and
+/// nothing is truncated), written and synced through that one handle, then renamed over `out_path` (a symlink at
+/// `out_path` is replaced, not followed). Any failure removes the temporary file and leaves `out_path` as it was.
+pub fn publish(gpa: std.mem.Allocator, io: std.Io, out_path: []const u8, parts: []const []const u8) !void {
+    return publishNamed(gpa, io, out_path, parts, &randomNonce);
+}
+
+/// The folds file's digest record (fold-rank.sh's `.inkling2-dspark-fold.sha256`): `line` and a newline published as
+/// `path` the same way as the folds file (`publish`), so no existing name is opened, followed or truncated.
+pub fn record(gpa: std.mem.Allocator, io: std.Io, path: []const u8, line: []const u8) !void {
+    if (line.len == 0 or std.mem.indexOfScalar(u8, line, '\n') != null) return error.BadRecord;
+    return publish(gpa, io, path, &.{ line, "\n" });
+}
+
+fn randomNonce(io: std.Io, _: usize) [8]u8 {
+    var n: [8]u8 = undefined;
+    io.random(&n);
+    return n;
+}
+
+/// `publish` with the temporary names' nonces from `nonce` (try 0, 1, ...): tests plant a name it will draw.
+fn publishNamed(gpa: std.mem.Allocator, io: std.Io, out_path: []const u8, parts: []const []const u8, nonce: *const fn (std.Io, usize) [8]u8) !void {
+    const cwd = std.Io.Dir.cwd();
+    const dir = std.fs.path.dirname(out_path) orelse ".";
+    const base = std.fs.path.basename(out_path);
+    if (base.len == 0) return error.BadOutputPath;
+    var try_: usize = 0;
+    while (true) : (try_ += 1) {
+        const tmp = try std.fmt.allocPrint(gpa, "{s}/.{s}.{s}.tmp", .{ dir, base, std.fmt.bytesToHex(nonce(io, try_), .lower) });
+        defer gpa.free(tmp);
+        const file = cwd.createFile(io, tmp, .{ .exclusive = true }) catch |e| switch (e) {
+            error.PathAlreadyExists => if (try_ < 16) continue else return e,
+            else => return e,
+        };
+        errdefer cwd.deleteFile(io, tmp) catch {};
+        {
+            defer file.close(io);
+            var at: u64 = 0;
+            for (parts) |part| {
+                try file.writePositionalAll(io, part, at);
+                at += part.len;
+            }
+            try file.sync(io);
+        }
+        try cwd.rename(tmp, cwd, out_path, io);
+        return;
+    }
+}
+
+const testing = std.testing;
+
+test "inkling2 fold: fp64 to bf16 rounds through fp32 (torch's order), nearest even at each step" {
+    // 1 + 2^-8 + 2^-30: direct rounding to bf16 goes up (above the halfway point 1 + 2^-8), but fp32 first rounds
+    // it to 1 + 2^-8 exactly, the halfway point, and nearest even then goes down to 1.0
+    try testing.expectEqual(@as(u16, 0x3f80), f64ToBf16(1.0 + 0x1p-8 + 0x1p-30));
+    try testing.expectEqual(@as(u16, 0x3f81), f64ToBf16(1.0 + 0x1p-8 + 0x1p-20));
+    try testing.expectEqual(@as(u16, 0xbf80), f64ToBf16(-1.0));
+    try testing.expectEqual(@as(u16, 0x0000), f64ToBf16(0.0));
+}
+
+test "inkling2 fold: tiles equal the plain fp64 sum in h order for every row and column, odd row counts" {
+    const gpa = testing.allocator;
+    const H = 37;
+    const n = 7;
+    var prng = std.Random.DefaultPrng.init(7);
+    const rnd = prng.random();
+    const bf = struct {
+        fn of(r: std.Random) f64 {
+            return st.bf16ToF32(st.f32ToBf16((r.float(f32) - 0.5) * 8));
+        }
+    }.of;
+    const w = try gpa.alloc(f64, H * rank_dim);
+    defer gpa.free(w);
+    const b = try gpa.alloc(f64, H);
+    defer gpa.free(b);
+    const u = try gpa.alloc(f64, n * H);
+    defer gpa.free(u);
+    for (w) |*x| x.* = bf(rnd);
+    for (b) |*x| x.* = bf(rnd);
+    for (u) |*x| x.* = bf(rnd);
+    var head = try Head.init(gpa, H, w, b);
+    defer head.deinit(gpa);
+    var ow: [n * rank_dim]u16 = undefined;
+    var ob: [n]u16 = undefined;
+    rows(&head, u, n, &ow, &ob);
+    for (0..n) |r| {
+        for (0..rank_dim + 1) |c| {
+            var s: f64 = 0;
+            for (0..H) |h| s += u[r * H + h] * (if (c < rank_dim) w[h * rank_dim + c] else b[h]);
+            const got = if (c < rank_dim) ow[r * rank_dim + c] else ob[r];
+            try testing.expectEqual(f64ToBf16(s), got);
+        }
+    }
+}
+
+test "inkling2 fold: the header is save_file's" {
+    const h = try header(testing.allocator, 201024, &.{});
+    defer testing.allocator.free(h);
+    try testing.expectEqual(@as(u64, 152), std.mem.readInt(u64, h[0..8], .little));
+    try testing.expectEqualStrings("{\"fold_b\":{\"dtype\":\"BF16\",\"shape\":[201024],\"data_offsets\":[0,402048]},\"fold_w\":{\"dtype\":\"BF16\",\"shape\":[201024,256],\"data_offsets\":[402048,103326336]}} ", h[8..]);
+}
+
+const PublishTest = struct {
+    /// Try 0 draws the planted name, later tries ordinary ones.
+    fn planted(io: std.Io, try_: usize) [8]u8 {
+        return if (try_ == 0) @splat(0xab) else randomNonce(io, try_);
+    }
+
+    fn root(tmp: *const testing.TmpDir) ![:0]u8 {
+        return tmp.dir.realPathFileAlloc(testing.io, ".", testing.allocator);
+    }
+
+    fn join(dir: []const u8, name: []const u8) ![]u8 {
+        return std.fs.path.join(testing.allocator, &.{ dir, name });
+    }
+
+    fn expectFile(tmp: *const testing.TmpDir, name: []const u8, want: []const u8) !void {
+        const got = try tmp.dir.readFileAlloc(testing.io, name, testing.allocator, .limited(1 << 20));
+        defer testing.allocator.free(got);
+        try testing.expectEqualStrings(want, got);
+    }
+
+    /// The folder's names other than `keep`: none may be a leftover temporary file.
+    fn expectOnly(tmp: *const testing.TmpDir, keep: []const []const u8) !void {
+        var d = try tmp.dir.openDir(testing.io, ".", .{ .iterate = true });
+        defer d.close(testing.io);
+        var it = d.iterate();
+        while (try it.next(testing.io)) |e| {
+            for (keep) |k| {
+                if (std.mem.eql(u8, k, e.name)) break;
+            } else {
+                std.debug.print("unexpected entry {s}\n", .{e.name});
+                return error.TestUnexpectedEntry;
+            }
+        }
+    }
+
+    const Racer = struct {
+        out: []const u8,
+        body: []const u8,
+        err: ?anyerror = null,
+        fn run(r: *Racer) void {
+            for (0..40) |_| publish(testing.allocator, testing.io, r.out, &.{ r.body[0..3], r.body[3..] }) catch |e| {
+                r.err = e;
+                return;
+            };
+        }
+    };
+};
+
+test "inkling2 fold publish: a symlink planted at the temporary names or at the output is never written through" {
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = testing.io;
+    const dir = try PublishTest.root(&tmp);
+    defer testing.allocator.free(dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "sentinel", .data = "an original weight shard" });
+    const name = "inkling2-dspark-fold.safetensors";
+    // the earlier wrapper's and tool's predictable names, and the name try 0 will draw, all link to the sentinel
+    try tmp.dir.symLink(io, "sentinel", name ++ ".tmp", .{});
+    try tmp.dir.symLink(io, "sentinel", name ++ ".tmp.tmp", .{});
+    const drawn = "." ++ name ++ ".abababababababab.tmp";
+    try tmp.dir.symLink(io, "sentinel", drawn, .{});
+    const out = try PublishTest.join(dir, name);
+    defer testing.allocator.free(out);
+    try publishNamed(testing.allocator, io, out, &.{ "fold", "s v1" }, &PublishTest.planted);
+    try PublishTest.expectFile(&tmp, "sentinel", "an original weight shard");
+    try PublishTest.expectFile(&tmp, name, "folds v1");
+    try PublishTest.expectOnly(&tmp, &.{ "sentinel", name, name ++ ".tmp", name ++ ".tmp.tmp", drawn });
+    // the output itself a link to the sentinel: replaced by the new file, the sentinel unchanged
+    try tmp.dir.deleteFile(io, name);
+    try tmp.dir.symLink(io, "sentinel", name, .{});
+    try publish(testing.allocator, io, out, &.{"folds v2"});
+    try PublishTest.expectFile(&tmp, "sentinel", "an original weight shard");
+    try PublishTest.expectFile(&tmp, name, "folds v2"); // written through the link, the sentinel would read so
+}
+
+test "inkling2 fold publish: two writers at once leave one whole file and no temporary file" {
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try PublishTest.root(&tmp);
+    defer testing.allocator.free(dir);
+    const out = try PublishTest.join(dir, "f.safetensors");
+    defer testing.allocator.free(out);
+    const a_body: [4096]u8 = @splat('a');
+    const b_body: [4096]u8 = @splat('b');
+    var a: PublishTest.Racer = .{ .out = out, .body = &a_body };
+    var b: PublishTest.Racer = .{ .out = out, .body = &b_body };
+    const ta = try std.Thread.spawn(.{}, PublishTest.Racer.run, .{&a});
+    const tb = try std.Thread.spawn(.{}, PublishTest.Racer.run, .{&b});
+    ta.join();
+    tb.join();
+    try testing.expect(a.err == null and b.err == null);
+    const got = try tmp.dir.readFileAlloc(testing.io, "f.safetensors", testing.allocator, .limited(1 << 20));
+    defer testing.allocator.free(got);
+    try testing.expect(std.mem.eql(u8, got, &a_body) or std.mem.eql(u8, got, &b_body));
+    try PublishTest.expectOnly(&tmp, &.{"f.safetensors"});
+}
+
+test "inkling2 fold record: a symlink planted at the record, its old temporary name or the drawn one is never written through" {
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = testing.io;
+    const dir = try PublishTest.root(&tmp);
+    defer testing.allocator.free(dir);
+    try tmp.dir.writeFile(io, .{ .sub_path = "sentinel", .data = "an original weight shard" });
+    const name = ".inkling2-dspark-fold.sha256";
+    const drawn = "." ++ name ++ ".abababababababab.tmp";
+    for ([_][]const u8{ name, name ++ ".tmp", name ++ ".AbCd1234", drawn }) |n| try tmp.dir.symLink(io, "sentinel", n, .{});
+    const out = try PublishTest.join(dir, name);
+    defer testing.allocator.free(out);
+    const line = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef  rank 3";
+    try publishNamed(testing.allocator, io, out, &.{ line, "\n" }, &PublishTest.planted);
+    try PublishTest.expectFile(&tmp, "sentinel", "an original weight shard");
+    try PublishTest.expectFile(&tmp, name, line ++ "\n");
+    try PublishTest.expectOnly(&tmp, &.{ "sentinel", name, name ++ ".tmp", name ++ ".AbCd1234", drawn });
+    try record(testing.allocator, io, out, "again  rank 3");
+    try PublishTest.expectFile(&tmp, name, "again  rank 3\n");
+    try PublishTest.expectFile(&tmp, "sentinel", "an original weight shard");
+    try testing.expectError(error.BadRecord, record(testing.allocator, io, out, "two\nlines"));
+    try testing.expectError(error.BadRecord, record(testing.allocator, io, out, ""));
+    try PublishTest.expectFile(&tmp, name, "again  rank 3\n");
+}
+
+test "inkling2 fold publish: a missing folder fails and creates nothing" {
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const dir = try PublishTest.root(&tmp);
+    defer testing.allocator.free(dir);
+    const out = try PublishTest.join(dir, "absent/f.safetensors");
+    defer testing.allocator.free(out);
+    try testing.expectError(error.FileNotFound, publish(testing.allocator, testing.io, out, &.{"x"}));
+    try PublishTest.expectOnly(&tmp, &.{});
+}
