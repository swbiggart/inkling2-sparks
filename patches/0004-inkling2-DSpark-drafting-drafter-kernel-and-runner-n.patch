+    pub fn absorb(dr: *Drafter, c: *const Ctx, slot: u32, pos0: usize, R: usize, row0: usize, posp: u64) !void {
+        if (row0 + R > dr.cap or pos0 + R > dr.context) return error.DraftContext;
