+        a.add(x);
+        a.add(@as(i64, @intCast(x_ld)));
+        a.add(gain);
+        a.add(out);
+        a.add(@as(i64, @intCast(out_ld)));
+        a.add(@as(i64, @intCast(pos0)));
+        a.add(theta);
+        a.add(eps);
+        a.add(posp);
+        a.add(@as(i64, @intCast(ring)));
