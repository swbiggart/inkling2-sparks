+
+    pub fn tap(dr: *const Drafter, t: usize) u64 {
+        return dr.taps + t * dr.cap * H * 2;
+    }
+
+    fn launch(dr: *const Drafter, c: *const Ctx, f: cuda.Function, grid: [3]usize, threads: usize, a: *cuda.Args) !void {
