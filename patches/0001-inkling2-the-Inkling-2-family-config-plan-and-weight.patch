+    try testing.expect(!s.unpin(&a));
+    try testing.expect(!s.unpin(&b));
+    s.pin(&b); // B is now newer than A
+    try testing.expect(!s.unpin(&b));
+    // E (4): 2 free -> A goes (oldest) -> 4 free but split -> B 2->0, C 4->2 in 2-row pieces, E at 12
