+
+test "Inkling 2 text: the release tokenizer and template (TF_INKLING2_DIR)" {
+    const dir = std.c.getenv("TF_INKLING2_DIR") orelse return error.SkipZigTest;
+    var arena = std.heap.ArenaAllocator.init(t.allocator);
+    defer arena.deinit();
