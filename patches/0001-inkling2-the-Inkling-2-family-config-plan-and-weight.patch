+    try std.testing.expect(!std.mem.eql(u8, &Lc.of(.{ null, null, null, "3,3,3,3,3" }), &Lc.of(.{ null, null, null, "3,3,3,3,10" })));
+    try std.testing.expect(!std.mem.eql(u8, &none, &Lc.of(.{ "attn,mlp,route,proj,conv,segs", null, null, null })));
