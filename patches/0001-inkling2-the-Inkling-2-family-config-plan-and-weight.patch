diff --git a/zig/src/families/inkling2/inventory.zig b/zig/src/families/inkling2/inventory.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6c53ba0ab85267b41bdb29b871b3349e5ccb8e09
--- /dev/null
+++ b/zig/src/families/inkling2/inventory.zig
@@ -0,0 +1,380 @@
+//! Inkling-2-Small's safetensors inventory: every tensor's file, dtype, shape and byte range, from the shard headers
+//! of a checkpoint folder or from the text form tools/zig/inkling2_inventory.py writes (fixtures/inventory.tsv).
+const std = @import("std");
+const Diag = @import("diag.zig").Diag;
+const fail = @import("diag.zig").fail;
+
+/// The dtypes the release stores. Any other refuses the checkpoint.
+pub const DType = enum {
+    bf16,
+    f32,
+    u8,
+    f8_e4m3,
+
+    pub fn size(d: DType) u64 {
+        return switch (d) {
+            .bf16 => 2,
+            .f32 => 4,
+            .u8, .f8_e4m3 => 1,
+        };
+    }
+
+    pub fn parse(text: []const u8) ?DType {
+        const names = .{ .{ "BF16", DType.bf16 }, .{ "F32", DType.f32 }, .{ "U8", DType.u8 }, .{ "F8_E4M3", DType.f8_e4m3 } };
+        inline for (names) |n| if (std.mem.eql(u8, text, n[0])) return n[1];
+        return null;
+    }
+
+    pub fn name(d: DType) []const u8 {
+        return switch (d) {
+            .bf16 => "BF16",
+            .f32 => "F32",
+            .u8 => "U8",
+            .f8_e4m3 => "F8_E4M3",
+        };
+    }
+};
+
+/// Which manifest section a tensor belongs to: the model's files, or the drafter's mtp.safetensors.
+pub const Section = enum { model, mtp };
+
+pub const mtp_file = "mtp.safetensors";
+
+pub const File = struct {
+    name: []const u8,
+    header_len: u64,
+
+    /// Where the data region starts: tensors' begin and end count from here.
+    pub fn dataStart(f: File) u64 {
+        return 8 + f.header_len;
+    }
+
+    pub fn section(f: File) Section {
+        return if (std.mem.eql(u8, f.name, mtp_file)) .mtp else .model;
+    }
+};
+
+pub const max_rank = 4;
+
+pub const Tensor = struct {
+    name: []const u8,
+    file: u16,
+    dtype: DType,
+    rank: u8,
+    shape: [max_rank]u64,
+    /// Bytes from the file's data start (safetensors' data_offsets).
+    begin: u64,
+    end: u64,
+
+    pub fn dim(t: Tensor, i: usize) u64 {
+        return if (i < t.rank) t.shape[i] else 1;
+    }
+
+    pub fn bytes(t: Tensor) u64 {
+        return t.end - t.begin;
+    }
+
+    pub fn is(t: Tensor, dtype: DType, shape: []const u64) bool {
+        if (t.dtype != dtype or t.rank != shape.len) return false;
+        for (shape, 0..) |d, i| if (t.shape[i] != d) return false;
+        return true;
+    }
+};
+
+pub const Inventory = struct {
+    arena: std.heap.ArenaAllocator,
+    files: []File,
+    tensors: []Tensor,
+
+    pub fn deinit(inv: *Inventory) void {
+        inv.arena.deinit();
+        inv.* = undefined;
+    }
+
+    pub fn section(inv: *const Inventory, t: Tensor) Section {
+        return inv.files[t.file].section();
+    }
+
+    /// Absolute byte offset of `t`'s first byte in its file.
+    pub fn offset(inv: *const Inventory, t: Tensor) u64 {
+        return inv.files[t.file].dataStart() + t.begin;
+    }
+
+    pub fn find(inv: *const Inventory, name: []const u8) ?Tensor {
+        for (inv.tensors) |t| if (std.mem.eql(u8, t.name, name)) return t;
+        return null;
+    }
+
+    pub fn totalBytes(inv: *const Inventory) u64 {
+        var n: u64 = 0;
+        for (inv.tensors) |t| n += t.bytes();
+        return n;
+    }
+
+    /// The text form: `file <index> <name> <header_len>` lines, then `t <file> <name> <dtype> <shape> <begin> <end>`.
+    pub fn fromText(gpa: std.mem.Allocator, text: []const u8, d: ?*Diag) !Inventory {
+        var arena: std.heap.ArenaAllocator = .init(gpa);
+        errdefer arena.deinit();
+        const a = arena.allocator();
+        var files: std.ArrayList(File) = .empty;
+        var tensors: std.ArrayList(Tensor) = .empty;
+        var lines = std.mem.splitScalar(u8, text, '\n');
+        while (lines.next()) |raw| {
+            const line = std.mem.trimEnd(u8, raw, "\r");
+            if (line.len == 0 or line[0] == '#') continue;
+            var f = std.mem.splitScalar(u8, line, '\t');
+            const kind = f.next().?;
+            if (std.mem.eql(u8, kind, "file")) {
+                const i = try std.fmt.parseInt(usize, f.next() orelse return error.BadInventory, 10);
+                if (i != files.items.len) return error.BadInventory;
+                const name = try a.dupe(u8, f.next() orelse return error.BadInventory);
+                const len = try std.fmt.parseInt(u64, f.next() orelse return error.BadInventory, 10);
+                _ = std.math.add(u64, 8, len) catch return fail(d, error.BadInventory, "file {s}: header length {d} puts its data past u64", .{ name, len });
+                try files.append(a, .{ .name = name, .header_len = len });
+            } else if (std.mem.eql(u8, kind, "t")) {
+                const file = try std.fmt.parseInt(u16, f.next() orelse return error.BadInventory, 10);
+                if (file >= files.items.len) return error.BadInventory;
+                var t: Tensor = .{ .name = try a.dupe(u8, f.next() orelse return error.BadInventory), .file = file, .dtype = undefined, .rank = 0, .shape = @splat(1), .begin = 0, .end = 0 };
+                const dt = f.next() orelse return error.BadInventory;
+                t.dtype = DType.parse(dt) orelse return fail(d, error.UnsupportedDType, "tensor {s} has dtype {s}, not one the release stores", .{ t.name, dt });
+                const dims = f.next() orelse return error.BadInventory;
+                if (dims.len > 0) {
+                    var parts = std.mem.splitScalar(u8, dims, ',');
+                    while (parts.next()) |x| {
+                        if (t.rank == max_rank) return error.BadInventory;
+                        t.shape[t.rank] = try std.fmt.parseInt(u64, x, 10);
+                        t.rank += 1;
+                    }
+                }
+                t.begin = try std.fmt.parseInt(u64, f.next() orelse return error.BadInventory, 10);
+                t.end = try std.fmt.parseInt(u64, f.next() orelse return error.BadInventory, 10);
+                try checkSize(t, d);
+                _ = std.math.add(u64, files.items[file].dataStart(), t.end) catch
+                    return fail(d, error.BadInventory, "tensor {s} ends past u64 in its file", .{t.name});
+                try tensors.append(a, t);
+            } else return error.BadInventory;
+        }
+        if (files.items.len == 0 or tensors.items.len == 0) return error.BadInventory;
+        try checkUnique(a, tensors.items, d);
+        try checkDisjoint(a, tensors.items, d);
+        return .{ .arena = arena, .files = files.items, .tensors = tensors.items };
+    }
+
+    /// The headers of `dir`'s shards (model.safetensors.index.json's files) and of its mtp.safetensors, when present.
+    pub fn fromDir(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, d: ?*Diag) !Inventory {
+        var arena: std.heap.ArenaAllocator = .init(gpa);
+        errdefer arena.deinit();
+        const a = arena.allocator();
+        var names = try shardNames(a, io, dir);
+        const mtp = try std.fs.path.join(a, &.{ dir, mtp_file });
+        if (std.Io.Dir.cwd().access(io, mtp, .{})) |_| {
+            try names.append(a, mtp_file);
+        } else |_| {}
+        var files: std.ArrayList(File) = .empty;
+        var tensors: std.ArrayList(Tensor) = .empty;
+        for (names.items, 0..) |name, i| {
+            const path = try std.fs.path.join(a, &.{ dir, name });
+            const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+            defer file.close(io);
+            const size = try file.length(io);
+            var prefix: [8]u8 = undefined;
+            if (try file.readPositionalAll(io, &prefix, 0) != prefix.len) return error.BadSafetensors;
+            const n = std.mem.readInt(u64, &prefix, .little);
+            if (n > 100_000_000 or size < 8 or n > size - 8) return error.BadSafetensors;
+            const text = try a.alloc(u8, @intCast(n));
+            if (try file.readPositionalAll(io, text, 8) != text.len) return error.BadSafetensors;
+            try files.append(a, .{ .name = name, .header_len = n });
+            try parseHeader(a, text, @intCast(i), size - 8 - n, &tensors, d);
+        }
+        try checkUnique(a, tensors.items, d);
+        try checkDisjoint(a, tensors.items, d);
+        return .{ .arena = arena, .files = files.items, .tensors = tensors.items };
+    }
+};
+
+/// model.safetensors.index.json's shard names, sorted.
+fn shardNames(a: std.mem.Allocator, io: std.Io, dir: []const u8) !std.ArrayList([]const u8) {
+    const index = try std.fs.path.join(a, &.{ dir, "model.safetensors.index.json" });
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, index, a, .limited(1 << 26));
+    const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+    if (doc != .object) return error.BadIndex;
+    const map = doc.object.get("weight_map") orelse return error.BadIndex;
+    if (map != .object) return error.BadIndex;
+    var seen: std.StringHashMapUnmanaged(void) = .empty;
+    var out: std.ArrayList([]const u8) = .empty;
+    var it = map.object.iterator();
+    while (it.next()) |e| {
+        if (e.value_ptr.* != .string) return error.BadIndex;
+        const f = e.value_ptr.string;
+        if (std.mem.indexOfAny(u8, f, "/\\") != null or std.mem.eql(u8, f, "..")) return error.BadIndex;
+        if ((try seen.getOrPut(a, f)).found_existing) continue;
+        try out.append(a, f);
+    }
+    std.mem.sort([]const u8, out.items, {}, struct {
+        fn lt(_: void, x: []const u8, y: []const u8) bool {
+            return std.mem.order(u8, x, y) == .lt;
+        }
+    }.lt);
+    return out;
+}
+
+fn parseHeader(a: std.mem.Allocator, text: []const u8, file: u16, data_len: u64, out: *std.ArrayList(Tensor), d: ?*Diag) !void {
+    const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+    if (doc != .object) return error.BadSafetensors;
+    var it = doc.object.iterator();
+    while (it.next()) |kv| {
+        if (std.mem.eql(u8, kv.key_ptr.*, "__metadata__")) continue;
+        const v = kv.value_ptr.*;
+        if (v != .object) return error.BadSafetensors;
+        const dt = v.object.get("dtype") orelse return error.BadSafetensors;
+        if (dt != .string) return error.BadSafetensors;
+        var t: Tensor = .{ .name = kv.key_ptr.*, .file = file, .dtype = undefined, .rank = 0, .shape = @splat(1), .begin = 0, .end = 0 };
+        t.dtype = DType.parse(dt.string) orelse return fail(d, error.UnsupportedDType, "tensor {s} has dtype {s}, not one the release stores", .{ t.name, dt.string });
+        const shape = v.object.get("shape") orelse return error.BadSafetensors;
+        if (shape != .array or shape.array.items.len > max_rank) return error.BadSafetensors;
+        for (shape.array.items, 0..) |dim, i| {
+            if (dim != .integer or dim.integer < 0) return error.BadSafetensors;
+            t.shape[i] = @intCast(dim.integer);
+        }
+        t.rank = @intCast(shape.array.items.len);
+        const offs = v.object.get("data_offsets") orelse return error.BadSafetensors;
+        if (offs != .array or offs.array.items.len != 2) return error.BadSafetensors;
+        for (offs.array.items) |o| if (o != .integer or o.integer < 0) return error.BadSafetensors;
+        t.begin = @intCast(offs.array.items[0].integer);
+        t.end = @intCast(offs.array.items[1].integer);
+        if (t.end > data_len) return fail(d, error.BadSafetensors, "tensor {s} ends past its file", .{t.name});
+        try checkSize(t, d);
+        try out.append(a, t);
+    }
+}
+
+fn checkSize(t: Tensor, d: ?*Diag) !void {
+    var n: u64 = t.dtype.size();
+    for (t.shape[0..t.rank]) |dim| n = std.math.mul(u64, n, dim) catch return error.BadSafetensors;
+    if (t.end < t.begin or t.end - t.begin != n)
+        return fail(d, error.BadSafetensors, "tensor {s} spans {d} bytes, its shape {d}", .{ t.name, t.end -| t.begin, n });
+}
+
+fn checkUnique(a: std.mem.Allocator, tensors: []const Tensor, d: ?*Diag) !void {
+    var seen: std.StringHashMapUnmanaged(void) = .empty;
+    defer seen.deinit(a);
+    for (tensors) |t| if ((try seen.getOrPut(a, t.name)).found_existing)
+        return fail(d, error.DuplicateTensor, "tensor {s} is in two files", .{t.name});
+}
+
+/// No two tensors of a file share a byte: sorted by file and begin, each starts at or past the one before's end.
+fn checkDisjoint(a: std.mem.Allocator, tensors: []const Tensor, d: ?*Diag) !void {
+    const order = try a.alloc(u32, tensors.len);
+    defer a.free(order);
+    for (order, 0..) |*o, i| o.* = @intCast(i);
+    std.mem.sort(u32, order, tensors, struct {
+        fn lt(ts: []const Tensor, x: u32, y: u32) bool {
+            const p = ts[x];
+            const q = ts[y];
+            if (p.file != q.file) return p.file < q.file;
+            return if (p.begin != q.begin) p.begin < q.begin else p.end < q.end;
+        }
+    }.lt);
+    for (order[0..order.len -| 1], order[@min(1, order.len)..]) |i, j| {
+        const p = tensors[i];
+        const q = tensors[j];
+        if (p.file == q.file and q.begin < p.end)
+            return fail(d, error.BadSafetensors, "tensors {s} and {s} overlap in their file", .{ p.name, q.name });
+    }
+}
+
+pub const fixture = @embedFile("fixtures/inventory.tsv");
+
+test "inkling2 inventory: the release's 1,854 tensors in 25 files, 393.5 GB" {
+    var inv = try Inventory.fromText(std.testing.allocator, fixture, null);
+    defer inv.deinit();
+    try std.testing.expectEqual(@as(usize, 25), inv.files.len);
+    try std.testing.expectEqual(@as(usize, 1854), inv.tensors.len);
+    try std.testing.expectEqual(@as(u64, 393_479_869_088), inv.totalBytes());
+    const w13 = inv.find("model.llm.layers.0.mlp.experts.w13_weight").?;
+    try std.testing.expect(w13.is(.u8, &.{ 384, 4608, 2304 }));
+    const mx = inv.find("model.llm.layers.47.mlp.experts.w2_weight").?;
+    try std.testing.expect(mx.is(.f8_e4m3, &.{ 384, 4608, 2304 }));
+    try std.testing.expectEqual(Section.mtp, inv.section(inv.find("markov_head.markov_w1.weight").?));
+    try std.testing.expectEqual(Section.model, inv.section(w13));
+    try std.testing.expectEqual(@as(u64, 8 + 17504), inv.offset(inv.find("model.llm.attn_res.attn_queries.0").?));
+}
+
+test "inkling2 inventory: a size that disagrees with the shape, an unknown dtype or a repeated name is refused" {
+    const head = "file\t0\tx.safetensors\t10\n";
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t4\t0\t6\n", null));
+    try std.testing.expectError(error.UnsupportedDType, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tF16\t4\t0\t8\n", null));
+    try std.testing.expectError(error.DuplicateTensor, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t4\t0\t8\nt\t0\ta\tBF16\t4\t8\t16\n", null));
+    var ok = try Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t4\t0\t8\n", null);
+    ok.deinit();
+}
+
+fn testShard(dir: std.Io.Dir, io: std.Io, name: []const u8, header: []const u8, data: usize) !void {
+    var buf: [512]u8 = undefined;
+    std.mem.writeInt(u64, buf[0..8], header.len, .little);
+    @memcpy(buf[8..][0..header.len], header);
+    @memset(buf[8 + header.len ..][0..data], 0);
+    try dir.writeFile(io, .{ .sub_path = name, .data = buf[0 .. 8 + header.len + data] });
+}
+
+test "inkling2 inventory: a folder's shard headers in index order, then mtp.safetensors" {
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(io, .{ .sub_path = "model.safetensors.index.json", .data = "{\"metadata\":{},\"weight_map\":{\"b\":\"model-00002-of-00002.safetensors\",\"a\":\"model-00001-of-00002.safetensors\"}}" });
+    const first = "{\"__metadata__\":{\"format\":\"pt\"},\"a\":{\"dtype\":\"BF16\",\"shape\":[2,3],\"data_offsets\":[0,12]}}";
+    try testShard(tmp.dir, io, "model-00001-of-00002.safetensors", first, 12);
+    try testShard(tmp.dir, io, "model-00002-of-00002.safetensors", "{\"b\":{\"dtype\":\"F8_E4M3\",\"shape\":[4],\"data_offsets\":[0,4]}}", 4);
+    try testShard(tmp.dir, io, mtp_file, "{\"fuse_weight\":{\"dtype\":\"F32\",\"shape\":[1],\"data_offsets\":[0,4]}}", 4);
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", std.testing.allocator);
+    defer std.testing.allocator.free(dir);
+    var inv = try Inventory.fromDir(std.testing.allocator, io, dir, null);
+    defer inv.deinit();
+    try std.testing.expectEqual(@as(usize, 3), inv.files.len);
+    try std.testing.expectEqualStrings("model-00001-of-00002.safetensors", inv.files[0].name);
+    try std.testing.expectEqualStrings(mtp_file, inv.files[2].name);
+    const a = inv.find("a").?;
+    try std.testing.expect(a.is(.bf16, &.{ 2, 3 }));
+    try std.testing.expectEqual(@as(u64, 8 + first.len), inv.offset(a));
+    try std.testing.expectEqual(Section.mtp, inv.section(inv.find("fuse_weight").?));
+    // a tensor past its file's end
+    try testShard(tmp.dir, io, "model-00002-of-00002.safetensors", "{\"b\":{\"dtype\":\"F8_E4M3\",\"shape\":[4],\"data_offsets\":[0,4]}}", 2);
+    var d: Diag = .{};
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromDir(std.testing.allocator, io, dir, &d));
+    try std.testing.expect(std.mem.indexOf(u8, d.text(), "ends past its file") != null);
+}
+
+test "inkling2 inventory: two tensors on one byte range of a file are refused" {
+    const head = "file\t0\tx.safetensors\t10\n";
+    var d: Diag = .{};
+    // b starts inside a, then the same range twice
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t4\t0\t8\nt\t0\tb\tBF16\t2\t4\t8\n", &d));
+    try std.testing.expect(std.mem.indexOf(u8, d.text(), "overlap") != null);
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromText(std.testing.allocator, head ++ "t\t0\tb\tBF16\t4\t0\t8\nt\t0\ta\tBF16\t4\t0\t8\n", null));
+    // a long tensor that covers a later one
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t8\t0\t16\nt\t0\tb\tBF16\t1\t4\t6\nt\t0\tc\tBF16\t1\t10\t12\n", null));
+    // the same range in two files is two tensors
+    var ok = try Inventory.fromText(std.testing.allocator, head ++ "file\t1\ty.safetensors\t10\nt\t0\ta\tBF16\t4\t0\t8\nt\t1\tb\tBF16\t4\t0\t8\n", null);
+    ok.deinit();
+}
+
+test "inkling2 inventory: a header length or byte range whose file offset passes u64 is refused" {
+    const head = "file\t0\tx.safetensors\t10\n";
+    var d: Diag = .{};
+    try std.testing.expectError(error.BadInventory, Inventory.fromText(std.testing.allocator, "file\t0\tx.safetensors\t18446744073709551615\nt\t0\ta\tBF16\t4\t0\t8\n", &d));
+    try std.testing.expectError(error.BadInventory, Inventory.fromText(std.testing.allocator, head ++ "t\t0\ta\tBF16\t4\t18446744073709551600\t18446744073709551608\n", &d));
+    try std.testing.expect(std.mem.indexOf(u8, d.text(), "past") != null);
+}
+
+test "inkling2 inventory: a shard header whose tensors share bytes is refused" {
+    const io = std.testing.io;
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    try tmp.dir.writeFile(io, .{ .sub_path = "model.safetensors.index.json", .data = "{\"metadata\":{},\"weight_map\":{\"a\":\"model-00001-of-00001.safetensors\",\"b\":\"model-00001-of-00001.safetensors\"}}" });
+    try testShard(tmp.dir, io, "model-00001-of-00001.safetensors", "{\"a\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[0,8]},\"b\":{\"dtype\":\"BF16\",\"shape\":[4],\"data_offsets\":[4,12]}}", 12);
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", std.testing.allocator);
+    defer std.testing.allocator.free(dir);
+    var d: Diag = .{};
+    try std.testing.expectError(error.BadSafetensors, Inventory.fromDir(std.testing.allocator, io, dir, &d));
+    try std.testing.expect(std.mem.indexOf(u8, d.text(), "overlap") != null);
+}
diff --git a/zig/src/families/inkling2/native.zig b/zig/src/families/inkling2/native.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d9261934ec5f2c6a72f011610eb65107b9b8fe15
--- /dev/null
+++ b/zig/src/families/inkling2/native.zig
@@ -0,0 +1,41 @@
+//! What the native host says for an Inkling-2-Small checkpoint while the family has no forward: the checkpoint is
+//! recognized and checked (config, quant manifest, every tensor's role, the rank plan at the requested world size),
+//! then refused by name rather than as an unknown model.
+const std = @import("std");
+const config = @import("config.zig");
+const describe = @import("describe.zig");
+const Diag = @import("diag.zig").Diag;
+
+pub const model_type = config.model_type;
+pub const architecture = config.architecture;
+pub const title = "Inkling-2-Small";
+
+pub fn recognizes(mt: []const u8) bool {
+    return std.mem.eql(u8, mt, model_type);
+}
+
+/// The open's problem for `dir` at `tp` ranks: what was read and checked, then that the forward is not built yet.
+pub fn refusal(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, dir: []const u8, tp: u32) ![]const u8 {
+    const not_yet = "the inkling2 family's forward is not implemented yet (family skeleton: tf-inkling2-plan prints the rank plan)";
+    var d: Diag = .{};
+    var x = describe.Model.fromDir(gpa, io, dir, .{ .world = @max(tp, 1) }, &d) catch |e| {
+        if (e == error.OutOfMemory) return e;
+        return std.fmt.allocPrint(a, "{s} ({s}, {s}): {s}: {s}", .{ title, model_type, architecture, if (d.len > 0) d.text() else @errorName(e), not_yet });
+    };
+    defer x.deinit();
+    var most: u64 = 0;
+    for (x.p.ranks) |r| most = @max(most, r.total());
+    return std.fmt.allocPrint(a, "{s} ({s}, {s}): config, quant manifest and {d} tensors checked; at --tp {d} the largest rank holds {d:.1} GiB of weights; {s}", .{
+        title, model_type, architecture, x.inv.tensors.len, x.p.split.world, @as(f64, @floatFromInt(most)) / describe.gib, not_yet,
+    });
+}
+
+test "inkling2 native: the refusal names the family and the missing forward, even for an unreadable folder" {
+    var arena: std.heap.ArenaAllocator = .init(std.testing.allocator);
+    defer arena.deinit();
+    const why = try refusal(arena.allocator(), std.testing.allocator, std.testing.io, "/nonexistent-inkling2-folder", 4);
+    try std.testing.expect(std.mem.indexOf(u8, why, "Inkling-2-Small (inkling2, Inkling2ForConditionalGeneration)") != null);
+    try std.testing.expect(std.mem.indexOf(u8, why, "config.json") != null);
+    try std.testing.expect(std.mem.indexOf(u8, why, "not implemented yet") != null);
+    try std.testing.expect(recognizes("inkling2") and !recognizes("inkling2_text"));
+}
diff --git a/zig/src/families/inkling2/plan.zig b/zig/src/families/inkling2/plan.zig
new file mode 100644
index 0000000000000000000000000000000000000000..43bdb390114357557938bcf9c0b2ef0ccccc3f15
--- /dev/null
+++ b/zig/src/families/inkling2/plan.zig
@@ -0,0 +1,514 @@
+//! The TP/EP slice plan: for world size W, each rank's query and key heads, its experts, the tensors every rank holds
+//! whole, and rank 0's and the drafter rank's own, as byte ranges inside the safetensors files.
+//!
+//! Attention is tensor-parallel by key head (a key head's query heads go with it: 12 query and 2 key heads a rank at
+//! W = 4). The MoE is placed one of two ways (`Layout`):
+//!   whole: expert-parallel (96 experts a rank at W = 4, or any split the caller gives, such as 93/97/97/97). Experts
+//!     are fused along axis 0 in the release, so a rank's experts are one contiguous byte range of each expert tensor.
+//!   split: every rank holds a 1/W row slice of every expert (checkpoint mode only; cuda_moe.zig `splitUp`): rows
+//!     [r*n/W, (r+1)*n/W) of each expert's w13 (n = 2I = 4608; the rows interleave gate and up, row 2i = gate_i and
+//!     2i + 1 = up_i, as TokenSpeed's `gate_up[:, 0::2]` and Transformers' Interleave converter read them, so the
+//!     slice is gate rows r*I/W .. and the matching up rows) and of w2 (n = H = 4608 output rows, all of K), the block
+//!     scales the same rows, and the per-expert amax whole on every rank. A slice is one strided run a tensor: 384 runs
+//!     of n/W rows, n rows apart.
+//! Heads split by canon's rule at equal weights (largest remainder, the first ranks one more), as the mesh layer's
+//! `shard.range` does. A query-head column cut (the output projection) is one run a row. The unembed is split by
+//! vocabulary entry (canon's rule over the padded vocabulary: 50,256 rows a rank at W = 4) under either expert layout,
+//! so every rank computes its share of the logits; the embed stays whole on rank 0.
+const std = @import("std");
+const inventory = @import("inventory.zig");
+const roles_mod = @import("roles.zig");
+const Config = @import("config.zig").Config;
+const Diag = @import("diag.zig").Diag;
+const fail = @import("diag.zig").fail;
+const Role = roles_mod.Role;
+const Placement = roles_mod.Placement;
+
+pub const max_world = 16;
+
+pub const Span = struct {
+    lo: u32,
+    hi: u32,
+
+    pub fn len(s: Span) u32 {
+        return s.hi - s.lo;
+    }
+};
+
+/// Rank `rank`'s share of `units` over `world` at equal weights: the first `units % world` ranks one more.
+pub fn canon(units: u32, rank: u32, world: u32) Span {
+    const base = units / world;
+    const extra = units % world;
+    const lo = rank * base + @min(rank, extra);
+    return .{ .lo = lo, .hi = lo + base + @intFromBool(rank < extra) };
+}
+
+/// How ranks hold the experts (see the header).
+pub const Layout = enum {
+    whole,
+    split,
+
+    /// TF_INK2_EXPERTS (whole when unset or unknown).
+    pub fn env() Layout {
+        const v = std.c.getenv("TF_INK2_EXPERTS") orelse return .whole;
+        return std.meta.stringToEnum(Layout, std.mem.span(v)) orelse .whole;
+    }
+};
+
+pub const Split = struct {
+    world: u32,
+    /// Experts a rank holds, in rank order: rank r holds the next `experts[r]` after rank r - 1's (whole); all of them
+    /// on every rank (split).
+    experts: [max_world]u32 = @splat(0),
+    /// The rank that holds the drafter (DSpark): the last rank, so rank 0 keeps room for the embed and unembed.
+    drafter: u32,
+    layout: Layout = .whole,
+
+    /// The even split: experts by canon's rule, the drafter on the last rank.
+    pub fn even(c: *const Config, world: u32, d: ?*Diag) !Split {
+        if (world == 0 or world > max_world) return fail(d, error.BadInkling2Split, "world size {d} is not from 1 to {d}", .{ world, max_world });
+        var s: Split = .{ .world = world, .drafter = world - 1 };
+        for (0..world) |r| s.experts[r] = canon(c.text.experts, @intCast(r), world).len();
+        return s.checked(c, d);
+    }
+
+    /// Experts a rank as given (`counts.len` is the world size).
+    pub fn uneven(c: *const Config, counts: []const u32, d: ?*Diag) !Split {
+        if (counts.len == 0 or counts.len > max_world) return fail(d, error.BadInkling2Split, "{d} expert counts: give 1 to {d}", .{ counts.len, max_world });
+        var s: Split = .{ .world = @intCast(counts.len), .drafter = @intCast(counts.len - 1) };
+        @memcpy(s.experts[0..counts.len], counts);
+        return s.checked(c, d);
+    }
+
+    /// Every expert on every rank, a 1/W row slice of each (see the header), the drafter on the last rank. The slices
+    /// must be whole column tiles of the checkpoint-mode kernels (128 rows) and h's slices whole MXFP8 blocks (32).
+    pub fn sliced(c: *const Config, world: u32, d: ?*Diag) !Split {
+        if (world == 0 or world > max_world) return fail(d, error.BadInkling2Split, "world size {d} is not from 1 to {d}", .{ world, max_world });
+        var s: Split = .{ .world = world, .drafter = world - 1, .layout = .split };
+        for (0..world) |r| s.experts[r] = c.text.experts;
+        const I = c.text.moe_intermediate;
+        const ok = (2 * I) % (128 * world) == 0 and c.text.hidden % (128 * world) == 0 and I % (32 * world) == 0;
+        if (!ok) return fail(d, error.BadInkling2Split, "split experts at world size {d}: {d} gate/up rows, {d} output rows and {d} h values a rank are not whole tiles (128 rows, 32 values)", .{ world, 2 * I / world, c.text.hidden / world, I / world });
+        if (world > c.text.kv_heads) return fail(d, error.BadInkling2Split, "world size {d} is more than the {d} key heads", .{ world, c.text.kv_heads });
+        return s;
+    }
+
+    fn checked(s: Split, c: *const Config, d: ?*Diag) !Split {
+        var sum: u64 = 0;
+        for (s.experts[0..s.world], 0..) |n, r| {
+            if (n == 0) return fail(d, error.BadInkling2Split, "rank {d} would hold no experts", .{r});
+            sum += n;
+        }
+        if (sum != c.text.experts) return fail(d, error.BadInkling2Split, "the expert counts sum to {d}, not {d}", .{ sum, c.text.experts });
+        if (s.world > c.text.kv_heads) return fail(d, error.BadInkling2Split, "world size {d} is more than the {d} key heads", .{ s.world, c.text.kv_heads });
+        if (s.drafter >= s.world) return fail(d, error.BadInkling2Split, "drafter rank {d} is not below world size {d}", .{ s.drafter, s.world });
+        return s;
+    }
+
+    pub fn expertSpan(s: Split, rank: u32) Span {
+        if (s.layout == .split) return .{ .lo = 0, .hi = s.experts[rank] };
+        var lo: u32 = 0;
+        for (s.experts[0..rank]) |n| lo += n;
+        return .{ .lo = lo, .hi = lo + s.experts[rank] };
+    }
+
+    /// The rows of each expert's `rows` (w13: 2I, w2: H) rank `rank` holds: all of them (whole), its 1/W (split).
+    pub fn rowSpan(s: Split, rows: u32, rank: u32) Span {
+        return if (s.layout == .split) canon(rows, rank, s.world) else .{ .lo = 0, .hi = rows };
+    }
+
+    /// How a rank holds a tensor of `role` under this split: the split layout's per-expert amax is whole on every rank.
+    pub fn placed(s: Split, role: Role) Placement {
+        if (s.layout == .split and role.placement == .experts and role.part == .amax) return .replicated;
+        return role.placement;
+    }
+
+    pub fn kvSpan(s: Split, c: *const Config, rank: u32) Span {
+        return canon(c.text.kv_heads, rank, s.world);
+    }
+
+    pub fn qSpan(s: Split, c: *const Config, rank: u32) Span {
+        const kv = s.kvSpan(c, rank);
+        const g = c.group();
+        return .{ .lo = kv.lo * g, .hi = kv.hi * g };
+    }
+};
+
+/// `count` runs of `len` bytes, `stride` apart, from `offset` (absolute, from the file's start).
+pub const Run = struct {
+    file: u16,
+    offset: u64,
+    len: u64,
+    stride: u64,
+    count: u64,
+
+    pub fn bytes(r: Run) u64 {
+        return r.len * r.count;
+    }
+};
+
+pub const Piece = struct {
+    tensor: u32,
+    run: Run,
+};
+
+/// The memory plan's columns.
+pub const Category = enum {
+    experts,
+    attention,
+    replicated,
+    embed,
+    vision,
+    drafter,
+
+    pub fn of(r: Role) Category {
+        return switch (r.placement) {
+            .experts => .experts,
+            .q_rows, .kv_rows, .q_cols, .kv_cols => .attention,
+            .replicated => .replicated,
+            .first, .vocab_rows => if (r.kind == .vision) .vision else .embed,
+            .drafter => .drafter,
+        };
+    }
+};
+pub const categories = @typeInfo(Category).@"enum".field_names.len;
+
+pub const Rank = struct {
+    rank: u32,
+    q: Span,
+    kv: Span,
+    experts: Span,
+    pieces: []Piece,
+    bytes: [categories]u64,
+
+    pub fn total(r: *const Rank) u64 {
+        var n: u64 = 0;
+        for (r.bytes) |b| n += b;
+        return n;
+    }
+};
+
+pub const Plan = struct {
+    arena: std.heap.ArenaAllocator,
+    split: Split,
+    ranks: []Rank,
+
+    pub fn deinit(p: *Plan) void {
+        p.arena.deinit();
+        p.* = undefined;
+    }
+};
+
+/// Rank `rank`'s run of tensor `t` under `role`, or null when the rank holds none of it.
+pub fn run(c: *const Config, inv: *const inventory.Inventory, t: inventory.Tensor, role: Role, split: Split, rank: u32) ?Run {
+    const base = inv.offset(t);
+    const whole: Run = .{ .file = t.file, .offset = base, .len = t.bytes(), .stride = t.bytes(), .count = 1 };
+    const placement = split.placed(role);
+    if (placement == .experts and split.layout == .split) {
+        // rows [lo, hi) of each expert: one run an expert, `rows` rows apart
+        if (t.rank != 3) return null;
+        const rows: u32 = @intCast(t.dim(1));
+        const span = split.rowSpan(rows, rank);
+        if (span.len() == 0) return null;
+        if (span.len() == rows) return whole;
+        const row = t.bytes() / (t.dim(0) * rows);
+        return .{ .file = t.file, .offset = base + @as(u64, span.lo) * row, .len = @as(u64, span.len()) * row, .stride = @as(u64, rows) * row, .count = t.dim(0) };
+    }
+    const span: Span = switch (placement) {
+        .replicated => return whole,
+        .first => return if (rank == 0) whole else null,
+        .drafter => return if (rank == split.drafter) whole else null,
+        .q_rows, .q_cols => split.qSpan(c, rank),
+        .kv_rows, .kv_cols => split.kvSpan(c, rank),
+        .experts => split.expertSpan(rank),
+        .vocab_rows => canon(c.text.vocab, rank, split.world),
+    };
+    if (span.len() == 0) return null;
+    switch (role.placement) {
+        .q_rows, .kv_rows, .experts, .vocab_rows => {
+            const row = t.bytes() / t.dim(0);
+            const off = base + @as(u64, span.lo) * role.unit * row;
+            const len = @as(u64, span.len()) * role.unit * row;
+            return .{ .file = t.file, .offset = off, .len = len, .stride = len, .count = 1 };
+        },
+        .q_cols, .kv_cols => {
+            const es = t.dtype.size();
+            return .{ .file = t.file, .offset = base + @as(u64, span.lo) * role.unit * es, .len = @as(u64, span.len()) * role.unit * es, .stride = t.dim(1) * es, .count = t.dim(0) };
+        },
+        else => unreachable,
+    }
+}
+
+pub fn build(gpa: std.mem.Allocator, c: *const Config, inv: *const inventory.Inventory, roles: []const Role, split: Split) !Plan {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    const ranks = try a.alloc(Rank, split.world);
+    for (ranks, 0..) |*r, i| {
+        const rank: u32 = @intCast(i);
+        var pieces: std.ArrayList(Piece) = .empty;
+        r.* = .{ .rank = rank, .q = split.qSpan(c, rank), .kv = split.kvSpan(c, rank), .experts = split.expertSpan(rank), .pieces = &.{}, .bytes = @splat(0) };
+        for (inv.tensors, roles, 0..) |t, role, ti| if (run(c, inv, t, role, split, rank)) |x| {
+            try pieces.append(a, .{ .tensor = @intCast(ti), .run = x });
+            r.bytes[@backingInt(Category.of(role))] += x.bytes();
+        };
+        r.pieces = pieces.items;
+    }
+    return .{ .arena = arena, .split = split, .ranks = ranks };
+}
+
+pub const Coverage = struct {
+    /// Bytes of every tensor in the checkpoint.
+    total: u64,
+    /// Bytes of the tensors every rank holds whole (counted once).
+    replicated: u64,
+    /// Bytes the ranks hold, over all ranks.
+    held: u64,
+};
+
+/// Checks that every byte of every tensor is held by exactly one rank, except replicated tensors, which every rank
+/// holds whole; and that no run leaves its tensor.
+pub fn verify(gpa: std.mem.Allocator, p: *const Plan, inv: *const inventory.Inventory, roles: []const Role, d: ?*Diag) !Coverage {
+    const Entry = struct { tensor: u32, rank: u32, run: Run };
+    var all: std.ArrayList(Entry) = .empty;
+    defer all.deinit(gpa);
+    var cov: Coverage = .{ .total = inv.totalBytes(), .replicated = 0, .held = 0 };
+    for (p.ranks) |r| for (r.pieces) |x| {
+        try all.append(gpa, .{ .tensor = x.tensor, .rank = r.rank, .run = x.run });
+        cov.held += x.run.bytes();
+    };
+    std.mem.sort(Entry, all.items, {}, struct {
+        fn lt(_: void, x: Entry, y: Entry) bool {
+            return if (x.tensor != y.tensor) x.tensor < y.tensor else x.rank < y.rank;
+        }
+    }.lt);
+    const Interval = struct { lo: u64, hi: u64 };
+    var spans: std.ArrayList(Interval) = .empty;
+    defer spans.deinit(gpa);
+    var i: usize = 0;
+    for (inv.tensors, roles, 0..) |t, role, ti| {
+        const lo = inv.offset(t);
+        const hi = lo + t.bytes();
+        var j = i;
+        while (j < all.items.len and all.items[j].tensor == ti) j += 1;
+        const mine = all.items[i..j];
+        i = j;
+        for (mine) |e| if (e.run.file != t.file) return fail(d, error.Inkling2PlanGap, "{s}: rank {d}'s run is in another file", .{ t.name, e.rank });
+        if (p.split.placed(role) == .replicated) {
+            cov.replicated += t.bytes();
+            if (mine.len != p.split.world) return fail(d, error.Inkling2PlanGap, "{s}: replicated on {d} of {d} ranks", .{ t.name, mine.len, p.split.world });
+            for (mine, 0..) |e, r| if (e.rank != r or e.run.offset != lo or e.run.bytes() != t.bytes() or e.run.count != 1)
+                return fail(d, error.Inkling2PlanGap, "{s}: rank {d} does not hold it whole", .{ t.name, e.rank });
+            continue;
+        }
+        spans.clearRetainingCapacity();
+        for (mine) |e| {
+            for (0..e.run.count) |k| {
+                const s = e.run.offset + k * e.run.stride;
+                try spans.append(gpa, .{ .lo = s, .hi = s + e.run.len });
+            }
+        }
+        std.mem.sort(Interval, spans.items, {}, struct {
+            fn lt(_: void, x: Interval, y: Interval) bool {
+                return x.lo < y.lo;
+            }
+        }.lt);
+        var at = lo;
+        for (spans.items) |s| {
+            if (s.lo != at) return fail(d, error.Inkling2PlanGap, "{s}: bytes {d} to {d} held {s}", .{ t.name, @min(at, s.lo) - lo, @max(at, s.lo) - lo, if (s.lo < at) "twice" else "by no rank" });
+            at = s.hi;
+        }
+        if (at != hi) return fail(d, error.Inkling2PlanGap, "{s}: its last {d} bytes held by no rank", .{ t.name, hi -| at });
+    }
+    if (cov.held != cov.total + (p.split.world - 1) * cov.replicated)
+        return fail(d, error.Inkling2PlanGap, "the ranks hold {d} bytes, not {d}", .{ cov.held, cov.total + (p.split.world - 1) * cov.replicated });
+    return cov;
+}
+
+const testing = std.testing;
+const config = @import("config.zig");
+const quant = @import("quant.zig");
+
+fn fixtures() !struct { c: Config, m: quant.Manifest, inv: inventory.Inventory, roles: []Role } {
+    const c = try config.parse(testing.allocator, config.fixture, null);
+    var m = try quant.parse(testing.allocator, quant.fixture, null);
+    errdefer m.deinit();
+    var inv = try inventory.Inventory.fromText(testing.allocator, inventory.fixture, null);
+    errdefer inv.deinit();
+    const roles = try roles_mod.classifyAll(testing.allocator, &c, &m, &inv, null);
+    return .{ .c = c, .m = m, .inv = inv, .roles = roles };
+}
+
+const gib: f64 = 1 << 30;
+
+test "inkling2 plan: canon's rule matches the mesh layer's (largest remainder, the first ranks one more)" {
+    try testing.expectEqual(Span{ .lo = 0, .hi = 3 }, canon(8, 0, 3));
+    try testing.expectEqual(Span{ .lo = 3, .hi = 6 }, canon(8, 1, 3));
+    try testing.expectEqual(Span{ .lo = 6, .hi = 8 }, canon(8, 2, 3));
+    try testing.expectEqual(Span{ .lo = 288, .hi = 384 }, canon(384, 3, 4));
+}
+
+test "inkling2 plan: every byte held once at W = 1, 2, 3 and 4 and at 93/97/97/97, replicated tensors on every rank" {
+    var f = try fixtures();
+    defer {
+        f.m.deinit();
+        f.inv.deinit();
+        testing.allocator.free(f.roles);
+    }
+    const uneven = [_]u32{ 93, 97, 97, 97 };
+    var replicated: ?u64 = null;
+    for ([_]u32{ 1, 2, 3, 4, 0 }) |w| {
+        const split = if (w == 0) try Split.uneven(&f.c, &uneven, null) else try Split.even(&f.c, w, null);
+        var p = try build(testing.allocator, &f.c, &f.inv, f.roles, split);
+        defer p.deinit();
+        var d: Diag = .{};
+        const cov = verify(testing.allocator, &p, &f.inv, f.roles, &d) catch |e| {
+            std.debug.print("world {d}: {s}\n", .{ split.world, d.text() });
+            return e;
+        };
+        try testing.expectEqual(@as(u64, 393_479_869_088), cov.total);
+        if (replicated) |r| try testing.expectEqual(r, cov.replicated) else replicated = cov.replicated;
+        var experts: u32 = 0;
+        var q: u32 = 0;
+        for (p.ranks) |r| {
+            try testing.expectEqual(experts, r.experts.lo);
+            experts = r.experts.hi;
+            try testing.expectEqual(q, r.q.lo);
+            q = r.q.hi;
+            try testing.expectEqual(r.q.len(), 6 * r.kv.len());
+        }
+        try testing.expectEqual(@as(u32, 384), experts);
+        try testing.expectEqual(@as(u32, 48), q);
+    }
+}
+
+test "inkling2 plan: W = 4 reproduces the plan's table (GiB a rank)" {
+    var f = try fixtures();
+    defer {
+        f.m.deinit();
+        f.inv.deinit();
+        testing.allocator.free(f.roles);
+    }
+    var p = try build(testing.allocator, &f.c, &f.inv, f.roles, try Split.even(&f.c, 4, null));
+    defer p.deinit();
+    for (p.ranks) |r| {
+        try testing.expectEqual(@as(u32, 12), r.q.len());
+        try testing.expectEqual(@as(u32, 2), r.kv.len());
+        try testing.expectEqual(@as(u32, 96), r.experts.len());
+        try testing.expectApproxEqAbs(@as(f64, 87.6), @as(f64, @floatFromInt(r.bytes[@backingInt(Category.experts)])) / gib, 0.05);
+        try testing.expectApproxEqAbs(@as(f64, 2.2), @as(f64, @floatFromInt(r.bytes[@backingInt(Category.attention)])) / gib, 0.05);
+        try testing.expectApproxEqAbs(@as(f64, 0.2), @as(f64, @floatFromInt(r.bytes[@backingInt(Category.replicated)])) / gib, 0.05);
+    }
+    // rank 0: the embed (1.73 GiB), the vision tower and a quarter of the unembed; every other rank a quarter of the
+    // unembed (50,256 rows of 4608 bf16)
+    const first = @as(f64, @floatFromInt(p.ranks[0].bytes[@backingInt(Category.embed)] + p.ranks[0].bytes[@backingInt(Category.vision)])) / gib;
+    try testing.expectApproxEqAbs(@as(f64, 4.1 - 3 * 0.43), first, 0.05);
+    try testing.expectApproxEqAbs(@as(f64, 3.2), @as(f64, @floatFromInt(p.ranks[3].bytes[@backingInt(Category.drafter)])) / gib, 0.05);
+    try testing.expectEqual(@as(u64, 0), p.ranks[1].bytes[@backingInt(Category.drafter)]);
+    for (1..4) |r| try testing.expectEqual(@as(u64, 50256 * 4608 * 2), p.ranks[r].bytes[@backingInt(Category.embed)]);
+    const u = f.inv.find("model.llm.unembed.weight").?;
+    var seen = false;
+    for (p.ranks[3].pieces) |x| if (std.mem.eql(u8, f.inv.tensors[x.tensor].name, u.name)) {
+        try testing.expectEqual(f.inv.offset(u) + 3 * 50256 * 4608 * 2, x.run.offset);
+        try testing.expectEqual(@as(u64, 50256 * 4608 * 2), x.run.len);
+        seen = true;
+    };
+    try testing.expect(seen);
+    // rank 2's experts 192-287 of layer 0's gate-up are one run: 96 experts of 4608 x 2304 bytes
+    const t = f.inv.find("model.llm.layers.0.mlp.experts.w13_weight").?;
+    for (p.ranks[2].pieces) |x| if (std.mem.eql(u8, f.inv.tensors[x.tensor].name, t.name)) {
+        try testing.expectEqual(@as(u64, 1), x.run.count);
+        try testing.expectEqual(f.inv.offset(t) + 192 * 4608 * 2304, x.run.offset);
+        try testing.expectEqual(@as(u64, 96 * 4608 * 2304), x.run.len);
+    };
+}
+
+test "inkling2 plan: split experts at W = 1, 2, 3 and 4 hold every byte once (amax on every rank), W = 4 a quarter of each expert's rows" {
+    var f = try fixtures();
+    defer {
+        f.m.deinit();
+        f.inv.deinit();
+        testing.allocator.free(f.roles);
+    }
+    var whole = try build(testing.allocator, &f.c, &f.inv, f.roles, try Split.even(&f.c, 4, null));
+    defer whole.deinit();
+    for ([_]u32{ 1, 2, 3, 4 }) |w| {
+        var p = try build(testing.allocator, &f.c, &f.inv, f.roles, try Split.sliced(&f.c, w, null));
+        defer p.deinit();
+        var d: Diag = .{};
+        _ = verify(testing.allocator, &p, &f.inv, f.roles, &d) catch |e| {
+            std.debug.print("split world {d}: {s}\n", .{ w, d.text() });
+            return e;
+        };
+        for (p.ranks) |r| try testing.expectEqual(Span{ .lo = 0, .hi = 384 }, r.experts);
+        if (w != 4) continue;
+        // the same bytes a rank as whole experts, give or take the amax every rank now holds whole
+        for (p.ranks, whole.ranks) |r, x| {
+            const a = r.bytes[@backingInt(Category.experts)];
+            const b = x.bytes[@backingInt(Category.experts)];
+            try testing.expect(a >= b and a - b < 1 << 20);
+            try testing.expectEqual(r.total() - a, x.total() - b);
+        }
+        // rank 2's slice of layer 0's gate-up: rows 2304 .. 3455 of each expert (gate/up pairs 1152 .. 1727)
+        const t = f.inv.find("model.llm.layers.0.mlp.experts.w13_weight").?;
+        const sc = f.inv.find("model.llm.layers.40.mlp.experts.w2_weight_scale").?;
+        const am = f.inv.find("model.llm.layers.0.mlp.experts.w2_weight_amax").?;
+        var seen: u32 = 0;
+        for (p.ranks[2].pieces) |x| {
+            const name = f.inv.tensors[x.tensor].name;
+            if (std.mem.eql(u8, name, t.name)) {
+                try testing.expectEqual(Run{ .file = t.file, .offset = f.inv.offset(t) + 2304 * 2304, .len = 1152 * 2304, .stride = 4608 * 2304, .count = 384 }, x.run);
+                seen += 1;
+            } else if (std.mem.eql(u8, name, sc.name)) {
+                // MXFP8 w2 scales: 4608 rows of 2304 / 32 a row
+                try testing.expectEqual(Run{ .file = sc.file, .offset = f.inv.offset(sc) + 2304 * 72, .len = 1152 * 72, .stride = 4608 * 72, .count = 384 }, x.run);
+                seen += 1;
+            } else if (std.mem.eql(u8, name, am.name)) {
+                try testing.expectEqual(@as(u64, 384 * 4), x.run.bytes());
+                seen += 1;
+            }
+        }
+        try testing.expectEqual(@as(u32, 3), seen);
+        // the head under split experts too: every rank a quarter of the unembed by vocabulary (50,256 rows of 4608
+        // bf16), rank 3's at its offset
+        for (1..4) |r| try testing.expectEqual(@as(u64, 50256 * 4608 * 2), p.ranks[r].bytes[@backingInt(Category.embed)]);
+        const u = f.inv.find("model.llm.unembed.weight").?;
+        var head_seen = false;
+        for (p.ranks[3].pieces) |x| if (std.mem.eql(u8, f.inv.tensors[x.tensor].name, u.name)) {
+            try testing.expectEqual(Run{ .file = u.file, .offset = f.inv.offset(u) + 3 * 50256 * 4608 * 2, .len = 50256 * 4608 * 2, .stride = 50256 * 4608 * 2, .count = 1 }, x.run);
+            head_seen = true;
+        };
+        try testing.expect(head_seen);
+    }
+    try testing.expectError(error.BadInkling2Split, Split.sliced(&f.c, 5, null));
+    try testing.expectError(error.BadInkling2Split, Split.sliced(&f.c, 8, null));
+}
+
+test "inkling2 plan: splits that leave a rank empty, miscount the experts or outnumber the key heads are refused" {
+    const c = try config.parse(testing.allocator, config.fixture, null);
+    try testing.expectError(error.BadInkling2Split, Split.uneven(&c, &.{ 100, 100, 100, 100 }, null));
+    try testing.expectError(error.BadInkling2Split, Split.uneven(&c, &.{ 384, 0 }, null));
+    try testing.expectError(error.BadInkling2Split, Split.even(&c, 9, null));
+    try testing.expectError(error.BadInkling2Split, Split.even(&c, 0, null));
+}
+
+test "inkling2 plan: a replicated tensor's piece in another file is refused" {
+    var f = try fixtures();
+    defer {
+        f.m.deinit();
+        f.inv.deinit();
+        testing.allocator.free(f.roles);
+    }
+    var p = try build(testing.allocator, &f.c, &f.inv, f.roles, try Split.even(&f.c, 2, null));
+    defer p.deinit();
+    var moved: ?[]const u8 = null;
+    for (p.ranks[1].pieces) |*x| if (f.roles[x.tensor].placement == .replicated) {
+        x.run.file = @intCast((x.run.file + 1) % f.inv.files.len);
+        moved = f.inv.tensors[x.tensor].name;
+        break;
+    };
+    var d: Diag = .{};
+    try testing.expectError(error.Inkling2PlanGap, verify(testing.allocator, &p, &f.inv, f.roles, &d));
+    try testing.expect(std.mem.indexOf(u8, d.text(), moved.?) != null);
+    try testing.expect(std.mem.indexOf(u8, d.text(), "another file") != null);
+}
diff --git a/zig/src/families/inkling2/plan_main.zig b/zig/src/families/inkling2/plan_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ee68aa83ad180be5cd13abee1aeedbb9d8465250
--- /dev/null
+++ b/zig/src/families/inkling2/plan_main.zig
@@ -0,0 +1,134 @@
+//! tf-inkling2-plan: Inkling-2-Small's rank plan, checked against a checkpoint folder or the release's inventory.
+const std = @import("std");
+const ink = @import("inkling2");
+
+const usage =
+    \\usage: tf-inkling2-plan [options]
+    \\  --dir DIR          read DIR's config.json, hf_quant_config.json and safetensors headers
+    \\                     (default: the release's files as embedded at build time)
+    \\  --inventory FILE   the inventory's text form (tools/zig/inkling2_inventory.py) instead of DIR's headers
+    \\  --world N          ranks, experts split evenly (default 4)
+    \\  --experts A,B,..   experts a rank, in rank order (sets the world size), e.g. 93,97,97,97
+    \\  --experts split    every expert on every rank, a 1/W row slice of each (w13 gate/up pairs, w2 output rows,
+    \\                     their scales; amax whole): the checkpoint-mode split layout (--experts whole: the default)
+    \\  --drafter R        the rank holding the DSpark drafter (default: the last)
+    \\  --positions N      KV pool positions (default 524288)
+    \\  --streams N        streams for the per-stream state line (default 8)
+    \\  --ranges R         print rank R's byte ranges instead of the table
+    \\  --digests OUT      hash every rank's pieces from --dir (the source checkpoint) into OUT, the content-digest
+    \\                     manifest tf-inkling2-cuda checks its loaded bytes against (one file for all ranks)
+    \\  --layers A:B       with --digests: only the pieces of layers A .. B-1
+    \\  --jobs N           with --digests: reading threads (default 8)
+    \\
+;
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const gpa = init.gpa;
+    const io = init.io;
+    const args = try init.minimal.args.toSlice(a);
+    var dir: ?[]const u8 = null;
+    var inventory_path: ?[]const u8 = null;
+    var want: ink.describe.Want = .{};
+    var positions: u64 = 524288;
+    var streams: u64 = 8;
+    var ranges: ?u32 = null;
+    var digests: ?[]const u8 = null;
+    var layers: ?[2]u32 = null;
+    var jobs: usize = 8;
+    var counts: std.ArrayList(u32) = .empty;
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        const k = args[i];
+        if (std.mem.eql(u8, k, "--help") or std.mem.eql(u8, k, "-h")) {
+            std.debug.print("{s}", .{usage});
+            return 0;
+        }
+        if (i + 1 >= args.len) {
+            std.debug.print("{s}", .{usage});
+            return 2;
+        }
+        const v = args[i + 1];
+        i += 1;
+        if (std.mem.eql(u8, k, "--dir")) dir = v else if (std.mem.eql(u8, k, "--inventory")) inventory_path = v else if (std.mem.eql(u8, k, "--world")) {
+            want.world = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--experts")) {
+            if (std.meta.stringToEnum(ink.plan.Layout, v)) |l| {
+                want.layout = l;
+                continue;
+            }
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |n| try counts.append(a, try std.fmt.parseInt(u32, n, 10));
+        } else if (std.mem.eql(u8, k, "--drafter")) {
+            want.drafter = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--positions")) {
+            positions = try std.fmt.parseInt(u64, v, 10);
+        } else if (std.mem.eql(u8, k, "--streams")) {
+            streams = try std.fmt.parseInt(u64, v, 10);
+        } else if (std.mem.eql(u8, k, "--ranges")) {
+            ranges = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--digests")) {
+            digests = v;
+        } else if (std.mem.eql(u8, k, "--jobs")) {
+            jobs = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--layers")) {
+            const colon = std.mem.indexOfScalar(u8, v, ':') orelse return 2;
+            layers = .{ try std.fmt.parseInt(u32, v[0..colon], 10), try std.fmt.parseInt(u32, v[colon + 1 ..], 10) };
+        } else {
+            std.debug.print("unknown option {s}\n{s}", .{ k, usage });
+            return 2;
+        }
+    }
+    want.experts = counts.items;
+    var d: ink.Diag = .{};
+    var model = open(a, gpa, io, dir, inventory_path, want, &d) catch |e| {
+        std.debug.print("FAIL tf-inkling2-plan: {t}: {s}\n", .{ e, d.text() });
+        return 1;
+    };
+    defer model.deinit();
+    var buf: [8192]u8 = undefined;
+    if (digests) |path| {
+        if (dir == null or inventory_path != null) {
+            std.debug.print("--digests reads the source checkpoint: give --dir (and no --inventory)\n", .{});
+            return 2;
+        }
+        const tmp = try std.fmt.allocPrint(a, "{s}.tmp", .{path});
+        const file = try std.Io.Dir.cwd().createFile(io, tmp, .{});
+        var fw = file.writer(io, &buf);
+        digestsTo(gpa, io, &fw.interface, dir.?, &model, layers, jobs) catch |e| {
+            file.close(io);
+            std.debug.print("FAIL tf-inkling2-plan --digests: {t}\n", .{e});
+            return 1;
+        };
+        file.close(io);
+        try std.Io.Dir.cwd().rename(tmp, std.Io.Dir.cwd(), path, io);
+        std.debug.print("{s}: world {d}\n", .{ path, model.p.split.world });
+        return 0;
+    }
+    var out = std.Io.File.stdout().writer(io, &buf);
+    if (ranges) |r| {
+        if (r >= model.p.split.world) {
+            std.debug.print("--ranges {d}: the world size is {d}\n", .{ r, model.p.split.world });
+            return 2;
+        }
+        try ink.describe.ranges(&out.interface, &model, r);
+    } else try ink.describe.report(&out.interface, &model, positions, streams);
+    try out.interface.flush();
+    return 0;
+}
+
+fn digestsTo(gpa: std.mem.Allocator, io: std.Io, w: *std.Io.Writer, dir: []const u8, model: *const ink.describe.Model, layers: ?[2]u32, jobs: usize) !void {
+    try ink.digests.write(gpa, io, w, dir, model, layers, jobs);
+    try w.flush();
+}
+
+fn open(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, dir: ?[]const u8, inventory_path: ?[]const u8, want: ink.describe.Want, d: *ink.Diag) !ink.describe.Model {
+    const inv_text: ?[]const u8 = if (inventory_path) |p| try std.Io.Dir.cwd().readFileAlloc(io, p, a, .limited(1 << 26)) else null;
+    if (dir) |root| {
+        if (inv_text == null) return ink.describe.Model.fromDir(gpa, io, root, want, d);
+        const cfg = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ root, "config.json" }), a, .limited(1 << 22));
+        const q = try std.Io.Dir.cwd().readFileAlloc(io, try std.fs.path.join(a, &.{ root, "hf_quant_config.json" }), a, .limited(1 << 24));
+        return ink.describe.Model.fromTexts(gpa, cfg, q, inv_text.?, want, d);
+    }
+    return ink.describe.Model.fromTexts(gpa, ink.config.fixture, ink.quant.fixture, inv_text orelse ink.inventory.fixture, want, d);
+}
diff --git a/zig/src/families/inkling2/quant.zig b/zig/src/families/inkling2/quant.zig
new file mode 100644
index 0000000000000000000000000000000000000000..262854e6ad9fb593b86469d875fa630fe3d9d5d9
--- /dev/null
+++ b/zig/src/families/inkling2/quant.zig
@@ -0,0 +1,273 @@
+//! The release's quantization manifest (hf_quant_config.json, `quant_method: inkling2`): which tensors are stored in
+//! which format, at which compute and output dtypes, and how the activations into them must be quantized.
+//!
+//! Each parameter group lists its tensors by name. A quantized weight's companions (its block scales, its per-expert
+//! amax and its outer scale denominator) are not listed: `roles.zig` attaches them to their weight's group. A group
+//! whose settings are not one of the four formats below is refused, as is a key the parser does not know.
+const std = @import("std");
+const Diag = @import("diag.zig").Diag;
+const fail = @import("diag.zig").fail;
+const Section = @import("inventory.zig").Section;
+
+/// The storage formats the release uses.
+pub const Format = enum {
+    /// float32, cast: the attention residual's queries and the router's selection bias.
+    fp32,
+    /// bfloat16, cast: attention, router weights, norms, convolutions, embed, unembed, vision tower, drafter.
+    bf16,
+    /// NVFP4: packed E2M1 pairs, an E4M3 scale per 16 values of a row, an fp32 amax per expert and an outer scale
+    /// denominator (weight_scale_format amax_denominator). Experts of layers 0-39.
+    nvfp4,
+    /// MXFP8: E4M3 values, a UE8M0 scale per 32 values of a row. Experts of layers 40-47.
+    mxfp8,
+
+    pub fn name(f: Format) []const u8 {
+        return switch (f) {
+            .fp32 => "FP32",
+            .bf16 => "BF16",
+            .nvfp4 => "NVFP4",
+            .mxfp8 => "MXFP8",
+        };
+    }
+};
+
+/// How activations entering a quantized weight's matmul must be quantized (required_activation_quantization).
+pub const ActQuant = struct {
+    format: enum { nvfp4_e2m1, mxfp8_e4m3 },
+    block: u32,
+    scale: enum { e4m3, ue8m0 },
+    /// amax_type per_token: the NVFP4 outer scale is chosen per token.
+    per_token: bool = false,
+    /// scale_selection_rule fouroversix_mae: each 16-block's scale is the better of two candidates (by mean
+    /// absolute error), as TokenSpeed's numerics define it. The method is Four Over Six (mit-han-lab/fouroversix,
+    /// arXiv:2512.02010).
+    two_candidates: bool = false,
+};
+
+pub const Group = struct {
+    format: Format,
+    /// The matmul's output dtype as the manifest gives it (output_dtype; fwd_output_dtype when given, the unembed's
+    /// float32 logits).
+    output: []const u8,
+    fwd_output: ?[]const u8 = null,
+    act: ?ActQuant = null,
+    /// weight_block_shape: [] for the cast formats, [1, 16] NVFP4, [32, 32] MXFP8 (the stored scales are one per
+    /// row and 32 values; see roles.zig's shape checks).
+    block: [2]u32 = .{ 0, 0 },
+    tensors: []const []const u8,
+};
+
+pub const Manifest = struct {
+    arena: std.heap.ArenaAllocator,
+    model: []Group,
+    mtp: []Group,
+    index: [2]std.StringHashMapUnmanaged(u16),
+
+    pub fn deinit(m: *Manifest) void {
+        m.arena.deinit();
+        m.* = undefined;
+    }
+
+    pub fn groups(m: *const Manifest, s: Section) []const Group {
+        return switch (s) {
+            .model => m.model,
+            .mtp => m.mtp,
+        };
+    }
+
+    /// The group that lists `name` in section `s`, or null when the manifest does not list it.
+    pub fn lookup(m: *const Manifest, s: Section, name: []const u8) ?*const Group {
+        const i = m.index[@backingInt(s)].get(name) orelse return null;
+        return &m.groups(s)[i];
+    }
+
+    pub fn read(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, d: ?*Diag) !Manifest {
+        const path = try std.fs.path.join(gpa, &.{ dir, "hf_quant_config.json" });
+        defer gpa.free(path);
+        const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 24)) catch |e|
+            return fail(d, e, "cannot read hf_quant_config.json: {t}", .{e});
+        defer gpa.free(bytes);
+        return parse(gpa, bytes, d);
+    }
+};
+
+const group_keys = [_][]const u8{ "compute_dtype", "output_dtype", "fwd_output_dtype", "required_activation_quantization", "tensors", "weight_block_shape", "weight_transform", "weight_scale_format" };
+
+fn str(o: std.json.ObjectMap, key: []const u8) ?[]const u8 {
+    const v = o.get(key) orelse return null;
+    return if (v == .string) v.string else null;
+}
+
+fn eql(a: ?[]const u8, b: []const u8) bool {
+    return if (a) |x| std.mem.eql(u8, x, b) else false;
+}
+
+fn actQuant(v: std.json.Value, d: ?*Diag) !?ActQuant {
+    if (v == .null) return null;
+    if (v != .object) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: required_activation_quantization is not an object", .{});
+    const o = v.object;
+    var it = o.iterator();
+    while (it.next()) |e| {
+        const k = e.key_ptr.*;
+        const known = for ([_][]const u8{ "amax_type", "block_size", "format", "rounding", "scale_dtype", "scale_selection_rule" }) |x| {
+            if (std.mem.eql(u8, x, k)) break true;
+        } else false;
+        if (!known) return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: activation quantization key {s} is not known", .{k});
+    }
+    const block = o.get("block_size") orelse return fail(d, error.BadInkling2Quant, "hf_quant_config.json: activation quantization lacks block_size", .{});
+    if (block != .integer) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: block_size is not an integer", .{});
+    if (!eql(str(o, "rounding"), "nearest")) return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: activation rounding is not nearest", .{});
+    const format = str(o, "format") orelse "";
+    const scale = str(o, "scale_dtype") orelse "";
+    if (std.mem.eql(u8, format, "nvfp4_e2m1") and block.integer == 16 and std.mem.eql(u8, scale, "float8_e4m3fn") and
+        eql(str(o, "amax_type"), "per_token") and eql(str(o, "scale_selection_rule"), "fouroversix_mae"))
+        return .{ .format = .nvfp4_e2m1, .block = 16, .scale = .e4m3, .per_token = true, .two_candidates = true };
+    if (std.mem.eql(u8, format, "mxfp8_e4m3") and block.integer == 32 and std.mem.eql(u8, scale, "ue8m0") and
+        o.get("amax_type") == null and o.get("scale_selection_rule") == null)
+        return .{ .format = .mxfp8_e4m3, .block = 32, .scale = .ue8m0 };
+    return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: activation quantization {s} at {d} with {s} scales is not built", .{ format, block.integer, scale });
+}
+
+fn blockShape(v: ?std.json.Value, d: ?*Diag) ![2]u32 {
+    const x = v orelse return .{ 0, 0 };
+    if (x != .array or (x.array.items.len != 0 and x.array.items.len != 2)) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: weight_block_shape is not [] or [rows, columns]", .{});
+    if (x.array.items.len == 0) return .{ 0, 0 };
+    var out: [2]u32 = undefined;
+    for (x.array.items, &out) |e, *o| {
+        if (e != .integer or e.integer <= 0 or e.integer > 1 << 16) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: weight_block_shape is not [rows, columns]", .{});
+        o.* = @intCast(e.integer);
+    }
+    return out;
+}
+
+fn group(a: std.mem.Allocator, v: std.json.Value, d: ?*Diag) !Group {
+    if (v != .object) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: a parameter group is not an object", .{});
+    const o = v.object;
+    var it = o.iterator();
+    while (it.next()) |e| {
+        const known = for (group_keys) |x| {
+            if (std.mem.eql(u8, x, e.key_ptr.*)) break true;
+        } else false;
+        if (!known) return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: parameter group key {s} is not known", .{e.key_ptr.*});
+    }
+    const compute = str(o, "compute_dtype") orelse "";
+    const transform = str(o, "weight_transform") orelse "";
+    const output = str(o, "output_dtype") orelse return fail(d, error.BadInkling2Quant, "hf_quant_config.json: a group lacks output_dtype", .{});
+    const act = try actQuant(o.get("required_activation_quantization") orelse .null, d);
+    const block = try blockShape(o.get("weight_block_shape"), d);
+    const list = o.get("tensors") orelse return fail(d, error.BadInkling2Quant, "hf_quant_config.json: a group lacks tensors", .{});
+    if (list != .array) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: tensors is not a list", .{});
+    const names = try a.alloc([]const u8, list.array.items.len);
+    for (list.array.items, names) |x, *n| {
+        if (x != .string) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: a tensor name is not a string", .{});
+        n.* = x.string;
+    }
+    var g: Group = .{ .format = undefined, .output = output, .fwd_output = str(o, "fwd_output_dtype"), .act = act, .block = block, .tensors = names };
+    const cast = std.mem.eql(u8, transform, "cast") and act == null and block[0] == 0 and o.get("weight_scale_format") == null;
+    if (cast and std.mem.eql(u8, compute, "float32") and std.mem.eql(u8, output, "float32")) {
+        g.format = .fp32;
+    } else if (cast and std.mem.eql(u8, compute, "bfloat16") and std.mem.eql(u8, output, "bfloat16") and
+        (g.fwd_output == null or eql(g.fwd_output, "float32")))
+    {
+        g.format = .bf16;
+    } else if (std.mem.eql(u8, compute, "nvfp4") and std.mem.eql(u8, transform, "nvfp4_nearest") and std.mem.eql(u8, output, "uint8") and
+        block[0] == 1 and block[1] == 16 and eql(str(o, "weight_scale_format"), "amax_denominator") and act != null and act.?.format == .nvfp4_e2m1)
+    {
+        g.format = .nvfp4;
+    } else if (std.mem.eql(u8, compute, "mxfp8") and std.mem.eql(u8, transform, "mxfp8_nearest") and std.mem.eql(u8, output, "float8_e4m3fn") and
+        block[0] == 32 and block[1] == 32 and o.get("weight_scale_format") == null and act != null and act.?.format == .mxfp8_e4m3)
+    {
+        g.format = .mxfp8;
+    } else return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: a group computing {s} with transform {s} is not one of FP32, BF16, NVFP4 or MXFP8", .{ compute, transform });
+    return g;
+}
+
+fn groups(a: std.mem.Allocator, root: std.json.ObjectMap, key: []const u8, index: *std.StringHashMapUnmanaged(u16), d: ?*Diag) ![]Group {
+    const s = root.get(key) orelse return fail(d, error.BadInkling2Quant, "hf_quant_config.json lacks {s}", .{key});
+    if (s != .object) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: {s} is not an object", .{key});
+    var it = s.object.iterator();
+    while (it.next()) |e| if (!std.mem.eql(u8, e.key_ptr.*, "parameter_groups"))
+        return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: {s}.{s} is not known", .{ key, e.key_ptr.* });
+    const list = s.object.get("parameter_groups") orelse return fail(d, error.BadInkling2Quant, "hf_quant_config.json: {s} lacks parameter_groups", .{key});
+    if (list != .array) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: {s}.parameter_groups is not a list", .{key});
+    const out = try a.alloc(Group, list.array.items.len);
+    for (list.array.items, out, 0..) |v, *g, i| {
+        g.* = try group(a, v, d);
+        for (g.tensors) |n| {
+            const slot = try index.getOrPut(a, n);
+            if (slot.found_existing) return fail(d, error.BadInkling2Quant, "hf_quant_config.json: {s} is in two groups", .{n});
+            slot.value_ptr.* = @intCast(i);
+        }
+    }
+    return out;
+}
+
+pub fn parse(gpa: std.mem.Allocator, bytes: []const u8, d: ?*Diag) !Manifest {
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    errdefer arena.deinit();
+    const a = arena.allocator();
+    const doc = std.json.parseFromSliceLeaky(std.json.Value, a, bytes, .{}) catch |e|
+        return fail(d, e, "hf_quant_config.json is not JSON: {t}", .{e});
+    if (doc != .object) return fail(d, error.BadInkling2Quant, "hf_quant_config.json is not an object", .{});
+    const method = str(doc.object, "quant_method") orelse "";
+    if (!std.mem.eql(u8, method, "inkling2")) return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: quant_method is {s}, not inkling2", .{method});
+    var it = doc.object.iterator();
+    while (it.next()) |e| {
+        const k = e.key_ptr.*;
+        if (!std.mem.eql(u8, k, "quant_method") and !std.mem.eql(u8, k, "model") and !std.mem.eql(u8, k, "mtp"))
+            return fail(d, error.UnsupportedInkling2Quant, "hf_quant_config.json: {s} is not known", .{k});
+    }
+    var m: Manifest = .{ .arena = undefined, .model = &.{}, .mtp = &.{}, .index = .{ .empty, .empty } };
+    m.model = try groups(a, doc.object, "model", &m.index[0], d);
+    m.mtp = if (doc.object.get("mtp") != null) try groups(a, doc.object, "mtp", &m.index[1], d) else &.{};
+    m.arena = arena;
+    return m;
+}
+
+const testing = std.testing;
+pub const fixture = @embedFile("fixtures/hf_quant_config.json");
+
+test "inkling2 quant: the release's manifest, five model groups and the drafter's" {
+    var m = try parse(testing.allocator, fixture, null);
+    defer m.deinit();
+    try testing.expectEqual(@as(usize, 5), m.model.len);
+    try testing.expectEqual(@as(usize, 1), m.mtp.len);
+    var listed: [4]usize = @splat(0);
+    for (m.model) |g| listed[@backingInt(g.format)] += g.tensors.len;
+    try testing.expectEqualSlices(usize, &.{ 144, 1273 + 1, 80, 16 }, &listed);
+    try testing.expectEqual(@as(usize, 84), m.mtp[0].tensors.len);
+    const w13 = m.lookup(.model, "model.llm.layers.0.mlp.experts.w13_weight").?;
+    try testing.expectEqual(Format.nvfp4, w13.format);
+    try testing.expect(w13.act.?.per_token and w13.act.?.two_candidates and w13.act.?.block == 16);
+    const mx = m.lookup(.model, "model.llm.layers.40.mlp.experts.w2_weight").?;
+    try testing.expectEqual(Format.mxfp8, mx.format);
+    try testing.expectEqual(@as(u32, 32), mx.act.?.block);
+    try testing.expectEqual([2]u32{ 32, 32 }, mx.block);
+    const un = m.lookup(.model, "model.llm.unembed.weight").?;
+    try testing.expectEqual(Format.bf16, un.format);
+    try testing.expectEqualStrings("float32", un.fwd_output.?);
+    try testing.expectEqual(Format.fp32, m.lookup(.model, "model.llm.layers.3.mlp.gate.bias").?.format);
+    try testing.expectEqual(Format.bf16, m.lookup(.mtp, "markov_head.markov_w1.weight").?.format);
+    try testing.expect(m.lookup(.model, "model.llm.layers.0.mlp.experts.w13_weight_scale") == null); // a companion
+    try testing.expect(m.lookup(.mtp, "model.llm.embed.weight") == null);
+}
+
+test "inkling2 quant: another method, an unknown setting or a tensor in two groups is refused" {
+    const Case = struct { from: []const u8, to: []const u8, err: anyerror };
+    const cases = [_]Case{
+        .{ .from = "\"quant_method\": \"inkling2\"", .to = "\"quant_method\": \"modelopt\"", .err = error.UnsupportedInkling2Quant },
+        .{ .from = "\"scale_selection_rule\": \"fouroversix_mae\"", .to = "\"scale_selection_rule\": \"max\"", .err = error.UnsupportedInkling2Quant },
+        .{ .from = "\"weight_scale_format\": \"amax_denominator\"", .to = "\"weight_scale_format\": \"plain\"", .err = error.UnsupportedInkling2Quant },
+        .{ .from = "\"weight_transform\": \"mxfp8_nearest\"", .to = "\"weight_transform\": \"mxfp8_stochastic\"", .err = error.UnsupportedInkling2Quant },
+        .{ .from = "\"output_dtype\": \"uint8\",", .to = "\"output_dtype\": \"uint8\", \"zero_point\": 0,", .err = error.UnsupportedInkling2Quant },
+        .{ .from = "\"model.llm.unembed.weight\"", .to = "\"model.llm.embed.weight\"", .err = error.BadInkling2Quant },
+    };
+    for (cases) |case| {
+        const changed = try std.mem.replaceOwned(u8, testing.allocator, fixture, case.from, case.to);
+        defer testing.allocator.free(changed);
+        try testing.expect(!std.mem.eql(u8, changed, fixture));
+        var d: Diag = .{};
+        try testing.expectError(case.err, parse(testing.allocator, changed, &d));
+        try testing.expect(d.len > 0);
+    }
+}
diff --git a/zig/src/families/inkling2/roles.zig b/zig/src/families/inkling2/roles.zig
new file mode 100644
index 0000000000000000000000000000000000000000..4779976ba9c1cccaf27bf9d7c7d290ef0743939a
--- /dev/null
+++ b/zig/src/families/inkling2/roles.zig
@@ -0,0 +1,541 @@
+//! Every checkpoint tensor's role: what it is, its storage format, its expected dtype and shape, and how a rank of a
+//! tensor-parallel (attention) and expert-parallel (MoE) split takes it. A tensor this file does not name, one the
+//! manifest does not list, or one whose dtype or shape is not what the config implies refuses the checkpoint.
+//!
+//! Layouts (Transformers' modeling_inkling2.py, Apache-2.0): projections are [out, in] row-major; query heads own
+//! consecutive rows of wq_du, gate_attn, wr_du (16 a head), attn_sink_proj and the clip scales, and consecutive columns
+//! of wo_ud; key heads own consecutive rows of wk_dv, wv_dv, the static convolutions' weights, and of the dynamic
+//! convolutions' weight_proj (4 taps a head), and columns of their static_w [taps, channels]. Query head h reads key
+//! head h / (heads / kv_heads). Experts are fused along axis 0, so a run of experts is one contiguous byte range.
+const std = @import("std");
+const inventory = @import("inventory.zig");
+const quant = @import("quant.zig");
+const Config = @import("config.zig").Config;
+const Diag = @import("diag.zig").Diag;
+const fail = @import("diag.zig").fail;
+const Tensor = inventory.Tensor;
+const DType = inventory.DType;
+
+/// How ranks take a tensor.
+pub const Placement = enum {
+    /// Rows by query head: `unit` rows a head.
+    q_rows,
+    /// Rows by key head.
+    kv_rows,
+    /// Columns of a 2-D tensor by query head (the output projection).
+    q_cols,
+    /// Columns of a 2-D tensor by key head (a global layer's static convolution taps).
+    kv_cols,
+    /// Axis 0 by expert.
+    experts,
+    /// Whole on every rank.
+    replicated,
+    /// Rows by vocabulary entry, canon's rule over the padded vocabulary (the unembed: each rank's logits for its
+    /// share of the vocabulary, gathered in rank order).
+    vocab_rows,
+    /// Whole on rank 0 only (embed, vision tower).
+    first,
+    /// Whole on the drafter's rank only.
+    drafter,
+
+    pub fn sliced(p: Placement) bool {
+        return switch (p) {
+            .q_rows, .kv_rows, .q_cols, .kv_cols, .experts, .vocab_rows => true,
+            .replicated, .first, .drafter => false,
+        };
+    }
+};
+
+/// What a tensor is, for the memory plan's categories.
+pub const Kind = enum { attention, router, norm, conv, residual, experts, embed, unembed, vision, drafter };
+
+/// A quantized weight's parts: the weight, its block scales, its per-expert amax, its outer scale denominator.
+pub const Part = enum { weight, scale, amax, denominator };
+
+pub const Role = struct {
+    kind: Kind,
+    placement: Placement,
+    format: quant.Format,
+    part: Part = .weight,
+    layer: ?u16 = null,
+    /// Rows or columns a head (1 for experts: axis 0 is the expert).
+    unit: u64 = 1,
+};
+
+const Shape = []const u64;
+
+const Ctx = struct {
+    c: *const Config,
+    m: *const quant.Manifest,
+    d: ?*Diag,
+
+    fn expect(x: Ctx, t: Tensor, dtype: DType, shape: Shape) !void {
+        if (t.is(dtype, shape)) return;
+        return fail(x.d, error.UnexpectedInkling2Tensor, "{s}: {s} {any}, expected {s} {any}", .{ t.name, t.dtype.name(), t.shape[0..t.rank], dtype.name(), shape });
+    }
+
+    fn unknown(x: Ctx, t: Tensor) error{UnknownInkling2Tensor} {
+        return fail(x.d, error.UnknownInkling2Tensor, "{s}: not a tensor the inkling2 family knows", .{t.name});
+    }
+};
+
+const companions = [_]struct { suffix: []const u8, part: Part }{
+    .{ .suffix = "_outer_scale_denominator", .part = .denominator },
+    .{ .suffix = "_scale", .part = .scale },
+    .{ .suffix = "_amax", .part = .amax },
+};
+
+/// The manifest group of `t`, with the part a companion is of its listed weight.
+fn listed(x: Ctx, t: Tensor, s: inventory.Section) !struct { group: *const quant.Group, part: Part } {
+    if (x.m.lookup(s, t.name)) |g| return .{ .group = g, .part = .weight };
+    for (companions) |cmp| if (std.mem.endsWith(u8, t.name, cmp.suffix)) {
+        const base = t.name[0 .. t.name.len - cmp.suffix.len];
+        if (x.m.lookup(s, base)) |g| {
+            const ok = switch (g.format) {
+                .nvfp4 => true,
+                .mxfp8 => cmp.part == .scale,
+                .fp32, .bf16 => false,
+            };
+            if (ok) return .{ .group = g, .part = cmp.part };
+        }
+    };
+    return fail(x.d, error.UnknownInkling2Tensor, "{s}: not listed in hf_quant_config.json, nor a quantized weight's scale", .{t.name});
+}
+
+/// `name` = `prefix` ++ decimal index ++ "." ++ rest: the index and the rest.
+fn indexed(name: []const u8, prefix: []const u8) ?struct { i: u32, rest: []const u8 } {
+    if (!std.mem.startsWith(u8, name, prefix)) return null;
+    const tail = name[prefix.len..];
+    const dot = std.mem.indexOfScalar(u8, tail, '.') orelse tail.len;
+    const i = std.fmt.parseInt(u32, tail[0..dot], 10) catch return null;
+    if (dot > 1 and tail[0] == '0') return null;
+    return .{ .i = i, .rest = if (dot < tail.len) tail[dot + 1 ..] else "" };
+}
+
+fn oneOf(s: []const u8, names: []const []const u8) bool {
+    for (names) |n| if (std.mem.eql(u8, s, n)) return true;
+    return false;
+}
+
+/// The role of `t`, its dtype and shape checked.
+pub fn classify(c: *const Config, m: *const quant.Manifest, inv: *const inventory.Inventory, t: Tensor, d: ?*Diag) !Role {
+    const x: Ctx = .{ .c = c, .m = m, .d = d };
+    const s = inv.section(t);
+    const l = try listed(x, t, s);
+    const f = l.group.format;
+    if (s == .mtp) return drafter(x, t, f);
+    if (std.mem.startsWith(u8, t.name, "model.visual.")) return vision(x, t, f);
+    const llm = "model.llm.";
+    if (!std.mem.startsWith(u8, t.name, llm)) return x.unknown(t);
+    const n = t.name[llm.len..];
+    if (indexed(n, "layers.")) |li| return layer(x, t, f, l.part, li.i, li.rest);
+    return top(x, t, f, n);
+}
+
+fn top(x: Ctx, t: Tensor, f: quant.Format, n: []const u8) !Role {
+    const tc = &x.c.text;
+    const h: u64 = tc.hidden;
+    const v: u64 = tc.vocab;
+    if (std.mem.eql(u8, n, "embed.weight")) {
+        try x.expect(t, .bf16, &.{ v, h });
+        return .{ .kind = .embed, .placement = .first, .format = f };
+    }
+    if (std.mem.eql(u8, n, "embed_norm.weight")) {
+        try x.expect(t, .bf16, &.{h});
+        return .{ .kind = .embed, .placement = .first, .format = f };
+    }
+    if (std.mem.eql(u8, n, "unembed.weight")) {
+        try x.expect(t, .bf16, &.{ v, h });
+        return .{ .kind = .unembed, .placement = .vocab_rows, .format = f };
+    }
+    if (std.mem.eql(u8, n, "norm.weight")) {
+        try x.expect(t, .bf16, &.{h});
+        return .{ .kind = .norm, .placement = .replicated, .format = f };
+    }
+    if (std.mem.eql(u8, n, "attn_res.output_query")) {
+        try x.expect(t, .f32, &.{h});
+        return .{ .kind = .residual, .placement = .replicated, .format = f };
+    }
+    // attention_input of layer i + 1 (layer 0 has none): three queries (q, k, v inputs) before a global layer
+    if (indexed(n, "attn_res.attn_queries.")) |q| if (q.rest.len == 0 and q.i + 1 < tc.layers) {
+        const l = q.i + 1;
+        if (tc.global[l]) try x.expect(t, .f32, &.{ 3, h }) else try x.expect(t, .f32, &.{h});
+        return .{ .kind = .residual, .placement = .replicated, .format = f, .layer = @intCast(l) };
+    };
+    if (indexed(n, "attn_res.mlp_queries.")) |q| if (q.rest.len == 0 and q.i < tc.layers) {
+        try x.expect(t, .f32, &.{h});
+        return .{ .kind = .residual, .placement = .replicated, .format = f, .layer = @intCast(q.i) };
+    };
+    return x.unknown(t);
+}
+
+fn layer(x: Ctx, t: Tensor, f: quant.Format, part: Part, li: u32, n: []const u8) !Role {
+    const tc = &x.c.text;
+    if (li >= tc.layers) return x.unknown(t);
+    const g = tc.global[li];
+    const L: u16 = @intCast(li);
+    const h: u64 = tc.hidden;
+    const H: u64 = tc.heads;
+    const K: u64 = tc.kv_heads;
+    const D: u64 = tc.head_dim;
+    const R: u64 = tc.d_rel;
+    const T: u64 = tc.conv_taps;
+    const E: u64 = tc.experts;
+    const I: u64 = tc.moe_intermediate;
+    const Q = struct { name: []const u8, rows: u64, unit: u64 };
+    for ([_]Q{
+        .{ .name = "attn.wq_du.weight", .rows = H * D, .unit = D },
+        .{ .name = "attn.gate_attn.weight", .rows = H * D, .unit = D },
+        .{ .name = "attn.wr_du.weight", .rows = H * R, .unit = R },
+        .{ .name = "attn.attn_sink_proj.weight", .rows = H, .unit = 1 },
+    }) |q| if (std.mem.eql(u8, n, q.name)) {
+        try x.expect(t, .bf16, &.{ q.rows, h });
+        return .{ .kind = .attention, .placement = .q_rows, .format = f, .layer = L, .unit = q.unit };
+    };
+    if (std.mem.eql(u8, n, "attn.q_l2_clip.scale")) {
+        try x.expect(t, .bf16, &.{ H, D });
+        return .{ .kind = .attention, .placement = .q_rows, .format = f, .layer = L, .unit = 1 };
+    }
+    if (std.mem.eql(u8, n, "attn.rel_l2_clip.scale")) {
+        try x.expect(t, .bf16, &.{ H, R });
+        return .{ .kind = .attention, .placement = .q_rows, .format = f, .layer = L, .unit = 1 };
+    }
+    if (oneOf(n, &.{ "attn.wk_dv.weight", "attn.wv_dv.weight" })) {
+        try x.expect(t, .bf16, &.{ K * D, h });
+        return .{ .kind = .attention, .placement = .kv_rows, .format = f, .layer = L, .unit = D };
+    }
+    if (std.mem.eql(u8, n, "attn.wo_ud.weight")) {
+        try x.expect(t, .bf16, &.{ h, H * D });
+        return .{ .kind = .attention, .placement = .q_cols, .format = f, .layer = L, .unit = D };
+    }
+    if (std.mem.eql(u8, n, "attn.rel_logits_proj.proj")) {
+        try x.expect(t, .bf16, &.{ R, if (g) tc.rel_extent else tc.window });
+        return .{ .kind = .attention, .placement = .replicated, .format = f, .layer = L };
+    }
+    if (!g and oneOf(n, &.{ "attn.k_sconv.weight", "attn.v_sconv.weight" })) {
+        try x.expect(t, .bf16, &.{ K * D, 1, T });
+        return .{ .kind = .conv, .placement = .kv_rows, .format = f, .layer = L, .unit = D };
+    }
+    if (g and oneOf(n, &.{ "attn.k_sconv.static_w", "attn.v_sconv.static_w" })) {
+        try x.expect(t, .bf16, &.{ T, K * D });
+        return .{ .kind = .conv, .placement = .kv_cols, .format = f, .layer = L, .unit = D };
+    }
+    if (g and oneOf(n, &.{ "attn.k_sconv.weight_proj", "attn.v_sconv.weight_proj" })) {
+        try x.expect(t, .bf16, &.{ K * T, h });
+        return .{ .kind = .conv, .placement = .kv_rows, .format = f, .layer = L, .unit = T };
+    }
+    if ((!g and std.mem.eql(u8, n, "attn_norm.weight")) or (g and oneOf(n, &.{ "q_input_norm.weight", "k_input_norm.weight", "v_input_norm.weight" })) or
+        std.mem.eql(u8, n, "mlp_norm.weight"))
+    {
+        try x.expect(t, .bf16, &.{h});
+        return .{ .kind = .norm, .placement = .replicated, .format = f, .layer = L };
+    }
+    if (oneOf(n, &.{ "attn_sconv.weight", "mlp_sconv.weight" })) {
+        try x.expect(t, .bf16, &.{ h, 1, T });
+        return .{ .kind = .conv, .placement = .replicated, .format = f, .layer = L };
+    }
+    if (std.mem.eql(u8, n, "mlp.gate.weight")) {
+        try x.expect(t, .bf16, &.{ E, h });
+        return .{ .kind = .router, .placement = .replicated, .format = f, .layer = L };
+    }
+    if (std.mem.eql(u8, n, "mlp.gate.bias")) {
+        try x.expect(t, .f32, &.{E});
+        return .{ .kind = .router, .placement = .replicated, .format = f, .layer = L };
+    }
+    const ex = "mlp.experts.";
+    if (std.mem.startsWith(u8, n, ex)) {
+        const w = n[ex.len..];
+        // gate and up stacked: [E, 2I, hidden]; down: [E, hidden, I]
+        var rows: u64 = h;
+        var cols: u64 = I;
+        if (std.mem.startsWith(u8, w, "w13_weight")) {
+            rows = 2 * I;
+            cols = h;
+        } else if (!std.mem.startsWith(u8, w, "w2_weight")) return x.unknown(t);
+        const role: Role = .{ .kind = .experts, .placement = .experts, .format = f, .part = part, .layer = L };
+        switch (part) {
+            .weight => switch (f) {
+                .nvfp4 => try x.expect(t, .u8, &.{ E, rows, cols / 2 }),
+                .mxfp8 => try x.expect(t, .f8_e4m3, &.{ E, rows, cols }),
+                else => return x.unknown(t),
+            },
+            .scale => switch (f) {
+                .nvfp4 => try x.expect(t, .f8_e4m3, &.{ E, rows, cols / 16 }),
+                .mxfp8 => try x.expect(t, .u8, &.{ E, rows, cols / 32 }),
+                else => return x.unknown(t),
+            },
+            .amax => try x.expect(t, .f32, &.{E}),
+            .denominator => {
+                try x.expect(t, .f32, &.{1});
+                var r = role;
+                r.placement = .replicated;
+                return r;
+            },
+        }
+        return role;
+    }
+    return x.unknown(t);
+}
+
+/// A tensor known by name, with its shape (BF16, `rank` of `shape`'s dims).
+const Named = struct { name: []const u8, shape: [2]u64, rank: u8 = 2 };
+
+/// Checks `t` against the entry named `n`, or returns false when none is.
+fn named(x: Ctx, t: Tensor, n: []const u8, table: []const Named) !bool {
+    for (table) |e| if (std.mem.eql(u8, n, e.name)) {
+        try x.expect(t, .bf16, e.shape[0..e.rank]);
+        return true;
+    };
+    return false;
+}
+
+/// The vision tower (tokenspeed's inkling2_vision.py names; Transformers' Inkling2Vision* shapes): patch embedding
+/// [hidden, 3 * patch^2], learned positions [grid^2, hidden], pre-norm, 23 pre-norm layers with layer scale, and the
+/// projector [projection_hidden, merge^2 * hidden] then [text hidden, projection_hidden].
+fn vision(x: Ctx, t: Tensor, f: quant.Format) !Role {
+    const v = &x.c.vision;
+    const w: u64 = v.hidden;
+    const p: u64 = v.projection_hidden;
+    const role: Role = .{ .kind = .vision, .placement = .first, .format = f };
+    const n = t.name["model.visual.".len..];
+    if (try named(x, t, n, &.{
+        .{ .name = "proj_in.weight", .shape = .{ p, @as(u64, v.merge) *| v.merge *| w } },
+        .{ .name = "proj_out.weight", .shape = .{ x.c.text.hidden, p } },
+        .{ .name = "backbone.ln_pre.weight", .shape = .{ w, 0 }, .rank = 1 },
+        .{ .name = "backbone.ln_pre.bias", .shape = .{ w, 0 }, .rank = 1 },
+        .{ .name = "backbone.embeddings.class_embedding", .shape = .{ w, 0 }, .rank = 1 },
+        .{ .name = "backbone.embeddings.cls_position_embedding", .shape = .{ w, 0 }, .rank = 1 },
+        .{ .name = "backbone.embeddings.patch_embedding.weight", .shape = .{ w, 3 *| @as(u64, v.patch) *| v.patch } },
+        .{ .name = "backbone.embeddings.position_embedding", .shape = .{ @as(u64, v.posemb_grid) *| v.posemb_grid, w } },
+    })) return role;
+    if (v.projector_bias and try named(x, t, n, &.{
+        .{ .name = "proj_in.bias", .shape = .{ p, 0 }, .rank = 1 },
+        .{ .name = "proj_out.bias", .shape = .{ x.c.text.hidden, 0 }, .rank = 1 },
+    })) return role;
+    if (indexed(n, "backbone.layers.")) |li| if (li.i < v.layers) {
+        const i = v.intermediate();
+        if (try named(x, t, li.rest, &.{
+            .{ .name = "ln_1.weight", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "ln_1.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "ln_2.weight", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "ln_2.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "ls_1.gamma", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "ls_2.gamma", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "mlp.c_fc.weight", .shape = .{ i, w } },
+            .{ .name = "mlp.c_fc.bias", .shape = .{ i, 0 }, .rank = 1 },
+            .{ .name = "mlp.c_proj.weight", .shape = .{ w, i } },
+            .{ .name = "mlp.c_proj.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "self_attn.q_proj.weight", .shape = .{ w, w } },
+            .{ .name = "self_attn.q_proj.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "self_attn.k_proj.weight", .shape = .{ w, w } },
+            .{ .name = "self_attn.k_proj.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "self_attn.v_proj.weight", .shape = .{ w, w } },
+            .{ .name = "self_attn.v_proj.bias", .shape = .{ w, 0 }, .rank = 1 },
+            .{ .name = "self_attn.out_proj.weight", .shape = .{ w, w } },
+            .{ .name = "self_attn.out_proj.bias", .shape = .{ w, 0 }, .rank = 1 },
+        })) return role;
+    };
+    return x.unknown(t);
+}
+
+/// The DSpark drafter (tokenspeed's inkling2_mtp.py): fuse_weight [layers + 1, targets], the mask embedding, the
+/// final norm, the Markov head (markov_w1 [vocab, rank]; with the rnn_hidden head, rnn_proj [3 rank, 2 rank +
+/// 2 hidden] and hidden_out [hidden, rank]) and its layers (Q [heads * head_dim, hidden], K and V and their context
+/// copies [kv_heads * head_dim, hidden], O [hidden, heads * head_dim], the dense SwiGLU, head_dim-wide QK norms).
+fn drafter(x: Ctx, t: Tensor, f: quant.Format) !Role {
+    const m = &x.c.draft;
+    const h: u64 = m.hidden;
+    const r: u64 = m.markov_rank;
+    const role: Role = .{ .kind = .drafter, .placement = .drafter, .format = f };
+    const n = t.name;
+    if (try named(x, t, n, &.{
+        .{ .name = "fuse_weight", .shape = .{ @as(u64, m.layers) + 1, m.target_count } },
+        .{ .name = "mask_embed", .shape = .{ h, 0 }, .rank = 1 },
+        .{ .name = "norm.weight", .shape = .{ h, 0 }, .rank = 1 },
+        .{ .name = "markov_head.markov_w1.weight", .shape = .{ x.c.text.vocab, r } },
+    })) return role;
+    if (m.markov_rnn_hidden and try named(x, t, n, &.{
+        .{ .name = "markov_head.dflare_norm.weight", .shape = .{ h, 0 }, .rank = 1 },
+        .{ .name = "markov_head.hidden_out.weight", .shape = .{ h, r } },
+        .{ .name = "markov_head.hidden_out.bias", .shape = .{ h, 0 }, .rank = 1 },
+        .{ .name = "markov_head.rnn_proj.weight", .shape = .{ 3 * r, 2 * r + 2 * h } },
+        .{ .name = "markov_head.rnn_proj.bias", .shape = .{ 3 * r, 0 }, .rank = 1 },
+    })) return role;
+    if (indexed(n, "layers.")) |li| if (li.i < m.layers) {
+        const D: u64 = m.head_dim;
+        const q = m.heads * D;
+        const kv = m.kv_heads * D;
+        const I: u64 = m.intermediate;
+        if (try named(x, t, li.rest, &.{
+            .{ .name = "dflare_norm.weight", .shape = .{ h, 0 }, .rank = 1 },
+            .{ .name = "input_layernorm.weight", .shape = .{ h, 0 }, .rank = 1 },
+            .{ .name = "post_attention_layernorm.weight", .shape = .{ h, 0 }, .rank = 1 },
+            .{ .name = "mlp.gate_proj.weight", .shape = .{ I, h } },
+            .{ .name = "mlp.up_proj.weight", .shape = .{ I, h } },
+            .{ .name = "mlp.down_proj.weight", .shape = .{ h, I } },
+            .{ .name = "self_attn.q_proj.weight", .shape = .{ q, h } },
+            .{ .name = "self_attn.k_proj.weight", .shape = .{ kv, h } },
+            .{ .name = "self_attn.v_proj.weight", .shape = .{ kv, h } },
+            .{ .name = "self_attn.k_proj_ctx.weight", .shape = .{ kv, h } },
+            .{ .name = "self_attn.v_proj_ctx.weight", .shape = .{ kv, h } },
+            .{ .name = "self_attn.o_proj.weight", .shape = .{ h, q } },
+            .{ .name = "self_attn.q_norm.weight", .shape = .{ D, 0 }, .rank = 1 },
+            .{ .name = "self_attn.k_norm.weight", .shape = .{ D, 0 }, .rank = 1 },
+            .{ .name = "self_attn.k_norm_ctx.weight", .shape = .{ D, 0 }, .rank = 1 },
+        })) return role;
+    };
+    return x.unknown(t);
+}
+
+/// Tensors a text layer must hold, by suffix after `model.llm.layers.<i>.`.
+const local_names = [_][]const u8{ "attn.wq_du.weight", "attn.gate_attn.weight", "attn.wr_du.weight", "attn.attn_sink_proj.weight", "attn.q_l2_clip.scale", "attn.rel_l2_clip.scale", "attn.wk_dv.weight", "attn.wv_dv.weight", "attn.wo_ud.weight", "attn.rel_logits_proj.proj", "attn.k_sconv.weight", "attn.v_sconv.weight", "attn_norm.weight", "attn_sconv.weight", "mlp_norm.weight", "mlp_sconv.weight", "mlp.gate.weight", "mlp.gate.bias", "mlp.experts.w13_weight", "mlp.experts.w13_weight_scale", "mlp.experts.w2_weight", "mlp.experts.w2_weight_scale" };
+const global_names = [_][]const u8{ "attn.wq_du.weight", "attn.gate_attn.weight", "attn.wr_du.weight", "attn.attn_sink_proj.weight", "attn.q_l2_clip.scale", "attn.rel_l2_clip.scale", "attn.wk_dv.weight", "attn.wv_dv.weight", "attn.wo_ud.weight", "attn.rel_logits_proj.proj", "attn.k_sconv.static_w", "attn.k_sconv.weight_proj", "attn.v_sconv.static_w", "attn.v_sconv.weight_proj", "q_input_norm.weight", "k_input_norm.weight", "v_input_norm.weight", "attn_sconv.weight", "mlp_norm.weight", "mlp_sconv.weight", "mlp.gate.weight", "mlp.gate.bias", "mlp.experts.w13_weight", "mlp.experts.w13_weight_scale", "mlp.experts.w2_weight", "mlp.experts.w2_weight_scale" };
+const nvfp4_names = [_][]const u8{ "mlp.experts.w13_weight_amax", "mlp.experts.w13_weight_outer_scale_denominator", "mlp.experts.w2_weight_amax", "mlp.experts.w2_weight_outer_scale_denominator" };
+
+/// Every tensor's role (parallel to `inv.tensors`), with every name the manifest lists present and every text
+/// layer complete.
+pub fn classifyAll(gpa: std.mem.Allocator, c: *const Config, m: *const quant.Manifest, inv: *const inventory.Inventory, d: ?*Diag) ![]Role {
+    const out = try gpa.alloc(Role, inv.tensors.len);
+    errdefer gpa.free(out);
+    var names: std.StringHashMapUnmanaged(u32) = .empty;
+    defer names.deinit(gpa);
+    try names.ensureTotalCapacity(gpa, @intCast(inv.tensors.len));
+    for (inv.tensors, out, 0..) |t, *r, i| {
+        r.* = try classify(c, m, inv, t, d);
+        names.putAssumeCapacity(t.name, @intCast(i));
+    }
+    for ([_]inventory.Section{ .model, .mtp }) |s| for (m.groups(s)) |g| for (g.tensors) |n| {
+        const i = names.get(n) orelse return fail(d, error.MissingInkling2Tensor, "{s}: listed in hf_quant_config.json, not in the checkpoint", .{n});
+        if (inv.section(inv.tensors[i]) != s) return fail(d, error.MissingInkling2Tensor, "{s}: in the wrong file", .{n});
+    };
+    var buf: [160]u8 = undefined;
+    for (0..c.text.layers) |l| {
+        const list: []const []const u8 = if (c.text.global[l]) &global_names else &local_names;
+        for (list) |n| {
+            const full = try std.fmt.bufPrint(&buf, "model.llm.layers.{d}.{s}", .{ l, n });
+            if (!names.contains(full)) return fail(d, error.MissingInkling2Tensor, "{s}: missing", .{full});
+        }
+        const w13 = try std.fmt.bufPrint(&buf, "model.llm.layers.{d}.mlp.experts.w13_weight", .{l});
+        if (out[names.get(w13).?].format == .nvfp4) for (nvfp4_names) |n| {
+            const full = try std.fmt.bufPrint(&buf, "model.llm.layers.{d}.{s}", .{ l, n });
+            if (!names.contains(full)) return fail(d, error.MissingInkling2Tensor, "{s}: missing", .{full});
+        };
+    }
+    for ([_][]const u8{ "model.llm.embed.weight", "model.llm.embed_norm.weight", "model.llm.unembed.weight", "model.llm.norm.weight", "model.llm.attn_res.output_query" }) |n|
+        if (!names.contains(n)) return fail(d, error.MissingInkling2Tensor, "{s}: missing", .{n});
+    return out;
+}
+
+const testing = std.testing;
+const config = @import("config.zig");
+
+const Loaded = struct {
+    c: Config,
+    m: quant.Manifest,
+    inv: inventory.Inventory,
+
+    fn init() !Loaded {
+        var m = try quant.parse(testing.allocator, quant.fixture, null);
+        errdefer m.deinit();
+        return .{ .c = try config.parse(testing.allocator, config.fixture, null), .m = m, .inv = try inventory.Inventory.fromText(testing.allocator, inventory.fixture, null) };
+    }
+
+    fn deinit(l: *Loaded) void {
+        l.m.deinit();
+        l.inv.deinit();
+    }
+};
+
+test "inkling2 roles: every release tensor has one role, the formats the manifest gives" {
+    var l = try Loaded.init();
+    defer l.deinit();
+    const roles = try classifyAll(testing.allocator, &l.c, &l.m, &l.inv, null);
+    defer testing.allocator.free(roles);
+    var by_format: [4]u64 = @splat(0);
+    var by_kind: [@typeInfo(Kind).@"enum".field_names.len]usize = @splat(0);
+    for (l.inv.tensors, roles) |t, r| {
+        by_format[@backingInt(r.format)] += t.bytes();
+        by_kind[@backingInt(r.kind)] += 1;
+    }
+    // NVFP4 experts of 40 layers with their scales, MXFP8 experts of 8
+    try testing.expectEqual(@as(u64, 40 * 384 * 4608 * (2304 + 1152 + 288 + 144) + 40 * 2 * (384 * 4 + 4)), by_format[@backingInt(quant.Format.nvfp4)]);
+    try testing.expectEqual(@as(u64, 8 * 384 * 4608 * (4608 + 2304 + 144 + 72)), by_format[@backingInt(quant.Format.mxfp8)]);
+    try testing.expectEqual(@as(usize, 40 * 8 + 8 * 4), by_kind[@backingInt(Kind.experts)]);
+    try testing.expectEqual(@as(usize, 84), by_kind[@backingInt(Kind.drafter)]);
+    try testing.expectEqual(@as(usize, 8 + 23 * 18), by_kind[@backingInt(Kind.vision)]);
+    const wo = try classify(&l.c, &l.m, &l.inv, l.inv.find("model.llm.layers.5.attn.wo_ud.weight").?, null);
+    try testing.expectEqual(Placement.q_cols, wo.placement);
+    const sw = try classify(&l.c, &l.m, &l.inv, l.inv.find("model.llm.layers.5.attn.k_sconv.static_w").?, null);
+    try testing.expectEqual(Placement.kv_cols, sw.placement);
+    const wp = try classify(&l.c, &l.m, &l.inv, l.inv.find("model.llm.layers.11.attn.v_sconv.weight_proj").?, null);
+    try testing.expectEqual(@as(u64, 4), wp.unit);
+    const den = try classify(&l.c, &l.m, &l.inv, l.inv.find("model.llm.layers.0.mlp.experts.w2_weight_outer_scale_denominator").?, null);
+    try testing.expectEqual(Placement.replicated, den.placement);
+    try testing.expectEqual(Part.denominator, den.part);
+}
+
+test "inkling2 roles: an unknown, unlisted, misshaped or missing tensor refuses the checkpoint" {
+    var l = try Loaded.init();
+    defer l.deinit();
+    var d: Diag = .{};
+    var t = l.inv.find("model.llm.layers.0.attn.wq_du.weight").?;
+    t.name = "model.llm.layers.0.attn.wq_new.weight";
+    try testing.expectError(error.UnknownInkling2Tensor, classify(&l.c, &l.m, &l.inv, t, &d));
+    try testing.expect(std.mem.indexOf(u8, d.text(), "wq_new") != null);
+    t = l.inv.find("model.llm.layers.0.attn.wq_du.weight").?;
+    t.shape[0] = 6016;
+    try testing.expectError(error.UnexpectedInkling2Tensor, classify(&l.c, &l.m, &l.inv, t, &d));
+    t = l.inv.find("model.llm.layers.40.mlp.experts.w13_weight_scale").?;
+    t.name = "model.llm.layers.40.mlp.experts.w13_weight_amax"; // MXFP8 has no amax
+    try testing.expectError(error.UnknownInkling2Tensor, classify(&l.c, &l.m, &l.inv, t, &d));
+    // a global layer's tensor on a sliding layer
+    t = l.inv.find("model.llm.layers.5.attn.k_sconv.static_w").?;
+    t.name = "model.llm.layers.4.attn.k_sconv.static_w";
+    try testing.expectError(error.UnknownInkling2Tensor, classify(&l.c, &l.m, &l.inv, t, &d));
+    // the inventory without one listed tensor
+    const saved = l.inv.tensors;
+    defer l.inv.tensors = saved;
+    var fewer: std.ArrayList(Tensor) = .empty;
+    defer fewer.deinit(testing.allocator);
+    for (saved) |x| if (!std.mem.eql(u8, x.name, "model.llm.layers.7.mlp_sconv.weight")) try fewer.append(testing.allocator, x);
+    l.inv.tensors = fewer.items;
+    try testing.expectError(error.MissingInkling2Tensor, classifyAll(testing.allocator, &l.c, &l.m, &l.inv, &d));
+    try testing.expect(std.mem.indexOf(u8, d.text(), "layers.7.mlp_sconv") != null);
+}
+
+test "inkling2 roles: a vision or drafter tensor whose shape is not the config's refuses the checkpoint" {
+    var l = try Loaded.init();
+    defer l.deinit();
+    const Case = struct { name: []const u8, axis: u8, to: u64 };
+    for ([_]Case{
+        .{ .name = "model.visual.proj_in.weight", .axis = 1, .to = 1024 },
+        .{ .name = "model.visual.proj_out.weight", .axis = 0, .to = 4096 },
+        .{ .name = "model.visual.backbone.embeddings.patch_embedding.weight", .axis = 1, .to = 2400 },
+        .{ .name = "model.visual.backbone.embeddings.position_embedding", .axis = 0, .to = 1025 },
+        .{ .name = "model.visual.backbone.embeddings.class_embedding", .axis = 0, .to = 1023 },
+        .{ .name = "model.visual.backbone.ln_pre.bias", .axis = 0, .to = 4096 },
+        .{ .name = "model.visual.backbone.layers.3.mlp.c_fc.weight", .axis = 0, .to = 4097 },
+        .{ .name = "model.visual.backbone.layers.3.mlp.c_proj.weight", .axis = 1, .to = 1024 },
+        .{ .name = "model.visual.backbone.layers.22.self_attn.q_proj.bias", .axis = 0, .to = 4096 },
+        .{ .name = "model.visual.backbone.layers.0.ls_2.gamma", .axis = 0, .to = 4608 },
+        .{ .name = "fuse_weight", .axis = 0, .to = 5 },
+        .{ .name = "mask_embed", .axis = 0, .to = 1024 },
+        .{ .name = "markov_head.markov_w1.weight", .axis = 0, .to = 200058 },
+        .{ .name = "markov_head.rnn_proj.weight", .axis = 1, .to = 9216 },
+        .{ .name = "markov_head.hidden_out.weight", .axis = 1, .to = 128 },
+        .{ .name = "layers.2.self_attn.k_proj.weight", .axis = 0, .to = 6144 },
+        .{ .name = "layers.4.self_attn.o_proj.weight", .axis = 1, .to = 4608 },
+        .{ .name = "layers.0.self_attn.q_norm.weight", .axis = 0, .to = 4608 },
+        .{ .name = "layers.1.mlp.down_proj.weight", .axis = 1, .to = 9216 },
+    }) |case| {
+        var t = l.inv.find(case.name).?;
+        _ = try classify(&l.c, &l.m, &l.inv, t, null);
+        t.shape[case.axis] = case.to;
+        var d: Diag = .{};
+        testing.expectError(error.UnexpectedInkling2Tensor, classify(&l.c, &l.m, &l.inv, t, &d)) catch |e| {
+            std.debug.print("{s}: shape {any} passed\n", .{ case.name, t.shape[0..t.rank] });
+            return e;
+        };
+        try testing.expect(std.mem.indexOf(u8, d.text(), case.name) != null);
+    }
+}
diff --git a/zig/src/families/inkling2/sample.zig b/zig/src/families/inkling2/sample.zig
new file mode 100644
index 0000000000000000000000000000000000000000..209ec93de851a12eacc2082964f000c92dae12d4
--- /dev/null
+++ b/zig/src/families/inkling2/sample.zig
@@ -0,0 +1,325 @@
+//! Rank 0's sampled draw over a row of fp32 logits (cuda_lanes.zig): the lane core's keyed fp64 sampler
+//! (lanes.sampling.choose: the temperature floored at 1e-6, top_k, top_p over the top k, min_p, Gumbel keys at the
+//! row's position) over the whole vocabulary, without sorting the whole row. A draw only ever reads a prefix of the
+//! row's order (value descending, then the lower id), and only that prefix is sorted:
+//! - top_k below the vocabulary: the values at or above a cutoff that at least k of them reach. chooseOrdered reads
+//!   the first k of an order alone, so the draw is choose's own.
+//! - top_p alone: the values at or above a cutoff whose mass reaches top_p of the row's total (fp64, every token).
+//!   The nucleus walk runs over that prefix against the row's total; a walk that does not end inside the prefix
+//!   takes the whole sorted row instead.
+//! - neither: choose's one pass over the row.
+//! Temperature 0 never comes here: greedy is the caller's argmax.
+//! A row may hold -inf (a grammar's disallowed tokens, cuda_lanes.zig drawMasked): such a value has no mass and sorts
+//! after every finite one, so the paths above draw what choose draws with those tokens in the row.
+const std = @import("std");
+const lanes = @import("lanes");
+
+const sampling = lanes.sampling;
+const Sampling = lanes.Sampling;
+const Candidate = sampling.Candidate;
+
+extern "c" fn exp(x: f64) f64;
+
+/// Histogram buckets over a value's distance below the row's best: `per` a unit, the last one holds the rest.
+const buckets = 256;
+const per = 8.0;
+
+pub const Path = enum { top_k, top_p, race, full };
+
+pub const Sampler = struct {
+    gpa: std.mem.Allocator,
+    order: std.ArrayList(Candidate) = .empty,
+    values: std.ArrayList(f64) = .empty,
+    ids: std.ArrayList(u64) = .empty,
+    /// The last draw's path (tests).
+    path: Path = .race,
+
+    pub fn deinit(self: *Sampler) void {
+        self.order.deinit(self.gpa);
+        self.values.deinit(self.gpa);
+        self.ids.deinit(self.gpa);
+    }
+
+    /// The token `s` draws from `logits` at `position` (s.temperature > 0).
+    pub fn draw(self: *Sampler, logits: []const f32, s: Sampling, position: u64) !u32 {
+        const V = logits.len;
+        if (V == 0) return error.NoAllowedToken;
+        var m = -std.math.inf(f32);
+        var finite = true;
+        for (logits) |l| {
+            finite = finite and (std.math.isFinite(l) or l == -std.math.inf(f32));
+            m = @max(m, l);
+        }
+        // NaN, +inf, a row of -inf alone, and temperature 0 keep choose's own handling
+        if (!finite or !std.math.isFinite(m) or !(s.temperature > 0)) return self.whole(logits, s, position, .full);
+        const k: usize = if (s.top_k == 0) V else @min(V, s.top_k);
+        if (k < V) return self.topK(logits, m, k, s, position);
+        if (s.top_p > 0.0 and s.top_p < 1.0) return self.topP(logits, m, s, position);
+        return self.whole(logits, s, position, .race);
+    }
+
+    /// choose over the whole row (its one-pass race when no cut applies, else its full sort).
+    fn whole(self: *Sampler, logits: []const f32, s: Sampling, position: u64, path: Path) !u32 {
+        self.path = path;
+        try self.values.resize(self.gpa, logits.len);
+        try self.ids.resize(self.gpa, logits.len);
+        for (self.values.items, self.ids.items, logits, 0..) |*v, *id, l, i| {
+            v.* = l;
+            id.* = i;
+        }
+        return @intCast(try sampling.choose(self.gpa, self.values.items, self.ids.items, position, s));
+    }
+
+    /// The bucket of logit `l` at `top - l / t` below the best (`per` buckets a unit, the last one for the rest).
+    /// It only grows as l falls: buckets 0 ..= b hold every value at or above their lowest one, ties included.
+    fn bucket(top: f64, l: f32, t: f64) usize {
+        const at = (top - @as(f64, l) / t) * per;
+        return if (at >= buckets - 1) buckets - 1 else @intFromFloat(at);
+    }
+
+    /// The row's values in buckets 0 ..= last, sorted: the sorted row's first entries.
+    fn prefix(self: *Sampler, logits: []const f32, top: f64, t: f64, last: usize) ![]const Candidate {
+        self.order.clearRetainingCapacity();
+        for (logits, 0..) |l, i| {
+            if (bucket(top, l, t) <= last) try self.order.append(self.gpa, .{ .value = l, .id = i });
+        }
+        std.mem.sort(Candidate, self.order.items, {}, byValueThenId);
+        return self.order.items;
+    }
+
+    /// top_k below the vocabulary: a prefix of at least k values, then chooseOrdered (it reads the first k).
+    fn topK(self: *Sampler, logits: []const f32, m: f32, k: usize, s: Sampling, position: u64) !u32 {
+        var count: [buckets]usize = @splat(0);
+        const top: f64 = m;
+        for (logits) |l| count[bucket(top, l, 1.0)] += 1;
+        var last: usize = 0;
+        var n: usize = count[0];
+        while (n < k) {
+            last += 1;
+            n += count[last];
+        }
+        if (last == buckets - 1) return self.whole(logits, s, position, .full);
+        self.path = .top_k;
+        const order = try self.prefix(logits, top, 1.0, last);
+        return @intCast(try sampling.chooseOrdered(self.gpa, order, position, s));
+    }
+
+    /// top_p over the whole row: the row's total in fp64, a prefix that holds top_p of it (one bucket more than the
+    /// histogram asks, for its rounding), the nucleus walked over it (as chooseOrdered walks), then chooseOrdered
+    /// over the nucleus alone (min_p and the keyed draw).
+    fn topP(self: *Sampler, logits: []const f32, m: f32, s: Sampling, position: u64) !u32 {
+        const t = @max(s.temperature, 1e-6);
+        const x0 = @as(f64, m) / t;
+        var mass: [buckets]f64 = @splat(0.0);
+        var total: f64 = 0.0;
+        for (logits) |l| {
+            const p = exp(@as(f64, l) / t - x0);
+            mass[bucket(x0, l, t)] += p;
+            total += p;
+        }
+        const want = s.top_p * total;
+        var last: usize = 0;
+        var held: f64 = mass[0];
+        while (held < want and last < buckets - 1) {
+            last += 1;
+            held += mass[last];
+        }
+        last = @min(last + 1, buckets - 1);
+        if (last == buckets - 1) return self.whole(logits, s, position, .full);
+        const order = try self.prefix(logits, x0, t, last);
+        // chooseOrdered's walk: keep the candidates whose running share stays below top_p, and the one that reaches it
+        var cum: f64 = 0.0;
+        var below: usize = 0;
+        for (order) |c| {
+            cum += exp(c.value / t - x0) / total;
+            if (cum < s.top_p) below += 1 else break;
+        }
+        if (below == order.len) return self.whole(logits, s, position, .full); // the walk did not end inside the prefix
+        self.path = .top_p;
+        var nucleus = s;
+        nucleus.top_k = @intCast(below + 1);
+        nucleus.top_p = 1.0;
+        return @intCast(try sampling.chooseOrdered(self.gpa, order[0 .. below + 1], position, nucleus));
+    }
+};
+
+fn byValueThenId(_: void, a: Candidate, b: Candidate) bool {
+    return a.value > b.value or (a.value == b.value and a.id < b.id);
+}
+
+// Host tests: draws against the lane core's choose over the whole row, and the drawn frequencies against the exact
+// distribution on small synthetic rows.
+
+const testing = std.testing;
+
+/// choose over the whole row, as the reference.
+fn reference(a: std.mem.Allocator, logits: []const f32, s: Sampling, position: u64) !u32 {
+    const values = try a.alloc(f64, logits.len);
+    defer a.free(values);
+    const ids = try a.alloc(u64, logits.len);
+    defer a.free(ids);
+    for (values, ids, logits, 0..) |*v, *id, l, i| {
+        v.* = l;
+        id.* = i;
+    }
+    return @intCast(try sampling.choose(a, values, ids, position, s));
+}
+
+/// The exact probabilities of `s` over `logits`: softmax at max(T, 1e-6), the top k (ties to the lower id), the
+/// nucleus over the top k's mass, min_p against the best.
+fn exact(a: std.mem.Allocator, logits: []const f32, s: Sampling) ![]f64 {
+    const V = logits.len;
+    const order = try a.alloc(Candidate, V);
+    defer a.free(order);
+    for (order, logits, 0..) |*c, l, i| c.* = .{ .value = l, .id = i };
+    std.mem.sort(Candidate, order, {}, byValueThenId);
+    const t = @max(s.temperature, 1e-6);
+    const k = if (s.top_k == 0) V else @min(V, s.top_k);
+    var z: f64 = 0.0;
+    for (order[0..k]) |c| z += @exp((c.value - order[0].value) / t);
+    var keep = k;
+    if (s.top_p > 0.0 and s.top_p < 1.0) {
+        var cum: f64 = 0.0;
+        for (order[0..k], 0..) |c, j| {
+            cum += @exp((c.value - order[0].value) / t) / z;
+            if (cum >= s.top_p) {
+                keep = j + 1;
+                break;
+            }
+        }
+    }
+    if (s.min_p > 0.0) {
+        var n: usize = 0;
+        while (n < keep and @exp((order[n].value - order[0].value) / t) >= s.min_p) n += 1;
+        keep = n;
+    }
+    const p = try a.alloc(f64, V);
+    @memset(p, 0.0);
+    var kept: f64 = 0.0;
+    for (order[0..keep]) |c| kept += @exp((c.value - order[0].value) / t);
+    for (order[0..keep]) |c| p[c.id] = @exp((c.value - order[0].value) / t) / kept;
+    return p;
+}
+
+const settings = [_]Sampling{
+    .{ .seed = 7, .temperature = 0.7, .top_k = 0, .top_p = 1.0 },
+    .{ .seed = 8, .temperature = 1.0, .top_k = 5, .top_p = 1.0 },
+    .{ .seed = 9, .temperature = 1.0, .top_k = 0, .top_p = 0.8 },
+    .{ .seed = 10, .temperature = 1.3, .top_k = 6, .top_p = 0.9 },
+    .{ .seed = 11, .temperature = 0.5, .top_k = 0, .top_p = 0.95, .min_p = 0.05 },
+    .{ .seed = 12, .temperature = 2.0, .top_k = 0, .top_p = 1.0, .min_p = 0.1 },
+};
+
+test "inkling2 sampler: every path draws what choose draws over the whole row" {
+    const a = testing.allocator;
+    var rng = std.Random.DefaultPrng.init(42);
+    const r = rng.random();
+    const logits = try a.alloc(f32, 5000);
+    defer a.free(logits);
+    for (logits) |*l| l.* = @floatCast(r.floatNorm(f64) * 3.0);
+    logits[1234] = logits[77]; // a tie
+    var smp: Sampler = .{ .gpa = a };
+    defer smp.deinit();
+    const more = [_]Sampling{
+        .{ .seed = 1, .temperature = 0.7, .top_k = 20, .top_p = 0.95 },
+        .{ .seed = 2, .temperature = 1e-9, .top_k = 0, .top_p = 0.9 }, // under the floor
+        .{ .seed = 3, .temperature = 1.0, .top_k = 2000, .top_p = 0.99 },
+        .{ .seed = 4, .temperature = 1.0, .top_k = 0, .top_p = 0.999999 },
+    };
+    var seen: [4]usize = @splat(0);
+    for (settings ++ more) |s| {
+        for (0..60) |position| {
+            const got = try smp.draw(logits, s, position);
+            try testing.expectEqual(try reference(a, logits, s, position), got);
+            seen[@intFromEnum(smp.path)] += 1;
+        }
+    }
+    try testing.expect(seen[@intFromEnum(Path.top_k)] > 0 and seen[@intFromEnum(Path.top_p)] > 0 and seen[@intFromEnum(Path.race)] > 0);
+}
+
+test "inkling2 sampler: a masked row (disallowed tokens at -inf) draws what choose draws, never a disallowed token" {
+    const a = testing.allocator;
+    var rng = std.Random.DefaultPrng.init(43);
+    const r = rng.random();
+    const logits = try a.alloc(f32, 5000);
+    defer a.free(logits);
+    var smp: Sampler = .{ .gpa = a };
+    defer smp.deinit();
+    const more = [_]Sampling{
+        .{ .seed = 1, .temperature = 0.7, .top_k = 20, .top_p = 0.95 },
+        .{ .seed = 3, .temperature = 1.0, .top_k = 2000, .top_p = 0.99 },
+        .{ .seed = 4, .temperature = 1.0, .top_k = 0, .top_p = 0.999999 },
+        .{ .seed = 5, .temperature = 1.0, .top_k = 4000, .top_p = 1.0 }, // past the allowed tokens: the -inf ones too
+    };
+    var seen: [4]usize = @splat(0);
+    // most allowed (a JSON string's body), a few (a key's choice), one (a forced token)
+    for ([_]f64{ 0.9, 0.01, 0.0 }) |keep| {
+        for (logits) |*l| l.* = if (r.float(f64) < keep) @floatCast(r.floatNorm(f64) * 3.0) else -std.math.inf(f32);
+        logits[4321] = 1.5; // at least one allowed
+        for (settings ++ more) |s| {
+            for (0..40) |position| {
+                const got = try smp.draw(logits, s, position);
+                try testing.expect(logits[got] != -std.math.inf(f32));
+                try testing.expectEqual(try reference(a, logits, s, position), got);
+                seen[@intFromEnum(smp.path)] += 1;
+            }
+        }
+    }
+    try testing.expect(seen[@intFromEnum(Path.top_k)] > 0 and seen[@intFromEnum(Path.top_p)] > 0 and seen[@intFromEnum(Path.race)] > 0);
+}
+
+test "inkling2 sampler: the drawn frequencies follow the exact distribution" {
+    const a = testing.allocator;
+    const logits = [_]f32{ 2.0, 1.5, 1.5, 0.3, -0.2, 0.9, -1.7, 3.1, 0.0, -4.0, 1.1, 2.6 };
+    var smp: Sampler = .{ .gpa = a };
+    defer smp.deinit();
+    const n = 40_000;
+    for (settings) |s| {
+        const p = try exact(a, &logits, s);
+        defer a.free(p);
+        var counts: [logits.len]usize = @splat(0);
+        for (0..n) |position| counts[try smp.draw(&logits, s, position)] += 1;
+        // chi-square over the kept tokens; a dropped token is never drawn
+        var chi: f64 = 0.0;
+        var df: usize = 0;
+        for (p, counts) |q, c| {
+            if (q == 0.0) {
+                try testing.expectEqual(@as(usize, 0), c);
+                continue;
+            }
+            const e = q * n;
+            chi += (@as(f64, @floatFromInt(c)) - e) * (@as(f64, @floatFromInt(c)) - e) / e;
+            df += 1;
+        }
+        // at most 11 degrees of freedom: chi-square past 45 has a chance below 1e-5
+        if (chi > 45.0) {
+            std.debug.print("seed {d}: chi-square {d:.1} over {d} tokens\n", .{ s.seed, chi, df });
+            return error.DistributionDiffers;
+        }
+    }
+}
+
+test "inkling2 sampler: no 1024-candidate cap: a flat row and a nucleus past 1024 tokens are drawn whole" {
+    const a = testing.allocator;
+    const logits = try a.alloc(f32, 2048);
+    defer a.free(logits);
+    @memset(logits, 0.5);
+    var smp: Sampler = .{ .gpa = a };
+    defer smp.deinit();
+    // the whole row: half the draws land past id 1023
+    var past: usize = 0;
+    const n = 4000;
+    for (0..n) |position| {
+        if (try smp.draw(logits, .{ .seed = 5, .temperature = 1.0, .top_k = 0, .top_p = 1.0 }, position) >= 1024) past += 1;
+    }
+    try testing.expect(past > n / 2 - 160 and past < n / 2 + 160); // 5 standard deviations
+    // top_p 0.9 of a flat row keeps ids 0 .. 1843 (ties go to the lower id): draws reach past 1024, none past 1843
+    var high: u32 = 0;
+    for (0..n) |position| {
+        const id = try smp.draw(logits, .{ .seed = 6, .temperature = 1.0, .top_k = 0, .top_p = 0.9 }, position);
+        try testing.expect(id <= 1843);
+        high = @max(high, id);
+    }
+    try testing.expectEqual(Path.top_p, smp.path);
+    try testing.expect(high > 1800);
+}
diff --git a/zig/src/families/inkling2/st.zig b/zig/src/families/inkling2/st.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9a6a95acb021dbf479c8a270eae32bdfd52abefa
--- /dev/null
+++ b/zig/src/families/inkling2/st.zig
@@ -0,0 +1,364 @@
+//! Safetensors files for the CUDA runner and its tools: the oracle's per-prompt files read by name, the runner's dumps
+//! written. Any dtype the format names is read; a dump writes the dtypes the forward holds (BF16, F32, I32, I64, U8).
+const std = @import("std");
+
+pub const DType = enum {
+    bf16,
+    f16,
+    f32,
+    f64,
+    i64,
+    i32,
+    i16,
+    i8,
+    u8,
+    bool,
+    f8_e4m3,
+
+    const names = [_][]const u8{ "BF16", "F16", "F32", "F64", "I64", "I32", "I16", "I8", "U8", "BOOL", "F8_E4M3" };
+
+    pub fn name(d: DType) []const u8 {
+        return names[@intFromEnum(d)];
+    }
+
+    pub fn parse(text: []const u8) ?DType {
+        for (names, 0..) |n, i| if (std.mem.eql(u8, n, text)) return @enumFromInt(i);
+        return null;
+    }
+
+    pub fn size(d: DType) u64 {
+        return switch (d) {
+            .f64, .i64 => 8,
+            .f32, .i32 => 4,
+            .bf16, .f16, .i16 => 2,
+            .i8, .u8, .bool, .f8_e4m3 => 1,
+        };
+    }
+};
+
+pub const max_rank = 6;
+
+pub const Entry = struct {
+    name: []const u8,
+    dtype: DType,
+    rank: u8,
+    shape: [max_rank]u64,
+    /// Bytes from the data region's start.
+    begin: u64,
+    end: u64,
+
+    pub fn dim(e: Entry, i: usize) u64 {
+        return if (i < e.rank) e.shape[i] else 1;
+    }
+
+    pub fn count(e: Entry) u64 {
+        var n: u64 = 1;
+        for (e.shape[0..e.rank]) |x| n *= x;
+        return n;
+    }
+
+    pub fn bytes(e: Entry) u64 {
+        return e.end - e.begin;
+    }
+};
+
+/// A safetensors file opened for reading by name; its header parsed, its data read on demand.
+pub const Reader = struct {
+    arena: std.heap.ArenaAllocator,
+    io: std.Io,
+    file: std.Io.File,
+    data_start: u64,
+    entries: []Entry,
+    /// __metadata__ pairs, as stored.
+    meta: []const [2][]const u8,
+
+    pub fn open(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !Reader {
+        const file = try std.Io.Dir.cwd().openFile(io, path, .{});
+        errdefer file.close(io);
+        var r: Reader = .{ .arena = .init(gpa), .io = io, .file = file, .data_start = 0, .entries = &.{}, .meta = &.{} };
+        errdefer r.arena.deinit();
+        const size = try file.length(io);
+        var prefix: [8]u8 = undefined;
+        if (size < 8 or try file.readPositionalAll(io, &prefix, 0) != 8) return error.BadSafetensors;
+        const n = std.mem.readInt(u64, &prefix, .little);
+        if (n > 1 << 30 or n > size - 8) return error.BadSafetensors;
+        const text = try r.arena.allocator().alloc(u8, @intCast(n));
+        if (try file.readPositionalAll(io, text, 8) != text.len) return error.BadSafetensors;
+        r.data_start = 8 + n;
+        try r.parse(text, size - 8 - n);
+        return r;
+    }
+
+    fn parse(r: *Reader, text: []const u8, data_len: u64) !void {
+        const a = r.arena.allocator();
+        const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+        if (doc != .object) return error.BadSafetensors;
+        var list: std.ArrayList(Entry) = .empty;
+        var meta: std.ArrayList([2][]const u8) = .empty;
+        var it = doc.object.iterator();
+        while (it.next()) |kv| {
+            const v = kv.value_ptr.*;
+            if (std.mem.eql(u8, kv.key_ptr.*, "__metadata__")) {
+                if (v != .object) return error.BadSafetensors;
+                var mi = v.object.iterator();
+                while (mi.next()) |m| if (m.value_ptr.* == .string) try meta.append(a, .{ m.key_ptr.*, m.value_ptr.string });
+                continue;
+            }
+            if (v != .object) return error.BadSafetensors;
+            const dt = v.object.get("dtype") orelse return error.BadSafetensors;
+            const shape = v.object.get("shape") orelse return error.BadSafetensors;
+            const offs = v.object.get("data_offsets") orelse return error.BadSafetensors;
+            if (dt != .string or shape != .array or offs != .array or offs.array.items.len != 2) return error.BadSafetensors;
+            if (shape.array.items.len > max_rank) return error.BadSafetensors;
+            var e: Entry = .{ .name = kv.key_ptr.*, .dtype = DType.parse(dt.string) orelse return error.UnsupportedDType, .rank = @intCast(shape.array.items.len), .shape = @splat(1), .begin = 0, .end = 0 };
+            for (shape.array.items, 0..) |d, i| {
+                if (d != .integer or d.integer < 0) return error.BadSafetensors;
+                e.shape[i] = @intCast(d.integer);
+            }
+            for (offs.array.items) |o| if (o != .integer or o.integer < 0) return error.BadSafetensors;
+            e.begin = @intCast(offs.array.items[0].integer);
+            e.end = @intCast(offs.array.items[1].integer);
+            if (e.end < e.begin or e.end > data_len or e.bytes() != e.count() * e.dtype.size()) return error.BadSafetensors;
+            try list.append(a, e);
+        }
+        std.mem.sort(Entry, list.items, {}, struct {
+            fn lt(_: void, x: Entry, y: Entry) bool {
+                return std.mem.order(u8, x.name, y.name) == .lt;
+            }
+        }.lt);
+        r.entries = list.items;
+        r.meta = meta.items;
+    }
+
+    pub fn close(r: *Reader) void {
+        r.file.close(r.io);
+        r.arena.deinit();
+        r.* = undefined;
+    }
+
+    pub fn find(r: *const Reader, name: []const u8) ?Entry {
+        var lo: usize = 0;
+        var hi: usize = r.entries.len;
+        while (lo < hi) {
+            const mid = (lo + hi) / 2;
+            switch (std.mem.order(u8, r.entries[mid].name, name)) {
+                .eq => return r.entries[mid],
+                .lt => lo = mid + 1,
+                .gt => hi = mid,
+            }
+        }
+        return null;
+    }
+
+    pub fn metaValue(r: *const Reader, key: []const u8) ?[]const u8 {
+        for (r.meta) |m| if (std.mem.eql(u8, m[0], key)) return m[1];
+        return null;
+    }
+
+    /// `out.len` bytes of `e` from byte `offset` within it.
+    pub fn readInto(r: *const Reader, e: Entry, offset: u64, out: []u8) !void {
+        if (offset > e.bytes() or out.len > e.bytes() - offset) return error.BadSafetensors;
+        if (try r.file.readPositionalAll(r.io, out, r.data_start + e.begin + offset) != out.len) return error.BadSafetensors;
+    }
+
+    /// The whole of tensor `name`, which must have dtype `dtype`; the caller frees it.
+    pub fn alloc(r: *const Reader, gpa: std.mem.Allocator, name: []const u8, dtype: DType) ![]u8 {
+        const e = r.find(name) orelse return error.MissingTensor;
+        if (e.dtype != dtype) return error.UnexpectedDType;
+        const out = try gpa.alloc(u8, @intCast(e.bytes()));
+        errdefer gpa.free(out);
+        try r.readInto(e, 0, out);
+        return out;
+    }
+};
+
+/// Tensors gathered in memory, then written as one safetensors file (names sorted, data 8-byte aligned).
+pub const Writer = struct {
+    gpa: std.mem.Allocator,
+    items: std.ArrayList(Item) = .empty,
+    meta: std.ArrayList([2][]u8) = .empty,
+
+    const Item = struct { name: []u8, dtype: DType, rank: u8, shape: [max_rank]u64, data: []u8 };
+
+    pub fn init(gpa: std.mem.Allocator) Writer {
+        return .{ .gpa = gpa };
+    }
+
+    pub fn deinit(w: *Writer) void {
+        for (w.items.items) |it| {
+            w.gpa.free(it.name);
+            w.gpa.free(it.data);
+        }
+        w.items.deinit(w.gpa);
+        for (w.meta.items) |m| {
+            w.gpa.free(m[0]);
+            w.gpa.free(m[1]);
+        }
+        w.meta.deinit(w.gpa);
+        w.* = undefined;
+    }
+
+    pub fn has(w: *const Writer, name: []const u8) bool {
+        for (w.items.items) |it| if (std.mem.eql(u8, it.name, name)) return true;
+        return false;
+    }
+
+    /// A copy of `data` as tensor `name` of `shape`; a name given twice replaces the first.
+    pub fn add(w: *Writer, name: []const u8, dtype: DType, shape: []const u64, data: []const u8) !void {
+        if (shape.len > max_rank) return error.BadShape;
+        var n: u64 = dtype.size();
+        for (shape) |d| n *= d;
+        if (n != data.len) return error.BadShape;
+        const copy = try w.gpa.dupe(u8, data);
+        errdefer w.gpa.free(copy);
+        try w.addOwned(name, dtype, shape, copy);
+    }
+
+    /// As `add`, taking ownership of `data` (allocated with the writer's allocator).
+    pub fn addOwned(w: *Writer, name: []const u8, dtype: DType, shape: []const u64, data: []u8) !void {
+        var it: Item = .{ .name = try w.gpa.dupe(u8, name), .dtype = dtype, .rank = @intCast(shape.len), .shape = @splat(1), .data = data };
+        @memcpy(it.shape[0..shape.len], shape);
+        for (w.items.items) |*old| if (std.mem.eql(u8, old.name, name)) {
+            w.gpa.free(old.name);
+            w.gpa.free(old.data);
+            old.* = it;
+            return;
+        };
+        errdefer w.gpa.free(it.name);
+        try w.items.append(w.gpa, it);
+    }
+
+    pub fn setMeta(w: *Writer, key: []const u8, value: []const u8) !void {
+        const v = try w.gpa.dupe(u8, value);
+        errdefer w.gpa.free(v);
+        for (w.meta.items) |*m| if (std.mem.eql(u8, m[0], key)) {
+            w.gpa.free(m[1]);
+            m[1] = v;
+            return;
+        };
+        const k = try w.gpa.dupe(u8, key);
+        errdefer w.gpa.free(k);
+        try w.meta.append(w.gpa, .{ k, v });
+    }
+
+    pub fn write(w: *Writer, io: std.Io, path: []const u8) !void {
+        std.mem.sort(Item, w.items.items, {}, struct {
+            fn lt(_: void, x: Item, y: Item) bool {
+                return std.mem.order(u8, x.name, y.name) == .lt;
+            }
+        }.lt);
+        var head: std.ArrayList(u8) = .empty;
+        defer head.deinit(w.gpa);
+        try head.append(w.gpa, '{');
+        var first = true;
+        if (w.meta.items.len > 0) {
+            try head.appendSlice(w.gpa, "\"__metadata__\":{");
+            for (w.meta.items, 0..) |m, i| {
+                if (i > 0) try head.append(w.gpa, ',');
+                try quote(w.gpa, &head, m[0]);
+                try head.append(w.gpa, ':');
+                try quote(w.gpa, &head, m[1]);
+            }
+            try head.append(w.gpa, '}');
+            first = false;
+        }
+        var at: u64 = 0;
+        for (w.items.items) |it| {
+            if (!first) try head.append(w.gpa, ',');
+            first = false;
+            try quote(w.gpa, &head, it.name);
+            var buf: [64]u8 = undefined;
+            try head.appendSlice(w.gpa, try std.fmt.bufPrint(&buf, ":{{\"dtype\":\"{s}\",\"shape\":[", .{it.dtype.name()}));
+            for (it.shape[0..it.rank], 0..) |d, i| {
+                if (i > 0) try head.append(w.gpa, ',');
+                try head.appendSlice(w.gpa, try std.fmt.bufPrint(&buf, "{d}", .{d}));
+            }
+            try head.appendSlice(w.gpa, try std.fmt.bufPrint(&buf, "],\"data_offsets\":[{d},{d}]}}", .{ at, at + it.data.len }));
+            at += it.data.len;
+        }
+        try head.append(w.gpa, '}');
+        while ((8 + head.items.len) % 8 != 0) try head.append(w.gpa, ' ');
+        const file = try std.Io.Dir.cwd().createFile(io, path, .{ .truncate = true });
+        defer file.close(io);
+        var prefix: [8]u8 = undefined;
+        std.mem.writeInt(u64, &prefix, head.items.len, .little);
+        try file.writePositionalAll(io, &prefix, 0);
+        try file.writePositionalAll(io, head.items, 8);
+        var off: u64 = 8 + head.items.len;
+        for (w.items.items) |it| {
+            try file.writePositionalAll(io, it.data, off);
+            off += it.data.len;
+        }
+    }
+};
+
+fn quote(gpa: std.mem.Allocator, out: *std.ArrayList(u8), s: []const u8) !void {
+    try out.append(gpa, '"');
+    for (s) |c| switch (c) {
+        '"' => try out.appendSlice(gpa, "\\\""),
+        '\\' => try out.appendSlice(gpa, "\\\\"),
+        0...0x1f => {
+            var buf: [6]u8 = undefined;
+            try out.appendSlice(gpa, try std.fmt.bufPrint(&buf, "\\u{x:0>4}", .{c}));
+        },
+        else => try out.append(gpa, c),
+    };
+    try out.append(gpa, '"');
+}
+
+/// bf16 bits to f32.
+pub fn bf16ToF32(bits: u16) f32 {
+    return @bitCast(@as(u32, bits) << 16);
+}
+
+/// f32 to bf16 bits, round to nearest even (NaN kept quiet).
+pub fn f32ToBf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @intCast((u >> 16) | 0x40);
+    const lsb = (u >> 16) & 1;
+    return @intCast((u +% 0x7fff +% lsb) >> 16);
+}
+
+const testing = std.testing;
+
+test "inkling2 st: a written file reads back by name, with metadata, shapes and bytes" {
+    var tmp = testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = testing.io;
+    var w = Writer.init(testing.allocator);
+    defer w.deinit();
+    const a = [_]u16{ 1, 2, 3, 4, 5, 6 };
+    const b = [_]i32{ -7, 9 };
+    try w.add("h.3", .bf16, &.{ 2, 3 }, std.mem.sliceAsBytes(&a));
+    try w.add("route.ids.3", .i32, &.{ 1, 2 }, std.mem.sliceAsBytes(&b));
+    try w.add("odd \"name\"", .u8, &.{3}, "xyz");
+    try w.setMeta("layers", "3,4");
+    try testing.expectError(error.BadShape, w.add("bad", .f32, &.{2}, "abc"));
+    const dir = try tmp.dir.realPathFileAlloc(io, ".", testing.allocator);
+    defer testing.allocator.free(dir);
+    const path = try std.fs.path.join(testing.allocator, &.{ dir, "x.safetensors" });
+    defer testing.allocator.free(path);
+    try w.write(io, path);
+    var r = try Reader.open(testing.allocator, io, path);
+    defer r.close();
+    try testing.expectEqual(@as(usize, 3), r.entries.len);
+    try testing.expectEqualStrings("3,4", r.metaValue("layers").?);
+    const e = r.find("h.3").?;
+    try testing.expectEqual(@as(u64, 3), e.dim(1));
+    const got = try r.alloc(testing.allocator, "h.3", .bf16);
+    defer testing.allocator.free(got);
+    try testing.expectEqualSlices(u8, std.mem.sliceAsBytes(&a), got);
+    const ids = try r.alloc(testing.allocator, "route.ids.3", .i32);
+    defer testing.allocator.free(ids);
+    try testing.expectEqual(@as(i32, -7), std.mem.bytesToValue(i32, ids[0..4]));
+    try testing.expectError(error.UnexpectedDType, r.alloc(testing.allocator, "h.3", .f32));
+    try testing.expect(r.find("odd \"name\"") != null);
+    try testing.expect(r.find("missing") == null);
+}
+
+test "inkling2 st: bf16 rounding is nearest even" {
+    try testing.expectEqual(@as(u16, 0x3f80), f32ToBf16(1.0));
+    try testing.expectEqual(@as(u16, 0x3f80), f32ToBf16(@bitCast(@as(u32, 0x3f808000)))); // tie to even (down)
+    try testing.expectEqual(@as(u16, 0x3f82), f32ToBf16(@bitCast(@as(u32, 0x3f818000)))); // tie to even (up)
+    try testing.expectEqual(@as(f32, 1.0), bf16ToF32(0x3f80));
+}
