+        };
+        e.slots.deinit(e.gpa);
+        if (e.pool) |p| p.deinit();
+        if (e.vision) |r| r.destroy();
+        e.freeHead();
+        if (e.drafter) |dr| dr.deinit();
+        if (e.xover) |*v| v.deinit();
+        if (e.parts) |*p| p.deinit();
