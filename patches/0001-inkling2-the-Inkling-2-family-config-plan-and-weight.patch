+        try seen.put(testing.allocator, k, {});
+    };
+    inline for (.{ "at", "tokens", "rows", "cols" }) |field| {
+        var x = ims;
+        @field(x[1], field) += 1;
+        try testing.expect(!seen.contains(prefixKey(&x, 37)));
+        try testing.expect(!std.mem.eql(u8, &k36, &prefixKey(&x, 37)));
