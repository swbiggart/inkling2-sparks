+fn noCopy(ctx: *anyopaque, dst: u64, src: u64, bytes: usize) anyerror!void {
+    _ = ctx;
+    _ = dst;
+    _ = src;
+    _ = bytes;
+    return error.Unexpected;
+}
+
+fn noDone(ctx: *anyopaque) anyerror!void {
+    _ = ctx;
+    return error.Unexpected;
+}
