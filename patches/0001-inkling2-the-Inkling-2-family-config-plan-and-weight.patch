+test "inkling2 cuda engine: the NVMe tier's switch moves the agreed settings digest, not its identity's" {
+    // Engine.fingerprint: the switch's text is hashed after everything else and only when on, so a rank with it on
+    // and one with it off (or another cap) differ in the agreed digest (RankMismatch on every rank), while the
+    // identity's settings (the digest before it) stay the same: a cap change keeps the tier's files
+    const Sha = std.crypto.hash.sha2.Sha256;
+    const base = "world 4 layers 48 context 131072 scratch 0 rows 2048 mode default attn kx";
+    var digests: [3][32]u8 = undefined;
+    var ids: [3][32]u8 = undefined;
+    const cfgs = [_]nvme.Config{ .{}, try nvme.configFrom("/var/cache/x", null, null), try nvme.configFrom("/var/cache/x", "32", null) };
+    for (cfgs, 0..) |c, i| {
+        var h = Sha.init(.{});
+        settingsHash(&h, RawSettings{ .text = base }, false, true, .deepen);
+        var before = h;
+        before.final(&ids[i]);
+        var nb: [96]u8 = undefined;
+        h.update(nvme.settingsText(c, &nb));
+        h.final(&digests[i]);
+    }
+    var v02: [32]u8 = undefined;
+    Sha.hash(base, &v02, .{});
+    try std.testing.expectEqualSlices(u8, &v02, &digests[0]); // off: v0.2's
+    try std.testing.expect(!std.mem.eql(u8, &digests[0], &digests[1])); // on against off
+    try std.testing.expect(!std.mem.eql(u8, &digests[1], &digests[2])); // another cap
+    try std.testing.expectEqualSlices(u8, &ids[0], &ids[1]);
+    try std.testing.expectEqualSlices(u8, &ids[1], &ids[2]);
+    // the directory and the floor are each rank's own: not hashed
+    var a: [96]u8 = undefined;
+    var b: [96]u8 = undefined;
+    try std.testing.expectEqualStrings(nvme.settingsText(try nvme.configFrom("/a", "64", "8"), &a), nvme.settingsText(try nvme.configFrom("/b/c", "64", "100"), &b));
+}
