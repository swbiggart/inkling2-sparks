+test "inkling2 cuda engine: a settings text past v0.2's 768 bytes is hashed whole, so ranks that differ in it refuse" {
+    // a long raw value on one rank (TF_INK2_CK_PROFILE, never parsed before the agreement): v0.2's buffer could not hold
+    // the text, so that rank failed before the gather and the others waited in it. Now every rank hashes its whole
+    // text: one long value and another (or none) give different digests, the same long value the same digest.
+    if (std.c.getenv("TF_INK2_CK_PROFILE") != null) return error.SkipZigTest;
+    const env_fns = struct {
+        extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+        extern "c" fn unsetenv(name: [*:0]const u8) c_int;
+    };
+    defer _ = env_fns.unsetenv("TF_INK2_CK_PROFILE");
+    const gpa = std.testing.allocator;
+    const Sha = std.crypto.hash.sha2.Sha256;
+    const base: Settings = .{ .world = 4, .layers = 48, .context = 131072, .scratch_gib = scratch.default_gib, .mode = .checkpoint, .drafter = true };
+    const digest = struct {
+        fn of(b: Settings) [32]u8 {
+            var h = Sha.init(.{});
+            settingsHash(&h, b, false, true, .deepen);
+            var d: [32]u8 = undefined;
+            h.final(&d);
+            return d;
+        }
+    }.of;
+    const unset = digest(base);
+    var long: [1500:0]u8 = undefined;
+    @memset(long[0..], 'a');
+    _ = env_fns.setenv("TF_INK2_CK_PROFILE", &long, 1);
+    var aw: std.Io.Writer.Allocating = .init(gpa);
+    defer aw.deinit();
+    try aw.writer.print("{f}", .{base});
