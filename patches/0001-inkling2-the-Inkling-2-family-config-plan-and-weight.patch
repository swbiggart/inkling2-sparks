+    if (!drafted) return "";
+    var w: std.Io.Writer = .fixed(buf);
+    w.writeAll(" depths=") catch return "";
+    var first = true;
+    var d: usize = s.depth_rounds.len;
+    while (d > 0) {
+        d -= 1;
+        if (s.depth_rounds[d] == 0) continue;
