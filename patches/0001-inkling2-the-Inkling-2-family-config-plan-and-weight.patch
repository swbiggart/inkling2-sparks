+    for ([_]struct { d: *const Digest, n: u32, row0: u32 }{ .{ .d = &a, .n = 2, .row0 = 0 }, .{ .d = &b, .n = 2, .row0 = 2 }, .{ .d = &c, .n = 10, .row0 = 4 } }) |x| {
+        try testing.expectEqual(x.row0, try s.alloc(x.d, x.n));
