+/// One rank's weights, state and activations, its exchange and forward (addresses fixed: the forward points in).
+const Rank = struct {
+    w: ic.weights.Weights,
+    act: ic.state.Act,
+    st: ic.state.State,
+    x: ic.tp.Exchange,
+    f: fwd.Forward = undefined,
+
+    fn deinit(r: *Rank) void {
+        r.st.deinit();
+        r.act.deinit();
+        r.w.deinit();
+    }
+};
+
+/// Layer li on every rank this process runs: real ranks gather inside the layer; virtual ranks run each stage on
+/// every rank before the next stage, so the sums (and split experts' gathers) read every rank's part.
+fn runLayer(ranks: []Rank, virtual: bool, li: u32, R: usize, pos0: usize) !void {
+    if (!virtual) return ranks[0].f.layer(li, R, pos0);
+    for (ranks) |*r| try r.f.attnStage(li, R, pos0);
+    for (ranks) |*r| try r.f.mlpStage(li, R, pos0);
+    if (ranks[0].f.split()) for (ranks) |*r| try r.f.downStage(li, R, pos0);
+    for (ranks) |*r| try r.f.outStage(li, R, pos0);
+}
+
+/// W > 1 with --embed: rank 0's embedding rows (in its h[0]) to every rank's h[0].
+fn shareEmbed(ranks: []Rank, o: Opts, R: usize) !void {
+    const f0 = &ranks[0].f;
+    const c = &f0.c;
+    const h = f0.a.h[0].slice(0, R);
+    const n = R * H * 2;
+    if (o.virtual) {
+        for (ranks[1..]) |*r| try c.copyRows(r.f.a.h[0].slice(0, R), h);
+        return;
+    }
+    const x = &ranks[0].x;
+    const buf = x.parts.ptr[0];
+    try c.copy(buf + @as(u64, x.rank) * n, h.ptr, n);
+    try x.group.?.allGather(c.stream, buf + @as(u64, x.rank) * n, buf, n);
+    try c.copy(h.ptr, buf, n);
+}
+
+/// What every rank must agree on before loading: the executable, the checkpoint (config, quantization manifest,
+/// every tensor's name, file, offset and size), and the run's settings and prompt.
+const Fingerprint = extern struct {
+    program: [32]u8,
+    checkpoint: [32]u8,
+    settings: [32]u8,
+    rank: u32,
+    world: u32,
+};
+
+fn hashFile(gpa: std.mem.Allocator, io: std.Io, h: *std.crypto.hash.sha2.Sha256, path: []const u8) !void {
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(1 << 30)) catch |e| switch (e) {
+        error.FileNotFound => return h.update("(none)"),
+        else => return e,
+    };
+    defer gpa.free(bytes);
+    h.update(bytes);
+}
+
+fn agree(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: cuda.Stream, g: *const cuda.tp_group.Group, m: *const ink.describe.Model, o: Opts, ids: []const i64, manifest: ?[]const u8) !void {
+    const Sha = std.crypto.hash.sha2.Sha256;
+    var fp: Fingerprint = .{ .program = undefined, .checkpoint = undefined, .settings = undefined, .rank = o.rank, .world = o.world };
+    var prompt_xxh64: u64 = 0;
+    {
+        var h = Sha.init(.{});
+        try hashFile(gpa, io, &h, "/proc/self/exe");
+        h.final(&fp.program);
+    }
+    {
+        var h = Sha.init(.{});
+        for ([_][]const u8{ "config.json", "hf_quant_config.json", "model.safetensors.index.json" }) |name| {
+            const path = try std.fs.path.join(gpa, &.{ o.dir, name });
+            defer gpa.free(path);
+            try hashFile(gpa, io, &h, path);
+        }
+        for (m.inv.tensors) |t| {
+            h.update(t.name);
+            h.update(std.mem.asBytes(&[3]u64{ t.file, m.inv.offset(t), t.bytes() }));
+        }
+        // the expected contents: every rank's piece digests (each rank checks its own after loading)
+        h.update(manifest orelse "(no digest manifest)");
+        h.final(&fp.checkpoint);
+    }
+    {
+        var h = Sha.init(.{});
+        var buf: [128]u8 = undefined;
+        const env = struct {
+            fn get(name: [*:0]const u8) []const u8 {
+                return if (std.c.getenv(name)) |v| std.mem.span(v) else "";
+            }
+        }.get;
+        // the text straight into the hash, whatever its length (a 512-byte buffer failed one rank on a long value
+        // before the gather, while the others waited in it); a hashing writer's drain only hashes, so nothing fails
+        var hw: std.Io.Writer.Hashing(Sha) = .initHasher(h, &buf);
+        hw.writer.print("world {d} layers {d}:{d} embed {} head {} teacher {} chunk {d} scratch {d} mode {s} experts {s} TF_INK2_ATTN={s} XROWS={s} CK_SHAPE1={s} prompt {s}", .{ o.world, o.lo, o.hi, o.embed, o.head, o.teacher, o.chunk, o.scratch_gib, @tagName(o.mode), @tagName(o.experts), env("TF_INK2_ATTN"), env("TF_INK2_XROWS"), env("TF_INK2_CK_SHAPE1"), std.fs.path.basename(o.prompt) }) catch {};
+        // a value holding a space could shift a boundary between fields: then their lengths too (none added otherwise)
+        ic.engine.writeRawLengths(&hw.writer, &.{ env("TF_INK2_ATTN"), env("TF_INK2_XROWS"), env("TF_INK2_CK_SHAPE1"), std.fs.path.basename(o.prompt) }) catch {};
+        hw.writer.flush() catch {};
+        h = hw.hasher;
+        // the prompt chunks' overlap and MoE-A as codes (cuda_xover.zig): Forward.layer reads them, and a rank set
+        // differently issues other collectives (codes: an amax and a codes gather in place of the bf16 MoE-A), so the
+        // ranks agree on them as the engine does; nothing is added when they are off, so those bytes are unchanged
+        ic.xover.hashSettings(&h);
+        h.update(std.mem.sliceAsBytes(ids));
+        // the prompt file's bytes: the oracle rows each rank reads (h.*, embed, final), not only its name and ids
+        prompt_xxh64 = try fileXxh64(gpa, io, o.prompt);
+        h.update(std.mem.asBytes(&prompt_xxh64));
+        h.final(&fp.settings);
+    }
+    var all: [ink.plan.max_world]Fingerprint = undefined;
+    try g.gather(Fingerprint, d, s, fp, all[0..o.world]);
+    var ok = true;
+    for (all[0..o.world], 0..) |x, r| {
+        const why: ?[]const u8 = if (x.rank != r or x.world != o.world) "rank or world" else if (!std.mem.eql(u8, &x.program, &fp.program)) "the executable" else if (!std.mem.eql(u8, &x.checkpoint, &fp.checkpoint)) "the checkpoint" else if (!std.mem.eql(u8, &x.settings, &fp.settings)) "the settings or prompt (incl. TF_INK2_XOVERLAP*, TF_INK2_XCODES)" else null;
+        if (why) |w| {
+            std.debug.print("rank {d}: rank {d} differs from this rank in {s}\n", .{ o.rank, r, w });
+            ok = false;
+        }
+    }
+    if (!ok) return error.RankMismatch;
+    std.debug.print("rank {d} of {d}: fingerprint agreed (executable {x}, checkpoint and digest manifest {x}, settings and prompt {x}; prompt file xxh64 {x:0>16})\n", .{ o.rank, o.world, fp.program[0..6], fp.checkpoint[0..6], fp.settings[0..6], prompt_xxh64 });
+}
+
+/// xxh64 of a file's bytes, read 16 MiB at a time.
+fn fileXxh64(gpa: std.mem.Allocator, io: std.Io, path: []const u8) !u64 {
+    const f = try std.Io.Dir.cwd().openFile(io, path, .{});
+    defer f.close(io);
+    const buf = try gpa.alloc(u8, 16 << 20);
+    defer gpa.free(buf);
+    var h = std.hash.XxHash64.init(0);
+    var at: u64 = 0;
+    while (true) {
+        const n = try f.readPositionalAll(io, buf, at);
+        h.update(buf[0..n]);
+        at += n;
+        if (n < buf.len) break;
+    }
+    return h.final();
+}
+
+/// A real rank stops: the others hear it on their liveness lines and stop, and this rank's communicator is aborted, so
+/// no kernel of its stream waits on a peer (cuda/tp_group.zig). Safe to call more than once.
+fn bail(g: *cuda.tp_group.Group, why: []const u8) void {
+    cuda.tp_watch.fail(why);
+    g.abort();
+}
+
+/// TF_INK2_FAULT (tests of the failure paths): `fail:R:L` rank R fails before layer L; `digest:R` rank R's final hash
+/// of its layer outputs is off by one bit (as if its outputs differed).
+const Fault = struct {
+    kind: enum { none, fail, digest } = .none,
+    rank: u32 = 0,
+    layer: u32 = 0,
+
+    fn read() Fault {
+        const v = std.mem.span(std.c.getenv("TF_INK2_FAULT") orelse return .{});
+        var it = std.mem.splitScalar(u8, v, ':');
+        const k = it.next() orelse return .{};
+        const r = std.fmt.parseInt(u32, it.next() orelse return .{}, 10) catch return .{};
+        if (std.mem.eql(u8, k, "digest")) return .{ .kind = .digest, .rank = r };
+        const l = std.fmt.parseInt(u32, it.next() orelse return .{}, 10) catch return .{};
+        if (std.mem.eql(u8, k, "fail")) return .{ .kind = .fail, .rank = r, .layer = l };
+        return .{};
+    }
+
+    fn at(f: Fault, kind: @TypeOf(f.kind), rank: u32, layer: ?u32) bool {
+        return f.kind == kind and f.rank == rank and (layer == null or layer.? == f.layer);
+    }
+};
+
+/// sha256 over the dump's layer outputs and routes (the tensors every rank computes).
+fn digest(x: *const Dump) [32]u8 {
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    var it = x.tensors.iterator();
+    while (it.next()) |e| {
+        const k = e.key_ptr.*;
+        if (!std.mem.startsWith(u8, k, "h.") and !std.mem.startsWith(u8, k, "route.")) continue;
+        h.update(k);
+        h.update(e.value_ptr.data);
+    }
+    var out: [32]u8 = undefined;
+    h.final(&out);
+    return out;
+}
+
+fn stopped(a: std.mem.Allocator, s: ?fwd.Stop, e: anyerror) ![]const u8 {
+    const x = s orelse return std.fmt.allocPrint(a, "failed: {t}", .{e});
+    if (x.err == error.NotImplemented) return std.fmt.allocPrint(a, "stopped at layer {f} op {s}: NotImplemented (no kernel yet)", .{ x.scope, x.op });
+    return std.fmt.allocPrint(a, "failed at layer {f} op {s}: {t}", .{ x.scope, x.op, x.err });
+}
+
+/// The forward's input rows start .. start + R: layer lo's input in h[0], the blocks below lo.
+fn inputs(gpa: std.mem.Allocator, f: *fwd.Forward, oracle: *const ink.st.Reader, ids: []const i64, o: Opts, start: usize, R: usize) !void {
+    const act = f.a;
+    act.nblocks = 0;
+    if ((o.lo == 0 or o.synthetic) and o.embed) {
+        if (f.w.embed == 0) return; // rank > 0: rank 0's rows come by shareEmbed
+        const host = try gpa.alloc(i32, R);
+        defer gpa.free(host);
+        for (host, ids[start..][0..R]) |*h, v| h.* = @intCast(v);
+        try upload(f, act.tokens.ptr, std.mem.sliceAsBytes(host));
+        try f.embed(R, start);
+        return;
+    }
+    try oracleState(gpa, f, oracle, o.lo, start, R);
+}
+
+/// Layer L's input from the oracle, rows start .. start + R: h.<L-1> (or the embedding) in h[0], and the blocks
+/// below L (L = 48: the final mix's inputs).
+fn oracleState(gpa: std.mem.Allocator, f: *fwd.Forward, oracle: *const ink.st.Reader, L: u32, start: usize, R: usize) !void {
+    const act = f.a;
+    var buf: [16]u8 = undefined;
+    const name = if (L == 0) "embed" else try std.fmt.bufPrint(&buf, "h.{d}", .{L - 1});
+    try rows(gpa, f, oracle, name, start, R, act.h[0].slice(0, R));
+    const nb = fwd.blocksBefore(L);
+    for (0..nb) |i| {
+        const b: u32 = @intCast(6 * i); // the input of layer b: the embedding, or layer b - 1's output
+        const src = if (b == 0) "embed" else try std.fmt.bufPrint(&buf, "h.{d}", .{b - 1});
+        try rows(gpa, f, oracle, src, start, R, act.block(i, R));
+    }
+    act.nblocks = nb;
+}
+
+fn rows(gpa: std.mem.Allocator, f: *fwd.Forward, r: *const ink.st.Reader, name: []const u8, lo: usize, n: usize, dst: Mat) !void {
+    const e = r.find(name) orelse {
+        std.log.err("inkling2: the oracle file has no {s}", .{name});
+        return error.MissingTensor;
+    };
+    if (e.dtype != .bf16 or e.rank != 2 or e.dim(1) != H or lo + n > e.dim(0)) return error.UnexpectedOracleTensor;
+    const host = try gpa.alloc(u8, n * H * 2);
+    defer gpa.free(host);
+    try r.readInto(e, lo * H * 2, host);
+    try upload(f, dst.ptr, host);
+}
+
+fn upload(f: *fwd.Forward, ptr: u64, bytes: []const u8) !void {
+    try f.c.stream.synchronize();
+    const view: cuda.DeviceBuffer = .{ .d = f.c.d, .ptr = ptr, .len = bytes.len, .borrowed = true };
+    try view.upload(0, bytes);
+}
+
+/// --prof: one forward's table, ms a rank (the sum over this process's ranks / nlocal) by op and layer.
+fn printProf(p: *const ic.forward.Prof, lo: u32, hi: u32, nlocal: u32, start: usize, R: usize) void {
+    const n: f64 = @floatFromInt(nlocal);
+    std.debug.print("prof forward rows {d}..{d} ({d} rows), ms a rank\nprof op", .{ start, start + R - 1, R });
+    for (lo..hi) |l| std.debug.print("\tL{d}", .{l});
+    std.debug.print("\tmean\n", .{});
+    var tot: [ic.forward.Prof.rows]f64 = @splat(0);
+    for (p.labels[0..p.nlabels], 0..) |name, j| {
+        std.debug.print("prof {s}", .{name});
+        var sum: f64 = 0;
+        for (lo..hi) |l| {
+            const v = p.ms[l][j] / n;
+            tot[l] += v;
+            sum += v;
+            std.debug.print("\t{d:.3}", .{v});
+        }
+        std.debug.print("\t{d:.3}\n", .{sum / @as(f64, @floatFromInt(hi - lo))});
+    }
+    std.debug.print("prof total", .{});
+    var sum: f64 = 0;
+    for (lo..hi) |l| {
+        sum += tot[l];
+        std.debug.print("\t{d:.3}", .{tot[l]});
+    }
+    std.debug.print("\t{d:.3}\n", .{sum / @as(f64, @floatFromInt(hi - lo))});
+}
+
+/// The head over `ys` (the final rows, the same on every rank): each rank's share of the logits into its block of
+/// `parts`, gathered in rank order (real ranks) or written there one rank after another (virtual), then rank 0's
+/// softcap over all of them into `out`.
+fn headShares(ranks: []Rank, o: Opts, ys: Mat, parts: u64, out: Mat, row0: usize) !void {
+    for (ranks) |*r| try r.f.unembedShare(ys, parts, r.x.rank, row0);
+    const n = ys.rows;
+    const share: usize = ranks[0].w.vocab_rows.len();
+    if (!o.virtual and o.world > 1) {
+        const x = &ranks[0].x;
+        const bytes = n * share * 2;
+        try x.group.?.allGather(ranks[0].f.c.stream, parts + @as(u64, x.rank) * bytes, parts, bytes);
+    }
+    if (ranks[0].x.rank != 0) return;
+    try ranks[0].f.softcapShares(parts, o.world, out, row0);
+}
+
+/// The head's selected rows and their logits: the ranks' bf16 shares as gathered, and the softcapped logits.
+const HeadBufs = struct {
+    rows: Mat,
+    parts: u64,
+    out: Mat,
+    own: [3]cuda.DeviceBuffer,
+
+    fn init(d: *const cuda.Driver, n: usize, world: u32, share: usize, unpadded: usize) !HeadBufs {
+        var own: [3]cuda.DeviceBuffer = undefined;
+        own[0] = try cuda.DeviceBuffer.alloc(d, @max(n, 1) * H * 2);
+        errdefer own[0].free();
+        own[1] = try cuda.DeviceBuffer.alloc(d, @as(usize, world) * @max(n, 1) * share * 2);
+        errdefer own[1].free();
+        own[2] = try cuda.DeviceBuffer.alloc(d, @max(n, 1) * unpadded * 4);
+        return .{ .rows = Mat.of(own[0].ptr, n, H, .bf16), .parts = own[1].ptr, .out = Mat.of(own[2].ptr, n, unpadded, .f32), .own = own };
+    }
+
+    fn deinit(h: *HeadBufs) void {
+        for (&h.own) |*b| b.free();
+    }
+};
+
+fn secs(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-9;
+}
+
+fn gib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 30);
+}
diff --git a/zig/src/families/inkling2/cuda_scratch.zig b/zig/src/families/inkling2/cuda_scratch.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d9b6cd72b3781f58a4da68a8f5087b72654b7e89
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_scratch.zig
@@ -0,0 +1,210 @@
+//! The op scratch a forward takes (cuda_ops.zig Scratch: a bump arena the forward resets before every op), counted
+//! from the ops' own sizes so a step can be checked before its header goes out: a short scratch found after the header
+//! stops every rank (the others wait in a collective), one found before refuses only the step.
+//!
+//! The takes, op by op (each op from an empty scratch; cuda_forward.zig resets before every op and, in a forward of
+//! several segments, before each segment's attention core):
+//!   attn.project  the lane matmul's split-K partials of the layer's projections (cuda_attn.zig linear), in one op
+//!   attn.core     the split form's pairs, partials, kept scores and folded pairs (cuda_attn.zig Plan.scratch), a
+//!                 segment at a time: its rows, its first position, and in a captured step the slot's capacity
+//!   attn.out      the output projection's partials
+//!   moe.experts   checkpoint mode: cuda_moe.zig ckScratchBytes; full mode: scratchBytes; split experts: splitUp's
+//!                 quantized rows and route bitmaps (moe.down: splitDown's quantized activations and route rows)
+//! All but the core depend only on the forward's rows; the core on each segment's position. The largest at a slot's
+//! context over every forward the engine runs (`startupNeed`: up to prompt_rows rows eager, up to a verify window as
+//! a captured step) is checked once at start-up; `fits` checks one forward.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const attn = @import("cuda_attn.zig");
+const moe = @import("cuda_moe.zig");
+const weights = @import("cuda_weights.zig");
+
+const Kernels = ops.Kernels;
+const H = weights.hidden;
+
+/// The op scratch a rank holds by default, GiB (TF_INK2_SCRATCH_GIB, whole GiB, in the settings the ranks agree on).
+/// Measured need at W = 4: about 0.2 GiB at a 131,072-position slot with 2,048-row prompt chunks (--exp scratch);
+/// the start-up check (`checkStartup`) refuses a context whose need passes it.
+pub const default_gib: usize = 1;
+
+/// TF_INK2_SCRATCH_GIB, else `default_gib`.
+pub fn gib() usize {
+    const v = std.c.getenv("TF_INK2_SCRATCH_GIB") orelse return default_gib;
+    return std.fmt.parseInt(usize, std.mem.span(v), 10) catch default_gib;
+}
+
+/// One segment of a forward: `rows` rows from position `pos0`; `positions` the slot's capacity when the forward runs
+/// as a captured step (the core's scratch then spans the slot), 0 eager.
+pub const Part = struct { pos0: usize, rows: usize, positions: usize = 0 };
+
+/// The kind of forward `parts` make (cuda_ops.zig Scratch.kind, for the peaks by kind).
+pub fn kindOf(parts: []const Part) ops.Scratch.Kind {
+    if (parts.len > 1) return .batched;
+    if (parts.len == 0) return .other;
+    const R = parts[0].rows;
+    return if (R == 1) .decode else if (R <= 8) .window else .prompt;
+}
+
+/// Takes in order, each 256-byte aligned as Scratch.take aligns: the op's high-water mark.
+fn takes(list: []const usize) usize {
+    var at: usize = 0;
+    for (list) |b| if (b > 0) {
+        at = std.mem.alignForward(usize, at, 256) + b;
+    };
+    return at;
+}
+
+/// The lane matmul's partials of a projection (0 for a layer not packed).
+fn part(k: *const Kernels, l: *const weights.Layer, p: attn.Packed, R: usize) usize {
+    if (l.extra[0] == 0) return 0;
+    return k.attn.lane.partBytes(R, attn.lanes(l, p));
+}
+
+/// The most any op but the attention core takes in a forward of R rows (all segments together).
+pub fn rowsNeed(k: *const Kernels, w: *const weights.Weights, R: usize) usize {
+    if (R == 0) return 0;
+    var most: usize = 0;
+    const routes = R * moe.topk;
+    const I = moe.intermediate;
+    // layers alike in these give the same takes (2-4 classes in the model): count each class once
+    var seen: [8][5]u32 = undefined;
+    var nseen: usize = 0;
+    layers: for (w.layers) |*l| {
+        const E0 = &l.experts;
+        const key = [5]u32{ @intFromBool(l.global), @intFromEnum(E0.format), E0.split, E0.count(), E0.n2 };
+        for (seen[0..nseen]) |x| if (std.mem.eql(u32, &x, &key)) continue :layers;
+        if (nseen < seen.len) {
+            seen[nseen] = key;
+            nseen += 1;
+        }
+        // attn.project: q, rel, gate, sink, k, v (+ the global layers' k and v window projections), project's order
+        var pl: [8]usize = undefined;
+        var n: usize = 0;
+        for ([_]attn.Packed{ .q, .rel, .gate, .sink, .k, .v }) |p| {
+            pl[n] = part(k, l, p, R);
+            n += 1;
+        }
+        if (l.global) for ([_]attn.Packed{ .k_wproj, .v_wproj }) |p| {
+            pl[n] = part(k, l, p, R);
+            n += 1;
+        };
+        most = @max(most, takes(pl[0..n]));
+        if (R <= attn.one_rows) if (attn.oneGroups(l)) |g| {
+            var ps: [3]usize = undefined; // attn.projectOne, its launches' takes
+            for (0..g.n) |i| ps[i] = k.attn.lane.partBytes(R, g.w[i]);
+            most = @max(most, takes(ps[0..g.n]));
+        };
+        most = @max(most, part(k, l, .o, R));
+        const E = &l.experts;
+        if (E.count() == 0) continue;
+        const nv = E.format == .nvfp4;
+        if (E.split > 1) {
+            // splitUp: the rows quantized (codes, scales, amax), then ckPlan's bitmaps over every expert
+            most = @max(most, takes(&.{ if (nv) R * H / 2 else R * H, if (nv) R * H / 16 else R * H / 32, if (nv) R * 4 else 0, 2 * moe.experts_total * ((R + 31) / 32) * 4 }));
+            // splitDown: the activations quantized, the route rows
+            most = @max(most, takes(&.{ if (nv) routes * I / 2 else routes * I, if (nv) routes * I / 16 else routes * I / 32, if (nv) routes * 4 else 0, routes * @as(usize, E.n2) * 2 }));
+        } else if (k.moe.mode == .checkpoint) {
+            most = @max(most, moe.ckScratchBytes(R, E.count(), k.moe.shape(routes, nv, 0), E.format));
+        } else most = @max(most, moe.scratchBytes(R, E.count(), moe.rowTiles(routes, E.count())));
+    }
+    return most;
+}
+
+/// The attention core's take for one segment (sliding and global layers; the rank's heads).
+pub fn coreNeed(k: *const Kernels, hq: usize, hk: usize, g: Part) usize {
+    var most: usize = 0;
+    for ([_]usize{ 0, attn.window }) |win| {
+        const kv: attn.Kv = .{ .k = 0, .v = 0, .slots = if (win == 0) @max(g.positions, g.pos0 + g.rows) else win - 1 + g.rows, .heads = hk, .window = win };
+        const dev: ?attn.Dev = if (g.positions > 0) .{ .posp = 1, .positions = g.positions } else null;
+        most = @max(most, attn.plan(&k.attn, g.rows, g.pos0, dev, kv, hq, hk).scratch(g.rows, hq));
+    }
+    return most;
+}
+
+/// The op scratch a forward of `parts` takes at most: its largest op's.
+pub fn need(k: *const Kernels, w: *const weights.Weights, parts: []const Part) usize {
+    if (w.layers.len == 0) return 0;
+    const l0 = &w.layers[0];
+    var R: usize = 0;
+    var most: usize = 0;
+    for (parts) |g| {
+        R += g.rows;
+        most = @max(most, coreNeed(k, l0.hq, l0.hk, g));
+    }
+    return @max(most, rowsNeed(k, w, R));
+}
+
+/// Before a step's header: whether `s` holds the forward of `parts` (every rank's scratch is the same size and the
+/// ranks' shapes are alike, so rank 0's answer is every rank's). error.ScratchShort, logged with the need, when not.
+pub fn fits(s: *const ops.Scratch, k: *const Kernels, w: *const weights.Weights, parts: []const Part) error{ScratchShort}!void {
+    const n = need(k, w, parts);
+    if (n <= s.buf.len) return;
+    std.log.err("inkling2: a forward of {d} segment(s) ({d} rows, the first at position {d}) needs {d:.1} MiB of op scratch, {d} MiB held (TF_INK2_SCRATCH_GIB): refused before its header", .{ parts.len, rowsOf(parts), if (parts.len > 0) parts[0].pos0 else 0, ops.mib(n), s.buf.len >> 20 });
+    return error.ScratchShort;
+}
+
+/// `fits` for the engine's segments (anything with `pos0` and `rows`): `positions` the slot's capacity when the
+/// forward runs as a captured step, null eager.
+pub fn fitsSegs(s: *const ops.Scratch, k: *const Kernels, w: *const weights.Weights, segs: anytype, positions: ?usize) error{ScratchShort}!void {
+    var ps: [16]Part = undefined;
+    if (segs.len > ps.len) return error.ScratchShort;
+    for (segs, 0..) |g, i| ps[i] = .{ .pos0 = g.pos0, .rows = g.rows, .positions = positions orelse 0 };
+    return fits(s, k, w, ps[0..segs.len]);
+}
+
+fn rowsOf(parts: []const Part) usize {
+    var R: usize = 0;
+    for (parts) |g| R += g.rows;
+    return R;
+}
+
+/// The most op scratch any forward at a slot of `context` positions takes: up to `rows` rows (eager, any position)
+/// and up to `graph_rows` as a captured step (cuda_attn.zig scratchNeed for the core), and every row count's other ops.
+pub fn startupNeed(k: *const Kernels, w: *const weights.Weights, context: usize, rows: usize, graph_rows: usize) struct { total: usize, core: usize, other: usize } {
+    if (w.layers.len == 0) return .{ .total = 0, .core = 0, .other = 0 };
+    const l0 = &w.layers[0];
+    const core = attn.scratchNeed(&k.attn, l0.hq, l0.hk, context, rows, graph_rows);
+    var other: usize = 0;
+    for (1..rows + 1) |R| other = @max(other, rowsNeed(k, w, R));
+    return .{ .total = @max(core, other), .core = core, .other = other };
+}
+
+/// Start-up, on every rank, after the weights are loaded and prepared (the projections' lane forms): the op scratch
+/// must hold `startupNeed`, so no forward of a slot of `context` positions can be short. error.ScratchShort with the
+/// need logged; else the need is logged.
+pub fn checkStartup(s: *const ops.Scratch, k: *const Kernels, w: *const weights.Weights, context: usize, rows: usize, graph_rows: usize, rank: u32) !void {
+    const n = startupNeed(k, w, context, rows, graph_rows);
+    if (n.total > s.buf.len) {
+        std.log.err("inkling2 rank {d}: the op scratch ({d} MiB) is short of {d:.1} MiB at {d} positions a slot (attention core {d:.1}, other ops {d:.1}; raise TF_INK2_SCRATCH_GIB or lower the context)", .{ rank, s.buf.len >> 20, ops.mib(n.total), context, ops.mib(n.core), ops.mib(n.other) });
+        return error.ScratchShort;
+    }
+    std.log.info("inkling2 rank {d}: op scratch need {d:.1} MiB of {d} MiB at {d} positions a slot (attention core {d:.1}, other ops {d:.1} at up to {d} rows)", .{ rank, ops.mib(n.total), s.buf.len >> 20, context, ops.mib(n.core), ops.mib(n.other), rows });
+}
+
+/// The last `checkTower` refusal (the need and the scratch's bytes) for the server's words (cuda_native.zig
+/// explain); zeros: none.
+pub var tower_short: struct { need: usize = 0, have: usize = 0 } = .{};
+
+/// Rank 0 with the vision tower, after `checkStartup`: a tower unit borrows the op scratch between forwards (begin, a
+/// run of layers, the merger: cuda_vision.zig sliceNeed at the largest image), so the scratch must hold those `bytes`
+/// too. error.ScratchShort with the need logged (and kept in `tower_short`); else the need is logged. The scratch is
+/// the one every rank agreed on; the tower never raises it on rank 0 alone.
+pub fn checkTower(s: *const ops.Scratch, bytes: usize) !void {
+    if (bytes > s.buf.len) {
+        tower_short = .{ .need = bytes, .have = s.buf.len };
+        std.log.err("inkling2 rank 0: the op scratch ({d} MiB) is short of {d:.1} MiB for a vision tower unit at the largest image (raise TF_INK2_SCRATCH_GIB on every rank)", .{ s.buf.len >> 20, ops.mib(bytes) });
+        return error.ScratchShort;
+    }
+    std.log.info("inkling2 rank 0: vision tower: a unit borrows {d:.1} MiB of the op scratch's {d} MiB at the largest image", .{ ops.mib(bytes), s.buf.len >> 20 });
+}
+
+test "inkling2 cuda scratch: takes, kinds" {
+    try std.testing.expectEqual(@as(usize, 0), takes(&.{}));
+    try std.testing.expectEqual(@as(usize, 256 + 10), takes(&.{ 1, 0, 10 }));
+    try std.testing.expectEqual(@as(usize, 512 + 4), takes(&.{ 300, 4 }));
+    try std.testing.expectEqual(ops.Scratch.Kind.decode, kindOf(&.{.{ .pos0 = 9, .rows = 1 }}));
+    try std.testing.expectEqual(ops.Scratch.Kind.window, kindOf(&.{.{ .pos0 = 9, .rows = 8 }}));
+    try std.testing.expectEqual(ops.Scratch.Kind.prompt, kindOf(&.{.{ .pos0 = 0, .rows = 2048 }}));
+    try std.testing.expectEqual(ops.Scratch.Kind.batched, kindOf(&.{ .{ .pos0 = 9, .rows = 1 }, .{ .pos0 = 3, .rows = 1 } }));
+}
