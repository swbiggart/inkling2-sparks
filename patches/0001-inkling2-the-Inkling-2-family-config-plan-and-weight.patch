+    try testing.expectEqual(@as(u32, 0), try s.alloc(&g, 2));
+    try testing.expectEqual(@as(u32, 1 + 5), f.copies);
+    // nothing unpinned and too few rows: the reservations were broken
+    write(&f, &s, &g);
+    s.finish(&g);
+    s.pin(&e);
