diff --git a/zig/src/families/inkling2/cuda_state.zig b/zig/src/families/inkling2/cuda_state.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ce8c7c848caca7a1587498a3e7ad0958a8c3b6d5
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_state.zig
@@ -0,0 +1,675 @@
+//! A forward's activation buffers (`Act`, sized for the widest forward) and one stream's state across forwards
+//! (`State`: each layer's keys and values and its four convolutions' last 3 input rows), with the scaffold's own
+//! state steps: the cache write, the convolution state commits (a forward's, a verify window's keeping its inputs,
+//! and `keep`'s rollback, one launch each) and the block push.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const weights = @import("cuda_weights.zig");
+const attn = @import("cuda_attn.zig");
+const conv = @import("cuda_conv.zig");
+const pages = @import("cuda_pages.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+const D = weights.head_dim;
+
+/// Completed block sources at most (layers 0, 6, ..., 42).
+pub const max_blocks = 8;
+pub const topk = 8;
+pub const experts = 384;
+
+/// Every activation of one forward, `cap` rows each (a forward uses the first R).
+pub const Act = struct {
+    gpa: std.mem.Allocator,
+    cap: usize,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: usize = 0,
+    /// Layer input and output, swapped after each layer.
+    h: [2]Mat = undefined,
+    x: [3]Mat = undefined, // fp32 mix outputs (attention input queries)
+    xn: [3]Mat = undefined, // bf16 normed sources
+    q: Mat = undefined,
+    k: Mat = undefined,
+    v: Mat = undefined,
+    rel: Mat = undefined,
+    gate: Mat = undefined,
+    sink: Mat = undefined,
+    dk: Mat = undefined,
+    dv: Mat = undefined,
+    kc: Mat = undefined,
+    vc: Mat = undefined,
+    qh: Mat = undefined,
+    kh: Mat = undefined,
+    vh: Mat = undefined,
+    relh: Mat = undefined,
+    o: Mat = undefined,
+    ao: Mat = undefined,
+    a: Mat = undefined,
+    partial: Mat = undefined,
+    mx: Mat = undefined,
+    m: Mat = undefined,
+    ids: Mat = undefined,
+    wts: Mat = undefined,
+    logits: Mat = undefined,
+    y: Mat = undefined,
+    cm: Mat = undefined,
+    /// Token ids (i32) for the embedding.
+    tokens: Mat = undefined,
+    /// The blocks: max_blocks matrices [cap, H] bf16, `nblocks` of them complete.
+    blocks: u64 = 0,
+    nblocks: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, cap: usize, hq: usize, hk: usize) !Act {
+        var a: Act = .{ .gpa = gpa, .cap = cap };
+        errdefer a.deinit();
+        for (&a.h) |*m| m.* = try a.mat(d, H, .bf16);
+        for (&a.x) |*m| m.* = try a.mat(d, H, .f32);
+        for (&a.xn) |*m| m.* = try a.mat(d, H, .bf16);
+        a.q = try a.mat(d, hq * D, .bf16);
+        a.k = try a.mat(d, hk * D, .bf16);
+        a.v = try a.mat(d, hk * D, .bf16);
+        a.rel = try a.mat(d, hq * weights.d_rel, .bf16);
+        a.gate = try a.mat(d, hq * D, .bf16);
+        a.sink = try a.mat(d, hq, .bf16);
+        a.dk = try a.mat(d, hk * weights.taps, .bf16);
+        a.dv = try a.mat(d, hk * weights.taps, .bf16);
+        a.kc = try a.mat(d, hk * D, .bf16);
+        a.vc = try a.mat(d, hk * D, .bf16);
+        a.qh = try a.mat(d, hq * D, .bf16);
+        a.kh = try a.mat(d, hk * D, .bf16);
+        a.vh = try a.mat(d, hk * D, .bf16);
+        a.relh = try a.mat(d, hq * weights.d_rel, .bf16);
+        a.o = try a.mat(d, hq * D, .bf16);
+        a.ao = try a.mat(d, H, .bf16);
+        a.a = try a.mat(d, H, .bf16);
+        a.partial = try a.mat(d, H, .f32);
+        a.mx = try a.mat(d, H, .f32);
+        a.m = try a.mat(d, H, .bf16);
+        a.ids = try a.mat(d, topk, .i32);
+        a.wts = try a.mat(d, topk, .f32);
+        a.logits = try a.mat(d, experts, .f32);
+        a.y = try a.mat(d, H, .bf16);
+        a.cm = try a.mat(d, H, .bf16);
+        a.tokens = try a.mat(d, 1, .i32);
+        a.blocks = try a.raw(d, max_blocks * a.blockStride());
+        return a;
+    }
+
+    pub fn deinit(a: *Act) void {
+        for (a.own.items) |*b| b.free();
+        a.own.deinit(a.gpa);
+        a.* = undefined;
+    }
+
+    fn raw(a: *Act, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try a.own.append(a.gpa, b);
+        a.bytes += bytes;
+        return b.ptr;
+    }
+
+    fn mat(a: *Act, d: *const cuda.Driver, cols: usize, dt: ops.Dt) !Mat {
+        return Mat.of(try a.raw(d, a.cap * cols * dt.size()), a.cap, cols, dt);
+    }
+
+    pub fn blockStride(a: *const Act) usize {
+        return a.cap * H * 2;
+    }
+
+    /// The completed blocks for a forward of `rows` rows.
+    pub fn blockView(a: *const Act, rows: usize) ops.Blocks {
+        return .{ .ptr = a.blocks, .stride = a.blockStride(), .count = a.nblocks, .rows = rows, .hidden = H };
+    }
+
+    /// Block `i` (complete or not) for `rows` rows.
+    pub fn block(a: *const Act, i: usize, rows: usize) Mat {
+        return Mat.of(a.blocks + i * a.blockStride(), rows, H, .bf16);
+    }
+};
+
+/// Rows of a verify window at most: a forward this narrow on a slot with drafts keeps each convolution's inputs, so
+/// `keep` can take the state back to any of its rows (DSpark: the anchor and 7 drafts).
+pub const spec_rows = 8;
+
+/// One layer's state for one stream.
+pub const LayerState = struct {
+    kv: attn.Kv,
+    /// bf16 [3, C] each: K and V (C = hk*128), post-attention and post-MLP (C = 4608).
+    conv_k: u64,
+    conv_v: u64,
+    conv_attn: u64,
+    conv_mlp: u64,
+    /// With drafts: each convolution's [state before the forward; the forward's input rows], bf16 [3 + spec_rows, C]
+    /// (k, v, attn, mlp); 0 without.
+    hist: [4]u64 = @splat(0),
+};
+
+/// One stream's state over the loaded layers.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    first: u32,
+    layers: []LayerState,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: usize = 0,
+    /// Positions held (the next forward starts here).
+    pos: usize = 0,
+    context: usize,
+    /// The last forward's first position and rows, and whether it kept its convolution inputs (a verify window).
+    last_pos0: usize = 0,
+    last_rows: usize = 0,
+    kept_inputs: bool = false,
+    /// The last forward's row this stream's rows started at (a batched forward's segment; the drafter's taps).
+    last_row0: usize = 0,
+    /// The engine's forward count at this stream's last forward (cuda_engine.zig Engine.forwards): the drafter's
+    /// taps are this stream's while no other forward came after it.
+    last_fwd: u64 = 0,
+    /// With the convolutions' input history: `keepAll`'s table on the device, a `KeepEntry` for each convolution of
+    /// each layer (4 a layer), and its entries.
+    keep_table: u64 = 0,
+    keep_entries: u32 = 0,
+    /// Global layers on pages (cuda_pages.zig): where they live, the slot's page table (i32 ids on the device at a
+    /// fixed address, `entries` of them; unmapped entries name the scrub page), its host copy, and the entries that
+    /// name the slot's own pages (positions [0, mapped * page_rows) may run). Null place: a window a layer (v0.1).
+    place: ?pages.Place = null,
+    table: u64 = 0,
+    ids: []u32 = &.{},
+    mapped: usize = 0,
+    /// On pages: the first page when the slot's mapped pages are one run of consecutive ids (the allocator's normal
+    /// case), else null. Its one-row forwards then read and write that run through the v0.1 ring kernels (`kvFor`;
+    /// TF_INK2_RUN_RING=0: never), every other forward through the page table.
+    run: ?u32 = null,
+    ring_on_run: bool = true,
+    /// The mode of this stream's last one-row forward (`noteOneRow`: counted when it changes).
+    last_one: enum { none, ring, paged } = .none,
+    /// Tooling (own pages, TF_INK2_PAGE_ORDER=move): each new sequence's run (`restart`), and the one-row forwards
+    /// counted so far; while `flip` is set, every other `flip` one-row forwards take the page table (mode switches
+    /// mid-stream).
+    moves: u32 = 0,
+    ones: u64 = 0,
+    flip: u32 = 0,
+
+    /// Where a slot's global layers live: a window each (v0.1), the served streams' shared pool, or pages of its own
+    /// (tooling: the slot's whole context mapped at once, consecutive ids or, with `shuffle`, a permutation; with
+    /// `move`, an arena of two contexts in which each new sequence takes another run, see `restart`).
+    /// `drafter_hk` (own pages): the drafter's key heads when its global layer shares the slot's pages (stage 2c: two
+    /// more regions; 0: no drafter).
+    pub const Storage = union(enum) { window, pool: pages.Place, own: struct { shuffle: bool = false, move: bool = false, drafter_hk: usize = 0 } };
+
+    /// Room for `context` positions, forwards of at most `max_rows` rows; `spec`: the convolutions' input history.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, max_rows: usize, spec: bool) !State {
+        return initOn(gpa, d, w, context, max_rows, spec, .window);
+    }
+
+    /// `init` with the global layers on `storage`.
+    pub fn initOn(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, max_rows: usize, spec: bool, storage: Storage) !State {
+        var s: State = .{ .gpa = gpa, .first = w.first, .layers = try gpa.alloc(LayerState, w.layers.len), .context = context, .ring_on_run = pages.ringOnRun() };
+        errdefer s.deinit();
+        if (storage != .window) try s.pageTable(gpa, d, w, context, storage);
+        var g: usize = 0;
+        for (w.layers, s.layers) |l, *st| {
+            const cols = l.hk * D;
+            const slots = if (l.global) context else @min(context, attn.window - 1 + max_rows);
+            var kv: attn.Kv = undefined;
+            if (l.global and s.place != null) {
+                // global layer g: keys in region 2g, values in 2g + 1, position p at row p % page_rows of page ids[p / page_rows]
+                const pl = s.place.?;
+                kv = .{ .k = pl.region(2 * g), .v = pl.region(2 * g + 1), .slots = s.ids.len * pages.page_rows, .heads = l.hk, .window = 0, .pages = s.table, .page = pl.elems() };
+                g += 1;
+            } else kv = .{ .k = try s.zeroed(d, slots * cols * 2), .v = try s.zeroed(d, slots * cols * 2), .slots = slots, .heads = l.hk, .window = if (l.global) 0 else attn.window };
+            st.* = .{
+                .kv = kv,
+                .conv_k = try s.zeroed(d, conv.state_rows * cols * 2),
+                .conv_v = try s.zeroed(d, conv.state_rows * cols * 2),
+                .conv_attn = try s.zeroed(d, conv.state_rows * H * 2),
+                .conv_mlp = try s.zeroed(d, conv.state_rows * H * 2),
+            };
+            if (spec) for (&st.hist, [4]usize{ cols, cols, H, H }) |*h, c| {
+                h.* = try s.zeroed(d, (conv.state_rows + spec_rows) * c * 2);
+            };
+        }
+        if (spec) {
+            const table = try gpa.alloc(KeepEntry, 4 * w.layers.len);
+            defer gpa.free(table);
+            for (s.layers, w.layers, 0..) |st, l, i| {
+                const kvc: u32 = @intCast(@as(usize, l.hk) * D);
+                for (st.hist, [4]u64{ st.conv_k, st.conv_v, st.conv_attn, st.conv_mlp }, [4]u32{ kvc, kvc, H, H }, 0..) |h, x, c, j| table[4 * i + j] = .{ .state = x, .hist = h, .cols = c };
+            }
+            var b = try cuda.DeviceBuffer.alloc(d, table.len * @sizeOf(KeepEntry));
+            errdefer b.free();
+            try b.upload(0, std.mem.sliceAsBytes(table));
+            try s.own.append(gpa, b);
+            s.bytes += b.len;
+            s.keep_table = b.ptr;
+            s.keep_entries = @intCast(table.len);
+        }
+        return s;
+    }
+
+    pub fn deinit(s: *State) void {
+        for (s.own.items) |*b| b.free();
+        s.own.deinit(s.gpa);
+        s.gpa.free(s.layers);
+        if (s.ids.len > 0) s.gpa.free(s.ids);
+        s.* = undefined;
+    }
+
+    /// The page table (every entry on the scrub page), and with `own` the slot's own arena, every entry mapped.
+    fn pageTable(s: *State, gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, storage: Storage) !void {
+        const g = (try pagedShapeFor(w, if (storage == .own) storage.own.drafter_hk else 0)) orelse return error.NoGlobalLayers;
+        const entries = pages.pagesFor(context);
+        s.place = switch (storage) {
+            .pool => |pl| pl,
+            .own => |o| .{ .base = try s.raw(d, pages.arenaBytes(ownPages(entries, o.move), g.regions, g.run)), .pages = ownPages(entries, o.move), .run = g.run },
+            .window => unreachable,
+        };
+        s.ids = try gpa.alloc(u32, entries);
+        @memset(s.ids, s.place.?.scrub());
+        s.table = try s.raw(d, entries * 4);
+        if (storage == .own) {
+            for (s.ids, 0..) |*v, i| v.* = @intCast(i);
+            if (storage.own.shuffle) {
+                var prng = std.Random.DefaultPrng.init(0x1d2b_2024);
+                prng.random().shuffle(u32, s.ids);
+            }
+            s.mapped = entries;
+            s.run = runStart(s.ids);
+            if (storage.own.move) s.flip = move_flip;
+            // NaN under TF_KV_POISON, so a row read before its write shows (G4); the scrub page too
+            const pl = s.place.?;
+            const view: cuda.DeviceBuffer = .{ .d = d, .ptr = pl.base, .len = @intCast(pages.arenaBytes(pl.pages, g.regions, g.run)), .borrowed = true };
+            try view.fill8(if (pages.poisoned()) 0xff else 0, null);
+        }
+        try s.upload(d);
+    }
+
+    /// The host table to the device (blocking; start-up and tooling).
+    fn upload(s: *const State, d: *const cuda.Driver) !void {
+        const view: cuda.DeviceBuffer = .{ .d = d, .ptr = s.table, .len = s.ids.len * 4, .borrowed = true };
+        try view.upload(0, std.mem.sliceAsBytes(s.ids));
+    }
+
+    /// Whether the global layers are on pages.
+    pub fn paged(s: *const State) bool {
+        return s.place != null;
+    }
+
+    /// Positions the slot may run to: its table's mapped pages (on pages), else its context.
+    pub fn limit(s: *const State) usize {
+        return if (s.place != null) @min(s.mapped * pages.page_rows, s.context) else s.context;
+    }
+
+    /// Rank 0 and the followers alike: the slot's pages are `ids` (position order); the rest of its table the scrub
+    /// page. The host copy now; the device table by `enqueueTable` (on the stream, after every earlier forward).
+    pub fn mapIds(s: *State, ids: []const u32) !void {
+        if (s.place == null) return error.NotPaged;
+        if (ids.len > s.ids.len) return error.PastContext;
+        const scrub = s.place.?.scrub();
+        for (ids) |id| if (id >= scrub) return error.BadPage;
+        @memcpy(s.ids[0..ids.len], ids);
+        @memset(s.ids[ids.len..], scrub);
+        s.mapped = ids.len;
+        s.run = runStart(ids);
+    }
+
+    /// No pages mapped (the slot's stream ended): no forward of it until it opens again.
+    pub fn unmap(s: *State) void {
+        s.mapped = 0;
+        s.run = null;
+        s.last_one = .none;
+    }
+
+    /// Layer `l`'s keys and values for a forward of `rows` of this stream's rows: a one-row forward of a global layer
+    /// on pages that are one run (`run`) gets the ring view of the run (base its first page, a slot a position, no
+    /// table read: v0.1's kernels and window); every other forward the layer's own Kv (paged for a global layer on
+    /// pages). Both address the same bytes, and the ring and paged kernels give the same bits (G1).
+    pub fn kvFor(s: *const State, l: u32, rows: usize) attn.Kv {
+        const kv = s.layer(l).kv;
+        if (rows != 1 or !kv.paged()) return kv;
+        const start = s.ringRun() orelse return kv;
+        const off = @as(u64, start) * kv.page * 2;
+        return .{ .k = kv.k + off, .v = kv.v + off, .slots = s.context, .heads = kv.heads, .window = 0, .run = start };
+    }
+
+    /// The run a one-row forward reads through the ring kernels, or null (not on pages, not one run, or switched off;
+    /// tooling: a `flip` phase on the page table).
+    pub fn ringRun(s: *const State) ?u32 {
+        if (!s.ring_on_run or s.mapped == 0) return null;
+        if (s.flip > 0 and (s.ones / s.flip) % 2 == 1) return null;
+        return s.run;
+    }
+
+    /// Tooling (TF_INK2_PAGE_ORDER=move): the slot's own pages moved to the next run of its two-context arena (a new
+    /// sequence's: rows written before it are never read), the device table queued on `c`'s stream.
+    fn moveRun(s: *State, c: *const Ctx) !void {
+        const pl = s.place orelse return;
+        const entries = s.ids.len;
+        if (pl.pages != ownPages(entries, true)) return; // not a moving arena
+        s.moves += 1;
+        const start: u32 = @intCast((@as(usize, s.moves) * (entries / 2 + 1)) % (entries + 1));
+        for (s.ids, 0..) |*v, i| v.* = start + @as(u32, @intCast(i));
+        s.mapped = entries;
+        s.run = start;
+        s.ones = 0;
+        s.last_one = .none;
+        try s.enqueueTable(c.d, c.stream);
+    }
+
+    /// The host table queued to the device on `stream` (a pinned copy: it lands after the stream's earlier work).
+    pub fn enqueueTable(s: *const State, d: *const cuda.Driver, stream: cuda.Stream) !void {
+        try cuda.copy_source.enqueue(d, s.table, std.mem.sliceAsBytes(s.ids), stream);
+    }
+
+    fn raw(s: *State, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try s.own.append(s.gpa, b);
+        s.bytes += bytes;
+        return b.ptr;
+    }
+
+    fn zeroed(s: *State, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try b.fill8(0, null);
+        try s.own.append(s.gpa, b);
+        s.bytes += bytes;
+        return b.ptr;
+    }
+
+    pub fn layer(s: *const State, l: u32) *const LayerState {
+        return &s.layers[l - s.first];
+    }
+
+    /// A new sequence: every convolution's state back to zeros (the keys and values need no clearing: a forward
+    /// reads only positions it or an earlier forward of the same sequence wrote).
+    pub fn restart(s: *State, c: *const Ctx) !void {
+        if (s.flip > 0) try s.moveRun(c);
+        for (s.layers) |st| {
+            const kvc = st.kv.heads * D * 2;
+            try c.zero(st.conv_k, conv.state_rows * kvc);
+            try c.zero(st.conv_v, conv.state_rows * kvc);
+            try c.zero(st.conv_attn, conv.state_rows * H * 2);
+            try c.zero(st.conv_mlp, conv.state_rows * H * 2);
+        }
+        s.pos = 0;
+    }
+};
+
+/// Tooling, TF_INK2_PAGE_ORDER=move: one-row forwards a phase (ring on the run, then the page table, in turn).
+pub const move_flip: u32 = 5;
+
+/// The pages of a slot's own arena (the scrub page last): its context's, or two contexts' when it moves.
+fn ownPages(entries: usize, move: bool) usize {
+    return if (move) 2 * entries + 1 else entries + 1;
+}
+
+/// The first id when `ids` are one run of consecutive ids, else null.
+pub fn runStart(ids: []const u32) ?u32 {
+    if (ids.len == 0 or pages.Alloc.runsOf(ids) != 1) return null;
+    return ids[0];
+}
+
+/// The device bytes `State.init` takes for these weights, `context` positions and forwards of `max_rows` rows.
+pub fn stateBytes(w: *const weights.Weights, context: usize, max_rows: usize) usize {
+    var n: usize = 0;
+    for (w.layers) |l| {
+        const cols: usize = @as(usize, l.hk) * D;
+        const slots = if (l.global) context else @min(context, attn.window - 1 + max_rows);
+        n += 2 * slots * cols * 2 + 2 * conv.state_rows * cols * 2 + 2 * conv.state_rows * H * 2;
+    }
+    return n;
+}
+
+/// The pages' shape on these weights: regions (2 a global layer: keys, values) and a run's bytes (page_rows rows of
+/// a global layer); null without a global layer. Every global layer has the same key heads.
+/// `drafter`: the drafter's global layer has the last two regions (2g: keys, 2g + 1: values; stage 2c).
+pub const PagedShape = struct {
+    regions: usize,
+    run: u64,
+    globals: usize,
+    drafter: bool = false,
+
+    /// The drafter's keys' (0) and values' (1) regions.
+    pub fn drafterRegion(g: PagedShape, which: usize) usize {
+        std.debug.assert(g.drafter and which < 2);
+        return 2 * g.globals + which;
+    }
+};
+
+pub fn pagedShape(w: *const weights.Weights) ?PagedShape {
+    var n: usize = 0;
+    var hk: usize = 0;
+    for (w.layers) |l| if (l.global) {
+        n += 1;
+        hk = l.hk;
+    };
+    if (n == 0) return null;
+    return .{ .regions = 2 * n, .run = pages.page_rows * hk * D * 2, .globals = n };
+}
+
+/// `pagedShape` with the drafter's global layer in two more regions when `drafter_hk` > 0 (its key heads: a page's
+/// run of it must be a target global layer's, as it is at every W: 8 / W both).
+pub fn pagedShapeFor(w: *const weights.Weights, drafter_hk: usize) !?PagedShape {
+    var g = pagedShape(w) orelse return null;
+    if (drafter_hk == 0) return g;
+    if (pages.page_rows * drafter_hk * D * 2 != g.run) return error.DraftPageShape;
+    g.regions += 2;
+    g.drafter = true;
+    return g;
+}
+
+/// Bytes a page takes on this rank (every region's run of it).
+pub fn pageBytes(w: *const weights.Weights) u64 {
+    const g = pagedShape(w) orelse return 0;
+    return g.regions * g.run;
+}
+
+/// `pageBytes` with the drafter's two runs when `drafter_hk` > 0.
+pub fn pageBytesFor(w: *const weights.Weights, drafter_hk: usize) u64 {
+    const g = (pagedShapeFor(w, drafter_hk) catch return 0) orelse return 0;
+    return g.regions * g.run;
+}
+
+/// The device bytes a slot on pages takes beside its pages: every layer's but the global layers' keys and values,
+/// and its page table.
+pub fn fixedBytes(w: *const weights.Weights, context: usize, max_rows: usize) usize {
+    var n: usize = 0;
+    for (w.layers) |l| {
+        const cols: usize = @as(usize, l.hk) * D;
+        const slots = if (l.global) 0 else @min(context, attn.window - 1 + max_rows);
+        n += 2 * slots * cols * 2 + 2 * conv.state_rows * cols * 2 + 2 * conv.state_rows * H * 2;
+    }
+    return n + pages.pagesFor(context) * 4;
+}
+
+/// Positions [lo, hi) of a global layer's keys and values as runs of contiguous rows, in position order: one run a
+/// window, or a run a page (consecutive page ids merged) on pages.
+pub const RowRuns = struct {
+    kv: attn.Kv,
+    ids: []const u32,
+    p: usize,
+    hi: usize,
+    row: usize,
+
+    pub const Run = struct { pos: usize, n: usize, k: u64, v: u64 };
+
+    pub fn of(kv: attn.Kv, ids: []const u32, lo: usize, hi: usize) RowRuns {
+        return .{ .kv = kv, .ids = ids, .p = lo, .hi = hi, .row = kv.heads * D * 2 };
+    }
+
+    pub fn next(r: *RowRuns) !?Run {
+        if (r.p >= r.hi) return null;
+        const p = r.p;
+        if (!r.kv.paged()) {
+            if (r.kv.window != 0 or r.hi > r.kv.slots) return error.KvWindow; // a slot a position only
+            r.p = r.hi;
+            return .{ .pos = p, .n = r.hi - p, .k = r.kv.k + p * r.row, .v = r.kv.v + p * r.row };
+        }
+        const stride: u64 = @as(u64, r.kv.page) * 2;
+        var j = p / pages.page_rows;
+        if (j >= r.ids.len) return error.PastContext;
+        const off = p % pages.page_rows;
+        const id = r.ids[j];
+        var end = @min(r.hi, (j + 1) * pages.page_rows);
+        // consecutive ids are one run when a page's rows are a whole run of the region (the arena's layout)
+        if (stride == pages.page_rows * r.row) while (end < r.hi and j + 1 < r.ids.len and r.ids[j + 1] == r.ids[j] + 1) {
+            j += 1;
+            end = @min(r.hi, (j + 1) * pages.page_rows);
+        };
+        r.p = end;
+        const at = @as(u64, id) * stride + off * r.row;
+        return .{ .pos = p, .n = end - p, .k = r.kv.k + at, .v = r.kv.v + at };
+    }
+};
+
+/// The device bytes the convolutions' input history adds (State.init with `spec`).
+pub fn histBytes(w: *const weights.Weights) usize {
+    var n: usize = 0;
+    for (w.layers) |l| n += (conv.state_rows + spec_rows) * (2 * @as(usize, l.hk) * D + 2 * H) * 2;
+    return n;
+}
+
+/// A convolution's state after a verify window's input rows x [R, C] (R <= spec_rows), keeping its history:
+/// hist = [state; x], then state = hist[R .. R + 3), one launch (inkling2_conv.cu tf_ink2_conv_commit_spec: the same
+/// bytes as `convCommitSpecCopies`' three copies).
+pub fn convCommitSpec(c: *const Ctx, state: u64, hist: u64, x: Mat) !void {
+    const R = x.rows;
+    if (R > spec_rows or x.dt != .bf16) return error.BadSpecWindow;
+    if (R == 0) return;
+    const C = x.cols;
+    var a: cuda.Args = .{};
+    a.add(state);
+    a.add(hist);
+    a.add(x.ptr);
+    a.add(@as(i64, @intCast(x.ld)));
+    a.add(@as(i32, @intCast(R)));
+    a.add(@as(i32, @intCast(C)));
+    try cuda.launch.launch(c.k.conv.commit_spec_fn, .{ .grid = .{ .x = @intCast((C + 255) / 256), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// `convCommitSpec` as three device copies (the form it replaced; the op check compares the two).
+pub fn convCommitSpecCopies(c: *const Ctx, state: u64, hist: u64, x: Mat) !void {
+    const n = conv.state_rows;
+    const row = x.cols * x.dt.size();
+    const R = x.rows;
+    if (R > spec_rows or !x.dense()) return error.BadSpecWindow;
+    try c.copy(hist, state, n * row);
+    try c.copy(hist + n * row, x.ptr, R * row);
+    try c.copy(state, hist + R * row, n * row);
+}
+
+/// One convolution's place in `State.keep_table` (inkling2_conv.cu KeepEntry).
+pub const KeepEntry = extern struct {
+    state: u64,
+    hist: u64,
+    cols: u32,
+    pad: u32 = 0,
+};
+
+/// Every convolution of the slot as if only its last window's first `keep` rows had run: state = hist[keep ..
+/// keep + 3) for each, one launch over `keep_table` (inkling2_conv.cu tf_ink2_conv_keep: the same bytes as a
+/// `convKeep` copy a convolution).
+pub fn keepAll(c: *const Ctx, st: *const State, keep: usize) !void {
+    if (st.keep_table == 0) return error.RollbackNotKept;
+    if (keep == 0 or keep > spec_rows) return error.BadKeep;
+    var a: cuda.Args = .{};
+    a.add(st.keep_table);
+    a.add(@as(i32, @intCast(keep)));
+    try cuda.launch.launch(c.k.conv.keep_fn, .{ .grid = .{ .x = 8, .y = st.keep_entries, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// The state as if only the window's first `keep` rows had run: hist[keep .. keep + 3) (one convolution, one copy;
+/// `keepAll` does every convolution in one launch, and the op check compares the two).
+pub fn convKeep(c: *const Ctx, state: u64, hist: u64, cols: usize, keep: usize) !void {
+    const row = cols * 2;
+    try c.copy(state, hist + keep * row, conv.state_rows * row);
+}
+
+/// k', v' rows [R, hk*128] of positions pos0 .. pos0 + R - 1 into their slots, one launch
+/// (inkling2_attn.cu tf_ink2_attn_kv_write); `dev`: pos0 read on the device at run time (a captured decode step).
+/// A paged Kv (a global layer in the KV page pool) takes tf_ink2_attn_kv_write_pg: each row to its page's row.
+pub fn kvWrite(c: *const Ctx, kv: attn.Kv, pos0: usize, dev: ?attn.Dev, k: Mat, v: Mat) !void {
+    const R = k.rows;
+    if (R > kv.slots or !k.dense() or !v.dense()) return error.KvWindow;
+    if (R == 0) return;
+    const row = kv.heads * D * 2;
+    if (k.cols * 2 != row or v.cols * 2 != row or row % 16 != 0 or kv.slots > std.math.maxInt(i32) or pos0 + R > std.math.maxInt(i32)) return error.KvWindow;
+    // paged: every row inside the table, whole 16-byte words a page
+    if (kv.paged() and (kv.window != 0 or kv.page % 8 != 0 or pos0 + R > kv.slots)) return error.KvWindow;
+    var a: cuda.Args = .{};
+    for ([_]u64{ k.ptr, v.ptr, kv.k, kv.v }) |p| a.add(p);
+    a.add(@as(i32, @intCast(row / 16)));
+    a.add(@as(i32, @intCast(kv.slots)));
+    a.add(@as(i32, @intCast(pos0)));
+    a.add(if (dev) |x| x.posp else @as(u64, 0));
+    if (kv.paged()) kv.addPaged(&a);
+    const f = if (kv.paged()) c.k.attn.pg.kv_write else c.k.attn.kv_write;
+    try c.launchOn(kv.run, kv.k, kv.v, f, .{ .grid = .{ .x = @intCast(R), .y = 1, .z = 1 }, .block = .{ .x = 128, .y = 1, .z = 1 } }, &a);
+}
+
+/// The cached rows of positions lo .. hi - 1 gathered into k, v [hi - lo, hk*128] (for dumps); `ids` a paged
+/// layer's host table.
+pub fn kvGather(c: *const Ctx, kv: attn.Kv, ids: []const u32, lo: usize, hi: usize, k: Mat, v: Mat) !void {
+    if (kv.paged()) {
+        var runs = RowRuns.of(kv, ids, lo, hi);
+        while (try runs.next()) |r| {
+            try c.copy(k.row(r.pos - lo), r.k, r.n * runs.row);
+            try c.copy(v.row(r.pos - lo), r.v, r.n * runs.row);
+        }
+        return;
+    }
+    const row = kv.heads * D * 2;
+    var p = lo;
+    while (p < hi) {
+        const slot = p % kv.slots;
+        const n = @min(hi - p, kv.slots - slot);
+        try c.copy(k.row(p - lo), kv.k + slot * row, n * row);
+        try c.copy(v.row(p - lo), kv.v + slot * row, n * row);
+        p += n;
+    }
+}
+
+/// A convolution's state after a forward's input rows x [R, C] (bf16): the last 3 rows of [state; x], one launch
+/// (inkling2_conv.cu tf_ink2_conv_commit).
+pub fn convCommit(c: *const Ctx, state: u64, x: Mat) !void {
+    comptime std.debug.assert(conv.state_rows == 3);
+    if (x.rows == 0) return;
+    if (x.dt != .bf16) return error.BadConvShape;
+    // only the last three rows can stay
+    const xs = if (x.rows > conv.state_rows) x.slice(x.rows - conv.state_rows, conv.state_rows) else x;
+    const C = x.cols;
+    var a: cuda.Args = .{};
+    a.add(state);
+    a.add(xs.ptr);
+    a.add(@as(i64, @intCast(xs.ld)));
+    a.add(@as(i32, @intCast(xs.rows)));
+    a.add(@as(i32, @intCast(C)));
+    try cuda.launch.launch(c.k.conv.commit_fn, .{ .grid = .{ .x = @intCast((C + 255) / 256), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// h_in [R, H] bf16 as the next completed block.
+pub fn pushBlock(c: *const Ctx, a: *Act, h_in: Mat) !void {
+    if (a.nblocks >= max_blocks) return error.TooManyBlocks;
+    try c.copyRows(a.block(a.nblocks, h_in.rows), h_in);
+    a.nblocks += 1;
+}
+
+test "inkling2 cuda state: ring slots of a sliding layer cover every row's window" {
+    // a forward of R rows at pos0 writes slots of pos0 .. pos0+R-1; row pos0 still needs pos0 - 1023
+    const R = 300;
+    const slots = attn.window - 1 + R;
+    const pos0 = 5000;
+    // the oldest position still needed is pos0 - 1023; the newest written is pos0 + R - 1
+    try std.testing.expect((pos0 + R - 1) - (pos0 - (attn.window - 1)) < slots);
+}
+
+test "inkling2 cuda state: a slot's pages are one run only when every id follows the one before" {
+    try std.testing.expectEqual(@as(?u32, 7), runStart(&.{ 7, 8, 9 }));
+    try std.testing.expectEqual(@as(?u32, 0), runStart(&.{0}));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{ 7, 8, 10 }));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{ 8, 7 }));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{}));
+}
diff --git a/zig/src/families/inkling2/cuda_synth.zig b/zig/src/families/inkling2/cuda_synth.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6a5507e6c5a5242fd3398028444670b149cad414
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_synth.zig
@@ -0,0 +1,212 @@
+//! Tooling (tf-inkling2-decode --exp deep --fill synth): a slot's state for positions 0 .. D - 1 written directly
+//! with deterministic synthetic values, no forward: every layer's keys and values (a global layer's positions
+//! 0 .. D - 1, a sliding layer's whole ring), its four convolution states, and with the drafter the slot's draft
+//! caches (every layer's rows; a local layer's mirrored rows kept equal to the rows they mirror). A decode step at D
+//! then reads them as it reads a prefill's, so decode rows against one prompt forward over the same positions check
+//! the indexing, grids, op scratch and log scaling of a 1M-position slot exactly in minutes, where a real prefill to
+//! 1M takes hours.
+//!
+//! The values: one pattern of `elems` (a prime) bf16 values, about N(0, 1) (a sum of four uniforms), from a fixed
+//! seed, laid over each buffer from its own offset (rank, layer, buffer): byte b of a buffer is the pattern's byte
+//! (offset + b) mod `bytes`. A prime period keeps a row's bytes from repeating at any power-of-two distance, so a
+//! read or write off by a wrapped 32-bit offset lands on other values. `check` reads the global layers' positions
+//! 0 .. D - 1 back against the pattern after the experiment: no forward wrote below D.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const state = @import("cuda_state.zig");
+const conv = @import("cuda_conv.zig");
+const weights = @import("cuda_weights.zig");
+const dspark = @import("cuda_dspark.zig");
+
+/// bf16 values in the pattern (a prime), and its bytes.
+pub const elems: usize = 8_388_593;
+pub const bytes: usize = 2 * elems;
+const seed: u64 = 0x1f2e3d4c5b6a7988;
+
+/// The pattern on the host (`bytes` bytes; the caller frees it).
+pub fn pattern(gpa: std.mem.Allocator) ![]u8 {
+    const out = try gpa.alloc(u8, bytes);
+    errdefer gpa.free(out);
+    var rng = std.Random.DefaultPrng.init(seed);
+    const r = rng.random();
+    for (0..elems) |i| {
+        const u = r.int(u64);
+        var s: f32 = 0;
+        inline for (0..4) |j| s += @as(f32, @floatFromInt((u >> (16 * j)) & 0xffff)) / 65536.0 - 0.5;
+        // the sum of four uniforms has variance 1/3: scaled to about N(0, 1), within +-3.47
+        const x: f32 = s * 1.7320508;
+        const b: u32 = @bitCast(x);
+        const h: u16 = @intCast((b + 0x7fff + ((b >> 16) & 1)) >> 16); // round to nearest even
+        std.mem.writeInt(u16, out[2 * i ..][0..2], h, .little);
+    }
+    return out;
+}
+
+/// Buffer `which` of layer `layer` (or the drafter's) on rank `rank`: its byte offset into the pattern (even, so
+/// every bf16 stays whole).
+pub fn offset(rank: u32, layer: usize, which: usize) usize {
+    var h = std.hash.Wyhash.init(seed);
+    h.update(std.mem.asBytes(&rank));
+    h.update(std.mem.asBytes(&layer));
+    h.update(std.mem.asBytes(&which));
+    return 2 * @as(usize, @intCast(h.final() % elems));
+}
+
+/// `n` bytes at `dst` from the pattern on the device (`pat`) from byte `off`, wrapping.
+fn lay(c: *const ops.Ctx, pat: u64, dst: u64, n: usize, off: usize) !void {
+    var done: usize = 0;
+    var at = off;
+    while (done < n) {
+        const k = @min(n - done, bytes - at);
+        try c.copy(dst + done, pat + at, k);
+        done += k;
+        at = 0;
+    }
+}
+
+/// Buffers a layer's fill takes, in order: keys, values, then the four convolution states.
+const kv_k = 0;
+const kv_v = 1;
+const conv0 = 2;
+/// The drafter's layers (`which` = drafter_which + 2 l for keys, + 1 for values), after every target layer's.
+const drafter_which = 64;
+
+/// Rows of layer `l`'s keys (and values) the fill writes: a global layer's positions 0 .. positions - 1, a sliding
+/// layer's every ring slot.
+fn kvRows(st: *const state.State, l: usize, positions: usize) usize {
+    const kv = st.layers[l].kv;
+    return if (kv.window == 0) positions else kv.slots;
+}
+
+/// Slot `st` (on rank `rank`) as if positions 0 .. positions - 1 had run, with the pattern's values (see the top);
+/// `caches` the slot's draft caches when the drafter is loaded. Leaves the slot's position to the caller.
+pub fn fill(gpa: std.mem.Allocator, c: *const ops.Ctx, st: *const state.State, caches: ?*const dspark.Caches, rank: u32, positions: usize) !void {
+    const host = try pattern(gpa);
+    defer gpa.free(host);
+    var pat = try cuda.DeviceBuffer.fromHost(c.d, host);
+    defer pat.free();
+    for (st.layers, 0..) |l, i| {
+        const layer = @as(usize, st.first) + i;
+        const row = l.kv.heads * weights.head_dim * 2;
+        if (l.kv.paged()) {
+            // on pages: positions 0 .. positions - 1 a run of the slot's pages at a time, the pattern from where a
+            // window's row would take it
+            var runs = state.RowRuns.of(l.kv, st.ids, 0, positions);
+            while (try runs.next()) |r| {
+                try lay(c, pat.ptr, r.k, r.n * row, (offset(rank, layer, kv_k) + r.pos * row) % bytes);
+                try lay(c, pat.ptr, r.v, r.n * row, (offset(rank, layer, kv_v) + r.pos * row) % bytes);
+            }
+        } else {
+            const n = kvRows(st, i, positions) * row;
+            try lay(c, pat.ptr, l.kv.k, n, offset(rank, layer, kv_k));
+            try lay(c, pat.ptr, l.kv.v, n, offset(rank, layer, kv_v));
+        }
+        for ([4]u64{ l.conv_k, l.conv_v, l.conv_attn, l.conv_mlp }, [4]usize{ row, row, weights.hidden * 2, weights.hidden * 2 }, 0..) |p, w, j| {
+            try lay(c, pat.ptr, p, conv.state_rows * w, offset(rank, layer, conv0 + j));
+        }
+    }
+    if (caches) |dc| for (0..dspark.nlayers) |l| {
+        if (!dspark.local[l]) if (dc.pagedKv(st.ids.len)) |kv| {
+            // the global layer on pages (stage 2c): positions 0 .. positions - 1, the pattern from where its row in
+            // the slot's own table would take it
+            var runs = state.RowRuns.of(kv, st.ids, 0, @min(positions, st.limit()));
+            while (try runs.next()) |r| {
+                try lay(c, pat.ptr, r.k, r.n * dc.row, (offset(rank, 0, drafter_which + 2 * l) + r.pos * dc.row) % bytes);
+                try lay(c, pat.ptr, r.v, r.n * dc.row, (offset(rank, 0, drafter_which + 2 * l + 1) + r.pos * dc.row) % bytes);
+            }
+            continue;
+        };
+        for ([2]u64{ dc.keys(l), dc.values(l) }, 0..) |p, j| {
+            try lay(c, pat.ptr, p, dc.rows(l) * dc.row, offset(rank, 0, drafter_which + 2 * l + j));
+            // a ring's first `window` rows are mirrored after it (cuda_dspark.zig localRows): keep them equal
+            const ring = dc.wrap(l);
+            if (ring > 0) try c.copy(p + ring * dc.row, p, dspark.window * dc.row);
+        }
+    };
+    try c.stream.synchronize();
+}
+
+/// What `check` found: bytes compared and the first position whose row differs from the pattern (null: none).
+/// `ranks_bad`: the ranks whose own check found a row unequal (every rank's, gathered by Engine.synthCheck).
+pub const Checked = struct { bytes: u64 = 0, layers: u32 = 0, bad: ?usize = null, bad_layer: usize = 0, ranks_bad: u32 = 0 };
+
+/// The global layers' keys and values of positions 0 .. positions - 1 read back against the pattern.
+/// TF_INK2_SYNTH_FAULT=R (tests): rank R reads its first global layer's first key byte flipped, as a changed row.
+pub fn check(gpa: std.mem.Allocator, c: *const ops.Ctx, st: *const state.State, rank: u32, positions: usize) !Checked {
+    try c.stream.synchronize();
+    const fault = if (std.c.getenv("TF_INK2_SYNTH_FAULT")) |v| (std.fmt.parseInt(u32, std.mem.span(v), 10) catch std.math.maxInt(u32)) == rank else false;
+    const host = try pattern(gpa);
+    defer gpa.free(host);
+    const chunk: usize = 64 << 20;
+    const buf = try gpa.alloc(u8, chunk);
+    defer gpa.free(buf);
+    var out: Checked = .{};
+    for (st.layers, 0..) |l, i| {
+        if (l.kv.window != 0) continue;
+        const layer = @as(usize, st.first) + i;
+        const row = l.kv.heads * weights.head_dim * 2;
+        out.layers += 1;
+        for ([2]usize{ kv_k, kv_v }) |which| {
+            const n = positions * row;
+            const off = offset(rank, layer, which);
+            var at: usize = 0;
+            while (at < n) {
+                // the next run of contiguous rows from logical byte `at` (a window: all of it; pages: a run of them)
+                var runs = state.RowRuns.of(l.kv, st.ids, at / row, positions);
+                const r = (try runs.next()).?;
+                const p = if (which == kv_k) r.k else r.v;
+                const k = @min(r.n * row, chunk - chunk % row);
+                try cuda.memory.download(c.d, p, buf[0..k]);
+                if (fault and out.layers == 1 and which == kv_k and at == 0) buf[0] ^= 1;
+                // compare against the pattern from (off + at) mod bytes, a wrap at a time
+                var done: usize = 0;
+                while (done < k) {
+                    const from = (off + at + done) % bytes;
+                    const m = @min(k - done, bytes - from);
+                    if (!std.mem.eql(u8, buf[done..][0..m], host[from..][0..m])) {
+                        var j: usize = 0;
+                        while (buf[done + j] == host[from + j]) j += 1;
+                        const pos = (at + done + j) / row;
+                        if (out.bad == null or pos < out.bad.?) {
+                            out.bad = pos;
+                            out.bad_layer = layer;
+                        }
+                        break;
+                    }
+                    done += m;
+                }
+                out.bytes += k;
+                at += k;
+            }
+        }
+    }
+    return out;
+}
+
+test "inkling2 synth: the pattern is fixed, about N(0, 1), and offsets are even and inside it" {
+    const gpa = std.testing.allocator;
+    const p = try pattern(gpa);
+    defer gpa.free(p);
+    var sum: f64 = 0;
+    var sq: f64 = 0;
+    for (0..elems) |i| {
+        const h = std.mem.readInt(u16, p[2 * i ..][0..2], .little);
+        const x: f32 = @bitCast(@as(u32, h) << 16);
+        try std.testing.expect(std.math.isFinite(x) and @abs(x) < 3.5);
+        sum += x;
+        sq += x * x;
+    }
+    const n: f64 = @floatFromInt(elems);
+    try std.testing.expect(@abs(sum / n) < 0.01 and @abs(sq / n - 1) < 0.02);
+    const q = try pattern(gpa);
+    defer gpa.free(q);
+    try std.testing.expectEqualSlices(u8, p, q);
+    for (0..4) |r| for (0..48) |l| for (0..6) |w| {
+        const o = offset(@intCast(r), l, w);
+        try std.testing.expect(o % 2 == 0 and o < bytes);
+    };
+    try std.testing.expect(offset(0, 3, 0) != offset(1, 3, 0) and offset(0, 3, 0) != offset(0, 3, 1));
+    var d: usize = 2;
+    while (d * d <= elems) : (d += 1) try std.testing.expect(elems % d != 0);
+}
diff --git a/zig/src/families/inkling2/cuda_tp.zig b/zig/src/families/inkling2/cuda_tp.zig
new file mode 100644
index 0000000000000000000000000000000000000000..88d8b9a1c2c4bfca336be6b661614c6bea6f7811
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_tp.zig
@@ -0,0 +1,189 @@
+//! W > 1: a rank's two exchanges a layer. Rank r holds query heads [r*48/W, ...), key heads [r*8/W, ...) and experts
+//! [r*384/W, ...) (plan.zig); the rest of a layer is replicated. The output projection over the rank's heads and the
+//! combine over its experts each leave an fp32 partial [R, H]; every rank's partial is all-gathered in rank order
+//! and every rank adds them rank 0 first and rounds to bf16 once (res.rankSum), so every rank holds the same bits
+//! after each sum and the router picks the same experts on every rank.
+//!
+//! Split experts (plan.Layout.split, checkpoint mode): the MoE's rank-order sum gives way to two gathers a layer
+//! (cuda_moe.zig `splitUp` / `splitDown`): MoE-A, every rank's h columns [R * 8, I/W] bf16 into [W][R * 8][I/W], and
+//! MoE-B, every rank's output columns [R, H/W] bf16 into [W][R][H/W], laid out as rows by `columns`. No rank sums
+//! anything another rank computed, so every rank holds the same bits, equal to W = 1's. Each gather's size depends on R
+//! only, and nothing waits on the host inside a layer.
+//!
+//! Real ranks (one process a rank) gather over NCCL (cuda/tp_group.zig, a blocking communicator bootstrapped from
+//! NCCL_COMM_ID). Virtual ranks (all ranks in one process, one after another on one card) share the partial
+//! buffers, so nothing moves: each writes its own slot and the sum reads them all.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const res = @import("cuda_res.zig");
+const weights = @import("cuda_weights.zig");
+const moe = @import("cuda_moe.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+
+/// The layer's two sums: after the output projection and after the experts.
+pub const Sum = enum(u1) { attn, moe };
+
+/// The partials of both sums: fp32 [world][R][H] each, for forwards of at most `cap` rows. Two buffers, so a virtual
+/// rank's MoE partial never lands on an attention partial a later virtual rank has still to add.
+pub const Parts = struct {
+    ptr: [2]u64,
+    world: u32,
+    cap: usize,
+    own: ?[2]cuda.DeviceBuffer = null,
+    /// Split experts: the MoE-A and MoE-B gather buffers and the route plan in place of the MoE partials.
+    split: ?Split = null,
+
+    pub const Split = struct {
+        /// bf16 [world][cap * 8][I / world]
+        h: u64,
+        /// bf16 [world][cap][H / world]
+        y: u64,
+        /// cuda_moe.zig splitPlanBytes(cap)
+        plan: u64,
+        own: [3]cuda.DeviceBuffer,
+        bytes: usize,
+    };
+
+    /// `layout` whole: both sums' fp32 partials; split: the attention partials and the split experts' buffers.
+    pub fn init(d: *const cuda.Driver, world: u32, cap: usize) !Parts {
+        return initFor(d, world, cap, .whole);
+    }
+
+    pub fn initFor(d: *const cuda.Driver, world: u32, cap: usize, layout: @import("inkling2").plan.Layout) !Parts {
+        const n = @as(usize, world) * cap * H * 4;
+        var a = try cuda.DeviceBuffer.alloc(d, n);
+        errdefer a.free();
+        if (layout == .whole) {
+            const b = try cuda.DeviceBuffer.alloc(d, n);
+            return .{ .ptr = .{ a.ptr, b.ptr }, .world = world, .cap = cap, .own = .{ a, b } };
+        }
+        const sizes = [3]usize{ cap * moe.topk * moe.intermediate * 2, cap * H * 2, moe.splitPlanBytes(cap) };
+        var own: [3]cuda.DeviceBuffer = undefined;
+        var made: usize = 0;
+        errdefer for (own[0..made]) |*b| b.free();
+        for (&own, sizes) |*b, size| {
+            b.* = try cuda.DeviceBuffer.alloc(d, size);
+            made += 1;
+        }
+        const empty = try cuda.DeviceBuffer.alloc(d, 0); // no MoE partials: address 0, nothing held
+        return .{ .ptr = .{ a.ptr, 0 }, .world = world, .cap = cap, .own = .{ a, empty }, .split = .{ .h = own[0].ptr, .y = own[1].ptr, .plan = own[2].ptr, .own = own, .bytes = sizes[0] + sizes[1] + sizes[2] } };
+    }
+
+    pub fn deinit(p: *Parts) void {
+        if (p.own) |*o| for (o) |*b| b.free();
+        p.own = null;
+        if (p.split) |*x| for (&x.own) |*b| b.free();
+        p.split = null;
+    }
+
+    pub fn bytes(p: *const Parts) usize {
+        const whole = @as(usize, p.world) * p.cap * H * 4;
+        return if (p.split) |x| whole + x.bytes else 2 * whole;
+    }
+};
+
+/// TF_INK2_TIME_EXCHANGE=1: every real-rank gather waits for its stream before and after, and its wall time (the
+/// transfer plus the wait for the slowest rank) is counted here per sum; the runner prints the totals.
+pub const Timing = struct {
+    pub var on: ?bool = null;
+    pub var ns: [2]u64 = .{ 0, 0 };
+    pub var calls: [2]u64 = .{ 0, 0 };
+
+    pub fn enabled() bool {
+        if (on == null) on = if (std.c.getenv("TF_INK2_TIME_EXCHANGE")) |v| v[0] == '1' else false;
+        return on.?;
+    }
+
+    pub fn now() u64 {
+        var t: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(std.c.CLOCK.MONOTONIC, &t);
+        return @as(u64, @intCast(t.sec)) * std.time.ns_per_s + @as(u64, @intCast(t.nsec));
+    }
+};
+
+pub const Exchange = struct {
+    rank: u32,
+    world: u32,
+    parts: *const Parts,
+    /// Real ranks: the group the partials are gathered over; null: virtual ranks (shared buffers).
+    group: ?*const cuda.tp_group.Group = null,
+
+    fn base(x: *const Exchange, s: Sum) u64 {
+        return x.parts.ptr[@intFromEnum(s)];
+    }
+
+    /// This rank's partial of sum `s` for a forward of R rows (its slot of [world][R][H]).
+    pub fn mine(x: *const Exchange, s: Sum, R: usize) Mat {
+        return Mat.of(x.base(s) + @as(u64, x.rank) * R * H * 4, R, H, .f32);
+    }
+
+    /// Every rank's partial into every rank's buffer, rank order (real ranks; virtual ranks share the buffer).
+    pub fn gather(x: *const Exchange, c: *const Ctx, s: Sum, R: usize) !void {
+        if (R > x.parts.cap) return error.ExchangeTooSmall;
+        if (s == .moe and x.parts.split != null) return error.SplitExpertsGatherTwice;
+        const g = x.group orelse return;
+        if (!Timing.enabled()) return g.allGather(c.stream, x.mine(s, R).ptr, x.base(s), R * H * 4);
+        try c.stream.synchronize();
+        const t = Timing.now();
+        try g.allGather(c.stream, x.mine(s, R).ptr, x.base(s), R * H * 4);
+        try c.stream.synchronize();
+        Timing.ns[@intFromEnum(s)] += Timing.now() - t;
+        Timing.calls[@intFromEnum(s)] += 1;
+    }
+
+    /// out bf16 [R, H] = bf16(partial_0 + partial_1 + ...), rank order.
+    pub fn sum(x: *const Exchange, c: *const Ctx, s: Sum, out: Mat) !void {
+        try res.rankSum(c, x.base(s), x.world, out);
+    }
+
+    /// The split experts' buffers (null: whole experts).
+    pub fn split(x: *const Exchange) ?Parts.Split {
+        return x.parts.split;
+    }
+
+    /// Split experts: this rank's h [R * 8, I/W] (its slot of MoE-A's [W][R * 8][I/W]).
+    pub fn hMine(x: *const Exchange, R: usize) u64 {
+        return x.parts.split.?.h + @as(u64, x.rank) * R * moe.topk * (moe.intermediate / x.world) * 2;
+    }
+
+    /// Split experts: this rank's output columns [R, H/W] (its slot of MoE-B's [W][R][H/W]).
+    pub fn yMine(x: *const Exchange, R: usize) u64 {
+        return x.parts.split.?.y + @as(u64, x.rank) * R * (H / x.world) * 2;
+    }
+
+    /// Split experts: MoE-A (`.h`) or MoE-B (`.y`) for a forward of R rows, every rank's slot into every rank's buffer,
+    /// rank order (real ranks; virtual ranks share the buffers). Timed with the MoE sum (TF_INK2_TIME_EXCHANGE).
+    pub fn gatherSplit(x: *const Exchange, c: *const Ctx, which: enum { h, y }, R: usize) !void {
+        if (R > x.parts.cap) return error.ExchangeTooSmall;
+        const sp = x.parts.split orelse return error.NotSplitExperts;
+        const g = x.group orelse return;
+        const own, const all, const n = switch (which) {
+            .h => .{ x.hMine(R), sp.h, R * moe.topk * (moe.intermediate / x.world) * 2 },
+            .y => .{ x.yMine(R), sp.y, R * (H / x.world) * 2 },
+        };
+        if (!Timing.enabled()) return g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        const t = Timing.now();
+        try g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        Timing.ns[1] += Timing.now() - t;
+        Timing.calls[1] += 1;
+    }
+
+    /// Split experts, after MoE-B: out bf16 [R, H], every rank's columns in place.
+    pub fn columns(x: *const Exchange, c: *const Ctx, out: Mat) !void {
+        try moe.splitColumns(c, x.parts.split.?.y, x.world, out);
+    }
+};
+
+test "inkling2 cuda tp: a rank's slot of the partials" {
+    const parts: Parts = .{ .ptr = .{ 1 << 30, 2 << 30 }, .world = 4, .cap = 32 };
+    const x: Exchange = .{ .rank = 2, .world = 4, .parts = &parts };
+    try std.testing.expectEqual(@as(u64, (2 << 30) + 2 * 25 * H * 4), x.mine(.moe, 25).ptr);
+    try std.testing.expect(x.mine(.attn, 25).is(25, H, .f32));
+    try std.testing.expectEqual(@as(usize, 2 * 4 * 32 * H * 4), parts.bytes());
+}
diff --git a/zig/src/families/inkling2/cuda_weights.zig b/zig/src/families/inkling2/cuda_weights.zig
new file mode 100644
index 0000000000000000000000000000000000000000..56672ad3d66154100d3f1fdd2bdf0ec15f328628
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_weights.zig
@@ -0,0 +1,854 @@
+//! One rank's Inkling-2 weights on the device for a layer range [a, b), from the rank plan's byte ranges (plan.zig):
+//! each tensor the rank holds is read from its safetensors run(s) and uploaded as one dense array. Reader threads
+//! (ReadOpts: 8 by default, direct reads into pinned buffers, no page cache and no second host copy) each take whole
+//! pieces, hash every byte as read (the content digests, digests.zig) and copy each chunk to the device while reading
+//! the next. Quantized expert
+//! bytes stay packed as stored (NVFP4 / MXFP8, with their scales, amax and denominator); BF16 and F32 tensors keep
+//! their dtype, except the RMS norm gains and the router weight, converted exactly to fp32 (Transformers keeps the
+//! router in fp32 and multiplies gains in fp32). Group kernels that want another layout repack in their
+//! `prepare(layer)` hook (cuda_<group>.zig), which runs once per layer after the upload; what they allocate there
+//! goes in `Weights.own` so it is freed with the weights.
+//!
+//! Device layouts (rank r of W; hq = its query heads, hk = its key heads, E = its experts, H = 4608, D = 128):
+//!   wq, wg      bf16 [hq*D, H]   rows by query head (Transformers q_proj, gate_proj)
+//!   wr          bf16 [hq*16, H]  relative-state rows (r_proj), 16 a head
+//!   wsink       bf16 [hq, H]
+//!   wk, wv      bf16 [hk*D, H]
+//!   wo          bf16 [H, hq*D]   the rank's column cut of o_proj, gathered dense
+//!   q_scale     bf16 [hq, D], rel_scale bf16 [hq, 16]   (Inkling2ScaledL2Clip.scale)
+//!   rel_proj    bf16 [16, 1024]  (Inkling2RelativeLogits.proj; extent 1024 in both layer kinds)
+//!   local:  k_conv, v_conv bf16 [hk*D, 4] (conv1d weight [C, 1, 4]; tap 3 multiplies the current row)
+//!   global: k_conv, v_conv bf16 [4, hk*D] (static_weight [lag, C]; lag 0 = current row)
+//!           k_wproj, v_wproj bf16 [hk*4, H] (weight_proj; row = head*4 + lag)
+//!   attn_conv, mlp_conv bf16 [H, 4] (post-attention / post-MLP conv1d weight, tap 3 = current row)
+//!   in_norm[0..3] fp32 [H]: local attn_norm in [0]; global q, k, v input norms
+//!   mlp_norm fp32 [H]; attn_query fp32 [nq, H] (0 at layer 0); mlp_query fp32 [H]
+//!   router fp32 [384, H]; router_bias fp32 [384]
+//!   experts: see `Experts`.
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+pub const hidden = 4608;
+pub const head_dim = 128;
+pub const d_rel = 16;
+pub const taps = 4;
+
+pub const Format = enum { nvfp4, mxfp8 };
+
+/// A layer's experts as stored, the rank's span [lo, hi) of the 384 (row `e - lo` holds expert e).
+///   NVFP4 (layers 0-39): w13 u8 [E, 2I, H/2] (e2m1 pairs, low nibble = even column), w13_scale e4m3 [E, 2I, H/16],
+///     w13_amax f32 [E]; w2 u8 [E, H, I/2], w2_scale e4m3 [E, H, I/16], w2_amax f32 [E]; den13 / den2 the
+///     outer_scale_denominator scalars (read from the file: 2688 in the release). Weight value =
+///     e2m1 * e4m3 * (amax[e] / den), as the oracle decodes it.
+///   MXFP8 (layers 40-47): w13 e4m3 [E, 2I, H], w13_scale u8 [E, 2I, H/32] (ue8m0, one a row a 32 columns);
+///     w2 e4m3 [E, H, I], w2_scale u8 [E, H, I/32]. Weight value = e4m3 * 2^(scale - 127).
+///   w13 rows are interleaved: row 2i = gate_i, row 2i + 1 = up_i (I = 2304).
+/// Split experts (plan.Layout.split, W ranks): every expert (lo = 0, hi = 384), and of each only its rows
+/// [n13 * part, + n13) of w13 (gate/up pairs n13 / 2 * part ..) and [n2 * part, + n2) of w2 (all of K), with their
+/// scales' rows, dense: w13 [E, n13, ...], w2 [E, n2, ...]; amax whole [384]. Whole experts: n13 = 2I, n2 = H.
+pub const Experts = struct {
+    format: Format,
+    lo: u32,
+    hi: u32,
+    /// The split layout's world size (1: whole experts) and this rank's place in it.
+    split: u32 = 1,
+    part: u32 = 0,
+    /// Rows of each expert held: w13 (gate/up interleaved) and w2 (output rows).
+    n13: u32 = 2 * 2304,
+    n2: u32 = hidden,
+    w13: u64 = 0,
+    w13_scale: u64 = 0,
+    w2: u64 = 0,
+    w2_scale: u64 = 0,
+    w13_amax: u64 = 0,
+    w2_amax: u64 = 0,
+    den13: f32 = 0,
+    den2: f32 = 0,
+    /// Free for the MoE group's repacked forms (moe.prepare).
+    extra: [4]u64 = @splat(0),
+
+    pub fn count(e: Experts) u32 {
+        return e.hi - e.lo;
+    }
+};
+
+pub const Layer = struct {
+    index: u32,
+    global: bool,
+    boundary: bool,
+    /// The rank's query and key heads.
+    hq: u32,
+    hk: u32,
+    /// Attention-input queries: 0 (layer 0), 1 (sliding) or 3 (global).
+    nq: u32,
+    in_norm: [3]u64 = @splat(0),
+    mlp_norm: u64 = 0,
+    attn_query: u64 = 0,
+    mlp_query: u64 = 0,
+    wq: u64 = 0,
+    wk: u64 = 0,
+    wv: u64 = 0,
+    wr: u64 = 0,
+    wg: u64 = 0,
+    wsink: u64 = 0,
+    wo: u64 = 0,
+    q_scale: u64 = 0,
+    rel_scale: u64 = 0,
+    rel_proj: u64 = 0,
+    k_conv: u64 = 0,
+    v_conv: u64 = 0,
+    k_wproj: u64 = 0,
+    v_wproj: u64 = 0,
+    attn_conv: u64 = 0,
+    mlp_conv: u64 = 0,
+    router: u64 = 0,
+    router_bias: u64 = 0,
+    experts: Experts,
+    /// Free for the attention and convolution groups' repacked forms (their prepare hooks).
+    extra: [4]u64 = @splat(0),
+};
+
+pub const Weights = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    /// Layers a .. b, `layers[i]` is layer a + i.
+    first: u32,
+    layers: []Layer,
+    embed: u64 = 0, // bf16 [embed_rows.len(), H]: the table rows this rank holds (cuda_embed.zig)
+    embed_norm: u64 = 0, // fp32 [H]
+    /// The embedding rows `embed` holds: vocabulary entries embed_rows.lo .. embed_rows.hi (the whole table on rank 0
+    /// as loaded; cuda_embed.zig `spread` leaves each rank its share).
+    embed_rows: ink.plan.Span = .{ .lo = 0, .hi = 0 },
+    unembed: u64 = 0, // bf16 [vocab_rows.len(), H]: the rank's share of the vocabulary (plan.zig)
+    norm: u64 = 0, // fp32 [H]
+    output_query: u64 = 0, // fp32 [H]
+    /// The unembed rows this rank holds: vocabulary entries vocab_rows.lo .. vocab_rows.hi (all of them at W = 1).
+    vocab_rows: ink.plan.Span = .{ .lo = 0, .hi = 0 },
+    vocab: u32 = 0,
+    unpadded_vocab: u32 = 0,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: u64 = 0,
+    /// Bytes freed after upload (repacked sources: the bf16 attention copies).
+    released: u64 = 0,
+
+    pub fn deinit(w: *Weights) void {
+        for (w.own.items) |*b| b.free();
+        w.own.deinit(w.gpa);
+        w.gpa.free(w.layers);
+        w.* = undefined;
+    }
+
+    /// Frees the owned buffer at `ptr` (a prepare hook dropping a source it has repacked); false if none is owned there.
+    pub fn release(w: *Weights, ptr: u64) bool {
+        for (w.own.items, 0..) |*b, i| if (b.ptr == ptr) {
+            w.bytes -= b.len;
+            w.released += b.len;
+            b.free();
+            _ = w.own.swapRemove(i);
+            return true;
+        };
+        return false;
+    }
+
+    /// Device memory owned by the weights (for a prepare hook's repacked forms).
+    pub fn alloc(w: *Weights, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(w.d, bytes);
+        errdefer b.free();
+        try w.own.append(w.gpa, b);
+        w.bytes += bytes;
+        return b.ptr;
+    }
+
+    /// Frees the buffer at `ptr` (one the loader uploaded), if the weights own one there.
+    pub fn drop(w: *Weights, ptr: u64) void {
+        if (ptr != 0) _ = w.release(ptr);
+    }
+
+    pub fn layer(w: *const Weights, l: u32) *const Layer {
+        return &w.layers[l - w.first];
+    }
+
+    pub fn holds(w: *const Weights, l: u32) bool {
+        return l >= w.first and l < w.first + w.layers.len;
+    }
+};
+
+pub const Want = struct {
+    rank: u32 = 0,
+    lo: u32,
+    hi: u32,
+    /// The embedding and its norm (rank 0 loads them at any W; at W > 1 cuda_embed.zig `spread` moves them off rank 0).
+    embed: bool = false,
+    /// The final mix's query, the final norm and the rank's share of the unembed (vocab_rows).
+    head: bool = false,
+    /// The final mix's query and the final norm alone (the drafter's last tap on every rank).
+    final: bool = false,
+    /// Each loaded piece's content digest (xxh64 of its bytes as read, plan order): digests.zig checks them.
+    digests: ?*std.ArrayList(ink.digests.Digest) = null,
+};
+
+/// Called once per loaded layer, after its tensors are on the device (each group's `prepare`).
+pub const Prepare = *const fn (w: *Weights, l: *Layer) anyerror!void;
+
+/// How the loader reads (environment, read once per load):
+///   TF_INK2_LOAD_THREADS=N   reader threads (default 8); each reads whole pieces, hashes them and uploads them
+///   TF_INK2_LOAD_DIRECT=0    page-cache reads instead of direct (O_DIRECT) ones; a file direct reads refuse falls
+///                            back on its own
+///   TF_INK2_LOAD_CHUNK_MIB=M a thread's two pinned read buffers, M MiB each (default 32)
+///   TF_INK2_LOAD_RECHECK=1   after the load, every uploaded piece is read back from the device and hashed again
+///                            (must equal the hash of the bytes read: proves the upload)
+pub const ReadOpts = struct {
+    threads: u32 = 8,
+    direct: bool = true,
+    chunk: usize = 32 << 20,
+    recheck: bool = false,
+
+    pub fn env() ReadOpts {
+        var o: ReadOpts = .{};
+        if (std.c.getenv("TF_INK2_LOAD_THREADS")) |v| o.threads = std.math.clamp(std.fmt.parseInt(u32, std.mem.span(v), 10) catch o.threads, 1, 64);
+        if (std.c.getenv("TF_INK2_LOAD_DIRECT")) |v| o.direct = v[0] != '0';
+        if (std.c.getenv("TF_INK2_LOAD_CHUNK_MIB")) |v| o.chunk = @as(usize, std.math.clamp(std.fmt.parseInt(u32, std.mem.span(v), 10) catch 32, 1, 1024)) << 20;
+        if (std.c.getenv("TF_INK2_LOAD_RECHECK")) |v| o.recheck = v[0] == '1';
+        return o;
+    }
+};
+
+/// Direct reads' alignment of file offsets, lengths and buffer addresses (a multiple of any logical block size).
+const direct_align: u64 = 4096;
+/// Rows of a strided run at most this far apart are read in one read (the gap's bytes read and skipped).
+const merge_gap: u64 = 128 << 10;
+
+/// One step of a run's load: `reads` reads of `read_len` bytes, read i from file offset file_at + i * read_step into
+/// the buffer at i * read_len (all aligned to the reader's alignment), then `rows` rows of `width` bytes, the first at
+/// buffer offset data_at and each `pitch` bytes after the one before, hashed in order and copied to the run's dense
+/// device array at byte `dst` (rows back to back).
+pub const Chunk = struct {
+    file_at: u64,
+    read_len: usize,
+    reads: usize,
+    read_step: u64,
+    data_at: usize,
+    pitch: usize,
+    width: usize,
+    rows: usize,
+    dst: u64,
+
+    /// Bytes of the buffer the reads fill.
+    pub fn span(c: Chunk) usize {
+        return c.reads * c.read_len;
+    }
+
+    /// Bytes read i must return (less at the end of the file is a short read).
+    pub fn need(c: Chunk) usize {
+        return if (c.reads == 1) c.data_at + (c.rows - 1) * c.pitch + c.width else c.data_at + c.width;
+    }
+};
+
+/// A run's chunks for buffers of `cap` bytes and reads aligned to `a` (1: any): rows close together share a read;
+/// rows far apart are read one by one, several a chunk; a row longer than a chunk is read in parts.
+pub const Chunks = struct {
+    r: ink.plan.Run,
+    a: u64,
+    cap: usize,
+    row: u64 = 0,
+    part: u64 = 0,
+
+    fn up(x: u64, a: u64) u64 {
+        return (x + a - 1) / a * a;
+    }
+
+    pub fn next(it: *Chunks) ?Chunk {
+        const r = it.r;
+        if (it.row >= r.count or r.len == 0) return null;
+        const a = it.a;
+        const cap: u64 = it.cap;
+        const len = r.len;
+        const off0 = r.offset + it.row * r.stride;
+        if (len + 3 * a > cap or it.part > 0) {
+            // a part of a long row: at most cap - 2a bytes, so its aligned read fits the buffer
+            const off = off0 + it.part;
+            const n = @min(len - it.part, cap - 2 * a);
+            const at = off / a * a;
+            const c: Chunk = .{ .file_at = at, .read_len = @intCast(up(off + n, a) - at), .reads = 1, .read_step = 0, .data_at = @intCast(off - at), .pitch = @intCast(n), .width = @intCast(n), .rows = 1, .dst = it.row * len + it.part };
+            it.part += n;
+            if (it.part == len) {
+                it.part = 0;
+                it.row += 1;
+            }
+            return c;
+        }
+        const left = r.count - it.row;
+        if (left > 1 and r.stride >= len and r.stride - len <= merge_gap) {
+            // rows close together: one read over as many as fit
+            const at = off0 / a * a;
+            const first = off0 - at + len;
+            const n = @min(left, 1 + (cap - up(first, a) - a) / r.stride);
+            const c: Chunk = .{ .file_at = at, .read_len = @intCast(up(off0 + (n - 1) * r.stride + len, a) - at), .reads = 1, .read_step = 0, .data_at = @intCast(off0 - at), .pitch = @intCast(r.stride), .width = @intCast(len), .rows = @intCast(n), .dst = it.row * len };
+            it.row += n;
+            return c;
+        }
+        // rows read one by one: several a chunk when every row sits at the same offset from the alignment
+        const mis = off0 % a;
+        const read_len = up(mis + len, a);
+        const n = if (r.stride % a == 0) @min(left, cap / read_len) else 1;
+        const c: Chunk = .{ .file_at = off0 - mis, .read_len = @intCast(read_len), .reads = @intCast(n), .read_step = r.stride, .data_at = @intCast(mis), .pitch = @intCast(read_len), .width = @intCast(len), .rows = @intCast(n), .dst = it.row * len };
+        it.row += n;
+        return c;
+    }
+};
+
+/// What the loader does with a piece: upload its bytes as they are, or convert them first (bf16 gains to fp32, the
+/// bf16 router to fp32, a scalar into the experts' facts). Every job hashes the bytes it reads (xxh64, rows in order).
+const Job = struct {
+    piece: u32,
+    run: ink.plan.Run,
+    kind: enum { raw, gain, router, scalar },
+    dtype: ink.inventory.DType = .bf16,
+    /// The device array (raw, gain, router), allocated before any read.
+    dst: u64 = 0,
+    /// A scalar's place.
+    out: ?*f32 = null,
+    xxh64: u64 = 0,
+};
+
+/// The reader threads: each takes the next job (largest first), reads it into its two pinned buffers in turn, hashes
+/// each chunk and copies it to the device on its own stream while it reads the next one.
+const Pool = struct {
+    d: *const cuda.Driver,
+    ctx: cuda.abi.Context,
+    dir: []const u8,
+    m: *const ink.describe.Model,
+    jobs: []Job,
+    order: []const u32,
+    opts: ReadOpts,
+    rank: u32,
+    recheck: bool = false,
+    next: std.atomic.Value(usize) = .init(0),
+    err: std.atomic.Value(u16) = .init(0),
+    /// Files that refused direct reads (read through the page cache instead).
+    buffered: std.atomic.Value(u32) = .init(0),
+
+    fn fail(p: *Pool, e: anyerror) void {
+        _ = p.err.cmpxchgStrong(0, @intFromError(e), .acq_rel, .acquire);
+        p.next.store(p.order.len, .release);
+    }
+
+    fn failed(p: *const Pool) ?anyerror {
+        const e = p.err.load(.acquire);
+        return if (e == 0) null else @errorFromInt(e);
+    }
+
+    fn work(p: *Pool) void {
+        const run = if (p.recheck) p.recheckLoop() else p.loop();
+        run catch |e| p.fail(e);
+    }
+
+    fn current(p: *Pool) !void {
+        try p.d.check(p.d.api.cuCtxSetCurrent(p.ctx), "cuCtxSetCurrent");
+        cuda.copy_source.setCurrent(p.ctx);
+    }
+
+    fn loop(p: *Pool) !void {
+        try p.current();
+        var t: Thread = .{ .p = p };
+        defer t.deinit();
+        try t.init();
+        while (true) {
+            const k = p.next.fetchAdd(1, .acq_rel);
+            if (k >= p.order.len) break;
+            try t.job(&p.jobs[p.order[k]]);
+        }
+        try t.s.?.synchronize();
+    }
+
+    /// Every raw piece read back from the device and hashed again.
+    fn recheckLoop(p: *Pool) !void {
+        try p.current();
+        var hb = try cuda.HostBuffer.alloc(p.d, p.opts.chunk);
+        defer hb.free();
+        const buf = hb.bytes;
+        while (true) {
+            const k = p.next.fetchAdd(1, .acq_rel);
+            if (k >= p.order.len) return;
+            const j = &p.jobs[p.order[k]];
+            if (j.kind != .raw) continue;
+            const total: usize = @intCast(j.run.bytes());
+            var h = std.hash.XxHash64.init(0);
+            var done: usize = 0;
+            while (done < total) {
+                const n = @min(total - done, buf.len);
+                try p.d.check(p.d.api.cuMemcpyDtoH_v2(buf.ptr, j.dst + done, n), "cuMemcpyDtoH");
+                h.update(buf[0..n]);
+                done += n;
+            }
+            if (h.final() != j.xxh64) {
+                std.log.err("inkling2 rank {d}: {s}: the device's bytes hash {x:0>16}, the bytes read {x:0>16}", .{ p.rank, p.m.inv.tensors[p.m.p.ranks[p.rank].pieces[j.piece].tensor].name, h.final(), j.xxh64 });
+                return error.UploadDiffers;
+            }
+        }
+    }
+};
+
+/// A file as one reader thread holds it.
+const Src = struct {
+    fd: i32,
+    /// The alignment its reads need (1: page-cache reads).
+    a: u64,
+};
+
+const is_linux = @import("builtin").os.tag == .linux;
+
+const Thread = struct {
+    p: *Pool,
+    s: ?cuda.Stream = null,
+    bufs: [2]?cuda.HostBuffer = .{ null, null },
+    evs: [2]?cuda.Event = .{ null, null },
+    busy: [2]bool = .{ false, false },
+    which: u1 = 0,
+    files: []?Src = &.{},
+
+    fn init(t: *Thread) !void {
+        const p = t.p;
+        t.files = try std.heap.page_allocator.alloc(?Src, p.m.inv.files.len);
+        @memset(t.files, null);
+        for (&t.bufs) |*b| b.* = try cuda.HostBuffer.alloc(p.d, p.opts.chunk);
+        for (&t.evs) |*e| e.* = try cuda.Event.init(p.d, false);
+        t.s = try cuda.Stream.init(p.d, true);
+    }
+
+    /// The stream first (it waits for the copies), then the buffers the copies read.
+    fn deinit(t: *Thread) void {
+        if (t.s) |*s| s.deinit();
+        for (&t.evs) |*e| if (e.*) |*x| x.deinit();
+        for (&t.bufs) |*b| if (b.*) |*x| x.free();
+        for (t.files) |f| if (f) |x| close(x);
+        if (t.files.len > 0) std.heap.page_allocator.free(t.files);
+    }
+
+    fn close(f: Src) void {
+        if (comptime is_linux) _ = std.os.linux.close(f.fd);
+    }
+
+    fn file(t: *Thread, i: u16) !Src {
+        if (t.files[i]) |f| return f;
+        const p = t.p;
+        const gpa = std.heap.page_allocator;
+        const path = try std.fs.path.joinZ(gpa, &.{ p.dir, p.m.inv.files[i].name });
+        defer gpa.free(path);
+        if (comptime !is_linux) return error.Unsupported;
+        const linux = std.os.linux;
+        var direct = p.opts.direct;
+        while (true) {
+            const rc = linux.open(path.ptr, .{ .ACCMODE = .RDONLY, .CLOEXEC = true, .DIRECT = direct }, 0);
+            switch (linux.errno(rc)) {
+                .SUCCESS => {
+                    t.files[i] = .{ .fd = @intCast(rc), .a = if (direct) direct_align else 1 };
+                    return t.files[i].?;
+                },
+                .INTR => continue,
+                .INVAL => if (direct) {
+                    direct = false;
+                    _ = p.buffered.fetchAdd(1, .acq_rel);
+                    continue;
+                } else return error.OpenFailed,
+                .NOENT => return error.FileNotFound,
+                .ACCES, .PERM => return error.AccessDenied,
+                else => return error.OpenFailed,
+            }
+        }
+    }
+
+    /// `buf.len` bytes at `off`; at least `need` of them must be there.
+    fn read(f: Src, buf: []u8, off: u64, need: usize) !void {
+        if (comptime !is_linux) return error.Unsupported;
+        const linux = std.os.linux;
+        var got: usize = 0;
+        while (got < buf.len) {
+            const rc = linux.pread(f.fd, buf[got..].ptr, buf.len - got, @intCast(off + got));
+            switch (linux.errno(rc)) {
+                .SUCCESS => {},
+                .INTR => continue,
+                else => return error.ReadFailed,
+            }
+            if (rc == 0) break;
+            got += rc;
+            if (got % f.a != 0) break; // a direct read's short tail: the end of the file
+        }
+        if (got < need) return error.ShortRead;
+    }
+
+    /// The other buffer, once the copy that last read it is done.
+    fn buffer(t: *Thread) !struct { []u8, u1 } {
+        const i = t.which;
+        t.which ^= 1;
+        if (t.busy[i]) try t.evs[i].?.synchronize();
+        t.busy[i] = false;
+        return .{ t.bufs[i].?.bytes, i };
+    }
+
+    fn job(t: *Thread, j: *Job) !void {
+        const p = t.p;
+        const f = try t.file(j.run.file);
+        var h = std.hash.XxHash64.init(0);
+        var it: Chunks = .{ .r = j.run, .a = f.a, .cap = p.opts.chunk };
+        if (j.kind != .raw) {
+            // a small piece: one chunk, converted on the host
+            const c = it.next() orelse return error.UnexpectedInkling2Layout;
+            if (c.rows != 1 or it.next() != null) return error.UnexpectedInkling2Layout;
+            const buf = (try t.buffer())[0];
+            try read(f, buf[0..c.span()], c.file_at, c.need());
+            const raw = buf[c.data_at..][0..c.width];
+            h.update(raw);
+            j.xxh64 = h.final();
+            try convert(p.d, j, raw);
+            return;
+        }
+        const s = t.s.?;
+        while (it.next()) |c| {
+            const buf, const i = try t.buffer();
+            for (0..c.reads) |k| try read(f, buf[k * c.read_len ..][0..c.read_len], c.file_at + k * c.read_step, c.need());
+            for (0..c.rows) |k| h.update(buf[c.data_at + k * c.pitch ..][0..c.width]);
+            const src = buf[c.data_at..].ptr;
+            const dst = j.dst + c.dst;
+            if (c.rows == 1 or c.pitch == c.width) {
+                try p.d.check(p.d.api.cuMemcpyHtoDAsync_v2(dst, src, c.rows * c.width, s.handle), "cuMemcpyHtoDAsync");
+            } else {
+                const cp: cuda.abi.Memcpy2D = .{ .src_type = @intCast(cuda.abi.memory_type_host), .src_host = src, .src = 0, .src_pitch = c.pitch, .dst = dst, .dst_pitch = c.width, .width = c.width, .height = c.rows };
+                try p.d.check(p.d.api.cuMemcpy2DAsync_v2(&cp, s.handle), "cuMemcpy2DAsync");
+            }
+            try t.evs[i].?.record(s);
+            t.busy[i] = true;
+        }
+        j.xxh64 = h.final();
+        if (f.a == 1) forget(f, j.run);
+    }
+
+    /// Drops a page-cache read run's pages once read, so a unified-memory device (GB10) does not hold the weights
+    /// twice while loading. Advice only: errors are ignored. TF_INK2_KEEP_CACHE=1 keeps them.
+    fn forget(f: Src, r: ink.plan.Run) void {
+        if (comptime !is_linux) return;
+        if (std.c.getenv("TF_INK2_KEEP_CACHE")) |v| if (v[0] == '1') return;
+        const span = (r.count - 1) * r.stride + r.len;
+        _ = std.os.linux.fadvise(f.fd, @intCast(r.offset), @intCast(span), std.os.linux.POSIX_FADV.DONTNEED);
+    }
+};
+
+/// A small piece's bytes, converted, to its device array (or its scalar's place).
+fn convert(d: *const cuda.Driver, j: *Job, raw: []const u8) !void {
+    const gpa = std.heap.page_allocator;
+    switch (j.kind) {
+        .raw => unreachable,
+        .scalar => j.out.?.* = @bitCast(std.mem.readInt(u32, raw[0..4], .little)),
+        .gain, .router => {
+            const view: cuda.DeviceBuffer = .{ .d = d, .ptr = j.dst, .len = if (j.dtype == .f32) raw.len else raw.len * 2, .borrowed = true };
+            if (j.dtype == .f32) return view.upload(0, raw);
+            const out = try gpa.alloc(f32, raw.len / 2);
+            defer gpa.free(out);
+            for (out, 0..) |*o, i| o.* = ink.st.bf16ToF32(std.mem.readInt(u16, raw[2 * i ..][0..2], .little));
+            try view.upload(0, std.mem.sliceAsBytes(out));
+        },
+    }
+}
+
+/// The load's jobs as the plan's pieces are walked (in plan order): each device array allocated here, in the order
+/// and sizes the pieces come in.
+const Jobs = struct {
+    gpa: std.mem.Allocator,
+    w: *Weights,
+    list: std.ArrayList(Job) = .empty,
+    piece: u32 = 0,
+
+    fn alloc(J: *Jobs, bytes: u64) !u64 {
+        var buf = try cuda.DeviceBuffer.alloc(J.w.d, @intCast(bytes));
+        errdefer buf.free();
+        try J.w.own.append(J.gpa, buf);
+        J.w.bytes += bytes;
+        return buf.ptr;
+    }
+
+    /// The run's bytes as one dense device array.
+    fn raw(J: *Jobs, r: ink.plan.Run) !u64 {
+        const ptr = try J.alloc(r.bytes());
+        try J.list.append(J.gpa, .{ .piece = J.piece, .run = r, .kind = .raw, .dst = ptr });
+        return ptr;
+    }
+
+    /// A bf16 (or fp32) vector as fp32 on the device.
+    fn gain(J: *Jobs, r: ink.plan.Run, dtype: ink.inventory.DType) !u64 {
+        if (r.count != 1) return error.UnexpectedInkling2Layout;
+        if (dtype != .f32 and dtype != .bf16) return error.UnexpectedInkling2Layout;
+        const ptr = try J.alloc(if (dtype == .f32) r.len else r.len / 2 * 4);
+        try J.list.append(J.gpa, .{ .piece = J.piece, .run = r, .kind = .gain, .dtype = dtype, .dst = ptr });
+        return ptr;
+    }
+
+    /// The router [384, H] bf16 as fp32 (exact).
+    fn router(J: *Jobs, r: ink.plan.Run) !u64 {
+        if (r.count != 1 or r.len % 2 != 0) return error.UnexpectedInkling2Layout;
+        const ptr = try J.alloc(r.len / 2 * 4);
+        try J.list.append(J.gpa, .{ .piece = J.piece, .run = r, .kind = .router, .dst = ptr });
+        return ptr;
+    }
+
+    fn scalar(J: *Jobs, r: ink.plan.Run, out: *f32) !void {
+        if (r.len != 4 or r.count != 1) return error.UnexpectedInkling2Layout;
+        try J.list.append(J.gpa, .{ .piece = J.piece, .run = r, .kind = .scalar, .out = out });
+    }
+};
+
+/// Runs the jobs on the reader threads (and, asked, the recheck after), largest first.
+fn readAll(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, m: *const ink.describe.Model, jobs: []Job, rank: u32) !void {
+    if (jobs.len == 0) return;
+    const opts = ReadOpts.env();
+    var ctx: cuda.abi.Context = null;
+    try d.check(d.api.cuCtxGetCurrent(&ctx), "cuCtxGetCurrent");
+    const order = try gpa.alloc(u32, jobs.len);
+    defer gpa.free(order);
+    for (order, 0..) |*o, i| o.* = @intCast(i);
+    std.mem.sort(u32, order, @as([]const Job, jobs), struct {
+        fn lt(js: []const Job, x: u32, y: u32) bool {
+            return js[x].run.bytes() > js[y].run.bytes();
+        }
+    }.lt);
+    var total: u64 = 0;
+    for (jobs) |j| total += j.run.bytes();
+    const n = @min(opts.threads, jobs.len);
+    const threads = try gpa.alloc(std.Thread, n);
+    defer gpa.free(threads);
+    const clock = std.Io.Clock.awake;
+    const t0 = clock.now(io).toNanoseconds();
+    for (0..2) |pass| {
+        if (pass == 1 and !opts.recheck) break;
+        var p: Pool = .{ .d = d, .ctx = ctx, .dir = dir, .m = m, .jobs = jobs, .order = order, .opts = opts, .rank = rank, .recheck = pass == 1 };
+        var started: usize = 0;
+        for (threads) |*t| {
+            t.* = std.Thread.spawn(.{}, Pool.work, .{&p}) catch |e| {
+                p.fail(e);
+                break;
+            };
+            started += 1;
+        }
+        for (threads[0..started]) |t| t.join();
+        if (p.failed()) |e| return e;
+        const s = @as(f64, @floatFromInt(clock.now(io).toNanoseconds() - t0)) * 1e-9;
+        const gib = @as(f64, @floatFromInt(total)) / (1 << 30);
+        if (pass == 0) {
+            std.log.info("inkling2 rank {d}: read, hashed and uploaded {d} pieces, {d:.2} GiB in {d:.1} s ({d:.2} GiB/s; {d} threads, {s} reads, {d} MiB buffers{s})", .{ rank, jobs.len, gib, s, gib / @max(s, 1e-9), n, if (opts.direct) "direct" else "page-cache", opts.chunk >> 20, if (p.buffered.load(.acquire) > 0) "; some files through the page cache" else "" });
+        } else std.log.info("inkling2 rank {d}: recheck: every uploaded piece's device bytes hash as read ({d:.1} s since the load began)", .{ rank, s });
+    }
+}
+
+fn layerOf(c: *const ink.config.Config, l: u32, split: ink.plan.Split, rank: u32, format: Format) Layer {
+    const t = &c.text;
+    return .{
+        .index = l,
+        .global = t.global[l],
+        .boundary = t.blockBoundary(l),
+        .hq = split.qSpan(c, rank).len(),
+        .hk = split.kvSpan(c, rank).len(),
+        .nq = if (l == 0) 0 else if (t.global[l]) 3 else 1,
+        .experts = .{
+            .format = format,
+            .lo = split.expertSpan(rank).lo,
+            .hi = split.expertSpan(rank).hi,
+            .split = if (split.layout == .split) split.world else 1,
+            .part = if (split.layout == .split) rank else 0,
+            .n13 = split.rowSpan(2 * t.moe_intermediate, rank).len(),
+            .n2 = split.rowSpan(t.hidden, rank).len(),
+        },
+    };
+}
+
+/// Rank `want.rank`'s weights of layers [want.lo, want.hi) of the checked model `m` (read from `dir`), with the
+/// embedding and the head when asked; `prepare` hooks run per layer after its upload. The plan's pieces are walked in
+/// order first (each device array allocated, nothing read), then reader threads read, hash and upload them (ReadOpts);
+/// the digests come out in plan order, as the pieces are.
+pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, m: *const ink.describe.Model, want: Want, prepare: []const Prepare) !Weights {
+    const c = &m.c;
+    if (want.lo >= want.hi or want.hi > c.text.layers or want.rank >= m.p.split.world) return error.BadLayerRange;
+    var w: Weights = .{ .gpa = gpa, .d = d, .first = want.lo, .layers = try gpa.alloc(Layer, want.hi - want.lo), .vocab = c.text.vocab, .unpadded_vocab = c.text.unpadded_vocab, .vocab_rows = ink.plan.canon(c.text.vocab, want.rank, m.p.split.world) };
+    errdefer w.deinit();
+    for (w.layers, want.lo..) |*l, i| {
+        const li: u32 = @intCast(i);
+        var buf: [96]u8 = undefined;
+        const fmt: Format = if (m.inv.find(try std.fmt.bufPrint(&buf, "model.llm.layers.{d}.mlp.experts.w13_weight_amax", .{li})) != null) .nvfp4 else .mxfp8;
+        l.* = layerOf(c, li, m.p.split, want.rank, fmt);
+    }
+    var J: Jobs = .{ .gpa = gpa, .w = &w };
+    defer J.list.deinit(gpa);
+    const rank = &m.p.ranks[want.rank];
+    const llm = "model.llm.";
+    for (rank.pieces, 0..) |piece, pi| {
+        J.piece = @intCast(pi);
+        const t = m.inv.tensors[piece.tensor];
+        const role = m.roles[piece.tensor];
+        if (!std.mem.startsWith(u8, t.name, llm)) continue; // vision tower, drafter
+        const n = t.name[llm.len..];
+        if (role.layer) |li| {
+            if (li < want.lo or li >= want.hi) continue;
+            const l = &w.layers[li - want.lo];
+            if (std.mem.startsWith(u8, n, "attn_res.")) {
+                if (std.mem.startsWith(u8, n, "attn_res.attn_queries.")) l.attn_query = try J.raw(piece.run) else l.mlp_query = try J.raw(piece.run);
+                continue;
+            }
+            const leaf = n[std.mem.indexOfScalarPos(u8, n, "layers.".len, '.').? + 1 ..];
+            try assign(&J, l, leaf, piece.run, t.dtype);
+            continue;
+        }
+        if (std.mem.eql(u8, n, "embed.weight")) {
+            if (want.embed) {
+                w.embed = try J.raw(piece.run);
+                w.embed_rows = .{ .lo = 0, .hi = w.vocab };
+            }
+        } else if (std.mem.eql(u8, n, "embed_norm.weight")) {
+            if (want.embed) w.embed_norm = try J.gain(piece.run, t.dtype);
+        } else if (std.mem.eql(u8, n, "unembed.weight")) {
+            if (piece.run.count != 1 or piece.run.len != @as(u64, w.vocab_rows.len()) * hidden * 2) return error.UnexpectedInkling2Layout;
+            if (want.head) w.unembed = try J.raw(piece.run);
+        } else if (std.mem.eql(u8, n, "norm.weight")) {
+            if (want.head or want.final) w.norm = try J.gain(piece.run, t.dtype);
+        } else if (std.mem.eql(u8, n, "attn_res.output_query")) {
+            if (want.head or want.final) w.output_query = try J.raw(piece.run);
+        } else return error.UnknownInkling2Tensor;
+    }
+    try readAll(gpa, io, d, dir, m, J.list.items, want.rank);
+    if (want.digests) |out| for (J.list.items) |j| if (j.run.bytes() > 0) try out.append(gpa, .{ .piece = j.piece, .xxh64 = j.xxh64 });
+    for (w.layers) |*l| try complete(l);
+    if (want.embed and (w.embed == 0 or w.embed_norm == 0)) return error.MissingInkling2Tensor;
+    if (want.head and (w.unembed == 0 or w.norm == 0 or w.output_query == 0)) return error.MissingInkling2Tensor;
+    for (w.layers) |*l| for (prepare) |p| try p(&w, l);
+    return w;
+}
+
+const How = enum { raw, gain, router };
+
+fn assign(J: *Jobs, l: *Layer, leaf: []const u8, r: ink.plan.Run, dtype: ink.inventory.DType) !void {
+    const E = &l.experts;
+    const table = [_]struct { []const u8, *u64, How }{
+        .{ "attn.wq_du.weight", &l.wq, .raw },                     .{ "attn.wk_dv.weight", &l.wk, .raw },
+        .{ "attn.wv_dv.weight", &l.wv, .raw },                     .{ "attn.wr_du.weight", &l.wr, .raw },
+        .{ "attn.gate_attn.weight", &l.wg, .raw },                 .{ "attn.attn_sink_proj.weight", &l.wsink, .raw },
+        .{ "attn.wo_ud.weight", &l.wo, .raw },                     .{ "attn.q_l2_clip.scale", &l.q_scale, .raw },
+        .{ "attn.rel_l2_clip.scale", &l.rel_scale, .raw },         .{ "attn.rel_logits_proj.proj", &l.rel_proj, .raw },
+        .{ "attn.k_sconv.weight", &l.k_conv, .raw },               .{ "attn.k_sconv.static_w", &l.k_conv, .raw },
+        .{ "attn.v_sconv.weight", &l.v_conv, .raw },               .{ "attn.v_sconv.static_w", &l.v_conv, .raw },
+        .{ "attn.k_sconv.weight_proj", &l.k_wproj, .raw },         .{ "attn.v_sconv.weight_proj", &l.v_wproj, .raw },
+        .{ "attn_norm.weight", &l.in_norm[0], .gain },             .{ "q_input_norm.weight", &l.in_norm[0], .gain },
+        .{ "k_input_norm.weight", &l.in_norm[1], .gain },          .{ "v_input_norm.weight", &l.in_norm[2], .gain },
+        .{ "mlp_norm.weight", &l.mlp_norm, .gain },                .{ "attn_sconv.weight", &l.attn_conv, .raw },
+        .{ "mlp_sconv.weight", &l.mlp_conv, .raw },                .{ "mlp.gate.weight", &l.router, .router },
+        .{ "mlp.gate.bias", &l.router_bias, .raw },                .{ "mlp.experts.w13_weight", &E.w13, .raw },
+        .{ "mlp.experts.w13_weight_scale", &E.w13_scale, .raw },   .{ "mlp.experts.w2_weight", &E.w2, .raw },
+        .{ "mlp.experts.w2_weight_scale", &E.w2_scale, .raw },     .{ "mlp.experts.w13_weight_amax", &E.w13_amax, .raw },
+        .{ "mlp.experts.w2_weight_amax", &E.w2_amax, .raw },
+    };
+    for (table) |e| if (std.mem.eql(u8, leaf, e[0])) {
+        if (E.split > 1 and std.mem.startsWith(u8, leaf, "mlp.experts.")) try splitRun(E, leaf, r);
+        e[1].* = switch (e[2]) {
+            .raw => try J.raw(r),
+            .gain => try J.gain(r, dtype),
+            .router => try J.router(r),
+        };
+        return;
+    };
+    if (std.mem.eql(u8, leaf, "mlp.experts.w13_weight_outer_scale_denominator")) {
+        try J.scalar(r, &E.den13);
+    } else if (std.mem.eql(u8, leaf, "mlp.experts.w2_weight_outer_scale_denominator")) {
+        try J.scalar(r, &E.den2);
+    } else return error.UnknownInkling2Tensor;
+}
+
+/// A split rank's expert piece is what the kernels index: the amax whole (an fp32 a expert), every other tensor one
+/// strided run an expert of its n13 (w13) or n2 (w2) rows, `row` bytes a row (codes or values, then scales).
+fn splitRun(E: *const Experts, leaf: []const u8, r: ink.plan.Run) !void {
+    const n = E.hi - E.lo;
+    const nv = E.format == .nvfp4;
+    const amax = std.mem.endsWith(u8, leaf, "_amax");
+    const w13 = std.mem.indexOf(u8, leaf, "w13") != null;
+    const K: u64 = if (w13) hidden else 2304;
+    const rows: u64 = if (w13) E.n13 else E.n2;
+    const row: u64 = if (std.mem.endsWith(u8, leaf, "_scale")) (if (nv) K / 16 else K / 32) else (if (nv) K / 2 else K);
+    const ok = if (amax) r.bytes() == @as(u64, n) * 4 else r.count == n and r.len == rows * row;
+    if (!ok) {
+        std.log.err("inkling2: split experts: {s} is held as {d} runs of {d} bytes, not this rank's slice", .{ leaf, r.count, r.len });
+        return error.UnexpectedInkling2Layout;
+    }
+}
+
+/// Every tensor the layer needs is there.
+fn complete(l: *const Layer) !void {
+    const E = &l.experts;
+    const need = [_]u64{ l.mlp_norm, l.mlp_query, l.wq, l.wk, l.wv, l.wr, l.wg, l.wsink, l.wo, l.q_scale, l.rel_scale, l.rel_proj, l.k_conv, l.v_conv, l.attn_conv, l.mlp_conv, l.router, l.router_bias, E.w13, E.w13_scale, E.w2, E.w2_scale, l.in_norm[0] };
+    for (need, 0..) |p, i| if (p == 0) {
+        std.log.err("inkling2: layer {d} is missing tensor #{d} of its set", .{ l.index, i });
+        return error.MissingInkling2Tensor;
+    };
+    if (l.nq > 0 and l.attn_query == 0) return error.MissingInkling2Tensor;
+    if (l.global and (l.in_norm[1] == 0 or l.in_norm[2] == 0 or l.k_wproj == 0 or l.v_wproj == 0)) return error.MissingInkling2Tensor;
+    if (E.format == .nvfp4 and (E.w13_amax == 0 or E.w2_amax == 0 or E.den13 == 0 or E.den2 == 0)) return error.MissingInkling2Tensor;
+}
+
+test "inkling2 cuda weights: a layer's facts at W = 1 and W = 4" {
+    const c = try ink.config.parse(std.testing.allocator, ink.config.fixture, null);
+    const one = try ink.plan.Split.even(&c, 1, null);
+    const l0 = layerOf(&c, 0, one, 0, .nvfp4);
+    try std.testing.expect(l0.boundary and !l0.global and l0.nq == 0 and l0.hq == 48 and l0.hk == 8);
+    try std.testing.expectEqual(@as(u32, 384), l0.experts.count());
+    const l5 = layerOf(&c, 5, one, 0, .nvfp4);
+    try std.testing.expect(l5.global and !l5.boundary and l5.nq == 3);
+    const four = try ink.plan.Split.even(&c, 4, null);
+    const l47 = layerOf(&c, 47, four, 2, .mxfp8);
+    try std.testing.expect(l47.global and l47.hq == 12 and l47.hk == 2 and l47.experts.lo == 192 and l47.experts.hi == 288);
+    try std.testing.expect(l47.experts.n13 == 4608 and l47.experts.n2 == 4608 and l47.experts.split == 1);
+    const sp = try ink.plan.Split.sliced(&c, 4, null);
+    const s3 = layerOf(&c, 3, sp, 3, .nvfp4);
+    try std.testing.expect(s3.experts.lo == 0 and s3.experts.hi == 384 and s3.experts.split == 4 and s3.experts.part == 3);
+    try std.testing.expect(s3.experts.n13 == 1152 and s3.experts.n2 == 1152);
+}
+
+test "inkling2 cuda weights: a run's chunks read, hash and place exactly its rows (direct and page-cache reads)" {
+    const gpa = std.testing.allocator;
+    const file = try gpa.alloc(u8, 2 << 20);
+    defer gpa.free(file);
+    for (file, 0..) |*b, i| b.* = @truncate((i *% 2654435761) >> 7);
+    const R = ink.plan.Run;
+    const runs = [_]R{
+        .{ .file = 0, .offset = 0, .len = 1000, .stride = 1000, .count = 1 },
+        .{ .file = 0, .offset = 12345, .len = 300000, .stride = 0, .count = 1 }, // longer than a small chunk
+        .{ .file = 0, .offset = 777, .len = 3072, .stride = 12288, .count = 60 }, // rows close together
+        .{ .file = 0, .offset = 4097, .len = 5000, .stride = 200000, .count = 4 }, // far apart, unaligned stride
+        .{ .file = 0, .offset = 100, .len = 20000, .stride = 4096 * 40, .count = 5 }, // far apart, aligned stride
+        .{ .file = 0, .offset = 4096, .len = 70000, .stride = 4096 * 50, .count = 3 }, // long rows
+        .{ .file = 0, .offset = 3, .len = 1, .stride = 4096 * 33, .count = 9 },
+    };
+    for (runs) |r| for ([_]u64{ 1, direct_align }) |a| for ([_]usize{ 64 << 10, 1 << 20 }) |cap| {
+        const out = try gpa.alloc(u8, r.bytes());
+        defer gpa.free(out);
+        const buf = try gpa.alloc(u8, cap);
+        defer gpa.free(buf);
+        var h = std.hash.XxHash64.init(0);
+        var at: u64 = 0;
+        var it: Chunks = .{ .r = r, .a = a, .cap = cap };
+        while (it.next()) |c| {
+            try std.testing.expect(c.span() <= cap and c.file_at % a == 0 and c.read_len % a == 0 and c.rows > 0);
+            try std.testing.expect(c.reads == 1 or (c.reads == c.rows and c.read_step % a == 0 and c.pitch == c.read_len));
+            try std.testing.expect(c.need() <= c.read_len and c.dst == at);
+            for (0..c.reads) |k| @memcpy(buf[k * c.read_len ..][0..c.read_len], file[c.file_at + k * c.read_step ..][0..c.read_len]);
+            for (0..c.rows) |k| {
+                const row = buf[c.data_at + k * c.pitch ..][0..c.width];
+                @memcpy(out[c.dst + k * c.width ..][0..c.width], row);
+                h.update(row);
+            }
+            at += c.rows * c.width;
+        }
+        try std.testing.expectEqual(r.bytes(), at);
+        var want = std.hash.XxHash64.init(0);
+        for (0..r.count) |j| {
+            const row = file[r.offset + j * r.stride ..][0..r.len];
+            try std.testing.expectEqualSlices(u8, row, out[j * r.len ..][0..r.len]);
+            want.update(row);
+        }
+        try std.testing.expectEqual(want.final(), h.final());
+    };
+}
diff --git a/zig/src/families/inkling2/cuda_wire.zig b/zig/src/families/inkling2/cuda_wire.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7c454f944918d0a430e2847766f8efd0d3639c62
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_wire.zig
@@ -0,0 +1,740 @@
+//! TF_INK2_ROCE_MULTI=1 at three ranks or more: the layer exchanges' small all-gathers on fabric/tp's multirank RoCE
+//! wire instead of NCCL (borrowed as the GLM family borrows it, glm/cuda_roce_multi.zig). The same bytes land in the
+//! same rank-order slots, so the rank-order fp32 sums that follow are unchanged; gathers past the wire's ceiling
+//! (prompt chunks) stay on NCCL. On the four-Spark switchless ring set TF_TP_ROCE_RELAY=1 with one HCA to each
+//! neighbour (TF_TP_ROCE_HCA=rocep1s0f0:3,rocep1s0f1:3), TF_TP_KERNEL_IMAGE (tp_mailbox.fatbin), TF_TP_MASTER (rank
+//! 0's LAN address) and a free TF_TP_PORT (its plan link uses TF_TP_PORT + 7).
+const std = @import("std");
+const builtin = @import("builtin");
+const cuda = @import("cuda");
+const tp = @import("tp");
+
+const Group = cuda.tp_group.Group;
+
+/// Every transport beside NCCL, once the group is open: first one unconditional vote of every rank on the transport
+/// settings (agreeTransport), then upstream's RoCE gather (TF_ROCE) and the mesh wire (TF_INK2_ROCE_MULTI), entered
+/// by every rank alike. A rank whose settings differ, or that cannot read its own (the kernel image), stops every
+/// rank within the vote, naming the setting and the rank; any other failure here is told to the other ranks by name
+/// on the liveness lines (when open), so none is left waiting in a collective or a bootstrap. The mesh wire's
+/// bootstrap takes the settings and the kernel image's bytes the vote compared (Mesh), never a second read.
+pub fn openAll(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, g: *Group) !void {
+    openAgreed(gpa, io, d, g) catch |err| {
+        switch (err) {
+            // every rank reached the same verdict in the vote and stops on its own; none needs telling
+            error.TransportSettingsDiffer, error.TransportNotReady => cuda.tp_watch.ended(),
+            else => cuda.tp_watch.fail(@errorName(err)),
+        }
+        return err;
+    };
+}
+
+fn openAgreed(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, g: *Group) !void {
+    var mesh = try agreeTransport(gpa, io, d, g);
+    defer if (mesh) |*m| m.deinit(gpa);
+    try openFast(gpa, io, d, g);
+    try open(gpa, io, d, g, wanted(), if (mesh) |*m| m else null);
+}
+
+/// What every rank's vote agreed for the mesh wire, kept for its bootstrap: the fabric/tp settings as parsed for the
+/// ballot and the kernel image's bytes whose sha256 was compared. Nothing is read again after the vote.
+pub const Mesh = struct {
+    cfg: tp.Config,
+    image: []align(16) u8,
+
+    fn deinit(m: *Mesh, gpa: std.mem.Allocator) void {
+        gpa.free(m.image);
+    }
+};
+
+/// The settings a transport branches on, each compared as its effective value (empty: not in use at this world or
+/// with the wire off). TF_TP_ROCE_HCA, TF_TP_ROCE_CPU and TF_TP_ROCE_FAST may differ between hosts and are not here.
+const Setting = enum(u8) { roce, roce_max_kb, multi, master, port, mailbox_kb, relay, wire, fallback, tp_rest, image };
+
+fn settingName(s: Setting) []const u8 {
+    return switch (s) {
+        .roce => "TF_ROCE",
+        .roce_max_kb => "TF_ROCE_MAX_KB",
+        .multi => "TF_INK2_ROCE_MULTI",
+        .master => "TF_TP_MASTER",
+        .port => "TF_TP_PORT / TF_TP_PLAN_PORT",
+        .mailbox_kb => "TF_TP_MAILBOX_MAX_KB",
+        .relay => "TF_TP_ROCE_RELAY / TF_TP_ROCE_RELAY_MAX_KB",
+        .wire => "TF_TP_ROCE_WIRE",
+        .fallback => "TF_TP_ROCE_FALLBACK",
+        .tp_rest => "the other fabric/tp settings (TF_COMM_BACKEND, TF_TP_ROCE_CHUNKED_KB, TF_TP_FAILFAST)",
+        .image => "TF_TP_KERNEL_IMAGE's contents (sha256)",
+    };
+}
+
+const n_settings = @intFromEnum(Setting.image) + 1; // image is the last
+const value_len = 40; // a value as shown in the lines (cut to fit)
+const full_len = 1024; // the longest value compared (a DNS name is at most 255 bytes)
+
+/// One rank's ballot: its effective transport settings, or why it cannot read them (ready 0). Fixed size: it crosses
+/// NCCL as bytes in one all-gather. Each setting is compared by the sha256 of its whole value (`full`); `values`
+/// holds it cut to fit, for the lines only.
+const Vote = extern struct {
+    rank: u32,
+    world: u32,
+    ready: u32 = 1,
+    why: [120]u8 = @splat(0),
+    values: [n_settings][value_len]u8 = @splat(@splat(0)),
+    full: [n_settings][32]u8 = @splat(@splat(0)),
+
+    fn set(v: *Vote, s: Setting, comptime fmt: []const u8, args: anytype) void {
+        const i = @intFromEnum(s);
+        var buf: [full_len]u8 = undefined;
+        const text = std.fmt.bufPrint(&buf, fmt, args) catch {
+            // longer than any valid value: not compared by a prefix, refused (every rank sees which)
+            v.refuse("{s} is longer than {d} bytes", .{ settingName(s), full_len });
+            return;
+        };
+        std.crypto.hash.sha2.Sha256.hash(text, &v.full[i], .{});
+        const out = &v.values[i];
+        @memset(out, 0);
+        const n = @min(text.len, value_len - 1);
+        @memcpy(out[0..n], text[0..n]);
+        if (text.len > n) @memcpy(out[value_len - 4 .. value_len - 1], "...");
+    }
+
+    fn value(v: *const Vote, s: Setting) []const u8 {
+        return std.mem.sliceTo(&v.values[@intFromEnum(s)], 0);
+    }
+
+    /// Whether `v` and `w` hold the same whole value of `s` (not its shown, possibly cut, form).
+    fn same(v: *const Vote, w: *const Vote, s: Setting) bool {
+        return std.mem.eql(u8, &v.full[@intFromEnum(s)], &w.full[@intFromEnum(s)]);
+    }
+
+    fn refuse(v: *Vote, comptime fmt: []const u8, args: anytype) void {
+        if (v.ready == 0) return; // the first reason stays
+        v.ready = 0;
+        _ = std.fmt.bufPrint(v.why[0 .. v.why.len - 1], fmt, args) catch {
+            @memcpy(v.why[v.why.len - 4 .. v.why.len - 1], "...");
+        };
+    }
+
+    fn reason(v: *const Vote) []const u8 {
+        return std.mem.sliceTo(&v.why, 0);
+    }
+};
+
+const Get = *const fn ([]const u8) ?[]const u8;
+
+fn envGet(name: []const u8) ?[]const u8 {
+    var buf: [64]u8 = undefined;
+    if (name.len >= buf.len) return null;
+    @memcpy(buf[0..name.len], name);
+    buf[name.len] = 0;
+    return if (std.c.getenv(buf[0..name.len :0])) |v| std.mem.span(v) else null;
+}
+
+/// The environment as fabric/tp reads its own settings (tp.Config.fromEnvFor): an empty value is unset.
+fn tpEnvGet(name: []const u8) ?[]const u8 {
+    const v = envGet(name) orelse return null;
+    return if (v.len == 0) null else v;
+}
+
+/// openFast's branch: TF_ROCE starting with 1 at two ranks or more.
+fn roceOn(get: Get, world: usize) bool {
+    const v = get("TF_ROCE") orelse return false;
+    return world >= 2 and v.len > 0 and v[0] == '1';
+}
+
+/// open's branch: TF_INK2_ROCE_MULTI starting with 1, three ranks or more, on Linux.
+fn multiOn(get: Get, world: usize, linux: bool) bool {
+    const v = get("TF_INK2_ROCE_MULTI") orelse return false;
+    return linux and world >= 3 and v.len > 0 and v[0] == '1';
+}
+
+/// The kernel image as this rank found it (read only when the mesh wire is on).
+const Image = union(enum) { unset, failed: []const u8, empty, digest: [32]u8 };
+
+/// The image's state for the ballot and, when it was read, its bytes (the caller's): the very bytes hashed.
+const ImageRead = struct { image: Image, bytes: ?[]align(16) u8 = null };
+
+fn readImage(gpa: std.mem.Allocator, io: std.Io, get: Get) ImageRead {
+    const path = get("TF_TP_KERNEL_IMAGE") orelse return .{ .image = .unset };
+    // aligned as the wire's module load takes them (fabric/tp roce_multi)
+    const bytes = std.Io.Dir.cwd().readFileAllocOptions(io, path, gpa, .limited(1 << 26), .@"16", null) catch |err| return .{ .image = .{ .failed = @errorName(err) } };
+    if (bytes.len == 0) {
+        gpa.free(bytes);
+        return .{ .image = .empty };
+    }
+    var h: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(bytes, &h, .{});
+    return .{ .image = .{ .digest = h }, .bytes = bytes };
+}
+
+/// This rank's ballot from `get` (the environment), its place, and its kernel image when the mesh wire is on.
+fn ballot(get: Get, world: usize, rank: usize, linux: bool, image: Image) Vote {
+    var cfg: ?tp.Config = null;
+    return ballotParsed(get, get, world, rank, linux, image, &cfg);
+}
+
+/// `ballot`, with the fabric/tp settings read through `tp_get` and kept in `cfg` (when the mesh wire is on and they
+/// parse): the settings voted on are the ones the bootstrap uses.
+fn ballotParsed(get: Get, tp_get: Get, world: usize, rank: usize, linux: bool, image: Image, cfg_out: *?tp.Config) Vote {
+    var v: Vote = .{ .rank = @intCast(rank), .world = @intCast(world) };
+    if (roceOn(get, world)) {
+        v.set(.roce, "{s}", .{get("TF_ROCE").?});
+        const kb = if (get("TF_ROCE_MAX_KB")) |k| std.fmt.parseInt(usize, k, 10) catch blk: {
+            v.refuse("TF_ROCE_MAX_KB={s} is not a number", .{k});
+            break :blk 0;
+        } else 512;
+        v.set(.roce_max_kb, "{d}", .{kb});
+    } else v.set(.roce, "off", .{});
+    if (!multiOn(get, world, linux)) {
+        v.set(.multi, "off", .{});
+        return v;
+    }
+    v.set(.multi, "on", .{});
+    const cfg = tp.Config.parseFor(tp_get, @intCast(world), @intCast(rank)) catch {
+        v.refuse("a fabric/tp setting (TF_TP_*) is invalid: its warning above names it", .{});
+        return v;
+    };
+    cfg_out.* = cfg;
+    v.set(.master, "{s}", .{cfg.master});
+    v.set(.port, "{d}/{d}", .{ cfg.port, cfg.link_port });
+    v.set(.mailbox_kb, "{d}", .{cfg.mailbox_max_bytes / 1024});
+    if (cfg.roce_relay) v.set(.relay, "on, {d} KiB", .{cfg.roce_relay_max_bytes / 1024}) else v.set(.relay, "off", .{});
+    v.set(.wire, "{t}", .{cfg.roce_wire});
+    v.set(.fallback, "{t}", .{cfg.roce_fallback});
+    const rest = cfg.digest();
+    v.set(.tp_rest, "{x}", .{&rest});
+    switch (image) {
+        .unset => v.refuse("TF_TP_KERNEL_IMAGE is not set (TF_INK2_ROCE_MULTI=1 needs tp_mailbox.fatbin)", .{}),
+        .failed => |e| v.refuse("TF_TP_KERNEL_IMAGE={s}: {s}", .{ get("TF_TP_KERNEL_IMAGE").?, e }),
+        .empty => v.refuse("TF_TP_KERNEL_IMAGE={s} is empty", .{get("TF_TP_KERNEL_IMAGE").?}),
+        .digest => |h| v.set(.image, "{x}", .{&h}),
+    }
+    return v;
+}
+
+const Verdict = union(enum) {
+    agreed,
+    not_ready: usize, // the lowest rank that could not read its settings
+    differs: struct { rank: usize, setting: ?Setting }, // the first rank and setting unlike `mine` (null: place)
+};
+
+/// The same verdict on every rank: every rank reads the same ballots.
+fn judge(all: []const Vote, mine: *const Vote) Verdict {
+    for (all, 0..) |v, r| if (v.ready != 1) return .{ .not_ready = r };
+    for (all, 0..) |v, r| {
+        if (v.rank != r or v.world != all.len) return .{ .differs = .{ .rank = r, .setting = null } };
+        for (std.enums.values(Setting)) |s| if (!v.same(mine, s)) return .{ .differs = .{ .rank = r, .setting = s } };
+    }
+    return .agreed;
+}
+
+/// Before any transport: every rank's transport ballot over the group's NCCL (the one collective every rank enters
+/// unconditionally), then one verdict. Differing settings or a rank not ready stop every rank here, naming them.
+/// With the mesh wire on, returns the agreed settings and the image bytes hashed for the ballot (the caller's).
+fn agreeTransport(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, g: *Group) !?Mesh {
+    if (g.world < 2) return null;
+    const linux = comptime builtin.os.tag == .linux;
+    var read: ImageRead = if (multiOn(&envGet, g.world, linux)) readImage(gpa, io, &envGet) else .{ .image = .unset };
+    defer if (read.bytes) |b| gpa.free(b);
+    var cfg: ?tp.Config = null;
+    const mine = ballotParsed(&envGet, &tpEnvGet, g.world, g.rank, linux, read.image, &cfg);
+    const all = try gpa.alloc(Vote, g.world);
+    defer gpa.free(all);
+    {
+        var s = try cuda.Stream.init(d, true);
+        defer s.deinit();
+        try g.gather(Vote, d, s, mine, all);
+    }
+    switch (judge(all, &mine)) {
+        .agreed => {},
+        .not_ready => {
+            for (all, 0..) |v, r| if (v.ready != 1) std.log.err("inkling2 rank {d}: rank {d} cannot open its transports: {s}; every rank stops", .{ g.rank, r, v.reason() });
+            return error.TransportNotReady;
+        },
+        .differs => {
+            for (all, 0..) |v, r| {
+                if (v.rank != r or v.world != g.world) std.log.err("inkling2 rank {d}: rank {d} reports rank {d} of {d}", .{ g.rank, r, v.rank, v.world });
+                for (std.enums.values(Setting)) |s| if (!v.same(&mine, s))
+                    std.log.err("inkling2 rank {d}: rank {d} differs from this rank in {s} (rank {d}: \"{s}\", this rank: \"{s}\"); every rank stops", .{ g.rank, r, settingName(s), r, v.value(s), mine.value(s) });
+            }
+            return error.TransportSettingsDiffer;
+        },
+    }
+    if (g.rank == 0) std.log.info("inkling2: transport settings agreed on {d} ranks: TF_ROCE {s}, TF_INK2_ROCE_MULTI {s}{s}{s}{s}{s}{s}", .{ g.world, mine.value(.roce), mine.value(.multi), if (mine.value(.mailbox_kb).len > 0) " (TF_TP_MAILBOX_MAX_KB " else "", mine.value(.mailbox_kb), if (mine.value(.image).len > 0) ", kernel image sha256 " else "", mine.value(.image), if (mine.value(.mailbox_kb).len > 0) ")" else "" });
+    return keep(&mine, cfg, &read.bytes);
+}
+
+/// The mesh wire's part of an agreed vote: its settings and the image bytes (moved out of `bytes`), or null when the
+/// wire is off. An agreed ballot with the wire on was ready, so both are there.
+fn keep(mine: *const Vote, cfg: ?tp.Config, bytes: *?[]align(16) u8) ?Mesh {
+    if (!std.mem.eql(u8, mine.value(.multi), "on")) return null;
+    const c = cfg orelse return null;
+    const image = bytes.* orelse return null;
+    bytes.* = null;
+    return .{ .cfg = c, .image = image };
+}
+
+/// TF_INK2_ROCE_MULTI=1: every rank must set it alike (it is in the run's settings; the wire's own vote also agrees).
+pub fn wanted() bool {
+    const v = std.c.getenv("TF_INK2_ROCE_MULTI") orelse return false;
+    return v[0] == '1';
+}
+
+/// TF_ROCE=1 (switched fabric, every rank reaching every other on the same HCA index): upstream's RoCE small-gather
+/// wire (cuda/roce.zig, docs/roce-gather.md) carries gathers of up to TF_ROCE_MAX_KB (default 512) a rank; its connect
+/// probe refuses a ring without a switch and every rank keeps NCCL. Off unless set, at any world size.
+pub fn openFast(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, g: *Group) !void {
+    const v = std.c.getenv("TF_ROCE") orelse return;
+    if (v[0] != '1' or g.world < 2) return;
+    const kb = if (std.c.getenv("TF_ROCE_MAX_KB")) |k| try std.fmt.parseInt(usize, std.mem.span(k), 10) else 512;
+    var s = try cuda.Stream.init(d, true);
+    defer s.deinit();
+    try g.openRoce(gpa, io, d, s, kb * 1024);
+    if (g.rank == 0) std.log.info("TF_ROCE=1: gathers up to {d} KiB a rank on {s}", .{ kb, if (g.fast != null) "the RoCE wire" else "NCCL (the wire did not come up)" });
+}
+
+/// Every rank opens the wire and lends it to `g` once every probe matched NCCL; one rank failing leaves all on NCCL.
+/// `mesh` is what the transport vote agreed (agreeTransport): the settings and kernel image used here, as compared.
+pub fn open(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, g: *Group, on: bool, mesh: ?*const Mesh) !void {
+    if (comptime builtin.os.tag != .linux) return; // fabric/tp's sockets and verbs
+    if (!on) return;
+    if (g.world < 3) {
+        if (g.rank == 0) std.log.info("TF_INK2_ROCE_MULTI=1 takes three ranks or more; {d} keep their own route", .{g.world});
+        return;
+    }
+    // every rank's vote agreed the wire on, so every rank holds its settings and image: no rank enters the bootstrap
+    // alone
+    const m = mesh orelse return error.TransportNotAgreed;
+    _ = io; // nothing is read here: the vote read it
+    var stage: Stage = .local;
+    const w = borrow(gpa, d, g, m, &stage) catch |err| {
+        // TF_TP_ROCE_FALLBACK=error refuses rather than run on NCCL, as does a failure the others may not share
+        if (m.cfg.roce_fallback == .@"error" or !fallsBack(err, stage)) return err;
+        std.log.warn("rank {d}: TF_INK2_ROCE_MULTI=1, but the wire did not open ({s}); NCCL keeps the small gathers", .{ g.rank, @errorName(err) });
+        return;
+    };
+    g.multi = .{ .ctx = w, .fits = fits, .gather = gather, .check = check, .abort = abort, .deinit = deinit };
+}
+
+/// How far a rank's borrow got: `local` until its bootstrap is open (every rank connected), `bootstrap` while every
+/// step is voted on the bootstrap, `nccl` once its probe's NCCL gather is enqueued.
+const Stage = enum { local, bootstrap, nccl };
+
+/// Whether NCCL keeps the small gathers after `err` at `stage`. Never from `local`: the other ranks are entering the
+/// bootstrap, so this rank's failure goes to them (openAll: by name on the liveness lines) and every rank stops,
+/// instead of this rank running on while they wait out the bootstrap's timeout. Always within the bootstrap (each
+/// step every rank's or none). After the probe's gather is enqueued, only on every rank's verdict (a mismatch).
+fn fallsBack(err: anyerror, stage: Stage) bool {
+    return switch (stage) {
+        .local => false,
+        .bootstrap => true,
+        .nccl => err == error.ProbeMismatch,
+    };
+}
+
+/// fabric/tp's bootstrap, ports, wire and kernel, and a probe against the group's NCCL: each step every rank's or none.
+fn borrow(gpa: std.mem.Allocator, d: *const cuda.Driver, g: *const Group, m: *const Mesh, stage: *Stage) !*Wire {
+    const cfg = m.cfg;
+    var b = try tp.Bootstrap.open(cfg);
+    defer b.close(); // the wire is connected by the end of init
+    stage.* = .bootstrap;
+    try b.agree(&cfg.digest(), "fabric/tp settings (TF_TP_MAILBOX_MAX_KB, TF_TP_ROCE_RELAY_MAX_KB, TF_TP_ROCE_WIRE, TF_TP_ROCE_FALLBACK)");
+    var specs: [tp.roce_verbs.max_hcas]tp.roce_verbs.HcaSpec = undefined;
+    var picked = true;
+    const n = if (cfg.roce_wire == .verbs) tp.roce_pick.resolve(cfg, &b, &specs) catch blk: {
+        picked = false;
+        break :blk 0;
+    } else 0;
+    if (!try everyRank(&b, picked)) return error.RoceHcaSelectionFailed;
+    const r = try tp.roce_multi.Roce.init(d, &b, m.image, wireOptions(cfg, specs[0..n])); // the module copies it at load
+    errdefer r.deinit();
+    const w = try gpa.create(Wire); // before the last vote: nothing after it can fail
+    errdefer gpa.destroy(w);
+    w.* = .{ .gpa = gpa, .r = r, .rank = g.rank };
+    var p: Probe = .{ .gpa = gpa, .d = d, .g = g, .r = r };
+    defer p.deinit();
+    try vote(&b, p.steps(), stage);
+    var line: [384]u8 = undefined;
+    const ceiling = if (r.relay) @min(r.slot_bytes, r.relay_max_bytes) else r.slot_bytes;
+    std.log.info("rank {d}: TF_INK2_ROCE_MULTI: gathers up to {d} KiB a rank on the wire, its probe equal to NCCL's: {s}", .{ g.rank, ceiling / 1024, r.describeLink(&line) });
+    return w;
+}
+
+/// The wire settings used by borrow, kept separate from device setup so the host can check the exact options.
+fn wireOptions(cfg: tp.Config, hcas: []const tp.roce_verbs.HcaSpec) tp.roce_multi.Options {
+    return .{ .relay = cfg.roce_relay, .relay_max_bytes = cfg.roce_relay_max_bytes, .wire = if (cfg.roce_wire == .shm) .shm else .verbs, .hcas = hcas, .traffic_class = cfg.roce_tc, .cpu = cfg.roce_cpu, .max_bytes = cfg.mailbox_max_bytes, .timeout_ns = cfg.mailbox_timeout_ns, .fast = cfg.roce_fast, .blocks = cfg.roce_blocks };
+}
+
+/// Called before startup or weight loading, using the family's already checked rank/world.
+pub fn validate(world: usize, rank: usize, enabled: bool) !void {
+    if (enabled) _ = try tp.Config.fromEnvFor(@intCast(world), @intCast(rank));
+}
+
+test "inkling2 wire: wire options preserve the opt-in and its slot independently" {
+    const o = wireOptions(.{ .world = 4, .roce_relay = true, .roce_relay_max_bytes = 128 * 1024, .mailbox_max_bytes = 256 * 1024 }, &.{});
+    try std.testing.expect(o.relay);
+    try std.testing.expectEqual(@as(usize, 256 * 1024), o.max_bytes);
+    try std.testing.expectEqual(@as(usize, 128 * 1024), o.relay_max_bytes);
+    try std.testing.expect(!wireOptions(.{}, &.{}).relay);
+}
+
+/// A rank's probe in steps (made ready before any gather, both gathers, the wait, the verdict); a test fails any.
+const Steps = struct {
+    ctx: *anyopaque,
+    prepare: *const fn (*anyopaque) anyerror!void,
+    wire: *const fn (*anyopaque) anyerror!void,
+    nccl: *const fn (*anyopaque) anyerror!void,
+    wait: *const fn (*anyopaque) anyerror!void,
+    equal: *const fn (*anyopaque) bool,
+};
+
+/// Every rank is ready before any enters a gather, then all enter both; a failed NCCL gather or wait refuses at once.
+fn vote(b: *tp.Bootstrap, s: Steps, stage: *Stage) !void {
+    const ready = if (s.prepare(s.ctx)) |_| true else |_| false;
+    if (!try everyRank(b, ready)) return error.ProbeUnprepared;
+    const wired = if (s.wire(s.ctx)) |_| true else |_| false; // NCCL's gather follows it either way
+    stage.* = .nccl;
+    try s.nccl(s.ctx);
+    try s.wait(s.ctx);
+    try lendIfAll(b, wired and s.equal(s.ctx));
+}
+
+/// One 4 KiB gather in place, on the wire and on the group's NCCL (no wire lent yet): every byte must be equal.
+const Probe = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    g: *const Group,
+    r: *tp.roce_multi.Roce,
+    a: ?cuda.DeviceBuffer = null, // the wire's rows, then NCCL's
+    s: ?cuda.Stream = null,
+
+    const n = 4096;
+
+    fn deinit(p: *Probe) void {
+        if (p.a) |*a| a.free();
+        if (p.s) |*s| s.deinit();
+    }
+
+    fn steps(p: *Probe) Steps {
+        return .{ .ctx = p, .prepare = prepare, .wire = wire, .nccl = nccl, .wait = wait, .equal = equal };
+    }
+
+    fn from(ctx: *anyopaque) *Probe {
+        return @ptrCast(@alignCast(ctx));
+    }
+
+    fn prepare(ctx: *anyopaque) anyerror!void {
+        const p = from(ctx);
+        const world = p.g.world;
+        p.a = try cuda.DeviceBuffer.alloc(p.d, 2 * world * n);
+        p.s = try cuda.Stream.init(p.d, true);
+        var mine: [n]u8 = undefined;
+        tp.reference.fill(&mine, .bf16, @intCast(p.g.rank), 0x7072_6f62);
+        try p.a.?.uploadAsync(p.g.rank * n, &mine, p.s.?.handle);
+        try p.a.?.uploadAsync((world + p.g.rank) * n, &mine, p.s.?.handle);
+        try p.s.?.synchronize(); // the rows are up before this rank says it is ready
+    }
+
+    fn wire(ctx: *anyopaque) anyerror!void {
+        const p = from(ctx);
+        try p.r.allGatherBytes(p.a.?.ptr + p.g.rank * n, p.a.?.ptr, n, p.s.?.handle);
+    }
+
+    fn nccl(ctx: *anyopaque) anyerror!void {
+        const p = from(ctx);
+        try p.g.allGather(p.s.?, p.a.?.ptr + (p.g.world + p.g.rank) * n, p.a.?.ptr + p.g.world * n, n);
+    }
+
+    fn wait(ctx: *anyopaque) anyerror!void {
+        try from(ctx).s.?.synchronize();
+    }
+
+    fn equal(ctx: *anyopaque) bool {
+        const p = from(ctx);
+        const world = p.g.world;
+        p.r.check() catch return false;
+        const got = p.gpa.alloc(u8, 2 * world * n) catch return false;
+        defer p.gpa.free(got);
+        p.a.?.download(0, got) catch return false;
+        const same = std.mem.eql(u8, got[0 .. world * n], got[world * n ..]);
+        if (!same) std.log.warn("rank {d}: TF_INK2_ROCE_MULTI's probe: the wire's gather DIFFERS from NCCL's", .{p.g.rank});
+        return same;
+    }
+};
+
+/// The wire is lent only when every rank's probe matched NCCL's bytes: one rank's mismatch keeps every rank on NCCL.
+fn lendIfAll(b: *tp.Bootstrap, good: bool) !void {
+    if (!try everyRank(b, good)) return error.ProbeMismatch;
+}
+
+/// Every rank's vote over the bootstrap, the same answer on every rank.
+fn everyRank(b: *tp.Bootstrap, yes: bool) !bool {
+    var blobs: [tp.bootstrap.max_ranks][]const u8 = undefined;
+    var buf: [tp.bootstrap.max_ranks]u8 = undefined;
+    return allSaid(try b.allGather(&.{@intFromBool(yes)}, &buf, &blobs));
+}
+
+/// Whether every rank's one-byte vote is yes: every rank reads the same votes, so every rank decides alike.
+fn allSaid(votes: []const []const u8) bool {
+    for (votes) |v| if (v.len != 1 or v[0] != 1) return false;
+    return true;
+}
+
+/// The lent wire and what went down it, for its account at the end.
+const Wire = struct {
+    gpa: std.mem.Allocator,
+    r: *tp.roce_multi.Roce,
+    rank: usize,
+    gathers: std.atomic.Value(u64) = .init(0),
+    bytes: std.atomic.Value(u64) = .init(0),
+};
+
+fn of(ctx: *anyopaque) *Wire {
+    return @ptrCast(@alignCast(ctx));
+}
+
+fn fits(ctx: *anyopaque, bytes: usize) bool {
+    return of(ctx).r.fits(bytes);
+}
+
+fn gather(ctx: *anyopaque, s: cuda.abi.Stream, mine: cuda.abi.DevicePtr, all: cuda.abi.DevicePtr, bytes: usize) anyerror!void {
+    const w = of(ctx);
+    try w.r.allGatherBytes(mine, all, bytes, s);
+    // once: the engine's own gathers take the wire (a server's stop exits before any close prints the account)
+    if (w.gathers.fetchAdd(1, .monotonic) == 0) std.log.info("rank {d}: TF_INK2_ROCE_MULTI: the first gather is on the wire ({d} bytes a rank)", .{ w.rank, bytes });
+    _ = w.bytes.fetchAdd(bytes, .monotonic);
+}
+
+fn check(ctx: *anyopaque) anyerror!void {
+    return of(ctx).r.check(); // a failed wait's line names the rank and seq it waited on
+}
+
+fn abort(ctx: *anyopaque) void {
+    const w = of(ctx);
+    w.r.abort();
+    report(w, "aborted");
+}
+
+fn deinit(ctx: *anyopaque) void {
+    const w = of(ctx);
+    report(w, "closing");
+    w.r.deinit();
+    w.gpa.destroy(w);
+}
+
+/// Gathers, bytes, the proxy's last post and failure, each HCA's QPs: a rank whose posts stop short is the stuck one.
+fn report(w: *const Wire, when: []const u8) void {
+    var line: [384]u8 = undefined;
+    const r = w.r;
+    const fmt = "rank {d}: TF_INK2_ROCE_MULTI {s}: {d} gathers, {d} bytes, posted to seq {d}, failed {s}{s}; {s}";
+    const args = .{ w.rank, when, w.gathers.load(.monotonic), w.bytes.load(.monotonic), r.last_seq, if (r.failed()) "yes " else "no", r.proxyError(), r.describeLink(&line) };
+    if (r.failed()) std.log.warn(fmt, args) else std.log.info(fmt, args);
+}
+
+test "TF_INK2_ROCE_MULTI off, or under three ranks: the group keeps its own route and nothing opens" {
+    var g: Group = .{ .lib = undefined, .comm = null, .rank = 0, .world = 3 };
+    try open(std.testing.allocator, undefined, undefined, &g, false, null);
+    try std.testing.expect(g.multi == null);
+    g.world = 2;
+    try open(std.testing.allocator, undefined, undefined, &g, true, null);
+    try std.testing.expect(g.multi == null);
+}
+
+test "inkling2 wire: a failure on one rank after the vote, before its bootstrap is open, never falls back alone" {
+    // the vote passed on every rank, then this rank lacks what it agreed (or its bootstrap fails to open): it stops
+    // with an error (openAll tells every rank on the liveness lines) instead of returning on NCCL while its peers
+    // wait in the bootstrap, whatever the error and TF_TP_ROCE_FALLBACK
+    for ([_]anyerror{ error.OutOfMemory, error.FileNotFound, error.ConnectionRefused, error.AddressInUse, error.ProbeMismatch }) |e|
+        try std.testing.expect(!fallsBack(e, .local));
+    // within the bootstrap every step is every rank's: all fall back together; after the probe's NCCL gather, only a
+    // mismatch every rank saw
+    try std.testing.expect(fallsBack(error.RoceHcaSelectionFailed, .bootstrap));
+    try std.testing.expect(fallsBack(error.ProbeUnprepared, .bootstrap));
+    try std.testing.expect(fallsBack(error.ProbeMismatch, .nccl));
+    try std.testing.expect(!fallsBack(error.Timeout, .nccl));
+    if (comptime builtin.os.tag == .linux) {
+        // the wire on at three ranks without the vote's settings and image (a rank that did not pass the vote):
+        // refused before any bootstrap, as an error, not a fallback
+        var g: Group = .{ .lib = undefined, .comm = null, .rank = 2, .world = 3 };
+        try std.testing.expectError(error.TransportNotAgreed, open(std.testing.allocator, undefined, undefined, &g, true, null));
+        try std.testing.expect(g.multi == null);
+    }
+}
+
+test "inkling2 wire: the bootstrap gets the very image bytes the vote hashed, not a second read" {
+    var tmp = std.testing.tmpDir(.{});
+    defer tmp.cleanup();
+    const io = std.testing.io;
+    try tmp.dir.writeFile(io, .{ .sub_path = "tp_mailbox.fatbin", .data = "the voted kernel image" });
+    const path = try tmp.dir.realPathFileAlloc(io, "tp_mailbox.fatbin", std.testing.allocator);
+    defer std.testing.allocator.free(path);
+    ImageEnv.path = path;
+    var read = readImage(std.testing.allocator, io, &ImageEnv.get);
+    defer if (read.bytes) |b| std.testing.allocator.free(b);
+    var want: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash("the voted kernel image", &want, .{});
+    try std.testing.expectEqualSlices(u8, &want, &read.image.digest);
+    // the file changes (or goes) after the vote: the kept bytes are still the voted ones
+    try tmp.dir.writeFile(io, .{ .sub_path = "tp_mailbox.fatbin", .data = "another image" });
+    try tmp.dir.deleteFile(io, "tp_mailbox.fatbin");
+    const v = ballot(VoteTest.env(&VoteTest.release), 4, 0, true, read.image);
+    var cfg: ?tp.Config = tp.Config.parseFor(VoteTest.env(&VoteTest.release), 4, 0) catch unreachable;
+    const m = keep(&v, cfg, &read.bytes).?;
+    try std.testing.expect(read.bytes == null); // moved into the Mesh
+    var got: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(m.image, &got, .{});
+    try std.testing.expectEqualSlices(u8, &want, &got);
+    try std.testing.expectEqualStrings("198.51.100.1", m.cfg.master);
+    std.testing.allocator.free(m.image);
+    // with the wire off nothing is kept
+    cfg = null;
+    const off = ballot(VoteTest.env(&.{}), 4, 0, true, .unset);
+    var none: ?[]align(16) u8 = null;
+    try std.testing.expect(keep(&off, cfg, &none) == null);
+}
+
+const ImageEnv = struct {
+    var path: []const u8 = "";
+    fn get(name: []const u8) ?[]const u8 {
+        return if (std.mem.eql(u8, name, "TF_TP_KERNEL_IMAGE")) path else null;
+    }
+};
+
+test "the wire is lent only when every rank's vote is one byte saying yes" {
+    try std.testing.expect(allSaid(&.{ &.{1}, &.{1}, &.{1} }));
+    try std.testing.expect(!allSaid(&.{ &.{1}, &.{0}, &.{1} }));
+    try std.testing.expect(!allSaid(&.{ &.{1}, &.{}, &.{1} }));
+    try std.testing.expect(!allSaid(&.{ &.{1}, &.{ 1, 1 }, &.{1} }));
+}
+
+const VoteTest = struct {
+    var vars: [8][2][]const u8 = undefined;
+    var n: usize = 0;
+
+    fn get(name: []const u8) ?[]const u8 {
+        for (vars[0..n]) |kv| if (std.mem.eql(u8, kv[0], name)) return kv[1];
+        return null;
+    }
+
+    fn env(list: []const [2][]const u8) Get {
+        @memcpy(vars[0..list.len], list);
+        n = list.len;
+        return &get;
+    }
+
+    const release = [_][2][]const u8{ .{ "TF_INK2_ROCE_MULTI", "1" }, .{ "TF_TP_MAILBOX_MAX_KB", "640" }, .{ "TF_TP_PORT", "29640" }, .{ "TF_TP_MASTER", "198.51.100.1" }, .{ "TF_TP_KERNEL_IMAGE", "/x/tp_mailbox.fatbin" } };
+    const image: Image = .{ .digest = @splat(0x5a) };
+
+    /// Four ballots: the release settings, with rank `odd`'s environment and image replaced.
+    fn four(odd: usize, odd_env: []const [2][]const u8, odd_image: Image) [4]Vote {
+        var out: [4]Vote = undefined;
+        for (&out, 0..) |*v, r| v.* = if (r == odd) ballot(env(odd_env), 4, r, true, odd_image) else ballot(env(&release), 4, r, true, image);
+        return out;
+    }
+};
+
+test "inkling2 transport vote: the release settings alike on four ranks agree" {
+    const all = VoteTest.four(9, &.{}, .unset);
+    for (&all) |*v| try std.testing.expect(judge(&all, v) == .agreed);
+    try std.testing.expectEqualStrings("on", all[0].value(.multi));
+    try std.testing.expectEqualStrings("off", all[0].value(.roce));
+    try std.testing.expectEqualStrings("640", all[0].value(.mailbox_kb));
+    try std.testing.expectEqualStrings("29640/29647", all[0].value(.port));
+    try std.testing.expectEqualStrings("5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a5a...", all[0].value(.image)); // all 32 bytes compared, shown cut
+}
+
+test "inkling2 transport vote: TF_ROCE on one follower only is refused on every rank, naming TF_ROCE" {
+    const odd = VoteTest.release ++ [_][2][]const u8{.{ "TF_ROCE", "1" }};
+    const all = VoteTest.four(1, &odd, VoteTest.image);
+    for (&all) |*v| {
+        const verdict = judge(&all, v);
+        try std.testing.expect(verdict == .differs);
+        try std.testing.expectEqual(Setting.roce, verdict.differs.setting.?);
+    }
+    try std.testing.expectEqualStrings("1", all[1].value(.roce));
+    try std.testing.expectEqualStrings("512", all[1].value(.roce_max_kb));
+    // the mesh off everywhere: the same refusal
+    const plain = [_][2][]const u8{.{ "TF_ROCE", "1" }};
+    var off: [4]Vote = undefined;
+    for (&off, 0..) |*v, r| v.* = ballot(VoteTest.env(if (r == 2) &plain else &.{}), 4, r, true, .unset);
+    try std.testing.expectEqual(Setting.roce, judge(&off, &off[0]).differs.setting.?);
+}
+
+test "inkling2 transport vote: one rank without TF_INK2_ROCE_MULTI is refused, naming it" {
+    const all = VoteTest.four(3, &.{}, .unset);
+    for (&all) |*v| try std.testing.expectEqual(Setting.multi, judge(&all, v).differs.setting.?);
+    try std.testing.expectEqualStrings("off", all[3].value(.multi));
+}
+
+test "inkling2 transport vote: a missing, unreadable, empty or different kernel image on one rank stops every rank" {
+    var all = VoteTest.four(2, &VoteTest.release, .{ .failed = "FileNotFound" });
+    for (&all) |*v| try std.testing.expectEqual(@as(usize, 2), judge(&all, v).not_ready);
+    try std.testing.expectEqualStrings("TF_TP_KERNEL_IMAGE=/x/tp_mailbox.fatbin: FileNotFound", all[2].reason());
+    all = VoteTest.four(0, &VoteTest.release, .empty);
+    try std.testing.expectEqual(@as(usize, 0), judge(&all, &all[3]).not_ready);
+    all = VoteTest.four(1, VoteTest.release[0..4], .unset); // TF_TP_KERNEL_IMAGE unset
+    try std.testing.expectEqual(@as(usize, 1), judge(&all, &all[0]).not_ready);
+    all = VoteTest.four(3, &VoteTest.release, .{ .digest = @splat(0x11) });
+    try std.testing.expectEqual(Setting.image, judge(&all, &all[0]).differs.setting.?);
+}
+
+test "inkling2 transport vote: a different TF_TP_MAILBOX_MAX_KB, an invalid TF_TP_* value or TF_ROCE_MAX_KB is caught" {
+    var odd = VoteTest.release;
+    odd[1] = .{ "TF_TP_MAILBOX_MAX_KB", "512" };
+    var all = VoteTest.four(1, &odd, VoteTest.image);
+    try std.testing.expectEqual(Setting.mailbox_kb, judge(&all, &all[0]).differs.setting.?);
+    odd[1] = .{ "TF_TP_MAILBOX_MAX_KB", "lots" };
+    all = VoteTest.four(1, &odd, VoteTest.image);
+    try std.testing.expectEqual(@as(usize, 1), judge(&all, &all[0]).not_ready);
+    const bad = [_][2][]const u8{ .{ "TF_ROCE", "1" }, .{ "TF_ROCE_MAX_KB", "x" } };
+    var r: [2]Vote = .{ ballot(VoteTest.env(&bad), 2, 0, true, .unset), undefined };
+    r[1] = ballot(VoteTest.env(&bad), 2, 1, true, .unset);
+    try std.testing.expectEqual(@as(usize, 0), judge(&r, &r[1]).not_ready);
+}
+
+test "inkling2 transport vote: long values are compared whole: two master names alike in their first 36 bytes differ" {
+    const prefix = "inkling2-rank-zero.a-long-subdomain."; // 36 bytes: what a cut value shows
+    comptime std.debug.assert(prefix.len == 36);
+    var a = VoteTest.release;
+    var b = VoteTest.release;
+    a[3] = .{ "TF_TP_MASTER", prefix ++ "lab-one.example.internal" };
+    b[3] = .{ "TF_TP_MASTER", prefix ++ "lab-two.example.internal" };
+    var all: [4]Vote = undefined;
+    for (&all, 0..) |*v, r| v.* = ballot(VoteTest.env(if (r == 3) &b else &a), 4, r, true, VoteTest.image);
+    try std.testing.expectEqualStrings(all[0].value(.master), all[3].value(.master)); // shown alike, cut
+    try std.testing.expectEqualStrings(prefix ++ "...", all[3].value(.master)[0 .. prefix.len + 3]);
+    for (&all) |*v| {
+        const verdict = judge(&all, v);
+        try std.testing.expect(verdict == .differs);
+        try std.testing.expectEqual(Setting.master, verdict.differs.setting.?);
+    }
+    // the same long name on every rank agrees
+    for (&all, 0..) |*v, r| v.* = ballot(VoteTest.env(&a), 4, r, true, VoteTest.image);
+    for (&all) |*v| try std.testing.expect(judge(&all, v) == .agreed);
+    // any other setting alike in its shown form but not whole: TF_ROCE's value
+    const xs: [40]u8 = @splat('x');
+    const r1 = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs ++ "a" }};
+    const r2 = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs ++ "b" }};
+    var two: [2]Vote = .{ ballot(VoteTest.env(&r1), 2, 0, true, .unset), undefined };
+    two[1] = ballot(VoteTest.env(&r2), 2, 1, true, .unset);
+    try std.testing.expectEqualStrings(two[0].value(.roce), two[1].value(.roce));
+    try std.testing.expectEqual(Setting.roce, judge(&two, &two[0]).differs.setting.?);
+}
+
+test "inkling2 transport vote: a value longer than any valid one is refused, not compared by a prefix" {
+    const xs: [1100]u8 = @splat('x');
+    const huge = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs }};
+    const v = ballot(VoteTest.env(&huge), 2, 0, true, .unset);
+    try std.testing.expect(v.ready == 0);
+    try std.testing.expectEqualStrings("TF_ROCE is longer than 1024 bytes", v.reason());
+}
+
+test "inkling2 transport vote: under three ranks or off Linux the mesh setting reads off, and a place mismatch is caught" {
+    const two = ballot(VoteTest.env(&VoteTest.release), 2, 0, true, .unset);
+    try std.testing.expectEqualStrings("off", two.value(.multi));
+    try std.testing.expect(two.ready == 1);
+    const mac = ballot(VoteTest.env(&VoteTest.release), 4, 0, false, .unset);
+    try std.testing.expectEqualStrings("off", mac.value(.multi));
+    var all = VoteTest.four(9, &.{}, .unset);
+    all[2].rank = 1;
+    try std.testing.expect(judge(&all, &all[0]).differs.setting == null);
+}
diff --git a/zig/src/families/inkling2/cuda_xrows.zig b/zig/src/families/inkling2/cuda_xrows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..76fec37f7cf1fde88842d1f813b3f7490e5e7597
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_xrows.zig
@@ -0,0 +1,107 @@
+//! W > 1, prompt chunks: a layer's rank-order sum (cuda_tp.zig) by rows instead of whole. Rank r owns rows
+//! [r*S, r*S + n_r) of the forward (S = ceil(R / W)); every rank sends each other rank that rank's rows of its fp32
+//! partial (one NCCL send/recv group), sums its own rows over the ranks in rank order (res.rankSumRows: the same adds
+//! in the same order as res.rankSum, so every row's bits are those of the whole sum), and the bf16 rows are
+//! all-gathered in rank order, S rows a rank, straight into the sum's output (rows R .. W*S - 1 of it are scratch).
+//!
+//! Bytes a rank receives for one sum: (W-1) * S * H * 4 + (W-1) * S * H * 2, against (W-1) * R * H * 4 for the
+//! all-gather of whole partials: at W = 4 and 2048 rows 28.3 + 14.2 MB against 113 MB (2.7x less); at W = 2,
+//! 18.9 + 9.4 against 37.7 (1.3x less). Decode-sized forwards keep the whole all-gather (one collective, no
+//! send/recv group): below `min_rows`.
+//!
+//! Opt-in (TF_INK2_XROWS=1): the send/recv group connects every pair of ranks, which a switch carries but the
+//! four-Spark switchless ring does not (its non-neighbours have no direct route; NCCL's own collectives follow the
+//! ring). The bits are the same either way, but the NCCL calls are not: set it on every rank or none. At W = 2
+//! over PCIe on one host it gains nothing (1.33x fewer bytes against a second collective); the Sparks at W = 4 on a
+//! switch are where it is meant to pay.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const res = @import("cuda_res.zig");
+const tp = @import("cuda_tp.zig");
+const weights = @import("cuda_weights.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+
+/// The fewest rows a forward sums by rows.
+pub const min_rows = 64;
+
+var enabled: ?bool = null;
+
+/// TF_INK2_XROWS=1: prompt chunks sum by rows (see the header); unset or 0, the whole all-gather at every row count.
+pub fn wanted() bool {
+    if (enabled == null) enabled = if (std.c.getenv("TF_INK2_XROWS")) |v| v[0] == '1' else false;
+    return enabled.?;
+}
+
+/// Rows a rank owns of a forward of R rows: S = ceil(R / W) each, the last ranks fewer (or none).
+pub fn share(R: usize, world: usize, rank: usize) [2]usize {
+    const S = (R + world - 1) / world;
+    const lo = @min(R, rank * S);
+    return .{ lo, @min(R, lo + S) };
+}
+
+/// Whether a forward of R rows sums by rows: real ranks, R >= min_rows, and the output holds W * S rows.
+pub fn applies(x: *const tp.Exchange, R: usize, out_rows: usize) bool {
+    if (x.group == null or x.world < 2 or R < min_rows or R > x.parts.cap or !wanted()) return false;
+    const S = (R + x.world - 1) / x.world;
+    return S * x.world <= out_rows;
+}
+
+/// Sum `s` of a forward of R rows (fp32 partials) into `out` (bf16, at least W * S rows from row 0; rows 0 .. R - 1
+/// get the sum). Every rank's partial is in its slot of the sum's buffer (tp.Exchange.mine), not yet gathered.
+pub fn sum(x: *const tp.Exchange, c: *const Ctx, s: tp.Sum, R: usize, out: Mat) !void {
+    if (!tp.Timing.enabled()) return run(x, c, s, R, out);
+    try c.stream.synchronize();
+    const t = tp.Timing.now();
+    try run(x, c, s, R, out);
+    try c.stream.synchronize();
+    tp.Timing.ns[@intFromEnum(s)] += tp.Timing.now() - t;
+    tp.Timing.calls[@intFromEnum(s)] += 1;
+}
+
+fn run(x: *const tp.Exchange, c: *const Ctx, s: tp.Sum, R: usize, out: Mat) !void {
+    const g = x.group orelse return error.NoGroup;
+    const W: usize = x.world;
+    const r: usize = x.rank;
+    const S = (R + W - 1) / W;
+    if (!out.is(out.rows, H, .bf16) or !out.dense() or out.rows < W * S) return error.BadExchangeShape;
+    const row = H * 4;
+    const base = x.parts.ptr[@intFromEnum(s)];
+    const slot = R * row; // rank q's partial [R][H] at base + q * slot (tp.Exchange.mine)
+    const own = share(R, W, r);
+    // rank q's rows of this rank's partial to q; this rank's rows of q's partial into q's slot, at their own rows
+    try g.lib.check(g.lib.api.ncclGroupStart(), "ncclGroupStart");
+    const posted: anyerror!void = post: {
+        for (0..W) |q| {
+            if (q == r) continue;
+            const theirs = share(R, W, q);
+            if (theirs[1] > theirs[0]) g.send(c.stream, base + r * slot + theirs[0] * row, (theirs[1] - theirs[0]) * row, q) catch |e| break :post e;
+            if (own[1] > own[0]) g.recv(c.stream, base + q * slot + own[0] * row, (own[1] - own[0]) * row, q) catch |e| break :post e;
+        }
+        break :post {};
+    };
+    try g.lib.check(g.lib.api.ncclGroupEnd(), "ncclGroupEnd"); // the group closes on every path
+    try posted;
+    if (own[1] > own[0]) try res.rankSumRows(c, base + own[0] * row, W, slot, out.slice(own[0], own[1] - own[0]));
+    // every rank's S rows (the last ranks' padded with scratch rows) into out in rank order
+    try g.allGather(c.stream, out.row(r * S), out.ptr, S * H * 2);
+}
+
+test "inkling2 cuda xrows: shares" {
+    try std.testing.expectEqual([2]usize{ 0, 512 }, share(2048, 4, 0));
+    try std.testing.expectEqual([2]usize{ 1536, 2048 }, share(2048, 4, 3));
+    // 1967 rows: 492 a rank, the last 491
+    try std.testing.expectEqual([2]usize{ 984, 1476 }, share(1967, 4, 2));
+    try std.testing.expectEqual([2]usize{ 1476, 1967 }, share(1967, 4, 3));
+    // 65 rows at W = 4: 17, 17, 17, 14
+    try std.testing.expectEqual([2]usize{ 51, 65 }, share(65, 4, 3));
+    var n: usize = 0;
+    for (0..4) |q| {
+        const x = share(1967, 4, q);
+        n += x[1] - x[0];
+    }
+    try std.testing.expectEqual(@as(usize, 1967), n);
+}
diff --git a/zig/src/families/inkling2/describe.zig b/zig/src/families/inkling2/describe.zig
new file mode 100644
index 0000000000000000000000000000000000000000..106becab81cc96b7f3d09127801aa889f5f8c145
--- /dev/null
+++ b/zig/src/families/inkling2/describe.zig
@@ -0,0 +1,167 @@
+//! The checkpoint read as one plan: config, manifest, inventory, roles and a rank split checked together, and the
+//! per-rank memory table and byte ranges printed from it (tf-inkling2-plan, and the native host's refusal).
+const std = @import("std");
+const config = @import("config.zig");
+const quant = @import("quant.zig");
+const inventory = @import("inventory.zig");
+const roles_mod = @import("roles.zig");
+const plan = @import("plan.zig");
+const Diag = @import("diag.zig").Diag;
+
+pub const gib: f64 = 1 << 30;
+
+/// Everything read and checked for one split.
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    c: config.Config,
+    m: quant.Manifest,
+    inv: inventory.Inventory,
+    roles: []roles_mod.Role,
+    p: plan.Plan,
+    cov: plan.Coverage,
+
+    /// From the three texts (config.json, hf_quant_config.json, the inventory's text form).
+    pub fn fromTexts(gpa: std.mem.Allocator, config_json: []const u8, quant_json: []const u8, inventory_text: []const u8, split: Want, d: ?*Diag) !Model {
+        const c = try config.parse(gpa, config_json, d);
+        var m = try quant.parse(gpa, quant_json, d);
+        errdefer m.deinit();
+        var inv = try inventory.Inventory.fromText(gpa, inventory_text, d);
+        errdefer inv.deinit();
+        return finish(gpa, c, m, inv, split, d);
+    }
+
+    /// From a checkpoint folder: its config.json, hf_quant_config.json and safetensors headers.
+    pub fn fromDir(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, split: Want, d: ?*Diag) !Model {
+        const c = try config.Config.read(gpa, io, dir, d);
+        var m = try quant.Manifest.read(gpa, io, dir, d);
+        errdefer m.deinit();
+        var inv = try inventory.Inventory.fromDir(gpa, io, dir, d);
+        errdefer inv.deinit();
+        return finish(gpa, c, m, inv, split, d);
+    }
+
+    fn finish(gpa: std.mem.Allocator, c: config.Config, m: quant.Manifest, inv: inventory.Inventory, want: Want, d: ?*Diag) !Model {
+        var out: Model = .{ .gpa = gpa, .c = c, .m = m, .inv = inv, .roles = &.{}, .p = undefined, .cov = undefined };
+        out.roles = try roles_mod.classifyAll(gpa, &out.c, &out.m, &out.inv, d);
+        errdefer gpa.free(out.roles);
+        if (want.layout == .split and want.experts.len > 0) return @import("diag.zig").fail(d, error.BadInkling2Split, "split experts take a world size, not expert counts", .{});
+        var split = if (want.layout == .split) try plan.Split.sliced(&out.c, want.world, d) else if (want.experts.len > 0) try plan.Split.uneven(&out.c, want.experts, d) else try plan.Split.even(&out.c, want.world, d);
+        if (want.drafter) |r| {
+            if (r >= split.world) return @import("diag.zig").fail(d, error.BadInkling2Split, "drafter rank {d} is not below world size {d}", .{ r, split.world });
+            split.drafter = r;
+        }
+        out.p = try plan.build(gpa, &out.c, &out.inv, out.roles, split);
+        errdefer out.p.deinit();
+        out.cov = try plan.verify(gpa, &out.p, &out.inv, out.roles, d);
+        return out;
+    }
+
+    pub fn deinit(x: *Model) void {
+        x.p.deinit();
+        x.gpa.free(x.roles);
+        x.inv.deinit();
+        x.m.deinit();
+        x.* = undefined;
+    }
+
+    /// Bytes of keys and values one position takes on rank `r` across the global layers (the paged pool).
+    pub fn kvPerPosition(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        return @as(u64, t.globalCount()) * 2 * x.p.ranks[r].kv.len() * t.head_dim * 2;
+    }
+
+    /// Bytes of the sliding layers' key and value rings for one stream on rank `r` (a full window each).
+    pub fn windowPerStream(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        return @as(u64, t.layers - t.globalCount()) * t.window * 2 * x.p.ranks[r].kv.len() * t.swa_head_dim * 2;
+    }
+
+    /// Bytes of one stream's convolution state on rank `r`: 3 rows of the four convolutions a layer, in fp32.
+    pub fn convPerStream(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        const kv = @as(u64, x.p.ranks[r].kv.len()) * t.head_dim;
+        return @as(u64, t.layers) * (t.conv_taps - 1) * (2 * @as(u64, t.hidden) + 2 * kv) * 4;
+    }
+};
+
+/// The split a caller asks for: a world size (even experts), or explicit expert counts; the drafter's rank.
+pub const Want = struct {
+    world: u32 = 4,
+    experts: []const u32 = &.{},
+    drafter: ?u32 = null,
+    /// Whole experts a rank, or a 1/W row slice of every expert on every rank (plan.zig `Layout`).
+    layout: plan.Layout = .whole,
+};
+
+fn g(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / gib;
+}
+
+/// The per-rank memory table, as the plan's section 2 gives it.
+pub fn report(w: *std.Io.Writer, x: *const Model, positions: u64, streams: u64) !void {
+    const t = &x.c.text;
+    const s = x.p.split;
+    try w.print("Inkling-2-Small: {d} layers ({d} global), {d} experts ({d} a token), {d} tensors in {d} files, {d:.1} GiB\n", .{ t.layers, t.globalCount(), t.experts, t.topk, x.inv.tensors.len, x.inv.files.len, g(x.cov.total) });
+    if (x.c.unknown > 0) try w.print("config.json: {d} keys not known to this parser (first: {s})\n", .{ x.c.unknown, x.c.firstUnknown() });
+    try w.print("world {d}: experts", .{s.world});
+    if (s.layout == .split) try w.print(" split (all {d} on every rank, a 1/{d} row slice of each)", .{ t.experts, s.world }) else for (s.experts[0..s.world], 0..) |n, i| try w.print("{s}{d}", .{ if (i == 0) " " else "/", n });
+    try w.print("; drafter on rank {d}; coverage: every byte on one rank, {d:.2} GiB replicated on all\n\n", .{ s.drafter, g(x.cov.replicated) });
+    try w.writeAll("rank  q heads  kv heads  experts    | experts  attention  replicated  embed+unembed  vision  drafter | weights  KV pool  total GiB\n");
+    for (x.p.ranks) |r| {
+        const b = r.bytes;
+        const pool = x.kvPerPosition(r.rank) * positions;
+        try w.print("{d:>4}  {d:>2}-{d:<2}    {d}-{d}       {d:>3}-{d:<3}    | {d:>7.1}  {d:>9.1}  {d:>10.1}  {d:>13.1}  {d:>6.1}  {d:>7.1} | {d:>7.1}  {d:>7.1}  {d:>9.1}\n", .{
+            r.rank,                                 r.q.lo,                                  r.q.hi - 1,                               r.kv.lo,                                    r.kv.hi - 1,
+            r.experts.lo,                           r.experts.hi - 1,                        g(b[@backingInt(plan.Category.experts)]), g(b[@backingInt(plan.Category.attention)]), g(b[@backingInt(plan.Category.replicated)]),
+            g(b[@backingInt(plan.Category.embed)]), g(b[@backingInt(plan.Category.vision)]), g(b[@backingInt(plan.Category.drafter)]), g(r.total()),                               g(pool),
+            g(r.total() + pool),
+        });
+    }
+    const r0 = x.p.ranks[0].rank;
+    try w.print("\nKV pool: {d} positions, {d} bytes a position a rank (the {d} global layers' keys and values, bf16)\n", .{ positions, x.kvPerPosition(r0), t.globalCount() });
+    try w.print("per stream, rank 0: sliding-window rings {d:.3} GiB, convolution state {d:.1} MiB; {d} streams: {d:.2} GiB\n", .{
+        g(x.windowPerStream(r0)), @as(f64, @floatFromInt(x.convPerStream(r0))) / (1 << 20), streams, g((x.windowPerStream(r0) + x.convPerStream(r0)) * streams),
+    });
+    try w.writeAll("not counted: scratch, the CUDA context and transport buffers (the plan estimates 3 GiB a rank)\n");
+}
+
+/// Rank `rank`'s byte ranges, one line a tensor: file, absolute offset, run length, stride, runs, tensor name.
+pub fn ranges(w: *std.Io.Writer, x: *const Model, rank: u32) !void {
+    try w.writeAll("# file\toffset\tlen\tstride\tcount\tplacement\ttensor\n");
+    for (x.p.ranks[rank].pieces) |piece| {
+        const t = x.inv.tensors[piece.tensor];
+        const r = piece.run;
+        try w.print("{s}\t{d}\t{d}\t{d}\t{d}\t{t}\t{s}\n", .{ x.inv.files[r.file].name, r.offset, r.len, r.stride, r.count, x.p.split.placed(x.roles[piece.tensor]), t.name });
+    }
+}
+
+test "inkling2 describe: the release's table at W = 4 and its ranges" {
+    var d: Diag = .{};
+    var x = Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .world = 4 }, &d) catch |e| {
+        std.debug.print("{s}\n", .{d.text()});
+        return e;
+    };
+    defer x.deinit();
+    try std.testing.expectEqual(@as(u64, 8192), x.kvPerPosition(0)); // 8.2 KB a token a rank
+    try std.testing.expectEqual(@as(u64, 4 << 30), x.kvPerPosition(0) * 524288);
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+    try report(&out.writer, &x, 524288, 8);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "world 4: experts 96/96/96/96; drafter on rank 3") != null);
+    out.clearRetainingCapacity();
+    try ranges(&out.writer, &x, 1);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "q_cols\tmodel.llm.layers.0.attn.wo_ud.weight") != null);
+    var u = try Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .experts = &.{ 93, 97, 97, 97 }, .drafter = 2 }, null);
+    defer u.deinit();
+    try std.testing.expectEqual(@as(u32, 93), u.p.ranks[0].experts.len());
+    try std.testing.expect(u.p.ranks[2].bytes[@backingInt(plan.Category.drafter)] > 3 << 30);
+    var sp = try Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .world = 4, .layout = .split }, null);
+    defer sp.deinit();
+    out.clearRetainingCapacity();
+    try report(&out.writer, &sp, 524288, 8);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "world 4: experts split (all 384 on every rank, a 1/4 row slice of each)") != null);
+    out.clearRetainingCapacity();
+    try ranges(&out.writer, &sp, 1);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "replicated\tmodel.llm.layers.0.mlp.experts.w13_weight_amax") != null);
+    try std.testing.expectError(error.BadInkling2Split, Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .experts = &.{ 93, 97, 97, 97 }, .layout = .split }, null));
+}
