--- /dev/null
+++ b/zig/src/server/inkling2_reply.zig
@@ -0,0 +1,472 @@
+//! Inkling 2's typed reply parts as reasoning_content, content and tool_calls, whole or streamed in any chunks.
+//!
+//! The grammar is the checkpoint's own (tokenizer_config.json ``response_template`` and chat_template.jinja, released
+//! by Thinking Machines under the Apache License 2.0); no code is copied from them:
+//!
+//!   reply  := part* (``<|content_model_end_sampling|>`` | end of text)
+//!   part   := [``<|message_model|>`` NAME] OPEN BODY ``<|end_message|>``
+//!   OPEN   := ``<|content_thinking|>``                                  -> reasoning_content (joined, not stripped)
+//!           | ``<|content_text|>`` | ``<|content_tool_error|>`` | ``<|content_invoke_tool_text|>`` -> content
+//!           | ``<|content_invoke_tool_json|>`` BODY = {"name": NAME, "args": {...}}       -> one tool call
+//!
+//! Text outside a part is not part of any field, as in Transformers' response-template parser
+//! (utils/chat_parsing/response_parser.py, Apache License 2.0). Beyond it, this reader also: closes a
+//! part a new header or opener interrupts, ends the reply at a user, system or tool header (another speaker's turn),
+//! keeps a part max_tokens cut (its text so far; a cut call's JSON stays text), and keeps a call it cannot use (bad
+//! JSON, no name, arguments that are not an object, a tool the request did not offer) as content text.
+const std = @import("std");
+const json = @import("json");
+const Allocator = std.mem.Allocator;
+
+pub const Marker = enum {
+    message_model,
+    message_user,
+    message_system,
+    message_tool,
+    content_text,
+    content_thinking,
+    content_tool_error,
+    content_invoke_tool_text,
+    content_invoke_tool_json,
+    content_xml,
+    content_image,
+    end_message,
+    content_model_end_sampling,
+    endoftext,
+    begin_of_text,
+
+    /// The marker's spelling, which is also its added token's text.
+    pub fn spelling(m: Marker) []const u8 {
+        return switch (m) {
+            inline else => |tag| "<|" ++ @tagName(tag) ++ "|>",
+        };
+    }
+
+    pub fn of(text: []const u8) ?Marker {
+        if (text.len < 4 or !std.mem.startsWith(u8, text, "<|") or !std.mem.endsWith(u8, text, "|>")) return null;
+        return std.meta.stringToEnum(Marker, text[2 .. text.len - 2]);
+    }
+};
+
+/// What a part's body feeds.
+pub const Kind = enum { text, thinking, tool_json, ignored };
+
+pub fn kindOf(m: Marker) ?Kind {
+    return switch (m) {
+        .content_text, .content_tool_error, .content_invoke_tool_text => .text,
+        .content_thinking => .thinking,
+        .content_invoke_tool_json => .tool_json,
+        .content_xml, .content_image => .ignored,
+        else => null,
+    };
+}
+
+pub const Call = struct { name: []const u8, arguments: []const u8 };
+
+pub const State = union(enum) { outside, header, part: Kind, ended };
+
+pub const Parser = struct {
+    a: Allocator,
+    /// The tool names the request offered; a call to any other name stays text.
+    offered: []const []const u8 = &.{},
+    reasoning: std.ArrayList(u8) = .empty,
+    content: std.ArrayList(u8) = .empty,
+    calls: std.ArrayList(Call) = .empty,
+    /// Tool parts kept as text: bad JSON, no name, non-object arguments, or a tool the request did not offer.
+    rejected: usize = 0,
+    /// Non-space bytes outside every part, which no field takes.
+    stray: usize = 0,
+    state: State = .outside,
+    header: std.ArrayList(u8) = .empty,
+    body: std.ArrayList(u8) = .empty,
+    held: std.ArrayList(u8) = .empty,
+
+    pub fn deinit(p: *Parser) void {
+        inline for (.{ &p.reasoning, &p.content, &p.header, &p.body, &p.held }) |list| list.deinit(p.a);
+        for (p.calls.items) |c| {
+            p.a.free(c.name);
+            p.a.free(c.arguments);
+        }
+        p.calls.deinit(p.a);
+    }
+
+    pub fn ended(p: *const Parser) bool {
+        return p.state == .ended;
+    }
+
+    pub fn thinking(p: *const Parser) bool {
+        return p.state == .part and p.state.part == .thinking;
+    }
+
+    /// Decoded reply text: marker spellings are markers, and one split across chunks is held until it completes.
+    pub fn feedText(p: *Parser, bytes: []const u8) Allocator.Error!void {
+        try p.held.appendSlice(p.a, bytes);
+        const s = p.held.items;
+        var done: usize = 0;
+        var i: usize = 0;
+        var hold: ?usize = null;
+        while (i < s.len) {
+            const lt = std.mem.indexOfScalarPos(u8, s, i, '<') orelse break;
+            const rest = s[lt..];
+            var hit: ?Marker = null;
+            var maybe = false;
+            for (std.enums.values(Marker)) |m| {
+                const w = m.spelling();
+                if (std.mem.startsWith(u8, rest, w)) {
+                    hit = m;
+                    break;
+                }
+                if (rest.len < w.len and std.mem.startsWith(u8, w, rest)) maybe = true;
+            }
+            if (hit) |m| {
+                try p.feedLiteral(s[done..lt]);
+                try p.feedMarker(m);
+                done = lt + m.spelling().len;
+                i = done;
+            } else if (maybe) {
+                hold = lt; // a marker may complete with the next chunk
+                break;
+            } else i = lt + 1;
+        }
+        const keep = hold orelse s.len;
+        try p.feedLiteral(s[done..keep]);
+        const left = s.len - keep;
+        std.mem.copyForwards(u8, p.held.items[0..left], s[keep..]);
+        p.held.items.len = left;
+    }
+
+    /// Bytes that are text whatever they spell (an ordinary token's bytes).
+    pub fn feedLiteral(p: *Parser, bytes: []const u8) Allocator.Error!void {
+        if (bytes.len == 0) return;
+        switch (p.state) {
+            .ended => {},
+            .outside => for (bytes) |b| {
+                p.stray += @intFromBool(std.mem.indexOfScalar(u8, " \t\r\n", b) == null);
+            },
+            .header => try p.header.appendSlice(p.a, bytes),
+            .part => |k| switch (k) {
+                .text => try p.content.appendSlice(p.a, bytes),
+                .thinking => try p.reasoning.appendSlice(p.a, bytes),
+                .tool_json => try p.body.appendSlice(p.a, bytes),
+                .ignored => {},
+            },
+        }
+    }
+
+    /// One marker (an added token, or its spelling in text).
+    pub fn feedMarker(p: *Parser, m: Marker) Allocator.Error!void {
+        if (p.state == .ended) return;
+        if (kindOf(m)) |k| {
+            try p.close();
+            p.state = .{ .part = k };
+            return;
+        }
+        switch (m) {
+            .message_model => {
+                try p.close();
+                p.header.clearRetainingCapacity();
+                p.state = .header;
+            },
+            .end_message => {
+                try p.close();
+                p.state = .outside;
+            },
+            .message_user, .message_system, .message_tool, .content_model_end_sampling, .endoftext => {
+                try p.close();
+                p.state = .ended;
+            },
+            .begin_of_text => {},
+            else => unreachable,
+        }
+    }
+
+    /// The reply's end: a held partial marker is text, and an open tool part stays text.
+    pub fn finish(p: *Parser) Allocator.Error!void {
+        const held = try p.a.dupe(u8, p.held.items);
+        defer p.a.free(held);
+        p.held.clearRetainingCapacity();
+        try p.feedLiteral(held);
+        if (p.state == .part and p.state.part == .tool_json) {
+            try p.content.appendSlice(p.a, p.body.items);
+            p.body.clearRetainingCapacity();
+            p.rejected += 1;
+        }
+        if (p.state != .ended) p.state = .outside;
+    }
+
+    fn close(p: *Parser) Allocator.Error!void {
+        if (p.state == .part and p.state.part == .tool_json) {
+            defer p.body.clearRetainingCapacity();
+            try p.calls.ensureUnusedCapacity(p.a, 1); // a call's owned name and arguments land with no step left to fail
+            if (try p.call(p.body.items)) |c| {
+                p.calls.appendAssumeCapacity(c);
+            } else {
+                try p.content.appendSlice(p.a, p.body.items);
+                p.rejected += 1;
+            }
+        }
+        p.state = .outside;
+    }
+
+    /// ``{"name": NAME, "args": {...}}`` as a call to an offered tool, or null.
+    fn call(p: *Parser, body: []const u8) Allocator.Error!?Call {
+        var arena = std.heap.ArenaAllocator.init(p.a);
+        defer arena.deinit();
+        const a = arena.allocator();
+        var fixed: std.ArrayList(u8) = .empty;
+        try @import("tokenizer").unicode.appendLossy(&fixed, a, body);
+        const value = switch (try json.parseText(a, fixed.items)) {
+            .ok => |v| v,
+            .err => return null,
+        };
+        if (value != .object) return null;
+        const name = value.strField("name") orelse return null;
+        const known = for (p.offered) |o| {
+            if (std.mem.eql(u8, o, name)) break true;
+        } else false;
+        if (!known) return null;
+        const args: Value = value.get("args") orelse .null;
+        const object: Value = switch (args) {
+            .null => .{ .object = try json.newObject(a) },
+            .object => args,
+            else => return null,
+        };
+        const text = try json.stringify(a, object, .{ .ascii = false, .compact = true });
+        const owned_name = try p.a.dupe(u8, name);
+        errdefer p.a.free(owned_name);
+        return .{ .name = owned_name, .arguments = try p.a.dupe(u8, text) };
+    }
+};
+
+const Value = json.Value;
+
+/// A whole reply's text, parsed at once.
+pub fn parseText(a: Allocator, text: []const u8, offered: []const []const u8) Allocator.Error!Parser {
+    var p: Parser = .{ .a = a, .offered = offered };
+    errdefer p.deinit();
+    try p.feedText(text);
+    try p.finish();
+    return p;
+}
+
+/// The thinking-effort the template hears: thinking off is ``none`` (its ``0`` line); on, the request's effort or the
+/// template's own default (0.9) when the request names none.
+pub fn templateEffort(thinking: bool, effort: ?[]const u8) ?[]const u8 {
+    if (!thinking) return "none";
+    return effort;
+}
+
+/// The refusal for image, audio and video parts until Inkling 2's vision tower runs in this engine.
+pub const image_refusal = "Inkling 2 image input needs its vision tower, which this engine does not run yet; send text only";
+
+/// The token ids that end a reply besides config.json's EOS (200006): another speaker's header or the text end.
+pub const extra_stops = [_]Marker{ .endoftext, .message_user, .message_system, .message_tool };
+
+/// Whether a template is Inkling 2's: its typed openers and the numeric thinking-effort line.
+pub fn isTemplate(source: []const u8) bool {
+    return std.mem.indexOf(u8, source, "<|content_invoke_tool_json|>") != null and
+        std.mem.indexOf(u8, source, "Thinking effort level: ") != null;
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// tests
+
+const t = std.testing;
+
+fn expectParsed(p: *const Parser, reasoning: []const u8, content: []const u8, calls: []const [2][]const u8) !void {
+    try t.expectEqualStrings(reasoning, p.reasoning.items);
+    try t.expectEqualStrings(content, p.content.items);
+    try t.expectEqual(calls.len, p.calls.items.len);
+    for (calls, p.calls.items) |want, got| {
+        try t.expectEqualStrings(want[0], got.name);
+        try t.expectEqualStrings(want[1], got.arguments);
+    }
+}
+
+const tools = [_][]const u8{ "weather", "search" };
+
+const sample = "<|message_model|><|content_thinking|>Need the weather <tool> in two cities.\n<|end_message|>" ++
+    "<|message_model|><|content_text|>Checking both.<|end_message|>" ++
+    "<|message_model|>weather<|content_invoke_tool_json|>{\"name\":\"weather\",\"args\":{\"city\":\"K\u{f8}benhavn\"}}<|end_message|>" ++
+    "<|message_model|>weather<|content_invoke_tool_json|>{\"name\":\"weather\",\"args\":{\"city\":\"Tokyo\",\"days\":[1,2]}}<|end_message|>" ++
+    "<|content_model_end_sampling|>ignored after the end";
+
+test "Inkling 2 reply: thinking, text and two tool calls from one whole reply" {
+    var p = try parseText(t.allocator, sample, &tools);
+    defer p.deinit();
+    try expectParsed(&p, "Need the weather <tool> in two cities.\n", "Checking both.", &.{
+        .{ "weather", "{\"city\":\"K\u{f8}benhavn\"}" },
+        .{ "weather", "{\"city\":\"Tokyo\",\"days\":[1,2]}" },
+    });
+    try t.expect(p.ended());
+    try t.expectEqual(@as(usize, 0), p.rejected);
+}
+
+fn chunked(a: Allocator, text: []const u8, seed: u64, max: usize, strict: bool) !Parser {
+    var rng = std.Random.DefaultPrng.init(seed);
+    const r = rng.random();
+    var p: Parser = .{ .a = a, .offered = &tools };
+    errdefer p.deinit();
+    var at: usize = 0;
+    var last_reasoning: usize = 0;
+    var last_content: usize = 0;
+    while (at < text.len) {
+        const n = @min(text.len - at, 1 + r.uintLessThan(usize, max));
+        try p.feedText(text[at .. at + n]);
+        at += n;
+        // append-only: what a stream has shown never changes
+        try t.expect(p.reasoning.items.len >= last_reasoning and p.content.items.len >= last_content);
+        last_reasoning = p.reasoning.items.len;
+        last_content = p.content.items.len;
+        // no held marker byte ever reaches a field
+        if (strict) try t.expect(std.mem.indexOf(u8, p.content.items, "<|") == null);
+    }
+    try p.finish();
+    return p;
+}
+
+test "Inkling 2 reply: random chunks, single bytes included, equal the whole reply" {
+    var whole = try parseText(t.allocator, sample, &tools);
+    defer whole.deinit();
+    for (0..400) |seed| {
+        var p = try chunked(t.allocator, sample, seed, if (seed % 4 == 0) 1 else 1 + seed % 23, true);
+        defer p.deinit();
+        try expectParsed(&p, whole.reasoning.items, whole.content.items, &.{
+            .{ whole.calls.items[0].name, whole.calls.items[0].arguments },
+            .{ whole.calls.items[1].name, whole.calls.items[1].arguments },
+        });
+    }
+}
+
+test "Inkling 2 reply: random replies of markers, near-markers and JSON parse the same in any chunks" {
+    const pieces = [_][]const u8{
+        "<|message_model|>", "<|content_text|>", "<|content_thinking|>", "<|end_message|>", "<|content_invoke_tool_json|>",
+        "<|content_tool_error|>", "<|content_xml|>", "<|message_tool|>", "<|content_model_end_sampling|>", "weather",
+        "{\"name\":\"weather\",\"args\":{\"city\":\"Oslo\"}}", "{\"name\":\"search\"}", "{\"name\":", "<", "<|", "<|end_",
+        "<|content_", "|>", "a b", " ", "\n", "\u{e9}\u{4e16}\u{1f600}", "<b>", "<|x|>", "1 < 2", "|",
+    };
+    var rng = std.Random.DefaultPrng.init(20261112);
+    const r = rng.random();
+    var text: std.ArrayList(u8) = .empty;
+    defer text.deinit(t.allocator);
+    for (0..300) |round| {
+        text.clearRetainingCapacity();
+        for (0..r.uintLessThan(usize, 40)) |_| try text.appendSlice(t.allocator, pieces[r.uintLessThan(usize, pieces.len)]);
+        var whole = try parseText(t.allocator, text.items, &tools);
+        defer whole.deinit();
+        for (0..4) |k| {
+            var p = try chunked(t.allocator, text.items, round * 4 + k, if (k == 0) 1 else 1 + r.uintLessThan(usize, 30), false);
+            defer p.deinit();
+            try t.expectEqualStrings(whole.reasoning.items, p.reasoning.items);
+            try t.expectEqualStrings(whole.content.items, p.content.items);
+            try t.expectEqual(whole.calls.items.len, p.calls.items.len);
+            for (whole.calls.items, p.calls.items) |x, y| {
+                try t.expectEqualStrings(x.name, y.name);
+                try t.expectEqualStrings(x.arguments, y.arguments);
+            }
+            try t.expectEqual(whole.rejected, p.rejected);
+            try t.expectEqual(whole.stray, p.stray);
+        }
+    }
+}
+
+test "Inkling 2 reply: markers as tokens equal markers as text" {
+    var p: Parser = .{ .a = t.allocator, .offered = &tools };
+    defer p.deinit();
+    // the same reply as a token stream would deliver it: added tokens as markers, ordinary tokens' bytes split anywhere
+    var rest: []const u8 = sample;
+    while (rest.len > 0) {
+        if (std.mem.indexOf(u8, rest, "<|")) |at| {
+            for (rest[0..at]) |b| try p.feedLiteral(&.{b});
+            const end = std.mem.indexOfPos(u8, rest, at, "|>").? + 2;
+            try p.feedMarker(Marker.of(rest[at..end]).?);
+            rest = rest[end..];
+        } else {
+            try p.feedLiteral(rest);
+            rest = "";
+        }
+    }
+    try p.finish();
+    var whole = try parseText(t.allocator, sample, &tools);
+    defer whole.deinit();
+    try t.expectEqualStrings(whole.reasoning.items, p.reasoning.items);
+    try t.expectEqualStrings(whole.content.items, p.content.items);
+    try t.expectEqual(whole.calls.items.len, p.calls.items.len);
+}
+
+test "Inkling 2 reply: a marker spelled by ordinary tokens stays text" {
+    var p: Parser = .{ .a = t.allocator };
+    defer p.deinit();
+    try p.feedMarker(.message_model);
+    try p.feedMarker(.content_text);
+    try p.feedLiteral("quote: <|end_message|> and <|content_thinking|>");
+    try p.feedMarker(.end_message);
+    try p.finish();
+    try expectParsed(&p, "", "quote: <|end_message|> and <|content_thinking|>", &.{});
+}
+
+test "Inkling 2 reply: unusable calls stay text, partial JSON waits, a cut call is text" {
+    const bad = "<|content_invoke_tool_json|>{\"name\":\"nope\",\"args\":{}}<|end_message|>" ++
+        "<|content_invoke_tool_json|>{\"name\":\"weather\",\"args\":[1]}<|end_message|>" ++
+        "<|content_invoke_tool_json|>{not json<|end_message|>" ++
+        "<|content_invoke_tool_json|>{\"name\":\"search\"}<|end_message|>";
+    var p = try parseText(t.allocator, bad, &tools);
+    defer p.deinit();
+    try expectParsed(&p, "", "{\"name\":\"nope\",\"args\":{}}{\"name\":\"weather\",\"args\":[1]}{not json", &.{.{ "search", "{}" }});
+    try t.expectEqual(@as(usize, 3), p.rejected);
+    // a call's JSON arrives in pieces and is only a call once its part closes
+    var s: Parser = .{ .a = t.allocator, .offered = &tools };
+    defer s.deinit();
+    try s.feedText("<|message_model|>search<|content_invoke_tool_json|>{\"name\":\"sea");
+    try t.expectEqual(@as(usize, 0), s.calls.items.len);
+    try s.feedText("rch\",\"args\":{\"q\":\"zig\"}}<|end_mes");
+    try t.expectEqual(@as(usize, 0), s.calls.items.len);
+    try s.feedText("sage|>");
+    try expectParsed(&s, "", "", &.{.{ "search", "{\"q\":\"zig\"}" }});
+    // max_tokens cut a call: its JSON so far is text, as the shared parser keeps an unclosed envelope
+    var cut = try parseText(t.allocator, "<|content_text|>Hi<|end_message|><|content_invoke_tool_json|>{\"name\":\"we", &tools);
+    defer cut.deinit();
+    try expectParsed(&cut, "", "Hi{\"name\":\"we", &.{});
+}
+
+test "Inkling 2 reply: interrupted parts, other speakers, stray text and a trailing partial marker" {
+    var p = try parseText(t.allocator, "stray<|content_thinking|>a<|content_text|>b<|message_model|>x<|content_thinking|>c<|end_message|>" ++
+        "<|message_user|><|content_text|>not ours<|end_message|>", &tools);
+    defer p.deinit();
+    try expectParsed(&p, "ac", "b", &.{});
+    try t.expectEqual(@as(usize, 5), p.stray);
+    try t.expect(p.ended());
+    // a reply max_tokens cut inside a marker's spelling keeps those bytes as text
+    var q: Parser = .{ .a = t.allocator };
+    defer q.deinit();
+    try q.feedText("<|content_text|>a <|end_");
+    try t.expectEqualStrings("a ", q.content.items);
+    try q.finish();
+    try t.expectEqualStrings("a <|end_", q.content.items);
+    // a '<' that cannot start a marker is text at once
+    var r: Parser = .{ .a = t.allocator };
+    defer r.deinit();
+    try r.feedText("<|content_text|>1 < 2 <b> <|x|> <");
+    try t.expectEqualStrings("1 < 2 <b> <|x|> ", r.content.items);
+}
+
+fn parseSample(a: Allocator) !void {
+    var p = try parseText(a, sample, &tools);
+    defer p.deinit();
+    try t.expectEqual(@as(usize, 2), p.calls.items.len);
+}
+
+test "Inkling 2 reply: every allocation failure frees what the parse held, calls included" {
+    try t.checkAllAllocationFailures(t.allocator, parseSample, .{});
+}
+
+test "Inkling 2 reply: the effort the template hears and the template probe" {
+    try t.expectEqualStrings("none", templateEffort(false, "high").?);
+    try t.expectEqualStrings("none", templateEffort(false, null).?);
+    try t.expectEqualStrings("low", templateEffort(true, "low").?);
+    try t.expectEqual(@as(?[]const u8, null), templateEffort(true, null));
+    try t.expect(isTemplate("<|content_invoke_tool_json|> ... Thinking effort level: "));
+    try t.expect(!isTemplate("<|im_start|>"));
+    try t.expectEqual(Marker.end_message, Marker.of("<|end_message|>").?);
+    try t.expectEqual(@as(?Marker, null), Marker.of("<|unused_200054|>"));
+}
diff --git a/zig/src/server/inkling2_text_test.zig b/zig/src/server/inkling2_text_test.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6e80f746f6cfbdd5d1e059fcc20bb08a8e6439d5
--- /dev/null
+++ b/zig/src/server/inkling2_text_test.zig
@@ -0,0 +1,431 @@
+//! Inkling 2's text layer through the real OpenAI handler: typed reply parts, its stops, its effort line, image refusal.
+//! The hermetic cases use a small character tokenizer with Inkling 2's marker ids; with TF_INKLING2_DIR naming a
+//! folder holding the checkpoint's tokenizer.json, tokenizer_config.json, config.json and chat_template.jinja, the
+//! same checks also run on the release files.
+const std = @import("std");
+const api = @import("engine_api");
+const json = @import("json");
+const openai = @import("openai.zig");
+const http = @import("http_conn.zig");
+const HfText = @import("hf_text.zig").HfText;
+const Server = @import("server.zig").Server;
+const parts = @import("inkling2_reply.zig");
+const V = json.Value;
+const t = std.testing;
+
+const Script = struct {
+    a: std.mem.Allocator,
+    ids: []const u32,
+    prompt: []const u32 = &.{},
+    eos: []const u32 = &.{},
+    logprobs: bool = false, // the backend advertises logprobs: token i's row is -(i + 1) / 4
+    fn engine(s: *@This()) api.Engine {
+        return .{ .ctx = s, .vtable = &.{ .info = info, .submit = submit, .cancel = cancel, .status = status, .memory = memory } };
+    }
+    fn info(ptr: *anyopaque) api.Info {
+        const s: *@This() = @ptrCast(@alignCast(ptr));
+        return .{ .context_window = 32768, .reasoning = true, .logprobs = s.logprobs };
+    }
+    fn submit(ptr: *anyopaque, id: api.Id, request: *const api.Request, sink: api.Sink) api.SubmitError!void {
+        const s: *@This() = @ptrCast(@alignCast(ptr));
+        s.prompt = s.a.dupe(u32, request.prompt) catch return error.Busy;
+        s.eos = s.a.dupe(u32, request.eos) catch return error.Busy;
+        sink.event(sink.ctx, id, &.{ .prefilled = 0 });
+        for (s.ids, 0..) |token, i| {
+            if (request.logprobs) |count| {
+                var row: api.LogprobRow = .{ .token = token, .logprob = -@as(f32, @floatFromInt(i + 1)) / 4, .count = count };
+                for (0..count) |k| {
+                    row.ids[k] = token;
+                    row.logprobs[k] = row.logprob;
+                }
+                sink.event(sink.ctx, id, &.{ .logprobs = &.{row} });
+            }
+            sink.event(sink.ctx, id, &.{ .tokens = &.{token} });
+        }
+        sink.event(sink.ctx, id, &.{ .finished = .{ .reason = .stop } });
+    }
+    fn cancel(_: *anyopaque, _: api.Id) void {}
+    fn status(_: *anyopaque, out: *api.Status, _: []u32) void {
+        out.* = .{};
+    }
+    fn memory(_: *anyopaque, _: bool) ?api.Memory {
+        return null;
+    }
+};
+
+const Receipt = struct {
+    a: std.mem.Allocator,
+    code: u16 = 0,
+    body: V = .null,
+    events: std.ArrayList(V) = .empty,
+    fn out(r: *@This()) openai.Out {
+        return .{ .ctx = r, .vt = &.{ .open = begin, .event = event, .reply = whole } };
+    }
+    fn begin(ptr: *anyopaque, _: usize) error{Closed}!void {
+        const r: *@This() = @ptrCast(@alignCast(ptr));
+        r.code = 200;
+    }
+    fn event(ptr: *anyopaque, value: ?V) error{Closed}!void {
+        const r: *@This() = @ptrCast(@alignCast(ptr));
+        if (value) |v| r.events.append(r.a, v) catch return error.Closed;
+    }
+    fn whole(ptr: *anyopaque, code: u16, value: V) void {
+        const r: *@This() = @ptrCast(@alignCast(ptr));
+        r.code = code;
+        r.body = value;
+    }
+};
+
+/// Inkling 2's added tokens at their release ids.
+const markers = [_]struct { []const u8, u32 }{
+    .{ "<|endoftext|>", 199999 },              .{ "<|message_user|>", 200000 },        .{ "<|message_model|>", 200001 },
+    .{ "<|message_system|>", 200002 },         .{ "<|message_tool|>", 200003 },        .{ "<|content_text|>", 200004 },
+    .{ "<|content_image|>", 200005 },          .{ "<|content_model_end_sampling|>", 200006 }, .{ "<|content_thinking|>", 200008 },
+    .{ "<|end_message|>", 200010 },            .{ "<|content_tool_error|>", 200022 },  .{ "<|content_xml|>", 200024 },
+    .{ "<|begin_of_text|>", 200028 },          .{ "<|content_invoke_tool_json|>", 200049 }, .{ "<|content_invoke_tool_text|>", 200057 },
+};
+
+/// A template that writes the effort it hears where Inkling 2's writes its effort line, and names its typed parts.
+const template =
+    \\{#- <|content_invoke_tool_json|> Thinking effort level: "none" "minimal" "low" "medium" "high" "xhigh" "max" -#}
+    \\{%- for m in messages -%}<|message_user|><|content_text|>{{ m.content }}<|end_message|>{%- endfor -%}
+    \\<|message_system|><|content_text|>effort={{ reasoning_effort if reasoning_effort is defined and reasoning_effort is not none else 'default' }}<|end_message|>
+;
+
+const Fixture = struct {
+    tmp: t.TmpDir,
+    path: []u8,
+
+    fn init(a: std.mem.Allocator) !Fixture {
+        var tok: std.ArrayList(u8) = .empty;
+        try tok.appendSlice(a, "{\"model\":{\"type\":\"BPE\",\"merges\":[],\"vocab\":{\"\\n\":95");
+        for (0x20..0x7f) |c| {
+            try tok.appendSlice(a, ",\"");
+            if (c == '"' or c == '\\') try tok.append(a, '\\');
+            try tok.append(a, @intCast(c));
+            try tok.print(a, "\":{d}", .{c - 0x20});
+        }
+        for (markers) |m| try tok.print(a, ",\"{s}\":{d}", .{ m[0], m[1] });
+        try tok.appendSlice(a, "}},\"decoder\":{\"type\":\"Fuse\"},\"added_tokens\":[");
+        for (markers, 0..) |m, i| try tok.print(a, "{s}{{\"id\":{d},\"content\":\"{s}\",\"special\":true}}", .{ if (i > 0) "," else "", m[1], m[0] });
+        try tok.appendSlice(a, "]}");
+        var tmp = t.tmpDir(.{});
+        errdefer tmp.cleanup();
+        const io = t.io;
+        try tmp.dir.writeFile(io, .{ .sub_path = "tokenizer.json", .data = tok.items });
+        try tmp.dir.writeFile(io, .{ .sub_path = "config.json", .data = "{\"model_type\":\"inkling2\",\"eos_token_id\":200006}" });
+        try tmp.dir.writeFile(io, .{ .sub_path = "tokenizer_config.json", .data = "{}" });
+        try tmp.dir.writeFile(io, .{ .sub_path = "chat_template.jinja", .data = template });
+        return .{ .tmp = tmp, .path = try tmp.dir.realPathFileAlloc(io, ".", a) };
+    }
+};
+
+const reply_text = "<|message_model|><|content_thinking|>Plan: look up both.<|end_message|>" ++
+    "<|message_model|><|content_text|>Checking.<|end_message|>" ++
+    "<|message_model|>weather<|content_invoke_tool_json|>{\"name\":\"weather\",\"args\":{\"city\":\"Oslo\"}}<|end_message|>" ++
+    "<|message_model|>weather<|content_invoke_tool_json|>{\"name\":\"weather\",\"args\":{\"city\":\"Rome\",\"days\":2}}<|end_message|>" ++
+    "<|content_model_end_sampling|>";
+
+const tools_json = "[{\"type\":\"function\",\"function\":{\"name\":\"weather\",\"parameters\":{\"type\":\"object\"}}}]";
+
+const Seen = struct { reasoning: []const u8, content: []const u8, calls: usize, finish: []const u8 };
+
+fn ask(a: std.mem.Allocator, srv: *Server, body_text: []const u8, stream: bool) !struct { Receipt, Seen } {
+    var body = (try json.parse(a, body_text)).ok;
+    if (stream) try body.object.put(a, "stream", .{ .bool = true });
+    var conn = try http.Conn.init(a, -1, "fixture");
+    defer conn.deinit();
+    var r: Receipt = .{ .a = a };
+    openai.run(srv, a, r.out(), .{ .conn = &conn }, true, body);
+    if (r.code != 200) return .{ r, .{ .reasoning = "", .content = "", .calls = 0, .finish = "" } };
+    if (!stream) {
+        const choice = r.body.get("choices").?.array[0];
+        const message = choice.get("message").?;
+        const calls = if (message.get("tool_calls")) |list| list.array.len else 0;
+        if (message.get("tool_calls")) |list| for (list.array) |c| try t.expect(c.strField("id") != null);
+        return .{ r, .{ .reasoning = message.strField("reasoning_content") orelse "", .content = message.strField("content") orelse "", .calls = calls, .finish = choice.strField("finish_reason") orelse "" } };
+    }
+    var content: std.ArrayList(u8) = .empty;
+    var reason: std.ArrayList(u8) = .empty;
+    var calls: usize = 0;
+    var finish: []const u8 = "";
+    for (r.events.items) |event| {
+        const choices = event.get("choices") orelse continue;
+        if (choices.array.len == 0) continue;
+        if (choices.array[0].strField("finish_reason")) |f| finish = f;
+        const delta = choices.array[0].get("delta") orelse continue;
+        if (delta.strField("content")) |s| try content.appendSlice(a, s);
+        if (delta.strField("reasoning_content")) |s| try reason.appendSlice(a, s);
+        if (delta.get("tool_calls")) |list| for (list.array) |c| {
+            if (c.get("function").?.has("name")) calls += 1;
+        };
+    }
+    return .{ r, .{ .reasoning = reason.items, .content = content.items, .calls = calls, .finish = finish } };
+}
+
+fn serve(a: std.mem.Allocator, dir: []const u8, script: *Script) !struct { *HfText, *Server } {
+    var problem: []const u8 = "";
+    const text = HfText.load(t.allocator, t.io, dir, null, a, &problem) catch |e| {
+        std.debug.print("load: {s}\n", .{problem});
+        return e;
+    };
+    errdefer text.deinit();
+    const srv = try Server.init(a, t.io, script.engine(), text.text(), .{ .served_name = "m", .model_ids = &.{"m"}, .enable_thinking = true, .use_drafts = false }, null);
+    return .{ text, srv };
+}
+
+/// The typed reply, whole and streamed one token at a time, and the stops the engine is given.
+fn replyChecks(a: std.mem.Allocator, dir: []const u8) !void {
+    var script: Script = .{ .a = a, .ids = &.{} };
+    const text, const srv = try serve(a, dir, &script);
+    defer text.deinit();
+    defer srv.deinit();
+    try t.expect(text.text().vtable.format == .inkling2);
+    try t.expectEqualSlices(u32, &.{ 200006, 199999, 200000, 200002, 200003 }, srv.eos);
+    try t.expect(srv.info.capability(.thinking_switch) and srv.info.capability(.thinking_applicable));
+    script.ids = try text.text().encode(a, reply_text, false);
+    const body = "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"Weather?\"}],\"max_tokens\":512,\"tools\":" ++ tools_json ++ "}";
+    for ([_]bool{ false, true }) |stream| {
+        _, const seen = try ask(a, srv, body, stream);
+        try t.expectEqualStrings("Plan: look up both.", seen.reasoning);
+        try t.expectEqualStrings("Checking.", seen.content);
+        try t.expectEqual(@as(usize, 2), seen.calls);
+        try t.expectEqualStrings("tool_calls", seen.finish);
+        try t.expectEqualSlices(u32, srv.eos, script.eos);
+    }
+    const whole, _ = try ask(a, srv, body, false);
+    const calls = whole.body.get("choices").?.array[0].get("message").?.get("tool_calls").?.array;
+    try t.expectEqualStrings("weather", calls[1].get("function").?.strField("name").?);
+    try t.expectEqualStrings("{\"city\":\"Rome\",\"days\":2}", calls[1].get("function").?.strField("arguments").?);
+    // without tools the same calls are the request's text, not calls
+    const plain = "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"Weather?\"}],\"max_tokens\":512}";
+    for ([_]bool{ false, true }) |stream| {
+        _, const seen = try ask(a, srv, plain, stream);
+        try t.expectEqual(@as(usize, 0), seen.calls);
+        try t.expect(std.mem.startsWith(u8, seen.content, "Checking.{\"name\":\"weather\""));
+    }
+    // a marker the model spells with ordinary tokens is text
+    script.ids = try text.text().encodePlain(a, "<|content_text|>quoted<|end_message|>");
+    for ([_]bool{ false, true }) |stream| {
+        _, const seen = try ask(a, srv, plain, stream);
+        try t.expectEqualStrings("", seen.content);
+    }
+    script.ids = try std.mem.concat(a, u32, &.{ &.{ 200001, 200004 }, try text.text().encodePlain(a, "a <|end_message|> b"), &.{ 200010, 200006 } });
+    for ([_]bool{ false, true }) |stream| {
+        _, const seen = try ask(a, srv, plain, stream);
+        try t.expectEqualStrings("a <|end_message|> b", seen.content);
+    }
+}
+
+/// A reply's ids: Inkling 2's marker tokens and ordinary text, each piece encoded on its own.
+fn idsOf(a: std.mem.Allocator, text: *HfText, pieces: []const []const u8) ![]const u32 {
+    var out: std.ArrayList(u32) = .empty;
+    for (pieces) |piece| {
+        if (parts.Marker.of(piece)) |m| {
+            try out.append(a, text.text().tokenId(m.spelling()).?);
+        } else try out.appendSlice(a, try text.text().encodePlain(a, piece));
+    }
+    return out.items;
+}
+
+const plain_body = "{\"model\":\"m\",\"messages\":[{\"role\":\"user\",\"content\":\"Hi\"}],\"max_tokens\":512";
+
+/// A stop the generation never saw (it spans two parts' markers) truncates nothing; one inside a part does. (A stop
+/// letter the markers spell, as d in <|end_message|>, ends the reply there, as the generation's stop check does.)
+fn stopChecks(a: std.mem.Allocator, dir: []const u8) !void {
+    var script: Script = .{ .a = a, .ids = &.{} };
+    const text, const srv = try serve(a, dir, &script);
+    defer text.deinit();
+    defer srv.deinit();
+    script.ids = try idsOf(a, text, &.{ "<|message_model|>", "<|content_text|>", "ab", "<|end_message|>", "<|message_model|>", "<|content_text|>", "yz", "<|end_message|>", "<|content_model_end_sampling|>" });
+    const cases = [_][3][]const u8{
+        .{ "[\"by\"]", "abyz", "stop" }, // the reply's text holds ab<|end_message|>...yz: no stop
+        .{ "[\"z\"]", "aby", "stop" },
+        .{ "[\"b<|end_message|>\"]", "a", "stop" },
+    };
+    for (cases) |case| for ([_]bool{ false, true }) |stream| {
+        const body = try std.fmt.allocPrint(a, "{s},\"stop\":{s}}}", .{ plain_body, case[0] });
+        const r, const seen = try ask(a, srv, body, stream);
+        try t.expectEqual(@as(u16, 200), r.code);
+        if (!std.mem.eql(u8, case[1], seen.content)) {
+            std.debug.print("stop {s} stream={}: want {s}, got {s}\n", .{ case[0], stream, case[1], seen.content });
+            return error.TestUnexpectedResult;
+        }
+        try t.expectEqualStrings(case[2], seen.finish);
+    };
+}
+
+/// The rows a reply's logprobs carry, whole or streamed.
+fn rowsOf(a: std.mem.Allocator, r: *const Receipt, stream: bool) ![]const V {
+    if (!stream) return r.body.get("choices").?.array[0].get("logprobs").?.get("content").?.array;
+    var rows: std.ArrayList(V) = .empty;
+    for (r.events.items) |event| {
+        const choices = event.get("choices") orelse continue;
+        if (choices.array.len == 0) continue;
+        const lp = choices.array[0].get("logprobs") orelse continue;
+        if (lp == .object) if (lp.get("content")) |c| try rows.appendSlice(a, c.array);
+    }
+    return rows.items;
+}
+
+/// Logprob rows for the content's tokens only: never a marker's, a header name's or the reasoning's.
+fn logprobChecks(a: std.mem.Allocator, dir: []const u8) !void {
+    var script: Script = .{ .a = a, .ids = &.{}, .logprobs = true };
+    const text, const srv = try serve(a, dir, &script);
+    defer text.deinit();
+    defer srv.deinit();
+    const head = try idsOf(a, text, &.{ "<|message_model|>", "<|content_thinking|>", "hm", "<|end_message|>", "<|message_model|>", "<|content_text|>" });
+    const said = try idsOf(a, text, &.{"Hi there"});
+    script.ids = try std.mem.concat(a, u32, &.{ head, said, try idsOf(a, text, &.{ "<|end_message|>", "<|content_model_end_sampling|>" }) });
+    for ([_][]const u8{ ",\"chat_template_kwargs\":{\"enable_thinking\":false}", "" }) |switch_| for ([_]bool{ false, true }) |stream| {
+        const body = try std.fmt.allocPrint(a, "{s},\"logprobs\":true,\"top_logprobs\":1{s}}}", .{ plain_body, switch_ });
+        const r, const seen = try ask(a, srv, body, stream);
+        if (r.code != 200) {
+            std.debug.print("logprobs{s} stream={}: {d} {s}\n", .{ switch_, stream, r.code, try json.stringify(a, r.body, .{ .ascii = false, .compact = true }) });
+            return error.TestUnexpectedResult;
+        }
+        try t.expectEqualStrings("Hi there", seen.content);
+        const rows = try rowsOf(a, &r, stream);
+        var spelled: std.ArrayList(u8) = .empty;
+        for (rows) |row| try spelled.appendSlice(a, row.strField("token").?);
+        if (rows.len != said.len or !std.mem.eql(u8, "Hi there", spelled.items)) {
+            std.debug.print("logprobs{s} stream={}: {d} rows spell {s}\n", .{ switch_, stream, rows.len, spelled.items });
+            return error.TestUnexpectedResult;
+        }
+        for (rows, head.len..) |row, i| try t.expectEqual(-@as(f64, @floatFromInt(i + 1)) / 4, row.get("logprob").?.float);
+    };
+    // a call to a tool the request did not offer stays content, and so do its tokens' rows; its header name is neither
+    script.ids = try idsOf(a, text, &.{ "<|message_model|>", "<|content_text|>", "Hi", "<|end_message|>", "<|message_model|>", "w", "<|content_invoke_tool_json|>", "{}", "<|end_message|>", "<|content_model_end_sampling|>" });
+    for ([_]bool{ false, true }) |stream| {
+        const r, const seen = try ask(a, srv, plain_body ++ ",\"logprobs\":true}", stream);
+        try t.expectEqualStrings("Hi{}", seen.content);
+        var spelled: std.ArrayList(u8) = .empty;
+        for (try rowsOf(a, &r, stream)) |row| try spelled.appendSlice(a, row.strField("token").?);
+        try t.expectEqualStrings("Hi{}", spelled.items);
+    }
+}
+
+/// The response template's strip: false, for reasoning_content and content alike.
+fn whitespaceChecks(a: std.mem.Allocator, dir: []const u8) !void {
+    var script: Script = .{ .a = a, .ids = &.{} };
+    const text, const srv = try serve(a, dir, &script);
+    defer text.deinit();
+    defer srv.deinit();
+    const cases = [_][2][]const u8{ .{ "  Plan it.\n", " Hi \n" }, .{ " \n ", "\nok" } };
+    for (cases) |case| {
+        script.ids = try idsOf(a, text, &.{ "<|message_model|>", "<|content_thinking|>", case[0], "<|end_message|>", "<|message_model|>", "<|content_text|>", case[1], "<|end_message|>", "<|content_model_end_sampling|>" });
+        for ([_]bool{ false, true }) |stream| {
+            _, const seen = try ask(a, srv, plain_body ++ "}", stream);
+            try t.expectEqualStrings(case[0], seen.reasoning);
+            try t.expectEqualStrings(case[1], seen.content);
+        }
+    }
+}
+
+/// The effort line each request's thinking switch and effort give, and the image refusal.
+fn promptChecks(a: std.mem.Allocator, dir: []const u8, line: []const u8, efforts: []const [2][]const u8) !void {
+    var script: Script = .{ .a = a, .ids = &.{ 200001, 200004, 200010, 200006 } };
+    const text, const srv = try serve(a, dir, &script);
+    defer text.deinit();
+    defer srv.deinit();
+    for (efforts) |case| {
+        const body = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"messages\":[{{\"role\":\"user\",\"content\":\"Hi\"}}],\"max_tokens\":8{s}}}", .{case[0]});
+        const r, _ = try ask(a, srv, body, false);
+        try t.expectEqual(@as(u16, 200), r.code);
+        const prompt = try text.text().decode(a, script.prompt);
+        const want = try std.mem.concat(a, u8, &.{ line, case[1], "<|end_message|>" });
+        if (std.mem.indexOf(u8, prompt, want) == null) {
+            std.debug.print("{s}: want {s} in {s}\n", .{ case[0], want, prompt });
+            return error.TestUnexpectedResult;
+        }
+    }
+    for ([_][]const u8{
+        "{\"type\":\"image_url\",\"image_url\":{\"url\":\"data:image/png;base64,AAAA\"}}",
+        "{\"type\":\"input_audio\",\"input_audio\":{\"data\":\"AAAA\",\"format\":\"wav\"}}",
+    }) |part| {
+        const body = try std.fmt.allocPrint(a, "{{\"model\":\"m\",\"messages\":[{{\"role\":\"user\",\"content\":[{{\"type\":\"text\",\"text\":\"What?\"}},{s}]}}],\"max_tokens\":8}}", .{part});
+        const r, _ = try ask(a, srv, body, false);
+        try t.expectEqual(@as(u16, 400), r.code);
+        const message = r.body.get("error").?.strField("message").?;
+        if (std.mem.indexOf(u8, message, parts.image_refusal) == null) {
+            std.debug.print("refusal: {s}\n", .{message});
+            return error.TestUnexpectedResult;
+        }
+    }
+}
+
+const switches = [_][2][]const u8{
+    .{ "", "default" },
+    .{ ",\"reasoning_effort\":\"low\"", "low" },
+    .{ ",\"reasoning_effort\":\"max\"", "max" },
+    .{ ",\"reasoning_effort\":\"none\"", "none" },
+    .{ ",\"chat_template_kwargs\":{\"enable_thinking\":false}", "none" },
+    .{ ",\"chat_template_kwargs\":{\"enable_thinking\":true},\"reasoning_effort\":\"minimal\"", "minimal" },
+};
