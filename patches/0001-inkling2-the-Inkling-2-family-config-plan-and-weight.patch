diff --git a/zig/src/families/inkling2/cuda_state.zig b/zig/src/families/inkling2/cuda_state.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ce5a8e0a5b0383ee74412559ae26990442b38fb4
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_state.zig
@@ -0,0 +1,680 @@
+//! A forward's activation buffers (`Act`, sized for the widest forward) and one stream's state across forwards
+//! (`State`: each layer's keys and values and its four convolutions' last 3 input rows), with the scaffold's own
+//! state steps: the cache write, the convolution state commits (a forward's, a verify window's keeping its inputs,
+//! and `keep`'s rollback, one launch each) and the block push.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const weights = @import("cuda_weights.zig");
+const attn = @import("cuda_attn.zig");
+const conv = @import("cuda_conv.zig");
+const pages = @import("cuda_pages.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+const D = weights.head_dim;
+
+/// Completed block sources at most (layers 0, 6, ..., 42).
+pub const max_blocks = 8;
+pub const topk = 8;
+pub const experts = 384;
+
+/// Every activation of one forward, `cap` rows each (a forward uses the first R).
+pub const Act = struct {
+    gpa: std.mem.Allocator,
+    cap: usize,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: usize = 0,
+    /// Layer input and output, swapped after each layer.
+    h: [2]Mat = undefined,
+    x: [3]Mat = undefined, // fp32 mix outputs (attention input queries)
+    xn: [3]Mat = undefined, // bf16 normed sources
+    q: Mat = undefined,
+    k: Mat = undefined,
+    v: Mat = undefined,
+    rel: Mat = undefined,
+    gate: Mat = undefined,
+    sink: Mat = undefined,
+    /// attn.projectOne's output: [one_rows, attn.oneWidth] bf16 (at one row a layer's projections side by side).
+    one: Mat = undefined,
+    dk: Mat = undefined,
+    dv: Mat = undefined,
+    kc: Mat = undefined,
+    vc: Mat = undefined,
+    qh: Mat = undefined,
+    kh: Mat = undefined,
+    vh: Mat = undefined,
+    relh: Mat = undefined,
+    o: Mat = undefined,
+    ao: Mat = undefined,
+    a: Mat = undefined,
+    partial: Mat = undefined,
+    mx: Mat = undefined,
+    m: Mat = undefined,
+    ids: Mat = undefined,
+    wts: Mat = undefined,
+    logits: Mat = undefined,
+    y: Mat = undefined,
+    cm: Mat = undefined,
+    /// Token ids (i32) for the embedding.
+    tokens: Mat = undefined,
+    /// The blocks: max_blocks matrices [cap, H] bf16, `nblocks` of them complete.
+    blocks: u64 = 0,
+    nblocks: usize = 0,
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, cap: usize, hq: usize, hk: usize) !Act {
+        var a: Act = .{ .gpa = gpa, .cap = cap };
+        errdefer a.deinit();
+        for (&a.h) |*m| m.* = try a.mat(d, H, .bf16);
+        for (&a.x) |*m| m.* = try a.mat(d, H, .f32);
+        for (&a.xn) |*m| m.* = try a.mat(d, H, .bf16);
+        a.q = try a.mat(d, hq * D, .bf16);
+        a.k = try a.mat(d, hk * D, .bf16);
+        a.v = try a.mat(d, hk * D, .bf16);
+        a.rel = try a.mat(d, hq * weights.d_rel, .bf16);
+        a.gate = try a.mat(d, hq * D, .bf16);
+        a.sink = try a.mat(d, hq, .bf16);
+        const ow = attn.oneWidth(hq, hk);
+        const orows = @min(cap, attn.one_rows);
+        a.one = Mat.of(try a.raw(d, orows * ow * 2), orows, ow, .bf16);
+        a.dk = try a.mat(d, hk * weights.taps, .bf16);
+        a.dv = try a.mat(d, hk * weights.taps, .bf16);
+        a.kc = try a.mat(d, hk * D, .bf16);
+        a.vc = try a.mat(d, hk * D, .bf16);
+        a.qh = try a.mat(d, hq * D, .bf16);
+        a.kh = try a.mat(d, hk * D, .bf16);
+        a.vh = try a.mat(d, hk * D, .bf16);
+        a.relh = try a.mat(d, hq * weights.d_rel, .bf16);
+        a.o = try a.mat(d, hq * D, .bf16);
+        a.ao = try a.mat(d, H, .bf16);
+        a.a = try a.mat(d, H, .bf16);
+        a.partial = try a.mat(d, H, .f32);
+        a.mx = try a.mat(d, H, .f32);
+        a.m = try a.mat(d, H, .bf16);
+        a.ids = try a.mat(d, topk, .i32);
+        a.wts = try a.mat(d, topk, .f32);
+        a.logits = try a.mat(d, experts, .f32);
+        a.y = try a.mat(d, H, .bf16);
+        a.cm = try a.mat(d, H, .bf16);
+        a.tokens = try a.mat(d, 1, .i32);
+        a.blocks = try a.raw(d, max_blocks * a.blockStride());
+        return a;
+    }
+
+    pub fn deinit(a: *Act) void {
+        for (a.own.items) |*b| b.free();
+        a.own.deinit(a.gpa);
+        a.* = undefined;
+    }
+
+    fn raw(a: *Act, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try a.own.append(a.gpa, b);
+        a.bytes += bytes;
+        return b.ptr;
+    }
+
+    fn mat(a: *Act, d: *const cuda.Driver, cols: usize, dt: ops.Dt) !Mat {
+        return Mat.of(try a.raw(d, a.cap * cols * dt.size()), a.cap, cols, dt);
+    }
+
+    pub fn blockStride(a: *const Act) usize {
+        return a.cap * H * 2;
+    }
+
+    /// The completed blocks for a forward of `rows` rows.
+    pub fn blockView(a: *const Act, rows: usize) ops.Blocks {
+        return .{ .ptr = a.blocks, .stride = a.blockStride(), .count = a.nblocks, .rows = rows, .hidden = H };
+    }
+
+    /// Block `i` (complete or not) for `rows` rows.
+    pub fn block(a: *const Act, i: usize, rows: usize) Mat {
+        return Mat.of(a.blocks + i * a.blockStride(), rows, H, .bf16);
+    }
+};
+
+/// Rows of a verify window at most: a forward this narrow on a slot with drafts keeps each convolution's inputs, so
+/// `keep` can take the state back to any of its rows (DSpark: the anchor and 7 drafts).
+pub const spec_rows = 8;
+
+/// One layer's state for one stream.
+pub const LayerState = struct {
+    kv: attn.Kv,
+    /// bf16 [3, C] each: K and V (C = hk*128), post-attention and post-MLP (C = 4608).
+    conv_k: u64,
+    conv_v: u64,
+    conv_attn: u64,
+    conv_mlp: u64,
+    /// With drafts: each convolution's [state before the forward; the forward's input rows], bf16 [3 + spec_rows, C]
+    /// (k, v, attn, mlp); 0 without.
+    hist: [4]u64 = @splat(0),
+};
+
+/// One stream's state over the loaded layers.
+pub const State = struct {
+    gpa: std.mem.Allocator,
+    first: u32,
+    layers: []LayerState,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    bytes: usize = 0,
+    /// Positions held (the next forward starts here).
+    pos: usize = 0,
+    context: usize,
+    /// The last forward's first position and rows, and whether it kept its convolution inputs (a verify window).
+    last_pos0: usize = 0,
+    last_rows: usize = 0,
+    kept_inputs: bool = false,
+    /// The last forward's row this stream's rows started at (a batched forward's segment; the drafter's taps).
+    last_row0: usize = 0,
+    /// The engine's forward count at this stream's last forward (cuda_engine.zig Engine.forwards): the drafter's
+    /// taps are this stream's while no other forward came after it.
+    last_fwd: u64 = 0,
+    /// With the convolutions' input history: `keepAll`'s table on the device, a `KeepEntry` for each convolution of
+    /// each layer (4 a layer), and its entries.
+    keep_table: u64 = 0,
+    keep_entries: u32 = 0,
+    /// Global layers on pages (cuda_pages.zig): where they live, the slot's page table (i32 ids on the device at a
+    /// fixed address, `entries` of them; unmapped entries name the scrub page), its host copy, and the entries that
+    /// name the slot's own pages (positions [0, mapped * page_rows) may run). Null place: a window a layer (v0.1).
+    place: ?pages.Place = null,
+    table: u64 = 0,
+    ids: []u32 = &.{},
+    mapped: usize = 0,
+    /// On pages: the first page when the slot's mapped pages are one run of consecutive ids (the allocator's normal
+    /// case), else null. Its one-row forwards then read and write that run through the v0.1 ring kernels (`kvFor`;
+    /// TF_INK2_RUN_RING=0: never), every other forward through the page table.
+    run: ?u32 = null,
+    ring_on_run: bool = true,
+    /// The mode of this stream's last one-row forward (`noteOneRow`: counted when it changes).
+    last_one: enum { none, ring, paged } = .none,
+    /// Tooling (own pages, TF_INK2_PAGE_ORDER=move): each new sequence's run (`restart`), and the one-row forwards
+    /// counted so far; while `flip` is set, every other `flip` one-row forwards take the page table (mode switches
+    /// mid-stream).
+    moves: u32 = 0,
+    ones: u64 = 0,
+    flip: u32 = 0,
+
+    /// Where a slot's global layers live: a window each (v0.1), the served streams' shared pool, or pages of its own
+    /// (tooling: the slot's whole context mapped at once, consecutive ids or, with `shuffle`, a permutation; with
+    /// `move`, an arena of two contexts in which each new sequence takes another run, see `restart`).
+    /// `drafter_hk` (own pages): the drafter's key heads when its global layer shares the slot's pages (stage 2c: two
+    /// more regions; 0: no drafter).
+    pub const Storage = union(enum) { window, pool: pages.Place, own: struct { shuffle: bool = false, move: bool = false, drafter_hk: usize = 0 } };
+
+    /// Room for `context` positions, forwards of at most `max_rows` rows; `spec`: the convolutions' input history.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, max_rows: usize, spec: bool) !State {
+        return initOn(gpa, d, w, context, max_rows, spec, .window);
+    }
+
+    /// `init` with the global layers on `storage`.
+    pub fn initOn(gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, max_rows: usize, spec: bool, storage: Storage) !State {
+        var s: State = .{ .gpa = gpa, .first = w.first, .layers = try gpa.alloc(LayerState, w.layers.len), .context = context, .ring_on_run = pages.ringOnRun() };
+        errdefer s.deinit();
+        if (storage != .window) try s.pageTable(gpa, d, w, context, storage);
+        var g: usize = 0;
+        for (w.layers, s.layers) |l, *st| {
+            const cols = l.hk * D;
+            const slots = if (l.global) context else @min(context, attn.window - 1 + max_rows);
+            var kv: attn.Kv = undefined;
+            if (l.global and s.place != null) {
+                // global layer g: keys in region 2g, values in 2g + 1, position p at row p % page_rows of page ids[p / page_rows]
+                const pl = s.place.?;
+                kv = .{ .k = pl.region(2 * g), .v = pl.region(2 * g + 1), .slots = s.ids.len * pages.page_rows, .heads = l.hk, .window = 0, .pages = s.table, .page = pl.elems() };
+                g += 1;
+            } else kv = .{ .k = try s.zeroed(d, slots * cols * 2), .v = try s.zeroed(d, slots * cols * 2), .slots = slots, .heads = l.hk, .window = if (l.global) 0 else attn.window };
+            st.* = .{
+                .kv = kv,
+                .conv_k = try s.zeroed(d, conv.state_rows * cols * 2),
+                .conv_v = try s.zeroed(d, conv.state_rows * cols * 2),
+                .conv_attn = try s.zeroed(d, conv.state_rows * H * 2),
+                .conv_mlp = try s.zeroed(d, conv.state_rows * H * 2),
+            };
+            if (spec) for (&st.hist, [4]usize{ cols, cols, H, H }) |*h, c| {
+                h.* = try s.zeroed(d, (conv.state_rows + spec_rows) * c * 2);
+            };
+        }
+        if (spec) {
+            const table = try gpa.alloc(KeepEntry, 4 * w.layers.len);
+            defer gpa.free(table);
+            for (s.layers, w.layers, 0..) |st, l, i| {
+                const kvc: u32 = @intCast(@as(usize, l.hk) * D);
+                for (st.hist, [4]u64{ st.conv_k, st.conv_v, st.conv_attn, st.conv_mlp }, [4]u32{ kvc, kvc, H, H }, 0..) |h, x, c, j| table[4 * i + j] = .{ .state = x, .hist = h, .cols = c };
+            }
+            var b = try cuda.DeviceBuffer.alloc(d, table.len * @sizeOf(KeepEntry));
+            errdefer b.free();
+            try b.upload(0, std.mem.sliceAsBytes(table));
+            try s.own.append(gpa, b);
+            s.bytes += b.len;
+            s.keep_table = b.ptr;
+            s.keep_entries = @intCast(table.len);
+        }
+        return s;
+    }
+
+    pub fn deinit(s: *State) void {
+        for (s.own.items) |*b| b.free();
+        s.own.deinit(s.gpa);
+        s.gpa.free(s.layers);
+        if (s.ids.len > 0) s.gpa.free(s.ids);
+        s.* = undefined;
+    }
+
+    /// The page table (every entry on the scrub page), and with `own` the slot's own arena, every entry mapped.
+    fn pageTable(s: *State, gpa: std.mem.Allocator, d: *const cuda.Driver, w: *const weights.Weights, context: usize, storage: Storage) !void {
+        const g = (try pagedShapeFor(w, if (storage == .own) storage.own.drafter_hk else 0)) orelse return error.NoGlobalLayers;
+        const entries = pages.pagesFor(context);
+        s.place = switch (storage) {
+            .pool => |pl| pl,
+            .own => |o| .{ .base = try s.raw(d, pages.arenaBytes(ownPages(entries, o.move), g.regions, g.run)), .pages = ownPages(entries, o.move), .run = g.run },
+            .window => unreachable,
+        };
+        s.ids = try gpa.alloc(u32, entries);
+        @memset(s.ids, s.place.?.scrub());
+        s.table = try s.raw(d, entries * 4);
+        if (storage == .own) {
+            for (s.ids, 0..) |*v, i| v.* = @intCast(i);
+            if (storage.own.shuffle) {
+                var prng = std.Random.DefaultPrng.init(0x1d2b_2024);
+                prng.random().shuffle(u32, s.ids);
+            }
+            s.mapped = entries;
+            s.run = runStart(s.ids);
+            if (storage.own.move) s.flip = move_flip;
+            // NaN under TF_KV_POISON, so a row read before its write shows (G4); the scrub page too
+            const pl = s.place.?;
+            const view: cuda.DeviceBuffer = .{ .d = d, .ptr = pl.base, .len = @intCast(pages.arenaBytes(pl.pages, g.regions, g.run)), .borrowed = true };
+            try view.fill8(if (pages.poisoned()) 0xff else 0, null);
+        }
+        try s.upload(d);
+    }
+
+    /// The host table to the device (blocking; start-up and tooling).
+    fn upload(s: *const State, d: *const cuda.Driver) !void {
+        const view: cuda.DeviceBuffer = .{ .d = d, .ptr = s.table, .len = s.ids.len * 4, .borrowed = true };
+        try view.upload(0, std.mem.sliceAsBytes(s.ids));
+    }
+
+    /// Whether the global layers are on pages.
+    pub fn paged(s: *const State) bool {
+        return s.place != null;
+    }
+
+    /// Positions the slot may run to: its table's mapped pages (on pages), else its context.
+    pub fn limit(s: *const State) usize {
+        return if (s.place != null) @min(s.mapped * pages.page_rows, s.context) else s.context;
+    }
+
+    /// Rank 0 and the followers alike: the slot's pages are `ids` (position order); the rest of its table the scrub
+    /// page. The host copy now; the device table by `enqueueTable` (on the stream, after every earlier forward).
+    pub fn mapIds(s: *State, ids: []const u32) !void {
+        if (s.place == null) return error.NotPaged;
+        if (ids.len > s.ids.len) return error.PastContext;
+        const scrub = s.place.?.scrub();
+        for (ids) |id| if (id >= scrub) return error.BadPage;
+        @memcpy(s.ids[0..ids.len], ids);
+        @memset(s.ids[ids.len..], scrub);
+        s.mapped = ids.len;
+        s.run = runStart(ids);
+    }
+
+    /// No pages mapped (the slot's stream ended): no forward of it until it opens again.
+    pub fn unmap(s: *State) void {
+        s.mapped = 0;
+        s.run = null;
+        s.last_one = .none;
+    }
+
+    /// Layer `l`'s keys and values for a forward of `rows` of this stream's rows: a one-row forward of a global layer
+    /// on pages that are one run (`run`) gets the ring view of the run (base its first page, a slot a position, no
+    /// table read: v0.1's kernels and window); every other forward the layer's own Kv (paged for a global layer on
+    /// pages). Both address the same bytes, and the ring and paged kernels give the same bits (G1).
+    pub fn kvFor(s: *const State, l: u32, rows: usize) attn.Kv {
+        const kv = s.layer(l).kv;
+        if (rows != 1 or !kv.paged()) return kv;
+        const start = s.ringRun() orelse return kv;
+        const off = @as(u64, start) * kv.page * 2;
+        return .{ .k = kv.k + off, .v = kv.v + off, .slots = s.context, .heads = kv.heads, .window = 0, .run = start };
+    }
+
+    /// The run a one-row forward reads through the ring kernels, or null (not on pages, not one run, or switched off;
+    /// tooling: a `flip` phase on the page table).
+    pub fn ringRun(s: *const State) ?u32 {
+        if (!s.ring_on_run or s.mapped == 0) return null;
+        if (s.flip > 0 and (s.ones / s.flip) % 2 == 1) return null;
+        return s.run;
+    }
+
+    /// Tooling (TF_INK2_PAGE_ORDER=move): the slot's own pages moved to the next run of its two-context arena (a new
+    /// sequence's: rows written before it are never read), the device table queued on `c`'s stream.
+    fn moveRun(s: *State, c: *const Ctx) !void {
+        const pl = s.place orelse return;
+        const entries = s.ids.len;
+        if (pl.pages != ownPages(entries, true)) return; // not a moving arena
+        s.moves += 1;
+        const start: u32 = @intCast((@as(usize, s.moves) * (entries / 2 + 1)) % (entries + 1));
+        for (s.ids, 0..) |*v, i| v.* = start + @as(u32, @intCast(i));
+        s.mapped = entries;
+        s.run = start;
+        s.ones = 0;
+        s.last_one = .none;
+        try s.enqueueTable(c.d, c.stream);
+    }
+
+    /// The host table queued to the device on `stream` (a pinned copy: it lands after the stream's earlier work).
+    pub fn enqueueTable(s: *const State, d: *const cuda.Driver, stream: cuda.Stream) !void {
+        try cuda.copy_source.enqueue(d, s.table, std.mem.sliceAsBytes(s.ids), stream);
+    }
+
+    fn raw(s: *State, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try s.own.append(s.gpa, b);
+        s.bytes += bytes;
+        return b.ptr;
+    }
+
+    fn zeroed(s: *State, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try b.fill8(0, null);
+        try s.own.append(s.gpa, b);
+        s.bytes += bytes;
+        return b.ptr;
+    }
+
+    pub fn layer(s: *const State, l: u32) *const LayerState {
+        return &s.layers[l - s.first];
+    }
+
+    /// A new sequence: every convolution's state back to zeros (the keys and values need no clearing: a forward
+    /// reads only positions it or an earlier forward of the same sequence wrote).
+    pub fn restart(s: *State, c: *const Ctx) !void {
+        if (s.flip > 0) try s.moveRun(c);
+        for (s.layers) |st| {
+            const kvc = st.kv.heads * D * 2;
+            try c.zero(st.conv_k, conv.state_rows * kvc);
+            try c.zero(st.conv_v, conv.state_rows * kvc);
+            try c.zero(st.conv_attn, conv.state_rows * H * 2);
+            try c.zero(st.conv_mlp, conv.state_rows * H * 2);
+        }
+        s.pos = 0;
+    }
+};
+
+/// Tooling, TF_INK2_PAGE_ORDER=move: one-row forwards a phase (ring on the run, then the page table, in turn).
+pub const move_flip: u32 = 5;
+
+/// The pages of a slot's own arena (the scrub page last): its context's, or two contexts' when it moves.
+fn ownPages(entries: usize, move: bool) usize {
+    return if (move) 2 * entries + 1 else entries + 1;
+}
+
+/// The first id when `ids` are one run of consecutive ids, else null.
+pub fn runStart(ids: []const u32) ?u32 {
+    if (ids.len == 0 or pages.Alloc.runsOf(ids) != 1) return null;
+    return ids[0];
+}
+
+/// The device bytes `State.init` takes for these weights, `context` positions and forwards of `max_rows` rows.
+pub fn stateBytes(w: *const weights.Weights, context: usize, max_rows: usize) usize {
+    var n: usize = 0;
+    for (w.layers) |l| {
+        const cols: usize = @as(usize, l.hk) * D;
+        const slots = if (l.global) context else @min(context, attn.window - 1 + max_rows);
+        n += 2 * slots * cols * 2 + 2 * conv.state_rows * cols * 2 + 2 * conv.state_rows * H * 2;
+    }
+    return n;
+}
+
+/// The pages' shape on these weights: regions (2 a global layer: keys, values) and a run's bytes (page_rows rows of
+/// a global layer); null without a global layer. Every global layer has the same key heads.
+/// `drafter`: the drafter's global layer has the last two regions (2g: keys, 2g + 1: values; stage 2c).
+pub const PagedShape = struct {
+    regions: usize,
+    run: u64,
+    globals: usize,
+    drafter: bool = false,
+
+    /// The drafter's keys' (0) and values' (1) regions.
+    pub fn drafterRegion(g: PagedShape, which: usize) usize {
+        std.debug.assert(g.drafter and which < 2);
+        return 2 * g.globals + which;
+    }
+};
+
+pub fn pagedShape(w: *const weights.Weights) ?PagedShape {
+    var n: usize = 0;
+    var hk: usize = 0;
+    for (w.layers) |l| if (l.global) {
+        n += 1;
+        hk = l.hk;
+    };
+    if (n == 0) return null;
+    return .{ .regions = 2 * n, .run = pages.page_rows * hk * D * 2, .globals = n };
+}
+
+/// `pagedShape` with the drafter's global layer in two more regions when `drafter_hk` > 0 (its key heads: a page's
+/// run of it must be a target global layer's, as it is at every W: 8 / W both).
+pub fn pagedShapeFor(w: *const weights.Weights, drafter_hk: usize) !?PagedShape {
+    var g = pagedShape(w) orelse return null;
+    if (drafter_hk == 0) return g;
+    if (pages.page_rows * drafter_hk * D * 2 != g.run) return error.DraftPageShape;
+    g.regions += 2;
+    g.drafter = true;
+    return g;
+}
+
+/// Bytes a page takes on this rank (every region's run of it).
+pub fn pageBytes(w: *const weights.Weights) u64 {
+    const g = pagedShape(w) orelse return 0;
+    return g.regions * g.run;
+}
+
+/// `pageBytes` with the drafter's two runs when `drafter_hk` > 0.
+pub fn pageBytesFor(w: *const weights.Weights, drafter_hk: usize) u64 {
+    const g = (pagedShapeFor(w, drafter_hk) catch return 0) orelse return 0;
+    return g.regions * g.run;
+}
+
+/// The device bytes a slot on pages takes beside its pages: every layer's but the global layers' keys and values,
+/// and its page table.
+pub fn fixedBytes(w: *const weights.Weights, context: usize, max_rows: usize) usize {
+    var n: usize = 0;
+    for (w.layers) |l| {
+        const cols: usize = @as(usize, l.hk) * D;
+        const slots = if (l.global) 0 else @min(context, attn.window - 1 + max_rows);
+        n += 2 * slots * cols * 2 + 2 * conv.state_rows * cols * 2 + 2 * conv.state_rows * H * 2;
+    }
+    return n + pages.pagesFor(context) * 4;
+}
+
+/// Positions [lo, hi) of a global layer's keys and values as runs of contiguous rows, in position order: one run a
+/// window, or a run a page (consecutive page ids merged) on pages.
+pub const RowRuns = struct {
+    kv: attn.Kv,
+    ids: []const u32,
+    p: usize,
+    hi: usize,
+    row: usize,
+
+    pub const Run = struct { pos: usize, n: usize, k: u64, v: u64 };
+
+    pub fn of(kv: attn.Kv, ids: []const u32, lo: usize, hi: usize) RowRuns {
+        return .{ .kv = kv, .ids = ids, .p = lo, .hi = hi, .row = kv.heads * D * 2 };
+    }
+
+    pub fn next(r: *RowRuns) !?Run {
+        if (r.p >= r.hi) return null;
+        const p = r.p;
+        if (!r.kv.paged()) {
+            if (r.kv.window != 0 or r.hi > r.kv.slots) return error.KvWindow; // a slot a position only
+            r.p = r.hi;
+            return .{ .pos = p, .n = r.hi - p, .k = r.kv.k + p * r.row, .v = r.kv.v + p * r.row };
+        }
+        const stride: u64 = @as(u64, r.kv.page) * 2;
+        var j = p / pages.page_rows;
+        if (j >= r.ids.len) return error.PastContext;
+        const off = p % pages.page_rows;
+        const id = r.ids[j];
+        var end = @min(r.hi, (j + 1) * pages.page_rows);
+        // consecutive ids are one run when a page's rows are a whole run of the region (the arena's layout)
+        if (stride == pages.page_rows * r.row) while (end < r.hi and j + 1 < r.ids.len and r.ids[j + 1] == r.ids[j] + 1) {
+            j += 1;
+            end = @min(r.hi, (j + 1) * pages.page_rows);
+        };
+        r.p = end;
+        const at = @as(u64, id) * stride + off * r.row;
+        return .{ .pos = p, .n = end - p, .k = r.kv.k + at, .v = r.kv.v + at };
+    }
+};
+
+/// The device bytes the convolutions' input history adds (State.init with `spec`).
+pub fn histBytes(w: *const weights.Weights) usize {
+    var n: usize = 0;
+    for (w.layers) |l| n += (conv.state_rows + spec_rows) * (2 * @as(usize, l.hk) * D + 2 * H) * 2;
+    return n;
+}
+
+/// A convolution's state after a verify window's input rows x [R, C] (R <= spec_rows), keeping its history:
+/// hist = [state; x], then state = hist[R .. R + 3), one launch (inkling2_conv.cu tf_ink2_conv_commit_spec: the same
+/// bytes as `convCommitSpecCopies`' three copies).
+pub fn convCommitSpec(c: *const Ctx, state: u64, hist: u64, x: Mat) !void {
+    const R = x.rows;
+    if (R > spec_rows or x.dt != .bf16) return error.BadSpecWindow;
+    if (R == 0) return;
+    const C = x.cols;
+    var a: cuda.Args = .{};
+    a.add(state);
+    a.add(hist);
+    a.add(x.ptr);
+    a.add(@as(i64, @intCast(x.ld)));
+    a.add(@as(i32, @intCast(R)));
+    a.add(@as(i32, @intCast(C)));
+    try cuda.launch.launch(c.k.conv.commit_spec_fn, .{ .grid = .{ .x = @intCast((C + 255) / 256), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// `convCommitSpec` as three device copies (the form it replaced; the op check compares the two).
+pub fn convCommitSpecCopies(c: *const Ctx, state: u64, hist: u64, x: Mat) !void {
+    const n = conv.state_rows;
+    const row = x.cols * x.dt.size();
+    const R = x.rows;
+    if (R > spec_rows or !x.dense()) return error.BadSpecWindow;
+    try c.copy(hist, state, n * row);
+    try c.copy(hist + n * row, x.ptr, R * row);
+    try c.copy(state, hist + R * row, n * row);
+}
+
+/// One convolution's place in `State.keep_table` (inkling2_conv.cu KeepEntry).
+pub const KeepEntry = extern struct {
+    state: u64,
+    hist: u64,
+    cols: u32,
+    pad: u32 = 0,
+};
+
+/// Every convolution of the slot as if only its last window's first `keep` rows had run: state = hist[keep ..
+/// keep + 3) for each, one launch over `keep_table` (inkling2_conv.cu tf_ink2_conv_keep: the same bytes as a
+/// `convKeep` copy a convolution).
+pub fn keepAll(c: *const Ctx, st: *const State, keep: usize) !void {
+    if (st.keep_table == 0) return error.RollbackNotKept;
+    if (keep == 0 or keep > spec_rows) return error.BadKeep;
+    var a: cuda.Args = .{};
+    a.add(st.keep_table);
+    a.add(@as(i32, @intCast(keep)));
+    try cuda.launch.launch(c.k.conv.keep_fn, .{ .grid = .{ .x = 8, .y = st.keep_entries, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// The state as if only the window's first `keep` rows had run: hist[keep .. keep + 3) (one convolution, one copy;
+/// `keepAll` does every convolution in one launch, and the op check compares the two).
+pub fn convKeep(c: *const Ctx, state: u64, hist: u64, cols: usize, keep: usize) !void {
+    const row = cols * 2;
+    try c.copy(state, hist + keep * row, conv.state_rows * row);
+}
+
+/// k', v' rows [R, hk*128] of positions pos0 .. pos0 + R - 1 into their slots, one launch
+/// (inkling2_attn.cu tf_ink2_attn_kv_write); `dev`: pos0 read on the device at run time (a captured decode step).
+/// A paged Kv (a global layer in the KV page pool) takes tf_ink2_attn_kv_write_pg: each row to its page's row.
+pub fn kvWrite(c: *const Ctx, kv: attn.Kv, pos0: usize, dev: ?attn.Dev, k: Mat, v: Mat) !void {
+    const R = k.rows;
+    if (R > kv.slots or !k.dense() or !v.dense()) return error.KvWindow;
+    if (R == 0) return;
+    const row = kv.heads * D * 2;
+    if (k.cols * 2 != row or v.cols * 2 != row or row % 16 != 0 or kv.slots > std.math.maxInt(i32) or pos0 + R > std.math.maxInt(i32)) return error.KvWindow;
+    // paged: every row inside the table, whole 16-byte words a page
+    if (kv.paged() and (kv.window != 0 or kv.page % 8 != 0 or pos0 + R > kv.slots)) return error.KvWindow;
+    var a: cuda.Args = .{};
+    for ([_]u64{ k.ptr, v.ptr, kv.k, kv.v }) |p| a.add(p);
+    a.add(@as(i32, @intCast(row / 16)));
+    a.add(@as(i32, @intCast(kv.slots)));
+    a.add(@as(i32, @intCast(pos0)));
+    a.add(if (dev) |x| x.posp else @as(u64, 0));
+    if (kv.paged()) kv.addPaged(&a);
+    const f = if (kv.paged()) c.k.attn.pg.kv_write else c.k.attn.kv_write;
+    try c.launchOn(kv.run, kv.k, kv.v, f, .{ .grid = .{ .x = @intCast(R), .y = 1, .z = 1 }, .block = .{ .x = 128, .y = 1, .z = 1 } }, &a);
+}
+
+/// The cached rows of positions lo .. hi - 1 gathered into k, v [hi - lo, hk*128] (for dumps); `ids` a paged
+/// layer's host table.
+pub fn kvGather(c: *const Ctx, kv: attn.Kv, ids: []const u32, lo: usize, hi: usize, k: Mat, v: Mat) !void {
+    if (kv.paged()) {
+        var runs = RowRuns.of(kv, ids, lo, hi);
+        while (try runs.next()) |r| {
+            try c.copy(k.row(r.pos - lo), r.k, r.n * runs.row);
+            try c.copy(v.row(r.pos - lo), r.v, r.n * runs.row);
+        }
+        return;
+    }
+    const row = kv.heads * D * 2;
+    var p = lo;
+    while (p < hi) {
+        const slot = p % kv.slots;
+        const n = @min(hi - p, kv.slots - slot);
+        try c.copy(k.row(p - lo), kv.k + slot * row, n * row);
+        try c.copy(v.row(p - lo), kv.v + slot * row, n * row);
+        p += n;
+    }
+}
+
+/// A convolution's state after a forward's input rows x [R, C] (bf16): the last 3 rows of [state; x], one launch
+/// (inkling2_conv.cu tf_ink2_conv_commit).
+pub fn convCommit(c: *const Ctx, state: u64, x: Mat) !void {
+    comptime std.debug.assert(conv.state_rows == 3);
+    if (x.rows == 0) return;
+    if (x.dt != .bf16) return error.BadConvShape;
+    // only the last three rows can stay
+    const xs = if (x.rows > conv.state_rows) x.slice(x.rows - conv.state_rows, conv.state_rows) else x;
+    const C = x.cols;
+    var a: cuda.Args = .{};
+    a.add(state);
+    a.add(xs.ptr);
+    a.add(@as(i64, @intCast(xs.ld)));
+    a.add(@as(i32, @intCast(xs.rows)));
+    a.add(@as(i32, @intCast(C)));
+    try cuda.launch.launch(c.k.conv.commit_fn, .{ .grid = .{ .x = @intCast((C + 255) / 256), .y = 1, .z = 1 }, .block = .{ .x = 256, .y = 1, .z = 1 } }, c.stream, &a);
+}
+
+/// h_in [R, H] bf16 as the next completed block.
+pub fn pushBlock(c: *const Ctx, a: *Act, h_in: Mat) !void {
+    if (a.nblocks >= max_blocks) return error.TooManyBlocks;
+    try c.copyRows(a.block(a.nblocks, h_in.rows), h_in);
+    a.nblocks += 1;
+}
+
+test "inkling2 cuda state: ring slots of a sliding layer cover every row's window" {
+    // a forward of R rows at pos0 writes slots of pos0 .. pos0+R-1; row pos0 still needs pos0 - 1023
+    const R = 300;
+    const slots = attn.window - 1 + R;
+    const pos0 = 5000;
+    // the oldest position still needed is pos0 - 1023; the newest written is pos0 + R - 1
+    try std.testing.expect((pos0 + R - 1) - (pos0 - (attn.window - 1)) < slots);
+}
+
+test "inkling2 cuda state: a slot's pages are one run only when every id follows the one before" {
+    try std.testing.expectEqual(@as(?u32, 7), runStart(&.{ 7, 8, 9 }));
+    try std.testing.expectEqual(@as(?u32, 0), runStart(&.{0}));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{ 7, 8, 10 }));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{ 8, 7 }));
+    try std.testing.expectEqual(@as(?u32, null), runStart(&.{}));
+}
diff --git a/zig/src/families/inkling2/cuda_synth.zig b/zig/src/families/inkling2/cuda_synth.zig
new file mode 100644
index 0000000000000000000000000000000000000000..6a5507e6c5a5242fd3398028444670b149cad414
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_synth.zig
@@ -0,0 +1,212 @@
+//! Tooling (tf-inkling2-decode --exp deep --fill synth): a slot's state for positions 0 .. D - 1 written directly
+//! with deterministic synthetic values, no forward: every layer's keys and values (a global layer's positions
+//! 0 .. D - 1, a sliding layer's whole ring), its four convolution states, and with the drafter the slot's draft
+//! caches (every layer's rows; a local layer's mirrored rows kept equal to the rows they mirror). A decode step at D
+//! then reads them as it reads a prefill's, so decode rows against one prompt forward over the same positions check
+//! the indexing, grids, op scratch and log scaling of a 1M-position slot exactly in minutes, where a real prefill to
+//! 1M takes hours.
+//!
+//! The values: one pattern of `elems` (a prime) bf16 values, about N(0, 1) (a sum of four uniforms), from a fixed
+//! seed, laid over each buffer from its own offset (rank, layer, buffer): byte b of a buffer is the pattern's byte
+//! (offset + b) mod `bytes`. A prime period keeps a row's bytes from repeating at any power-of-two distance, so a
+//! read or write off by a wrapped 32-bit offset lands on other values. `check` reads the global layers' positions
+//! 0 .. D - 1 back against the pattern after the experiment: no forward wrote below D.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const state = @import("cuda_state.zig");
+const conv = @import("cuda_conv.zig");
+const weights = @import("cuda_weights.zig");
+const dspark = @import("cuda_dspark.zig");
+
+/// bf16 values in the pattern (a prime), and its bytes.
+pub const elems: usize = 8_388_593;
+pub const bytes: usize = 2 * elems;
+const seed: u64 = 0x1f2e3d4c5b6a7988;
+
+/// The pattern on the host (`bytes` bytes; the caller frees it).
+pub fn pattern(gpa: std.mem.Allocator) ![]u8 {
+    const out = try gpa.alloc(u8, bytes);
+    errdefer gpa.free(out);
+    var rng = std.Random.DefaultPrng.init(seed);
+    const r = rng.random();
+    for (0..elems) |i| {
+        const u = r.int(u64);
+        var s: f32 = 0;
+        inline for (0..4) |j| s += @as(f32, @floatFromInt((u >> (16 * j)) & 0xffff)) / 65536.0 - 0.5;
+        // the sum of four uniforms has variance 1/3: scaled to about N(0, 1), within +-3.47
+        const x: f32 = s * 1.7320508;
+        const b: u32 = @bitCast(x);
+        const h: u16 = @intCast((b + 0x7fff + ((b >> 16) & 1)) >> 16); // round to nearest even
+        std.mem.writeInt(u16, out[2 * i ..][0..2], h, .little);
+    }
+    return out;
+}
+
+/// Buffer `which` of layer `layer` (or the drafter's) on rank `rank`: its byte offset into the pattern (even, so
+/// every bf16 stays whole).
+pub fn offset(rank: u32, layer: usize, which: usize) usize {
+    var h = std.hash.Wyhash.init(seed);
+    h.update(std.mem.asBytes(&rank));
+    h.update(std.mem.asBytes(&layer));
+    h.update(std.mem.asBytes(&which));
+    return 2 * @as(usize, @intCast(h.final() % elems));
+}
+
+/// `n` bytes at `dst` from the pattern on the device (`pat`) from byte `off`, wrapping.
+fn lay(c: *const ops.Ctx, pat: u64, dst: u64, n: usize, off: usize) !void {
+    var done: usize = 0;
+    var at = off;
+    while (done < n) {
+        const k = @min(n - done, bytes - at);
+        try c.copy(dst + done, pat + at, k);
+        done += k;
+        at = 0;
+    }
+}
+
+/// Buffers a layer's fill takes, in order: keys, values, then the four convolution states.
+const kv_k = 0;
+const kv_v = 1;
+const conv0 = 2;
+/// The drafter's layers (`which` = drafter_which + 2 l for keys, + 1 for values), after every target layer's.
+const drafter_which = 64;
+
+/// Rows of layer `l`'s keys (and values) the fill writes: a global layer's positions 0 .. positions - 1, a sliding
+/// layer's every ring slot.
+fn kvRows(st: *const state.State, l: usize, positions: usize) usize {
+    const kv = st.layers[l].kv;
+    return if (kv.window == 0) positions else kv.slots;
+}
+
+/// Slot `st` (on rank `rank`) as if positions 0 .. positions - 1 had run, with the pattern's values (see the top);
+/// `caches` the slot's draft caches when the drafter is loaded. Leaves the slot's position to the caller.
+pub fn fill(gpa: std.mem.Allocator, c: *const ops.Ctx, st: *const state.State, caches: ?*const dspark.Caches, rank: u32, positions: usize) !void {
+    const host = try pattern(gpa);
+    defer gpa.free(host);
+    var pat = try cuda.DeviceBuffer.fromHost(c.d, host);
+    defer pat.free();
+    for (st.layers, 0..) |l, i| {
+        const layer = @as(usize, st.first) + i;
+        const row = l.kv.heads * weights.head_dim * 2;
+        if (l.kv.paged()) {
+            // on pages: positions 0 .. positions - 1 a run of the slot's pages at a time, the pattern from where a
+            // window's row would take it
+            var runs = state.RowRuns.of(l.kv, st.ids, 0, positions);
+            while (try runs.next()) |r| {
+                try lay(c, pat.ptr, r.k, r.n * row, (offset(rank, layer, kv_k) + r.pos * row) % bytes);
+                try lay(c, pat.ptr, r.v, r.n * row, (offset(rank, layer, kv_v) + r.pos * row) % bytes);
+            }
+        } else {
+            const n = kvRows(st, i, positions) * row;
+            try lay(c, pat.ptr, l.kv.k, n, offset(rank, layer, kv_k));
+            try lay(c, pat.ptr, l.kv.v, n, offset(rank, layer, kv_v));
+        }
+        for ([4]u64{ l.conv_k, l.conv_v, l.conv_attn, l.conv_mlp }, [4]usize{ row, row, weights.hidden * 2, weights.hidden * 2 }, 0..) |p, w, j| {
+            try lay(c, pat.ptr, p, conv.state_rows * w, offset(rank, layer, conv0 + j));
+        }
+    }
+    if (caches) |dc| for (0..dspark.nlayers) |l| {
+        if (!dspark.local[l]) if (dc.pagedKv(st.ids.len)) |kv| {
+            // the global layer on pages (stage 2c): positions 0 .. positions - 1, the pattern from where its row in
+            // the slot's own table would take it
+            var runs = state.RowRuns.of(kv, st.ids, 0, @min(positions, st.limit()));
+            while (try runs.next()) |r| {
+                try lay(c, pat.ptr, r.k, r.n * dc.row, (offset(rank, 0, drafter_which + 2 * l) + r.pos * dc.row) % bytes);
+                try lay(c, pat.ptr, r.v, r.n * dc.row, (offset(rank, 0, drafter_which + 2 * l + 1) + r.pos * dc.row) % bytes);
+            }
+            continue;
+        };
+        for ([2]u64{ dc.keys(l), dc.values(l) }, 0..) |p, j| {
+            try lay(c, pat.ptr, p, dc.rows(l) * dc.row, offset(rank, 0, drafter_which + 2 * l + j));
+            // a ring's first `window` rows are mirrored after it (cuda_dspark.zig localRows): keep them equal
+            const ring = dc.wrap(l);
+            if (ring > 0) try c.copy(p + ring * dc.row, p, dspark.window * dc.row);
+        }
+    };
+    try c.stream.synchronize();
+}
+
+/// What `check` found: bytes compared and the first position whose row differs from the pattern (null: none).
+/// `ranks_bad`: the ranks whose own check found a row unequal (every rank's, gathered by Engine.synthCheck).
+pub const Checked = struct { bytes: u64 = 0, layers: u32 = 0, bad: ?usize = null, bad_layer: usize = 0, ranks_bad: u32 = 0 };
+
+/// The global layers' keys and values of positions 0 .. positions - 1 read back against the pattern.
+/// TF_INK2_SYNTH_FAULT=R (tests): rank R reads its first global layer's first key byte flipped, as a changed row.
+pub fn check(gpa: std.mem.Allocator, c: *const ops.Ctx, st: *const state.State, rank: u32, positions: usize) !Checked {
+    try c.stream.synchronize();
+    const fault = if (std.c.getenv("TF_INK2_SYNTH_FAULT")) |v| (std.fmt.parseInt(u32, std.mem.span(v), 10) catch std.math.maxInt(u32)) == rank else false;
+    const host = try pattern(gpa);
+    defer gpa.free(host);
+    const chunk: usize = 64 << 20;
+    const buf = try gpa.alloc(u8, chunk);
+    defer gpa.free(buf);
+    var out: Checked = .{};
+    for (st.layers, 0..) |l, i| {
+        if (l.kv.window != 0) continue;
+        const layer = @as(usize, st.first) + i;
+        const row = l.kv.heads * weights.head_dim * 2;
+        out.layers += 1;
+        for ([2]usize{ kv_k, kv_v }) |which| {
+            const n = positions * row;
+            const off = offset(rank, layer, which);
+            var at: usize = 0;
+            while (at < n) {
+                // the next run of contiguous rows from logical byte `at` (a window: all of it; pages: a run of them)
+                var runs = state.RowRuns.of(l.kv, st.ids, at / row, positions);
+                const r = (try runs.next()).?;
+                const p = if (which == kv_k) r.k else r.v;
+                const k = @min(r.n * row, chunk - chunk % row);
+                try cuda.memory.download(c.d, p, buf[0..k]);
+                if (fault and out.layers == 1 and which == kv_k and at == 0) buf[0] ^= 1;
+                // compare against the pattern from (off + at) mod bytes, a wrap at a time
+                var done: usize = 0;
+                while (done < k) {
+                    const from = (off + at + done) % bytes;
+                    const m = @min(k - done, bytes - from);
+                    if (!std.mem.eql(u8, buf[done..][0..m], host[from..][0..m])) {
+                        var j: usize = 0;
+                        while (buf[done + j] == host[from + j]) j += 1;
+                        const pos = (at + done + j) / row;
+                        if (out.bad == null or pos < out.bad.?) {
+                            out.bad = pos;
+                            out.bad_layer = layer;
+                        }
+                        break;
+                    }
+                    done += m;
+                }
+                out.bytes += k;
+                at += k;
+            }
+        }
+    }
+    return out;
+}
+
+test "inkling2 synth: the pattern is fixed, about N(0, 1), and offsets are even and inside it" {
+    const gpa = std.testing.allocator;
+    const p = try pattern(gpa);
+    defer gpa.free(p);
+    var sum: f64 = 0;
+    var sq: f64 = 0;
+    for (0..elems) |i| {
+        const h = std.mem.readInt(u16, p[2 * i ..][0..2], .little);
+        const x: f32 = @bitCast(@as(u32, h) << 16);
+        try std.testing.expect(std.math.isFinite(x) and @abs(x) < 3.5);
+        sum += x;
+        sq += x * x;
+    }
+    const n: f64 = @floatFromInt(elems);
+    try std.testing.expect(@abs(sum / n) < 0.01 and @abs(sq / n - 1) < 0.02);
+    const q = try pattern(gpa);
+    defer gpa.free(q);
+    try std.testing.expectEqualSlices(u8, p, q);
+    for (0..4) |r| for (0..48) |l| for (0..6) |w| {
+        const o = offset(@intCast(r), l, w);
+        try std.testing.expect(o % 2 == 0 and o < bytes);
+    };
+    try std.testing.expect(offset(0, 3, 0) != offset(1, 3, 0) and offset(0, 3, 0) != offset(0, 3, 1));
+    var d: usize = 2;
+    while (d * d <= elems) : (d += 1) try std.testing.expect(elems % d != 0);
+}
diff --git a/zig/src/families/inkling2/cuda_tp.zig b/zig/src/families/inkling2/cuda_tp.zig
new file mode 100644
index 0000000000000000000000000000000000000000..c4bb3b531d69234f7959f7d93b3754d0a3def692
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_tp.zig
@@ -0,0 +1,248 @@
+//! W > 1: a rank's two exchanges a layer. Rank r holds query heads [r*48/W, ...), key heads [r*8/W, ...) and experts
+//! [r*384/W, ...) (plan.zig); the rest of a layer is replicated. The output projection over the rank's heads and the
+//! combine over its experts each leave an fp32 partial [R, H]; every rank's partial is all-gathered in rank order
+//! and every rank adds them rank 0 first and rounds to bf16 once (res.rankSum), so every rank holds the same bits
+//! after each sum and the router picks the same experts on every rank.
+//!
+//! Split experts (plan.Layout.split, checkpoint mode): the MoE's rank-order sum gives way to two gathers a layer
+//! (cuda_moe.zig `splitUp` / `splitDown`): MoE-A, every rank's h columns [R * 8, I/W] bf16 into [W][R * 8][I/W], and
+//! MoE-B, every rank's output columns [R, H/W] bf16 into [W][R][H/W], laid out as rows by `columns`. No rank sums
+//! anything another rank computed, so every rank holds the same bits, equal to W = 1's. Each gather's size depends on R
+//! only, and nothing waits on the host inside a layer.
+//!
+//! Real ranks (one process a rank) gather over NCCL (cuda/tp_group.zig, a blocking communicator bootstrapped from
+//! NCCL_COMM_ID). Virtual ranks (all ranks in one process, one after another on one card) share the partial
+//! buffers, so nothing moves: each writes its own slot and the sum reads them all.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const res = @import("cuda_res.zig");
+const weights = @import("cuda_weights.zig");
+const moe = @import("cuda_moe.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+
+/// The layer's two sums: after the output projection and after the experts.
+pub const Sum = enum(u1) { attn, moe };
+
+/// The partials of both sums: fp32 [world][R][H] each, for forwards of at most `cap` rows. Two buffers, so a virtual
+/// rank's MoE partial never lands on an attention partial a later virtual rank has still to add.
+pub const Parts = struct {
+    ptr: [2]u64,
+    world: u32,
+    cap: usize,
+    own: ?[2]cuda.DeviceBuffer = null,
+    /// Split experts: the MoE-A and MoE-B gather buffers and the route plan in place of the MoE partials.
+    split: ?Split = null,
+
+    pub const Split = struct {
+        /// bf16 [world][cap * 8][I / world]
+        h: u64,
+        /// bf16 [world][cap][H / world]
+        y: u64,
+        /// cuda_moe.zig splitPlanBytes(cap)
+        plan: u64,
+        own: [3]cuda.DeviceBuffer,
+        bytes: usize,
+    };
+
+    /// `layout` whole: both sums' fp32 partials; split: the attention partials and the split experts' buffers.
+    pub fn init(d: *const cuda.Driver, world: u32, cap: usize) !Parts {
+        return initFor(d, world, cap, .whole);
+    }
+
+    pub fn initFor(d: *const cuda.Driver, world: u32, cap: usize, layout: @import("inkling2").plan.Layout) !Parts {
+        const n = @as(usize, world) * cap * H * 4;
+        var a = try cuda.DeviceBuffer.alloc(d, n);
+        errdefer a.free();
+        if (layout == .whole) {
+            const b = try cuda.DeviceBuffer.alloc(d, n);
+            return .{ .ptr = .{ a.ptr, b.ptr }, .world = world, .cap = cap, .own = .{ a, b } };
+        }
+        const sizes = [3]usize{ cap * moe.topk * moe.intermediate * 2, cap * H * 2, moe.splitPlanBytes(cap) };
+        var own: [3]cuda.DeviceBuffer = undefined;
+        var made: usize = 0;
+        errdefer for (own[0..made]) |*b| b.free();
+        for (&own, sizes) |*b, size| {
+            b.* = try cuda.DeviceBuffer.alloc(d, size);
+            made += 1;
+        }
+        const empty = try cuda.DeviceBuffer.alloc(d, 0); // no MoE partials: address 0, nothing held
+        return .{ .ptr = .{ a.ptr, 0 }, .world = world, .cap = cap, .own = .{ a, empty }, .split = .{ .h = own[0].ptr, .y = own[1].ptr, .plan = own[2].ptr, .own = own, .bytes = sizes[0] + sizes[1] + sizes[2] } };
+    }
+
+    pub fn deinit(p: *Parts) void {
+        if (p.own) |*o| for (o) |*b| b.free();
+        p.own = null;
+        if (p.split) |*x| for (&x.own) |*b| b.free();
+        p.split = null;
+    }
+
+    pub fn bytes(p: *const Parts) usize {
+        const whole = @as(usize, p.world) * p.cap * H * 4;
+        return if (p.split) |x| whole + x.bytes else 2 * whole;
+    }
+};
+
+/// TF_INK2_TIME_EXCHANGE=1: every real-rank gather waits for its stream before and after, and its wall time (the
+/// transfer plus the wait for the slowest rank) is counted here per sum; the runner prints the totals.
+pub const Timing = struct {
+    pub var on: ?bool = null;
+    pub var ns: [2]u64 = .{ 0, 0 };
+    pub var calls: [2]u64 = .{ 0, 0 };
+
+    pub fn enabled() bool {
+        if (on == null) on = if (std.c.getenv("TF_INK2_TIME_EXCHANGE")) |v| v[0] == '1' else false;
+        return on.?;
+    }
+
+    pub fn now() u64 {
+        var t: std.c.timespec = undefined;
+        _ = std.c.clock_gettime(std.c.CLOCK.MONOTONIC, &t);
+        return @as(u64, @intCast(t.sec)) * std.time.ns_per_s + @as(u64, @intCast(t.nsec));
+    }
+};
+
+pub const Exchange = struct {
+    rank: u32,
+    world: u32,
+    parts: *const Parts,
+    /// Real ranks: the group the partials are gathered over; null: virtual ranks (shared buffers).
+    group: ?*const cuda.tp_group.Group = null,
+
+    fn base(x: *const Exchange, s: Sum) u64 {
+        return x.parts.ptr[@intFromEnum(s)];
+    }
+
+    /// This rank's partial of sum `s` for a forward of R rows (its slot of [world][R][H]).
+    pub fn mine(x: *const Exchange, s: Sum, R: usize) Mat {
+        return Mat.of(x.base(s) + @as(u64, x.rank) * R * H * 4, R, H, .f32);
+    }
+
+    /// Every rank's partial into every rank's buffer, rank order (real ranks; virtual ranks share the buffer).
+    pub fn gather(x: *const Exchange, c: *const Ctx, s: Sum, R: usize) !void {
+        if (R > x.parts.cap) return error.ExchangeTooSmall;
+        if (s == .moe and x.parts.split != null) return error.SplitExpertsGatherTwice;
+        const g = x.group orelse return;
+        if (!Timing.enabled()) return g.allGather(c.stream, x.mine(s, R).ptr, x.base(s), R * H * 4);
+        try c.stream.synchronize();
+        const t = Timing.now();
+        try g.allGather(c.stream, x.mine(s, R).ptr, x.base(s), R * H * 4);
+        try c.stream.synchronize();
+        Timing.ns[@intFromEnum(s)] += Timing.now() - t;
+        Timing.calls[@intFromEnum(s)] += 1;
+    }
+
+    /// out bf16 [R, H] = bf16(partial_0 + partial_1 + ...), rank order.
+    pub fn sum(x: *const Exchange, c: *const Ctx, s: Sum, out: Mat) !void {
+        try res.rankSum(c, x.base(s), x.world, out);
+    }
+
+    /// The split experts' buffers (null: whole experts).
+    pub fn split(x: *const Exchange) ?Parts.Split {
+        return x.parts.split;
+    }
+
+    /// Split experts: this rank's h [R * 8, I/W] (its slot of MoE-A's [W][R * 8][I/W]).
+    pub fn hMine(x: *const Exchange, R: usize) u64 {
+        return x.parts.split.?.h + @as(u64, x.rank) * R * moe.topk * (moe.intermediate / x.world) * 2;
+    }
+
+    /// Split experts: this rank's output columns [R, H/W] (its slot of MoE-B's [W][R][H/W]).
+    pub fn yMine(x: *const Exchange, R: usize) u64 {
+        return x.parts.split.?.y + @as(u64, x.rank) * R * (H / x.world) * 2;
+    }
+
+    /// Split experts: MoE-A (`.h`) or MoE-B (`.y`) for a forward of R rows, every rank's slot into every rank's buffer,
+    /// rank order (real ranks; virtual ranks share the buffers). Timed with the MoE sum (TF_INK2_TIME_EXCHANGE).
+    pub fn gatherSplit(x: *const Exchange, c: *const Ctx, which: enum { h, y }, R: usize) !void {
+        if (R > x.parts.cap) return error.ExchangeTooSmall;
+        const sp = x.parts.split orelse return error.NotSplitExperts;
+        const g = x.group orelse return;
+        const own, const all, const n = switch (which) {
+            .h => .{ x.hMine(R), sp.h, R * moe.topk * (moe.intermediate / x.world) * 2 },
+            .y => .{ x.yMine(R), sp.y, R * (H / x.world) * 2 },
+        };
+        if (!Timing.enabled()) return g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        const t = Timing.now();
+        try g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        Timing.ns[1] += Timing.now() - t;
+        Timing.calls[1] += 1;
+    }
+
+    /// Split experts, after MoE-B: out bf16 [R, H], every rank's columns in place.
+    pub fn columns(x: *const Exchange, c: *const Ctx, out: Mat) !void {
+        try moe.splitColumns(c, x.parts.split.?.y, x.world, out);
+    }
+
+    /// MoE-A as codes (TF_INK2_XCODES, cuda_moe.zig splitQuant): the gather's slots [W][codesSlot] and then every
+    /// rank's segment amax [W][R * 8] fp32 sit in the attention sum's partial buffer, which holds nothing live from
+    /// the attention sum's end to the down pass (the next layer's output projection writes it again). Its size, W * cap
+    /// rows of H fp32, holds both for every R <= cap at W >= 2 (codesFit).
+    pub fn codesAll(x: *const Exchange) u64 {
+        return x.base(.attn);
+    }
+
+    pub fn codesMine(x: *const Exchange, nv: bool, R: usize) u64 {
+        return x.codesAll() + @as(u64, x.rank) * moe.codesSlot(nv, x.world, R * moe.topk);
+    }
+
+    pub fn amaxAll(x: *const Exchange, R: usize) u64 {
+        // after the larger (MXFP8) slots, 256-byte aligned: one place for both formats
+        const slots = @as(usize, x.world) * moe.codesSlot(false, x.world, R * moe.topk);
+        return x.codesAll() + std.mem.alignForward(usize, slots, 256);
+    }
+
+    pub fn amaxMine(x: *const Exchange, R: usize) u64 {
+        return x.amaxAll(R) + @as(u64, x.rank) * R * moe.topk * 4;
+    }
+
+    /// Whether the codes and amaxes of an R-row forward fit the attention partial buffer.
+    pub fn codesFit(x: *const Exchange, R: usize) bool {
+        const need = (x.amaxAll(R) - x.codesAll()) + @as(usize, x.world) * R * moe.topk * 4;
+        return R <= x.parts.cap and need <= @as(usize, x.world) * x.parts.cap * H * 4;
+    }
+
+    /// MoE-A as codes: every rank's quantized slot (`nv`: NVFP4 layer) or segment amax (`.amax`) into every rank's
+    /// buffer, rank order (real ranks; virtual ranks share the buffer). Timed with the MoE sum (TF_INK2_TIME_EXCHANGE).
+    pub fn gatherCodes(x: *const Exchange, c: *const Ctx, which: enum { codes, amax }, nv: bool, R: usize) !void {
+        if (!x.codesFit(R)) return error.ExchangeTooSmall;
+        const g = x.group orelse return;
+        const own, const all, const n = switch (which) {
+            .codes => .{ x.codesMine(nv, R), x.codesAll(), moe.codesSlot(nv, x.world, R * moe.topk) },
+            .amax => .{ x.amaxMine(R), x.amaxAll(R), R * moe.topk * 4 },
+        };
+        if (!Timing.enabled()) return g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        const t = Timing.now();
+        try g.allGather(c.stream, own, all, n);
+        try c.stream.synchronize();
+        Timing.ns[1] += Timing.now() - t;
+        Timing.calls[1] += 1;
+    }
+};
+
+test "inkling2 cuda tp: MoE-A's codes and amaxes fit the attention partials" {
+    const parts: Parts = .{ .ptr = .{ 1 << 30, 0 }, .world = 4, .cap = 2048 };
+    for ([_]u32{ 2, 4 }) |W| for ([_]usize{ 1, 576, 2047, 2048 }) |R| {
+        var p = parts;
+        p.world = W;
+        const x: Exchange = .{ .rank = W - 1, .world = W, .parts = &p };
+        try std.testing.expect(x.codesFit(R));
+        // the last rank's amax ends inside the buffer, after every rank's codes (either format)
+        try std.testing.expect(x.amaxMine(R) + R * moe.topk * 4 <= x.codesAll() + @as(usize, W) * p.cap * H * 4);
+        try std.testing.expect(x.codesMine(false, R) + moe.codesSlot(false, W, R * moe.topk) <= x.amaxAll(R));
+    };
+}
+
+test "inkling2 cuda tp: a rank's slot of the partials" {
+    const parts: Parts = .{ .ptr = .{ 1 << 30, 2 << 30 }, .world = 4, .cap = 32 };
+    const x: Exchange = .{ .rank = 2, .world = 4, .parts = &parts };
+    try std.testing.expectEqual(@as(u64, (2 << 30) + 2 * 25 * H * 4), x.mine(.moe, 25).ptr);
+    try std.testing.expect(x.mine(.attn, 25).is(25, H, .f32));
+    try std.testing.expectEqual(@as(usize, 2 * 4 * 32 * H * 4), parts.bytes());
+}
diff --git a/zig/src/families/inkling2/cuda_vision.zig b/zig/src/families/inkling2/cuda_vision.zig
new file mode 100644
index 0000000000000000000000000000000000000000..d17c8ab2f33c73251062963750b5938affe188c1
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_vision.zig
@@ -0,0 +1,1163 @@
+//! Inkling-2's vision tower on one GPU (FABLE-IMAGE-INPUT-DESIGN 1.3, 2.2): RGB bytes and (H, W) to the T rows of
+//! 4,608 the text model takes at the image's tokens. The ops are inkling2_vision.cu's (patches, position sum, class
+//! row, LayerNorm, rotary, epilogues, the reference attention core) around the lane matmul (cuda/qmmf.zig, BF16 mode)
+//! for the 95 packed projections (patch embedding, 23 x fused q|k|v, out, fc1, fc2, the merger's two).
+//!
+//! Rounding points are torch's: each projection rounds once to bf16 after its bias; layer scale and residual are two
+//! bf16 roundings; GELU is torch's erf form in fp32. Every projection and epilogue runs on at most `row_block` rows a
+//! call and the attention core on at most `q_block` query rows a call; neither changes a bit (the lane's sums do not
+//! depend on the row count, the core's on the query block). A tower run can be cut into steps of whole layers
+//! (begin, step, finish) with the state held on the device between them.
+//!
+//! Engine mode (Options.own_work false, the serving engine's rank 0): the tower keeps only its weights and the
+//! residual stream `x` of the image in flight; every other buffer is borrowed per unit (`bindSlice`: begin, a run of
+//! layers, the merger) from a region the caller lends, the engine's op scratch between forwards, which holds nothing
+//! across units: the rotary tables are recomputed at each layer unit (the same kernel on the same inputs), and the
+//! merger writes the rows where the caller says (`finishInto`).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+
+const st = ink.st;
+const Weight = cuda.qmmf.Weight;
+const Stream = cuda.Stream;
+
+pub const hidden = 1024;
+pub const heads = 16;
+pub const head_dim = 64;
+pub const layers = 23;
+pub const inter = 4096;
+pub const proj_hidden = 4096;
+pub const out_width = 4608;
+pub const block = 40; // pixels a token side
+pub const patch = 20;
+pub const features = 3 * patch * patch; // 1200
+pub const features_pad = 1216; // the lane's K: a multiple of 64
+pub const grid_side = 32; // the position table's side
+pub const eps: f32 = 1e-5;
+pub const tensors = 422;
+const prefix = "model.visual.";
+
+/// torch's inv_freq (compute_axial_rope_parameters: 1 / 10000 ** (arange(0, 32, 2) / 32), fp32 on the CPU), as bits.
+pub const inv_freq_bits = [16]u32{
+    0x3f800000, 0x3f0ff59a, 0x3ea1e89b, 0x3e361887, 0x3dcccccd, 0x3d6655c2, 0x3d0186e3, 0x3c91ad39,
+    0x3c23d70a, 0x3bb8449c, 0x3b4f3e38, 0x3ae91528, 0x3a83126f, 0x3a136a16, 0x39a5cb60, 0x393a7753,
+};
+
+/// The 16 rotary frequencies as torch computes them: pow in fp32 (correctly rounded here through f64), then 1 / x
+/// in fp32. Checked against `inv_freq_bits` when a tower loads.
+pub fn invFreq() [16]f32 {
+    var out: [16]f32 = undefined;
+    for (&out, 0..) |*f, j| {
+        const e: f32 = @as(f32, @floatFromInt(2 * j)) / 32.0;
+        const p: f32 = @floatCast(std.math.pow(f64, 10000.0, @as(f64, e)));
+        f.* = 1.0 / p;
+    }
+    return out;
+}
+
+/// The processor's fp32 value of a byte, (x - 127.5) / 127.5, and at 256 the padding's, (-1 - 127.5) / 127.5.
+pub fn pixelTable() [257]f32 {
+    var t: [257]f32 = undefined;
+    for (0..256) |b| {
+        const x: f32 = @floatFromInt(b);
+        t[b] = (x - 127.5) / 127.5;
+    }
+    const pad: f32 = -1.0;
+    t[256] = (pad - 127.5) / 127.5;
+    return t;
+}
+
+/// Tokens a side: ceil(H / 40) rows, ceil(W / 40) cols.
+pub const Grid = struct {
+    rows: usize,
+    cols: usize,
+
+    pub fn of(h: usize, w: usize) Grid {
+        return .{ .rows = (h + block - 1) / block, .cols = (w + block - 1) / block };
+    }
+    pub fn tokens(g: Grid) usize {
+        return g.rows * g.cols;
+    }
+    pub fn patches(g: Grid) usize {
+        return 4 * g.tokens();
+    }
+    /// Tower rows: the class row, then the patches.
+    pub fn towerRows(g: Grid) usize {
+        return 4 * g.tokens() + 1;
+    }
+};
+
+/// One axis of transformers' vision_utils _interpolation_axis_taps_weights (bilinear, align_corners False, border):
+/// src = (i + 0.5) * 32 / size - 0.5 in fp32, taps floor and floor + 1 clamped, weights max(0, 1 - |src - floor - o|).
+fn axisTaps(i: usize, size: usize, taps: *[2]i32, w: *[2]f32) void {
+    const side: f32 = grid_side;
+    const src: f32 = ((@as(f32, @floatFromInt(i)) + 0.5) * side) / @as(f32, @floatFromInt(size)) - 0.5;
+    const fl = @floor(src);
+    const base: i64 = @intFromFloat(fl);
+    for (0..2) |o| {
+        taps[o] = @intCast(std.math.clamp(base + @as(i64, @intCast(o)), 0, grid_side - 1));
+        const dist = @abs((src - fl) - @as(f32, @floatFromInt(o)));
+        w[o] = @max(1.0 - dist, 0.0);
+    }
+}
+
+/// get_vision_interpolation_indices_and_weights(merge 2) for one image: patch p (block order) gets 4 table rows and
+/// 4 fp32 weights in tap order (h0 w0, h0 w1, h1 w0, h1 w1). idx and w hold 4 * patches each.
+pub fn positionTaps(g: Grid, idx: []i32, w: []f32) void {
+    const ph = 2 * g.rows;
+    const pw = 2 * g.cols;
+    for (0..g.patches()) |p| {
+        const t = p / 4;
+        const in = p % 4;
+        const row = 2 * (t / g.cols) + in / 2;
+        const col = 2 * (t % g.cols) + in % 2;
+        var ht: [2]i32 = undefined;
+        var hw: [2]f32 = undefined;
+        var wt: [2]i32 = undefined;
+        var ww: [2]f32 = undefined;
+        axisTaps(row, ph, &ht, &hw);
+        axisTaps(col, pw, &wt, &ww);
+        for (0..2) |a| for (0..2) |b| {
+            idx[4 * p + 2 * a + b] = ht[a] * grid_side + wt[b];
+            w[4 * p + 2 * a + b] = hw[a] * ww[b];
+        };
+    }
+}
+
+pub const Core = enum { ref, tc };
+
+pub const Options = struct {
+    /// rows a projection or epilogue call takes at most
+    row_block: usize = 2048,
+    /// query rows an attention core call takes at most
+    q_block: usize = 2048,
+    core: Core = .tc,
+    /// the longest image side the buffers hold
+    max_side: usize = 4096,
+    /// the tower allocates every buffer of an image (the tool); false: engine mode, only `x` resident and the rest
+    /// borrowed per unit (`bindSlice`)
+    own_work: bool = true,
+};
+
+/// What `Tower.load` takes beside the file: the content-digest manifest's text (each of the 422 tensors checked by
+/// name, len and xxh64 against `rank`'s lines, digests.checkNamed), and a device region the projections' staging may
+/// borrow (36 MiB; the engine's op scratch, idle at start-up) instead of allocating its own.
+pub const LoadArgs = struct {
+    manifest: ?[]const u8 = null,
+    rank: u32 = 0,
+    stage: ?cuda.DeviceBuffer = null,
+};
+
+/// An engine-mode unit's borrowed buffers (`bindSlice`): E1 .. E5, a run of layers, or the merger.
+pub const Phase = enum { begin, layer, merger };
+
+/// inkling2_vision.cu's kernels; `attn_tc` when the image holds inkling2_vision_attn.cuh's tf_iv_attn.
+pub const Kernels = struct {
+    mod: cuda.Module,
+    patchify: cuda.Function,
+    embed: cuda.Function,
+    class: cuda.Function,
+    layer_norm: cuda.Function,
+    rope_table: cuda.Function,
+    rotary_fn: cuda.Function,
+    bias: cuda.Function,
+    bias_gelu: cuda.Function,
+    bias_ls_res: cuda.Function,
+    ls_res: cuda.Function,
+    gelu_fn: cuda.Function,
+    gather: cuda.Function,
+    attn_ref: cuda.Function,
+    attn_tc: ?cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        if (!cuda.kernels.available) return error.BuiltWithoutKernels;
+        var mod = try cuda.Module.load(d, cuda.kernels.inkling2_vision);
+        errdefer mod.unload();
+        return .{
+            .mod = mod,
+            .patchify = try mod.function("tf_iv_patchify"),
+            .embed = try mod.function("tf_iv_embed"),
+            .class = try mod.function("tf_iv_class"),
+            .layer_norm = try mod.function("tf_iv_layer_norm"),
+            .rope_table = try mod.function("tf_iv_rope_table"),
+            .rotary_fn = try mod.function("tf_iv_rotary"),
+            .bias = try mod.function("tf_iv_bias"),
+            .bias_gelu = try mod.function("tf_iv_bias_gelu"),
+            .bias_ls_res = try mod.function("tf_iv_bias_ls_res"),
+            .ls_res = try mod.function("tf_iv_ls_res"),
+            .gelu_fn = try mod.function("tf_iv_gelu"),
+            .gather = try mod.function("tf_iv_gather"),
+            .attn_ref = try mod.function("tf_iv_attn_ref"),
+            .attn_tc = optionalFunction(d, mod, "tf_iv_attn"),
+        };
+    }
+
+    /// A kernel the image may lack (the tensor-core core): null when cuModuleGetFunction does not find it.
+    fn optionalFunction(d: *const cuda.Driver, mod: cuda.Module, name: [:0]const u8) ?cuda.Function {
+        var f: cuda.abi.Function = null;
+        if (d.api.cuModuleGetFunction(&f, mod.handle, name.ptr) != cuda.abi.success) return null;
+        return .{ .d = d, .handle = f };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.mod.unload();
+    }
+
+    fn go(f: cuda.Function, s: Stream, gx: usize, gy: usize, threads: u32, a: *cuda.Args) !void {
+        if (gx == 0) return;
+        try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(gx), .y = @intCast(gy), .z = 1 }, .block = .{ .x = threads } }, s, a);
+    }
+
+    /// E1: patches p0 .. p0 + n of an H x W image (rgb bytes on the device) as bf16 rows [n][1216].
+    pub fn patchRows(k: *const Kernels, s: Stream, rgb: u64, table: u64, h: usize, w: usize, cols: usize, p0: usize, n: usize, out: u64) !void {
+        var a: cuda.Args = .{};
+        a.add(rgb);
+        a.add(table);
+        for ([_]usize{ h, w, cols, p0 }) |v| a.add(@as(i32, @intCast(v)));
+        a.add(out);
+        try go(k.patchify, s, n, 1, 256, &a);
+    }
+
+    /// E3 + E4: x[1 + p] for p = p0 .. p0 + n from e2 rows [n][1024] and the position taps.
+    pub fn embedRows(k: *const Kernels, s: Stream, e2: u64, table: u64, idx: u64, w: u64, p0: usize, n: usize, x: u64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ e2, table, idx, w }) |p| a.add(p);
+        a.add(@as(i32, @intCast(p0)));
+        a.add(x);
+        try go(k.embed, s, n, 1, 256, &a);
+    }
+
+    pub fn classRow(k: *const Kernels, s: Stream, cls: u64, cls_pos: u64, x: u64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ cls, cls_pos, x }) |p| a.add(p);
+        try go(k.class, s, 1, 1, 256, &a);
+    }
+
+    /// y [n][1024] = LayerNorm(x) * w + b (eps 1e-5); x and y must not overlap.
+    pub fn layerNorm(k: *const Kernels, s: Stream, x: u64, w: u64, b: u64, y: u64, n: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ x, w, b, y }) |p| a.add(p);
+        a.add(eps);
+        try go(k.layer_norm, s, n, 1, 256, &a);
+    }
+
+    /// cos, sin [S][32] of rows 0 .. S - 1 for a grid `cols` tokens wide; inv: 16 fp32 on the device.
+    pub fn ropeTable(k: *const Kernels, s: Stream, inv: u64, cols: usize, rows: usize, cs: u64, sn: u64) !void {
+        var a: cuda.Args = .{};
+        a.add(inv);
+        a.add(@as(i32, @intCast(cols)));
+        a.add(@as(i32, 0));
+        a.add(cs);
+        a.add(sn);
+        try go(k.rope_table, s, rows, 1, 32, &a);
+    }
+
+    /// L3 on rows r0 .. r0 + n of qkv (rows `ld` apart, q at +0, k at +1024) in place.
+    pub fn rotary(k: *const Kernels, s: Stream, qkv: u64, ld: usize, cs: u64, sn: u64, r0: usize, n: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(qkv);
+        a.add(@as(i32, @intCast(ld)));
+        a.add(cs);
+        a.add(sn);
+        a.add(@as(i32, @intCast(r0)));
+        try go(k.rotary_fn, s, n, 1, 256, &a);
+    }
+
+    /// o[r * ldo + c] = bf16(acc[r * n + c] + bias[c]) for `rows` rows.
+    pub fn biasRows(k: *const Kernels, s: Stream, acc: u64, bias: u64, o: u64, rows: usize, n: usize, ldo: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ acc, bias, o }) |p| a.add(p);
+        a.add(@as(i32, @intCast(n)));
+        a.add(@as(i32, @intCast(ldo)));
+        try go(k.bias, s, rows, (n + 255) / 256, 256, &a);
+    }
+
+    pub fn biasGelu(k: *const Kernels, s: Stream, acc: u64, bias: u64, o: u64, rows: usize, n: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ acc, bias, o }) |p| a.add(p);
+        a.add(@as(i32, @intCast(n)));
+        try go(k.bias_gelu, s, rows, (n + 255) / 256, 256, &a);
+    }
+
+    /// x [rows][1024] = bf16(x + bf16(ls * bf16(acc + bias))) in place.
+    pub fn biasLsRes(k: *const Kernels, s: Stream, acc: u64, bias: u64, ls: u64, x: u64, rows: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ acc, bias, ls, x }) |p| a.add(p);
+        try go(k.bias_ls_res, s, rows, hidden / 256, 256, &a);
+    }
+
+    /// x [rows][1024] = bf16(x + bf16(ls * y)) in place, y bf16.
+    pub fn lsRes(k: *const Kernels, s: Stream, y: u64, ls: u64, x: u64, rows: usize) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ y, ls, x }) |p| a.add(p);
+        try go(k.ls_res, s, rows, hidden / 256, 256, &a);
+    }
+
+    /// o [count] = bf16(gelu(x)); x may be o.
+    pub fn gelu(k: *const Kernels, s: Stream, x: u64, o: u64, count: usize) !void {
+        var a: cuda.Args = .{};
+        a.add(x);
+        a.add(o);
+        a.add(@as(i64, @intCast(count)));
+        try go(k.gelu_fn, s, (count + 255) / 256, 1, 256, &a);
+    }
+
+    /// out [n][1024] = x's rows at rows[0 .. n] (i32 on the device).
+    pub fn gatherRows(k: *const Kernels, s: Stream, x: u64, rows: u64, n: usize, out: u64) !void {
+        var a: cuda.Args = .{};
+        for ([_]u64{ x, rows, out }) |p| a.add(p);
+        try go(k.gather, s, n, 1, 256, &a);
+    }
+
+    /// L4 on query rows q0 .. q0 + qn of an S-row image: q, k, v (row r, head h, d) at base + r * ld + h * 64 + d;
+    /// out row r at out + (r - q0) * 1024 + h * 64 + d. `ref`: tf_iv_attn_ref; `tc`: tf_iv_attn (64 rows a CTA).
+    pub fn core(k: *const Kernels, s: Stream, which: Core, q: u64, kk: u64, v: u64, ld: usize, out: u64, rows: usize, q0: usize, qn: usize) !void {
+        if (qn == 0) return;
+        var a: cuda.Args = .{};
+        for ([_]u64{ q, kk, v }) |p| a.add(p);
+        a.add(@as(i32, @intCast(ld)));
+        a.add(out);
+        for ([_]usize{ rows, q0, qn }) |x| a.add(@as(i32, @intCast(x)));
+        switch (which) {
+            .ref => try go(k.attn_ref, s, (qn + 127) / 128, heads, 128, &a),
+            .tc => try go(k.attn_tc orelse return error.TcCoreAbsent, s, (qn + 63) / 64, heads, 128, &a),
+        }
+    }
+};
+
+/// One encoder layer's device tensors: norms, layer scales and biases (bf16), and its packed projections.
+pub const Layer = struct {
+    ln1_w: u64 = 0,
+    ln1_b: u64 = 0,
+    ln2_w: u64 = 0,
+    ln2_b: u64 = 0,
+    ls1: u64 = 0,
+    ls2: u64 = 0,
+    b_qkv: u64 = 0, // [3072]: q, k, v
+    b_o: u64 = 0,
+    b_fc1: u64 = 0,
+    b_fc2: u64 = 0,
+    qkv: Weight = undefined, // [3072, 1024]
+    o: Weight = undefined,
+    fc1: Weight = undefined,
+    fc2: Weight = undefined,
+};
+
+/// The device rows of a finished image: [tokens][4608] bf16.
+pub const Rows = struct { ptr: u64, tokens: usize };
+
+/// A small tensor's place in the vector buffer: bf16 elements, by checkpoint name.
+const Small = struct { name: []const u8, len: usize };
+
+/// Each layer's small tensors, in the vector buffer's order.
+const per_layer = [_]Small{
+    .{ .name = "ln_1.weight", .len = hidden },          .{ .name = "ln_1.bias", .len = hidden },
+    .{ .name = "ln_2.weight", .len = hidden },          .{ .name = "ln_2.bias", .len = hidden },
+    .{ .name = "ls_1.gamma", .len = hidden },           .{ .name = "ls_2.gamma", .len = hidden },
+    .{ .name = "self_attn.q_proj.bias", .len = hidden }, .{ .name = "self_attn.k_proj.bias", .len = hidden },
+    .{ .name = "self_attn.v_proj.bias", .len = hidden }, .{ .name = "self_attn.out_proj.bias", .len = hidden },
+    .{ .name = "mlp.c_fc.bias", .len = inter },         .{ .name = "mlp.c_proj.bias", .len = hidden },
+};
+/// The backbone's small tensors before the position table.
+const top = [_]Small{
+    .{ .name = "backbone.embeddings.class_embedding", .len = hidden },
+    .{ .name = "backbone.embeddings.cls_position_embedding", .len = hidden },
+    .{ .name = "backbone.ln_pre.weight", .len = hidden },
+    .{ .name = "backbone.ln_pre.bias", .len = hidden },
+};
+
+/// The vector buffer's bytes: the small tensors, the position table, the 257 pixel values and the 16 frequencies.
+fn vectorBytes() usize {
+    var per: usize = 0;
+    for (per_layer) |x| per += x.len;
+    return (top.len * hidden + grid_side * grid_side * hidden + layers * per) * 2 + 257 * 4 + 16 * 4;
+}
+
+fn laneBytes(n: usize, k: usize) usize {
+    return cuda.modelopt.padded(n) * k * 2;
+}
+
+/// The packed projections' bytes.
+fn projBytes() usize {
+    const per = laneBytes(3 * hidden, hidden) + laneBytes(hidden, hidden) + laneBytes(inter, hidden) + laneBytes(hidden, inter);
+    return laneBytes(hidden, features_pad) + layers * per + laneBytes(proj_hidden, 4 * hidden) + laneBytes(out_width, proj_hidden);
+}
+
+/// Device bytes an engine-mode tower holds for images of `opt.max_side` a side (weights, tables and `x`), before
+/// loading: the start-up estimate.
+pub fn residentBytes(opt: Options) usize {
+    return vectorBytes() + projBytes() + Grid.of(opt.max_side, opt.max_side).towerRows() * hidden * 2;
+}
+
+/// The RGB bytes an image of grid g holds at most (whole blocks a side).
+fn rgbBytes(g: Grid) usize {
+    return g.rows * block * g.cols * block * 3;
+}
+
+pub const Tower = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    opt: Options,
+    k: Kernels,
+    lane: cuda.qmmf.Lane,
+    vectors: cuda.DeviceBuffer, // every bf16 vector and table, then the 257 pixel values and the 16 frequencies
+    proj: cuda.DeviceBuffer, // the lane's projections, one after another
+    work: cuda.DeviceBuffer, // the image's buffers (engine mode: `x` alone)
+    /// load: each tensor's name, len and xxh64 as read (with a digest manifest)
+    sums: ?*std.ArrayList(ink.digests.Named) = null,
+    /// the lane's split-K partials at most, over every row count a call takes
+    part_bytes: usize = 0,
+    // weights
+    class: u64 = 0,
+    cls_pos: u64 = 0,
+    pos_table: u64 = 0, // [1024][1024]
+    ln_pre_w: u64 = 0,
+    ln_pre_b: u64 = 0,
+    pixel_table: u64 = 0, // 257 fp32
+    inv: u64 = 0, // 16 fp32
+    patch_w: Weight = undefined, // [1024, 1216]
+    layer: [layers]Layer = @splat(.{}),
+    m1: Weight = undefined, // [4096, 4096]
+    m2: Weight = undefined, // [4608, 4096]
+    // buffers (sizes for max_side x max_side)
+    max_tokens: usize,
+    x: u64 = 0, // [S][1024] the residual stream
+    h: u64 = 0, // [S][1024] normed rows; the embedding before ln_pre
+    qkv: u64 = 0, // [S][3072]
+    ao: u64 = 0, // [S][1024] the core's output
+    acc: u64 = 0, // [row_block][4096] fp32
+    g: u64 = 0, // [row_block][4096] bf16: fc1's GELU, the merger's middle, E2's rows
+    patches: u64 = 0, // [row_block][1216]
+    rgb: u64 = 0,
+    idx: u64 = 0, // [P][4] i32
+    wts: u64 = 0, // [P][4] f32
+    cs: u64 = 0, // [S][32] f32
+    sn: u64 = 0,
+    out: u64 = 0, // [T][4608]
+    part: u64 = 0,
+    rgb_cap: usize = 0,
+    host_idx: []i32 = &.{},
+    host_w: []f32 = &.{},
+    // the image in flight
+    grid: Grid = .{ .rows = 0, .cols = 0 },
+    next: usize = 0, // the next layer step() runs
+
+    /// The 422 model.visual.* tensors from the safetensors file `path` (names, BF16, shapes checked; with a manifest
+    /// their contents, `LoadArgs`), the projections packed for the lane, and buffers for an image of opt.max_side a side
+    /// (engine mode: `x` alone). The context must be current.
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, path: []const u8, opt: Options, args: LoadArgs) !Tower {
+        if (opt.row_block == 0 or opt.q_block == 0) return error.BadVisionOptions;
+        const inv = invFreq();
+        for (inv, inv_freq_bits) |f, b| if (@as(u32, @bitCast(f)) != b) return error.InvFreqDiffers;
+        var r = try st.Reader.open(gpa, io, path);
+        defer r.close();
+        var count: usize = 0;
+        for (r.entries) |e| if (std.mem.startsWith(u8, e.name, prefix)) {
+            count += 1;
+        };
+        if (count != tensors) {
+            std.log.err("{s}: {d} model.visual.* tensors, expected {d}", .{ path, count, tensors });
+            return error.UnexpectedVisionTensors;
+        }
+        var k = try Kernels.load(d);
+        errdefer k.unload();
+        if (opt.core == .tc and k.attn_tc == null) return error.TcCoreAbsent;
+        var lane = try cuda.qmmf.Lane.load(d, (try d.currentCapability()) / 10);
+        errdefer lane.unload();
+        try lane.loadPrompt(d);
+        const g = Grid.of(opt.max_side, opt.max_side);
+        var t: Tower = .{ .gpa = gpa, .d = d, .opt = opt, .k = k, .lane = lane, .vectors = undefined, .proj = undefined, .work = undefined, .max_tokens = g.tokens() };
+        var sums: std.ArrayList(ink.digests.Named) = .empty;
+        defer sums.deinit(gpa);
+        if (args.manifest != null) {
+            try sums.ensureTotalCapacity(gpa, tensors);
+            t.sums = &sums;
+        }
+        try t.loadVectors(&r);
+        errdefer t.vectors.free();
+        try t.loadProjections(gpa, &r, args.stage);
+        errdefer t.proj.free();
+        t.sums = null;
+        if (args.manifest) |text| {
+            const c = try ink.digests.checkNamed(gpa, text, args.rank, prefix, sums.items);
+            if (c.differ + c.missing > 0 or c.pieces != tensors) {
+                std.log.err("inkling2 rank {d}: vision tower: {d} of {d} tensors differ from the digest manifest and {d} have no matching line (first: {s})", .{ args.rank, c.differ, c.pieces, c.missing, c.first orelse "none" });
+                return error.WeightBytesDiffer;
+            }
+            std.log.info("inkling2 rank {d}: vision tower: {d} tensors match the digest manifest (xxh64 {x:0>16})", .{ args.rank, c.pieces, c.loaded });
+        }
+        t.part_bytes = t.partNeed();
+        if (opt.own_work) try t.allocWork(g) else try t.allocResident(g);
+        return t;
+    }
+
+    pub fn deinit(t: *Tower) void {
+        t.gpa.free(t.host_idx);
+        t.gpa.free(t.host_w);
+        t.work.free();
+        t.proj.free();
+        t.vectors.free();
+        t.lane.unload();
+        t.k.unload();
+        t.* = undefined;
+    }
+
+    /// Tensor model.visual.`name` (BF16, `shape`) into `out`, its xxh64 noted when `sums` is set.
+    fn read(t: *Tower, r: *const st.Reader, name: []const u8, shape: []const u64, out: []u8) !void {
+        var nb: [128]u8 = undefined;
+        const full = try std.fmt.bufPrint(&nb, prefix ++ "{s}", .{name});
+        const e = r.find(full) orelse {
+            std.log.err("the tower file has no {s}", .{full});
+            return error.MissingVisionTensor;
+        };
+        var ok = e.dtype == .bf16 and e.rank == shape.len;
+        if (ok) for (shape, 0..) |n, i| {
+            if (e.dim(i) != n) ok = false;
+        };
+        if (!ok or out.len != e.bytes()) {
+            std.log.err("{s}: {s} {any}, expected BF16 {any}", .{ full, e.dtype.name(), e.shape[0..e.rank], shape });
+            return error.UnexpectedVisionTensor;
+        }
+        try r.readInto(e, 0, out);
+        if (t.sums) |list| try list.append(t.gpa, .{ .name = e.name, .len = out.len, .xxh64 = std.hash.XxHash64.hash(0, out) });
+    }
+
+    fn loadVectors(t: *Tower, r: *const st.Reader) !void {
+        const bytes = vectorBytes();
+        const host = try t.gpa.alloc(u8, bytes);
+        defer t.gpa.free(host);
+        var at: usize = 0;
+        var offs: [top.len]usize = undefined;
+        for (top, 0..) |s, i| {
+            try t.read(r, s.name, &.{s.len}, host[at..][0 .. s.len * 2]);
+            offs[i] = at;
+            at += s.len * 2;
+        }
+        const table_at = at;
+        try t.read(r, "backbone.embeddings.position_embedding", &.{ grid_side * grid_side, hidden }, host[at..][0 .. grid_side * grid_side * hidden * 2]);
+        at += grid_side * grid_side * hidden * 2;
+        var lofs: [layers][per_layer.len]usize = undefined;
+        for (0..layers) |l| for (per_layer, 0..) |s, i| {
+            var nb: [96]u8 = undefined;
+            const name = try std.fmt.bufPrint(&nb, "backbone.layers.{d}.{s}", .{ l, s.name });
+            try t.read(r, name, &.{s.len}, host[at..][0 .. s.len * 2]);
+            lofs[l][i] = at;
+            at += s.len * 2;
+        };
+        const px_at = at;
+        const px = pixelTable();
+        @memcpy(host[at..][0 .. 257 * 4], std.mem.sliceAsBytes(&px));
+        at += 257 * 4;
+        const inv_at = at;
+        const inv = invFreq();
+        @memcpy(host[at..][0 .. 16 * 4], std.mem.sliceAsBytes(&inv));
+        at += 16 * 4;
+        std.debug.assert(at == bytes);
+        t.vectors = try cuda.DeviceBuffer.fromHost(t.d, host);
+        const base = t.vectors.ptr;
+        t.class = base + offs[0];
+        t.cls_pos = base + offs[1];
+        t.ln_pre_w = base + offs[2];
+        t.ln_pre_b = base + offs[3];
+        t.pos_table = base + table_at;
+        t.pixel_table = base + px_at;
+        t.inv = base + inv_at;
+        for (&t.layer, lofs) |*l, o| {
+            l.ln1_w = base + o[0];
+            l.ln1_b = base + o[1];
+            l.ln2_w = base + o[2];
+            l.ln2_b = base + o[3];
+            l.ls1 = base + o[4];
+            l.ls2 = base + o[5];
+            l.b_qkv = base + o[6]; // q, k, v biases are adjacent: [3072]
+            if (o[7] != o[6] + hidden * 2 or o[8] != o[7] + hidden * 2) return error.UnexpectedVisionLayout;
+            l.b_o = base + o[9];
+            l.b_fc1 = base + o[10];
+            l.b_fc2 = base + o[11];
+        }
+    }
+
+    /// The projections packed for the lane; `lent`, when it holds the largest source, stages them instead of a buffer
+    /// of their own.
+    fn loadProjections(t: *Tower, gpa: std.mem.Allocator, r: *const st.Reader, lent: ?cuda.DeviceBuffer) !void {
+        const total = projBytes();
+        t.proj = try cuda.DeviceBuffer.alloc(t.d, total);
+        errdefer t.proj.free();
+        const most = out_width * proj_hidden * 2; // the largest source: proj_out
+        const host = try gpa.alloc(u8, most);
+        defer gpa.free(host);
+        var stage = if (lent) |b| (if (b.len >= most) view(t.d, b.ptr, most) else try cuda.DeviceBuffer.alloc(t.d, most)) else try cuda.DeviceBuffer.alloc(t.d, most);
+        defer stage.free();
+        var packer = try cuda.modelopt.Packer.load(t.d);
+        defer packer.unload();
+        var s = try Stream.init(t.d, true);
+        defer s.deinit();
+        var at: usize = 0;
+        const P = struct {
+            fn pack(tw: *Tower, pk: *const cuda.modelopt.Packer, ss: Stream, stg: *cuda.DeviceBuffer, src: []const u8, n: usize, k: usize, off: *usize) !Weight {
+                if (k % cuda.qmmf.group != 0) return error.UnexpectedVisionLayout;
+                try ss.synchronize(); // the stage is free
+                try stg.upload(0, src);
+                const dst = tw.proj.ptr + off.*;
+                try pk.bf16Lane(ss, stg.ptr, dst, n, k);
+                off.* += laneBytes(n, k);
+                return cuda.modelopt.bf16Weight(dst, n, k);
+            }
+        };
+        // E2: [1024, 1200] zero-padded to K = 1216
+        {
+            const raw = try gpa.alloc(u8, hidden * features * 2);
+            defer gpa.free(raw);
+            try t.read(r, "backbone.embeddings.patch_embedding.weight", &.{ hidden, features }, raw);
+            const dst = host[0 .. hidden * features_pad * 2];
+            @memset(dst, 0);
+            for (0..hidden) |n| @memcpy(dst[n * features_pad * 2 ..][0 .. features * 2], raw[n * features * 2 ..][0 .. features * 2]);
+            t.patch_w = try P.pack(t, &packer, s, &stage, dst, hidden, features_pad, &at);
+        }
+        for (&t.layer, 0..) |*l, i| {
+            var nb: [96]u8 = undefined;
+            const wb = hidden * hidden * 2;
+            for ([_][]const u8{ "q", "k", "v" }, 0..) |p, j| {
+                try s.synchronize();
+                try t.read(r, try std.fmt.bufPrint(&nb, "backbone.layers.{d}.self_attn.{s}_proj.weight", .{ i, p }), &.{ hidden, hidden }, host[j * wb ..][0..wb]);
+            }
+            l.qkv = try P.pack(t, &packer, s, &stage, host[0 .. 3 * wb], 3 * hidden, hidden, &at);
+            try s.synchronize();
+            try t.read(r, try std.fmt.bufPrint(&nb, "backbone.layers.{d}.self_attn.out_proj.weight", .{i}), &.{ hidden, hidden }, host[0..wb]);
+            l.o = try P.pack(t, &packer, s, &stage, host[0..wb], hidden, hidden, &at);
+            try s.synchronize();
+            try t.read(r, try std.fmt.bufPrint(&nb, "backbone.layers.{d}.mlp.c_fc.weight", .{i}), &.{ inter, hidden }, host[0 .. inter * hidden * 2]);
+            l.fc1 = try P.pack(t, &packer, s, &stage, host[0 .. inter * hidden * 2], inter, hidden, &at);
+            try s.synchronize();
+            try t.read(r, try std.fmt.bufPrint(&nb, "backbone.layers.{d}.mlp.c_proj.weight", .{i}), &.{ hidden, inter }, host[0 .. inter * hidden * 2]);
+            l.fc2 = try P.pack(t, &packer, s, &stage, host[0 .. inter * hidden * 2], hidden, inter, &at);
+        }
+        try s.synchronize();
+        try t.read(r, "proj_in.weight", &.{ proj_hidden, 4 * hidden }, host[0 .. proj_hidden * 4 * hidden * 2]);
+        t.m1 = try P.pack(t, &packer, s, &stage, host[0 .. proj_hidden * 4 * hidden * 2], proj_hidden, 4 * hidden, &at);
+        try s.synchronize();
+        try t.read(r, "proj_out.weight", &.{ out_width, proj_hidden }, host[0 .. out_width * proj_hidden * 2]);
+        t.m2 = try P.pack(t, &packer, s, &stage, host[0 .. out_width * proj_hidden * 2], out_width, proj_hidden, &at);
+        try s.synchronize();
+        std.debug.assert(at == total);
+    }
+
+    /// The lane's split-K partials at most: every projection shape at every row count a call takes (up to row_block;
+    /// a tail block's count may need more than a whole block's).
+    fn partNeed(t: *const Tower) usize {
+        var part: usize = 0;
+        const ws = [_]Weight{ t.patch_w, t.layer[0].qkv, t.layer[0].o, t.layer[0].fc1, t.layer[0].fc2, t.m1, t.m2 };
+        for (1..t.opt.row_block + 1) |m| for (ws) |w| {
+            part = @max(part, t.lane.partBytes(m, w));
+        };
+        return part;
+    }
+
+    fn allocWork(t: *Tower, g: Grid) !void {
+        const S = g.towerRows();
+        const P = g.patches();
+        const T = g.tokens();
+        const rb = t.opt.row_block;
+        const part = t.part_bytes;
+        t.rgb_cap = t.opt.max_side * t.opt.max_side * 3;
+        const sizes = [_]usize{
+            S * hidden * 2, // x
+            S * hidden * 2, // h
+            S * 3 * hidden * 2, // qkv
+            S * hidden * 2, // ao
+            rb * inter * 4, // acc
+            rb * inter * 2, // g
+            rb * features_pad * 2, // patches
+            t.rgb_cap, // rgb
+            P * 4 * 4, // idx
+            P * 4 * 4, // wts
+            S * 32 * 4, // cs
+            S * 32 * 4, // sn
+            T * out_width * 2, // out
+            part,
+        };
+        var total: usize = 0;
+        for (sizes) |n| total += std.mem.alignForward(usize, n, 256);
+        t.work = try cuda.DeviceBuffer.alloc(t.d, total);
+        errdefer t.work.free();
+        var at: usize = t.work.ptr;
+        var ptrs: [sizes.len]u64 = undefined;
+        for (sizes, &ptrs) |n, *p| {
+            p.* = if (n == 0) 0 else at;
+            at += std.mem.alignForward(usize, n, 256);
+        }
+        t.x, t.h, t.qkv, t.ao, t.acc, t.g, t.patches, t.rgb, t.idx, t.wts, t.cs, t.sn, t.out, t.part = ptrs;
+        t.host_idx = try t.gpa.alloc(i32, P * 4);
+        errdefer t.gpa.free(t.host_idx);
+        t.host_w = try t.gpa.alloc(f32, P * 4);
+    }
+
+    /// Engine mode: `x` alone on the device (and the host's position taps).
+    fn allocResident(t: *Tower, g: Grid) !void {
+        t.work = try cuda.DeviceBuffer.alloc(t.d, g.towerRows() * hidden * 2);
+        errdefer t.work.free();
+        t.x = t.work.ptr;
+        t.host_idx = try t.gpa.alloc(i32, g.patches() * 4);
+        errdefer t.gpa.free(t.host_idx);
+        t.host_w = try t.gpa.alloc(f32, g.patches() * 4);
+    }
+
+    /// Device bytes the tower holds (weights, tables and its own buffers; engine mode: resident bytes only).
+    pub fn deviceBytes(t: *const Tower) usize {
+        return t.vectors.len + t.proj.len + t.work.len;
+    }
+
+    // ------------------------------------------------------------------------------------------- engine mode
+
+    /// The buffers phase `p` borrows for grid g, in `bindSlice`'s order (0: none).
+    fn phaseSizes(t: *const Tower, g: Grid, p: Phase) [8]usize {
+        const S = g.towerRows();
+        const P = g.patches();
+        const rb = t.opt.row_block;
+        return switch (p) {
+            // rgb, patches, E2's rows (g), idx, wts, h, part
+            .begin => .{ rgbBytes(g), rb * features_pad * 2, rb * hidden * 2, P * 16, P * 16, S * hidden * 2, t.part_bytes, 0 },
+            // h, qkv, ao, acc, g, cs, sn, part
+            .layer => .{ S * hidden * 2, S * 3 * hidden * 2, S * hidden * 2, rb * inter * 4, rb * inter * 2, S * 32 * 4, S * 32 * 4, t.part_bytes },
+            // g, part
+            .merger => .{ rb * proj_hidden * 2, t.part_bytes, 0, 0, 0, 0, 0, 0 },
+        };
+    }
+
+    fn takes(sizes: [8]usize) usize {
+        var at: usize = 0;
+        for (sizes) |n| if (n > 0) {
+            at = std.mem.alignForward(usize, at, 256) + n;
+        };
+        return at;
+    }
+
+    /// The bytes an engine-mode unit borrows at most for an image of grid g (each phase's buffers 256-aligned).
+    pub fn sliceNeed(t: *const Tower, g: Grid) usize {
+        var most: usize = 0;
+        for ([_]Phase{ .begin, .layer, .merger }) |p| most = @max(most, takes(t.phaseSizes(g, p)));
+        return most;
+    }
+
+    /// Engine mode, before a unit on stream s: phase p's buffers laid out in [base, base + len) (256-aligned; nothing
+    /// in it is read before the unit writes it). A layer unit recomputes the rotary tables there first. `g` is the
+    /// image's grid (begin: the image about to start; else the one in flight).
+    pub fn bindSlice(t: *Tower, s: Stream, base: u64, len: usize, p: Phase, g: Grid) !void {
+        if (t.opt.own_work) return error.TowerOwnsItsBuffers;
+        if (g.tokens() == 0 or g.tokens() > t.max_tokens) return error.ImageSize;
+        if (p != .begin and (g.rows != t.grid.rows or g.cols != t.grid.cols)) return error.NotTheImageInFlight;
+        if (base % 256 != 0) return error.BadSlice;
+        const sizes = t.phaseSizes(g, p);
+        if (takes(sizes) > len) return error.ScratchShort;
+        var ptrs: [8]u64 = @splat(0);
+        var at: usize = 0;
+        for (sizes, &ptrs) |n, *q| if (n > 0) {
+            at = std.mem.alignForward(usize, at, 256);
+            q.* = base + at;
+            at += n;
+        };
+        t.h, t.qkv, t.ao, t.acc, t.g, t.patches, t.rgb, t.idx, t.wts, t.cs, t.sn, t.part = @as([12]u64, @splat(0));
+        t.rgb_cap = 0;
+        switch (p) {
+            .begin => {
+                t.rgb, t.patches, t.g, t.idx, t.wts, t.h, t.part = ptrs[0..7].*;
+                t.rgb_cap = sizes[0];
+            },
+            .layer => {
+                t.h, t.qkv, t.ao, t.acc, t.g, t.cs, t.sn, t.part = ptrs;
+                try t.k.ropeTable(s, t.inv, g.cols, g.towerRows(), t.cs, t.sn);
+            },
+            .merger => {
+                t.g = ptrs[0];
+                t.part = ptrs[1];
+            },
+        }
+    }
+
+    // ------------------------------------------------------------------------------------------- projections
+
+    /// y [n][w.n] bf16 (rows `ldy` apart) = bf16(x W^T + bias), x rows `ldx` apart; row blocks of row_block.
+    pub fn linearBias(t: *const Tower, s: Stream, x: u64, ldx: usize, n: usize, w: Weight, bias: u64, y: u64, ldy: usize) !void {
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += t.opt.row_block) {
+            const m = @min(t.opt.row_block, n - r0);
+            try t.lane.matmulF32(s, x + r0 * ldx * 2, ldx, m, w, t.acc, t.part);
+            try t.k.biasRows(s, t.acc, bias, y + r0 * ldy * 2, m, w.n, ldy);
+        }
+    }
+
+    /// y [n][w.n] = bf16(gelu(bf16(x W^T + bias))).
+    pub fn linearBiasGelu(t: *const Tower, s: Stream, x: u64, ldx: usize, n: usize, w: Weight, bias: u64, y: u64) !void {
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += t.opt.row_block) {
+            const m = @min(t.opt.row_block, n - r0);
+            try t.lane.matmulF32(s, x + r0 * ldx * 2, ldx, m, w, t.acc, t.part);
+            try t.k.biasGelu(s, t.acc, bias, y + r0 * w.n * 2, m, w.n);
+        }
+    }
+
+    /// y [n][w.n] bf16 = x W^T, one rounding (no bias).
+    pub fn linear(t: *const Tower, s: Stream, x: u64, ldx: usize, n: usize, w: Weight, y: u64) !void {
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += t.opt.row_block) {
+            const m = @min(t.opt.row_block, n - r0);
+            try t.lane.matmulOut(s, x + r0 * ldx * 2, ldx, m, w, y + r0 * w.n * 2, .bf16, t.part);
+        }
+    }
+
+    /// The core over every query row of an S-row image in blocks of q_block; out [S][1024].
+    pub fn attention(t: *const Tower, s: Stream, which: Core, q: u64, k: u64, v: u64, ld: usize, rows: usize, out: u64) !void {
+        var q0: usize = 0;
+        while (q0 < rows) : (q0 += t.opt.q_block) {
+            const qn = @min(t.opt.q_block, rows - q0);
+            try t.k.core(s, which, q, k, v, ld, out + q0 * hidden * 2, rows, q0, qn);
+        }
+    }
+
+    // -------------------------------------------------------------------------------------------- the tower
+
+    /// E1 .. E5 and the rotary tables of an H x W RGB image (`rgb` [H][W][3] on the host); then step() its layers.
+    pub fn begin(t: *Tower, s: Stream, rgb: []const u8, h: usize, w: usize) !void {
+        if (h == 0 or w == 0 or h > t.opt.max_side or w > t.opt.max_side) return error.ImageSize;
+        if (rgb.len != h * w * 3) return error.ImageBytes;
+        const g = Grid.of(h, w);
+        if (!t.opt.own_work and (t.rgb == 0 or rgb.len > t.rgb_cap)) return error.NoBeginSlice;
+        try t.prepareGrid(s, g);
+        try view(t.d, t.rgb, t.rgb_cap).upload(0, rgb);
+        const P = g.patches();
+        var p0: usize = 0;
+        while (p0 < P) : (p0 += t.opt.row_block) {
+            const n = @min(t.opt.row_block, P - p0);
+            try t.k.patchRows(s, t.rgb, t.pixel_table, h, w, g.cols, p0, n, t.patches);
+            try t.linear(s, t.patches, features_pad, n, t.patch_w, t.g);
+            try t.k.embedRows(s, t.g, t.pos_table, t.idx, t.wts, p0, n, t.h);
+        }
+        try t.k.classRow(s, t.class, t.cls_pos, t.h);
+        try t.layerNormRows(s, t.h, t.ln_pre_w, t.ln_pre_b, t.x, g.towerRows());
+    }
+
+    fn view(d: *const cuda.Driver, ptr: u64, len: usize) cuda.DeviceBuffer {
+        return .{ .d = d, .ptr = ptr, .len = len, .borrowed = true };
+    }
+
+    /// An image's grid without its pixels: the position taps (host, then uploaded) and the rotary tables (engine mode:
+    /// at each layer unit instead); the next step() runs layer 0. Waits for the stream first (the buffers are then
+    /// free).
+    pub fn prepareGrid(t: *Tower, s: Stream, g: Grid) !void {
+        if (g.tokens() == 0 or g.tokens() > t.max_tokens) return error.ImageSize;
+        try s.synchronize();
+        t.grid = g;
+        t.next = 0;
+        const P = g.patches();
+        positionTaps(g, t.host_idx[0 .. 4 * P], t.host_w[0 .. 4 * P]);
+        try view(t.d, t.idx, P * 16).upload(0, std.mem.sliceAsBytes(t.host_idx[0 .. 4 * P]));
+        try view(t.d, t.wts, P * 16).upload(0, std.mem.sliceAsBytes(t.host_w[0 .. 4 * P]));
+        if (t.opt.own_work) try t.k.ropeTable(s, t.inv, g.cols, g.towerRows(), t.cs, t.sn);
+    }
+
+    /// y = LayerNorm(x) over n rows in row blocks.
+    pub fn layerNormRows(t: *const Tower, s: Stream, x: u64, w: u64, b: u64, y: u64, n: usize) !void {
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += t.opt.row_block) {
+            const m = @min(t.opt.row_block, n - r0);
+            try t.k.layerNorm(s, x + r0 * hidden * 2, w, b, y + r0 * hidden * 2, m);
+        }
+    }
+
+    /// Layer `i` on the image's rows (t.x in place).
+    pub fn runLayer(t: *const Tower, s: Stream, i: usize) !void {
+        const l = &t.layer[i];
+        const S = t.grid.towerRows();
+        const rb = t.opt.row_block;
+        var r0: usize = 0;
+        while (r0 < S) : (r0 += rb) {
+            const m = @min(rb, S - r0);
+            try t.k.layerNorm(s, t.x + r0 * hidden * 2, l.ln1_w, l.ln1_b, t.h + r0 * hidden * 2, m);
+            try t.lane.matmulF32(s, t.h + r0 * hidden * 2, hidden, m, l.qkv, t.acc, t.part);
+            try t.k.biasRows(s, t.acc, l.b_qkv, t.qkv + r0 * 3 * hidden * 2, m, 3 * hidden, 3 * hidden);
+            try t.k.rotary(s, t.qkv, 3 * hidden, t.cs, t.sn, r0, m);
+        }
+        try t.attention(s, t.opt.core, t.qkv, t.qkv + hidden * 2, t.qkv + 2 * hidden * 2, 3 * hidden, S, t.ao);
+        r0 = 0;
+        while (r0 < S) : (r0 += rb) {
+            const m = @min(rb, S - r0);
+            try t.lane.matmulF32(s, t.ao + r0 * hidden * 2, hidden, m, l.o, t.acc, t.part);
+            try t.k.biasLsRes(s, t.acc, l.b_o, l.ls1, t.x + r0 * hidden * 2, m);
+        }
+        r0 = 0;
+        while (r0 < S) : (r0 += rb) {
+            const m = @min(rb, S - r0);
+            try t.k.layerNorm(s, t.x + r0 * hidden * 2, l.ln2_w, l.ln2_b, t.h + r0 * hidden * 2, m);
+            try t.lane.matmulF32(s, t.h + r0 * hidden * 2, hidden, m, l.fc1, t.acc, t.part);
+            try t.k.biasGelu(s, t.acc, l.b_fc1, t.g, m, inter);
+            try t.lane.matmulF32(s, t.g, inter, m, l.fc2, t.acc, t.part);
+            try t.k.biasLsRes(s, t.acc, l.b_fc2, l.ls2, t.x + r0 * hidden * 2, m);
+        }
+    }
+
+    /// The next `n` layers (fewer at the end); returns the layers left.
+    pub fn step(t: *Tower, s: Stream, n: usize) !usize {
+        const end = @min(layers, t.next + n);
+        while (t.next < end) : (t.next += 1) try t.runLayer(s, t.next);
+        return layers - t.next;
+    }
+
+    /// The merger on the finished layers: patch rows 1 .. S - 1 as [T][4096], linear_1, GELU, linear_2.
+    pub fn finish(t: *Tower, s: Stream) !Rows {
+        if (t.out == 0) return error.TowerOwnsNoRows;
+        return t.finishInto(s, t.out);
+    }
+
+    /// The merger on the finished layers into `out` [T][4608] bf16 (engine mode: after bindSlice(.merger)).
+    pub fn finishInto(t: *Tower, s: Stream, out: u64) !Rows {
+        if (t.next != layers) return error.TowerNotDone;
+        const T = t.grid.tokens();
+        try t.merger(s, t.x + hidden * 2, T, out);
+        return .{ .ptr = out, .tokens = T };
+    }
+
+    /// M2 on [n][4096] rows `x` (rows 4096 apart) into out [n][4608].
+    pub fn merger(t: *const Tower, s: Stream, x: u64, n: usize, out: u64) !void {
+        var r0: usize = 0;
+        while (r0 < n) : (r0 += t.opt.row_block) {
+            const m = @min(t.opt.row_block, n - r0);
+            try t.lane.matmulOut(s, x + r0 * 4 * hidden * 2, 4 * hidden, m, t.m1, t.g, .bf16, t.part);
+            try t.k.gelu(s, t.g, t.g, m * proj_hidden);
+            try t.lane.matmulOut(s, t.g, proj_hidden, m, t.m2, out + r0 * out_width * 2, .bf16, t.part);
+        }
+    }
+
+    /// The whole tower: begin, every layer, finish.
+    pub fn run(t: *Tower, s: Stream, rgb: []const u8, h: usize, w: usize) !Rows {
+        try t.begin(s, rgb, h, w);
+        _ = try t.step(s, layers);
+        return t.finish(s);
+    }
+};
+
+// ----------------------------------------------------------------------------------------------- the serving engine
+
+const vision_store = ink.vision_store;
+
+/// Images a request may hold at most: the spans an image chunk splices (cuda_vision_store.zig max_images).
+pub const max_images: u32 = vision_store.max_images;
+comptime {
+    std.debug.assert(vision_store.tower_layers == layers);
+}
+/// Image tokens a request by default: one 4,096 x 4,096 image (image_offer.zig Limits.default_image_tokens).
+pub const default_image_tokens: u32 = 10_816;
+/// The tower's file in the model folder when neither Vision.weights nor TF_INK2_VISION_WEIGHTS names one.
+pub const file_name = "inkling2-vision.safetensors";
+
+/// The serving engine's vision (cuda_engine.zig Options.vision; --vision's limits, or TF_INK2_VISION=1 in the tools):
+/// rank 0 loads the tower and a row store of `image_tokens` rows; the other ranks hold nothing.
+pub const Vision = struct {
+    /// image tokens a request at most, and the row store's rows
+    image_tokens: u32 = default_image_tokens,
+    /// images a request at most (--vision-max-images): an image chunk splices at most `max_images` (16)
+    max_images: u32 = 4,
+    /// the tower's file; null: TF_INK2_VISION_WEIGHTS, else <model dir>/inkling2-vision.safetensors
+    weights: ?[]const u8 = null,
+};
+
+/// Every rank, before any GPU work: images a request 1 .. `max_images` (error.VisionMaxImages; the server words it
+/// with both numbers) and a store of at least one row.
+pub fn checkLimits(v: Vision) error{ VisionMaxImages, BadVisionOptions }!void {
+    if (v.max_images == 0 or v.max_images > max_images) return error.VisionMaxImages;
+    if (v.image_tokens == 0) return error.BadVisionOptions;
+}
+
+/// Device bytes rank 0's vision takes beside the text weights, before loading (the start-up estimate): the
+/// engine-mode tower (weights, tables, `x` at max_side) and a row store of `image_tokens` rows.
+pub fn rank0Bytes(image_tokens: u32) usize {
+    return residentBytes(.{ .own_work = false }) + @as(usize, image_tokens) * vision_store.row_bytes;
+}
+
+/// Rank 0's vision in the serving engine (cuda_engine.zig Engine.vision): the tower in engine mode (weights and `x`
+/// resident; each unit borrows the op scratch, idle between forwards), the image rows it made (`rows`, bf16
+/// [image_tokens][4608]) and their host index (`store`, whose compaction copies go on the engine's stream).
+pub const Rank0 = struct {
+    gpa: std.mem.Allocator,
+    d: *const cuda.Driver,
+    /// the engine's stream: the tower's units and the store's copies are ordered with the forwards
+    stream: Stream,
+    limits: Vision,
+    tower: Tower,
+    rows: cuda.DeviceBuffer,
+    store: vision_store.Store,
+    /// the tower's job in flight and its pace beside decoders (cuda_lanes.zig: units under a chunk row cap)
+    pace: vision_store.Pace = .{},
+
+    /// The tower's file: `v.weights`, else TF_INK2_VISION_WEIGHTS, else <dir>/inkling2-vision.safetensors (written to
+    /// `buf` when built from `dir`).
+    pub fn path(buf: []u8, dir: []const u8, v: Vision) ![]const u8 {
+        if (v.weights) |p| return p;
+        if (std.c.getenv("TF_INK2_VISION_WEIGHTS")) |p| return std.mem.span(p);
+        return std.fmt.bufPrint(buf, "{s}/" ++ file_name, .{dir});
+    }
+
+    /// Rank 0 at start-up, after the text weights (the context current): the tower from its file, its 422 tensors
+    /// checked against `manifest`'s rank-0 lines by name, len and xxh64 when there is one, the projections staged in
+    /// `stage` (the op scratch, idle at load), and the row store. error.NoVisionTower when the file is absent.
+    pub fn load(gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, dir: []const u8, v: Vision, stream: Stream, stage: cuda.DeviceBuffer, manifest: ?[]const u8) !*Rank0 {
+        try checkLimits(v);
+        var pb: [std.fs.max_path_bytes]u8 = undefined;
+        const p = try path(&pb, dir, v);
+        const r = try gpa.create(Rank0);
+        errdefer gpa.destroy(r);
+        r.* = .{ .gpa = gpa, .d = d, .stream = stream, .limits = v, .tower = undefined, .rows = undefined, .store = undefined };
+        r.tower = Tower.load(gpa, io, d, p, .{ .own_work = false }, .{ .manifest = manifest, .rank = 0, .stage = stage }) catch |err| switch (err) {
+            error.FileNotFound => {
+                std.log.err("inkling2 rank 0: --vision: no vision tower at {s} (the recipe's weights step writes <model dir>/" ++ file_name ++ " with VISION=1; TF_INK2_VISION_WEIGHTS names another file)", .{p});
+                return error.NoVisionTower;
+            },
+            else => return err,
+        };
+        errdefer r.tower.deinit();
+        if (manifest == null) std.log.warn("inkling2 rank 0: vision tower contents not checked (no digest manifest)", .{});
+        r.rows = try cuda.DeviceBuffer.alloc(d, @as(usize, v.image_tokens) * vision_store.row_bytes);
+        errdefer r.rows.free();
+        r.store = try vision_store.Store.init(gpa, r.rows.ptr, v.image_tokens, vision_store.row_bytes, .{ .ctx = r, .run = copyRows, .done = copiesDone });
+        std.log.info("inkling2 rank 0: vision tower from {s}: {d:.1} MiB resident (weights and tables {d:.1}, x {d:.1}), the image row store {d} rows ({d:.1} MiB), at most {d} images a request", .{ p, mib(r.deviceBytes()), mib(r.tower.vectors.len + r.tower.proj.len), mib(r.tower.work.len), v.image_tokens, mib(r.rows.len), v.max_images });
+        return r;
+    }
+
+    pub fn destroy(r: *Rank0) void {
+        const gpa = r.gpa;
+        r.store.deinit();
+        r.rows.free();
+        r.tower.deinit();
+        gpa.destroy(r);
+    }
+
+    /// Device bytes held: the tower's resident bytes and the row store.
+    pub fn deviceBytes(r: *const Rank0) usize {
+        return r.tower.deviceBytes() + r.rows.len;
+    }
+
+    /// The op scratch a unit borrows at most: the largest image (max_side a side) in its largest phase.
+    pub fn scratchNeed(r: *const Rank0) usize {
+        return r.tower.sliceNeed(Grid.of(r.tower.opt.max_side, r.tower.opt.max_side));
+    }
+
+    /// One image's whole tower in one unit (the decode tool): begin, every layer, then the merger into `out` ([T][4608]
+    /// bf16: the image's store rows), each phase's buffers laid out in [base, base + len) (at least `tower.sliceNeed`
+    /// of its grid, borrowed from the op scratch). On the engine's stream; nothing waits for it but `begin`'s grid
+    /// (prepareGrid synchronizes first).
+    pub fn whole(r: *Rank0, base: u64, len: usize, rgb: []const u8, h: usize, w: usize, out: u64) !Rows {
+        try r.beginUnit(base, len, rgb, h, w);
+        _ = try r.layersUnit(base, len, layers);
+        return r.mergeUnit(base, len, out);
+    }
+
+    /// A unit's start: an H x W image's grid (prepareGrid waits for the stream), then E1 .. E5 into the resident `x`,
+    /// the begin phase's buffers in [base, base + len).
+    pub fn beginUnit(r: *Rank0, base: u64, len: usize, rgb: []const u8, h: usize, w: usize) !void {
+        try r.tower.bindSlice(r.stream, base, len, .begin, Grid.of(h, w));
+        try r.tower.begin(r.stream, rgb, h, w);
+    }
+
+    /// The image in flight's next `n` layers (the rotary tables recomputed in [base, base + len) first); the layers
+    /// left.
+    pub fn layersUnit(r: *Rank0, base: u64, len: usize, n: usize) !usize {
+        try r.tower.bindSlice(r.stream, base, len, .layer, r.tower.grid);
+        return r.tower.step(r.stream, n);
+    }
+
+    /// The image in flight's merger into `out` once its layers are done.
+    pub fn mergeUnit(r: *Rank0, base: u64, len: usize, out: u64) !Rows {
+        try r.tower.bindSlice(r.stream, base, len, .merger, r.tower.grid);
+        return r.tower.finishInto(r.stream, out);
+    }
+
+    /// The op scratch a unit of the image in flight borrows (an image of grid g: `tower.sliceNeed(g)`).
+    pub fn unitNeed(r: *const Rank0) usize {
+        return r.tower.sliceNeed(r.tower.grid);
+    }
+
+    /// The store's compaction copy, on the engine's stream.
+    fn copyRows(ctx: *anyopaque, dst: u64, src: u64, bytes: usize) anyerror!void {
+        const r: *Rank0 = @ptrCast(@alignCast(ctx));
+        try Tower.view(r.d, dst, bytes).copyFrom(0, src, bytes, r.stream.handle);
+    }
+
+    /// The store's compaction copies end: the engine's stream drained, so a copy's device fault surfaces here.
+    fn copiesDone(ctx: *anyopaque) anyerror!void {
+        const r: *Rank0 = @ptrCast(@alignCast(ctx));
+        try r.stream.synchronize();
+    }
+};
+
+fn mib(n: usize) f64 {
+    return @as(f64, @floatFromInt(n)) / (1 << 20);
+}
+
+test "inkling2 vision: rank 0's start-up estimate is the engine-mode tower and a store of image_tokens rows (about 803 MiB)" {
+    const M: usize = 1 << 20;
+    const base = rank0Bytes(default_image_tokens);
+    // weights and tables 625.06 MiB, x [S][1024] at 4096 a side 82.88 MiB, store [10,816][4608] bf16 95.06 MiB
+    try std.testing.expect(base > 802 * M and base < 804 * M);
+    try std.testing.expectEqual(@as(usize, 10_816 * 9216), base - residentBytes(.{ .own_work = false }));
+    try std.testing.expectEqual(base + 9216, rank0Bytes(default_image_tokens + 1));
+    try std.testing.expectEqual(@as(usize, 10_609), Grid.of(4096, 4096).tokens());
+}
+
+test "inkling2 vision: images a request 1 .. 16, the splice's spans, and a store of at least one row" {
+    try checkLimits(.{});
+    try checkLimits(.{ .max_images = 1 });
+    try checkLimits(.{ .max_images = 16 });
+    try std.testing.expectError(error.VisionMaxImages, checkLimits(.{ .max_images = 17 }));
+    try std.testing.expectError(error.VisionMaxImages, checkLimits(.{ .max_images = 64 }));
+    try std.testing.expectError(error.VisionMaxImages, checkLimits(.{ .max_images = 0 }));
+    try std.testing.expectError(error.BadVisionOptions, checkLimits(.{ .image_tokens = 0 }));
+    try std.testing.expectEqual(@as(u32, 16), max_images);
+    const v: Vision = .{};
+    try std.testing.expectEqual(@as(u32, 4), v.max_images);
+    try std.testing.expectEqual(@as(u32, 10_816), v.image_tokens);
+}
+
+test "inkling2 vision: the tower's file is Vision.weights, else <dir>/inkling2-vision.safetensors" {
+    var buf: [64]u8 = undefined;
+    try std.testing.expectEqualStrings("/w/t.safetensors", try Rank0.path(&buf, "/m", .{ .weights = "/w/t.safetensors" }));
+    if (std.c.getenv("TF_INK2_VISION_WEIGHTS") != null) return error.SkipZigTest;
+    try std.testing.expectEqualStrings("/m/inkling2-vision.safetensors", try Rank0.path(&buf, "/m", .{}));
+}
+
+test "inkling2 vision: an engine unit at the largest image fits the default op scratch with room for the partials" {
+    var t: Tower = .{ .gpa = std.testing.allocator, .d = undefined, .opt = .{ .own_work = false }, .k = undefined, .lane = undefined, .vectors = undefined, .proj = undefined, .work = undefined, .max_tokens = Grid.of(4096, 4096).tokens() };
+    const M: usize = 1 << 20;
+    const need = t.sliceNeed(Grid.of(4096, 4096));
+    // the layer phase: h 82.9, qkv 248.7, ao 82.9, acc 32, g 16, cs/sn 10.4 MiB (the partials borrowed beside)
+    try std.testing.expect(need > 470 * M and need < 476 * M);
+    t.part_bytes = 64 * M;
+    try std.testing.expect(t.sliceNeed(Grid.of(4096, 4096)) <= need + 64 * M + 256);
+    try std.testing.expect(t.sliceNeed(Grid.of(4096, 4096)) < 1 << 30);
+}
+
+test "inkling2 vision: the tool's buffers give back the device work and the host index when the host weights fail" {
+    const F = struct {
+        var mem: [16]u8 align(256) = undefined;
+        var allocs: usize = 0;
+        var frees: usize = 0;
+        fn alloc(out: *u64, _: usize) callconv(.c) cuda.abi.Result {
+            out.* = @intFromPtr(&mem);
+            allocs += 1;
+            return 0;
+        }
+        fn free(_: u64) callconv(.c) cuda.abi.Result {
+            frees += 1;
+            return 0;
+        }
+    };
+    var d: cuda.Driver = .{ .lib = undefined, .api = undefined };
+    d.api.cuMemAlloc_v2 = F.alloc;
+    d.api.cuMemFree_v2 = F.free;
+    // the host index is the first host allocation, the weights the second (they fail)
+    var failing = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = 1 });
+    const g = Grid.of(64, 64);
+    var t: Tower = .{ .gpa = failing.allocator(), .d = &d, .opt = .{ .max_side = 64 }, .k = undefined, .lane = undefined, .vectors = undefined, .proj = undefined, .work = undefined, .max_tokens = g.tokens() };
+    try std.testing.expectError(error.OutOfMemory, t.allocWork(g));
+    try std.testing.expect(F.allocs == 1 and F.frees == 1); // the device work went back
+    try std.testing.expectEqual(failing.allocations, failing.deallocations); // and the host index
+}
diff --git a/zig/src/families/inkling2/cuda_vision_main.zig b/zig/src/families/inkling2/cuda_vision_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..871e1622eb57191da54650e5c5b2e6ec8ef6e242
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_vision_main.zig
@@ -0,0 +1,788 @@
+//! tf-inkling2-vision: Inkling-2's vision tower alone on one GPU (cuda_vision.zig), over the image oracle's files
+//! (tools/zig/inkling2_vision_ref.py): an input file holds {rgb u8 [H, W, 3], hw i32 [2], grid i64 [3],
+//! pixel_values f32 [T, 40, 40, 3]}.
+//!
+//! Modes:
+//!   (rows)   --model DIR --input X [--out OUT] [--hash] [--repeat N] [--bench N]: the tower's rows [T, 4608]; OUT
+//!            holds rows, grid and each layer's output at the oracle's sampled rows (layer.<i>, layer.rows).
+//!   (ops)    --model DIR --input X --ops ORACLE.ops.safetensors --op-out OUT: each op of E2 .. M2 on torch's
+//!            recorded inputs, ours written under the oracle's op names (and res1/res2 for the residual ends),
+//!            with each op's bit-equal share and max |diff| against torch's output printed and in OUT.json.
+//!   (e1)     --e1 --input X: E1 on the GPU against bf16(pixel_values) in patch order, bit for bit (no weights).
+//!   (tables) --tables TABLES.safetensors: GELU on all 65,536 bf16 inputs, inv_freq, and the position taps of
+//!            each listed grid against the oracle's tables (no weights).
+//! Settings: --row-block R (2048), --q-block Q (2048), --slice-layers N (23), --core ref|tc, --weights FILE
+//! (default: the checkpoint shard holding model.visual.* by DIR's index). The GPU is the first visible device.
+//! --variant engine (rows mode, --no-layers): the tower in engine mode, as the serving engine's rank 0 runs it: only
+//! its weights and `x` its own, every other buffer borrowed per unit from one region of `sliceNeed` bytes (filled with
+//! a junk byte before each unit, so nothing can carry across), one layer a unit, the rows into a buffer of their own.
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const vis = @import("cuda_vision.zig");
+
+const st = ink.st;
+const Stream = cuda.Stream;
+
+const usage =
+    \\usage: tf-inkling2-vision --model DIR --input X.input.safetensors [--out OUT.safetensors] [--hash]
+    \\                          [--repeat N] [--bench N] [--before Y] [--no-layers] [--variant V] [settings]
+    \\       tf-inkling2-vision --model DIR --input X --ops ORACLE.ops.safetensors --op-out OUT.safetensors [settings]
+    \\       tf-inkling2-vision --e1 --input X.input.safetensors
+    \\       tf-inkling2-vision --tables TABLES.safetensors
+    \\settings: --row-block R (2048) --q-block Q (2048) --slice-layers N (23) --core ref|tc (ref)
+    \\          --weights FILE (default: DIR's shard holding model.visual.*)
+    \\          --variant engine: engine mode (rows, --no-layers; borrowed buffers a unit, one layer a unit)
+    \\The GPU is the first visible device (set CUDA_VISIBLE_DEVICES).
+    \\
+;
+
+const Opts = struct {
+    model: ?[]const u8 = null,
+    weights: ?[]const u8 = null,
+    input: ?[]const u8 = null,
+    before: ?[]const u8 = null,
+    out: ?[]const u8 = null,
+    hash: bool = false,
+    no_layers: bool = false,
+    variant: []const u8 = "",
+    repeat: usize = 1,
+    bench: usize = 0,
+    ops: ?[]const u8 = null,
+    op_out: ?[]const u8 = null,
+    e1: bool = false,
+    tables: ?[]const u8 = null,
+    slice_layers: usize = vis.layers,
+    vo: vis.Options = .{},
+
+    fn engine(o: *const Opts) bool {
+        return std.mem.eql(u8, o.variant, "engine");
+    }
+};
+
+fn parse(args: []const [:0]const u8) !?Opts {
+    var o: Opts = .{};
+    var i: usize = 1;
+    while (i < args.len) : (i += 1) {
+        const k = args[i];
+        if (std.mem.eql(u8, k, "--hash")) {
+            o.hash = true;
+            continue;
+        }
+        if (std.mem.eql(u8, k, "--no-layers")) {
+            o.no_layers = true;
+            continue;
+        }
+        if (std.mem.eql(u8, k, "--e1")) {
+            o.e1 = true;
+            continue;
+        }
+        if (i + 1 >= args.len) return null;
+        i += 1;
+        const v = args[i];
+        if (std.mem.eql(u8, k, "--model")) {
+            o.model = v;
+        } else if (std.mem.eql(u8, k, "--weights")) {
+            o.weights = v;
+        } else if (std.mem.eql(u8, k, "--input")) {
+            o.input = v;
+        } else if (std.mem.eql(u8, k, "--variant")) {
+            o.variant = v;
+        } else if (std.mem.eql(u8, k, "--before")) {
+            o.before = v;
+        } else if (std.mem.eql(u8, k, "--out")) {
+            o.out = v;
+        } else if (std.mem.eql(u8, k, "--repeat")) {
+            o.repeat = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--bench")) {
+            o.bench = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--ops")) {
+            o.ops = v;
+        } else if (std.mem.eql(u8, k, "--op-out")) {
+            o.op_out = v;
+        } else if (std.mem.eql(u8, k, "--tables")) {
+            o.tables = v;
+        } else if (std.mem.eql(u8, k, "--row-block")) {
+            o.vo.row_block = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--q-block")) {
+            o.vo.q_block = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--slice-layers")) {
+            o.slice_layers = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--core")) {
+            o.vo.core = std.meta.stringToEnum(vis.Core, v) orelse return null;
+        } else return null;
+    }
+    if (o.vo.row_block == 0 or o.vo.q_block == 0 or o.slice_layers == 0 or o.repeat == 0) return null;
+    if (o.tables != null) return o;
+    if (o.input == null) return null;
+    if (o.e1) return o;
+    if (o.model == null and o.weights == null) return null;
+    if ((o.ops == null) != (o.op_out == null)) return null;
+    if (o.engine()) {
+        if (o.ops != null or o.before != null or o.bench > 0 or (o.out != null and !o.no_layers)) return null;
+        o.vo.own_work = false;
+    }
+    return o;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    const o = (parse(args) catch null) orelse {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    };
+    return run(a, init.gpa, init.io, o) catch |e| {
+        std.debug.print("FAIL tf-inkling2-vision: {t}\n", .{e});
+        return 1;
+    };
+}
+
+/// The safetensors file of DIR's index that holds model.visual.proj_out.weight.
+fn weightsFile(a: std.mem.Allocator, io: std.Io, dir: []const u8) ![]const u8 {
+    const path = try std.fs.path.join(a, &.{ dir, "model.safetensors.index.json" });
+    const text = try std.Io.Dir.cwd().readFileAlloc(io, path, a, .limited(1 << 26));
+    const doc = try std.json.parseFromSliceLeaky(std.json.Value, a, text, .{});
+    if (doc != .object) return error.BadIndex;
+    const map = doc.object.get("weight_map") orelse return error.BadIndex;
+    if (map != .object) return error.BadIndex;
+    const f = map.object.get("model.visual.proj_out.weight") orelse return error.NoVisionTower;
+    if (f != .string) return error.BadIndex;
+    return std.fs.path.join(a, &.{ dir, f.string });
+}
+
+const Input = struct {
+    h: usize,
+    w: usize,
+    grid: vis.Grid,
+    rgb: []u8,
+    reader: st.Reader,
+};
+
+fn openInput(gpa: std.mem.Allocator, a: std.mem.Allocator, io: std.Io, path: []const u8) !Input {
+    var r = try st.Reader.open(gpa, io, path);
+    errdefer r.close();
+    const hw = try r.alloc(a, "hw", .i32);
+    const h: usize = @intCast(std.mem.readInt(i32, hw[0..4], .little));
+    const w: usize = @intCast(std.mem.readInt(i32, hw[4..8], .little));
+    const gb = try r.alloc(a, "grid", .i64);
+    const g = vis.Grid.of(h, w);
+    const rows: usize = @intCast(std.mem.readInt(i64, gb[gb.len - 16 ..][0..8], .little));
+    const cols: usize = @intCast(std.mem.readInt(i64, gb[gb.len - 8 ..][0..8], .little));
+    if (rows != g.rows or cols != g.cols) {
+        std.log.err("{s}: grid {d}x{d}, but {d}x{d} pixels give {d}x{d}", .{ path, rows, cols, h, w, g.rows, g.cols });
+        return error.UnexpectedGrid;
+    }
+    const rgb = try r.alloc(a, "rgb", .u8);
+    if (rgb.len != h * w * 3) return error.UnexpectedInput;
+    return .{ .h = h, .w = w, .grid = g, .rgb = rgb, .reader = r };
+}
+
+fn run(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try Stream.init(&driver, true);
+    defer stream.deinit();
+    if (o.tables) |p| return tables(a, gpa, io, &driver, stream, p);
+    var in = try openInput(gpa, a, io, o.input.?);
+    defer in.reader.close();
+    if (o.e1) return e1Check(a, &driver, stream, &in);
+    const clock = std.Io.Clock.awake;
+    const wpath = o.weights orelse try weightsFile(a, io, o.model.?);
+    const t0 = clock.now(io).toNanoseconds();
+    var tower = try vis.Tower.load(gpa, io, &driver, wpath, o.vo, .{});
+    defer tower.deinit();
+    std.debug.print("tower loaded in {d:.1} s from {s}: {d} MiB on the device; row block {d}, q block {d}, core {t}\n", .{ secs(clock.now(io).toNanoseconds() - t0), std.fs.path.basename(wpath), tower.deviceBytes() >> 20, o.vo.row_block, o.vo.q_block, o.vo.core });
+    if (o.ops) |p| return opCheck(a, gpa, io, &driver, stream, &tower, &in, p, o.op_out.?);
+    if (o.before) |p| { // another image through the tower first: its state must not reach this image's rows
+        var b = try openInput(gpa, a, io, p);
+        defer b.reader.close();
+        _ = try tower.run(stream, b.rgb, b.h, b.w);
+        try stream.synchronize();
+        std.debug.print("before: {s} ({d}x{d}) through the tower first\n", .{ std.fs.path.basename(p), b.w, b.h });
+    }
+    return towerRows(a, gpa, io, &driver, stream, &tower, &in, o);
+}
+
+fn secs(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-9;
+}
+
+fn ms(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-6;
+}
+
+// ---------------------------------------------------------------------------------------------------------- rows
+
+/// The oracle's sampled tower rows (inkling2_vision_ref.py sample_tower_rows): 0 .. 32, the last 32, every 64th.
+fn sampleRows(a: std.mem.Allocator, S: usize) ![]i32 {
+    var list: std.ArrayList(i32) = .empty;
+    for (0..S) |r| {
+        if (r < 33 or r + 32 >= S or r % 64 == 0) try list.append(a, @intCast(r));
+    }
+    return list.items;
+}
+
+fn towerRows(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: Stream, tower: *vis.Tower, in: *const Input, o: Opts) !u8 {
+    const clock = std.Io.Clock.awake;
+    const g = in.grid;
+    const S = g.towerRows();
+    const T = g.tokens();
+    std.debug.print("image {d}x{d}: grid {d}x{d}, {d} tokens, {d} tower rows\n", .{ in.w, in.h, g.rows, g.cols, T, S });
+    const host = try a.alloc(u8, T * vis.out_width * 2);
+    var first: ?[32]u8 = null;
+    var same = true;
+    // the sampled layer rows when OUT is wanted (one layer a step then, whatever --slice-layers says)
+    var sample: []i32 = &.{};
+    var sample_dev: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    var gathered: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    var layer_rows: [vis.layers][]u8 = undefined;
+    const layers_out = o.out != null and !o.no_layers;
+    if (layers_out) {
+        sample = try sampleRows(a, S);
+        sample_dev = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(sample));
+        gathered = try cuda.DeviceBuffer.alloc(d, sample.len * vis.hidden * 2);
+        for (&layer_rows) |*l| l.* = try a.alloc(u8, sample.len * vis.hidden * 2);
+    }
+    defer if (layers_out) {
+        sample_dev.free();
+        gathered.free();
+    };
+    // engine mode: one borrowed region a unit, and the rows' own buffer
+    var region: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    var rows_buf: cuda.DeviceBuffer = .{ .d = d, .ptr = 0, .len = 0 };
+    defer if (o.engine()) {
+        region.free();
+        rows_buf.free();
+    };
+    if (o.engine()) {
+        region = try cuda.DeviceBuffer.alloc(d, tower.sliceNeed(g));
+        rows_buf = try cuda.DeviceBuffer.alloc(d, T * vis.out_width * 2);
+        std.debug.print("engine mode: {d} MiB resident, {d:.1} MiB borrowed a unit for this image ({d:.1} MiB at {d} a side)\n", .{ tower.deviceBytes() >> 20, @as(f64, @floatFromInt(region.len)) / (1 << 20), @as(f64, @floatFromInt(tower.sliceNeed(vis.Grid.of(o.vo.max_side, o.vo.max_side)))) / (1 << 20), o.vo.max_side });
+    }
+    for (0..o.repeat) |rep| {
+        const t0 = clock.now(io).toNanoseconds();
+        if (o.engine()) {
+            try region.fill8(0x5a, s.handle);
+            try tower.bindSlice(s, region.ptr, region.len, .begin, g);
+            try tower.begin(s, in.rgb, in.h, in.w);
+            for (0..vis.layers) |_| {
+                try region.fill8(0x5a, s.handle);
+                try tower.bindSlice(s, region.ptr, region.len, .layer, g);
+                _ = try tower.step(s, 1);
+            }
+            try region.fill8(0x5a, s.handle);
+            try tower.bindSlice(s, region.ptr, region.len, .merger, g);
+            const out = try tower.finishInto(s, rows_buf.ptr);
+            try s.synchronize();
+            const t1 = clock.now(io).toNanoseconds();
+            try cuda.memory.download(d, out.ptr, host);
+            var dg: [32]u8 = undefined;
+            std.crypto.hash.sha2.Sha256.hash(host, &dg, .{});
+            if (first) |f| {
+                if (!std.mem.eql(u8, &f, &dg)) same = false;
+            } else first = dg;
+            if (o.hash) std.debug.print("HASH {s} run {d} rows [{d},{d}] sha256 {s} ({d:.1} ms; engine mode, one layer a unit, row block {d}, q block {d}, core {t})\n", .{ std.fs.path.basename(o.input.?), rep, T, vis.out_width, std.fmt.bytesToHex(dg, .lower), ms(t1 - t0), o.vo.row_block, o.vo.q_block, o.vo.core });
+            continue;
+        }
+        try tower.begin(s, in.rgb, in.h, in.w);
+        if (layers_out) {
+            var i: usize = 0;
+            while (i < vis.layers) : (i += 1) {
+                _ = try tower.step(s, 1);
+                try tower.k.gatherRows(s, tower.x, sample_dev.ptr, sample.len, gathered.ptr);
+                try s.synchronize();
+                try gathered.download(0, layer_rows[i]);
+            }
+        } else {
+            while (try tower.step(s, o.slice_layers) > 0) {}
+        }
+        const out = try tower.finish(s);
+        try s.synchronize();
+        const t1 = clock.now(io).toNanoseconds();
+        try cuda.memory.download(d, out.ptr, host);
+        var dg: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(host, &dg, .{});
+        if (first) |f| {
+            if (!std.mem.eql(u8, &f, &dg)) same = false;
+        } else first = dg;
+        if (o.hash) std.debug.print("HASH {s} run {d} rows [{d},{d}] sha256 {s} ({d:.1} ms; row block {d}, q block {d}, slice {d}, core {t})\n", .{ std.fs.path.basename(o.input.?), rep, T, vis.out_width, std.fmt.bytesToHex(dg, .lower), ms(t1 - t0), o.vo.row_block, o.vo.q_block, if (layers_out) 1 else o.slice_layers, o.vo.core });
+    }
+    if (o.repeat > 1) std.debug.print("REPEAT {d} runs: {s}\n", .{ o.repeat, if (same) "identical" else "DIFFER" });
+    if (o.bench > 0) {
+        const times = try a.alloc(f64, o.bench);
+        _ = try tower.run(s, in.rgb, in.h, in.w); // warm-up
+        try s.synchronize();
+        for (times) |*x| {
+            const t0 = clock.now(io).toNanoseconds();
+            try tower.begin(s, in.rgb, in.h, in.w);
+            while (try tower.step(s, o.slice_layers) > 0) {}
+            _ = try tower.finish(s);
+            try s.synchronize();
+            x.* = ms(clock.now(io).toNanoseconds() - t0);
+        }
+        std.mem.sort(f64, times, {}, std.sort.asc(f64));
+        std.debug.print("BENCH {s} {d}x{d} tokens {d} S {d}: median {d:.2} ms over {d} runs (min {d:.2}, max {d:.2}); core {t}, row block {d}, q block {d}\n", .{ std.fs.path.basename(o.input.?), in.w, in.h, T, S, times[times.len / 2], times.len, times[0], times[times.len - 1], o.vo.core, o.vo.row_block, o.vo.q_block });
+    }
+    if (o.out) |path| {
+        var wr = st.Writer.init(gpa);
+        defer wr.deinit();
+        try wr.add("rows", .bf16, &.{ T, vis.out_width }, host);
+        var gb: [3]i64 = .{ 1, @intCast(g.rows), @intCast(g.cols) };
+        try wr.add("grid", .i64, &.{ 1, 3 }, std.mem.sliceAsBytes(&gb));
+        if (layers_out) {
+            const lr = try a.alloc(i64, sample.len);
+            for (lr, sample) |*x, r| x.* = r;
+            try wr.add("layer.rows", .i64, &.{lr.len}, std.mem.sliceAsBytes(lr));
+            for (layer_rows, 0..) |l, i| {
+                var nb: [32]u8 = undefined;
+                try wr.add(try std.fmt.bufPrint(&nb, "layer.{d}", .{i}), .bf16, &.{ sample.len, vis.hidden }, l);
+            }
+        }
+        if (o.variant.len > 0) try wr.setMeta("variant", o.variant);
+        try wr.setMeta("fixture", std.fs.path.basename(o.input.?)[0 .. std.mem.indexOf(u8, std.fs.path.basename(o.input.?), ".input") orelse std.fs.path.basename(o.input.?).len]);
+        try wr.setMeta("tool", "tf-inkling2-vision");
+        try wr.setMeta("input", std.fs.path.basename(o.input.?));
+        try wr.setMeta("core", @tagName(o.vo.core));
+        try wr.setMeta("sha256", &std.fmt.bytesToHex(first.?, .lower));
+        try wr.write(io, path);
+        std.debug.print("wrote {s}\n", .{path});
+    }
+    return if (same) 0 else 1;
+}
+
+// ---------------------------------------------------------------------------------------------------------- E1
+
+fn e1Check(a: std.mem.Allocator, d: *const cuda.Driver, s: Stream, in: *const Input) !u8 {
+    const g = in.grid;
+    const P = g.patches();
+    const pv_bytes = try in.reader.alloc(a, "pixel_values", .f32);
+    const pv = std.mem.bytesAsSlice(f32, pv_bytes);
+    if (pv.len != g.tokens() * vis.block * vis.block * 3) return error.UnexpectedInput;
+    var k = try vis.Kernels.load(d);
+    defer k.unload();
+    const table = vis.pixelTable();
+    var tb = try cuda.DeviceBuffer.fromHost(d, std.mem.sliceAsBytes(&table));
+    defer tb.free();
+    var rgb = try cuda.DeviceBuffer.fromHost(d, in.rgb);
+    defer rgb.free();
+    var out = try cuda.DeviceBuffer.alloc(d, P * vis.features_pad * 2);
+    defer out.free();
+    try k.patchRows(s, rgb.ptr, tb.ptr, in.h, in.w, g.cols, 0, P, out.ptr);
+    try s.synchronize();
+    const got_b = try a.alloc(u8, P * vis.features_pad * 2);
+    try out.download(0, got_b);
+    const got = std.mem.bytesAsSlice(u16, got_b);
+    var equal: usize = 0;
+    var zero_tail = true;
+    for (0..P) |p| {
+        const t = p / 4;
+        const mi = (p % 4) / 2;
+        const mj = p % 2;
+        for (0..vis.features) |f| {
+            const py = f / 60;
+            const px = (f / 3) % 20;
+            const c = f % 3;
+            const want = st.f32ToBf16(pv[((t * vis.block + mi * vis.patch + py) * vis.block + mj * vis.patch + px) * 3 + c]);
+            if (got[p * vis.features_pad + f] == want) equal += 1;
+        }
+        for (vis.features..vis.features_pad) |f| if (got[p * vis.features_pad + f] != 0) {
+            zero_tail = false;
+        };
+    }
+    const total = P * vis.features;
+    std.debug.print("E1 {d}x{d} grid {d}x{d}: {d} patches, bit-equal {d}/{d} to bf16(pixel_values), padding columns zero {}\n", .{ in.w, in.h, g.rows, g.cols, P, equal, total, zero_tail });
+    return if (equal == total and zero_tail) 0 else 1;
+}
+
+// ------------------------------------------------------------------------------------------------------ tables
+
+fn tables(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: Stream, path: []const u8) !u8 {
+    var r = try st.Reader.open(gpa, io, path);
+    defer r.close();
+    var bad: usize = 0;
+    // GELU on every bf16 input
+    {
+        const gin = try r.alloc(a, "gelu.in", .bf16);
+        const gout = try r.alloc(a, "gelu.out", .bf16);
+        var k = try vis.Kernels.load(d);
+        defer k.unload();
+        var b = try cuda.DeviceBuffer.fromHost(d, gin);
+        defer b.free();
+        const n = gin.len / 2;
+        try k.gelu(s, b.ptr, b.ptr, n);
+        try s.synchronize();
+        const got = try a.alloc(u8, gin.len);
+        try b.download(0, got);
+        const c = compareBf16(std.mem.bytesAsSlice(u16, got), std.mem.bytesAsSlice(u16, gout));
+        std.debug.print("TABLE gelu: {d} inputs, bit-equal {d}, max |diff| {e}\n", .{ n, c.equal, c.max_abs });
+        const xs = std.mem.bytesAsSlice(u16, gin);
+        const ys = std.mem.bytesAsSlice(u16, got);
+        const zs = std.mem.bytesAsSlice(u16, gout);
+        var shown: usize = 0;
+        for (xs, ys, zs) |x, y, z| if (y != z and shown < 16) {
+            shown += 1;
+            std.debug.print("  gelu differs: in {x:0>4} ({e}) ours {x:0>4} ({e}) torch {x:0>4} ({e})\n", .{ x, st.bf16ToF32(x), y, st.bf16ToF32(y), z, st.bf16ToF32(z) });
+        };
+        if (c.equal != n) bad += 1;
+    }
+    {
+        const inv = try r.alloc(a, "rope.inv_freq", .f32);
+        const want = std.mem.bytesAsSlice(u32, inv);
+        var eq: usize = 0;
+        for (vis.invFreq(), 0..) |f, j| {
+            if (@as(u32, @bitCast(f)) == want[j]) eq += 1;
+        }
+        std.debug.print("TABLE rope.inv_freq: bit-equal {d}/16\n", .{eq});
+        if (eq != 16) bad += 1;
+    }
+    for (r.entries) |e| {
+        if (!std.mem.startsWith(u8, e.name, "pos.idx.")) continue;
+        const tag = e.name["pos.idx.".len..];
+        const x = std.mem.indexOfScalar(u8, tag, 'x') orelse continue;
+        const g: vis.Grid = .{ .rows = try std.fmt.parseInt(usize, tag[0..x], 10), .cols = try std.fmt.parseInt(usize, tag[x + 1 ..], 10) };
+        const P = g.patches();
+        const idx_b = try r.alloc(a, e.name, .i64);
+        var nb: [64]u8 = undefined;
+        const w_b = try r.alloc(a, try std.fmt.bufPrint(&nb, "pos.w.{s}", .{tag}), .f32);
+        const want_idx = std.mem.bytesAsSlice(i64, idx_b);
+        const want_w = std.mem.bytesAsSlice(u32, w_b);
+        if (want_idx.len != 4 * P or want_w.len != 4 * P) return error.UnexpectedTable;
+        const idx = try a.alloc(i32, 4 * P);
+        const w = try a.alloc(f32, 4 * P);
+        vis.positionTaps(g, idx, w);
+        var ei: usize = 0;
+        var ew: usize = 0;
+        for (0..4 * P) |i| {
+            if (idx[i] == want_idx[i]) ei += 1;
+            if (@as(u32, @bitCast(w[i])) == want_w[i]) ew += 1;
+        }
+        std.debug.print("TABLE pos {d}x{d}: {d} taps, indices bit-equal {d}, weights bit-equal {d}\n", .{ g.rows, g.cols, 4 * P, ei, ew });
+        if (ei != 4 * P or ew != 4 * P) bad += 1;
+    }
+    std.debug.print("TABLES: {d} tables differ\n", .{bad});
+    return if (bad == 0) 0 else 1;
+}
+
+// --------------------------------------------------------------------------------------------------------- ops
+
+const Cmp = struct { n: usize, equal: usize, max_abs: f64 };
+
+fn compareBf16(got: []align(1) const u16, want: []align(1) const u16) Cmp {
+    var c: Cmp = .{ .n = want.len, .equal = 0, .max_abs = 0 };
+    for (got, want) |x, y| {
+        if (x == y) {
+            c.equal += 1;
+            continue;
+        }
+        const dx: f64 = @abs(@as(f64, st.bf16ToF32(x)) - @as(f64, st.bf16ToF32(y)));
+        if (!(dx <= c.max_abs)) c.max_abs = dx; // NaN shows as NaN
+    }
+    return c;
+}
+
+fn compareF32(got: []align(1) const u32, want: []align(1) const u32) Cmp {
+    var c: Cmp = .{ .n = want.len, .equal = 0, .max_abs = 0 };
+    for (got, want) |x, y| {
+        if (x == y) {
+            c.equal += 1;
+            continue;
+        }
+        const dx: f64 = @abs(@as(f64, @as(f32, @bitCast(x))) - @as(f64, @as(f32, @bitCast(y))));
+        if (!(dx <= c.max_abs)) c.max_abs = dx;
+    }
+    return c;
+}
+
+const OpCtx = struct {
+    a: std.mem.Allocator,
+    d: *const cuda.Driver,
+    s: Stream,
+    r: *const st.Reader,
+    wr: *st.Writer,
+    json: *std.ArrayList(u8),
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+
+    /// torch's tensor `name` (dtype dt) on the device, its bytes too.
+    fn up(c: *OpCtx, name: []const u8, dt: st.DType) !struct { ptr: u64, host: []u8, e: st.Entry } {
+        const e = c.r.find(name) orelse {
+            std.log.err("the ops file has no {s}", .{name});
+            return error.MissingTensor;
+        };
+        const host = try c.r.alloc(c.a, name, dt);
+        const b = try cuda.DeviceBuffer.fromHost(c.d, host);
+        try c.own.append(c.a, b);
+        return .{ .ptr = b.ptr, .host = host, .e = e };
+    }
+
+    fn alloc(c: *OpCtx, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(c.d, bytes);
+        try b.fill8(0, null);
+        try c.own.append(c.a, b);
+        return b.ptr;
+    }
+
+    fn down(c: *OpCtx, ptr: u64, bytes: usize) ![]u8 {
+        try c.s.synchronize();
+        const h = try c.a.alloc(u8, bytes);
+        try cuda.memory.download(c.d, ptr, h);
+        return h;
+    }
+
+    /// Ours (host bytes, torch's shape of `ref`) written as `key`, compared with torch's `ref`.
+    fn report(c: *OpCtx, key: []const u8, ours: []const u8, ref: []const u8, dt: st.DType) !void {
+        const e = c.r.find(ref) orelse return error.MissingTensor;
+        const want = try c.r.alloc(c.a, ref, dt);
+        if (want.len != ours.len) return error.UnexpectedShape;
+        const cmp = if (dt == .f32)
+            compareF32(std.mem.bytesAsSlice(u32, ours), std.mem.bytesAsSlice(u32, want))
+        else
+            compareBf16(std.mem.bytesAsSlice(u16, ours), std.mem.bytesAsSlice(u16, want));
+        try c.wr.add(key, dt, e.shape[0..e.rank], ours);
+        const share = @as(f64, @floatFromInt(cmp.equal)) / @as(f64, @floatFromInt(@max(cmp.n, 1)));
+        std.debug.print("OP {s:<24} vs {s:<24} n {d:>10}  bit-equal {d:.6}  max|diff| {e}\n", .{ key, ref, cmp.n, share, cmp.max_abs });
+        const sep: []const u8 = if (c.json.items.len > 1) ",\n" else "\n";
+        try c.json.appendSlice(c.a, try std.fmt.allocPrint(c.a, "{s}  \"{s}\": {{\"ref\": \"{s}\", \"n\": {d}, \"equal\": {d}, \"share\": {d:.8}, \"max_abs\": {e}}}", .{ sep, key, ref, cmp.n, cmp.equal, share, cmp.max_abs }));
+    }
+
+    fn free(c: *OpCtx) void {
+        for (c.own.items) |*b| b.free();
+        c.own.clearRetainingCapacity();
+    }
+};
+
+/// [1, 16, S, 64] to [S, 1024] (head-major to row-major), 2-byte elements.
+fn headsToRows(a: std.mem.Allocator, x: []const u8, S: usize) ![]u8 {
+    const out = try a.alloc(u8, x.len);
+    const src = std.mem.bytesAsSlice(u16, x);
+    const dst = std.mem.bytesAsSlice(u16, out);
+    for (0..vis.heads) |h| for (0..S) |r| {
+        @memcpy(dst[r * vis.hidden + h * vis.head_dim ..][0..vis.head_dim], src[(h * S + r) * vis.head_dim ..][0..vis.head_dim]);
+    };
+    return out;
+}
+
+fn rowsToHeads(a: std.mem.Allocator, x: []const u8, S: usize) ![]u8 {
+    const out = try a.alloc(u8, x.len);
+    const src = std.mem.bytesAsSlice(u16, x);
+    const dst = std.mem.bytesAsSlice(u16, out);
+    for (0..vis.heads) |h| for (0..S) |r| {
+        @memcpy(dst[(h * S + r) * vis.head_dim ..][0..vis.head_dim], src[r * vis.hidden + h * vis.head_dim ..][0..vis.head_dim]);
+    };
+    return out;
+}
+
+fn opCheck(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, d: *const cuda.Driver, s: Stream, t: *vis.Tower, in: *const Input, ops_path: []const u8, out_path: []const u8) !u8 {
+    var r = try st.Reader.open(gpa, io, ops_path);
+    defer r.close();
+    var wr = st.Writer.init(gpa);
+    defer wr.deinit();
+    var json: std.ArrayList(u8) = .empty;
+    try json.append(a, '{');
+    var c: OpCtx = .{ .a = a, .d = d, .s = s, .r = &r, .wr = &wr, .json = &json };
+    defer c.free();
+    const g = in.grid;
+    const S = g.towerRows();
+    const P = g.patches();
+    const T = g.tokens();
+    const H = vis.hidden;
+    std.debug.print("ops {s}: grid {d}x{d}, S {d}\n", .{ std.fs.path.basename(ops_path), g.rows, g.cols, S });
+    // the image's taps and rotary tables (no pixels)
+    try t.prepareGrid(s, g);
+    // E2 from torch's patches (padded to 1216)
+    {
+        const pin = try r.alloc(a, "E2.patch.in", .bf16);
+        if (pin.len != P * vis.features * 2) return error.UnexpectedShape;
+        const pad = try a.alloc(u8, P * vis.features_pad * 2);
+        @memset(pad, 0);
+        for (0..P) |p| @memcpy(pad[p * vis.features_pad * 2 ..][0 .. vis.features * 2], pin[p * vis.features * 2 ..][0 .. vis.features * 2]);
+        var b = try cuda.DeviceBuffer.fromHost(d, pad);
+        try c.own.append(a, b);
+        _ = &b;
+        const y = try c.alloc(P * H * 2);
+        try t.linear(s, b.ptr, vis.features_pad, P, t.patch_w, y);
+        try c.report("E2.patch.out", try c.down(y, P * H * 2), "E2.patch.out", .bf16);
+    }
+    // E3 + E4 from torch's E2 output
+    {
+        const e2 = try c.up("E2.patch.out", .bf16);
+        const x = try c.alloc(S * H * 2);
+        var p0: usize = 0;
+        while (p0 < P) : (p0 += t.opt.row_block) {
+            const n = @min(t.opt.row_block, P - p0);
+            try t.k.embedRows(s, e2.ptr + p0 * H * 2, t.pos_table, t.idx, t.wts, p0, n, x);
+        }
+        try t.k.classRow(s, t.class, t.cls_pos, x);
+        try c.report("E4.embeddings.out", try c.down(x, S * H * 2), "E4.embeddings.out", .bf16);
+    }
+    {
+        const xin = try c.up("E5.ln_pre.in", .bf16);
+        const y = try c.alloc(S * H * 2);
+        try t.layerNormRows(s, xin.ptr, t.ln_pre_w, t.ln_pre_b, y, S);
+        try c.report("E5.ln_pre.out", try c.down(y, S * H * 2), "E5.ln_pre.out", .bf16);
+    }
+    c.free();
+    for (0..vis.layers) |li| {
+        var nb: [64]u8 = undefined;
+        if (r.find(try std.fmt.bufPrint(&nb, "L{d}.layer.in", .{li})) == null) continue;
+        const l = &t.layer[li];
+        const N = struct {
+            fn of(al: std.mem.Allocator, i: usize, name: []const u8) ![]const u8 {
+                return std.fmt.allocPrint(al, "L{d}.{s}", .{ i, name });
+            }
+        };
+        // L1
+        {
+            const xin = try c.up(try N.of(a, li, "L1.ln_1.in"), .bf16);
+            const y = try c.alloc(S * H * 2);
+            try t.layerNormRows(s, xin.ptr, l.ln1_w, l.ln1_b, y, S);
+            try c.report(try N.of(a, li, "L1.ln_1.out"), try c.down(y, S * H * 2), try N.of(a, li, "L1.ln_1.out"), .bf16);
+        }
+        // L2: the fused q|k|v with its bias, from torch's normed rows
+        {
+            const xin = try c.up(try N.of(a, li, "L1.ln_1.out"), .bf16);
+            const y = try c.alloc(S * 3 * H * 2);
+            try t.linearBias(s, xin.ptr, H, S, l.qkv, l.b_qkv, y, 3 * H);
+            const all = try c.down(y, S * 3 * H * 2);
+            for ([_][]const u8{ "q", "k", "v" }, 0..) |p, j| {
+                const part = try a.alloc(u8, S * H * 2);
+                for (0..S) |row| @memcpy(part[row * H * 2 ..][0 .. H * 2], all[(row * 3 + j) * H * 2 ..][0 .. H * 2]);
+                const key = try N.of(a, li, try std.fmt.allocPrint(a, "L2.{s}_proj.out", .{p}));
+                try c.report(key, part, key, .bf16);
+            }
+        }
+        // L3: rotary from torch's q, k; and our cos, sin against torch's
+        {
+            const qi = try c.r.alloc(a, try N.of(a, li, "rot.q_in"), .bf16);
+            const ki = try c.r.alloc(a, try N.of(a, li, "rot.k_in"), .bf16);
+            if (qi.len != S * H * 2 or ki.len != S * H * 2) return error.UnexpectedShape;
+            const qkv = try a.alloc(u8, S * 3 * H * 2);
+            @memset(qkv, 0);
+            for (0..S) |row| {
+                @memcpy(qkv[row * 3 * H * 2 ..][0 .. H * 2], qi[row * H * 2 ..][0 .. H * 2]);
+                @memcpy(qkv[(row * 3 + 1) * H * 2 ..][0 .. H * 2], ki[row * H * 2 ..][0 .. H * 2]);
+            }
+            var b = try cuda.DeviceBuffer.fromHost(d, qkv);
+            try c.own.append(a, b);
+            _ = &b;
+            var r0: usize = 0;
+            while (r0 < S) : (r0 += t.opt.row_block) try t.k.rotary(s, b.ptr, 3 * H, t.cs, t.sn, r0, @min(t.opt.row_block, S - r0));
+            const all = try c.down(b.ptr, S * 3 * H * 2);
+            for ([_][]const u8{ "q", "k" }, 0..) |p, j| {
+                const part = try a.alloc(u8, S * H * 2);
+                for (0..S) |row| @memcpy(part[row * H * 2 ..][0 .. H * 2], all[(row * 3 + j) * H * 2 ..][0 .. H * 2]);
+                const key = try N.of(a, li, try std.fmt.allocPrint(a, "rot.{s}_out", .{p}));
+                try c.report(key, part, key, .bf16);
+            }
+            for ([_][]const u8{ "cos", "sin" }, [_]u64{ t.cs, t.sn }) |p, ptr| {
+                const tab = try c.down(ptr, S * 32 * 4);
+                const v32 = std.mem.bytesAsSlice(u32, tab);
+                const wide = try a.alloc(u32, S * 64);
+                for (0..S) |row| for (0..32) |i| {
+                    wide[row * 64 + 2 * i] = v32[row * 32 + i];
+                    wide[row * 64 + 2 * i + 1] = v32[row * 32 + i];
+                };
+                const key = try N.of(a, li, try std.fmt.allocPrint(a, "rot.{s}", .{p}));
+                try c.report(key, std.mem.sliceAsBytes(wide), key, .f32);
+            }
+        }
+        // L4: the core on torch's q', k, v
+        {
+            var bufs: [3]u64 = undefined;
+            for ([_][]const u8{ "core.q", "core.k", "core.v" }, &bufs) |p, *ptr| {
+                const raw = try c.r.alloc(a, try N.of(a, li, p), .bf16);
+                if (raw.len != S * H * 2) return error.UnexpectedShape;
+                var b = try cuda.DeviceBuffer.fromHost(d, try headsToRows(a, raw, S));
+                try c.own.append(a, b);
+                _ = &b;
+                ptr.* = b.ptr;
+            }
+            const y = try c.alloc(S * H * 2);
+            const t0 = std.Io.Clock.awake.now(io).toNanoseconds();
+            try t.attention(s, t.opt.core, bufs[0], bufs[1], bufs[2], H, S, y);
+            try s.synchronize();
+            std.debug.print("core {t} on {d} rows: {d:.1} ms\n", .{ t.opt.core, S, ms(std.Io.Clock.awake.now(io).toNanoseconds() - t0) });
+            const key = try N.of(a, li, "core.out");
+            try c.report(key, try rowsToHeads(a, try c.down(y, S * H * 2), S), key, .bf16);
+        }
+        // L5: out_proj with its bias
+        {
+            const xin = try c.up(try N.of(a, li, "L2.out_proj.in"), .bf16);
+            const y = try c.alloc(S * H * 2);
+            try t.linearBias(s, xin.ptr, H, S, l.o, l.b_o, y, H);
+            const key = try N.of(a, li, "L2.out_proj.out");
+            try c.report(key, try c.down(y, S * H * 2), key, .bf16);
+        }
+        // L6: layer.in + ls_1 * torch's out_proj output (torch's value: ln_2's input)
+        {
+            const x = try c.up(try N.of(a, li, "layer.in"), .bf16);
+            const y = try c.up(try N.of(a, li, "L2.out_proj.out"), .bf16);
+            var r0: usize = 0;
+            while (r0 < S) : (r0 += t.opt.row_block) try t.k.lsRes(s, y.ptr + r0 * H * 2, l.ls1, x.ptr + r0 * H * 2, @min(t.opt.row_block, S - r0));
+            try c.report(try N.of(a, li, "res1.out"), try c.down(x.ptr, S * H * 2), try N.of(a, li, "L7.ln_2.in"), .bf16);
+        }
+        {
+            const xin = try c.up(try N.of(a, li, "L7.ln_2.in"), .bf16);
+            const y = try c.alloc(S * H * 2);
+            try t.layerNormRows(s, xin.ptr, l.ln2_w, l.ln2_b, y, S);
+            const key = try N.of(a, li, "L7.ln_2.out");
+            try c.report(key, try c.down(y, S * H * 2), key, .bf16);
+        }
+        // L8: fc1 + bias + GELU from fc1's input; fc2 + bias from fc2's input
+        {
+            const xin = try c.up(try N.of(a, li, "L8.fc1.in"), .bf16);
+            const y = try c.alloc(S * vis.inter * 2);
+            try t.linearBiasGelu(s, xin.ptr, H, S, l.fc1, l.b_fc1, y);
+            const key = try N.of(a, li, "L8.gelu.out");
+            try c.report(key, try c.down(y, S * vis.inter * 2), key, .bf16);
+        }
+        {
+            const xin = try c.up(try N.of(a, li, "L8.fc2.in"), .bf16);
+            const y = try c.alloc(S * H * 2);
+            try t.linearBias(s, xin.ptr, vis.inter, S, l.fc2, l.b_fc2, y, H);
+            const key = try N.of(a, li, "L8.fc2.out");
+            try c.report(key, try c.down(y, S * H * 2), key, .bf16);
+        }
+        // L9: ln_2's input + ls_2 * torch's fc2 output (torch's value: the layer's output)
+        {
+            const x = try c.up(try N.of(a, li, "L7.ln_2.in"), .bf16);
+            const y = try c.up(try N.of(a, li, "L8.fc2.out"), .bf16);
+            var r0: usize = 0;
+            while (r0 < S) : (r0 += t.opt.row_block) try t.k.lsRes(s, y.ptr + r0 * H * 2, l.ls2, x.ptr + r0 * H * 2, @min(t.opt.row_block, S - r0));
+            try c.report(try N.of(a, li, "res2.out"), try c.down(x.ptr, S * H * 2), try N.of(a, li, "layer.out"), .bf16);
+        }
+        c.free();
+    }
+    // M2
+    {
+        const xin = try c.up("M2.linear_1.in", .bf16);
+        const y = try c.alloc(T * vis.proj_hidden * 2);
+        try t.linear(s, xin.ptr, 4 * H, T, t.m1, y);
+        try c.report("M2.linear_1.out", try c.down(y, T * vis.proj_hidden * 2), "M2.linear_1.out", .bf16);
+    }
+    {
+        const xin = try c.up("M2.gelu.in", .bf16);
+        const y = try c.alloc(T * vis.proj_hidden * 2);
+        try t.k.gelu(s, xin.ptr, y, T * vis.proj_hidden);
+        try c.report("M2.gelu.out", try c.down(y, T * vis.proj_hidden * 2), "M2.gelu.out", .bf16);
+    }
+    {
+        const xin = try c.up("M2.linear_2.in", .bf16);
+        const y = try c.alloc(T * vis.out_width * 2);
+        try t.linear(s, xin.ptr, vis.proj_hidden, T, t.m2, y);
+        try c.report("M2.linear_2.out", try c.down(y, T * vis.out_width * 2), "M2.linear_2.out", .bf16);
+    }
+    try json.appendSlice(a, "\n}\n");
+    try wr.setMeta("tool", "tf-inkling2-vision --ops");
+    try wr.setMeta("ops", std.fs.path.basename(ops_path));
+    try wr.setMeta("core", @tagName(t.opt.core));
+    try wr.write(io, out_path);
+    const jpath = try std.fmt.allocPrint(a, "{s}.json", .{out_path});
+    const f = try std.Io.Dir.cwd().createFile(io, jpath, .{ .truncate = true });
+    defer f.close(io);
+    try f.writePositionalAll(io, json.items, 0);
+    std.debug.print("wrote {s} and {s}\n", .{ out_path, jpath });
+    return 0;
+}
diff --git a/zig/src/families/inkling2/cuda_vision_store.zig b/zig/src/families/inkling2/cuda_vision_store.zig
new file mode 100644
index 0000000000000000000000000000000000000000..9650460e62e0c06d1a73c738658ba815c913521b
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_vision_store.zig
@@ -0,0 +1,1536 @@
+//! Rank 0's image rows for the vision tower in the engine: the host side of one device buffer of `rows` tower output
+//! rows (bf16 [rows][4608], 9,216 B a row), indexed by each image's full 256-bit content digest.
+//!
+//! `Store` places an image's rows as one extent: first fit, else the least recently used unpinned entries go, and when
+//! the free rows are enough but split, the entries move down (compaction) in gap-sized device copies through `Copy`,
+//! so this file needs no GPU and the host tests run it over fake memory. A request reserves its images' rows when it
+//! opens; while the reservations sum to at most `rows`, `alloc` cannot fail: every pinned entry is a reserved image.
+//! At most one entry is building (the tower holds one image's state); it has no rows until the tower finishes it, and
+//! it is aborted when its last pin drops. A compaction copy that fails breaks the store (`broken`), at its enqueue or
+//! at the compaction's wait for its copies: an entry it was moving may hold other rows, so from then on no image is
+//! served, stored or begun (`StoreBroken`) and only pins and reservations drop; the engine needs a restart for images
+//! again.
+//!
+//! `Need` is a prompt pass's view of its images: which ones it still needs (`init` skips those that end at or before
+//! the resume point), what the next tower unit is (`plan`), the chunk's spans of stored rows (`spans`), and the pins it
+//! drops as the chunk cursor passes them (`passed`, `release`). `prefixKey` names the images in a kept prompt prefix.
+const std = @import("std");
+
+const Sha256 = std.crypto.hash.sha2.Sha256;
+
+/// The bytes of one tower output row: 4,608 bf16.
+pub const row_bytes = 4608 * 2;
+/// Images a request may hold (a chunk's spans are at most this many).
+pub const max_images = 16;
+
+pub const Digest = [32]u8;
+
+/// One image of a prompt: rows [at, at + tokens) of the prompt are its `rows` x `cols` tower rows, and `digest` names
+/// its pixels (SHA-256 of the decoded image; never all zeros).
+pub const Image = struct { at: u32, tokens: u32, rows: u32, cols: u32, digest: Digest };
+
+/// A device copy of `bytes` from `src` to `dst`, ordered on the tower's stream (`run`; it may return before the copy
+/// ends), and the wait for every copy run so far (`done`: a copy's device fault surfaces here). The two ranges never
+/// overlap.
+pub const Copy = struct {
+    ctx: *anyopaque,
+    run: *const fn (ctx: *anyopaque, dst: u64, src: u64, bytes: usize) anyerror!void,
+    done: *const fn (ctx: *anyopaque) anyerror!void,
+};
+
+pub const Entry = struct {
+    digest: Digest,
+    row0: u32,
+    tokens: u32,
+    pins: u32 = 0,
+    ready: bool = false, // false: the tower is building it, and its rows hold nothing yet
+    used: u64 = 0, // the store's clock at the last pin or finish
+};
+
+/// Prompt rows [first, first + n) of a chunk take the stored rows at `src`.
+pub const Span = struct { first: u32, n: u32, src: u64 };
+
+pub const Store = struct {
+    gpa: std.mem.Allocator,
+    buf: u64,
+    rows: u32,
+    row_bytes: usize,
+    copy: Copy,
+    entries: std.ArrayList(Entry) = .empty, // by row0; extents never overlap; capacity `rows` from `init`
+    committed: u32 = 0, // rows reserved by open requests
+    clock: u64 = 0,
+    evicted: u64 = 0,
+    moved: u64 = 0, // rows compaction copied
+    /// a compaction copy failed part way: no entry's rows are trusted (`check`)
+    broken: bool = false,
+
+    /// The index's room for its most entries (one a row) is taken here, at start-up: nothing later allocates.
+    pub fn init(gpa: std.mem.Allocator, buf: u64, rows: u32, bytes_per_row: usize, copy: Copy) !Store {
+        var s: Store = .{ .gpa = gpa, .buf = buf, .rows = rows, .row_bytes = bytes_per_row, .copy = copy };
+        try s.entries.ensureTotalCapacityPrecise(gpa, rows);
+        return s;
+    }
+
+    pub fn deinit(s: *Store) void {
+        s.entries.deinit(s.gpa);
+    }
+
+    /// A request's rows, at its opening: `LaneMemory` (the request waits) when the open requests already hold the rest.
+    pub fn reserve(s: *Store, n: u32) error{LaneMemory}!void {
+        if (n > s.rows - s.committed) return error.LaneMemory;
+        s.committed += n;
+    }
+
+    pub fn unreserve(s: *Store, n: u32) void {
+        std.debug.assert(n <= s.committed);
+        s.committed -= n;
+    }
+
+    /// StoreBroken once a compaction copy failed: every lookup, splice and new entry is refused from then on.
+    pub fn check(s: *const Store) error{StoreBroken}!void {
+        if (s.broken) return error.StoreBroken;
+    }
+
+    fn index(s: *const Store, d: *const Digest) ?usize {
+        for (s.entries.items, 0..) |*e, i| if (std.mem.eql(u8, &e.digest, d)) return i;
+        return null;
+    }
+
+    /// The entry with all 256 bits of `d`; the pointer lasts until the next alloc, abort or unpin.
+    pub fn find(s: *const Store, d: *const Digest) ?*Entry {
+        const i = s.index(d) orelse return null;
+        return &s.entries.items[i];
+    }
+
+    /// The building entry (the tower's job), if any.
+    pub fn job(s: *const Store) ?*Entry {
+        for (s.entries.items) |*e| if (!e.ready) return e;
+        return null;
+    }
+
+    /// The device address of row `row` of the buffer.
+    pub fn addr(s: *const Store, row: u64) u64 {
+        return s.buf + row * s.row_bytes;
+    }
+
+    pub fn pin(s: *Store, d: *const Digest) void {
+        const e = s.find(d).?;
+        e.pins += 1;
+        s.clock += 1;
+        e.used = s.clock;
+    }
+
+    /// Drops one pin; true when that aborted a building entry (its tower job must be dropped too).
+    pub fn unpin(s: *Store, d: *const Digest) bool {
+        const i = s.index(d).?;
+        const e = &s.entries.items[i];
+        std.debug.assert(e.pins > 0);
+        e.pins -= 1;
+        if (e.pins > 0 or e.ready) return false;
+        _ = s.entries.orderedRemove(i);
+        return true;
+    }
+
+    /// The tower wrote the building entry's rows.
+    pub fn finish(s: *Store, d: *const Digest) void {
+        const e = s.find(d).?;
+        std.debug.assert(!e.ready);
+        e.ready = true;
+        s.clock += 1;
+        e.used = s.clock;
+    }
+
+    /// Drops a building entry whatever its pins (the tower failed); its extent is free again.
+    pub fn abort(s: *Store, d: *const Digest) void {
+        const i = s.index(d).?;
+        std.debug.assert(!s.entries.items[i].ready);
+        _ = s.entries.orderedRemove(i);
+    }
+
+    /// Rows no entry holds.
+    pub fn free(s: *const Store) u32 {
+        var used: u32 = 0;
+        for (s.entries.items) |e| used += e.tokens;
+        return s.rows - used;
+    }
+
+    const Fit = struct { pos: usize, row0: u32 };
+
+    fn firstFit(s: *const Store, tokens: u32) ?Fit {
+        var next: u32 = 0;
+        for (s.entries.items, 0..) |e, i| {
+            if (e.row0 - next >= tokens) return .{ .pos = i, .row0 = next };
+            next = e.row0 + e.tokens;
+        }
+        if (s.rows - next >= tokens) return .{ .pos = s.entries.items.len, .row0 = next };
+        return null;
+    }
+
+    fn lru(s: *const Store) ?usize {
+        var best: ?usize = null;
+        for (s.entries.items, 0..) |e, i| {
+            if (e.pins != 0 or !e.ready) continue;
+            if (best == null or e.used < s.entries.items[best.?].used) best = i;
+        }
+        return best;
+    }
+
+    /// Moves `n` rows from `src` down to `dst` in pieces of at most the gap, so no copy overlaps itself.
+    fn move(s: *Store, dst: u32, src: u32, n: u32) !void {
+        const gap = src - dst;
+        var off: u32 = 0;
+        while (off < n) {
+            const k = @min(gap, n - off);
+            try s.copy.run(s.copy.ctx, s.addr(dst + off), s.addr(src + off), @as(usize, k) * s.row_bytes);
+            off += k;
+        }
+        s.moved += n;
+    }
+
+    /// Every entry down to the lowest rows, in order, the moves waited for (`Copy.done`, once) before it returns. A
+    /// copy error breaks the store, whether its enqueue or its completion reports it: the entry being moved may already
+    /// have rows of its own written over at its old address (pieces of the gap), and it is still ready there.
+    fn compact(s: *Store) !void {
+        errdefer {
+            s.broken = true;
+            std.log.warn("inkling2 rank 0: vision: an image row store compaction copy failed: no image is served until the engine restarts", .{});
+        }
+        var next: u32 = 0;
+        var moved = false;
+        for (s.entries.items) |*e| {
+            std.debug.assert(e.row0 >= next);
+            if (e.row0 != next) {
+                if (e.ready) {
+                    try s.move(next, e.row0, e.tokens);
+                    moved = true;
+                }
+                e.row0 = next;
+            }
+            next += e.tokens;
+        }
+        // the copies are asynchronous: a device fault surfaces at their completion, here, under the errdefer
+        if (moved) try s.copy.done(s.copy.ctx);
+    }
+
+    /// A building entry of `tokens` rows for `d`, pinned once; returns its first row. First fit; else unpinned
+    /// entries go, least recently used first, until one fits or the free rows suffice; then compaction. No host
+    /// allocation: entries hold a row or more each, so with `tokens` rows free there are fewer than `rows` of them.
+    pub fn alloc(s: *Store, d: *const Digest, tokens: u32) !u32 {
+        try s.check();
+        if (tokens == 0 or tokens > s.rows) return error.ImageRows;
+        if (s.index(d) != null) return error.ImageStored;
+        if (s.job() != null) return error.TowerBusy;
+        const fit = fit: while (true) {
+            if (s.firstFit(tokens)) |f| break :fit f;
+            if (s.free() >= tokens) {
+                try s.compact();
+                break :fit s.firstFit(tokens).?;
+            }
+            const i = s.lru() orelse return error.StoreFull; // pinned rows beyond the reservations
+            _ = s.entries.orderedRemove(i);
+            s.evicted += 1;
+        };
+        s.clock += 1;
+        std.debug.assert(s.entries.items.len < s.entries.capacity);
+        s.entries.insertAssumeCapacity(fit.pos, .{ .digest = d.*, .row0 = fit.row0, .tokens = tokens, .pins = 1, .used = s.clock });
+        return fit.row0;
+    }
+};
+
+/// What a prompt pass does before a chunk: `ready` (every image in it is stored), `work` (run the tower job's next
+/// slice: this pass's image or another pass's, whose rows it may need first), or `begin` (images[i] has a new building
+/// entry, pinned: start the tower on it).
+pub const Step = union(enum) { ready, work, begin: u32 };
+
+/// A prompt pass's images still to splice, and its pins and reservation in the store. The image slice is passed to
+/// each call (it is the request's), in prompt order.
+pub const Need = struct {
+    count: u32,
+    first: u32, // images before it end at or before the cursor: no tower, no splice
+    pinned: std.bit_set.IntegerBitSet(max_images) = .empty,
+    reserved: u32 = 0,
+
+    /// Skips the images that end at or before `from` (a kept prefix holds their rows). Refuses images out of prompt
+    /// order or overlapping, a grid that is not `tokens`, an all-zero digest, and more than `max_images`.
+    pub fn init(images: []const Image, from: u32) !Need {
+        if (images.len > max_images) return error.TooManyImages;
+        var end: u64 = 0;
+        for (images) |m| {
+            if (m.tokens == 0 or @as(u64, m.rows) * m.cols != m.tokens) return error.ImageGrid;
+            if (std.mem.allEqual(u8, &m.digest, 0)) return error.ImageDigestDiffers;
+            if (m.at < end) return error.ImageOrder;
+            end = @as(u64, m.at) + m.tokens;
+        }
+        var first: u32 = 0;
+        while (first < images.len and @as(u64, images[first].at) + images[first].tokens <= from) first += 1;
+        return .{ .count = @intCast(images.len), .first = first };
+    }
+
+    /// Rows of the images still needed: what the pass reserves.
+    pub fn tokens(n: *const Need, images: []const Image) u32 {
+        var t: u32 = 0;
+        for (images[n.first..]) |m| t += m.tokens;
+        return t;
+    }
+
+    pub fn reserve(n: *Need, s: *Store, images: []const Image) error{LaneMemory}!void {
+        std.debug.assert(images.len == n.count and n.reserved == 0);
+        const t = n.tokens(images);
+        try s.reserve(t);
+        n.reserved = t;
+    }
+
+    /// The next tower unit for chunk [at, at + len): pins each stored image it meets, a hit costs no tower.
+    pub fn plan(n: *Need, s: *Store, images: []const Image, at: u32, len: u32) !Step {
+        std.debug.assert(images.len == n.count);
+        try s.check(); // before any pin: a broken store's entries are no hits
+        const end = @as(u64, at) + len;
+        for (images[n.first..], n.first..) |*m, i| {
+            if (m.at >= end) break;
+            if (@as(u64, m.at) + m.tokens <= at) continue;
+            if (s.find(&m.digest)) |e| {
+                const ready = e.ready;
+                if (!n.pinned.isSet(i)) {
+                    s.pin(&m.digest);
+                    n.pinned.set(i);
+                }
+                if (ready) continue;
+                return .work; // the job is this image (another pass's or ours)
+            }
+            if (s.job() != null) return .work; // another image holds the tower: help it finish
+            _ = try s.alloc(&m.digest, m.tokens);
+            n.pinned.set(i);
+            return .{ .begin = @intCast(i) };
+        }
+        return .ready;
+    }
+
+    /// Whether every image chunk [at, at + len) meets is stored and ready, so `plan` would return `ready` with no
+    /// tower unit. Pins nothing, allocates nothing.
+    pub fn stored(n: *const Need, s: *const Store, images: []const Image, at: u32, len: u32) bool {
+        std.debug.assert(images.len == n.count);
+        const end = @as(u64, at) + len;
+        for (images[n.first..]) |*m| {
+            if (m.at >= end) break;
+            if (@as(u64, m.at) + m.tokens <= at) continue;
+            const e = s.find(&m.digest) orelse return false;
+            if (!e.ready) return false;
+        }
+        return true;
+    }
+
+    /// The stored rows chunk [at, at + len) splices, in prompt order, into `out`; returns the count. Every image the
+    /// chunk meets must be pinned by this pass and ready (`plan` returned `ready`).
+    pub fn spans(n: *const Need, s: *const Store, images: []const Image, at: u32, len: u32, out: []Span) !usize {
+        std.debug.assert(images.len == n.count);
+        try s.check(); // a pass pinned before the store broke splices nothing either
+        const end = @as(u64, at) + len;
+        var k: usize = 0;
+        for (images[n.first..], n.first..) |*m, i| {
+            if (m.at >= end) break;
+            const m_end = @as(u64, m.at) + m.tokens;
+            if (m_end <= at) continue;
+            if (!n.pinned.isSet(i)) return error.ImageNotReady;
+            const e = s.find(&m.digest) orelse return error.ImageNotReady;
+            if (!e.ready) return error.ImageNotReady;
+            if (k == out.len) return error.TooManySpans;
+            const lo: u32 = @max(at, m.at);
+            const hi: u32 = @intCast(@min(end, m_end));
+            out[k] = .{ .first = lo - at, .n = hi - lo, .src = s.addr(@as(u64, e.row0) + (lo - m.at)) };
+            k += 1;
+        }
+        return k;
+    }
+
+    /// Whether the pass pins the image named `d` (its own, or the same pixels another pass began).
+    pub fn holds(n: *const Need, images: []const Image, d: *const Digest) bool {
+        var it = n.pinned.iterator(.{});
+        while (it.next()) |i| if (std.mem.eql(u8, &images[i].digest, d)) return true;
+        return false;
+    }
+
+    fn drop(n: *Need, s: *Store, images: []const Image, i: usize) bool {
+        if (!n.pinned.isSet(i)) return false;
+        n.pinned.unset(i);
+        return s.unpin(&images[i].digest);
+    }
+
+    /// The cursor reached `at`: the images that end at or before it are unpinned and no longer needed. True when that
+    /// aborted the tower job.
+    pub fn passed(n: *Need, s: *Store, images: []const Image, at: u32) bool {
+        std.debug.assert(images.len == n.count);
+        var aborted = false;
+        while (n.first < n.count and @as(u64, images[n.first].at) + images[n.first].tokens <= at) : (n.first += 1) {
+            if (n.drop(s, images, n.first)) aborted = true;
+        }
+        return aborted;
+    }
+
+    /// The pass ended or was dropped: every pin and the reservation go. True when that aborted the tower job.
+    pub fn release(n: *Need, s: *Store, images: []const Image) bool {
+        std.debug.assert(images.len == n.count);
+        var aborted = false;
+        for (0..n.count) |i| {
+            if (n.drop(s, images, i)) aborted = true;
+        }
+        s.unreserve(n.reserved);
+        n.reserved = 0;
+        n.first = n.count;
+        return aborted;
+    }
+};
+
+/// SHA-256 over (at, tokens, rows, cols as u32 little-endian, then the digest) of each image with `img.at < at`, in
+/// order: the images a kept prefix of `at` rows holds. All zeros, with no hashing, when there is none.
+pub fn prefixKey(images: []const Image, at: u32) Digest {
+    var h: ?Sha256 = null;
+    for (images) |m| {
+        if (m.at >= at) continue;
+        if (h == null) h = Sha256.init(.{});
+        var b: [16]u8 = undefined;
+        std.mem.writeInt(u32, b[0..4], m.at, .little);
+        std.mem.writeInt(u32, b[4..8], m.tokens, .little);
+        std.mem.writeInt(u32, b[8..12], m.rows, .little);
+        std.mem.writeInt(u32, b[12..16], m.cols, .little);
+        h.?.update(&b);
+        h.?.update(&m.digest);
+    }
+    var out: Digest = @splat(0);
+    if (h) |*x| x.final(&out);
+    return out;
+}
+
+/// Tower layers in one unit: all `left` when chunks are unbounded (`max_rows` 0); 1 while a layer's time is unknown;
+/// else what a chunk of `max_rows` rows costs (`ns_per_row` each) over a layer's `layer_ns`, clamped to [1, left].
+pub fn sliceLayers(max_rows: u32, ns_per_row: u64, layer_ns: u64, left: u32) u32 {
+    if (left == 0) return 0;
+    if (max_rows == 0) return left;
+    if (layer_ns == 0 or ns_per_row == 0) return 1;
+    const budget = @as(u128, max_rows) * ns_per_row;
+    return @intCast(std.math.clamp(budget / layer_ns, 1, left));
+}
+
+/// The tower's layers (cuda_vision.zig layers).
+pub const tower_layers: u32 = 23;
+
+/// The tower's pace beside decoders (a prompt chunk capped at `max_rows` rows: --decode-share): the job in flight
+/// (its image's digest, the layers it has left and the units it took), what one of its layers takes (timed on the
+/// host in its first unit), what a settled prompt chunk's row costs (an EMA), and the help other passes gave.
+pub const Pace = struct {
+    /// the building entry the tower holds the state of; null: none, or its state is lost (a unit failed)
+    job: ?Digest = null,
+    left: u32 = 0,
+    units: u32 = 0,
+    layer_ns: u64 = 0,
+    /// a settled prompt chunk's ns over its rows (cuda_lanes.zig chunk), 1/4 the newest
+    chunk_ns_per_row: u64 = 0,
+    /// since start: units a pass ran of another image's job, and those in a step nothing billed to decoders (no chunk
+    /// row cap and a step the lane host did not time: a capped unit is side work the lane host bills, Stream.side_ns)
+    help_units: u64 = 0,
+    unbilled_help: u64 = 0,
+
+    /// A settled prompt chunk of `rows` rows took `ns`.
+    pub fn chunked(p: *Pace, ns: u64, rows: u64) void {
+        if (rows == 0) return;
+        const v = @max(1, ns / rows);
+        p.chunk_ns_per_row = if (p.chunk_ns_per_row == 0) v else (3 * p.chunk_ns_per_row + v) / 4;
+    }
+
+    pub fn holds(p: *const Pace, d: *const Digest) bool {
+        return if (p.job) |*j| std.mem.eql(u8, j, d) else false;
+    }
+
+    fn start(p: *Pace, d: *const Digest) void {
+        p.job = d.*;
+        p.left = tower_layers;
+        p.units = 1;
+        p.layer_ns = 0;
+    }
+
+    /// `k` layers of the job (none only when none is left), then the merger into its rows when none is left: the store
+    /// holds the image. A failure leaves the tower's state unknown: the job is no longer held (the caller drops it).
+    fn run(p: *Pace, s: *Store, t: Units, k: u32) !void {
+        errdefer p.job = null;
+        std.debug.assert(k <= p.left and (k > 0 or p.left == 0));
+        if (k > 0) try t.layers(t.ctx, k);
+        p.left -= k;
+        if (p.left > 0) return;
+        const d = s.job().?.digest;
+        try t.merge(t.ctx, s.find(&d).?.row0);
+        s.finish(&d);
+        p.job = null;
+    }
+};
+
+/// The tower's work on the device, a unit at a time (cuda_lanes.zig: Rank0's engine-mode units on the engine's stream,
+/// each borrowing the op scratch; the host tests' fakes).
+pub const Units = struct {
+    ctx: *anyopaque,
+    /// the pass's image `i` (the building entry just allocated): its grid, then E1 .. E5 into the tower's rows
+    begin: *const fn (ctx: *anyopaque, i: u32) anyerror!void,
+    /// the job's next `k` layers (k >= 1)
+    layers: *const fn (ctx: *anyopaque, k: u32) anyerror!void,
+    /// the merger into the store's rows from `row0`
+    merge: *const fn (ctx: *anyopaque, row0: u32) anyerror!void,
+    /// waits for the device
+    settle: *const fn (ctx: *anyopaque) anyerror!void,
+    /// the host's clock, ns
+    now: *const fn (ctx: *anyopaque) u64,
+};
+
+/// A pass's units of other images' jobs (help), and those in steps nothing billed to decoders (`unit`'s `settled`).
+pub const Help = struct { units: u32 = 0, layers: u32 = 0, unbilled: u32 = 0 };
+
+pub const Unit = enum { ready, worked };
+
+/// Before a pass's chunk [at, at + len): `ready` when every image of the chunk is stored (the chunk's forward goes
+/// out), else `worked` after one tower unit (the chunk waits for a later call). Every `worked` ran a layer or more,
+/// or the merger, so a caller that calls again until `ready` makes progress each call.
+/// - `max_rows` 0 (chunks without a cap): each job whole (begin, every layer, the merger), then the chunk: never
+///   `worked`.
+/// - else a new job's first unit is its begin and one layer, timed on the host between two settles (`layer_ns`);
+///   a later unit runs `sliceLayers(max_rows, chunk_ns_per_row, layer_ns, left)` layers, and the merger with the last.
+/// - another image's job in flight (`plan`'s `work` for an image not this pass's): its next unit runs here (help),
+///   counted in `help` and the pace; `settled`: this step's time is billed to decoders (the lane host times it, or
+///   bills a capped unit as side work).
+pub fn unit(n: *Need, s: *Store, pace: *Pace, images: []const Image, at: u32, len: u32, max_rows: u32, settled: bool, t: Units, help: *Help) !Unit {
+    while (true) switch (try n.plan(s, images, at, len)) {
+        .ready => return .ready,
+        .begin => |i| {
+            const d = &images[i].digest;
+            pace.start(d);
+            errdefer pace.job = null;
+            t.begin(t.ctx, i) catch |err| {
+                s.abort(d);
+                n.pinned.unset(i);
+                return err;
+            };
+            if (max_rows == 0) {
+                try pace.run(s, t, pace.left);
+                continue;
+            }
+            try t.settle(t.ctx); // the begin's work done: the layer alone is timed
+            const t0 = t.now(t.ctx);
+            try pace.run(s, t, 1);
+            try t.settle(t.ctx);
+            pace.layer_ns = @max(1, t.now(t.ctx) -| t0);
+            return .worked;
+        },
+        .work => {
+            const j = s.job().?.digest; // plan works only for the building entry
+            if (!pace.holds(&j)) return error.TowerJobLost;
+            const k = sliceLayers(max_rows, pace.chunk_ns_per_row, pace.layer_ns, pace.left);
+            if (!n.holds(images, &j)) {
+                help.units += 1;
+                help.layers += k;
+                pace.help_units += 1;
+                if (!settled) {
+                    help.unbilled += 1;
+                    pace.unbilled_help += 1;
+                }
+            }
+            pace.units += 1;
+            try pace.run(s, t, k);
+            if (max_rows == 0) continue;
+            return .worked;
+        },
+    };
+}
+
+// ---------------------------------------------------------------------------------------------------------------------
+// Host tests over fake device memory.
+
+const testing = std.testing;
+
+const Fake = struct {
+    mem: []u8,
+    base: u64,
+    copies: u32 = 0,
+    /// the copy after this many fails (a device fault in the middle of a compaction)
+    fail_at: ?u32 = null,
+    /// every copy is taken and lost on the device, and the wait for them fails (a fault that surfaces at completion)
+    fail_done: bool = false,
+    dones: u32 = 0,
+
+    fn run(ctx: *anyopaque, dst: u64, src: u64, bytes: usize) anyerror!void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        if (f.fail_at) |n| if (f.copies == n) return error.FakeFault;
+        if (f.fail_done) {
+            f.copies += 1;
+            return;
+        }
+        if (dst < f.base or src < f.base) return error.OutOfRange;
+        const d: usize = @intCast(dst - f.base);
+        const s: usize = @intCast(src - f.base);
+        if (d + bytes > f.mem.len or s + bytes > f.mem.len) return error.OutOfRange;
+        if (d < s + bytes and s < d + bytes) return error.Overlap;
+        @memcpy(f.mem[d..][0..bytes], f.mem[s..][0..bytes]);
+        f.copies += 1;
+    }
+
+    fn done(ctx: *anyopaque) anyerror!void {
+        const f: *Fake = @ptrCast(@alignCast(ctx));
+        f.dones += 1;
+        if (f.fail_done) return error.FakeFault;
+    }
+
+    fn copy(f: *Fake) Copy {
+        return .{ .ctx = f, .run = run, .done = done };
+    }
+
+    fn at(f: *const Fake, a: u64) []const u8 {
+        return f.mem[@intCast(a - f.base)..];
+    }
+};
+
+/// The bytes a tower writes for row `r` of the image named `d`.
+fn pattern(d: *const Digest, r: u64, b: u64) u8 {
+    return d[@intCast((r * 7 + b) % 32)] ^ @as(u8, @truncate(r * 31 + b * 3 + 1));
+}
+
+fn write(f: *Fake, s: *const Store, d: *const Digest) void {
+    const e = s.find(d).?;
+    var r: u64 = 0;
+    while (r < e.tokens) : (r += 1) {
+        const a: usize = @intCast(s.addr(e.row0 + r) - f.base);
+        for (0..s.row_bytes) |b| f.mem[a + b] = pattern(d, r, @intCast(b));
+    }
+}
+
+/// Whether the rows from device row `row0` hold image `d`'s rows [r0, r0 + n).
+fn holds(f: *const Fake, s: *const Store, d: *const Digest, row0: u64, r0: u64, n: u64) bool {
+    var r = r0;
+    while (r < r0 + n) : (r += 1) {
+        const m = f.at(s.addr(row0 + (r - r0)));
+        for (0..s.row_bytes) |b| if (m[b] != pattern(d, r, @intCast(b))) return false;
+    }
+    return true;
+}
+
+fn digestOf(k: u32) Digest {
+    var d: Digest = undefined;
+    Sha256.hash(std.mem.asBytes(&k), &d, .{});
+    return d;
+}
+
+fn mk(at: u32, rows: u32, cols: u32, k: u32) Image {
+    return .{ .at = at, .tokens = rows * cols, .rows = rows, .cols = cols, .digest = digestOf(k) };
+}
+
+fn checkStore(f: *const Fake, s: *const Store) !void {
+    var next: u32 = 0;
+    var building: u32 = 0;
+    for (s.entries.items) |*e| {
+        try testing.expect(e.row0 >= next);
+        try testing.expect(e.tokens > 0);
+        next = e.row0 + e.tokens;
+        if (!e.ready) {
+            building += 1;
+            try testing.expect(e.pins > 0);
