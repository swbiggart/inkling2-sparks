+            const kvc = l.kv.heads * weights.head_dim * 2;
+            for ([4]u64{ l.conv_k, l.conv_v, l.conv_attn, l.conv_mlp }, [4]usize{ kvc, kvc, H * 2, H * 2 }) |p, w| {
+                const n = conv_rows * w;
+                if (out) try c.copy(at, p, n) else try c.copy(p, at, n);
+                at += n;
+            }
+        }
+        try e.stream.synchronize();
+    }
+
+    /// Where slot `slot`'s sequence stands (positions held).
+    pub fn pos(e: *Engine, slot: u32) usize {
+        if (slot >= e.slots.items.len) return 0;
+        return if (e.slots.items[slot]) |s| s.pos else 0;
+    }
+
+    fn ctx(e: *Engine) ops.Ctx {
+        return .{ .d = e.d, .stream = e.stream, .k = &e.k, .gemms = &e.gemms, .scratch = &e.scratch };
+    }
+
+    /// The op context on the engine's stream (op checks between steps).
+    pub fn opCtx(e: *Engine) ops.Ctx {
+        return e.ctx();
+    }
+
+    /// R rows of slot `slot` at positions pos0 .. pos0 + R - 1 through every layer, on every rank (each rank calls it
+    /// with the same slot, pos0 and R; rank 0 with the token ids). pos0 = 0 starts the slot's sequence over.
+    pub fn forward(e: *Engine, slot: u32, pos0: usize, R: usize, ids: ?[]const u32) !void {
+        const st = try e.ready(slot, pos0, R);
+        e.scratch.kind = scratch.kindOf(&.{.{ .pos0 = pos0, .rows = R }});
+        var f: fwd.Forward = .{ .c = e.ctx(), .w = &e.w, .st = st, .a = &e.act, .x = if (e.parts != null) &e.x else null, .spec = e.drafter != null and R <= state.spec_rows, .prof = if (e.prof_on) e.prof else null };
+        f.capture = @import("cuda_snap.zig").forwardHook(e, slot, pos0, R); // the prompt cache's marks inside a chunk
+        if (pos0 == 0) try st.restart(&f.c);
+        try e.tokens(ids, R);
+        try e.body(&f, R, pos0);
+        if (f.prof) |p| try p.end();
+        const one = [1]fwd.Seg{.{ .st = st, .pos0 = pos0, .rows = R }};
+        const sg = [1]Segment{.{ .slot = slot, .pos0 = pos0, .rows = R }};
+        try e.drafterRows(&f, R, &one, &sg);
+        e.noteOneRow(&one);
+        e.counts.eager += 1;
+        e.forwards += 1;
+        st.last_fwd = e.forwards;
+        st.pos = pos0 + R;
+        st.last_pos0 = pos0;
+        st.last_rows = R;
+        st.last_row0 = 0;
+        st.kept_inputs = f.spec;
+        e.rows = R;
+        e.head_n = 0;
+    }
+
+    /// What `forwardMany` checks before its first collective (as `ready`, for every segment): the segments' forward
+    /// (each its stream's state, its first row and whether it keeps its convolution inputs) into `out`; the rows.
+    pub fn readyMany(e: *Engine, segs: []const Segment, out: *[fwd.max_segs]fwd.Seg) !usize {
+        if (segs.len == 0 or segs.len > fwd.max_segs) return error.BadSegments;
+        var R: usize = 0;
+        for (segs, 0..) |g, i| {
+            for (segs[0..i]) |o| if (o.slot == g.slot) return error.SlotTwiceInAForward;
+            const st = try e.ready(g.slot, g.pos0, g.rows);
+            out[i] = .{ .st = st, .pos0 = g.pos0, .row0 = R, .rows = g.rows, .spec = e.drafter != null and g.rows <= state.spec_rows };
+            R += g.rows;
+        }
+        if (R > prompt_rows) return error.BadRows;
+        return R;
+    }
+
+    /// Several streams' rows in one forward, on every rank (batched decode): segment i is segs[i].rows rows of slot
+    /// segs[i].slot from position segs[i].pos0, after the rows of the segments before it (rank 0's `ids` in that
+    /// order). Every op that does not touch a stream's state runs once over all the rows; the 13 that do run once a
+    /// segment on its rows (cuda_forward.zig Seg), so each stream's rows get the bits of a forward of their own.
+    /// One segment is `forward`.
+    pub fn forwardMany(e: *Engine, segs: []const Segment, ids: ?[]const u32) !void {
+        if (segs.len == 1) return e.forward(segs[0].slot, segs[0].pos0, segs[0].rows, ids);
+        var fs: [fwd.max_segs]fwd.Seg = undefined;
+        const R = try e.readyMany(segs, &fs);
+        const gs = fs[0..segs.len];
+        e.scratch.kind = .batched;
+        var f: fwd.Forward = .{ .c = e.ctx(), .w = &e.w, .st = gs[0].st, .a = &e.act, .x = if (e.parts != null) &e.x else null, .segs = gs, .prof = if (e.prof_on) e.prof else null };
+        for (gs) |g| if (g.pos0 == 0) try g.st.restart(&f.c);
+        try e.tokens(ids, R);
+        try e.body(&f, R, segs[0].pos0);
+        if (f.prof) |p| try p.end();
+        try e.drafterRows(&f, R, gs, segs);
+        e.noteOneRow(gs);
+        e.counts.eager += 1;
+        e.forwards += 1;
+        for (gs) |g| {
+            g.st.last_fwd = e.forwards;
+            g.st.pos = g.pos0 + g.rows;
+            g.st.last_pos0 = g.pos0;
+            g.st.last_rows = g.rows;
+            g.st.last_row0 = g.row0;
+            g.st.kept_inputs = g.spec;
+        }
+        e.rows = R;
+        e.head_n = 0;
+    }
+
+    /// With the drafter: tap 7 (the final normed rows) over the forward's R rows, then each segment's draft context
+    /// at its positions (rows a verify rejects are rewritten by the next one before a draft can read them). A
+    /// captured forward's segments carry `dev`: the context lands at the positions its header holds at replay.
+    fn drafterRows(e: *Engine, f: *const fwd.Forward, R: usize, gs: []const fwd.Seg, segs: []const Segment) !void {
+        const dr = e.drafter orelse return;
+        const c = f.c;
+        const a = &e.act;
+        e.scratch.reset();
+        const x = a.x[0].slice(0, R);
+        try res.mix(&c, a.blockView(R), a.h[0].slice(0, R), e.w.output_query, 1, &.{x});
+        try head.finalNorm(&c, &e.w, x, Mat.of(dr.tap(dspark.ntaps - 1), R, H, .bf16));
+        for (gs, segs) |g, sg| try dr.absorb(&c, sg.slot, g.pos0, g.rows, g.row0, if (g.dev) |d| d.posp else 0);
+    }
+
+    /// Rank 0: the forward's token ids to the device, queued on the stream after its earlier work (a pinned copy
+    /// the stream uploads in order: no wait for the device here; TF_INK2_SYNC_UPLOADS=1 waits and copies as before).
+    /// Ranks above 0 with the shared embedding: the header's ids when it carries them (`ids_in_header`; the drafted
+    /// rows from the drafter's walk, as rank 0 does), else rank 0's ids come by a broadcast in `body`.
+    fn tokens(e: *Engine, ids: ?[]const u32, R: usize) !void {
+        if (e.o.rank != 0) {
+            if (e.shared != null and e.ids_in_header) {
+                if (R > graph_rows) return error.BadRows;
+                const c = e.ctx();
+                try c.copy(e.act.tokens.ptr, e.hdr.ptr + Header.tokens_at, R * 4);
+                try e.walkIds(e.act.tokens.ptr, R);
+            } else e.walk_n = 0;
+            return;
+        }
+        const t = ids orelse return error.NoIds;
+        if (t.len != R) return error.BadRows;
+        var host: [prompt_rows]i32 = undefined;
+        for (host[0..R], t) |*h, v| h.* = @intCast(v);
+        if (!syncUploads()) try cuda.copy_source.enqueue(e.d, e.act.tokens.ptr, std.mem.sliceAsBytes(host[0..R]), e.stream) else {
+            try e.stream.synchronize();
+            const view: cuda.DeviceBuffer = .{ .d = e.d, .ptr = e.act.tokens.ptr, .len = R * 4, .borrowed = true };
+            try view.upload(0, std.mem.sliceAsBytes(host[0..R]));
+        }
+        try e.walkIds(e.act.tokens.ptr, R);
+    }
+
+    /// Rank 0: the rows `walk_ids` names, from the drafter's walk into the forward's ids at `ids` (R of them), after
+    /// the host's ids (queued on the stream); then none are pending.
+    fn walkIds(e: *Engine, ids: u64, R: usize) !void {
+        if (e.walk_n == 0) return;
+        defer e.walk_n = 0;
+        const dr = e.drafter orelse return error.NoDrafter;
+        const c = e.ctx();
+        for (e.walk_ids[0..e.walk_n]) |w| {
+            if (w.row + 1 + w.n > R or w.n > dspark.drafts) return error.BadRows;
+            try c.copy(ids + (w.row + 1) * 4, dr.walk + (w.y * dspark.block + 1) * 4, w.n * 4);
+        }
+    }
+
+    /// Rank 0: the next forward's rows that `walkIds` fills from the last `draftMany` (Leader.forwardDrafted); every
+    /// rank with the shared embedding (`shared`: a captured forward's ids are each rank's header copy, cuda_follow.zig
+    /// followDrafts; the drafter's walk is on every rank).
+    pub fn setWalkIds(e: *Engine, ws: []const WalkIds) !void {
+        if (e.o.rank != 0 and e.shared == null) return;
+        if (ws.len > max_segs) return error.BadSegments;
+        @memcpy(e.walk_ids[0..ws.len], ws);
+        e.walk_n = ws.len;
+    }
+
+    /// Rank 0: the last `draftMany`'s drafts of its streams (synchronizes the stream).
+    pub fn proposals(e: *Engine, out: []const *[dspark.drafts]u32) !void {
+        const dr = e.drafter orelse return error.NoDrafter;
+        const c = e.ctx();
+        try dr.proposalsMany(&c, out);
+    }
+
+    /// A forward's launches, after its inputs are on the device: the embedding (W > 1: an eager forward's ids from the
+    /// header or broadcast from rank 0, then every rank's rows gathered; W = 1: rank 0's own), every layer. Nothing
+    /// here waits on the device, so a decode step's body can be captured (`step`).
+    fn body(e: *Engine, f: *fwd.Forward, R: usize, pos0: usize) !void {
+        const a = &e.act;
+        defer e.ids_in_header = false;
+        if (e.shared) |*sh| {
+            if (f.ids == 0 and !e.ids_in_header) {
+                if (e.o.group) |g| try g.lib.check(g.lib.api.ncclBroadcast(a.tokens.ptr, a.tokens.ptr, R * 4, .u8, 0, g.comm, e.stream.handle), "ncclBroadcast");
+            }
+            try f.embedShared(sh, R, pos0);
+        } else if (e.o.rank == 0) try f.embed(R, pos0);
+        a.nblocks = 0;
+        var li: u32 = 0;
+        while (li < e.layers) : (li += 1) {
+            f.layer(li, R, pos0) catch |err| {
+                if (f.stopped) |s| std.log.err("inkling2: layer {f} op {s}: {t}", .{ s.scope, s.op, s.err });
+                return err;
+            };
+            if (e.drafter) |dr| if (dspark.tapOf(li)) |t| try f.c.copy(dr.tap(t), a.h[0].ptr, R * H * 2);
+        }
+    }
+
+    /// What `graphStep` checks before any rank moves (rank 0 runs it before the header): `readyMany`, and every
+    /// segment past its prompt (pos0 > 0) with at most `graph_seg_rows` rows, at most `graph_rows` in all.
+    pub fn graphReady(e: *Engine, segs: []const Segment, out: *[fwd.max_segs]fwd.Seg) !usize {
+        const R = try e.readyMany(segs, out);
+        if (R > graph_rows) return error.BadRows;
+        for (segs) |g| if (g.pos0 == 0 or g.pos0 > std.math.maxInt(i32) or g.rows > graph_seg_rows) return error.OutOfStep;
+        return R;
+    }
+
+    /// Rank 0, the second-sighting rule for a forward of several segments: true when its key's graph is held or the
+    /// key ran eagerly once before (it is then captured); else the key is remembered and the forward runs eagerly. A
+    /// key seen once (a stream set that never repeats) costs no capture.
+    pub fn graphWanted(e: *Engine, key: Key) bool {
+        if (key.units() > e.graph_max) return false; // larger than the whole cache: eager
+        for (e.graphs.items) |g| if (g.key.eql(key)) return true;
+        for (e.seen[0..@min(e.seen_n, seen_max)]) |k| if (k.eql(key)) return true;
+        e.seen[e.seen_n % seen_max] = key;
+        e.seen_n += 1;
+        return false;
+    }
+
+    /// The graph key of a forward of `segs`: their slots and rows, and which one-row segments are on their run
+    /// (State.ringRun: such a segment's global layers take the ring kernels on the run, so it is a different graph).
+    pub fn keyOf(e: *const Engine, segs: []const Segment) !Key {
+        var k = try Key.of(segs);
+        for (segs, 0..) |g, i| {
+            if (g.rows != 1 or g.slot >= e.slots.items.len) continue;
+            const st = e.slots.items[g.slot] orelse continue;
+            if (st.ringRun() != null) k.ring |= @as(u32, 1) << @intCast(i);
+        }
+        return k;
+    }
+
+    /// Counts a forward's one-row segments on pages by the kernels their global layers take (Counts.one_ring /
+    /// one_paged) and each stream's change of mode (switches).
+    fn noteOneRow(e: *Engine, gs: []const fwd.Seg) void {
+        for (gs) |g| {
+            if (g.rows != 1 or !g.st.paged()) continue;
+            const ring = g.st.ringRun() != null;
+            if (ring) e.counts.one_ring += 1 else e.counts.one_paged += 1;
+            const now: @TypeOf(g.st.last_one) = if (ring) .ring else .paged;
+            if (g.st.last_one != .none and g.st.last_one != now) e.counts.switches += 1;
+            g.st.last_one = now;
+            g.st.ones += 1;
+        }
+    }
+
+    /// A captured forward's nodes that `log` recorded (launches on a segment's run), found among the graph's kernel
+    /// nodes by kernel and base argument; error.RunNodes unless every recorded launch is found once.
+    fn runNodes(e: *Engine, graph: cuda.graph.Graph, log: *const ops.RunLog, gs: []const fwd.Seg, count: usize) ![]Graph.RunNode {
+        if (log.items.items.len == 0) return &.{};
+        const out = try e.gpa.alloc(Graph.RunNode, log.items.items.len);
+        errdefer e.gpa.free(out);
+        for (out, log.items.items) |*o, x| {
+            o.* = .{ .node = null, .seg = 0, .at = x };
+            var seg: ?usize = null;
+            for (gs, 0..) |g, i| if (g.rows == 1 and g.st.ringRun() == x.run) {
+                seg = i;
+            };
+            o.seg = @intCast(seg orelse return error.RunNodes);
+        }
+        const all = try e.gpa.alloc(cuda.graph.Node, count);
+        defer e.gpa.free(all);
+        const nodes = try graph.nodes(all);
+        var found: usize = 0;
+        for (nodes) |node| {
+            var p: cuda.abi.KernelNodeParams = std.mem.zeroes(cuda.abi.KernelNodeParams);
+            if (e.d.api.cuGraphKernelNodeGetParams_v2(node, &p) != cuda.abi.success) continue; // not a kernel node
+            const params = p.params orelse continue;
+            for (out) |*o| {
+                if (o.node != null or o.at.f.handle != p.func) continue;
+                const i = o.at.at[0];
+                const got = @as(*align(1) const u64, @ptrCast(params[i] orelse continue)).*;
+                if (got != o.at.args.integer(i).?) continue;
+                o.node = node;
+                found += 1;
+                break;
+            }
+        }
+        if (found != out.len) {
+            std.log.err("inkling2 rank {d}: {d} of {d} launches on a stream's run found in the captured graph", .{ e.o.rank, found, out.len });
+            return error.RunNodes;
+        }
+        return out;
+    }
+
+    /// A forward of segments `segs` (each past its prompt, a decode row or a verify window) and then the head over
+    /// all its rows, on every rank, as one captured CUDA graph: captured the first time its key (`Key`: slots and
+    /// rows) is seen and replayed after, each segment's first position and the token ids read on the device from the
+    /// step header's copy (`post` and `receive` leave it there; at W = 1 there is no broadcast and this writes it),
+    /// so the replay moves nothing to the device besides the header and holds one launch instead of thousands. The
+    /// same kernels in the same order as `forwardMany` (or `forward`) then `headRows(0, R)`, the drafter's taps and
+    /// context writes included, so the same bits. Every rank runs it for the same forwards (the header's `graph`),
+    /// so every rank's cache holds the same graphs with the same collectives. Rank 0 gets the R rows' logits.
+    pub fn graphStep(e: *Engine, segs: []const Segment, ids: ?[]const u32) !void {
+        var fs: [fwd.max_segs]fwd.Seg = undefined;
+        const R = try e.graphReady(segs, &fs);
+        const gs = fs[0..segs.len];
+        e.scratch.kind = if (segs.len > 1) .batched else scratch.kindOf(&.{.{ .pos0 = segs[0].pos0, .rows = segs[0].rows }});
+        if (e.o.group == null) {
+            var h: Header = .{ .kind = 0 };
+            try h.setSegs(segs);
+            try h.setTokens(ids orelse return error.NoIds);
+            try e.stream.synchronize();
+            try e.hdr.upload(0, std.mem.asBytes(&h));
+        }
+        if (e.o.rank == 0 or e.shared != null) try e.walkIds(e.hdr.ptr + Header.tokens_at, R); // after the header's upload (post, receive, or above)
+        const g = try e.graphOf(try e.keyOf(segs), gs, segs, R);
+        const moved = try g.follow(gs);
+        if (moved > 0) {
+            e.counts.repointed += moved;
+            e.counts.repoint_replays += 1;
+        }
+        e.noteOneRow(gs);
+        const a = &e.act;
+        a.h = g.h_start;
+        try g.exec.launchOn(e.stream);
+        a.h = g.h_end;
+        a.nblocks = g.nblocks;
+        e.counts.graph += 1;
+        e.forwards += 1;
+        for (gs) |x| {
+            x.st.last_fwd = e.forwards;
+            x.st.pos = x.pos0 + x.rows;
+            x.st.last_pos0 = x.pos0;
+            x.st.last_rows = x.rows;
+            x.st.last_row0 = x.row0;
+            x.st.kept_inputs = x.spec;
+        }
+        e.rows = R;
+        e.head_n = 0;
+        try e.headDone(R);
+    }
+
+    /// One decode step of slot `slot` (one row at pos0 > 0, then its head) as a captured forward (`graphStep`).
+    pub fn step(e: *Engine, slot: u32, pos0: usize, token: ?u32) !void {
+        const t = [1]u32{token orelse 0};
+        return e.graphStep(&.{.{ .slot = slot, .pos0 = pos0, .rows = 1 }}, if (token != null) &t else null);
+    }
+
+    /// The graph for `key`, captured now if the cache has none (the least recently used one replaced when full).
+    /// Every rank calls it for the same keys in the same order, so every rank's cache stays the same.
+    fn graphOf(e: *Engine, key: Key, gs: []const fwd.Seg, segs: []const Segment, R: usize) !*Graph {
+        e.graph_tick += 1;
+        for (e.graphs.items) |*g| if (g.key.eql(key)) {
+            g.used = e.graph_tick;
+            return g;
+        };
+        if (key.units() > e.graph_max) return error.GraphOverCache; // Leader.graphOk sends no such key
+        while (e.graphs.items.len > 0 and e.graph_units + key.units() > e.graph_max) {
+            var lru: usize = 0;
+            for (e.graphs.items, 0..) |g, i| if (g.used < e.graphs.items[lru].used) {
+                lru = i;
+            };
+            var old = e.graphs.swapRemove(lru);
+            e.graph_units -= old.key.units();
+            old.deinit(e.gpa); // a replay in flight completes; the driver frees it after
+            e.counts.evicted += 1;
+        }
+        const a = &e.act;
+        var g: Graph = .{ .key = key, .exec = undefined, .h_start = a.h, .h_end = undefined, .nblocks = 0, .used = e.graph_tick };
+        var dsegs: [fwd.max_segs]fwd.Seg = undefined;
+        for (gs, dsegs[0..gs.len], 0..) |x, *y, i| {
+            y.* = x;
+            y.dev = .{ .posp = e.hdr.ptr + Header.segPosAt(i), .positions = x.st.context };
+        }
+        var f: fwd.Forward = .{ .c = e.ctx(), .w = &e.w, .st = gs[0].st, .a = a, .x = if (e.parts != null) &e.x else null, .segs = dsegs[0..gs.len], .ids = e.hdr.ptr + Header.tokens_at };
+        // the launches on a segment's run (key.ring), so a replay can follow the stream's run when it moves
+        var log: ops.RunLog = .{ .gpa = e.gpa };
+        defer log.deinit();
+        if (key.ring != 0) f.c.runs = &log;
+        const free0 = e.memFree();
+        const t0 = Timing.now();
+        try cuda.graph.beginCapture(e.stream, .relaxed);
+        const captured: anyerror!void = run: {
+            e.body(&f, R, gs[0].pos0) catch |err| break :run err;
+            e.drafterRows(&f, R, dsegs[0..gs.len], segs) catch |err| break :run err;
+            e.headBody(0, R) catch |err| break :run err;
+        };
+        var graph = cuda.graph.endCapture(e.stream) catch |err| {
+            a.h = g.h_start;
+            captured catch |first| return first;
+            return err;
+        };
+        var kept = false;
+        defer if (!kept) graph.deinit();
+        captured catch |err| {
+            a.h = g.h_start;
+            return err;
+        };
+        const nodes = try graph.nodeCount();
+        g.runs = try e.runNodes(graph, &log, gs, nodes);
+        errdefer e.gpa.free(g.runs);
+        g.exec = try graph.instantiate();
+        errdefer g.exec.deinit();
+        if (g.runs.len > 0) {
+            g.tmpl = graph;
+            kept = true;
+        }
+        errdefer if (kept) {
+            kept = false;
+            g.tmpl = null;
+        };
+        try g.exec.upload(e.stream);
+        g.h_end = a.h;
+        g.nblocks = a.nblocks;
+        a.h = g.h_start;
+        try e.graphs.append(e.gpa, g);
+        e.graph_units += key.units();
+        const ms = @as(f64, @floatFromInt(Timing.now() - t0)) * 1e-6;
+        const bytes: i64 = @as(i64, @intCast(free0)) - @as(i64, @intCast(e.memFree()));
+        e.counts.captured += 1;
+        e.counts.graph_bytes += bytes;
+        e.counts.capture_ms += ms;
+        std.log.info("inkling2 rank {d}: forward ({f}) captured as one CUDA graph ({d} nodes, {d} on a stream's run) in {d:.1} ms, {d:.1} MiB; {d} held ({d} of {d} units), {d:.1} MiB in all", .{ e.o.rank, key, nodes, g.runs.len, ms, @as(f64, @floatFromInt(bytes)) / (1 << 20), e.graphs.items.len, e.graph_units, e.graph_max, @as(f64, @floatFromInt(e.counts.graph_bytes)) / (1 << 20) });
+        return &e.graphs.items[e.graphs.items.len - 1];
+    }
+
+    /// Free device memory (cuMemGetInfo; on GB10 the system's), to measure a capture's cost.
+    fn memFree(e: *const Engine) usize {
+        var free: usize = 0;
+        var total: usize = 0;
+        e.d.check(e.d.api.cuMemGetInfo_v2(&free, &total), "cuMemGetInfo") catch return 0;
+        return free;
+    }
+
+    /// What `keep` checks before any rank moves: the slot's last forward was a verify window holding `n` rows.
+    pub fn keepReady(e: *Engine, slot: u32, n: usize) !*state.State {
+        if (slot >= e.slots.items.len) return error.UnknownSlot;
+        const st = e.slots.items[slot] orelse return error.UnknownSlot;
+        if (n == 0 or n > st.last_rows or st.pos != st.last_pos0 + st.last_rows and st.pos != st.last_pos0 + n) return error.BadKeep;
+        if (n < st.last_rows and !st.kept_inputs) return error.RollbackNotKept;
+        return st;
+    }
+
+    /// The slot keeps the first `n` rows of its last forward (a verify window): every convolution's state goes back
+    /// to after row n - 1 and the next forward starts at its position + 1. The keys and values of the rows past it
+    /// need no undoing: the next forward rewrites those positions before anything reads them.
+    pub fn keep(e: *Engine, slot: u32, n: usize) !void {
+        const st = try e.keepReady(slot, n);
+        const want = st.last_pos0 + n;
+        if (st.pos == want) return;
+        const c = e.ctx();
+        try state.keepAll(&c, st, n); // one launch for every convolution of every layer
+        st.pos = want;
+    }
+
+    /// The drafter's block at the slot's position (after `keep`): `anchor` is the token there (the target's last
+    /// draw); rank 0 gets the 7 drafts in `out`. Every rank runs it (and embeds the anchor: `draftMany`).
+    pub fn draft(e: *Engine, slot: u32, anchor: u32, out: ?*[dspark.drafts]u32) !void {
+        const one = [1]DraftItem{.{ .slot = slot, .anchor = anchor }};
+        if (out) |o| return e.draftMany(&one, &.{o});
+        return e.draftMany(&one, null);
+    }
+
+    /// What `draftMany` checks before any rank moves (after each slot's keep, or of slots that kept already): every
+    /// slot's position is just past a row of its last forward (whose taps the block reads), no slot twice, at most
+    /// `dspark.most_streams` of them; their blocks into `out`.
+    pub fn draftReady(e: *Engine, items: []const DraftItem, out: *[dspark.most_streams]dspark.Item) ![]const dspark.Item {
+        if (e.drafter == null) return error.NoDrafter;
+        if (items.len == 0 or items.len > dspark.most_streams) return error.BadSegments;
+        for (items, out[0..items.len], 0..) |it, *o, i| {
+            for (items[0..i]) |b| if (b.slot == it.slot) return error.SlotTwiceInADraft;
+            if (it.slot >= e.slots.items.len) return error.UnknownSlot;
+            const st = e.slots.items[it.slot] orelse return error.UnknownSlot;
+            const p = st.pos;
+            if (p == 0 or p - 1 < st.last_pos0 or p - 1 >= st.last_pos0 + st.last_rows) return error.DraftWithoutTaps;
+            o.* = .{ .slot = it.slot, .p = p, .anchor = it.anchor, .feat_row = st.last_row0 + p - 1 - st.last_pos0 }; // the taps' row of position p - 1
+        }
+        return out[0..items.len];
+    }
+
+    /// Several slots' drafter blocks in one pass (cuda_dspark.zig draftMany), each at its slot's position (after its
+    /// `keep`) from its `anchor`: each slot's drafts are the bits of its own `draft`. Every rank runs it (W > 1: the
+    /// anchors' embedding rows gathered; W = 1: rank 0 embeds them); rank 0 gets slot i's 7 drafts in out[i].
+    pub fn draftMany(e: *Engine, items: []const DraftItem, out: ?[]const *[dspark.drafts]u32) !void {
+        const dr = e.drafter orelse return error.NoDrafter;
+        var buf: [dspark.most_streams]dspark.Item = undefined;
+        const its = try e.draftReady(items, &buf);
+        const S = its.len;
+        const c = e.ctx();
+        e.scratch.reset();
+        if (e.o.rank == 0 or e.shared != null) {
+            var ids: [dspark.most_streams]i32 = undefined;
+            for (items, ids[0..S]) |it, *v| v.* = @intCast(it.anchor);
+            try cuda.copy_source.enqueue(e.d, e.act.tokens.ptr, std.mem.sliceAsBytes(ids[0..S]), e.stream);
+        }
+        if (e.shared) |*sh| {
+            try sh.rows(&c, &e.w, e.act.tokens.ptr, e.act.y.slice(0, S), Mat.of(dr.anchors, S, H, .bf16)); // every rank has the anchors
+        } else if (e.o.rank == 0) try head.embed(&c, &e.w, e.act.tokens.ptr, e.act.y.slice(0, S), Mat.of(dr.anchors, S, H, .bf16));
+        try dr.draftMany(&c, its);
+        if (out) |o| try dr.proposalsMany(&c, o);
+    }
+
+    /// The head over rows lo .. lo + n of the last forward, on every rank (each calls it with the same rows): the
+    /// final mix over the blocks completed so far, the final norm, the unembed of the rank's share of the
+    /// vocabulary, the shares all-gathered in rank order; rank 0 then softcaps them and copies them to the host
+    /// (`logits`).
+    pub fn headRows(e: *Engine, lo: usize, n: usize) !void {
+        if (n == 0 or n > head_rows or lo + n > e.rows) return error.BadRows;
+        try e.headBody(lo, n);
+        try e.headDone(n);
+    }
+
+    /// The head's launches (see headRows); nothing here waits on the device.
+    fn headBody(e: *Engine, lo: usize, n: usize) !void {
+        const c = e.ctx();
+        const a = &e.act;
+        e.scratch.reset();
+        const blocks: ops.Blocks = .{ .ptr = a.blocks + lo * H * 2, .stride = a.blockStride(), .count = a.nblocks, .rows = n, .hidden = H };
+        const x = a.x[0].slice(0, n);
+        try res.mix(&c, blocks, a.h[0].slice(lo, n), e.w.output_query, 1, &.{x});
+        const y = e.hrows.slice(0, n);
+        try head.finalNorm(&c, &e.w, x, y);
+        const share: usize = e.w.vocab_rows.len();
+        const mine = e.hparts + @as(u64, e.o.rank) * n * share * 2;
+        try head.unembed(&c, &e.w, y, Mat.of(mine, n, share, .bf16));
+        if (e.o.group) |g| try g.allGather(e.stream, mine, e.hparts, n * share * 2);
+        e.head_n = 0;
+        if (e.o.rank != 0) return;
+        try head.softcapParts(&c, e.hparts, e.o.world, share, e.hout.slice(0, n));
+        if (e.argmax_on) try head.argmax(&c, e.hout.slice(0, n), e.hbufs[3].?.ptr);
+    }
+
+    /// Rank 0: waits for the head and copies its n rows of logits to the host (`logits`), or, when the lanes asked
+    /// for none (`want_logits` false), only the rows' argmax (`argmaxRows`).
+    fn headDone(e: *Engine, n: usize) !void {
+        if (e.o.rank != 0) return;
+        try e.stream.synchronize();
+        if (e.o.group) |g| try g.check();
+        const t0 = Timing.now();
+        const full = e.want_logits or !e.argmax_on;
+        const every = rowsBelow(n);
+        // without the device's argmax every row's logits come down; with it, the rows the lanes asked for
+        const have: u32 = if (!full) 0 else if (!e.argmax_on) every else e.want_rows & every;
+        const U = e.w.unpadded_vocab;
+        if (e.argmax_on) try cuda.memory.download(e.d, e.hbufs[3].?.ptr, std.mem.sliceAsBytes(e.host_max[0..n]));
+        if (have == every) {
+            try cuda.memory.download(e.d, e.hout.ptr, std.mem.sliceAsBytes(e.host[0 .. n * U]));
+        } else {
+            // each run of wanted rows in one copy
+            var r: usize = 0;
+            while (r < n) {
+                if (have >> @intCast(r) & 1 == 0) {
+                    r += 1;
+                    continue;
+                }
+                var end = r + 1;
+                while (end < n and have >> @intCast(end) & 1 == 1) end += 1;
+                try cuda.memory.download(e.d, e.hout.ptr + r * U * 4, std.mem.sliceAsBytes(e.host[r * U .. end * U]));
+                r = end;
+            }
+        }
+        const k = @intFromBool(full);
+        e.counts.heads[k] += 1;
+        e.counts.head_rows[k] += if (full) @popCount(have) else n;
+        e.counts.head_ns[k] += Timing.now() -| t0;
+        e.head_n = n;
+        e.head_logits = full;
+        e.head_have = have;
+    }
+
+    /// Bits of head rows 0 .. n - 1.
+    fn rowsBelow(n: usize) u32 {
+        return if (n >= 32) all_rows else (@as(u32, 1) << @intCast(n)) - 1;
+    }
+
+    /// Rank 0: the softcapped fp32 logits [n, unpadded vocab] of the last head's rows (host memory, valid until the
+    /// next forward or head). error.NoLogits when the head brought down only its argmax rows.
+    pub fn logits(e: *const Engine) ![]const f32 {
+        if (e.o.rank != 0) return error.NotRankZero;
+        if (e.head_n == 0 or !e.head_logits or e.head_have != rowsBelow(e.head_n)) return error.NoLogits;
+        return e.host[0 .. e.head_n * e.w.unpadded_vocab];
+    }
+
+    /// Rank 0: row `r` of the last head's logits, brought down now if the head left it on the device (`want_rows`;
+    /// the head's buffer holds it until the next forward).
+    pub fn fetchRow(e: *Engine, r: usize) ![]const f32 {
+        if (e.o.rank != 0) return error.NotRankZero;
+        if (r >= e.head_n) return error.NoLogits;
+        const U = e.w.unpadded_vocab;
+        if (e.head_have >> @intCast(r) & 1 == 0) {
+            try cuda.memory.download(e.d, e.hout.ptr + r * U * 4, std.mem.sliceAsBytes(e.host[r * U ..][0..U]));
+            e.head_have |= @as(u32, 1) << @intCast(r);
+            e.head_logits = true;
+        }
+        return e.host[r * U ..][0..U];
+    }
+
+    /// Rank 0: row `r` of the last head's logits, when it came down (`want_rows`).
+    pub fn logitsRow(e: *const Engine, r: usize) ![]const f32 {
+        if (e.o.rank != 0) return error.NotRankZero;
+        if (r >= e.head_n or !e.head_logits or e.head_have >> @intCast(r) & 1 == 0) return error.NoLogits;
+        const U = e.w.unpadded_vocab;
+        return e.host[r * U ..][0..U];
+    }
+
+    /// Rank 0: the last head's rows' argmax from the device (each the host argmax of its row's logits), when
+    /// TF_INK2_GPU_ARGMAX is on.
+    pub fn argmaxRows(e: *const Engine) ![]const u32 {
+        if (e.o.rank != 0) return error.NotRankZero;
+        if (e.head_n == 0 or !e.argmax_on) return error.NoArgmax;
+        return e.host_max[0..e.head_n];
+    }
+
+    /// Split experts run in checkpoint mode only, and every rank must hold the experts the same way and run the same
+    /// mode (a gather of both, its own collective, so a mismatch stops every rank before loading).
+    fn checkExperts(e: *Engine) !void {
+        const layout = e.o.experts.?;
+        if (layout == .split and e.k.moe.mode != .checkpoint) {
+            std.log.err("inkling2: split experts (TF_INK2_EXPERTS=split) run in checkpoint mode only: set TF_INK2_MODE=checkpoint", .{});
+            return error.SplitExpertsNeedCheckpointMode;
+        }
+        const g = e.o.group orelse return;
+        const mine: [2]u32 = .{ @intFromEnum(layout), @intFromEnum(e.k.moe.mode) };
+        var all: [ink.plan.max_world][2]u32 = undefined;
+        try g.gather([2]u32, e.d, e.stream, mine, all[0..e.o.world]);
+        for (all[0..e.o.world], 0..) |x, r| if (!std.mem.eql(u32, &x, &mine)) {
+            std.log.err("inkling2 rank {d}: rank {d} runs experts {t} in {t} mode, this rank {t} in {t} mode", .{ e.o.rank, r, @as(ink.plan.Layout, @enumFromInt(x[0])), @as(@TypeOf(e.k.moe.mode), @enumFromInt(x[1])), layout, e.k.moe.mode });
+            return error.RankMismatch;
+        };
+    }
+
+    /// Rank 0: a step's header to every other rank (W > 1): its upload to the device copy (a pinned copy queued on
+    /// the stream, so it lands after every kernel already queued, a replay's reads of the last header included) and
+    /// the broadcast, without waiting for the device (TF_INK2_SYNC_UPLOADS=1: wait, then a blocking copy, as before).
+    pub fn post(e: *Engine, h: Header) !void {
+        const g = e.o.group orelse return;
+        var x = h;
+        x.seq = e.seq;
+        e.seq +%= 1;
+        if (syncUploads()) {
+            try e.stream.synchronize();
+            try e.hdr.upload(0, std.mem.asBytes(&x));
+        } else try cuda.copy_source.enqueue(e.d, e.hdr.ptr, std.mem.asBytes(&x), e.stream);
+        try g.lib.check(g.lib.api.ncclBroadcast(e.hdr.ptr, e.hdr.ptr, @sizeOf(Header), .u8, 0, g.comm, e.stream.handle), "ncclBroadcast");
+    }
+
+    /// Ranks above 0: rank 0's next step.
+    pub fn receive(e: *Engine) !Header {
+        const g = e.o.group orelse return error.NoGroup;
+        try g.lib.check(g.lib.api.ncclBroadcast(e.hdr.ptr, e.hdr.ptr, @sizeOf(Header), .u8, 0, g.comm, e.stream.handle), "ncclBroadcast");
+        try e.stream.synchronize();
+        var h: Header = undefined;
+        try e.hdr.download(0, std.mem.asBytes(&h));
+        if (h.magic != Header.magic_word) return error.BadStep;
+        if (h.seq != e.seq) {
+            std.log.err("inkling2 rank {d}: header {d} from rank 0, {d} expected", .{ e.o.rank, h.seq, e.seq });
+            return error.BadStep;
+        }
+        e.seq +%= 1;
+        return h;
+    }
+
+    /// Every rank must have the same executable, checkpoint (with its digest manifest's text, or none) and settings
+    /// (with the experts' mode) before loading.
+    fn agree(e: *Engine, g: *const cuda.tp_group.Group, dir: []const u8, manifest: ?[]const u8, mode: moe.Mode) !void {
+        const Sha = std.crypto.hash.sha2.Sha256;
+        const o = e.o;
+        var fp: Fingerprint = .{ .program = undefined, .checkpoint = undefined, .settings = undefined, .rank = o.rank, .world = o.world };
+        {
+            var h = Sha.init(.{});
+            try hashFile(e.gpa, e.io, &h, "/proc/self/exe");
+            h.final(&fp.program);
+        }
+        {
+            var h = Sha.init(.{});
+            for ([_][]const u8{ "config.json", "hf_quant_config.json", "model.safetensors.index.json" }) |name| {
+                const path = try std.fs.path.join(e.gpa, &.{ dir, name });
+                defer e.gpa.free(path);
+                try hashFile(e.gpa, e.io, &h, path);
+            }
+            const m = &e.model;
+            for (m.inv.tensors) |t| {
+                h.update(t.name);
+                h.update(std.mem.asBytes(&[3]u64{ t.file, m.inv.offset(t), t.bytes() }));
+            }
+            // the expected contents: every rank's piece digests (each rank checks its own after loading)
+            h.update(manifest orelse "(no digest manifest)");
+            h.final(&fp.checkpoint);
+        }
+        {
+            var h = Sha.init(.{});
+            var buf: [768]u8 = undefined;
+            // every switch that changes a rank's arithmetic, its collectives' shapes or whether decode steps run as
+            // graphs: a rank set differently would hang a collective or mix arithmetic, so the ranks must agree
+            h.update(try std.fmt.bufPrint(&buf, "world {d} layers {d} context {d} scratch {d} rows {d} mode {t} TF_INK2_ATTN={s} TF_INK2_XROWS={s} TF_INK2_TIME_EXCHANGE={s} TF_INK2_CK_PROFILE={s} TF_INK2_CK_SHAPE1={s} TF_INK2_GRAPHS_MAX={d} dspark {} TF_INK2_ROCE_MULTI={s} TF_ROCE={s} TF_INK2_PAGES={} TF_KV_POISON={} TF_INK2_PAGE_ORDER={s} TF_INK2_RUN_RING={}", .{ o.world, o.layers, o.context, o.scratch_gib, prompt_rows, mode, env("TF_INK2_ATTN"), env("TF_INK2_XROWS"), env("TF_INK2_TIME_EXCHANGE"), env("TF_INK2_CK_PROFILE"), env("TF_INK2_CK_SHAPE1"), graphsMax(), o.drafter, env("TF_INK2_ROCE_MULTI"), env("TF_ROCE"), pages.enabled(), pages.poisoned(), env("TF_INK2_PAGE_ORDER"), pages.ringOnRun() }));
+            h.final(&fp.settings);
+        }
+        var all: [ink.plan.max_world]Fingerprint = undefined;
+        try g.gather(Fingerprint, e.d, e.stream, fp, all[0..o.world]);
+        var ok = true;
+        for (all[0..o.world], 0..) |y, r| {
+            const why: ?[]const u8 = if (y.rank != r or y.world != o.world) "rank or world" else if (!std.mem.eql(u8, &y.program, &fp.program)) "the executable" else if (!std.mem.eql(u8, &y.checkpoint, &fp.checkpoint)) "the checkpoint or its digest manifest (TF_INK2_DIGESTS)" else if (!std.mem.eql(u8, &y.settings, &fp.settings)) "the settings (layers, --context, TF_INK2_SCRATCH_GIB, TF_INK2_MODE, TF_INK2_ATTN*, TF_INK2_XROWS, TF_INK2_TIME_EXCHANGE, TF_INK2_CK_PROFILE, TF_INK2_CK_SHAPE1, TF_INK2_GRAPHS_MAX, TF_INK2_DSPARK, TF_INK2_ROCE_MULTI, TF_ROCE, TF_INK2_PAGES, TF_KV_POISON, TF_INK2_PAGE_ORDER, TF_INK2_RUN_RING)" else null;
+            if (why) |w| {
+                std.log.err("inkling2 rank {d}: rank {d} differs from this rank in {s}", .{ o.rank, r, w });
+                ok = false;
+            }
+        }
+        if (!ok) return error.RankMismatch;
+        std.log.info("inkling2 rank {d} of {d}: fingerprint agreed (executable {x}, checkpoint and digest manifest {x}, settings {x}; {t} mode, {s})", .{ o.rank, o.world, fp.program[0..6], fp.checkpoint[0..6], fp.settings[0..6], mode, if (manifest != null) "contents checked" else "contents NOT checked" });
+    }
+};
+
+/// A captured forward (Engine.graphStep): the activations' ping-pong buffers as the capture found and left them,
+/// the blocks it completed, and when it was last replayed (the cache's clock).
+const Graph = struct {
+    key: Key,
+    exec: cuda.graph.Exec,
+    h_start: [2]Mat,
+    h_end: [2]Mat,
+    nblocks: usize,
+    used: u64,
+    /// The nodes that read or write a ring view of a segment's run of pool pages (key.ring), each with the run it
+    /// points at now; the captured graph is kept while they are (node handles are the template's).
+    runs: []RunNode = &.{},
+    tmpl: ?cuda.graph.Graph = null,
+
+    const RunNode = struct { node: cuda.graph.Node, seg: u8, at: ops.RunLog.Launch };
+
+    fn deinit(g: *Graph, gpa: std.mem.Allocator) void {
+        g.exec.deinit();
+        if (g.tmpl) |*t| t.deinit();
+        gpa.free(g.runs);
+    }
+
+    /// Before a replay: every recorded node of a segment on its run pointed at the stream's run now (the bases move
+    /// by whole pages: the same rows of a region, the run's first page on). Returns the nodes changed.
+    fn follow(g: *Graph, gs: []const fwd.Seg) !usize {
+        var n: usize = 0;
+        for (g.runs) |*r| {
+            const st = gs[r.seg].st;
+            const now = st.ringRun() orelse return error.RunGone; // the key's ring bit says it is on a run
+            if (now == r.at.run) continue;
+            const step: i64 = @intCast(st.place.?.run);
+            const delta = (@as(i64, now) - @as(i64, r.at.run)) * step;
+            for (r.at.at[0..r.at.n]) |i| {
+                const was = r.at.args.integer(i).?;
+                const to: u64 = @intCast(@as(i64, @intCast(was)) + delta);
+                @memcpy(r.at.args.storage[r.at.args.offsets[i]..][0..8], std.mem.asBytes(&to));
+            }
+            try g.exec.setKernel(r.node, r.at.f, r.at.cfg, &r.at.args);
+            r.at.run = now;
+            n += 1;
+        }
+        return n;
+    }
+};
+
+const Timing = tp.Timing;
+
+/// The load's prepare hooks, then one that frees the layer's bf16 projection copies once they are packed into
+/// l.extra[0] (only the lane matmul reads the projections): layer by layer, so the
+/// load's peak never holds both forms of every layer. The pointers stay set (their shapes size the packed form).
+/// cuda_attn's prepare already frees the packed sources; this catches the rest (w.drop skips freed pointers).
+const prepare_dropping = fwd.prepare ++ [_]weights.Prepare{dropCopies};
+
+fn dropCopies(w: *weights.Weights, l: *weights.Layer) anyerror!void {
+    if (l.extra[0] == 0) return; // not packed: keep them
+    for ([_]u64{ l.wq, l.wk, l.wv, l.wr, l.wg, l.wsink, l.wo, l.k_wproj, l.v_wproj }) |p| w.drop(p);
+}
+
+fn env(name: [*:0]const u8) []const u8 {
+    return if (std.c.getenv(name)) |v| std.mem.span(v) else "";
+}
+
+fn hashFile(gpa: std.mem.Allocator, io: std.Io, h: *std.crypto.hash.sha2.Sha256, path: []const u8) !void {
+    const bytes = std.Io.Dir.cwd().readFileAlloc(io, path, gpa, .limited(2 << 30)) catch |err| switch (err) {
+        error.FileNotFound => return h.update("(none)"),
+        else => return err,
+    };
+    defer gpa.free(bytes);
+    h.update(bytes);
+}
+
+/// Bytes of the weights rank `rank` of `world` loads for layers [0, layers) (0: all), with rank 0's embed (the whole
+/// table, as loaded before `embed.spread`), the other ranks' rows of it (cuda_embed.zig) and every rank's share of
+/// the head.
+pub fn rankWeightBytes(m: *const ink.describe.Model, rank: u32, layers: u32) u64 {
+    const n = if (layers == 0) m.c.text.layers else layers;
+    var total: u64 = 0;
+    for (m.p.ranks[rank].pieces) |piece| {
+        const t = m.inv.tensors[piece.tensor];
+        if (!std.mem.startsWith(u8, t.name, "model.llm.")) continue;
+        if (m.roles[piece.tensor].layer) |li| {
+            if (li < n) total += piece.run.bytes();
+        } else total += piece.run.bytes();
+    }
+    const world = m.p.split.world;
+    if (rank > 0 and world > 1) {
+        const rows = embed.rowsOf(m.c.text.vocab, rank, world);
+        if (rows.len() > 0) total += @as(u64, rows.len()) * H * 2 + H * 4;
+    }
+    return total;
+}
+
+fn gib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 30);
+}
+
+test "inkling2 cuda engine: a graph's key is its segments' slots and rows" {
+    const k = try Key.of(&.{ .{ .slot = 2, .pos0 = 3000, .rows = 1 }, .{ .slot = 0, .pos0 = 77, .rows = 8 } });
+    try std.testing.expectEqual(@as(u8, 2), k.n);
+    try std.testing.expect(k.eql(try Key.of(&.{ .{ .slot = 2, .pos0 = 1, .rows = 1 }, .{ .slot = 0, .pos0 = 5, .rows = 8 } })));
+    try std.testing.expect(!k.eql(try Key.of(&.{ .{ .slot = 0, .pos0 = 77, .rows = 8 }, .{ .slot = 2, .pos0 = 3000, .rows = 1 } })));
+    try std.testing.expect(!k.eql(try Key.of(&.{.{ .slot = 2, .pos0 = 3000, .rows = 1 }})));
+    try std.testing.expectError(error.BadSegments, Key.of(&.{.{ .slot = 0, .pos0 = 1, .rows = 9 }}));
+    var on_run = k;
+    on_run.ring = 1; // segment 0 (one row) on its run: another graph
+    try std.testing.expect(!k.eql(on_run));
+    // cache units: 1 + segments / 4
+    try std.testing.expectEqual(@as(usize, 1), k.units());
+    var eight: [max_segs]Segment = undefined;
+    for (&eight, 0..) |*g, i| g.* = .{ .slot = @intCast(i), .pos0 = 1, .rows = 1 };
+    try std.testing.expectEqual(@as(usize, 3), (try Key.of(&eight)).units());
+    try std.testing.expectEqual(@as(usize, 2), (try Key.of(eight[0..4])).units());
+    var h: Header = .{ .kind = 1 };
+    try h.setTokens(&.{ 7, 200057 });
+    const bytes = std.mem.asBytes(&h);
+    try std.testing.expectEqual(@as(i32, 200057), std.mem.readInt(i32, bytes[Header.tokens_at + 4 ..][0..4], .little));
+    try h.setSegs(&.{ .{ .slot = 1, .pos0 = 3071, .rows = 8 }, .{ .slot = 3, .pos0 = 12345, .rows = 1 } });
+    try std.testing.expectEqual(@as(i32, 12345), std.mem.readInt(i32, bytes[@intCast(Header.segPosAt(1))..][0..4], .little));
+}
+
+test "inkling2 cuda engine: a step's header is 256 bytes and keeps its fields" {
+    var h: Header = .{ .kind = 1, .slot = 3, .rows = 2048, .pos0 = 1 << 40 };
+    try h.setSegs(&.{ .{ .slot = 2, .pos0 = 3000, .rows = 1 }, .{ .slot = 0, .pos0 = 77, .rows = 8 } });
+    var back: Header = undefined;
+    @memcpy(std.mem.asBytes(&back), std.mem.asBytes(&h));
+    try std.testing.expectEqual(h, back);
+    try std.testing.expectEqual(Header.magic_word, back.magic);
+    var buf: [fwd.max_segs]Segment = undefined;
+    const segs = try back.getSegs(&buf);
+    try std.testing.expectEqual(@as(usize, 2), segs.len);
+    try std.testing.expectEqual(Segment{ .slot = 0, .pos0 = 77, .rows = 8 }, segs[1]);
+    try std.testing.expectError(error.BadSegments, h.setSegs(&.{.{ .slot = 1 << 16, .pos0 = 0, .rows = 1 }}));
+}
+
+test "inkling2 cuda engine: the graph cache holds every one-stream key at 8 slots" {
+    try std.testing.expect(graphs_default >= 8 * graph_seg_rows and graph_rows <= head_rows);
+}
diff --git a/zig/src/families/inkling2/cuda_follow.zig b/zig/src/families/inkling2/cuda_follow.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3db80ad444202fcd6b0e33eea3df7c4d7d2da38d
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_follow.zig
@@ -0,0 +1,504 @@
+//! Ranks over processes: rank 0's `Leader` broadcasts each step's header (kind, slot, rows, first position) over the
+//! ranks' NCCL group before running it; every other rank `follow`s, running the same forward (its embedded rows come
+//! by the gather of the ranks' table rows inside the forward, cuda_embed.zig). A header can ask for the head over
+//! some of the forward's rows after it, or over rows of the last forward alone (`head`): every rank unembeds its
+//! share of the vocabulary (cuda_engine.zig `headRows`). Rank 0 alone samples: nothing about tokens or sampling
+//! crosses. At W = 1 the leader just runs its steps.
+//!
+//! Rank 0 does everything in a step that can fail on its own (the rows, the slot's state, the positions) before the
+//! header goes out, so such a failure is the request's alone and no rank has moved. A failure after the header, or
+//! in sending it, leaves the other ranks waiting in a collective rank 0 will not reach: every rank stops then.
+//!
+//! With the ranks' liveness lines open (cuda.tp_watch, served ranks), a rank that dies stops the others, and while no
+//! stream is left rank 0 sends `idle`: the other ranks then sleep on their lines (neither CUDA nor NCCL spins) until
+//! rank 0 wakes them before its next step. Followers start asleep.
+const std = @import("std");
+const cuda = @import("cuda");
+const engine = @import("cuda_engine.zig");
+const scratch = @import("cuda_scratch.zig");
+
+/// `drafts`: several slots' keeps and drafter blocks in one pass (`Leader.draftMany`): segment i is (slot, rows to
+/// keep, the anchor token in pos0). `save` .. `capture`: the prompt cache's copies (cuda_snap.zig). `mark` / `rewind`:
+/// tooling (tf-inkling2-decode --exp deep), a slot's convolution states and position kept aside and put back.
+/// `synth` / `synth_check`: tooling (--exp deep --fill synth), a slot's positions 0 .. pos0 - 1 written with synthetic
+/// values (cuda_synth.zig), and the global layers' rows read back against them (each rank logs its own).
+/// `pages`: a slot's stream opened on the KV page pool (cuda_pages.zig): rank 0's page ids for it (the slot's table
+/// broadcast after the header; `rows` of them name its pages) on every rank.
+pub const Kind = enum(u32) { forward = 1, end = 2, idle = 3, reserve = 4, head = 5, keep = 6, draft = 7, drafts = 8, save = 9, restore = 10, arena = 11, move = 12, capture = 13, mark = 14, rewind = 15, synth = 16, synth_check = 17, pages = 18 };
+
+/// Rows lo .. lo + n of a forward to turn into logits.
+pub const Rows = struct {
+    lo: usize,
+    n: usize,
+};
+
+/// TF_INK2_GRAPH (rank 0): `0` runs every forward eagerly; anything else (or unset) runs decode steps and verify
+/// windows as captured CUDA graphs (`Leader.graphOk`). The timing switches that wait on the device inside a step
+/// (TF_INK2_TIME_EXCHANGE, TF_INK2_CK_PROFILE) run eagerly.
+fn graphs() bool {
+    for ([_][*:0]const u8{ "TF_INK2_TIME_EXCHANGE", "TF_INK2_CK_PROFILE" }) |n| if (std.c.getenv(n)) |v| if (v[0] == '1') return false;
+    const v = std.c.getenv("TF_INK2_GRAPH") orelse return true;
+    return !(v[0] == '0' and v[1] == 0);
+}
+
+/// TF_INK2_GRAPH_SEGS (rank 0): `1` runs only one stream's forwards as graphs (several streams' rows eagerly, as
+/// stage 2b did; for A/B); anything else (or unset) runs several streams' too, on a key's second sighting.
+fn multiGraphs() bool {
+    const v = std.c.getenv("TF_INK2_GRAPH_SEGS") orelse return true;
+    return !(v[0] == '1' and v[1] == 0);
+}
+
+/// TF_INK2_SERVE_FAULT (tests): `slot:N` fails rank 0's N-th forward step at its slot, before its header (as a failed
+/// state allocation would); `step:N` fails it just after its header.
+const Fault = struct {
+    kind: enum { none, slot, step } = .none,
+    at: u64 = 0,
+    var steps: u64 = 0;
+
+    fn read() Fault {
+        const v = std.mem.span(std.c.getenv("TF_INK2_SERVE_FAULT") orelse return .{});
+        const colon = std.mem.indexOfScalar(u8, v, ':') orelse return .{};
+        const at = std.fmt.parseInt(u64, v[colon + 1 ..], 10) catch return .{};
+        const name = v[0..colon];
+        return if (std.mem.eql(u8, name, "slot")) .{ .kind = .slot, .at = at } else if (std.mem.eql(u8, name, "step")) .{ .kind = .step, .at = at } else .{};
+    }
+
+    /// This step's induced fault, if any (counts rank 0's forward steps).
+    fn next() @FieldType(Fault, "kind") {
+        const f = read();
+        if (f.kind == .none) return .none;
+        steps += 1;
+        if (steps != f.at) return .none;
+        std.log.warn("inkling2 rank 0: TF_INK2_SERVE_FAULT fails step {d} ({s} its header)", .{ steps, if (f.kind == .slot) "before" else "after" });
+        return f.kind;
+    }
+};
+
+pub const Leader = struct {
+    e: *engine.Engine,
+    /// Tooling: decode steps run eagerly whatever TF_INK2_GRAPH says (graph-against-eager timing in one process).
+    eager: bool = false,
+
+    /// The shared embedding (cuda_embed.zig): an eager forward of at most `graph_rows` rows carries its ids in its
+    /// header (`token` 1), so the other ranks need no broadcast of them (cuda_engine.zig `tokens`, `body`).
+    fn idsInHeader(x: Leader, h: *engine.Header, ids: []const u32) !void {
+        x.e.ids_in_header = false;
+        if (x.e.shared == null or ids.len == 0 or ids.len > engine.graph_rows) return;
+        try h.setTokens(ids);
+        h.token = 1;
+        x.e.ids_in_header = true;
+    }
+
+    /// A failure in sending a header stops every rank (whether it went out is not known).
+    pub fn send(x: Leader, h: engine.Header) !void {
+        if (x.e.asleep) {
+            cuda.tp_watch.wake();
+            x.e.asleep = false;
+        }
+        x.e.post(h) catch |err| return x.stop(err);
+    }
+
+    /// W > 1: a step failed after its header went out, so the other ranks wait in a collective this rank will not
+    /// reach. Every rank stops: the others hear this one's error on their lines and exit. W = 1: the error returns.
+    pub fn stop(x: Leader, err: anyerror) anyerror {
+        if (x.e.o.world < 2 or x.e.o.group == null) return err; // W = 1, or one rank alone (--solo)
+        std.log.err("inkling2 rank 0: a step failed after its header went out ({s}); every rank stops", .{@errorName(err)});
+        cuda.tp_watch.fatal(@errorName(err));
+        std.c._exit(1);
+    }
+
+    /// Whether a forward of `segs` (R rows) with the head over rows `hr` runs as a captured graph (`graphStep`), rank
+    /// 0's choice (the header carries it): TF_INK2_GRAPH not 0, no forced-eager tooling (`eager`) or profiled pass
+    /// (its marks are events), every segment past its prompt with at most 8 rows (a decode step or a verify window),
+    /// at most `graph_rows` in all, and the head over every row. One segment always; several (one forward of several
+    /// streams' rows, keyed by their slots and rows in order) from the key's second sighting (`Engine.graphWanted`;
+    /// the first runs eagerly), unless TF_INK2_GRAPH_SEGS=1. Called once a forward (it counts the sighting). With the
+    /// drafter its taps and context writes are in the graph.
+    pub fn graphOk(x: Leader, segs: []const engine.Segment, R: usize, hr: Rows) bool {
+        if (!graphs() or x.eager or x.e.prof_on or segs.len == 0 or R > engine.graph_rows) return false;
+        if (hr.lo != 0 or hr.n != R) return false;
+        for (segs) |g| if (g.pos0 == 0 or g.rows > engine.graph_seg_rows) return false;
+        if (segs.len == 1) return true;
+        if (!multiGraphs()) return false;
+        return x.e.graphWanted(x.e.keyOf(segs) catch return false);
+    }
+
+    /// Before a forward's header: the op scratch holds it (cuda_scratch.zig need; a captured step's attention spans
+    /// the slot's capacity), else error.ScratchShort fails the request and no rank moves.
+    fn fits(x: Leader, segs: []const engine.Segment, graph: bool) !void {
+        try scratch.fitsSegs(&x.e.scratch, &x.e.k, &x.e.w, segs, if (graph) x.e.capacity() else null);
+    }
+
+    /// `ids` (R rows) of slot `slot` from position pos0, on every rank; then, if asked, the head over rows `logits`
+    /// of it (rank 0's softcapped logits: `e.logits()`). A decode step or a verify window (past the prompt, at most
+    /// 8 rows, the head over all of them) runs as a captured graph (`graphOk`).
+    pub fn forward(x: Leader, slot: u32, pos0: usize, ids: []const u32, logits: ?Rows) !void {
+        const fault = Fault.next();
+        if (fault == .slot) return error.OutOfMemory;
+        try x.toolPages(slot, pos0);
+        _ = try x.e.ready(slot, pos0, ids.len);
+        const hr = logits orelse Rows{ .lo = 0, .n = 0 };
+        if (hr.n > engine.head_rows or hr.lo + hr.n > ids.len) return error.BadRows;
+        const seg = [1]engine.Segment{.{ .slot = slot, .pos0 = pos0, .rows = ids.len }};
+        const graph = x.graphOk(&seg, ids.len, hr);
+        try x.fits(&seg, graph);
+        if (graph) return x.graphForward(&seg, ids, fault);
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.forward), .slot = slot, .rows = @intCast(ids.len), .pos0 = pos0, .head_lo = @intCast(hr.lo), .head_n = @intCast(hr.n) };
+        h.pad[1] = @intFromBool(x.e.prof_on);
+        try x.idsInHeader(&h, ids);
+        try x.send(h);
+        if (fault == .step) return x.stop(error.InducedFault);
+        x.e.forward(slot, pos0, ids.len, ids) catch |err| return x.stop(err);
+        if (hr.n > 0) x.e.headRows(hr.lo, hr.n) catch |err| return x.stop(err);
+    }
+
+    /// A forward of `segs` with the head over all its rows as a captured graph on every rank: the segments and the
+    /// token ids go out in the header (the graph reads them on the device).
+    fn graphForward(x: Leader, segs: []const engine.Segment, ids: []const u32, fault: @FieldType(Fault, "kind")) !void {
+        var fs: [engine.max_segs]@import("cuda_forward.zig").Seg = undefined;
+        const R = try x.e.graphReady(segs, &fs);
+        if (ids.len != R) return error.BadRows;
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.forward), .rows = @intCast(R), .head_lo = 0, .head_n = @intCast(R), .graph = 1 };
+        try h.setSegs(segs);
+        try h.setTokens(ids);
+        try x.send(h);
+        if (fault == .step) return x.stop(error.InducedFault);
+        x.e.graphStep(segs, ids) catch |err| return x.stop(err);
+    }
+
+    /// Several streams' rows in one forward (batched decode, cuda_engine.zig forwardMany: segment i is segs[i].rows
+    /// rows of slot segs[i].slot from segs[i].pos0, `ids` in segment order), on every rank; then, if asked, the head
+    /// over rows `logits` of it. One segment is `forward`; several run as a captured graph when `graphOk` says so,
+    /// else eagerly.
+    pub fn forwardMany(x: Leader, segs: []const engine.Segment, ids: []const u32, logits: ?Rows) !void {
+        if (segs.len == 1) return x.forward(segs[0].slot, segs[0].pos0, ids, logits);
+        const fault = Fault.next();
+        if (fault == .slot) return error.OutOfMemory;
+        for (segs) |g| try x.toolPages(g.slot, g.pos0);
+        var fs: [engine.max_segs]@import("cuda_forward.zig").Seg = undefined;
+        const R = try x.e.readyMany(segs, &fs);
+        if (ids.len != R) return error.BadRows;
+        const hr = logits orelse Rows{ .lo = 0, .n = 0 };
+        if (hr.n > engine.head_rows or hr.lo + hr.n > R) return error.BadRows;
+        const graph = x.graphOk(segs, R, hr);
+        try x.fits(segs, graph);
+        if (graph) return x.graphForward(segs, ids, fault);
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.forward), .rows = @intCast(R), .head_lo = @intCast(hr.lo), .head_n = @intCast(hr.n) };
+        try h.setSegs(segs);
+        h.pad[1] = @intFromBool(x.e.prof_on);
+        try x.idsInHeader(&h, ids);
+        try x.send(h);
+        if (fault == .step) return x.stop(error.InducedFault);
+        x.e.forwardMany(segs, ids) catch |err| return x.stop(err);
+        if (hr.n > 0) x.e.headRows(hr.lo, hr.n) catch |err| return x.stop(err);
+    }
+
+    /// A verify forward whose drafts are made in the same step, with one header (the deferred draft, B2 C3 S2): each
+    /// segment i with keeps[i].n > 0 first keeps that many rows of its slot's last forward, and with keeps[i].draft
+    /// its drafter block runs from the window's first row (its anchor, ids[r0]); then the forward of `segs` and the
+    /// head over all its rows. Every drafting segment's window rows 1 .. are its drafts, made on the device: their
+    /// entries in `ids` are not read (rank 0 copies the drafter's walk into the forward's ids; `e.proposals` gives
+    /// them after). The same kernels in the same order as `draftMany` and then `forwardMany` (a graph when it
+    /// applies), so the same bits; one header and no wait between the draft and the window.
+    pub fn forwardDrafted(x: Leader, segs: []const engine.Segment, ids: []const u32, keeps: []const Keep) !void {
+        const e = x.e;
+        if (e.drafter == null) return error.NoDrafter;
+        if (segs.len == 0 or segs.len > engine.max_segs or keeps.len != segs.len) return error.BadSegments;
+        for (segs) |g| try x.toolPages(g.slot, g.pos0);
+        // every check a rank could fail alone, before the header: the keeps, each window at its kept position, the
+        // drafts' rows, then the forward's own (as readyMany, at the positions the keeps leave)
+        var R: usize = 0;
+        var items: [engine.max_segs]engine.DraftItem = undefined;
+        var walks: [engine.max_segs]engine.WalkIds = undefined;
+        var m: usize = 0;
+        var packed_keeps: u64 = 0;
+        var kept: [engine.max_segs]Keep = undefined;
+        for (segs, keeps, kept[0..segs.len], 0..) |g, k, *kk, i| {
+            for (segs[0..i]) |o| if (o.slot == g.slot) return error.SlotTwiceInAForward;
+            if (g.rows == 0 or g.pos0 == 0) return error.BadRows;
+            kk.* = k;
+            if (k.n > 0) {
+                const st = try e.keepReady(g.slot, k.n);
+                if (g.pos0 != st.last_pos0 + k.n or g.pos0 + g.rows > st.limit()) return error.OutOfStep;
+                if (st.pos == g.pos0) kk.n = 0 else if (k.n > 0x7f) return error.BadKeep; // kept already: nothing to send
+            }
+            if (kk.n == 0) _ = try e.ready(g.slot, g.pos0, g.rows);
+            if (k.draft) {
+                if (g.rows - 1 > @import("cuda_dspark.zig").drafts or R >= ids.len) return error.BadRows;
+                items[m] = .{ .slot = g.slot, .anchor = ids[R] };
+                walks[m] = .{ .row = @intCast(R), .y = @intCast(m), .n = @intCast(g.rows - 1) };
+                m += 1;
+            }
+            packed_keeps |= @as(u64, @intCast(kk.n | (@as(usize, @intFromBool(k.draft)) << 7))) << @intCast(8 * i);
+            R += g.rows;
+        }
+        if (ids.len != R) return error.BadRows;
+        if (packed_keeps == 0) return x.forwardMany(segs, ids, .{ .lo = 0, .n = R });
+        if (R > engine.graph_rows) return error.BadRows;
+        const fault = Fault.next();
+        if (fault == .slot) return error.OutOfMemory;
+        const hr: Rows = .{ .lo = 0, .n = R };
+        const graph = x.graphOk(segs, R, hr);
+        try x.fits(segs, graph);
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.forward), .rows = @intCast(R), .head_lo = 0, .head_n = @intCast(R), .graph = @intFromBool(graph) };
+        try h.setSegs(segs);
+        try h.setTokens(ids); // the anchors (each drafting window's first row) reach the other ranks here
+        h.pad[0] = packed_keeps;
+        h.pad[1] = @intFromBool(e.prof_on);
+        if (!graph and e.shared != null) h.token = 1; // and the eager forward's ids (`idsInHeader`)
+        e.ids_in_header = h.token == 1;
+        try x.send(h);
+        if (fault == .step) return x.stop(error.InducedFault);
+        x.keepsDrafts(segs, kept[0..segs.len], items[0..m]) catch |err| return x.stop(err);
+        e.setWalkIds(walks[0..m]) catch |err| return x.stop(err);
+        if (graph) {
+            e.graphStep(segs, ids) catch |err| return x.stop(err);
+            return;
+        }
+        e.forwardMany(segs, ids) catch |err| return x.stop(err);
+        e.headRows(0, R) catch |err| return x.stop(err);
+    }
+
+    fn keepsDrafts(x: Leader, segs: []const engine.Segment, keeps: []const Keep, items: []const engine.DraftItem) !void {
+        for (segs, keeps) |g, k| if (k.n > 0) try x.e.keep(g.slot, k.n);
+        if (items.len > 0) try x.e.draftMany(items, null);
+    }
+
+    /// A segment's keep (rows of its slot's last forward; 0: none) and whether its drafter block runs after it
+    /// (`forwardDrafted`).
+    pub const Keep = struct { n: usize = 0, draft: bool = false };
+
+    /// The head over rows `r` of the last forward, on every rank: rank 0's softcapped logits [r.n, vocab] (host
+    /// memory, valid until the next forward or head).
+    pub fn head(x: Leader, r: Rows) ![]const f32 {
+        if (r.n == 0 or r.n > engine.head_rows or r.lo + r.n > x.e.rows) return error.BadRows;
+        try x.send(.{ .kind = @intFromEnum(Kind.head), .head_lo = @intCast(r.lo), .head_n = @intCast(r.n) });
+        x.e.headRows(r.lo, r.n) catch |err| return x.stop(err);
+        return x.e.logits();
+    }
+
+    /// The slot keeps the first `n` rows of its last forward (a verify window), on every rank.
+    pub fn keep(x: Leader, slot: u32, n: usize) !void {
+        const st = try x.e.keepReady(slot, n);
+        if (st.pos == st.last_pos0 + n) return;
+        try x.send(.{ .kind = @intFromEnum(Kind.keep), .slot = slot, .rows = @intCast(n) });
+        x.e.keep(slot, n) catch |err| return x.stop(err);
+    }
+
+    /// `keep` of n rows, then the drafter's block at the slot's new position from `anchor`, on every rank; rank 0's
+    /// 7 drafts into `out`.
+    pub fn draft(x: Leader, slot: u32, n: usize, anchor: u32, out: *[@import("cuda_dspark.zig").drafts]u32) !void {
+        if (x.e.drafter == null) return error.NoDrafter;
+        _ = try x.e.keepReady(slot, n);
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.draft), .slot = slot, .rows = @intCast(n) };
+        h.pad[0] = anchor;
+        try x.send(h);
+        x.e.keep(slot, n) catch |err| return x.stop(err);
+        x.e.draft(slot, anchor, out) catch |err| return x.stop(err);
+    }
+
+    /// Several slots' drafts in one pass, on every rank: each slot keeps its `keeps[i]` rows (its last verify's
+    /// accepted ones), then one drafter pass makes every slot's block (cuda_engine.zig draftMany: each slot's drafts
+    /// the bits of its own `draft`); rank 0's 7 drafts of slot i into out[i]. One header for all of them.
+    pub fn draftMany(x: Leader, items: []const engine.DraftItem, keeps: []const usize, out: []const *[@import("cuda_dspark.zig").drafts]u32) !void {
+        if (x.e.drafter == null) return error.NoDrafter;
+        if (items.len != keeps.len or items.len != out.len or items.len == 0 or items.len > engine.max_segs) return error.BadSegments;
+        // everything a rank could fail on alone, before the header: each keep, then each block's taps after it
+        var segs: [engine.max_segs]engine.Segment = undefined;
+        for (items, keeps, segs[0..items.len], 0..) |it, n, *g, i| {
+            for (items[0..i]) |b| if (b.slot == it.slot) return error.SlotTwiceInADraft;
+            const st = try x.e.keepReady(it.slot, n);
+            if (n == 0 or n > st.last_rows) return error.BadKeep;
+            g.* = .{ .slot = it.slot, .pos0 = it.anchor, .rows = n };
+        }
+        var h: engine.Header = .{ .kind = @intFromEnum(Kind.drafts) };
+        try h.setSegs(segs[0..items.len]);
+        try x.send(h);
+        for (items, keeps) |it, n| x.e.keep(it.slot, n) catch |err| return x.stop(err);
+        x.e.draftMany(items, out) catch |err| return x.stop(err);
+    }
+
+    /// Tooling: slot `slot`'s state where it stands kept aside on every rank (cuda_engine.zig `mark`).
+    pub fn mark(x: Leader, slot: u32) !void {
+        if (x.e.pos(slot) == 0) return error.UnknownSlot;
+        try x.send(.{ .kind = @intFromEnum(Kind.mark), .slot = slot });
+        x.e.mark(slot) catch |err| return x.stop(err);
+    }
+
+    /// Tooling: slot `slot` back to its `mark` on every rank.
+    pub fn rewind(x: Leader, slot: u32) !void {
+        const m = x.e.marked orelse return error.NothingMarked;
+        if (m.slot != slot) return error.NothingMarked;
+        try x.send(.{ .kind = @intFromEnum(Kind.rewind), .slot = slot });
+        x.e.rewind(slot) catch |err| return x.stop(err);
+    }
+
+    /// Tooling: slot `slot` as if positions 0 .. positions - 1 had run, on every rank (cuda_engine.zig `synth`).
+    pub fn synth(x: Leader, slot: u32, positions: usize) !void {
+        if (positions == 0 or positions >= x.e.capacity()) return error.PastContext;
+        _ = try x.e.bind(slot); // (and its draft caches) a failed allocation moves no rank
+        try x.toolPages(slot, 0);
+        try x.send(.{ .kind = @intFromEnum(Kind.synth), .slot = slot, .pos0 = positions });
+        x.e.synth(slot, positions) catch |err| return x.stop(err);
+    }
+
+    /// Tooling: every rank reads slot `slot`'s global layers' positions 0 .. positions - 1 back against the fill and
+    /// logs it; true only if every rank's rows are equal (the verdicts gathered in Engine.synthCheck).
+    pub fn synthCheck(x: Leader, slot: u32, positions: usize) !bool {
+        if (slot >= x.e.slots.items.len or x.e.slots.items[slot] == null) return error.UnknownSlot;
+        try x.send(.{ .kind = @intFromEnum(Kind.synth_check), .slot = slot, .pos0 = positions });
+        const got = x.e.synthCheck(slot, positions) catch |err| return x.stop(err);
+        return got.bad == null and got.ranks_bad == 0;
+    }
+
+    /// Every rank's states for `n` streams (slots 0 .. n - 1), made at start-up, on pages the pool of rank 0's
+    /// planned pages first (cuda_native.zig count): rank 0's first, so its failure sends nothing; a rank that fails
+    /// after stops every rank. The other ranks then sleep again.
+    pub fn reserve(x: Leader, n: u32) !void {
+        const npages: usize = if (x.e.plan) |p| p.pages else 0;
+        try x.e.reserve(n, npages);
+        if (x.e.o.world < 2) return;
+        try x.send(.{ .kind = @intFromEnum(Kind.reserve), .slot = n, .pos0 = npages });
+        try x.idle();
+    }
+
+    /// Slot `slot`'s stream holds pages `ids` of the pool (rank 0's allocation; the first `shared` a kept state's,
+    /// adopted), on every rank: the header, then the slot's table broadcast (Engine.mapPages). Checked before the
+    /// header: the slot is on the pool and the ids fit its table.
+    pub fn mapPages(x: Leader, slot: u32, ids: []const u32, shared: usize) !void {
+        const p = x.e.pool orelse return error.NoPool;
+        if (slot >= p.slots or ids.len == 0 or shared > ids.len) return error.NoSlot;
+        const st = try x.e.bind(slot);
+        if (ids.len > st.ids.len) return error.PastContext;
+        for (ids) |id| if (id >= p.total()) return error.BadPage;
+        try x.send(.{ .kind = @intFromEnum(Kind.pages), .slot = slot, .rows = @intCast(ids.len), .pos0 = shared });
+        x.e.mapPages(slot, ids.len, ids, shared) catch |err| return x.stop(err);
+    }
+
+    /// Rank 0: slot `slot`'s stream takes `n` pages of the pool, the first `adopt.len` a kept state's (Pool.open),
+    /// and every rank maps them (`mapPages`). LaneMemory: not now; nothing was sent.
+    pub fn openPages(x: Leader, slot: u32, n: usize, adopt: []const u32) ![]const u32 {
+        const p = x.e.pool orelse return error.NoPool;
+        _ = try x.e.bind(slot);
+        const ids = try p.open(slot, n, adopt);
+        try x.mapPages(slot, ids, adopt.len);
+        return ids;
+    }
+
+    /// Tooling on the tool pool (Engine.toolPool): before a forward of slot `slot` from `pos0`, the slot holds its
+    /// whole context's pages: taken when it first runs, and taken anew when a new sequence (pos0 = 0) would rewrite
+    /// pages a kept state holds.
+    pub fn toolPages(x: Leader, slot: u32, pos0: usize) !void {
+        if (!x.e.tool_pool) return;
+        const p = x.e.pool.?;
+        const st = try x.e.bind(slot);
+        const a = &(p.alloc orelse return error.NotLeader);
+        if (st.mapped == p.entries and !(pos0 == 0 and a.anyKept(st.ids[0..st.mapped]))) return;
+        _ = try x.openPages(slot, p.entries, &.{});
+    }
+
+    /// No stream is left: the other ranks sleep on their lines until the next step (when the lines are open).
+    pub fn idle(x: Leader) !void {
+        if (!x.e.asleep) x.e.scratch.report(x.e.o.rank);
+        if (x.e.o.world < 2 or x.e.asleep or !cuda.tp_watch.open()) return;
+        try x.send(.{ .kind = @intFromEnum(Kind.idle) });
+        x.e.asleep = true;
+    }
+
+    /// The other ranks leave their loops.
+    pub fn end(x: Leader) !void {
+        if (x.e.o.world < 2) return;
+        cuda.tp_watch.ended();
+        try x.send(.{ .kind = @intFromEnum(Kind.end) });
+    }
+};
+
+/// A forward header's keeps and drafts (Leader.forwardDrafted, pad[0]: segment i's keep in byte i, its draft flag
+/// in that byte's bit 7; the anchors are the token ids of the drafting windows' first rows). With the shared
+/// embedding the window rows the drafts fill are set as on rank 0 (a captured forward reads this rank's header copy).
+fn followDrafts(e: *engine.Engine, h: *const engine.Header) !void {
+    var buf: [engine.max_segs]engine.Segment = undefined;
+    const segs = try h.getSegs(&buf);
+    var items: [engine.max_segs]engine.DraftItem = undefined;
+    var walks: [engine.max_segs]engine.WalkIds = undefined;
+    var m: usize = 0;
+    var r0: usize = 0;
+    for (segs, 0..) |g, i| {
+        const b: u8 = @truncate(h.pad[0] >> @intCast(8 * i));
+        const n = b & 0x7f;
+        if (n > 0) try e.keep(g.slot, n);
+        if (b & 0x80 != 0) {
+            if (r0 >= engine.graph_rows) return error.BadStep;
+            if (g.rows == 0 or g.rows - 1 > @import("cuda_dspark.zig").drafts) return error.BadStep;
+            items[m] = .{ .slot = g.slot, .anchor = @intCast(h.tokens[r0]) };
+            walks[m] = .{ .row = @intCast(r0), .y = @intCast(m), .n = @intCast(g.rows - 1) };
+            m += 1;
+        }
+        r0 += g.rows;
+    }
+    if (m > 0) try e.draftMany(items[0..m], null);
+    if (e.shared != null) try e.setWalkIds(walks[0..m]);
+}
+
+/// A rank other than 0: rank 0's steps until it ends.
+pub fn follow(e: *engine.Engine) !void {
+    var steps: u64 = 0;
+    cuda.tp_watch.sleep(e.io); // returns at once without lines
+    while (true) {
+        const h = try e.receive();
+        switch (std.enums.fromInt(Kind, h.kind) orelse return error.BadStep) {
+            .forward => {
+                e.prof_on = h.pad[1] == 1; // rank 0's budget pass
+                if (h.pad[0] != 0) try followDrafts(e, &h); // Leader.forwardDrafted: the keeps and drafts first
+                if (h.graph == 1) {
+                    var buf: [engine.max_segs]engine.Segment = undefined;
+                    if (h.head_lo != 0 or h.head_n != h.rows) return error.BadStep;
+                    try e.graphStep(try h.getSegs(&buf), null);
+                } else if (h.nseg > 0) {
+                    var buf: [engine.max_segs]engine.Segment = undefined;
+                    e.ids_in_header = h.token == 1;
+                    try e.forwardMany(try h.getSegs(&buf), null);
+                    if (h.head_n > 0) try e.headRows(h.head_lo, h.head_n);
+                } else {
+                    e.ids_in_header = h.token == 1;
+                    try e.forward(h.slot, @intCast(h.pos0), h.rows, null);
+                    if (h.head_n > 0) try e.headRows(h.head_lo, h.head_n);
+                }
+            },
+            .head => try e.headRows(h.head_lo, h.head_n),
+            .reserve => try e.reserve(h.slot, @intCast(h.pos0)),
+            .pages => try e.mapPages(h.slot, h.rows, null, @intCast(h.pos0)),
+            .mark => try e.mark(h.slot),
+            .rewind => try e.rewind(h.slot),
+            .synth => try e.synth(h.slot, @intCast(h.pos0)),
+            .synth_check => _ = try e.synthCheck(h.slot, @intCast(h.pos0)),
+            .keep => try e.keep(h.slot, h.rows),
+            .draft => {
+                try e.keep(h.slot, h.rows);
+                try e.draft(h.slot, @intCast(h.pad[0]), null);
+            },
+            .save, .restore, .arena, .capture => try @import("cuda_snap.zig").follow(e, h), // the prompt cache's copies
+            .move => return error.BadStep, // the copies' compaction (stage 1) is gone
+            .drafts => {
+                var buf: [engine.max_segs]engine.Segment = undefined;
+                const segs = try h.getSegs(&buf);
+                var items: [engine.max_segs]engine.DraftItem = undefined;
+                for (segs, items[0..segs.len]) |g, *it| {
+                    try e.keep(g.slot, g.rows);
+                    it.* = .{ .slot = g.slot, .anchor = @intCast(g.pos0) };
+                }
+                try e.draftMany(items[0..segs.len], null);
+            },
+            .idle => {
+                e.scratch.report(e.o.rank);
+                cuda.tp_watch.sleep(e.io);
+            },
+            .end => {
+                cuda.tp_watch.ended();
+                std.log.info("inkling2 rank {d}: rank 0 ended after {d} steps", .{ e.o.rank, steps });
+                return;
+            },
+        }
+        steps += 1;
+    }
+}
diff --git a/zig/src/families/inkling2/cuda_forward.zig b/zig/src/families/inkling2/cuda_forward.zig
new file mode 100644
index 0000000000000000000000000000000000000000..954a8884c125395a8d72bf8f583ddb422c86edde
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_forward.zig
@@ -0,0 +1,682 @@
+//! Inkling-2's forward in `full` mode on one rank, written as the sequence of op-group entry points (cuda_res,
+//! cuda_attn, cuda_conv, cuda_moe, cuda_head) over the activations of one forward (`Act`: R rows at positions
+//! pos0 .. pos0 + R - 1 of one stream) and the stream's state (`State`). Every op runs between `before` and
+//! `after`, which give the hooks the op's tensors: --dump-ops records inputs and outputs, --feed replaces every
+//! op's outputs with torch's (so each op is tested on torch's inputs) and lets an op without a kernel
+//! (error.NotImplemented) pass with torch's outputs. Without --feed such an op stops the forward, named in `stopped`.
+//!
+//! One decoder layer L (Transformers' Inkling2SlidingDecoderLayer / Inkling2FullDecoderLayer):
+//!   res.attn_input  x_j = Mix(attn_queries; blocks, h_in)              (L > 0; 1 query, 3 in global layers)
+//!   res.attn_norm   xn = norm(x) (sliding) | res.q_norm, res.k_norm, res.v_norm (global)
+//!   attn.project    q, k, v, rel, gate, sink (+ dk, dv)
+//!   conv.kv         kc, vc                       then the scaffold commits the K and V conv states
+//!   attn.heads      q', k', v', rel'             then the scaffold writes k', v' to the cache
+//!   attn.core       o
+//!   attn.out        ao                           (W > 1: the rank's fp32 partial; sum 1 in rank order -> ao)
+//!   conv.attn       a                            then commits the post-attention conv state
+//!   res.partial     partial                      then, at a boundary layer, pushes h_in onto the blocks
+//!   res.mlp_input   x = Mix(mlp_query; blocks, partial)
+//!   res.mlp_norm    m
+//!   moe.route       ids, wts, logits
+//!   moe.experts     y                            (W > 1: the rank's fp32 partial; sum 2 in rank order -> y)
+//!                   split experts (W > 1, checkpoint mode): h, the rank's act columns; MoE-A gathers them;
+//!   moe.down        the rank's columns of y      (split experts only); MoE-B gathers them -> y
+//!   conv.mlp        cm                           then commits the post-MLP conv state
+//!   res.output      h_out
+//! Model ops: head.embed before layer 0; res.final_input, head.final_norm, head.unembed, head.softcap after 47.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const weights = @import("cuda_weights.zig");
+const state = @import("cuda_state.zig");
+const attn = @import("cuda_attn.zig");
+const conv = @import("cuda_conv.zig");
+const res = @import("cuda_res.zig");
+const moe = @import("cuda_moe.zig");
+const head = @import("cuda_head.zig");
+const tp = @import("cuda_tp.zig");
+const xrows = @import("cuda_xrows.zig");
+const fuse = @import("cuda_fuse.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+
+/// The `Prepare` hooks of every group, run by the loader per layer.
+pub const prepare = [_]weights.Prepare{ attn.prepare, conv.prepare, res.prepare, moe.prepare, head.prepare };
+
+pub const Scope = union(enum) {
+    layer: u32,
+    model,
+
+    pub fn format(s: Scope, w: *std.Io.Writer) std.Io.Writer.Error!void {
+        switch (s) {
+            .layer => |l| try w.print("{d}", .{l}),
+            .model => try w.writeAll("model"),
+        }
+    }
+};
+
+pub const Dir = enum { in, out };
+
+/// One named tensor of an op. `whole`: not rows of the forward (a convolution state, gathered cache rows).
+pub const Tensor = struct {
+    name: []const u8,
+    m: Mat,
+    whole: bool = false,
+};
+
+pub const Hooks = struct {
+    ctx: ?*anyopaque = null,
+    /// --dump-ops: an op's input (before it runs) or output (after); `row0` is the forward's first row.
+    record: ?*const fn (ctx: *anyopaque, scope: Scope, op: []const u8, dir: Dir, t: Tensor, row0: usize) anyerror!void = null,
+    /// --feed: put torch's rows row0 .. row0 + R of this output in place; false when the capture has none.
+    feed: ?*const fn (ctx: *anyopaque, scope: Scope, op: []const u8, t: Tensor, row0: usize) anyerror!bool = null,
+    /// An op without a kernel passed with torch's outputs.
+    stub: ?*const fn (ctx: *anyopaque, scope: Scope, op: []const u8) anyerror!void = null,
+};
+
+/// The runner's --prof: stream time between marks, summed by layer and label. Each op's `before` marks its start, the
+/// scaffold's own copies and the rank sums mark theirs, and a span ends at the next mark (or at `end`), so the spans
+/// tile the stream's time from the first mark to `end` (launch gaps count to the span they fall in).
+pub const Prof = struct {
+    pub const max_marks = 2048;
+    pub const max_labels = 48;
+    /// Rows of `ms`: layers 0 .. 47, then the model ops.
+    pub const rows = 49;
+
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    events: [max_marks]?cuda.Event = @splat(null),
+    at: [max_marks][2]u32 = undefined,
+    n: usize = 0,
+    labels: [max_labels][]const u8 = undefined,
+    nlabels: usize = 0,
+    ms: [rows][max_labels]f64 = @splat(@splat(0)),
+    /// Spans ended (`end` calls with marks): forwards profiled since the last reset.
+    ends: usize = 0,
+
+    pub fn deinit(p: *Prof) void {
+        for (&p.events) |*e| if (e.*) |*x| x.deinit();
+    }
+
+    fn event(p: *Prof) !cuda.Event {
+        if (p.n >= max_marks) return error.ProfTooManyMarks;
+        if (p.events[p.n] == null) p.events[p.n] = try cuda.Event.init(p.d, true);
+        const e = p.events[p.n].?;
+        try e.record(p.stream);
+        return e;
+    }
+
+    pub fn mark(p: *Prof, scope: Scope, label: []const u8) !void {
+        const li = for (p.labels[0..p.nlabels], 0..) |x, i| {
+            if (std.mem.eql(u8, x, label)) break i;
+        } else blk: {
+            if (p.nlabels >= max_labels) return error.ProfTooManyLabels;
+            p.labels[p.nlabels] = label;
+            p.nlabels += 1;
+            break :blk p.nlabels - 1;
+        };
+        _ = try p.event();
+        p.at[p.n] = .{ switch (scope) {
+            .layer => |l| @min(l, rows - 1),
+            .model => rows - 1,
+        }, @intCast(li) };
+        p.n += 1;
+    }
+
+    /// Ends the last span, waits for the stream and adds the spans up.
+    pub fn end(p: *Prof) !void {
+        if (p.n == 0) return;
+        _ = try p.event();
+        try p.events[p.n].?.synchronize();
+        for (0..p.n) |i| {
+            const ms = try cuda.Event.elapsedMs(p.events[i].?, p.events[i + 1].?);
+            p.ms[p.at[i][0]][p.at[i][1]] += ms;
+        }
+        p.n = 0;
+        p.ends += 1;
+    }
+
+    pub fn reset(p: *Prof) void {
+        p.ms = @splat(@splat(0));
+        p.ends = 0;
+    }
+};
+
+/// An A/B of the fused ops in one process (tf-inkling2-decode --ab): forwards on this state run the unfused ops.
+pub var unfused_state: ?*const state.State = null;
+
+pub const Stop = struct {
+    scope: Scope,
+    op: []const u8,
+    err: anyerror,
+};
+
+/// One stream's rows of a forward (batched decode, cuda_engine.zig forwardMany): rows row0 .. row0 + rows of the
+/// forward, at positions pos0 .. pos0 + rows - 1 of that stream, whose state is `st`. `spec`: a verify window on a
+/// slot with drafts (each convolution commit keeps its inputs, cuda_state.zig convCommitSpec). `dev`: a captured
+/// forward (cuda_engine.zig graphStep) reads the segment's first position on the device (cuda_attn.zig Dev: the
+/// heads, the cache write and the attention core), so its graph replays at every position; pos0 is then the
+/// capture's.
+pub const Seg = struct {
+    st: *state.State,
+    pos0: usize,
+    row0: usize = 0,
+    rows: usize,
+    spec: bool = false,
+    dev: ?attn.Dev = null,
+};
+
+/// Segments a forward carries at most (the step header's room, cuda_engine.zig Header).
+pub const max_segs = 8;
+
+/// The prompt cache's mid-chunk capture (cuda_snap.zig forwardHook): called before each convolution commit with the
+/// state about to be committed and the rows committed into it; it copies what the state would be at a position
+/// inside the forward. Reads only; the forward's own bytes do not change.
+pub const Capture = struct {
+    ctx: *anyopaque,
+    conv: *const fn (ctx: *anyopaque, c: *const Ctx, conv_state: u64, x: Mat) anyerror!void,
+};
+
+pub const Forward = struct {
+    c: Ctx,
+    w: *const weights.Weights,
+    /// The forward's one stream (rows 0 .. R at pos0), unless `segs` is set.
+    st: *state.State,
+    a: *state.Act,
+    hooks: Hooks = .{},
+    stopped: ?Stop = null,
+    /// W > 1: the rank's two sums a layer (cuda_tp.zig); null at W = 1.
+    x: ?*const tp.Exchange = null,
+    /// A verify window on a slot with drafts: each convolution commit keeps its inputs (cuda_state.zig convCommitSpec).
+    spec: bool = false,
+    /// Several streams' rows in one forward (batched decode): the ops that read or write a stream's state (the
+    /// convolutions and their commits, the heads, the cache write, the attention core) run once a segment on its
+    /// rows; every other op runs once over all the forward's rows. Each op is row-invariant (a row's bits do not
+    /// depend on the forward's other rows), so each stream's rows get the bits of a forward of their own. Empty: the
+    /// one stream `st` (with `spec`). The hooks (--dump-ops, --feed) take one stream only.
+    segs: []const Seg = &.{},
+    /// Not 0: the embedding's token ids (i32, on the device) are read here instead of `a.tokens` (a captured forward
+    /// reads its tokens from the step header's device copy).
+    ids: u64 = 0,
+    /// The runner's --prof.
+    prof: ?*Prof = null,
+    /// Sums the exchange already left in a.ao / a.y as bf16 (cuda_xrows.zig), so the stage after skips its sum.
+    summed: [2]bool = .{ false, false },
+    /// The prompt cache's capture of states inside this forward (a one-stream prompt chunk; cuda_snap.zig).
+    capture: ?Capture = null,
+
+    fn commit(f: *Forward, spec: bool, conv_state: u64, hist: u64, x: Mat) !void {
+        if (f.capture) |cp| try cp.conv(cp.ctx, &f.c, conv_state, x);
+        if (spec and hist != 0) return state.convCommitSpec(&f.c, conv_state, hist, x);
+        return state.convCommit(&f.c, conv_state, x);
+    }
+
+    /// The forward's segments: `segs`, or the one stream's rows 0 .. R at pos0 (in `one`).
+    fn segments(f: *const Forward, R: usize, pos0: usize, one: *[1]Seg) ![]const Seg {
+        if (f.segs.len == 0) {
+            one[0] = .{ .st = f.st, .pos0 = pos0, .rows = R, .spec = f.spec };
+            return one;
+        }
+        if (f.hooks.record != null or f.hooks.feed != null) return error.SegmentsTakeNoHooks;
+        return f.segs;
+    }
+
+    fn mark(f: *Forward, scope: Scope, label: []const u8) !void {
+        if (f.prof) |p| try p.mark(scope, label);
+    }
+
+    /// Which stateless ops a call of R rows runs in cuda_fuse.zig's forms (TF_INK2_FUSE; by default the latency
+    /// forms up to fuse.lat_rows rows): never while the hooks look at or replace each op's tensors (--dump-ops,
+    /// --feed), which need the ops one by one, nor on `unfused_state`'s slot.
+    fn fuseMode(f: *const Forward, R: usize) fuse.Mode {
+        if (f.hooks.record != null or f.hooks.feed != null) return .none;
+        if (unfused_state) |u| if (u == f.st) return .none;
+        return f.c.k.fuse.mode.forRows(R);
+    }
+
+    fn before(f: *Forward, scope: Scope, op: []const u8, ins: []const Tensor, row0: usize) !void {
+        try f.mark(scope, op);
+        f.c.scratch.reset();
+        const rec = f.hooks.record orelse return;
+        try f.c.stream.synchronize();
+        for (ins) |t| if (t.m.rows > 0 and t.m.ptr != 0) try rec(f.hooks.ctx.?, scope, op, .in, t, row0);
+    }
+
+    fn after(f: *Forward, scope: Scope, op: []const u8, outs: []const Tensor, result: anyerror!void, row0: usize) !void {
+        var stub = false;
+        result catch |e| {
+            if (e != error.NotImplemented or f.hooks.feed == null) {
+                f.stopped = .{ .scope = scope, .op = op, .err = e };
+                return e;
+            }
+            stub = true;
+        };
+        if (stub) {
+            for (outs) |t| if (t.m.rows > 0 and t.m.ptr != 0 and !try f.hooks.feed.?(f.hooks.ctx.?, scope, op, t, row0)) {
+                std.log.err("inkling2: {f} {s} has no kernel and the capture has no {s} for it", .{ scope, op, t.name });
+                f.stopped = .{ .scope = scope, .op = op, .err = error.NotImplemented };
+                return error.NotImplemented;
+            };
+            if (f.hooks.stub) |s| try s(f.hooks.ctx.?, scope, op);
+            return;
+        }
+        if (f.hooks.record) |rec| {
+            try f.c.stream.synchronize();
+            for (outs) |t| if (t.m.rows > 0 and t.m.ptr != 0) try rec(f.hooks.ctx.?, scope, op, .out, t, row0);
+        }
+        if (f.hooks.feed) |feed| for (outs) |t| if (t.m.rows > 0 and t.m.ptr != 0) {
+            _ = try feed(f.hooks.ctx.?, scope, op, t, row0);
+        };
+    }
+
+    /// The blocks as op tensors block0 .. block<n-1>.
+    fn blockTensors(f: *Forward, R: usize, buf: *[state.max_blocks + 1]Tensor) []Tensor {
+        const names = [_][]const u8{ "block0", "block1", "block2", "block3", "block4", "block5", "block6", "block7" };
+        for (0..f.a.nblocks) |i| buf[i] = .{ .name = names[i], .m = f.a.block(i, R) };
+        return buf[0..f.a.nblocks];
+    }
+
+    /// head.embed: the normed embedding of the forward's token ids (already in `a.tokens`) into h[0].
+    pub fn embed(f: *Forward, R: usize, pos0: usize) !void {
+        const a = f.a;
+        const out = a.h[0].slice(0, R);
+        try f.before(.model, "head.embed", &.{.{ .name = "ids", .m = a.tokens.slice(0, R) }}, pos0);
+        try f.after(.model, "head.embed", &.{.{ .name = "e", .m = out }}, head.embed(&f.c, f.w, if (f.ids != 0) f.ids else a.tokens.ptr, a.y.slice(0, R), out), pos0);
+    }
+
+    /// head.embed with the table held by vocabulary rows over the ranks (cuda_embed.zig): every rank's rows of the
+    /// forward's token ids (already on every rank: `ids`, or `a.tokens`) gathered, picked and normed into h[0], the
+    /// bits `embed` gives on rank 0.
+    pub fn embedShared(f: *Forward, sh: *const @import("cuda_embed.zig").Shared, R: usize, pos0: usize) !void {
+        const a = f.a;
+        const out = a.h[0].slice(0, R);
+        try f.before(.model, "head.embed", &.{.{ .name = "ids", .m = a.tokens.slice(0, R) }}, pos0);
+        try f.after(.model, "head.embed", &.{.{ .name = "e", .m = out }}, sh.rows(&f.c, f.w, if (f.ids != 0) f.ids else a.tokens.ptr, a.y.slice(0, R), out), pos0);
+    }
+
+    /// Layer `li` over the forward's R rows: h[0] in, h[0] out (the buffers swap). At W > 1 the rank's partials are
+    /// gathered over its group between the stages (virtual ranks call the stages themselves, every rank's stage in
+    /// turn); split experts gather twice in the MoE (MoE-A after mlpStage, MoE-B after downStage).
+    pub fn layer(f: *Forward, li: u32, R: usize, pos0: usize) !void {
+        try f.attnStage(li, R, pos0);
+        if (f.x) |x| try f.exchange(x, .attn, li, R);
+        try f.mlpStage(li, R, pos0);
+        if (f.split()) {
+            try f.mark(.{ .layer = li }, "tp.split_h");
+            try f.x.?.gatherSplit(&f.c, .h, R);
+            try f.downStage(li, R, pos0);
+            try f.mark(.{ .layer = li }, "tp.split_y");
+            try f.x.?.gatherSplit(&f.c, .y, R);
+        } else if (f.x) |x| try f.exchange(x, .moe, li, R);
+        try f.outStage(li, R, pos0);
+    }
+
+    /// Split experts (the exchange has their buffers): the MoE runs in two halves around MoE-A.
+    pub fn split(f: *const Forward) bool {
+        return if (f.x) |x| x.split() != null else false;
+    }
+
+    /// Real ranks: sum `s`'s partials over the group, by rows for prompt chunks (cuda_xrows.zig: the sum's bf16 rows
+    /// land in a.ao / a.y, the same bits as the whole sum), else the whole all-gather (the next stage sums).
+    fn exchange(f: *Forward, x: *const tp.Exchange, s: tp.Sum, li: u32, R: usize) !void {
+        const out = if (s == .attn) f.a.ao else f.a.y;
+        if (xrows.applies(x, R, out.rows)) {
+            try f.mark(.{ .layer = li }, "tp.rows");
+            f.c.scratch.reset();
+            try xrows.sum(x, &f.c, s, R, out);
+            f.summed[@intFromEnum(s)] = true;
+            return;
+        }
+        try f.mark(.{ .layer = li }, "tp.gather");
+        try x.gather(&f.c, s, R);
+    }
+
+    /// Whether sum `s` still has to run in the stage (and clears the exchange's note).
+    fn unsummed(f: *Forward, s: tp.Sum) bool {
+        const done = f.summed[@intFromEnum(s)];
+        f.summed[@intFromEnum(s)] = false;
+        return !done;
+    }
+
+    /// The layer up to the output projection: ao bf16 at W = 1, else the rank's fp32 partial (its heads).
+    pub fn attnStage(f: *Forward, li: u32, R: usize, pos0: usize) !void {
+        const l = f.w.layer(li);
+        const a = f.a;
+        const c = &f.c;
+        const s: Scope = .{ .layer = li };
+        const h_in = a.h[0].slice(0, R);
+        var bt: [state.max_blocks + 1]Tensor = undefined;
+        var ins: [16]Tensor = undefined;
+        // attention input (L1) and its norms (L2)
+        var src: [3]Mat = .{ h_in, h_in, h_in };
+        const norm_ops = if (l.global) [3][]const u8{ "res.q_norm", "res.k_norm", "res.v_norm" } else [3][]const u8{ "res.attn_norm", "", "" };
+        const sources: usize = if (l.global) 3 else 1;
+        const xn = [3]Mat{ a.xn[0].slice(0, R), a.xn[1].slice(0, R), a.xn[2].slice(0, R) };
+        const fuse_in = l.nq > 0 and f.fuseMode(R).attnIn();
+        if (fuse_in) {
+            // res.attn_input and its norms as one launch
+            const xs = [3]Mat{ a.x[0].slice(0, R), a.x[1].slice(0, R), a.x[2].slice(0, R) };
+            try f.mark(s, "fuse.attn_in");
+            c.scratch.reset();
+            try fuse.attnIn(c, a.blockView(R), h_in, l.attn_query, l.nq, xs[0..l.nq], l.in_norm[0..sources], xn[0..sources]);
+        } else if (l.nq > 0) {
+            const xs = [3]Mat{ a.x[0].slice(0, R), a.x[1].slice(0, R), a.x[2].slice(0, R) };
+            const xt = [3]Tensor{ .{ .name = "x0", .m = xs[0] }, .{ .name = "x1", .m = xs[1] }, .{ .name = "x2", .m = xs[2] } };
+            const blocks = f.blockTensors(R, &bt);
+            @memcpy(ins[0..blocks.len], blocks);
+            ins[blocks.len] = .{ .name = "cand", .m = h_in };
+            try f.before(s, "res.attn_input", ins[0 .. blocks.len + 1], pos0);
+            try f.after(s, "res.attn_input", xt[0..l.nq], res.mix(c, a.blockView(R), h_in, l.attn_query, l.nq, xs[0..l.nq]), pos0);
+            src = if (l.nq == 1) .{ xs[0], xs[0], xs[0] } else xs;
+        }
+        if (!fuse_in) for (0..sources) |j| {
+            try f.before(s, norm_ops[j], &.{.{ .name = "x", .m = src[j] }}, pos0);
+            try f.after(s, norm_ops[j], &.{.{ .name = "y", .m = xn[j] }}, res.norm(c, src[j], l.in_norm[j], xn[j]), pos0);
+        };
+        const xq = xn[0];
+        const xk = if (l.global) xn[1] else xn[0];
+        const xv = if (l.global) xn[2] else xn[0];
+        // projections (L3)
+        const p: attn.Proj = .{
+            .q = a.q.slice(0, R),
+            .k = a.k.slice(0, R),
+            .v = a.v.slice(0, R),
+            .rel = a.rel.slice(0, R),
+            .gate = a.gate.slice(0, R),
+            .sink = a.sink.slice(0, R),
+            .dk = if (l.global) a.dk.slice(0, R) else .{},
+            .dv = if (l.global) a.dv.slice(0, R) else .{},
+        };
+        if (l.global) {
+            try f.before(s, "attn.project", &.{ .{ .name = "xq", .m = xq }, .{ .name = "xk", .m = xk }, .{ .name = "xv", .m = xv } }, pos0);
+        } else try f.before(s, "attn.project", &.{.{ .name = "x", .m = xq }}, pos0);
+        try f.after(s, "attn.project", &.{
+            .{ .name = "q", .m = p.q },       .{ .name = "k", .m = p.k },       .{ .name = "v", .m = p.v },
+            .{ .name = "rel", .m = p.rel },   .{ .name = "gate", .m = p.gate }, .{ .name = "sink", .m = p.sink },
+            .{ .name = "dk", .m = p.dk },     .{ .name = "dv", .m = p.dv },
+        }, attn.project(c, l, xq, xk, xv, p), pos0);
+        // K and V convolutions (L4), the stream's state a segment
+        var one: [1]Seg = undefined;
+        const segs = try f.segments(R, pos0, &one);
+        const st = segs[0].st.layer(li);
+        const kvc = l.hk * weights.head_dim;
+        const kc = a.kc.slice(0, R);
+        const vc = a.vc.slice(0, R);
+        try f.before(s, "conv.kv", &.{
+            .{ .name = "k", .m = p.k },
+            .{ .name = "v", .m = p.v },
+            .{ .name = "dk", .m = p.dk },
+            .{ .name = "dv", .m = p.dv },
+            .{ .name = "state_k", .m = Mat.of(st.conv_k, conv.state_rows, kvc, .bf16), .whole = true },
+            .{ .name = "state_v", .m = Mat.of(st.conv_v, conv.state_rows, kvc, .bf16), .whole = true },
+        }, pos0);
+        try f.after(s, "conv.kv", &.{ .{ .name = "kc", .m = kc }, .{ .name = "vc", .m = vc } }, convKv(c, l, li, segs, p, kc, vc), pos0);
+        try f.mark(s, "state.conv");
+        for (segs) |g| {
+            const gs = g.st.layer(li);
+            try f.commit(g.spec, gs.conv_k, gs.hist[0], p.k.slice(g.row0, g.rows));
+            try f.commit(g.spec, gs.conv_v, gs.hist[1], p.v.slice(g.row0, g.rows));
+        }
+        // heads (L5-L9) and the cache write (L11)
+        const hd: attn.Heads = .{ .q = a.qh.slice(0, R), .k = a.kh.slice(0, R), .v = a.vh.slice(0, R), .rel = a.relh.slice(0, R) };
+        try f.before(s, "attn.heads", &.{ .{ .name = "q", .m = p.q }, .{ .name = "kc", .m = kc }, .{ .name = "vc", .m = vc }, .{ .name = "rel", .m = p.rel } }, pos0);
+        try f.after(s, "attn.heads", &.{ .{ .name = "q", .m = hd.q }, .{ .name = "k", .m = hd.k }, .{ .name = "v", .m = hd.v }, .{ .name = "rel", .m = hd.rel } }, heads(c, l, segs, p.q, kc, vc, p.rel, hd), pos0);
+        try f.mark(s, "state.kv");
+        for (segs) |g| try state.kvWrite(c, g.st.kvFor(li, g.rows), g.pos0, g.dev, hd.k.slice(g.row0, g.rows), hd.v.slice(g.row0, g.rows));
+        // attention (L10, L12-L14)
+        const o = a.o.slice(0, R);
+        {
+            var n: usize = 4;
+            ins[0..4].* = .{ .{ .name = "q", .m = hd.q }, .{ .name = "rel", .m = hd.rel }, .{ .name = "sink", .m = p.sink }, .{ .name = "gate", .m = p.gate } };
+            if (f.hooks.record != null) {
+                const lo = st.kv.lo(pos0);
+                const ctx_rows = pos0 + R - lo;
+                const kx = Mat.of(try c.tmp(ctx_rows * kvc * 2), ctx_rows, kvc, .bf16);
+                const vx = Mat.of(try c.tmp(ctx_rows * kvc * 2), ctx_rows, kvc, .bf16);
+                try state.kvGather(c, st.kv, f.st.ids, lo, pos0 + R, kx, vx);
+                ins[4] = .{ .name = "k_ctx", .m = kx, .whole = true };
+                ins[5] = .{ .name = "v_ctx", .m = vx, .whole = true };
+                n = 6;
+            }
+            try f.before(s, "attn.core", ins[0..n], pos0);
+        }
+        try f.after(s, "attn.core", &.{.{ .name = "o", .m = o }}, core(c, l, li, segs, hd.q, hd.rel, p.sink, p.gate, o), pos0);
+        // output projection (L15)
+        const ao = if (f.x) |x| x.mine(.attn, R) else a.ao.slice(0, R);
+        try f.before(s, "attn.out", &.{.{ .name = "o", .m = o }}, pos0);
+        try f.after(s, "attn.out", &.{.{ .name = "ao", .m = ao }}, attn.output(c, l, o, ao), pos0);
+    }
+
+    /// From the attention sum (W > 1) to the experts: y bf16 at W = 1, else the rank's fp32 partial (its experts).
+    pub fn mlpStage(f: *Forward, li: u32, R: usize, pos0: usize) !void {
+        const l = f.w.layer(li);
+        const a = f.a;
+        const c = &f.c;
+        const s: Scope = .{ .layer = li };
+        const h_in = a.h[0].slice(0, R);
+        const ao = a.ao.slice(0, R);
+        if (f.x) |x| if (f.unsummed(.attn)) {
+            try f.mark(s, "tp.sum");
+            c.scratch.reset();
+            try x.sum(c, .attn, ao);
+        };
+        // the post-attention conv (L16)
+        var one: [1]Seg = undefined;
+        const segs = try f.segments(R, pos0, &one);
+        const st = segs[0].st.layer(li);
+        const ac = a.a.slice(0, R);
+        try f.before(s, "conv.attn", &.{ .{ .name = "x", .m = ao }, .{ .name = "state", .m = Mat.of(st.conv_attn, conv.state_rows, H, .bf16), .whole = true } }, pos0);
+        try f.after(s, "conv.attn", &.{.{ .name = "y", .m = ac }}, convPost(c, li, segs, l.attn_conv, ao, .attn, ac), pos0);
+        try f.mark(s, "state.conv");
+        for (segs) |g| {
+            const gs = g.st.layer(li);
+            try f.commit(g.spec, gs.conv_attn, gs.hist[2], ao.slice(g.row0, g.rows));
+        }
+        // the block partial (L17), the MLP input (L18) and its norm
+        const part = a.partial.slice(0, R);
+        const mx = a.mx.slice(0, R);
+        const m = a.m.slice(0, R);
+        const ids = a.ids.slice(0, R);
+        const wts = a.wts.slice(0, R);
+        const lg = a.logits.slice(0, R);
+        const fm = f.fuseMode(R);
+        if (fm.mlpIn()) {
+            // res.partial, the boundary push, res.mlp_input and res.mlp_norm as one launch
+            try f.mark(s, "fuse.mlp_in");
+            c.scratch.reset();
+            if (l.boundary and a.nblocks >= state.max_blocks) return error.TooManyBlocks;
+            const push = if (l.boundary) a.block(a.nblocks, R).ptr else 0;
+            try fuse.mlpIn(c, h_in, ac, l.boundary, part, a.blockView(R), push, l.mlp_query, mx, l.mlp_norm, m);
+            if (l.boundary) a.nblocks += 1;
+        } else try f.mlpInput(li, R, pos0, h_in, ac, part, mx, m);
+        if (fm.router()) {
+            // the router: its logits, then select and the slot order as one launch
+            try f.mark(s, "fuse.route");
+            c.scratch.reset();
+            try fuse.route(c, l, m, ids, wts, lg);
+        } else {
+            // router (L19)
+            try f.before(s, "moe.route", &.{.{ .name = "m", .m = m }}, pos0);
+            try f.after(s, "moe.route", &.{ .{ .name = "ids", .m = ids }, .{ .name = "w", .m = wts }, .{ .name = "logits", .m = lg } }, moe.route(c, l, m, ids, wts, lg), pos0);
+        }
+        try f.before(s, "moe.experts", &.{ .{ .name = "m", .m = m }, .{ .name = "ids", .m = ids }, .{ .name = "w", .m = wts } }, pos0);
+        if (f.split()) {
+            const x = f.x.?;
+            const hm = Mat.of(x.hMine(R), R * moe.topk, moe.intermediate / x.world, .bf16);
+            return f.after(s, "moe.experts", &.{.{ .name = "h", .m = hm }}, moe.splitUp(c, l, m, ids, wts, hm.ptr, x.split().?.plan, null), pos0);
+        }
+        const y = if (f.x) |x| x.mine(.moe, R) else a.y.slice(0, R);
+        try f.after(s, "moe.experts", &.{.{ .name = "y", .m = y }}, moe.experts(c, l, m, ids, wts, y), pos0);
+    }
+
+    /// The unfused ops from the partial to the router's input: res.partial, the boundary push, res.mlp_input,
+    /// res.mlp_norm.
+    fn mlpInput(f: *Forward, li: u32, R: usize, pos0: usize, h_in: Mat, ac: Mat, part: Mat, mx: Mat, m: Mat) !void {
+        const l = f.w.layer(li);
+        const a = f.a;
+        const c = &f.c;
+        const s: Scope = .{ .layer = li };
+        var bt: [state.max_blocks + 1]Tensor = undefined;
+        var ins: [16]Tensor = undefined;
+        try f.before(s, "res.partial", &.{ .{ .name = "h_in", .m = h_in }, .{ .name = "a", .m = ac } }, pos0);
+        try f.after(s, "res.partial", &.{.{ .name = "partial", .m = part }}, res.partial(c, h_in, ac, l.boundary, part), pos0);
+        if (l.boundary) {
+            try f.mark(s, "state.block");
+            try state.pushBlock(c, a, h_in);
+        }
+        // MLP input (L18)
+        {
+            const blocks = f.blockTensors(R, &bt);
+            @memcpy(ins[0..blocks.len], blocks);
+            ins[blocks.len] = .{ .name = "cand", .m = part };
+            try f.before(s, "res.mlp_input", ins[0 .. blocks.len + 1], pos0);
+            try f.after(s, "res.mlp_input", &.{.{ .name = "x", .m = mx }}, res.mix(c, a.blockView(R), part, l.mlp_query, 1, &.{mx}), pos0);
+        }
+        try f.before(s, "res.mlp_norm", &.{.{ .name = "x", .m = mx }}, pos0);
+        try f.after(s, "res.mlp_norm", &.{.{ .name = "y", .m = m }}, res.norm(c, mx, l.mlp_norm, m), pos0);
+    }
+
+    /// Split experts, after MoE-A: the rank's output columns of y from every rank's h (cuda_moe.zig splitDown).
+    pub fn downStage(f: *Forward, li: u32, R: usize, pos0: usize) !void {
+        const x = f.x orelse return error.NotSplitExperts;
+        const sp = x.split() orelse return error.NotSplitExperts;
+        const l = f.w.layer(li);
+        const s: Scope = .{ .layer = li };
+        const ym = Mat.of(x.yMine(R), R, H / x.world, .bf16);
+        try f.before(s, "moe.down", &.{}, pos0);
+        try f.after(s, "moe.down", &.{.{ .name = "y", .m = ym }}, moe.splitDown(&f.c, l, R, sp.h, sp.plan, ym.ptr, null), pos0);
+    }
+
+    /// From the MoE sum (W > 1) to the layer's output in h[0].
+    pub fn outStage(f: *Forward, li: u32, R: usize, pos0: usize) !void {
+        const l = f.w.layer(li);
+        const a = f.a;
+        const c = &f.c;
+        const s: Scope = .{ .layer = li };
+        const h_out = a.h[1].slice(0, R);
+        const part = a.partial.slice(0, R);
+        // split experts: MoE-B's [W][R][H/W] laid out as rows; one row is already [1][H], read in place
+        const in_place = if (f.x) |x| x.split() != null and R == 1 else false;
+        const y = if (in_place) Mat.of(f.x.?.split().?.y, 1, H, .bf16) else a.y.slice(0, R);
+        if (f.x) |x| if (!in_place and (x.split() != null or f.unsummed(.moe))) {
+            try f.mark(s, "tp.sum");
+            c.scratch.reset();
+            if (x.split() != null) try x.columns(c, y) else try x.sum(c, .moe, y);
+        };
+        // post-MLP conv (L21) and the layer's output (L22)
+        var one: [1]Seg = undefined;
+        const segs = try f.segments(R, pos0, &one);
+        const st = segs[0].st.layer(li);
+        const cm = a.cm.slice(0, R);
+        try f.before(s, "conv.mlp", &.{ .{ .name = "x", .m = y }, .{ .name = "state", .m = Mat.of(st.conv_mlp, conv.state_rows, H, .bf16), .whole = true } }, pos0);
+        try f.after(s, "conv.mlp", &.{.{ .name = "y", .m = cm }}, convPost(c, li, segs, l.mlp_conv, y, .mlp, cm), pos0);
+        try f.mark(s, "state.conv");
+        for (segs) |g| {
+            const gs = g.st.layer(li);
+            try f.commit(g.spec, gs.conv_mlp, gs.hist[3], y.slice(g.row0, g.rows));
+        }
+        try f.before(s, "res.output", &.{ .{ .name = "partial", .m = part }, .{ .name = "mconv", .m = cm } }, pos0);
+        try f.after(s, "res.output", &.{.{ .name = "h", .m = h_out }}, res.output(c, part, cm, h_out), pos0);
+        std.mem.swap(Mat, &a.h[0], &a.h[1]);
+    }
+
+    /// res.final_input and head.final_norm over the forward's rows: the final rows bf16 [R, H] (in a.xn[0]).
+    pub fn final(f: *Forward, R: usize, pos0: usize) !Mat {
+        const a = f.a;
+        const c = &f.c;
+        if (a.nblocks != state.max_blocks) return error.FinalNeedsEveryBlock;
+        var bt: [state.max_blocks + 1]Tensor = undefined;
+        var ins: [state.max_blocks + 1]Tensor = undefined;
+        const blocks = f.blockTensors(R, &bt);
+        @memcpy(ins[0..blocks.len], blocks);
+        const h = a.h[0].slice(0, R);
+        ins[blocks.len] = .{ .name = "cand", .m = h };
+        const x = a.x[0].slice(0, R);
+        try f.before(.model, "res.final_input", ins[0 .. blocks.len + 1], pos0);
+        try f.after(.model, "res.final_input", &.{.{ .name = "x", .m = x }}, res.mix(c, a.blockView(R), h, f.w.output_query, 1, &.{x}), pos0);
+        const y = a.xn[0].slice(0, R);
+        try f.before(.model, "head.final_norm", &.{.{ .name = "x", .m = x }}, pos0);
+        try f.after(.model, "head.final_norm", &.{.{ .name = "y", .m = y }}, head.finalNorm(c, f.w, x, y), pos0);
+        return y;
+    }
+
+    /// head.unembed of `rows` (final rows, bf16 [n, H]) over rank `rank`'s share of the vocabulary: bf16 logits
+    /// into its block of `parts` ([world][n][share], an all-gather's rank order; at W = 1 simply [n, vocab]);
+    /// `row0` numbers these rows for the hooks (the runner's selection).
+    pub fn unembedShare(f: *Forward, rows: Mat, parts: u64, rank: u32, row0: usize) !void {
+        const n = rows.rows;
+        const share: usize = f.w.vocab_rows.len();
+        const lg = Mat.of(parts + @as(u64, rank) * n * share * 2, n, share, .bf16);
+        try f.before(.model, "head.unembed", &.{.{ .name = "y", .m = rows }}, row0);
+        try f.after(.model, "head.unembed", &.{.{ .name = "logits", .m = lg }}, head.unembed(&f.c, f.w, rows, lg), row0);
+    }
+
+    /// head.softcap over every rank's gathered share (`parts`, see unembedShare): `out` fp32 [n, unpadded]. The
+    /// hooks see the bf16 logits as one tensor at W = 1 only.
+    pub fn softcapShares(f: *Forward, parts: u64, world: u32, out: Mat, row0: usize) !void {
+        const n = out.rows;
+        const share: usize = f.w.vocab_rows.len();
+        const whole: []const Tensor = &.{.{ .name = "logits", .m = Mat.of(parts, n, share, .bf16) }};
+        try f.before(.model, "head.softcap", if (world == 1) whole else &.{}, row0);
+        try f.after(.model, "head.softcap", &.{.{ .name = "out", .m = out }}, head.softcapParts(&f.c, parts, world, share, out), row0);
+    }
+};
+
+/// conv.kv a segment: each stream's K and V rows against its own convolution states.
+fn convKv(c: *const Ctx, l: *const weights.Layer, li: u32, segs: []const Seg, p: attn.Proj, kc: Mat, vc: Mat) !void {
+    for (segs) |g| {
+        const gs = g.st.layer(li);
+        const dk = if (l.global) p.dk.slice(g.row0, g.rows) else p.dk;
+        const dv = if (l.global) p.dv.slice(g.row0, g.rows) else p.dv;
+        try conv.kv(c, l, p.k.slice(g.row0, g.rows), p.v.slice(g.row0, g.rows), dk, dv, gs.conv_k, gs.conv_v, kc.slice(g.row0, g.rows), vc.slice(g.row0, g.rows));
+    }
+}
+
+/// conv.attn / conv.mlp a segment, against each stream's own state.
+fn convPost(c: *const Ctx, li: u32, segs: []const Seg, taps: u64, x: Mat, which: enum { attn, mlp }, out: Mat) !void {
+    for (segs) |g| {
+        const gs = g.st.layer(li);
+        try conv.post(c, taps, x.slice(g.row0, g.rows), if (which == .attn) gs.conv_attn else gs.conv_mlp, out.slice(g.row0, g.rows));
+    }
+}
+
+/// attn.heads a segment (the global layers' tau reads each row's position).
+fn heads(c: *const Ctx, l: *const weights.Layer, segs: []const Seg, q: Mat, kc: Mat, vc: Mat, rel: Mat, out: attn.Heads) !void {
+    for (segs) |g| {
+        const r = g.row0;
+        const n = g.rows;
+        try attn.heads(c, l, g.pos0, g.dev, q.slice(r, n), kc.slice(r, n), vc.slice(r, n), rel.slice(r, n), .{ .q = out.q.slice(r, n), .k = out.k.slice(r, n), .v = out.v.slice(r, n), .rel = out.rel.slice(r, n) });
+    }
+}
+
+/// attn.core a segment, over each stream's own keys and values.
+fn core(c: *const Ctx, l: *const weights.Layer, li: u32, segs: []const Seg, q: Mat, rel: Mat, sink: Mat, gate: Mat, out: Mat) !void {
+    for (segs) |g| {
+        const r = g.row0;
+        const n = g.rows;
+        // each segment's split scratch from the start: the launches are stream-ordered (in a graph too), so a
+        // segment reuses the bytes the one before it is done with, and attn.checkScratch's one-forward need holds
+        c.scratch.reset();
+        try attn.core(c, l, g.pos0, g.dev, q.slice(r, n), rel.slice(r, n), sink.slice(r, n), gate.slice(r, n), g.st.kvFor(li, g.rows), out.slice(r, n));
+    }
+}
+
+/// The completed blocks entering layer `l` (the boundaries 0, 6, ... below it).
+pub fn blocksBefore(l: u32) usize {
+    return (l + 5) / 6;
+}
+
+test {
+    _ = xrows;
+}
+
+test "inkling2 cuda forward: blocks entering each layer" {
+    try std.testing.expectEqual(@as(usize, 0), blocksBefore(0));
+    try std.testing.expectEqual(@as(usize, 1), blocksBefore(1));
+    try std.testing.expectEqual(@as(usize, 1), blocksBefore(6));
+    try std.testing.expectEqual(@as(usize, 2), blocksBefore(7));
+    try std.testing.expectEqual(@as(usize, 8), blocksBefore(47));
+    try std.testing.expectEqual(@as(usize, 8), blocksBefore(48));
+}
diff --git a/zig/src/families/inkling2/cuda_mem_check.zig b/zig/src/families/inkling2/cuda_mem_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..32e3e6101a770fc4a11d1040f54280c9d522de27
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_mem_check.zig
@@ -0,0 +1,105 @@
+//! tf-inkling2-decode --exp scratch (rank 0; every rank runs the forwards): the op scratch each kind of forward takes,
+//! measured (cuda_ops.zig Scratch's high-water mark over the forward) against cuda_scratch.zig's `need` for it, which
+//! must hold it. Forwards: on a fresh slot a prompt chunk of up to prompt_rows rows (two when the slot holds them), then
+//! on that slot and on the deepest slot so far (after a --depths check: at the last depth) eager forwards of 1, 2, 4,
+//! 8, 16 and 64 rows, captured steps of 1 and 8 rows (measured when the forward is captured; a replay takes nothing),
+//! and one batched forward of 8 rows a slot over up to four slots. Each forward moves its slots on; run it last.
+const std = @import("std");
+const engine = @import("cuda_engine.zig");
+const follow = @import("cuda_follow.zig");
+const scratch = @import("cuda_scratch.zig");
+const ops = @import("cuda_ops.zig");
+
+const mib = ops.mib;
+
+pub fn run(gpa: std.mem.Allocator, x0: follow.Leader, seq: []const u32) !bool {
+    const e = x0.e;
+    var x = x0;
+    const cap = e.capacity();
+    const ids = try gpa.alloc(u32, engine.prompt_rows);
+    defer gpa.free(ids);
+    for (ids, 0..) |*t, i| t.* = seq[i % seq.len];
+    // the deepest slot so far, and a fresh one
+    var deep: ?u32 = null;
+    for (e.slots.items, 0..) |s, i| if (s != null and e.pos(@intCast(i)) > 0) {
+        if (deep == null or e.pos(@intCast(i)) > e.pos(deep.?)) deep = @intCast(i);
+    };
+    const fresh: u32 = @intCast(e.slots.items.len);
+    const sn = scratch.startupNeed(&e.k, &e.w, cap, engine.prompt_rows, engine.graph_seg_rows);
+    std.debug.print("scratch: {d} MiB held; start-up need at {d} positions a slot {d:.1} MiB (attention core {d:.1}, other ops {d:.1})\n", .{ e.scratch.buf.len >> 20, cap, mib(sn.total), mib(sn.core), mib(sn.other) });
+    var ok = true;
+    var n: usize = 0;
+    // a prompt chunk (two when they fit, so the second's attention spans the first)
+    var at: usize = 0;
+    for (0..2) |_| {
+        const R = @min(engine.prompt_rows, cap -| (at + 200));
+        if (R < 64) break;
+        ok = try one(&x, fresh, at, ids[0..R], false, &n) and ok;
+        at += R;
+    }
+    var slots_buf: [2]u32 = undefined;
+    var ns: usize = 0;
+    if (deep) |d| if (d != fresh) {
+        slots_buf[ns] = d;
+        ns += 1;
+    };
+    if (e.pos(fresh) > 0) {
+        slots_buf[ns] = fresh;
+        ns += 1;
+    }
+    for (slots_buf[0..ns]) |s| {
+        for ([_]usize{ 1, 2, 4, 8, 16, 64 }) |R| ok = try one(&x, s, e.pos(s), ids[0..R], false, &n) and ok;
+        for ([_]usize{ 1, 8 }) |R| ok = try one(&x, s, e.pos(s), ids[0..R], true, &n) and ok;
+    }
+    // batched: 8 rows a slot over up to four slots past their prompts
+    {
+        var segs: [4]engine.Segment = undefined;
+        var parts: [4]scratch.Part = undefined;
+        var k: usize = 0;
+        for (e.slots.items, 0..) |s, i| {
+            if (k == segs.len) break;
+            const p = e.pos(@intCast(i));
+            if (s == null or p == 0 or p + 8 > cap) continue;
+            segs[k] = .{ .slot = @intCast(i), .pos0 = p, .rows = 8 };
+            parts[k] = .{ .pos0 = p, .rows = 8 };
+            k += 1;
+        }
+        if (k >= 2) {
+            const need = scratch.need(&e.k, &e.w, parts[0..k]);
+            e.scratch.peak = 0;
+            e.scratch.kind = .batched;
+            try x.forwardMany(segs[0..k], ids[0 .. 8 * k], null);
+            ok = report("batched", segs[0].slot, segs[0].pos0, 8 * k, false, e.scratch.peak, need, &n) and ok;
+            e.scratch.kind = .other;
+        }
+    }
+    e.scratch.report(0);
+    std.debug.print("{s} scratch: {d} forwards, each measured peak within cuda_scratch.need\n", .{ if (ok) "PASS" else "FAIL", n });
+    return ok;
+}
+
+fn one(x: *follow.Leader, slot: u32, pos0: usize, ids: []const u32, graph: bool, n: *usize) !bool {
+    const e = x.e;
+    if (pos0 + ids.len > e.capacity()) return true;
+    const part: [1]scratch.Part = .{.{ .pos0 = pos0, .rows = ids.len, .positions = if (graph) e.capacity() else 0 }};
+    const need = scratch.need(&e.k, &e.w, &part);
+    const captured = e.counts.captured;
+    e.scratch.peak = 0;
+    e.scratch.kind = scratch.kindOf(&part);
+    defer e.scratch.kind = .other;
+    x.eager = !graph;
+    defer x.eager = false;
+    try x.forward(slot, pos0, ids, if (graph) .{ .lo = 0, .n = ids.len } else null);
+    if (graph and e.counts.captured == captured) {
+        std.debug.print("  graph slot {d} pos {d} rows {d}: replayed (no takes); need {d:.2} MiB\n", .{ slot, pos0, ids.len, mib(need) });
+        return true;
+    }
+    return report(@tagName(scratch.kindOf(&part)), slot, pos0, ids.len, graph, e.scratch.peak, need, n);
+}
+
+fn report(kind: []const u8, slot: u32, pos0: usize, R: usize, graph: bool, peak: usize, need: usize, n: *usize) bool {
+    n.* += 1;
+    const ok = peak <= need;
+    std.debug.print("  {s} {s} slot {d} pos {d} rows {d}: measured {d:.2} MiB, need {d:.2} MiB{s}\n", .{ if (graph) "graph" else "eager", kind, slot, pos0, R, mib(peak), mib(need), if (!ok) " SHORT" else if (peak == need) " (equal)" else "" });
+    return ok;
+}
diff --git a/zig/src/families/inkling2/cuda_native.zig b/zig/src/families/inkling2/cuda_native.zig
new file mode 100644
index 0000000000000000000000000000000000000000..ec042ffc643f824b963960f7d7c45afcef91a11d
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_native.zig
@@ -0,0 +1,670 @@
+//! Inkling-2-Small behind the native CUDA registry (native/cuda.zig), `full` mode: `tensorfold-native serve MODEL
+//! --backend cuda [--tp W --rank R]`. Rank 0 serves HTTP; ranks 1 .. W-1 (the same command with --rank R) load
+//! their share, then run rank 0's forwards until it ends (cuda_follow.zig) and exit. The ranks meet over NCCL at
+//! NCCL_COMM_ID (rank 0's address:port; from --master/--master-port when unset).
+//! TF_INK2_LAYERS=N serves only layers [0, N) (debug; the same N on every rank).
+//! TF_INK2_MODE and TF_INK2_DIGESTS (cuda_engine.zig): the experts' mode and the content-digest manifest, the same
+//! on every rank. TF_INK2_DSPARK=1 loads the checkpoint's DSpark drafter split over the ranks (the same on every rank;
+//! TF_INK2_DSPARK_FOLD names its head folds).
+//! Streams: --context sets how many run at once (`count`). After every rank's load, rank 0 gathers each rank's room
+//! (the server's reading after the reserve; the weights, the drafter and the op scratch are in already) and its bytes
+//! a stream at --context (the drafter's caches counted when it is loaded); `--parallel auto` (the server's default)
+//! serves as many streams as fit on every rank beside the prompt cache (--prompt-cache-gib, one arena a rank) and the
+//! graph cache's reserve for that many streams (`graphBytes`), at most TF_INK2_MAX_STREAMS (rank 0's; 1 .. 8, default
+//! 8: the most the exact gates ran at once; the recipe sets 4). None fits: the server refuses to start and names the
+//! largest context that does. `--parallel N` serves N (the cap does not apply), refused when they do not fit. Every rank makes the slots' states after the count (`reserve`, from rank 0's number).
+const std = @import("std");
+const cuda = @import("cuda");
+const lanes = @import("lanes");
+const ink = @import("inkling2");
+const ic = @import("inkling2_cuda");
+const ink_lanes = @import("cuda_lanes.zig");
+
+const engine = ic.engine;
+
+pub const model_type = ink.config.model_type;
+pub const formats: []const []const u8 = &.{"inkling2"};
+pub const default_context: i64 = 32768;
+pub const max_segments: u32 = 1;
+pub const prompt_rows: u32 = engine.prompt_rows;
+pub const explains_open = true;
+/// Positions a slot holds past --context: a request of --context tokens in all (prompt plus max_tokens) fits.
+const context_slack = 16;
+pub const takes_drafter = false;
+pub const drafter_refusal = "--drafter: Inkling-2 on CUDA serves plain decode so far (its DSpark head is not built yet)";
+
+/// The server's reading of this rank's room after its load; null if unreadable.
+pub const Room = struct { ctx: *anyopaque, read: *const fn (*anyopaque) ?u64 };
+pub const Options = struct {
+    context: usize,
+    drafts: bool,
+    segments: usize = 1,
+    slide: bool = false,
+    room: ?Room = null,
+    tp: u32 = 1,
+    rank: u32 = 0,
+    master: ?[]const u8 = null,
+    master_port: u16 = 29551,
+    /// What --parallel and --prompt-cache-gib ask (native/cuda_options.zig): `count`'s inputs.
+    streams_asked: Asked = .{},
+};
+
+/// --parallel's count (`fixed`: a number, else auto up to `n`) and --prompt-cache-gib (null: not given).
+pub const Asked = struct { n: u32 = most_streams, fixed: bool = false, cache_gib: ?f64 = null };
+
+/// Streams `--parallel auto` serves at most: the most the exact gates have run at once (and the step header's
+/// segments, a batched forward's streams).
+pub const most_streams: u32 = @min(8, engine.max_segs);
+
+/// TF_INK2_MAX_STREAMS (rank 0): the cap on `--parallel auto`'s count, 1 .. most_streams; unset: most_streams.
+fn maxStreams() !u32 {
+    const v = std.mem.span(std.c.getenv("TF_INK2_MAX_STREAMS") orelse return most_streams);
+    return parseMaxStreams(v) orelse error.BadMaxStreams;
+}
+
+fn parseMaxStreams(v: []const u8) ?u32 {
+    const n = std.fmt.parseInt(u32, std.mem.trim(u8, v, " "), 10) catch return null;
+    return if (n >= 1 and n <= most_streams) n else null;
+}
+
+/// The smallest room of ranks 1 .. W-1, in rank 0's stream bytes, and its rank.
+pub const Peer = struct { bytes: u64, rank: usize };
+
+pub const Loaded = struct {
+    backend: lanes.backend.Backend,
+    facts: lanes.Model,
+    rows: u32,
+    stream_bytes: usize,
+    /// No stream's state exists before `reserve` makes the admitted ones on every rank.
+    free_streams: u32 = 0,
+    ctx: *anyopaque,
+    deinit: *const fn (*anyopaque) void,
+    /// The server's admitted streams: their states on every rank, made once.
+    reserve: *const fn (*anyopaque, u32) anyerror!void,
+    /// Rank 0: the server admits streams by this when it is smaller than rank 0's own room.
+    peer_room: ?Peer = null,
+    /// The checkpoint's own draft head when loaded (TF_INK2_DSPARK=1): "DSpark".
+    draft_kind: ?[]const u8 = null,
+    /// The prompt cache keeps this rank group's states (snap_*).
+    target: *anyopaque,
+    /// Rank 0: the streams `count` found at --context (the server serves exactly these; null: no room reading).
+    streams: ?u32 = null,
+    /// On the KV page pool: the lane host admits a request only when its pages fit (`fits`).
+    admits: bool = false,
+};
+
+/// --context's ceiling: the checkpoint's model_max_length (1,048,576), so --context 0 serves it and a larger one is
+/// refused by name (the text config names no max_position_embeddings, which the server reads otherwise). An
+/// unreadable config names none here (0): the family's open then refuses it with its own reason.
+pub fn contextCeiling(a: std.mem.Allocator, io: std.Io, dir: []const u8, rope_yarn: ?f64) !i64 {
+    _ = rope_yarn; // no rope in the target's layers
+    const c = ink.config.Config.read(a, io, dir, null) catch return 0;
+    return c.text.max_positions;
+}
+
+/// This rank's weights: its heads and experts of the served layers, rank 0's embed and head.
+pub fn placementWeightBytes(a: std.mem.Allocator, io: std.Io, dir: []const u8, tp: u32, rank: u32, drafts: bool) !u64 {
+    _ = drafts;
+    var m = ink.describe.Model.fromDir(a, io, dir, .{ .world = @max(tp, 1) }, null) catch return 0;
+    defer m.deinit();
+    if (rank >= m.p.ranks.len) return 0;
+    return engine.rankWeightBytes(&m, rank, engine.layersFromEnv() catch 0);
+}
+
+const Owned = struct {
+    gpa: std.mem.Allocator,
+    group: ?cuda.tp_group.Group = null,
+    e: *engine.Engine,
+    lanes: ink_lanes.Lanes,
+    /// TF_INK2_MAX_STREAMS as `count` read it (0: unreadable), for /health.
+    max_streams: u32 = 0,
+};
+
+pub fn open(gpa: std.mem.Allocator, io: std.Io, ctx: *const cuda.Context, dir: []const u8, kernels: ?[]const u8, o: Options) !Loaded {
+    if (kernels != null) return error.CapturedKernels;
+    const world: u32 = @max(o.tp, 1);
+    if (o.rank >= world) return error.NoRank;
+    if (world > ink.plan.max_world) return error.NoRank;
+    const own = try gpa.create(Owned);
+    errdefer gpa.destroy(own);
+    own.* = .{ .gpa = gpa, .e = undefined, .lanes = undefined, .max_streams = maxStreams() catch 0 };
+    if (world > 1) {
+        try commId(gpa, o);
+        // the ranks' liveness lines (NCCL_COMM_ID's port + 1): a rank that fails or dies stops the others
+        try cuda.tp_watch.start(io, o.rank, world);
+        own.group = cuda.tp_group.Group.open(ctx.d, o.rank, world) catch |err| {
+            cuda.tp_watch.fail(@errorName(err)); // the others stop now instead of waiting in NCCL's init
+            return err;
+        };
+        // one vote of every rank on the transport settings, then the transports (cuda_wire.zig openAll)
+        ic.wire.openAll(gpa, io, ctx.d, &own.group.?) catch |err| {
+            own.group.?.abort(); // nothing may wait on a peer that stopped; the process ends next
+            return err;
+        };
+    }
+    errdefer if (own.group) |*g| g.close();
+    own.e = engine.Engine.init(gpa, io, ctx.d, dir, .{ .rank = o.rank, .world = world, .context = o.context + context_slack, .group = if (own.group) |*g| g else null, .scratch_gib = scratchGib() }) catch |err| {
+        cuda.tp_watch.fail(@errorName(err)); // the other ranks stop with this rank's reason (a no-op at W = 1)
+        return err;
+    };
+    errdefer own.e.deinit(); // Engine.init checked every forward's op scratch at this context (cuda_scratch.zig)
+    // rank 0's refusal (no stream fits, or --parallel N does not) stops the other ranks with its reason
+    const counted = (if (own.group) |*g| rooms(own.e, g, o) else alone(own.e, o)) catch |err| {
+        cuda.tp_watch.fail(@errorName(err));
+        return err;
+    };
+    own.e.asleep = world > 1 and cuda.tp_watch.open(); // the followers start asleep
+    if (o.rank == 0 and !own.e.paged) std.log.warn("inkling2: TF_INK2_PAGES=0 serves v0.1's fixed windows, a tooling setting for A/B measurements (the KV page pool is the serving layout; /health reports no kv)", .{});
+    if (o.rank != 0) {
+        std.log.info("inkling2 rank {d} of {d}: following rank 0", .{ o.rank, world });
+        ic.follow.follow(own.e) catch |err| {
+            std.log.err("inkling2 rank {d}: following rank 0 stopped ({s})", .{ o.rank, @errorName(err) });
+            cuda.tp_watch.fail(@errorName(err));
+            std.c._exit(1);
+        };
+        release(own);
+        std.process.exit(0);
+    }
+    own.lanes = .{ .x = .{ .e = own.e }, .gpa = gpa };
+    own.lanes.loadScript(io) catch |err| {
+        std.log.err("inkling2: TF_INK2_SCRIPT: {s}", .{@errorName(err)});
+        return err;
+    };
+    return .{
+        .backend = own.lanes.backend(),
+        .facts = own.lanes.facts(),
+        .rows = own.lanes.widest(), // the widest verify window (the lane config's drafts; 2 without the drafter, so the lane core may share rounds)
+        .stream_bytes = own.e.streamBytes(),
+        .ctx = own,
+        .deinit = close,
+        .reserve = reserve,
+        .peer_room = if (counted) |c| c.peer else null,
+        .draft_kind = if (own.e.drafter != null) "DSpark" else null,
+        .target = own,
+        .streams = if (counted) |c| c.streams else null,
+        .admits = own.e.paged,
+    };
+}
+
+/// /health's `kv` (B3; native/cuda_startup_phase.zig converts it): rank 0's KV page pool as its engine thread last
+/// copied it (cuda_pages.zig `show`), the streams and their cap. Null without a pool (TF_INK2_PAGES=0, tooling).
+pub const KvCounts = struct { page_tokens: u32, pages: u64, free: u64, available: u64, kept: u64, request_tokens: u64, streams: u32, max_streams: u32, waiting_pages: u64, page_waits: u64 };
+
+pub fn kv_source(ptr: *anyopaque) ?KvCounts {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const p = own.e.pool orelse return null;
+    const s = p.shownNow();
+    return .{
+        .page_tokens = @intCast(ic.pages.page_rows),
+        .pages = s.pages,
+        .free = s.free,
+        .available = s.available,
+        .kept = s.kept,
+        .request_tokens = @min(s.pages * ic.pages.page_rows, o_context(own.e)),
+        .streams = p.slots,
+        .max_streams = own.max_streams,
+        .waiting_pages = s.waiting,
+        .page_waits = s.waits,
+    };
+}
+
+/// The lane host's admission on the KV page pool (Loaded.admits): a slot free and the request's pages available.
+pub fn fits(ptr: *anyopaque, prompt: u32, max_tokens: u32) bool {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    return own.lanes.fits(prompt, max_tokens);
+}
+
+// The prompt cache on the KV page pool (stage 2d; cuda_snap.zig). A state at N holds rows [0, N) (no head lookahead):
+// its whole pages by reference, its fixed part and tail rows in one arena slot; it is kept where the lane cut a chunk,
+// at any row: no grid, so the store is not "planned". The fork rule keeps one where a prompt parts from the longest
+// kept one; TF_INK2_PROMPT_TAIL=1 keeps a raw prompt's last row too. The store's budget is the arena's slots; the pages
+// are the pool's, given back by the store when a stream's pages do not fit (`snap_store`: the reclaim chain).
+pub const snap_lookahead: u32 = 0;
+pub const snap_fork = true;
+pub const snap_tail = "TF_INK2_PROMPT_TAIL";
+/// A new shared system prompt's end is planned with the endpoint and may evict, so concurrent requests on it wait for
+/// one prefill and resume there even when the arena is full (stage 1 on the Sparks: DSpark's larger states left no
+/// free room, the cuts were trimmed and 0 of 3 waited).
+pub const snap_shared_first = true;
+
+/// The arena bytes a state at `at` takes (the same on every rank): one slot.
+pub fn snap_bytes(ptr: *anyopaque, at: u32) u64 {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    return ic.snap.bytes(own.e, at);
+}
+
+/// The store's budget becomes one arena on every rank, made now (nothing is allocated while serving); the bytes past
+/// its last granule are set aside.
+pub fn snap_ready(ptr: *anyopaque, budget: u64) anyerror!u64 {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const n = try ic.snap.arena(own.lanes.x, budget);
+    if (n > 0) std.log.info("inkling2: prompt cache arena {d:.2} GiB on every rank: {d} kept states of {d:.0} MiB (their pages the pool's)", .{ gib(n), n / ic.snap.bytes(own.e, 0), @as(f64, @floatFromInt(ic.snap.bytes(own.e, 0))) / (1 << 20) });
+    return budget - n;
+}
+
+/// The server's store (native/cuda.zig, after it is made): the lanes ask it to give kept states' pages back before a
+/// stream's pages do not fit (the reclaim chain), and whether a state is borrowed (a resume in flight).
+pub fn snap_store(ptr: *anyopaque, store: *anyopaque, give_back: *const fn (*anyopaque, ?*anyopaque, *anyopaque, *const fn (*anyopaque) bool, bool) bool, borrowed: *const fn (*anyopaque, *anyopaque) bool) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    own.lanes.store = .{ .ctx = store, .give_back = give_back, .borrowed = borrowed };
+}
+
+/// The prompt pass of `owner` (a lane stream) stands at `at`, a mark at a chunk start: every rank copies its slot
+/// into the arena at one offset.
+pub fn snap_save(ptr: *anyopaque, owner: ?*anyopaque, at: u32) anyerror!*anyopaque {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const s: *const lanes.Stream = @ptrCast(@alignCast(owner orelse return error.UnknownStream));
+    const slot = own.lanes.slotOf(s) orelse return error.UnknownStream;
+    const k = try own.gpa.create(ic.snap.Kept);
+    errdefer own.gpa.destroy(k);
+    try ic.snap.save(own.lanes.x, slot, at, k);
+    return k;
+}
+
+/// A restore outside a prompt pass would leave the other ranks behind: states resume inside it (Lanes.resumeFrom).
+pub fn snap_restore(ptr: *anyopaque, owner: ?*anyopaque, saved: *anyopaque) anyerror!void {
+    _ = .{ ptr, owner, saved };
+    return error.RestoredInPromptPass;
+}
+
+/// Rank 0 frees the state's extent; nothing goes to the other ranks.
+pub fn snap_drop(ptr: *anyopaque, saved: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    const k: *ic.snap.Kept = @ptrCast(@alignCast(saved));
+    ic.snap.drop(own.lanes.x, k);
+    own.gpa.destroy(k);
+}
+
+/// A rank's room after its load (the server's reading, after the reserve) and its bytes a stream at --context; on
+/// pages, a slot's fixed part and a page's bytes (`stream` is then the fixed part and a whole context's pages).
+pub const RankRoom = extern struct { room: u64, stream: u64, fixed: u64 = 0, page: u64 = 0 };
+
+/// What `count` found (rank 0): the streams, and the smallest room less the graph cache's reserve, in rank 0's
+/// stream bytes, for the server's admission (which then admits exactly `streams` and gives the prompt cache the rest).
+const Counted = struct { streams: u32, peer: Peer };
+
+/// On pages: the most pool pages every rank holds beside `n` slots' fixed parts, the caches for n streams and the
+/// scrub page (0: none; a rank without a reading holds any number).
+pub fn poolPages(all: []const RankRoom, cache: u64, n: u32) u64 {
+    var most: u64 = std.math.maxInt(u64);
+    for (all) |r| {
+        if (r.room == std.math.maxInt(u64) or r.page == 0) continue;
+        const rest = r.room -| (cache + graphBytes(n) + r.page + @as(u64, n) * r.fixed);
+        most = @min(most, rest / r.page);
+    }
+    return if (most == std.math.maxInt(u64)) 0 else most;
+}
+
+/// The largest page's bytes over the ranks (the scrub page every rank keeps beside its pool; 0: not on pages).
+fn scrubBytes(all: []const RankRoom) u64 {
+    var b: u64 = 0;
+    for (all) |r| b = @max(b, r.page);
+    return b;
+}
+
+/// Device bytes kept out of the streams' room for the captured forwards of `streams` slots (cuda_engine.zig
+/// graphUnits units of graph_budget_bytes, on every rank).
+pub fn graphBytes(streams: u32) u64 {
+    return @as(u64, engine.graphUnits(streams)) * engine.graph_budget_bytes;
+}
+
+/// The prompt cache's arena a rank: --prompt-cache-gib (not given: none counted; the server sizes the cache from
+/// what the streams leave).
+fn cacheBytes(asked: Asked) u64 {
+    const g = asked.cache_gib orelse return 0;
+    return if (g > 0) @intFromFloat(g * (1 << 30)) else 0;
+}
+
+/// Room left on rank r for `n` streams: its room less the prompt cache and the graph cache for n (0: short).
+fn left(r: RankRoom, cache: u64, n: u32) u64 {
+    return r.room -| (cache + graphBytes(n));
+}
+
+/// Whether `n` streams fit on every rank (a rank without a reading, room maxInt, fits anything).
+pub fn fitsAll(all: []const RankRoom, cache: u64, n: u32) bool {
+    for (all) |r| {
+        if (r.room == std.math.maxInt(u64)) continue;
+        if (r.room < cache + graphBytes(n) or left(r, cache, n) / @max(r.stream, 1) < n) return false;
+    }
+    return true;
+}
+
+/// The most streams (1 .. `most`) that fit on every rank, 0 if not even one does.
+pub fn fitStreams(all: []const RankRoom, cache: u64, most: u32) u32 {
+    var n = most;
+    while (n > 0) : (n -= 1) if (fitsAll(all, cache, n)) return n;
+    return 0;
+}
+
+/// The rank whose room holds the fewest of its streams beside the caches for `n` streams.
+fn binding(all: []const RankRoom, cache: u64, n: u32) usize {
+    var best: usize = 0;
+    var most: u128 = std.math.maxInt(u128);
+    for (all, 0..) |r, q| {
+        if (r.room == std.math.maxInt(u64)) continue;
+        const k = @as(u128, left(r, cache, n)) * (1 << 20) / @max(r.stream, 1);
+        if (k < most) {
+            most = k;
+            best = q;
+        }
+    }
+    return best;
+}
+
+/// The largest --context (a multiple of 1,024 tokens, at most `ceiling`) whose one stream fits on every rank beside
+/// the caches; 0 if none. Rank r's stream at a context scales as rank 0's (`model.at(positions)`: rank 0's bytes for
+/// a slot of that many positions; `stream0` its bytes at this start's --context).
+pub fn largestContext(all: []const RankRoom, cache: u64, stream0: u64, model: anytype, ceiling: usize) usize {
+    var lo: usize = 0;
+    var hi: usize = ceiling / 1024;
+    while (lo < hi) {
+        const mid = (lo + hi + 1) / 2;
+        const b0 = model.at(mid * 1024 + context_slack);
+        var ok = true;
+        for (all) |r| {
+            if (r.room == std.math.maxInt(u64)) continue;
+            const b = @as(u128, b0) * r.stream / @max(stream0, 1);
+            if (r.room < cache + graphBytes(1) or b > left(r, cache, 1)) ok = false;
+        }
+        if (ok) lo = mid else hi = mid - 1;
+    }
+    return lo * 1024;
+}
+
+/// The refusal `explain` gives for `count`'s errors (rank 0 writes it before failing).
+var refusal_buf: [768]u8 = undefined;
+var refusal: []const u8 = "";
+
+/// Rank 0's bytes a slot of `positions` positions, for `largestContext` and `logTable`.
+const At = struct {
+    e: *const engine.Engine,
+    fn at(x: @This(), positions: usize) usize {
+        return x.e.streamBytesAt(positions);
+    }
+};
+
+/// Rank 0: the streams at --context from every rank's room (see the top). Logs the count; refuses when none fits
+/// (auto) or --parallel N does not.
+fn count(e: *engine.Engine, all: []const RankRoom, o: Options) !Counted {
+    const a = o.streams_asked;
+    // on pages the scrub page sits beside the pool on every rank: counted with the prompt cache
+    const cache = cacheBytes(a) + scrubBytes(all);
+    const cap = maxStreams() catch |err| {
+        refusal = "TF_INK2_MAX_STREAMS (the recipe's MAX_STREAMS): a stream count from 1 to 8";
+        std.log.err("inkling2: {s}", .{refusal});
+        return err;
+    };
+    // auto: as many as fit, at most the cap; --parallel N may ask for more (each is checked against the rooms)
+    const fit = fitStreams(all, cache, if (a.fixed) @max(a.n, most_streams) else most_streams);
+    const window = o.context;
+    const stream = e.streamBytes();
+    // on pages, --parallel N past the whole windows that fit: N slots share the pages the room holds beside them, and
+    // a request waits until its pages are free (at least a page a slot)
+    if (e.paged and a.fixed and a.n > fit) {
+        const p = poolPages(all, cache + pool_margin, a.n);
+        if (p >= a.n) return planned(e, all, cache, a.n, p, "--parallel", fit);
+    }
+    if (a.fixed and a.n > fit and fit > 0) {
+        const q = binding(all, cache, a.n);
+        refusal = std.fmt.bufPrint(&refusal_buf, "--parallel {d} at --context {d} needs {d:.2} GiB a rank ({d} streams of {d:.2} GiB, the prompt cache's {d:.2} GiB, the graph cache's {d:.2} GiB), and rank {d} has {d:.2} GiB after its load and the reserve: {d} fit (--parallel auto serves as many as fit), or lower --context", .{ a.n, window, gib(@as(u64, a.n) * all[q].stream + cache + graphBytes(a.n)), a.n, gib(all[q].stream), gib(cache), gib(graphBytes(a.n)), q, gib(all[q].room), fit }) catch "--parallel asks for more streams than fit at --context";
+        std.log.err("inkling2: {s}", .{refusal});
+        return error.ParallelDoesNotFit;
+    }
+    if (fit == 0) {
+        const q = binding(all, cache, 1);
+        const most = largestContext(all, cache, stream, At{ .e = e }, window);
+        refusal = std.fmt.bufPrint(&refusal_buf, "--context {d} fits no stream: one takes {d:.2} GiB a rank{s}, and rank {d} has {d:.2} GiB after its load and the reserve, {d:.2} GiB beside the prompt cache ({d:.2} GiB) and the graph cache ({d:.2} GiB); the largest context that fits is {d} tokens (--context {d}), or lower --prompt-cache-gib or TENSORFOLD_MEMORY_RESERVE_GIB", .{ window, gib(all[q].stream), if (e.drafter != null) " with the drafter" else "", q, gib(all[q].room), gib(left(all[q], cache, 1)), gib(cache), gib(graphBytes(1)), most, most }) catch "--context fits no stream: lower --context";
+        std.log.err("inkling2: {s}", .{refusal});
+        return error.ContextFitsNoStream;
+    }
+    const n = if (a.fixed) a.n else @min(fit, cap);
+    // on pages the pool takes the room beside the n slots (stage 2d): the pages past n whole contexts serve longer
+    // requests and the prompt cache's kept states; the streams stay n (whole contexts, capped)
+    if (e.paged) return planned(e, all, cache, n, @max(poolPages(all, cache + pool_margin, n), @as(u64, n) * ic.pages.pagesFor(e.o.context)), if (a.fixed) "--parallel" else "auto", fit);
+    const q = binding(all, cache, n);
+    var cap_buf: [24]u8 = undefined;
+    const capped = if (a.fixed) "" else std.fmt.bufPrint(&cap_buf, " (cap {d})", .{cap}) catch "";
+    std.log.info("inkling2: context {d} -> {d} stream{s}{s} ({s}: {d} fit; rank {d} binds, {d:.2} GiB after its load and the reserve, less the prompt cache's {d:.2} GiB and the graph cache's {d:.2} GiB ({d} units), holds {d} of {d:.2} GiB{s}; at most {d})", .{
+        window, n, if (n == 1) "" else "s", capped, if (a.fixed) "--parallel" else "auto", fit, q, gib(all[q].room), gib(cache), gib(graphBytes(n)), engine.graphUnits(n), left(all[q], cache, n) / @max(all[q].stream, 1), gib(all[q].stream), if (e.drafter != null) " with the drafter" else "", most_streams,
+    });
+    logTable(e, all, cache);
+    // the server's admission: the smallest room less the graph cache's reserve, in rank 0's stream bytes
+    var peer: Peer = .{ .bytes = std.math.maxInt(u64), .rank = 0 };
+    for (all, 0..) |r, i| {
+        if (r.room == std.math.maxInt(u64)) continue;
+        const wide = @as(u128, r.room -| graphBytes(n)) * stream / @max(r.stream, 1);
+        const bytes: u64 = @intCast(@min(wide, std.math.maxInt(u64)));
+        if (bytes < peer.bytes) peer = .{ .bytes = bytes, .rank = i };
+    }
+    return .{ .streams = n, .peer = peer };
+}
+
+/// Rank 0, on pages: `n` slots on a pool of `npages` pages (`e.plan`, what `reserve` makes on every rank). Logs the
+/// count, the pool and the most pages the room would hold beside the slots; the server's admission gets the smallest
+/// room less the graph cache's reserve, in rank 0's bytes a slot (its fixed part and its share of the pool).
+fn planned(e: *engine.Engine, all: []const RankRoom, cache: u64, n: u32, planned_pages: u64, how: []const u8, fit: u32) !Counted {
+    const npages = if (poolCap()) |c| @min(planned_pages, @max(c, n)) else planned_pages;
+    const room_pages = poolPages(all, cache, n);
+    const page_rows = ic.pages.page_rows;
+    const q = binding(all, cache, n);
+    std.log.info("inkling2: context {d} -> {d} stream{s} on a KV page pool ({s}: {d} whole contexts fit; rank {d} binds): {d} pages of {d} positions ({d} positions, {d:.2} GiB a rank; {d:.2} GiB fixed a slot; {d} whole contexts' {d} pages and {d} more for longer requests and kept prompts), the largest request {d} positions; the room holds {d} pages ({d} positions) beside {d} slots, the prompt cache's {d:.2} GiB and the graph cache's {d:.2} GiB{s}", .{
+        o_context(e), n, if (n == 1) "" else "s", how, fit, q, npages, page_rows, npages * page_rows, gib(npages * all[0].page), gib(all[0].fixed), @min(n, npages / ic.pages.pagesFor(e.o.context)), @min(npages, @as(u64, n) * ic.pages.pagesFor(e.o.context)), npages -| @as(u64, n) * ic.pages.pagesFor(e.o.context), @min(npages * page_rows, o_context(e)), room_pages, room_pages * page_rows, n, gib(cache -| scrubBytes(all)), gib(graphBytes(n)), if (e.drafter != null) " (with the drafter)" else "",
+    });
+    logTable(e, all, cache);
+    e.plan = .{ .slots = n, .pages = @intCast(npages) }; // after the table: e.streamBytes() is then a slot's share
+    // a slot's bytes as the server counts them: its fixed part and its share of the pool, on each rank
+    const mine = all[0].fixed + (npages * all[0].page + n - 1) / n;
+    var peer: Peer = .{ .bytes = std.math.maxInt(u64), .rank = 0 };
+    for (all, 0..) |r, i| {
+        if (r.room == std.math.maxInt(u64)) continue;
+        const each = r.fixed + (npages * r.page + n - 1) / n;
+        const wide = @as(u128, r.room -| graphBytes(n)) * mine / @max(each, 1);
+        const bytes: u64 = @intCast(@min(wide, std.math.maxInt(u64)));
+        if (bytes < peer.bytes) peer = .{ .bytes = bytes, .rank = i };
+    }
+    return .{ .streams = n, .peer = peer };
+}
+
+/// On pages, room left out of the pool beside the slots and the caches: the room readings' drift between the count
+/// and the server's own placement (the pool is sized to the room after the reserve, not to whole contexts).
+const pool_margin: u64 = 256 << 20;
+
+/// TF_INK2_POOL_PAGES=N (tests, rank 0): the pool at most N pages (a page a slot at least), so admission's waits and
+/// refusals can be reached on any host.
+fn poolCap() ?u64 {
+    const v = std.c.getenv("TF_INK2_POOL_PAGES") orelse return null;
+    const n = std.fmt.parseInt(u64, std.mem.span(v), 10) catch return null;
+    std.log.warn("inkling2: TF_INK2_POOL_PAGES={d} caps the KV page pool (a test setting)", .{n});
+    return n;
+}
+
+/// The served positions a slot holds (the table's capacity is a whole number of pages past it).
+fn o_context(e: *const engine.Engine) usize {
+    return e.o.context - context_slack;
+}
+
+/// The README's contexts, for `logTable`.
+const table_contexts = [_]usize{ 32768, 131072, 262144, 524288, 1048576 };
+
+/// Rank 0 (log only): the streams `--parallel auto` would serve at each of `table_contexts` beside the same caches,
+/// from these rooms (each rank's bytes a stream scaled as rank 0's at that context; the rooms are this start's, at
+/// --context: the drafter's attention buffers and the op scratch's need grow a little with the context).
+fn logTable(e: *const engine.Engine, all: []const RankRoom, cache: u64) void {
+    var buf: [320]u8 = undefined;
+    var at: usize = 0;
+    const stream0 = e.streamBytesAt(e.o.context); // a whole context's bytes (on pages: before the pool's share)
+    for (table_contexts) |c| {
+        var scaled: [ink.plan.max_world]RankRoom = undefined;
+        const b0 = (At{ .e = e }).at(c + context_slack);
+        for (all, scaled[0..all.len]) |r, *x| x.* = .{ .room = r.room, .stream = @intCast(@min(@as(u128, b0) * r.stream / @max(stream0, 1), std.math.maxInt(u64))) };
+        const n = fitStreams(scaled[0..all.len], cache, most_streams);
+        const t = std.fmt.bufPrint(buf[at..], " {d} -> {d} ({d:.2} GiB a stream);", .{ c, n, gib(b0) }) catch break;
+        at += t.len;
+    }
+    std.log.info("inkling2: --parallel auto by --context at these rooms, before the cap{s}:{s}", .{ if (e.drafter != null) " (with the drafter)" else "", buf[0..at] });
+}
+
+/// W = 1: this rank's room, counted as `count` does (null: no reading).
+fn alone(e: *engine.Engine, o: Options) !?Counted {
+    const r = o.room orelse return null;
+    const b = r.read(r.ctx) orelse return null;
+    std.log.info("inkling2 rank 0: {d:.2} GiB of room after its load ({d:.2} GiB a stream)", .{ gib(b), gib(e.streamBytes()) });
+    const all = [1]RankRoom{mineOf(e, b)};
+    return try count(e, &all, o);
+}
+
+/// Every rank's room after its load (the server's reading: on a unified-memory GPU such as GB10 that is
+/// /proc/meminfo's MemAvailable, not cuMemGetInfo) and its stream bytes, gathered over the group; rank 0 counts the
+/// streams from them (`count`) and gets the smallest room less the graph cache's reserve, in its own stream bytes,
+/// for the server's admission. The other ranks get null (rank 0's count reaches them in `reserve`).
+/// TF_INK2_FAKE_ROOM=R:GIB (tests): rank R reports GIB GiB.
+/// This rank's room reading and its bytes a stream (on pages: a slot's fixed part and a page's too).
+fn mineOf(e: *const engine.Engine, room: u64) RankRoom {
+    return .{ .room = room, .stream = e.streamBytes(), .fixed = if (e.paged) e.fixedBytesAt(e.o.context) else 0, .page = e.pageBytes() };
+}
+
+fn rooms(e: *engine.Engine, g: *const cuda.tp_group.Group, o: Options) !?Counted {
+    var mine: RankRoom = mineOf(e, if (o.room) |r| r.read(r.ctx) orelse 0 else std.math.maxInt(u64));
+    if (fakeRoom(e.o.rank)) |b| {
+        std.log.warn("inkling2 rank {d}: TF_INK2_FAKE_ROOM reports {d:.2} GiB of room (read {d:.2})", .{ e.o.rank, gib(b), gib(mine.room) });
+        mine.room = b;
+    }
+    var all: [ink.plan.max_world]RankRoom = undefined;
+    try g.gather(RankRoom, e.d, e.stream, mine, all[0..e.o.world]);
+    if (e.o.rank != 0) return null;
+    var any = false;
+    for (all[0..e.o.world], 0..) |r, q| {
+        if (r.room == std.math.maxInt(u64)) continue; // no reading
+        any = true;
+        std.log.info("inkling2 rank 0: rank {d} has {d:.2} GiB of room after its load ({d:.2} GiB a stream there)", .{ q, gib(r.room), gib(r.stream) });
+    }
+    if (!any) return null;
+    return try count(e, all[0..e.o.world], o);
+}
+
+fn fakeRoom(rank: u32) ?u64 {
+    const v = std.mem.span(std.c.getenv("TF_INK2_FAKE_ROOM") orelse return null);
+    const colon = std.mem.indexOfScalar(u8, v, ':') orelse return null;
+    const r = std.fmt.parseInt(u32, v[0..colon], 10) catch return null;
+    const g = std.fmt.parseFloat(f64, v[colon + 1 ..]) catch return null;
+    if (r != rank or !(g >= 0)) return null;
+    return @intFromFloat(g * (1 << 30));
+}
+
+fn gib(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 30);
+}
+
+fn reserve(ptr: *anyopaque, streams: u32) anyerror!void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    try own.lanes.x.reserve(streams);
+}
+
+/// NCCL_COMM_ID from --master and --master-port when the environment has none.
+fn commId(gpa: std.mem.Allocator, o: Options) !void {
+    if (std.c.getenv("NCCL_COMM_ID") != null) return;
+    const host = o.master orelse return error.NoCommId;
+    const v = try std.fmt.allocPrintSentinel(gpa, "{s}:{d}", .{ host, o.master_port }, 0);
+    defer gpa.free(v);
+    if (setenv("NCCL_COMM_ID", v.ptr, 1) != 0) return error.NoCommId;
+}
+
+extern "c" fn setenv(name: [*:0]const u8, value: [*:0]const u8, overwrite: c_int) c_int;
+
+/// TF_INK2_SCRATCH_GIB: the op scratch a forward may take (cuda_scratch.zig: default 1).
+fn scratchGib() usize {
+    return ic.scratch.gib();
+}
+
+fn close(ptr: *anyopaque) void {
+    const own: *Owned = @ptrCast(@alignCast(ptr));
+    own.lanes.x.end() catch |err| std.log.err("inkling2: ending the other ranks: {s}", .{@errorName(err)});
+    own.lanes.deinit();
+    release(own);
+}
+
+fn release(own: *Owned) void {
+    own.e.deinit();
+    if (own.group) |*g| g.close();
+    own.gpa.destroy(own);
+}
+
+/// The server's words for this family's refusals.
+pub fn explain(_: ?*anyopaque, err: anyerror) ?[]const u8 {
+    return switch (err) {
+        error.NoRank => "Inkling-2 at TP: --tp W (1, 2 or 4) and --rank R below W on every rank (rank 0 serves)",
+        error.NoCommId => "Inkling-2's ranks meet over NCCL: set NCCL_COMM_ID to rank 0's address:port on every rank (or --master and --master-port)",
+        error.CapturedKernels => "Inkling-2 runs its own kernels: unset TENSORFOLD_CUDA_KERNELS",
+        error.BadInk2Layers => "TF_INK2_LAYERS: a layer count from 1 to the model's 48",
+        error.RankMismatch => "the ranks differ in executable, checkpoint or settings (TF_INK2_LAYERS, --context, TF_INK2_*): the log names which",
+        error.TransportSettingsDiffer => "the ranks differ in their transport settings (TF_ROCE, TF_INK2_ROCE_MULTI, TF_TP_*, the kernel image's contents): the log names the setting and the rank",
+        error.TransportNotReady => "a rank cannot open its transports (TF_TP_KERNEL_IMAGE missing or unreadable, or an invalid TF_TP_* or TF_ROCE_MAX_KB value): the log names the rank and why",
+        error.BuiltWithoutKernels => "this build has no CUDA kernels for Inkling-2 (build with -Dnvcc and the GPU's -Dsm)",
+        error.ContextFitsNoStream, error.ParallelDoesNotFit, error.BadMaxStreams => if (refusal.len > 0) refusal else "the streams do not fit at --context: lower --context",
+        error.RequestOverPool => "the request (its prompt, max_tokens and a verify window) needs more KV pages than this server's whole page pool holds: shorten the prompt or lower max_tokens (the startup log names the pool's positions)",
+        error.PastPages => "the stream ran past the KV pages it reserved (its prompt, max_tokens and a verify window)",
+        else => null,
+    };
+}
+
+test "inkling2 native: refusals explain themselves" {
+    try std.testing.expect(explain(null, error.NoCommId) != null);
+    try std.testing.expect(explain(null, error.NoRank) != null);
+    try std.testing.expect(explain(null, error.TransportSettingsDiffer) != null);
+    try std.testing.expect(explain(null, error.TransportNotReady) != null);
+    try std.testing.expect(explain(null, error.OutOfMemory) == null);
+}
+
+test "inkling2 native: TF_INK2_MAX_STREAMS takes 1 .. 8" {
+    try std.testing.expectEqual(@as(?u32, 4), parseMaxStreams("4"));
+    try std.testing.expectEqual(@as(?u32, 1), parseMaxStreams("1"));
+    try std.testing.expectEqual(@as(?u32, most_streams), parseMaxStreams("8"));
+    try std.testing.expectEqual(@as(?u32, null), parseMaxStreams("0"));
+    try std.testing.expectEqual(@as(?u32, null), parseMaxStreams("9"));
+    try std.testing.expectEqual(@as(?u32, null), parseMaxStreams("auto"));
+    try std.testing.expectEqual(@as(?u32, null), parseMaxStreams(""));
+}
+
+test "inkling2 native: --parallel auto counts the streams every rank holds beside the prompt and graph caches" {
+    const G: u64 = 1 << 30;
+    if (std.c.getenv("TF_INK2_GRAPHS_MAX") != null) return error.SkipZigTest;
+    // one stream: 8 units (0.25 GiB); more: 64 units (2 GiB)
+    try std.testing.expectEqual(@as(u64, G / 4), graphBytes(1));
+    try std.testing.expectEqual(@as(u64, 2 * G), graphBytes(2));
+    const cache = 3 * G / 2;
+    // rank 1 binds: 10 GiB less 1.5 and 2 leaves 6.5, six 1 GiB streams
+    var all = [_]RankRoom{ .{ .room = 12 * G, .stream = G }, .{ .room = 10 * G, .stream = G }, .{ .room = std.math.maxInt(u64), .stream = G } };
+    try std.testing.expectEqual(@as(u32, 6), fitStreams(&all, cache, most_streams));
+    try std.testing.expectEqual(@as(usize, 1), binding(&all, cache, 6));
+    // no cache: 8 (the cap), not 8.0 / 1
+    try std.testing.expectEqual(@as(u32, 8), fitStreams(&all, 0, most_streams));
+    // one long stream: 9 GiB does not fit 10 - 1.5 - 0.25 = 8.25; 8 GiB does
+    all[0].stream = 9 * G;
+    all[1].stream = 9 * G;
+    try std.testing.expectEqual(@as(u32, 0), fitStreams(&all, cache, most_streams));
+    all[0].stream = 8 * G;
+    all[1].stream = 8 * G;
+    try std.testing.expectEqual(@as(u32, 1), fitStreams(&all, cache, most_streams));
+    // two streams of 4 GiB take the 2 GiB graph reserve: 10 - 1.5 - 2 = 6.5 < 8
+    all[0].stream = 4 * G;
+    all[1].stream = 4 * G;
+    try std.testing.expectEqual(@as(u32, 1), fitStreams(&all, cache, most_streams));
+    // the largest context for one stream: 0.12 GiB + 8 KiB a position on rank 0 (rank 1's the same) in rank 1's
+    // 9 - 1.5 - 0.25 = 7.25 GiB: about 0.93M positions, below the 1M asked
+    const Lin = struct {
+        fn at(_: @This(), positions: usize) usize {
+            return (G * 12 / 100) + positions * 8192;
+        }
+    };
+    all[0].stream = 1;
+    all[1].stream = 1;
+    all[1].room = 9 * G;
+    const most = largestContext(&all, cache, 1, Lin{}, 1 << 20);
+    try std.testing.expect(most % 1024 == 0 and most > 0 and most < 1 << 20);
+    try std.testing.expect(Lin.at(.{}, most + context_slack) <= left(all[1], cache, 1));
+    try std.testing.expect(Lin.at(.{}, most + 1024 + context_slack) > left(all[1], cache, 1));
+    // rank 1 with no room for the caches: nothing fits, no context either
+    all[1].room = G;
+    try std.testing.expectEqual(@as(u32, 0), fitStreams(&all, cache, most_streams));
+    try std.testing.expectEqual(@as(usize, 0), largestContext(&all, cache, 1, Lin{}, 1 << 20));
+}
diff --git a/zig/src/families/inkling2/cuda_pages.zig b/zig/src/families/inkling2/cuda_pages.zig
new file mode 100644
index 0000000000000000000000000000000000000000..828f8c762470707288b8ad4609f8cb9a07c5859b
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_pages.zig
@@ -0,0 +1,811 @@
+//! Inkling-2's KV page pool (v0.2 stage 2b): the global layers' keys and values of every served stream in one arena a
+//! rank, cut into pages of `page_rows` positions (one attention split), and rank 0's allocator of those pages.
+//! Sliding layers keep their rings outside the pool (and the drafter its own caches until stage 2c); a slot keeps its
+//! fixed part (rings, convolution states, the rollback history) and a page table at a fixed address, so no captured
+//! graph is recaptured when a stream's pages change.
+//!
+//! The arena is laid out by region (the bench's `soa`): region 2g holds global layer g's keys, region 2g + 1 its
+//! values, each `pages` runs of page_rows x row bytes; page id i is run i of every region, and the last page is the
+//! scrub page that unmapped table entries name (never handed out). A stream on consecutive page ids therefore has
+//! each layer's rows in one contiguous run, as a v0.1 window did (G2 on GB10: scattered ids cost one-row attention
+//! 3-8 %, consecutive ones within 0.5 % at 32k-131k).
+//!
+//! The allocator (rank 0 owns the pool; the other ranks map the ids its `pages` step sends, cuda_follow.zig):
+//! - admission promises a request's pages (its prompt, max_tokens and one verify window) or it waits (`fits`);
+//! - a stream's pages are taken as ONE run of consecutive ids when a free run holds them: the smallest free run that
+//!   does (best fit, the lowest on a tie), from its start;
+//! - only when no free run holds them are they taken scattered, from the longest free runs first (fewest pieces);
+//!   each such cover is counted and logged as a fallback;
+//! - growth (`grow`: a stream that needs more pages than it holds) takes the pages right after its last one when
+//!   they are free (in place), else a best-fit run of the rest, else scattered (a fallback).
+//! Pages go back when the stream ends. The counts an idle server must show (`census`): nothing promised, no stream's
+//! page taken, every page free or a kept state's (free + kept = total).
+//! The prompt cache on pages (stage 2d, cuda_snap.zig): a kept state at N holds a reference to the stream's whole
+//! pages [0, N / page_rows) (rank 0's count a page: `retain` / `release`; the kept states hold a page once in the
+//! pool, however many share it), never written again; a stream resuming it adopts those pages (`open` with `adopt`:
+//! one more holder each, first in its table) and takes fresh pages after them, in place after the last adopted one
+//! when they are free (the consecutive-run rule), else a best-fit run, else scattered.
+//! TF_KV_POISON=1 (tests, every rank): a stream's pages are set to NaN when they are mapped, so a row read before it
+//! is written shows in the output.
+const std = @import("std");
+const cuda = @import("cuda");
+const attn = @import("cuda_attn.zig");
+
+/// Positions a page holds: one attention split, so a block reads its page id once a split.
+pub const page_rows: usize = attn.split_keys;
+
+/// Pages `positions` rows take.
+pub fn pagesFor(positions: usize) usize {
+    return (positions + page_rows - 1) / page_rows;
+}
+
+/// TF_INK2_PAGES (tooling, every rank; part of the settings the ranks agree on): `0` keeps every global layer in a
+/// window a slot (v0.1's layout, for A/B measurements only: the pool is the one serving layout, and a server started
+/// with it says so); anything else (or unset) puts them on pages.
+pub fn enabled() bool {
+    const v = std.c.getenv("TF_INK2_PAGES") orelse return true;
+    return !(v[0] == '0' and v[1] == 0);
+}
+
+/// TF_INK2_RUN_RING (every rank; agreed): `0` gives every forward of a stream on pages the paged kernels; anything
+/// else (or unset) gives a stream's one-row forwards the v0.1 ring kernels on its pages when they are one run of
+/// consecutive ids (a contiguous window of each region), as fast as v0.1's windows.
+pub fn ringOnRun() bool {
+    const v = std.c.getenv("TF_INK2_RUN_RING") orelse return true;
+    return !(v[0] == '0' and v[1] == 0);
+}
+
+/// TF_KV_POISON=1: new pages start as NaN (G4).
+pub fn poisoned() bool {
+    const v = std.c.getenv("TF_KV_POISON") orelse return false;
+    return v[0] == '1' and v[1] == 0;
+}
+
+/// TF_INK2_PAGE_ORDER (tooling, a slot with its own pages): `shuffle` gives its table a pseudo-random permutation of
+/// its pages (the worst case for locality), anything else consecutive ids.
+pub fn shuffled() bool {
+    const v = std.c.getenv("TF_INK2_PAGE_ORDER") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "shuffle");
+}
+
+/// TF_INK2_PAGE_ORDER=move (tooling, a slot with its own pages): an arena of two contexts, each new sequence on
+/// another run of consecutive ids (a captured step replayed on a moved run), and every other 5 one-row forwards on
+/// the page table instead of the run (mode switches mid-stream).
+pub fn moving() bool {
+    const v = std.c.getenv("TF_INK2_PAGE_ORDER") orelse return false;
+    return std.mem.eql(u8, std.mem.span(v), "move");
+}
+
+/// Where a slot's global layers live: an arena of `pages` runs a region (the scrub page last), `run` bytes a run.
+pub const Place = struct {
+    base: u64,
+    pages: usize,
+    run: u64,
+
+    /// Region r's first byte (2g: global layer g's keys, 2g + 1 its values).
+    pub fn region(p: Place, r: usize) u64 {
+        return p.base + @as(u64, r) * p.pages * p.run;
+    }
+
+    /// The scrub page: what an unmapped table entry names.
+    pub fn scrub(p: Place) u32 {
+        return @intCast(p.pages - 1);
+    }
+
+    /// The page stride as the paged kernels take it (Kv.page): elements of 2 bytes.
+    pub fn elems(p: Place) usize {
+        return @intCast(p.run / 2);
+    }
+};
+
+/// The device bytes of an arena of `pages` pages (the scrub page included) for `regions` runs of `run` bytes.
+pub fn arenaBytes(pages: usize, regions: usize, run: u64) u64 {
+    return @as(u64, pages) * regions * run;
+}
+
+/// A maximal run of free pages.
+pub const Run = struct { start: u32, len: u32 };
+
+/// A stream's reservation: pages promised and not yet taken, and the pages it holds in position order (its table).
+pub const Lease = struct {
+    promised: usize = 0,
+    ids: std.ArrayList(u32) = .empty,
+};
+
+/// What an idle pool must show: nothing promised, no stream's page taken, every page free or a kept state's (`kept`:
+/// pages kept states hold; `taken`: pages any holder holds).
+pub const Census = struct { total: usize, free: usize, promised: usize, taken: usize, kept: usize = 0 };
+
+/// Rank 0's counts for /health (B3), in pages: the pool, free, free and not promised, kept by the prompt cache, the
+/// need of a request held back for pages (0: none) and the requests held back since start.
+pub const Shown = struct { pages: usize = 0, free: usize = 0, available: usize = 0, kept: usize = 0, waiting: usize = 0, waits: u64 = 0 };
+
+fn shownOf(a: *const Alloc, waiting: ?usize, waits: u64) Shown {
+    const c = a.census();
+    return .{
+        .pages = c.total,
+        .free = c.free,
+        .available = a.available(),
+        .kept = if (@hasField(Census, "kept")) c.kept else 0, // the prompt cache on pages (stage 2d)
+        .waiting = waiting orelse 0,
+        .waits = waits,
+    };
+}
+
+/// How streams' pages were placed since start.
+pub const Stats = struct {
+    covers: u64 = 0, // streams' first covers
+    one_run: u64 = 0, // of those, one run of consecutive ids
+    fallbacks: u64 = 0, // covers and growths taken scattered (no free run held them)
+    fallback_pieces: u64 = 0, // the runs those took
+    grown: u64 = 0, // growths
+    grown_in_place: u64 = 0, // of those, the pages right after the stream's last
+    grown_run: u64 = 0, // of those, a best-fit run elsewhere
+    resumed: u64 = 0, // streams that adopted a kept state's pages (the prompt cache on pages)
+    resumed_pages: u64 = 0, // the pages they adopted
+    resumed_one_run: u64 = 0, // of those streams, a table of one run (adopted and fresh pages consecutive)
+};
+
+/// Rank 0's page allocator over `total` pages (ids 0 .. total - 1; the arena's scrub page is not one of them).
+pub const Alloc = struct {
+    gpa: std.mem.Allocator,
+    refs: []u32, // holders a page (0: free); the kept states count as one holder of a page they hold
+    kept: []u32, // kept states holding a page (the prompt cache on pages)
+    nfree: usize,
+    nkept: usize = 0, // pages with kept > 0
+    promised: usize = 0,
+    stats: Stats = .{},
+    runs: std.ArrayList(Run) = .empty, // scratch for the scattered fallback
+
+    pub fn init(gpa: std.mem.Allocator, count: usize) !Alloc {
+        const refs = try gpa.alloc(u32, count);
+        errdefer gpa.free(refs);
+        @memset(refs, 0);
+        const kept = try gpa.alloc(u32, count);
+        @memset(kept, 0);
+        return .{ .gpa = gpa, .refs = refs, .kept = kept, .nfree = count };
+    }
+
+    pub fn deinit(a: *Alloc) void {
+        a.gpa.free(a.refs);
+        a.gpa.free(a.kept);
+        a.runs.deinit(a.gpa);
+        a.* = undefined;
+    }
+
+    pub fn total(a: *const Alloc) usize {
+        return a.refs.len;
+    }
+
+    /// Pages free and not promised.
+    pub fn available(a: *const Alloc) usize {
+        return a.nfree - a.promised;
+    }
+
+    /// Whether `n` more pages could be promised now.
+    pub fn fits(a: *const Alloc, n: usize) bool {
+        return a.available() >= n;
+    }
+
+    pub fn census(a: *const Alloc) Census {
+        return .{ .total = a.total(), .free = a.nfree, .promised = a.promised, .taken = a.total() - a.nfree, .kept = a.nkept };
+    }
+
+    /// Pages a stream holds (more holders than the kept states' one).
+    pub fn leased(a: *const Alloc) usize {
+        var n: usize = 0;
+        for (a.refs, a.kept) |r, k| n += @intFromBool(r > @intFromBool(k > 0));
+        return n;
+    }
+
+    /// Nothing promised and no stream's page: every page free or a kept state's (free + kept = total).
+    pub fn idle(a: *const Alloc) bool {
+        return a.promised == 0 and a.leased() == 0 and a.nfree + a.nkept == a.total();
+    }
+
+    /// A kept state takes a reference to page `id`, a stream's (taken): the kept states hold it once in the pool.
+    pub fn retain(a: *Alloc, id: u32) void {
+        if (a.refs[id] == 0) std.debug.panic("inkling2 pages: page {d} kept while free", .{id});
+        if (a.kept[id] == 0) {
+            a.refs[id] += 1;
+            a.nkept += 1;
+        }
+        a.kept[id] += 1;
+    }
+
+    /// A kept state's reference to page `id` goes; the page is free once nothing holds it.
+    pub fn release(a: *Alloc, id: u32) void {
+        if (a.kept[id] == 0) std.debug.panic("inkling2 pages: page {d} released by a kept state that does not hold it", .{id});
+        a.kept[id] -= 1;
+        if (a.kept[id] > 0) return;
+        a.nkept -= 1;
+        a.refs[id] -= 1;
+        if (a.refs[id] == 0) a.nfree += 1;
+    }
+
+    /// The pages kept states hold that no stream does and no state in `protect` holds (the reclaim chain could free
+    /// them by dropping the other states); `mark`: scratch, a byte a page.
+    pub fn reclaimable(a: *const Alloc, protect: []const []const u32, mark: []u8) usize {
+        if (a.nkept == 0) return 0;
+        @memset(mark, 0);
+        for (protect) |ids| for (ids) |id| {
+            mark[id] = 1;
+        };
+        var n: usize = 0;
+        for (a.refs, a.kept, mark) |r, k, m| n += @intFromBool(k > 0 and r == 1 and m == 0);
+        return n;
+    }
+
+    /// Whether a kept state holds any of `ids`.
+    pub fn anyKept(a: *const Alloc, ids: []const u32) bool {
+        for (ids) |id| if (a.kept[id] > 0) return true;
+        return false;
+    }
+
+    /// `l` (its table empty) adopts pages `ids` (a kept state's, taken): one more holder each, first in its table.
+    pub fn adopt(a: *Alloc, l: *Lease, ids: []const u32) !void {
+        if (l.ids.items.len != 0) return error.LeaseTaken;
+        try l.ids.ensureUnusedCapacity(a.gpa, ids.len);
+        for (ids) |id| {
+            if (id >= a.refs.len or a.refs[id] == 0) return error.AdoptFree;
+            a.refs[id] += 1;
+            l.ids.appendAssumeCapacity(id);
+        }
+    }
+
+    /// `n` more pages promised to `l`; LaneMemory when they are not available now.
+    pub fn promise(a: *Alloc, l: *Lease, n: usize) error{LaneMemory}!void {
+        if (a.available() < n) return error.LaneMemory;
+        a.promised += n;
+        l.promised += n;
+    }
+
+    /// What `l` was promised and has not taken goes back.
+    pub fn unpromise(a: *Alloc, l: *Lease) void {
+        a.promised -= l.promised;
+        l.promised = 0;
+    }
+
+    /// The smallest free run of at least `n` pages (the lowest on a tie), or null.
+    pub fn bestFit(a: *const Alloc, n: usize) ?Run {
+        if (n == 0) return null;
+        var best: ?Run = null;
+        var i: usize = 0;
+        while (i < a.refs.len) {
+            if (a.refs[i] != 0) {
+                i += 1;
+                continue;
+            }
+            const s = i;
+            while (i < a.refs.len and a.refs[i] == 0) i += 1;
+            const len = i - s;
+            if (len >= n and (best == null or len < best.?.len)) {
+                best = .{ .start = @intCast(s), .len = @intCast(len) };
+                if (len == n) break; // exact: nothing smaller can hold n
+            }
+        }
+        return best;
+    }
+
+    /// Page `id` taken by `l` from its promise.
+    fn takeId(a: *Alloc, l: *Lease, id: u32) void {
+        std.debug.assert(a.refs[id] == 0 and l.promised > 0);
+        a.refs[id] = 1;
+        a.nfree -= 1;
+        a.promised -= 1;
+        l.promised -= 1;
+        l.ids.appendAssumeCapacity(id);
+    }
+
+    /// Pages [start, start + n) taken by `l`.
+    fn takeRun(a: *Alloc, l: *Lease, start: u32, n: usize) void {
+        for (0..n) |k| a.takeId(l, start + @as(u32, @intCast(k)));
+    }
+
+    /// `n` pages for `l` as one best-fit run when one holds them, else scattered from the longest free runs first
+    /// (a fallback). Returns whether one run held them.
+    fn place(a: *Alloc, l: *Lease, n: usize) !bool {
+        if (n == 0) return true;
+        if (l.promised < n) return error.PastReservation;
+        try l.ids.ensureUnusedCapacity(a.gpa, n);
+        if (a.bestFit(n)) |r| {
+            a.takeRun(l, r.start, n);
+            return true;
+        }
+        // no free run holds n: the free runs, longest first (the lowest start on a tie), until n are taken
+        a.runs.clearRetainingCapacity();
+        var i: usize = 0;
+        while (i < a.refs.len) {
+            if (a.refs[i] != 0) {
+                i += 1;
+                continue;
+            }
+            const s = i;
+            while (i < a.refs.len and a.refs[i] == 0) i += 1;
+            try a.runs.append(a.gpa, .{ .start = @intCast(s), .len = @intCast(i - s) });
+        }
+        std.mem.sort(Run, a.runs.items, {}, longerFirst);
+        var left = n;
+        var pieces: u64 = 0;
+        for (a.runs.items) |r| {
+            if (left == 0) break;
+            const k = @min(left, r.len);
+            a.takeRun(l, r.start, k);
+            left -= k;
+            pieces += 1;
+        }
+        if (left > 0) return error.PastReservation; // a promise always has its pages free
+        a.stats.fallbacks += 1;
+        a.stats.fallback_pieces += pieces;
+        return false;
+    }
+
+    fn longerFirst(_: void, x: Run, y: Run) bool {
+        return x.len > y.len or (x.len == y.len and x.start < y.start);
+    }
+
+    /// `l`'s first `n` pages (its table empty), from its promise: one run when one holds them (see the top).
+    pub fn cover(a: *Alloc, l: *Lease, n: usize) !void {
+        if (l.ids.items.len != 0) return error.LeaseTaken;
+        a.stats.covers += 1;
+        const one = try a.place(l, n);
+        if (one) a.stats.one_run += 1;
+    }
+
+    /// `k` more pages after `l`'s last, from its promise: in place when the pages right after its last one are free,
+    /// else a best-fit run of the k, else scattered (a fallback).
+    pub fn grow(a: *Alloc, l: *Lease, k: usize) !void {
+        if (k == 0) return;
+        if (l.ids.items.len == 0) return a.cover(l, k);
+        if (l.promised < k) return error.PastReservation;
+        a.stats.grown += 1;
+        const last = l.ids.items[l.ids.items.len - 1];
+        const from: usize = @as(usize, last) + 1;
+        if (from + k <= a.refs.len and std.mem.allEqual(u32, a.refs[from..][0..k], 0)) {
+            try l.ids.ensureUnusedCapacity(a.gpa, k);
+            a.takeRun(l, @intCast(from), k);
+            a.stats.grown_in_place += 1;
+            return;
+        }
+        if (try a.place(l, k)) a.stats.grown_run += 1;
+    }
+
+    /// The stream ended: its promise and its pages go back (a page a kept state holds stays with it).
+    pub fn finish(a: *Alloc, l: *Lease) void {
+        a.unpromise(l);
+        for (l.ids.items) |id| {
+            if (a.refs[id] == 0) std.debug.panic("inkling2 pages: page {d} given back while free", .{id});
+            a.refs[id] -= 1;
+            if (a.refs[id] == 0) a.nfree += 1;
+        }
+        l.ids.deinit(a.gpa);
+        l.* = .{};
+    }
+
+    /// The runs of consecutive ids in `ids` (a stream's table), for the log.
+    pub fn runsOf(ids: []const u32) usize {
+        if (ids.len == 0) return 0;
+        var n: usize = 1;
+        for (ids[1..], ids[0 .. ids.len - 1]) |b, p| n += @intFromBool(b != p + 1);
+        return n;
+    }
+};
+
+/// Pages a request takes: its prompt, its reply and one verify window (`window` rows past its last token), at most
+/// the slot's table (`entries`).
+pub fn need(prompt: usize, max_new: usize, window: usize, entries: usize) usize {
+    return @min(pagesFor(prompt + max_new + window), entries);
+}
+
+/// The served streams' pool on one rank: the arena (every rank), and on rank 0 the allocator and each slot's lease.
+pub const Pool = struct {
+    gpa: std.mem.Allocator,
+    arena: cuda.DeviceBuffer,
+    place_: Place,
+    regions: usize,
+    slots: u32,
+    entries: usize, // a slot's table: pages(context)
+    leader: bool,
+    alloc: ?Alloc = null, // rank 0's
+    leases: []Lease = &.{}, // rank 0's, a slot each
+    mark: []u8 = &.{}, // rank 0's scratch, a byte a page (`reclaimable`)
+    poison: bool,
+    /// Rank 0: requests the lane host held back for want of pages (each counted once), and the need of the last one.
+    waits: u64 = 0,
+    waiting: ?usize = null,
+    /// Rank 0: the counts /health reads (`shownNow`, any thread), copied by the engine thread (`show`) at each open,
+    /// close and admission check, under `shown_lock`.
+    shown: Shown = .{},
+    shown_lock: std.atomic.Value(bool) = .init(false),
+
+    /// `total` pages (and the scrub page) for `slots` slots of `entries` table entries, `regions` runs of `run` bytes.
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, count: usize, regions: usize, run: u64, slots: u32, entries: usize, leader: bool) !*Pool {
+        if (count == 0 or regions == 0 or run == 0 or slots == 0) return error.BadPool;
+        if (count >= std.math.maxInt(i32)) return error.BadPool;
+        const p = try gpa.create(Pool);
+        errdefer gpa.destroy(p);
+        var arena = try cuda.DeviceBuffer.alloc(d, @intCast(arenaBytes(count + 1, regions, run)));
+        errdefer arena.free();
+        p.* = .{ .gpa = gpa, .arena = arena, .place_ = .{ .base = arena.ptr, .pages = count + 1, .run = run }, .regions = regions, .slots = slots, .entries = entries, .leader = leader, .poison = poisoned() };
+        // the scrub page: zeros (NaN under TF_KV_POISON); never written by a forward, never read
+        for (0..regions) |r| {
+            const view: cuda.DeviceBuffer = .{ .d = d, .ptr = p.place_.region(r) + count * run, .len = @intCast(run), .borrowed = true };
+            try view.fill8(if (p.poison) 0xff else 0, null);
+        }
+        if (leader) {
+            p.alloc = try Alloc.init(gpa, count);
+            errdefer p.alloc.?.deinit();
+            p.leases = try gpa.alloc(Lease, slots);
+            errdefer gpa.free(p.leases);
+            @memset(p.leases, .{});
+            p.mark = try gpa.alloc(u8, count);
+            p.show();
+        }
+        return p;
+    }
+
+    /// Rank 0's engine thread, after a change: the allocator's counts and the admission's wait into `shown`.
+    pub fn show(p: *Pool) void {
+        const s = shownOf(&(p.alloc orelse return), p.waiting, p.waits);
+        while (p.shown_lock.cmpxchgWeak(false, true, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+        p.shown = s;
+        p.shown_lock.store(false, .release);
+    }
+
+    /// Any thread: the counts `show` last copied.
+    pub fn shownNow(p: *Pool) Shown {
+        while (p.shown_lock.cmpxchgWeak(false, true, .acquire, .monotonic) != null) std.atomic.spinLoopHint();
+        const s = p.shown;
+        p.shown_lock.store(false, .release);
+        return s;
+    }
+
+    pub fn deinit(p: *Pool) void {
+        if (p.alloc) |*a| {
+            for (p.leases) |*l| a.finish(l);
+            a.deinit();
+        }
+        if (p.leases.len > 0) p.gpa.free(p.leases);
+        if (p.mark.len > 0) p.gpa.free(p.mark);
+        p.arena.free();
+        p.gpa.destroy(p);
+    }
+
+    pub fn place(p: *const Pool) Place {
+        return p.place_;
+    }
+
+    /// Pages handed out (the scrub page not counted).
+    pub fn total(p: *const Pool) usize {
+        return p.place_.pages - 1;
+    }
+
+    /// Rank 0: whether a request needing `n` pages fits now.
+    pub fn fits(p: *const Pool, n: usize) bool {
+        const a = p.alloc orelse return false;
+        return a.fits(n);
+    }
+
+    /// Rank 0: slot `slot` takes `n` pages (promised and covered: one run when one holds them); its ids, in position
+    /// order. `adopt`: a kept state's pages (the prompt cache on pages), the first of the n, adopted (one more holder
+    /// each) and the rest taken after them (`grow`: in place when free). LaneMemory: not now (the request waits);
+    /// RequestOverPool: never (more than the pool).
+    pub fn open(p: *Pool, slot: u32, n: usize, adopt: []const u32) ![]const u32 {
+        const a = &(p.alloc orelse return error.NotLeader);
+        defer p.show();
+        if (slot >= p.slots) return error.NoSlot;
+        if (n == 0 or n > p.entries or adopt.len > n) return error.PastContext;
+        if (n > a.total()) return error.RequestOverPool;
+        const l = &p.leases[slot];
+        const fb = a.stats.fallbacks;
+        if (adopt.len > 0) {
+            // the stream resumes a kept state: what the slot held goes back (a kept page stays with its state)
+            a.finish(l);
+            try a.promise(l, n - adopt.len);
+            errdefer a.finish(l);
+            try a.adopt(l, adopt);
+            try a.grow(l, n - adopt.len);
+            a.stats.resumed += 1;
+            a.stats.resumed_pages += adopt.len;
+            if (Alloc.runsOf(l.ids.items) == 1) a.stats.resumed_one_run += 1;
+            if (a.stats.fallbacks > fb) logFallback(p, slot, l.ids.items);
+            return l.ids.items;
+        }
+        if (l.ids.items.len > 0 and a.anyKept(l.ids.items)) a.finish(l); // a kept state holds some: never rewritten
+        if (l.ids.items.len > 0) {
+            // the slot's stream opens again (its pages kept): what it holds serves, grown past it when it needs more
+            if (l.ids.items.len >= n) return l.ids.items;
+            try a.promise(l, n - l.ids.items.len);
+            errdefer a.unpromise(l);
+            try a.grow(l, n - l.ids.items.len);
+            if (a.stats.fallbacks > fb) logFallback(p, slot, l.ids.items);
+            return l.ids.items;
+        }
+        a.unpromise(l);
+        try a.promise(l, n);
+        errdefer a.finish(l);
+        try a.cover(l, n);
+        if (a.stats.fallbacks > fb) logFallback(p, slot, l.ids.items);
+        return l.ids.items;
+    }
+
+    fn logFallback(p: *const Pool, slot: u32, ids: []const u32) void {
+        if (@import("builtin").is_test) return;
+        const a = p.alloc.?;
+        std.log.warn("inkling2 pages: slot {d}'s {d} pages taken scattered in {d} runs (no free run held them; {d} free in all): fallback {d} since start", .{ slot, ids.len, Alloc.runsOf(ids), a.nfree, a.stats.fallbacks });
+    }
+
+    /// Rank 0: the stream on slot `slot` ended; its pages go back. Logs the idle census when no slot holds any.
+    pub fn close(p: *Pool, slot: u32) void {
+        const a = &(p.alloc orelse return);
+        if (slot >= p.slots) return;
+        a.finish(&p.leases[slot]);
+        p.show();
+        for (p.leases) |l| if (l.ids.items.len > 0 or l.promised > 0) return;
+        if (@import("builtin").is_test) return;
+        const c = a.census();
+        const s = a.stats;
+        std.log.info("inkling2 pages idle{s}: promised {d}, taken {d} (kept states' {d}), free {d} + kept {d} == total {d}; streams' covers {d}, one run {d}, scattered (fallback) {d} in {d} runs, grown {d} ({d} in place); resumed on kept pages {d} ({d} pages adopted, {d} tables one run); requests that waited for pages {d}", .{ if (a.idle()) "" else " (UNEVEN)", c.promised, c.taken, c.kept, c.free, c.kept, c.total, s.covers, s.one_run, s.fallbacks, s.fallback_pieces, s.grown, s.grown_in_place, s.resumed, s.resumed_pages, s.resumed_one_run, p.waits });
+    }
+
+    /// Rank 0: the pages kept states hold that no stream does and no state in `protect` holds (the reclaim chain could
+    /// free them by dropping the other states).
+    pub fn reclaimable(p: *Pool, protect: []const []const u32) usize {
+        const a = &(p.alloc orelse return 0);
+        return a.reclaimable(protect, p.mark);
+    }
+
+    /// Every rank: `ids`' pages set to NaN in every region (TF_KV_POISON), on `stream`.
+    pub fn poisonPages(p: *const Pool, d: *const cuda.Driver, stream: cuda.Stream, ids: []const u32) !void {
+        if (!p.poison) return;
+        try poisonIn(d, stream, p.place_, p.regions, ids);
+    }
+};
+
+/// `ids`' pages of the arena at `pl` set to NaN in each of `regions` (a run of consecutive ids at once).
+pub fn poisonIn(d: *const cuda.Driver, stream: cuda.Stream, pl: Place, regions: usize, ids: []const u32) !void {
+    return fillIn(d, stream, pl, regions, ids, 0xff);
+}
+
+/// `ids`' pages of the arena at `pl` set to `byte` in each of `regions`, on `stream` (tests and poison).
+pub fn fillIn(d: *const cuda.Driver, stream: cuda.Stream, pl: Place, regions: usize, ids: []const u32, byte: u8) !void {
+    var i: usize = 0;
+    while (i < ids.len) {
+        var j = i + 1;
+        while (j < ids.len and ids[j] == ids[j - 1] + 1) j += 1;
+        for (0..regions) |r| {
+            const at = pl.region(r) + @as(u64, ids[i]) * pl.run;
+            try d.check(d.api.cuMemsetD8Async(at, byte, @intCast((j - i) * pl.run), stream.handle), "cuMemsetD8Async");
+        }
+        i = j;
+    }
+}
