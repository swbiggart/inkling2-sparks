+    for (&all, 0..) |*v, r| v.* = ballot(VoteTest.env(&a), 4, r, true, VoteTest.image);
+    for (&all) |*v| try std.testing.expect(judge(&all, v) == .agreed);
+    // any other setting alike in its shown form but not whole: TF_ROCE's value
+    const xs: [40]u8 = @splat('x');
+    const r1 = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs ++ "a" }};
+    const r2 = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs ++ "b" }};
+    var two: [2]Vote = .{ ballot(VoteTest.env(&r1), 2, 0, true, .unset), undefined };
+    two[1] = ballot(VoteTest.env(&r2), 2, 1, true, .unset);
+    try std.testing.expectEqualStrings(two[0].value(.roce), two[1].value(.roce));
+    try std.testing.expectEqual(Setting.roce, judge(&two, &two[0]).differs.setting.?);
+}
+
+test "inkling2 transport vote: a value longer than any valid one is refused, not compared by a prefix" {
+    const xs: [1100]u8 = @splat('x');
+    const huge = [_][2][]const u8{.{ "TF_ROCE", "1" ++ xs }};
+    const v = ballot(VoteTest.env(&huge), 2, 0, true, .unset);
+    try std.testing.expect(v.ready == 0);
+    try std.testing.expectEqualStrings("TF_ROCE is longer than 1024 bytes", v.reason());
+}
+
+test "inkling2 transport vote: under three ranks or off Linux the mesh setting reads off, and a place mismatch is caught" {
+    const two = ballot(VoteTest.env(&VoteTest.release), 2, 0, true, .unset);
+    try std.testing.expectEqualStrings("off", two.value(.multi));
+    try std.testing.expect(two.ready == 1);
+    const mac = ballot(VoteTest.env(&VoteTest.release), 4, 0, false, .unset);
+    try std.testing.expectEqualStrings("off", mac.value(.multi));
+    var all = VoteTest.four(9, &.{}, .unset);
+    all[2].rank = 1;
+    try std.testing.expect(judge(&all, &all[0]).differs.setting == null);
+}
diff --git a/zig/src/families/inkling2/cuda_xover.zig b/zig/src/families/inkling2/cuda_xover.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0befe501cf2805f57cc43735f6df9961182307ee
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_xover.zig
@@ -0,0 +1,397 @@
+//! W > 1, prompt chunks with split experts and by-rows sums (cuda_xrows.zig): the attention side of a layer in two row
+//! halves, so each half's by-rows attention sum crosses the wire while the other half computes (TF_INK2_XOVERLAP=1).
+//!
+//! One layer, halves a = rows [0, Ra) at pos0 and b = rows [Ra, R) at pos0 + Ra, every collective on the overlap's own
+//! stream N (one stream for all of the forward's collectives, so the communicator's calls keep one order), every other
+//! op on the forward's stream C, events between them:
+//!   C  attnStage(a)  attnStage(b)           mlpPre(a) mlpPre(b) splitUp(R)            downStage(R)          outStage(R)
+//!   N        sum(a) ......... sum(b) ......                       MoE-A(R) .........        MoE-B(R) ...
+//! sum(a) runs under attnStage(b), sum(b) under mlpPre(a). The experts take all R rows at once, so no expert weight is
+//! read twice; MoE-A and MoE-B stay where they were (on N, waited for at once).
+//!
+//! The same bits as the whole-chunk layer: each half is the layer's ops over its rows as a prompt chunk of its own at
+//! its positions (the ops are row-invariant and the prompt path chunk-invariant: the attention reads the keys half a
+//! wrote, each convolution commit takes its half's rows after the half before it), and the by-rows sum gives each row
+//! the whole sum's bits (cuda_xrows.zig). Both halves are above fuse.lat_rows, so they run the chunk's forms. Half b's
+//! partials sit after half a's in the attention partial buffer ([W][Ra][H] then [W][Rb][H], within [W][cap][H]), so
+//! the next half's output projection never writes what a sum still reads. The prompt cache's captures inside the chunk
+//! (cuda_snap.zig) take each mark from the half whose rows reach it.
+//!
+//! The NCCL calls differ from the whole layer's (two by-rows sums of half size): every rank must set the switch alike
+//! (it is in the settings the ranks agree on, cuda_engine.zig agree).
+//!
+//! TF_INK2_XCODES=1 (prompt chunks of at least min_rows rows, split experts, real ranks; with or without the overlap):
+//! MoE-A carries each rank's quantized columns in place of its bf16 ones (cuda_moe.zig splitAmax / splitQuant /
+//! splitDownCodes; inkling2_ck.cu "MoE-A as codes"): NVFP4 layers first gather every rank's segment amax of each
+//! route (R * 8 fp32), then quantize their own columns with the row amax and gather the codes and scales (0.28x the
+//! bf16 bytes); MXFP8 layers quantize and gather (0.52x). The down pass reads the same codes, scales and amax the
+//! whole-row quantizer gives, so the bits are unchanged. The gather's slots use the attention partial buffer (nothing
+//! live there from the attention sum to the down pass). Every rank must set it alike (agree's settings).
+//!
+//! TF_INK2_XOVERLAP=s (a test of the halves' bits on one GPU): at W = 1 the same halves with no exchange and no second
+//! stream: attnStage(a), attnStage(b), mlpPre(a), mlpPre(b), the experts and outStage over all R rows.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const state = @import("cuda_state.zig");
+const tp = @import("cuda_tp.zig");
+const xrows = @import("cuda_xrows.zig");
+const fwd = @import("cuda_forward.zig");
+const moe = @import("cuda_moe.zig");
+
+const Mat = ops.Mat;
+
+/// The fewest rows a chunk splits: halves of at least 288 rows, well above fuse.lat_rows and xrows.min_rows, and every
+/// gather of a half above the RoCE mesh wire's ceiling (the release's 640 KiB a rank: a by-rows bf16 gather of 288
+/// rows at W = 4 is 648 KiB), so all of a split chunk's collectives stay on NCCL.
+pub const min_rows = 576;
+
+var codes_: ?bool = null;
+
+/// TF_INK2_XCODES=1: MoE-A as codes (see the header).
+pub fn codesWanted() bool {
+    if (codes_ == null) codes_ = if (std.c.getenv("TF_INK2_XCODES")) |v| v[0] == '1' else false;
+    return codes_.?;
+}
+
+/// Whether forward `f`'s R-row MoE-A goes as codes: the switch, a prompt chunk of at least min_rows rows (decode
+/// steps and windows keep the bf16 gather), real ranks with split experts, no op hooks, room in the buffer.
+pub fn codes(f: *const fwd.Forward, R: usize) bool {
+    if (!codesWanted() or R < min_rows) return false;
+    if (f.hooks.record != null or f.hooks.feed != null) return false;
+    const x = f.x orelse return false;
+    return x.group != null and x.split() != null and x.codesFit(R);
+}
+
+/// MoE-A as codes and the down pass, after the up pass left this rank's h (its slot, x.hMine): on the forward's
+/// stream, or with `ov` the gathers on its stream N (events between).
+pub fn moeA(f: *fwd.Forward, ov: ?*Overlap, li: u32, R: usize, pos0: usize) !void {
+    _ = pos0;
+    const x = f.x.?;
+    const sp = x.split().?;
+    const l = f.w.layer(li);
+    const nv = l.experts.format == .nvfp4;
+    const s: fwd.Scope = .{ .layer = li };
+    const C = f.c.stream;
+    var cn = f.c;
+    if (ov) |o| cn.stream = o.n;
+    // NVFP4: every rank's segment amax of each route first
+    if (nv) {
+        try f.mark(s, "moe.amax");
+        try moe.splitAmax(&f.c, l, R, x.world, x.hMine(R), x.amaxMine(R));
+        if (ov) |o| try o.handoff(C, o.n, 8);
+        try f.mark(s, "tp.split_amax");
+        try x.gatherCodes(&cn, .amax, nv, R);
+        if (ov) |o| try o.handoff(o.n, C, 9);
+    }
+    try f.mark(s, "moe.quant");
+    try moe.splitQuant(&f.c, l, R, x.world, x.hMine(R), x.amaxAll(R), x.codesMine(nv, R));
+    if (ov) |o| try o.handoff(C, o.n, 4);
+    try f.mark(s, "tp.split_h");
+    try x.gatherCodes(&cn, .codes, nv, R);
+    if (ov) |o| try o.handoff(o.n, C, 5);
+    try f.mark(s, "moe.down");
+    f.c.scratch.reset();
+    const ym = x.yMine(R);
+    try moe.splitDownCodes(&f.c, l, R, .{ .parts = x.codesAll(), .world = x.world, .amaxes = x.amaxAll(R) }, sp.plan, ym, null, .{}); // >= min_rows rows: never a K1 call
+}
+
+pub const Mode = enum { off, on, split };
+
+var mode_: ?Mode = null;
+
+/// TF_INK2_XOVERLAP: 1 prompt chunks overlap their attention sums (see the header), s the halves alone at W = 1 (a
+/// test); unset or 0: the whole layer.
+pub fn mode() Mode {
+    if (mode_ == null) mode_ = if (std.c.getenv("TF_INK2_XOVERLAP")) |v| switch (v[0]) {
+        '1' => .on,
+        's' => .split,
+        else => .off,
+    } else .off;
+    return mode_.?;
+}
+
+/// Whether an engine of `world` ranks (`group`: real ranks) makes the overlap's stream and events.
+pub fn wanted(world: u32, group: bool) bool {
+    return switch (mode()) {
+        .off => false,
+        .on => world > 1 and group,
+        .split => world == 1,
+    };
+}
+
+/// TF_INK2_XOVERLAP_SPLIT=N (1..15, default 8): half a takes about N/16 of a chunk's rows (any split gives the same
+/// bits; it moves how much compute each half's sum hides under).
+pub fn splitSixteenths() usize {
+    if (split_ == null) split_ = if (std.c.getenv("TF_INK2_XOVERLAP_SPLIT")) |v| std.fmt.parseInt(u8, std.mem.span(v), 10) catch 8 else 8;
+    if (split_.? == 0 or split_.? > 15) split_ = 8;
+    return split_.?;
+}
+
+var split_: ?u8 = null;
+
+/// Half a's rows of an R-row chunk at W ranks: a multiple of W (so its by-rows sum needs no padding rows) near
+/// R * n / 16 (n = splitSixteenths()).
+pub fn halfRows(R: usize, world: usize) usize {
+    return partRows(R, world, splitSixteenths());
+}
+
+fn partRows(R: usize, world: usize, n: usize) usize {
+    return world * ((R * n + 16 * world - 1) / (16 * world));
+}
+
+/// The activations of rows [row0, cap) of `a` as a forward of their own (every row-major buffer advanced by row0
+/// rows; the blocks keep their stride). Owns nothing; `one` (rows of at most attn.one_rows) is left as it is. Every
+/// [cap, n] buffer of state.Act is listed (a test checks the count against the struct).
+pub fn actFrom(a: *const state.Act, row0: usize) state.Act {
+    var v = a.*;
+    v.own = .empty;
+    for (&v.h) |*m| m.* = from(m.*, row0);
+    for (&v.x) |*m| m.* = from(m.*, row0);
+    for (&v.xn) |*m| m.* = from(m.*, row0);
+    inline for (.{ "q", "k", "v", "rel", "gate", "sink", "dk", "dv", "kc", "vc", "qh", "kh", "vh", "relh", "o", "ao", "a", "partial", "mx", "m", "ids", "wts", "logits", "y", "cm", "tokens" }) |name| {
+        @field(v, name) = from(@field(a, name), row0);
+    }
+    v.blocks = a.blocks + row0 * weights_hidden * 2;
+    return v;
+}
+
+fn from(m: Mat, row0: usize) Mat {
+    return m.slice(row0, m.rows - row0);
+}
+
+const weights_hidden = @import("cuda_weights.zig").hidden;
+
+/// The overlap's switches as resolved, for the settings every rank agrees on (cuda_engine.zig agree): bytes only
+/// where a switch is on, so a run with every switch off hashes as v0.2's (its default fingerprint test).
+/// Every runner of real ranks that can reach Forward.layer must hash it (cuda_engine.zig agree, cuda_run_main.zig).
+pub fn hashSettings(h: anytype) void {
+    hashOf(h, mode(), splitSixteenths(), codesWanted());
+}
+
+/// hashSettings of given switches (resolved): nothing when the overlap is off and the codes are off.
+pub fn hashOf(h: anytype, m: Mode, split: usize, with_codes: bool) void {
+    if (m != .off) {
+        h.update(" xover:");
+        h.update(@tagName(m));
+        var buf: [16]u8 = undefined;
+        h.update(std.fmt.bufPrint(&buf, " split:{d}", .{split}) catch unreachable);
+    }
+    if (with_codes) h.update(" xcodes:1");
+}
+
+pub const Overlap = struct {
+    d: *const cuda.Driver,
+    /// Layers run in halves (the first one's split is logged).
+    layers: u64 = 0,
+    /// The collectives' stream (highest priority, so a collective's kernel starts as soon as its inputs are there).
+    n: cuda.Stream,
+    ev: [10]cuda.Event,
+
+    pub fn init(d: *const cuda.Driver) !Overlap {
+        var n = try cuda.Stream.initPriority(d, .highest);
+        errdefer n.deinit();
+        var ev: [10]cuda.Event = undefined;
+        var made: usize = 0;
+        errdefer for (ev[0..made]) |*e| e.deinit();
+        for (&ev) |*e| {
+            e.* = try cuda.Event.init(d, false);
+            made += 1;
+        }
+        return .{ .d = d, .n = n, .ev = ev };
+    }
+
+    pub fn deinit(o: *Overlap) void {
+        std.log.info("inkling2 xover: {d} layers ran in halves", .{o.layers});
+        o.n.synchronize() catch {};
+        for (&o.ev) |*e| e.deinit();
+        o.n.deinit();
+    }
+
+    /// Whether forward `f` runs its R-row layers overlapped: real ranks, split experts, by-rows sums for both halves,
+    /// one stream's rows, no op hooks, and room in a.ao for half b's padded sum.
+    pub fn applies(o: *const Overlap, f: *const fwd.Forward, R: usize) bool {
+        _ = o;
+        if (R < min_rows or mode() == .off or f.segs.len != 0) return false;
+        if (f.hooks.record != null or f.hooks.feed != null) return false;
+        if (mode() == .split) return f.x == null and halfRows(R, 1) > fuse_lat_rows;
+        const x = f.x orelse return false;
+        if (x.group == null or x.split() == null) return false;
+        const W: usize = x.world;
+        const Ra = halfRows(R, W);
+        const Rb = R - Ra;
+        if (Rb < min_rows / 2 or Ra < min_rows / 2) return false; // an uneven split keeps each half above the wire too
+        if (!xrows.applies(x, Ra, f.a.ao.rows) or !xrows.applies(x, Rb, f.a.ao.rows - Ra)) return false;
+        return R <= x.parts.cap;
+    }
+
+    fn mark(o: *Overlap, i: usize, s: cuda.Stream) !void {
+        try o.ev[i].record(s);
+    }
+
+    /// Stream `dst` waits for what `src` has queued so far (event i).
+    fn handoff(o: *Overlap, src: cuda.Stream, dst: cuda.Stream, i: usize) !void {
+        try o.ev[i].record(src);
+        try dst.wait(o.ev[i]);
+    }
+
+    /// Layer `li` of forward `f` (R rows at pos0, `applies`), h[0] in, h[0] out.
+    pub fn layer(o: *Overlap, f: *fwd.Forward, li: u32, R: usize, pos0: usize) !void {
+        // a failure after a collective is queued: nothing is left running on N past this layer
+        errdefer o.n.synchronize() catch {};
+        if (o.layers == 0) std.log.info("inkling2 xover: prompt chunks in halves ({t}; first: {d} rows at {d} as {d} + {d})", .{ mode(), R, pos0, halfRows(R, if (f.x) |x| x.world else 1), R - halfRows(R, if (f.x) |x| x.world else 1) });
+        o.layers += 1;
+        if (f.x == null) return splitLayer(f, li, R, pos0);
+        const x = f.x.?;
+        const W: usize = x.world;
+        const Ra = halfRows(R, W);
+        const Rb = R - Ra;
+        const C = f.c.stream;
+        var cn = f.c;
+        cn.stream = o.n;
+        // half b's attention partials after half a's (the sum reads [W][Rb][H] from its own base)
+        var pb = x.parts.*;
+        pb.own = null;
+        pb.split = x.parts.split;
+        pb.ptr[@intFromEnum(tp.Sum.attn)] += @as(u64, W) * Ra * weights_hidden * 4;
+        const xa: tp.Exchange = .{ .rank = x.rank, .world = x.world, .parts = x.parts, .group = x.group };
+        const xb: tp.Exchange = .{ .rank = x.rank, .world = x.world, .parts = &pb, .group = x.group };
+        var va = actFrom(f.a, 0);
+        var vb = actFrom(f.a, Ra);
+        var fa = f.*;
+        fa.a = &va;
+        fa.x = &xa;
+        fa.ov = null;
+        var fb = f.*;
+        fb.a = &vb;
+        fb.x = &xb;
+        fb.ov = null;
+        if (f.capture) |cp| {
+            fa.capture = cp.of(pos0, true);
+            fb.capture = cp.of(pos0 + Ra, false);
+        }
+        errdefer {
+            if (fa.stopped) |s| f.stopped = s;
+            if (fb.stopped) |s| f.stopped = s;
+        }
+        const s: fwd.Scope = .{ .layer = li };
+        // the attention halves; each one's sum on N once its partials are written
+        try fa.attnStage(li, Ra, pos0);
+        try o.mark(0, C);
+        try o.n.wait(o.ev[0]);
+        try f.mark(s, "tp.rows");
+        try xrows.sum(&xa, &cn, .attn, Ra, va.ao);
+        try o.mark(1, o.n);
+        try fb.attnStage(li, Rb, pos0 + Ra);
+        try o.mark(2, C);
+        try o.n.wait(o.ev[2]);
+        try xrows.sum(&xb, &cn, .attn, Rb, vb.ao);
+        try o.mark(3, o.n);
+        // each half from its sum to the router (the summed rows are in a.ao)
+        fa.summed[@intFromEnum(tp.Sum.attn)] = true;
+        fb.summed[@intFromEnum(tp.Sum.attn)] = true;
+        try C.wait(o.ev[1]);
+        try fa.mlpPre(li, Ra, pos0);
+        try C.wait(o.ev[3]);
+        try fb.mlpPre(li, Rb, pos0 + Ra);
+        if (va.nblocks != vb.nblocks) return error.OverlapBlocks;
+        f.a.nblocks = va.nblocks;
+        // the experts over all R rows, MoE-A and MoE-B on N
+        try f.mlpExperts(li, R, pos0);
+        if (codes(f, R)) try moeA(f, o, li, R, pos0) else {
+            try o.mark(4, C);
+            try o.n.wait(o.ev[4]);
+            try f.mark(s, "tp.split_h");
+            try x.gatherSplit(&cn, .h, R);
+            try o.mark(5, o.n);
+            try C.wait(o.ev[5]);
+            try f.downStage(li, R, pos0);
+        }
+        try o.mark(6, C);
+        try o.n.wait(o.ev[6]);
+        try f.mark(s, "tp.split_y");
+        try x.gatherSplit(&cn, .y, R);
+        try o.mark(7, o.n);
+        try C.wait(o.ev[7]);
+        try f.outStage(li, R, pos0);
+    }
+};
+
+const fuse_lat_rows = @import("cuda_fuse.zig").lat_rows;
+
+/// TF_INK2_XOVERLAP=s at W = 1: the halves with no exchange (see the header).
+fn splitLayer(f: *fwd.Forward, li: u32, R: usize, pos0: usize) !void {
+    const Ra = halfRows(R, 1);
+    const Rb = R - Ra;
+    var va = actFrom(f.a, 0);
+    var vb = actFrom(f.a, Ra);
+    var fa = f.*;
+    fa.a = &va;
+    fa.ov = null;
+    var fb = f.*;
+    fb.a = &vb;
+    fb.ov = null;
+    if (f.capture) |cp| {
+        fa.capture = cp.of(pos0, true);
+        fb.capture = cp.of(pos0 + Ra, false);
+    }
+    errdefer {
+        if (fa.stopped) |s| f.stopped = s;
+        if (fb.stopped) |s| f.stopped = s;
+    }
+    try fa.attnStage(li, Ra, pos0);
+    try fb.attnStage(li, Rb, pos0 + Ra);
+    try fa.mlpPre(li, Ra, pos0);
+    try fb.mlpPre(li, Rb, pos0 + Ra);
+    if (va.nblocks != vb.nblocks) return error.OverlapBlocks;
+    f.a.nblocks = va.nblocks;
+    try f.mlpExperts(li, R, pos0);
+    try f.outStage(li, R, pos0);
+}
+
+test "inkling2 cuda xover: every row buffer of Act is shifted" {
+    var n: usize = 0;
+    inline for (@typeInfo(state.Act).@"struct".field_names) |name| {
+        const T = @FieldType(state.Act, name);
+        if (T == Mat) n += 1;
+        if (T == [2]Mat) n += 2;
+        if (T == [3]Mat) n += 3;
+    }
+    // 26 named + h (2) + x (3) + xn (3) + `one` (not shifted)
+    try std.testing.expectEqual(@as(usize, 26 + 2 + 3 + 3 + 1), n);
+}
+
+test "inkling2 cuda xover: the switches' agreement bytes: none when off, distinct when on" {
+    const Sha = std.crypto.hash.sha2.Sha256;
+    const Case = struct { m: Mode, split: usize, codes: bool };
+    const cases = [_]Case{ .{ .m = .off, .split = 8, .codes = false }, .{ .m = .on, .split = 8, .codes = false }, .{ .m = .on, .split = 10, .codes = false }, .{ .m = .off, .split = 8, .codes = true }, .{ .m = .on, .split = 8, .codes = true }, .{ .m = .split, .split = 8, .codes = false } };
+    var got: [cases.len][32]u8 = undefined;
+    for (cases, 0..) |c, i| {
+        var h = Sha.init(.{});
+        h.update("base");
+        hashOf(&h, c.m, c.split, c.codes);
+        h.final(&got[i]);
+    }
+    var base: [32]u8 = undefined;
+    Sha.hash("base", &base, .{});
+    // all off: the base's own digest (v0.2's bytes); any switch on: a digest of its own
+    try std.testing.expectEqualSlices(u8, &base, &got[0]);
+    for (1..cases.len) |i| for (0..i) |j| try std.testing.expect(!std.mem.eql(u8, &got[i], &got[j]));
+}
+
+test "inkling2 cuda xover: halves" {
+    try std.testing.expectEqual(@as(usize, 1024), partRows(2048, 4, 8));
+    try std.testing.expectEqual(@as(usize, 984), partRows(1967, 4, 8));
+    try std.testing.expectEqual(@as(usize, 1024), partRows(2048, 2, 8));
+    try std.testing.expectEqual(@as(usize, 288), partRows(576, 4, 8));
+    try std.testing.expectEqual(@as(usize, 1152), partRows(2048, 4, 9));
+    try std.testing.expectEqual(@as(usize, 1280), partRows(2048, 4, 10));
+    try std.testing.expectEqual(@as(usize, 496), partRows(992, 1, 8));
+    // half b's padded by-rows sum stays inside the chunk's rows rounded up to W
+    for ([_]usize{ 576, 577, 1000, 1967, 2045, 2047, 2048 }) |R| for ([_]usize{ 2, 4 }) |W| for ([_]usize{ 8, 9, 10 }) |n| {
+        const Ra = partRows(R, W, n);
+        try std.testing.expect(Ra % W == 0 and Ra < R);
+        const Sb = (R - Ra + W - 1) / W;
+        try std.testing.expect(Ra + W * Sb <= W * ((R + W - 1) / W));
+    };
+}
diff --git a/zig/src/families/inkling2/cuda_xrows.zig b/zig/src/families/inkling2/cuda_xrows.zig
new file mode 100644
index 0000000000000000000000000000000000000000..76fec37f7cf1fde88842d1f813b3f7490e5e7597
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_xrows.zig
@@ -0,0 +1,107 @@
+//! W > 1, prompt chunks: a layer's rank-order sum (cuda_tp.zig) by rows instead of whole. Rank r owns rows
+//! [r*S, r*S + n_r) of the forward (S = ceil(R / W)); every rank sends each other rank that rank's rows of its fp32
+//! partial (one NCCL send/recv group), sums its own rows over the ranks in rank order (res.rankSumRows: the same adds
+//! in the same order as res.rankSum, so every row's bits are those of the whole sum), and the bf16 rows are
+//! all-gathered in rank order, S rows a rank, straight into the sum's output (rows R .. W*S - 1 of it are scratch).
+//!
+//! Bytes a rank receives for one sum: (W-1) * S * H * 4 + (W-1) * S * H * 2, against (W-1) * R * H * 4 for the
+//! all-gather of whole partials: at W = 4 and 2048 rows 28.3 + 14.2 MB against 113 MB (2.7x less); at W = 2,
+//! 18.9 + 9.4 against 37.7 (1.3x less). Decode-sized forwards keep the whole all-gather (one collective, no
+//! send/recv group): below `min_rows`.
+//!
+//! Opt-in (TF_INK2_XROWS=1): the send/recv group connects every pair of ranks, which a switch carries but the
+//! four-Spark switchless ring does not (its non-neighbours have no direct route; NCCL's own collectives follow the
+//! ring). The bits are the same either way, but the NCCL calls are not: set it on every rank or none. At W = 2
+//! over PCIe on one host it gains nothing (1.33x fewer bytes against a second collective); the Sparks at W = 4 on a
+//! switch are where it is meant to pay.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const res = @import("cuda_res.zig");
+const tp = @import("cuda_tp.zig");
+const weights = @import("cuda_weights.zig");
+
+const Mat = ops.Mat;
+const Ctx = ops.Ctx;
+const H = weights.hidden;
+
+/// The fewest rows a forward sums by rows.
+pub const min_rows = 64;
+
+var enabled: ?bool = null;
+
+/// TF_INK2_XROWS=1: prompt chunks sum by rows (see the header); unset or 0, the whole all-gather at every row count.
+pub fn wanted() bool {
+    if (enabled == null) enabled = if (std.c.getenv("TF_INK2_XROWS")) |v| v[0] == '1' else false;
+    return enabled.?;
+}
+
+/// Rows a rank owns of a forward of R rows: S = ceil(R / W) each, the last ranks fewer (or none).
+pub fn share(R: usize, world: usize, rank: usize) [2]usize {
+    const S = (R + world - 1) / world;
+    const lo = @min(R, rank * S);
+    return .{ lo, @min(R, lo + S) };
+}
+
+/// Whether a forward of R rows sums by rows: real ranks, R >= min_rows, and the output holds W * S rows.
+pub fn applies(x: *const tp.Exchange, R: usize, out_rows: usize) bool {
+    if (x.group == null or x.world < 2 or R < min_rows or R > x.parts.cap or !wanted()) return false;
+    const S = (R + x.world - 1) / x.world;
+    return S * x.world <= out_rows;
+}
+
+/// Sum `s` of a forward of R rows (fp32 partials) into `out` (bf16, at least W * S rows from row 0; rows 0 .. R - 1
+/// get the sum). Every rank's partial is in its slot of the sum's buffer (tp.Exchange.mine), not yet gathered.
+pub fn sum(x: *const tp.Exchange, c: *const Ctx, s: tp.Sum, R: usize, out: Mat) !void {
+    if (!tp.Timing.enabled()) return run(x, c, s, R, out);
+    try c.stream.synchronize();
+    const t = tp.Timing.now();
+    try run(x, c, s, R, out);
+    try c.stream.synchronize();
+    tp.Timing.ns[@intFromEnum(s)] += tp.Timing.now() - t;
+    tp.Timing.calls[@intFromEnum(s)] += 1;
+}
+
+fn run(x: *const tp.Exchange, c: *const Ctx, s: tp.Sum, R: usize, out: Mat) !void {
+    const g = x.group orelse return error.NoGroup;
+    const W: usize = x.world;
+    const r: usize = x.rank;
+    const S = (R + W - 1) / W;
+    if (!out.is(out.rows, H, .bf16) or !out.dense() or out.rows < W * S) return error.BadExchangeShape;
+    const row = H * 4;
+    const base = x.parts.ptr[@intFromEnum(s)];
+    const slot = R * row; // rank q's partial [R][H] at base + q * slot (tp.Exchange.mine)
+    const own = share(R, W, r);
+    // rank q's rows of this rank's partial to q; this rank's rows of q's partial into q's slot, at their own rows
+    try g.lib.check(g.lib.api.ncclGroupStart(), "ncclGroupStart");
+    const posted: anyerror!void = post: {
+        for (0..W) |q| {
+            if (q == r) continue;
+            const theirs = share(R, W, q);
+            if (theirs[1] > theirs[0]) g.send(c.stream, base + r * slot + theirs[0] * row, (theirs[1] - theirs[0]) * row, q) catch |e| break :post e;
+            if (own[1] > own[0]) g.recv(c.stream, base + q * slot + own[0] * row, (own[1] - own[0]) * row, q) catch |e| break :post e;
+        }
+        break :post {};
+    };
+    try g.lib.check(g.lib.api.ncclGroupEnd(), "ncclGroupEnd"); // the group closes on every path
+    try posted;
+    if (own[1] > own[0]) try res.rankSumRows(c, base + own[0] * row, W, slot, out.slice(own[0], own[1] - own[0]));
+    // every rank's S rows (the last ranks' padded with scratch rows) into out in rank order
+    try g.allGather(c.stream, out.row(r * S), out.ptr, S * H * 2);
+}
+
+test "inkling2 cuda xrows: shares" {
+    try std.testing.expectEqual([2]usize{ 0, 512 }, share(2048, 4, 0));
+    try std.testing.expectEqual([2]usize{ 1536, 2048 }, share(2048, 4, 3));
+    // 1967 rows: 492 a rank, the last 491
+    try std.testing.expectEqual([2]usize{ 984, 1476 }, share(1967, 4, 2));
+    try std.testing.expectEqual([2]usize{ 1476, 1967 }, share(1967, 4, 3));
+    // 65 rows at W = 4: 17, 17, 17, 14
+    try std.testing.expectEqual([2]usize{ 51, 65 }, share(65, 4, 3));
+    var n: usize = 0;
+    for (0..4) |q| {
+        const x = share(1967, 4, q);
+        n += x[1] - x[0];
+    }
+    try std.testing.expectEqual(@as(usize, 1967), n);
+}
diff --git a/zig/src/families/inkling2/describe.zig b/zig/src/families/inkling2/describe.zig
new file mode 100644
index 0000000000000000000000000000000000000000..106becab81cc96b7f3d09127801aa889f5f8c145
--- /dev/null
+++ b/zig/src/families/inkling2/describe.zig
@@ -0,0 +1,167 @@
+//! The checkpoint read as one plan: config, manifest, inventory, roles and a rank split checked together, and the
+//! per-rank memory table and byte ranges printed from it (tf-inkling2-plan, and the native host's refusal).
+const std = @import("std");
+const config = @import("config.zig");
+const quant = @import("quant.zig");
+const inventory = @import("inventory.zig");
+const roles_mod = @import("roles.zig");
+const plan = @import("plan.zig");
+const Diag = @import("diag.zig").Diag;
+
+pub const gib: f64 = 1 << 30;
+
+/// Everything read and checked for one split.
+pub const Model = struct {
+    gpa: std.mem.Allocator,
+    c: config.Config,
+    m: quant.Manifest,
+    inv: inventory.Inventory,
+    roles: []roles_mod.Role,
+    p: plan.Plan,
+    cov: plan.Coverage,
+
+    /// From the three texts (config.json, hf_quant_config.json, the inventory's text form).
+    pub fn fromTexts(gpa: std.mem.Allocator, config_json: []const u8, quant_json: []const u8, inventory_text: []const u8, split: Want, d: ?*Diag) !Model {
+        const c = try config.parse(gpa, config_json, d);
+        var m = try quant.parse(gpa, quant_json, d);
+        errdefer m.deinit();
+        var inv = try inventory.Inventory.fromText(gpa, inventory_text, d);
+        errdefer inv.deinit();
+        return finish(gpa, c, m, inv, split, d);
+    }
+
+    /// From a checkpoint folder: its config.json, hf_quant_config.json and safetensors headers.
+    pub fn fromDir(gpa: std.mem.Allocator, io: std.Io, dir: []const u8, split: Want, d: ?*Diag) !Model {
+        const c = try config.Config.read(gpa, io, dir, d);
+        var m = try quant.Manifest.read(gpa, io, dir, d);
+        errdefer m.deinit();
+        var inv = try inventory.Inventory.fromDir(gpa, io, dir, d);
+        errdefer inv.deinit();
+        return finish(gpa, c, m, inv, split, d);
+    }
+
+    fn finish(gpa: std.mem.Allocator, c: config.Config, m: quant.Manifest, inv: inventory.Inventory, want: Want, d: ?*Diag) !Model {
+        var out: Model = .{ .gpa = gpa, .c = c, .m = m, .inv = inv, .roles = &.{}, .p = undefined, .cov = undefined };
+        out.roles = try roles_mod.classifyAll(gpa, &out.c, &out.m, &out.inv, d);
+        errdefer gpa.free(out.roles);
+        if (want.layout == .split and want.experts.len > 0) return @import("diag.zig").fail(d, error.BadInkling2Split, "split experts take a world size, not expert counts", .{});
+        var split = if (want.layout == .split) try plan.Split.sliced(&out.c, want.world, d) else if (want.experts.len > 0) try plan.Split.uneven(&out.c, want.experts, d) else try plan.Split.even(&out.c, want.world, d);
+        if (want.drafter) |r| {
+            if (r >= split.world) return @import("diag.zig").fail(d, error.BadInkling2Split, "drafter rank {d} is not below world size {d}", .{ r, split.world });
+            split.drafter = r;
+        }
+        out.p = try plan.build(gpa, &out.c, &out.inv, out.roles, split);
+        errdefer out.p.deinit();
+        out.cov = try plan.verify(gpa, &out.p, &out.inv, out.roles, d);
+        return out;
+    }
+
+    pub fn deinit(x: *Model) void {
+        x.p.deinit();
+        x.gpa.free(x.roles);
+        x.inv.deinit();
+        x.m.deinit();
+        x.* = undefined;
+    }
+
+    /// Bytes of keys and values one position takes on rank `r` across the global layers (the paged pool).
+    pub fn kvPerPosition(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        return @as(u64, t.globalCount()) * 2 * x.p.ranks[r].kv.len() * t.head_dim * 2;
+    }
+
+    /// Bytes of the sliding layers' key and value rings for one stream on rank `r` (a full window each).
+    pub fn windowPerStream(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        return @as(u64, t.layers - t.globalCount()) * t.window * 2 * x.p.ranks[r].kv.len() * t.swa_head_dim * 2;
+    }
+
+    /// Bytes of one stream's convolution state on rank `r`: 3 rows of the four convolutions a layer, in fp32.
+    pub fn convPerStream(x: *const Model, r: u32) u64 {
+        const t = &x.c.text;
+        const kv = @as(u64, x.p.ranks[r].kv.len()) * t.head_dim;
+        return @as(u64, t.layers) * (t.conv_taps - 1) * (2 * @as(u64, t.hidden) + 2 * kv) * 4;
+    }
+};
+
+/// The split a caller asks for: a world size (even experts), or explicit expert counts; the drafter's rank.
+pub const Want = struct {
+    world: u32 = 4,
+    experts: []const u32 = &.{},
+    drafter: ?u32 = null,
+    /// Whole experts a rank, or a 1/W row slice of every expert on every rank (plan.zig `Layout`).
+    layout: plan.Layout = .whole,
+};
+
+fn g(b: u64) f64 {
+    return @as(f64, @floatFromInt(b)) / gib;
+}
+
+/// The per-rank memory table, as the plan's section 2 gives it.
+pub fn report(w: *std.Io.Writer, x: *const Model, positions: u64, streams: u64) !void {
+    const t = &x.c.text;
+    const s = x.p.split;
+    try w.print("Inkling-2-Small: {d} layers ({d} global), {d} experts ({d} a token), {d} tensors in {d} files, {d:.1} GiB\n", .{ t.layers, t.globalCount(), t.experts, t.topk, x.inv.tensors.len, x.inv.files.len, g(x.cov.total) });
+    if (x.c.unknown > 0) try w.print("config.json: {d} keys not known to this parser (first: {s})\n", .{ x.c.unknown, x.c.firstUnknown() });
+    try w.print("world {d}: experts", .{s.world});
+    if (s.layout == .split) try w.print(" split (all {d} on every rank, a 1/{d} row slice of each)", .{ t.experts, s.world }) else for (s.experts[0..s.world], 0..) |n, i| try w.print("{s}{d}", .{ if (i == 0) " " else "/", n });
+    try w.print("; drafter on rank {d}; coverage: every byte on one rank, {d:.2} GiB replicated on all\n\n", .{ s.drafter, g(x.cov.replicated) });
+    try w.writeAll("rank  q heads  kv heads  experts    | experts  attention  replicated  embed+unembed  vision  drafter | weights  KV pool  total GiB\n");
+    for (x.p.ranks) |r| {
+        const b = r.bytes;
+        const pool = x.kvPerPosition(r.rank) * positions;
+        try w.print("{d:>4}  {d:>2}-{d:<2}    {d}-{d}       {d:>3}-{d:<3}    | {d:>7.1}  {d:>9.1}  {d:>10.1}  {d:>13.1}  {d:>6.1}  {d:>7.1} | {d:>7.1}  {d:>7.1}  {d:>9.1}\n", .{
+            r.rank,                                 r.q.lo,                                  r.q.hi - 1,                               r.kv.lo,                                    r.kv.hi - 1,
+            r.experts.lo,                           r.experts.hi - 1,                        g(b[@backingInt(plan.Category.experts)]), g(b[@backingInt(plan.Category.attention)]), g(b[@backingInt(plan.Category.replicated)]),
+            g(b[@backingInt(plan.Category.embed)]), g(b[@backingInt(plan.Category.vision)]), g(b[@backingInt(plan.Category.drafter)]), g(r.total()),                               g(pool),
+            g(r.total() + pool),
+        });
+    }
+    const r0 = x.p.ranks[0].rank;
+    try w.print("\nKV pool: {d} positions, {d} bytes a position a rank (the {d} global layers' keys and values, bf16)\n", .{ positions, x.kvPerPosition(r0), t.globalCount() });
+    try w.print("per stream, rank 0: sliding-window rings {d:.3} GiB, convolution state {d:.1} MiB; {d} streams: {d:.2} GiB\n", .{
+        g(x.windowPerStream(r0)), @as(f64, @floatFromInt(x.convPerStream(r0))) / (1 << 20), streams, g((x.windowPerStream(r0) + x.convPerStream(r0)) * streams),
+    });
+    try w.writeAll("not counted: scratch, the CUDA context and transport buffers (the plan estimates 3 GiB a rank)\n");
+}
+
+/// Rank `rank`'s byte ranges, one line a tensor: file, absolute offset, run length, stride, runs, tensor name.
+pub fn ranges(w: *std.Io.Writer, x: *const Model, rank: u32) !void {
+    try w.writeAll("# file\toffset\tlen\tstride\tcount\tplacement\ttensor\n");
+    for (x.p.ranks[rank].pieces) |piece| {
+        const t = x.inv.tensors[piece.tensor];
+        const r = piece.run;
+        try w.print("{s}\t{d}\t{d}\t{d}\t{d}\t{t}\t{s}\n", .{ x.inv.files[r.file].name, r.offset, r.len, r.stride, r.count, x.p.split.placed(x.roles[piece.tensor]), t.name });
+    }
+}
+
+test "inkling2 describe: the release's table at W = 4 and its ranges" {
+    var d: Diag = .{};
+    var x = Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .world = 4 }, &d) catch |e| {
+        std.debug.print("{s}\n", .{d.text()});
+        return e;
+    };
+    defer x.deinit();
+    try std.testing.expectEqual(@as(u64, 8192), x.kvPerPosition(0)); // 8.2 KB a token a rank
+    try std.testing.expectEqual(@as(u64, 4 << 30), x.kvPerPosition(0) * 524288);
+    var out: std.Io.Writer.Allocating = .init(std.testing.allocator);
+    defer out.deinit();
+    try report(&out.writer, &x, 524288, 8);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "world 4: experts 96/96/96/96; drafter on rank 3") != null);
+    out.clearRetainingCapacity();
+    try ranges(&out.writer, &x, 1);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "q_cols\tmodel.llm.layers.0.attn.wo_ud.weight") != null);
+    var u = try Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .experts = &.{ 93, 97, 97, 97 }, .drafter = 2 }, null);
+    defer u.deinit();
+    try std.testing.expectEqual(@as(u32, 93), u.p.ranks[0].experts.len());
+    try std.testing.expect(u.p.ranks[2].bytes[@backingInt(plan.Category.drafter)] > 3 << 30);
+    var sp = try Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .world = 4, .layout = .split }, null);
+    defer sp.deinit();
+    out.clearRetainingCapacity();
+    try report(&out.writer, &sp, 524288, 8);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "world 4: experts split (all 384 on every rank, a 1/4 row slice of each)") != null);
+    out.clearRetainingCapacity();
+    try ranges(&out.writer, &sp, 1);
+    try std.testing.expect(std.mem.indexOf(u8, out.written(), "replicated\tmodel.llm.layers.0.mlp.experts.w13_weight_amax") != null);
+    try std.testing.expectError(error.BadInkling2Split, Model.fromTexts(std.testing.allocator, config.fixture, quant.fixture, inventory.fixture, .{ .experts = &.{ 93, 97, 97, 97 }, .layout = .split }, null));
+}
diff --git a/zig/src/families/inkling2/diag.zig b/zig/src/families/inkling2/diag.zig
new file mode 100644
index 0000000000000000000000000000000000000000..69553b3dbeefeb20473ccd4e704e75e31030f9de
--- /dev/null
+++ b/zig/src/families/inkling2/diag.zig
@@ -0,0 +1,22 @@
+//! Why a check refused: one line the caller prints or hands back as the open's problem.
+const std = @import("std");
+
+pub const Diag = struct {
+    buf: [400]u8 = undefined,
+    len: usize = 0,
+
+    pub fn set(d: *Diag, comptime fmt: []const u8, args: anytype) void {
+        const out = std.fmt.bufPrint(&d.buf, fmt, args) catch d.buf[0..];
+        d.len = out.len;
+    }
+
+    pub fn text(d: *const Diag) []const u8 {
+        return d.buf[0..d.len];
+    }
+};
+
+/// `d.set(fmt, args)` when `d` is given; always returns `err` so callers write `return fail(d, error.X, ...)`.
+pub fn fail(d: ?*Diag, err: anytype, comptime fmt: []const u8, args: anytype) @TypeOf(err) {
+    if (d) |x| x.set(fmt, args);
+    return err;
+}
diff --git a/zig/src/families/inkling2/digests.zig b/zig/src/families/inkling2/digests.zig
new file mode 100644
index 0000000000000000000000000000000000000000..dcbcf038ead6a1a9a3872da80154c08e541cd4c0
--- /dev/null
+++ b/zig/src/families/inkling2/digests.zig
@@ -0,0 +1,329 @@
+//! Content digests of a rank plan's pieces: xxh64 (seed 0) of each piece's bytes as the loader reads them (a
+//! strided run's rows in order). `tf-inkling2-plan --dir SOURCE --world W --digests OUT` hashes every rank's pieces
+//! from the source checkpoint into one manifest all ranks share; tf-inkling2-cuda hashes the bytes as it loads them
+//! (cuda_weights.zig, no second pass) and checks its own pieces against the manifest's lines for its rank.
+//!
+//! xxh64, not std's XxHash3: in Zig 0.17 XxHash3's streaming update runs at about 0.3 GB/s, XxHash64's near 9 GB/s.
+//!
+//! Manifest: a header line, then `rank file offset len stride count tensor xxh64` (tab-separated, xxh64 in hex).
+const std = @import("std");
+const describe = @import("describe.zig");
+const plan = @import("plan.zig");
+
+pub const header = "# inkling2 content digests: xxh64 (seed 0) of each piece's bytes in load order\n# rank\tfile\toffset\tlen\tstride\tcount\ttensor\txxh64\n";
+
+/// A loaded piece (plan.Rank.pieces[piece]) and the xxh64 of its bytes.
+pub const Digest = struct { piece: u32, xxh64: u64 };
+
+/// The run's bytes, rows in order, read `buf.len` at a time.
+pub fn hashRun(io: std.Io, f: std.Io.File, r: plan.Run, buf: []u8) !u64 {
+    var h = std.hash.XxHash64.init(0);
+    if (r.count == 1) {
+        var done: u64 = 0;
+        while (done < r.len) {
+            const n: usize = @intCast(@min(r.len - done, buf.len));
+            if (try f.readPositionalAll(io, buf[0..n], r.offset + done) != n) return error.ShortRead;
+            h.update(buf[0..n]);
+            done += n;
+        }
+    } else {
+        if (r.len > buf.len) return error.RunTooLong;
+        const per: u64 = @max(1, buf.len / r.len);
+        var k: u64 = 0;
+        while (k < r.count) {
+            const n = @min(per, r.count - k);
+            for (0..n) |j| {
+                const at: usize = @intCast(j * r.len);
+                if (try f.readPositionalAll(io, buf[at..][0..@intCast(r.len)], r.offset + (k + j) * r.stride) != r.len) return error.ShortRead;
+            }
+            h.update(buf[0..@intCast(n * r.len)]);
+            k += n;
+        }
+    }
+    if (comptime @import("builtin").os.tag == .linux) {
+        const span = (r.count - 1) * r.stride + r.len;
+        _ = std.os.linux.fadvise(f.handle, @intCast(r.offset), @intCast(span), std.os.linux.POSIX_FADV.DONTNEED);
+    }
+    return h.final();
+}
+
+/// Whether piece `p` of the plan is in layers [lo, hi) (null: every piece).
+fn wanted(m: *const describe.Model, p: plan.Piece, layers: ?[2]u32) bool {
+    const r = layers orelse return true;
+    const li = m.roles[p.tensor].layer orelse return false;
+    return li >= r[0] and li < r[1];
+}
+
+const Job = struct {
+    io: std.Io,
+    dir: []const u8,
+    m: *const describe.Model,
+    runs: []const plan.Run,
+    out: []u64,
+    next: std.atomic.Value(usize) = .init(0),
+    bytes: std.atomic.Value(u64) = .init(0),
+
+    fn work(j: *Job, gpa: std.mem.Allocator, failed: *?anyerror) void {
+        j.loop(gpa) catch |e| {
+            failed.* = e;
+            j.next.store(j.runs.len, .release);
+        };
+    }
+
+    fn loop(j: *Job, gpa: std.mem.Allocator) !void {
+        const buf = try gpa.alloc(u8, 64 << 20);
+        defer gpa.free(buf);
+        const files = try gpa.alloc(?std.Io.File, j.m.inv.files.len);
+        defer gpa.free(files);
+        @memset(files, null);
+        defer for (files) |f| if (f) |x| x.close(j.io);
+        while (true) {
+            const i = j.next.fetchAdd(1, .acq_rel);
+            if (i >= j.runs.len) return;
+            const r = j.runs[i];
+            if (files[r.file] == null) {
+                const path = try std.fs.path.join(gpa, &.{ j.dir, j.m.inv.files[r.file].name });
+                defer gpa.free(path);
+                files[r.file] = try std.Io.Dir.cwd().openFile(j.io, path, .{});
+            }
+            j.out[i] = try hashRun(j.io, files[r.file].?, r, buf);
+            _ = j.bytes.fetchAdd(r.bytes(), .acq_rel);
+        }
+    }
+};
+
+/// Every rank's pieces (in layers [lo, hi) when given) hashed from checkpoint `dir` with `jobs` threads, written as a
+/// manifest to `w`; a run several ranks share (a replicated tensor) is read once.
+pub fn write(gpa: std.mem.Allocator, io: std.Io, w: *std.Io.Writer, dir: []const u8, m: *const describe.Model, layers: ?[2]u32, jobs: usize) !void {
+    var index: std.AutoHashMapUnmanaged(plan.Run, usize) = .empty;
+    defer index.deinit(gpa);
+    var runs: std.ArrayList(plan.Run) = .empty;
+    defer runs.deinit(gpa);
+    var total: u64 = 0;
+    for (m.p.ranks) |rank| for (rank.pieces) |p| if (wanted(m, p, layers)) {
+        const gop = try index.getOrPut(gpa, p.run);
+        if (!gop.found_existing) {
+            gop.value_ptr.* = runs.items.len;
+            try runs.append(gpa, p.run);
+            total += p.run.bytes();
+        }
+    };
+    // largest first, so the last runs left are small ones
+    const order = try gpa.alloc(usize, runs.items.len);
+    defer gpa.free(order);
+    for (order, 0..) |*o, i| o.* = i;
+    std.mem.sort(usize, order, runs.items, struct {
+        fn lt(rs: []const plan.Run, a: usize, b: usize) bool {
+            return rs[a].bytes() > rs[b].bytes();
+        }
+    }.lt);
+    const sorted = try gpa.alloc(plan.Run, runs.items.len);
+    defer gpa.free(sorted);
+    for (sorted, order) |*s, o| s.* = runs.items[o];
+    const out = try gpa.alloc(u64, runs.items.len);
+    defer gpa.free(out);
+    var job: Job = .{ .io = io, .dir = dir, .m = m, .runs = sorted, .out = out };
+    const clock = std.Io.Clock.awake;
+    const t0 = clock.now(io).toNanoseconds();
+    std.debug.print("hashing {d} runs, {d:.2} GiB, {d} threads\n", .{ runs.items.len, @as(f64, @floatFromInt(total)) / (1 << 30), jobs });
+    const threads = try gpa.alloc(std.Thread, @max(1, jobs));
+    defer gpa.free(threads);
+    const failed = try gpa.alloc(?anyerror, threads.len);
+    defer gpa.free(failed);
+    @memset(failed, null);
+    for (threads, failed) |*t, *e| t.* = try std.Thread.spawn(.{}, Job.work, .{ &job, gpa, e });
+    var last: i96 = t0;
+    while (job.next.load(.acquire) < sorted.len) {
+        std.Io.sleep(io, .fromMilliseconds(500), .awake) catch {};
+        const now = clock.now(io).toNanoseconds();
+        if (now - last > 30 * std.time.ns_per_s) {
+            last = now;
+            const b = job.bytes.load(.acquire);
+            std.debug.print("  {d:.1} of {d:.1} GiB, {d:.0} MB/s\n", .{ @as(f64, @floatFromInt(b)) / (1 << 30), @as(f64, @floatFromInt(total)) / (1 << 30), @as(f64, @floatFromInt(b)) / (@as(f64, @floatFromInt(now - t0)) * 1e-3) });
+        }
+    }
+    for (threads) |t| t.join();
+    for (failed) |f| if (f) |e| return e;
+    const s = @as(f64, @floatFromInt(clock.now(io).toNanoseconds() - t0)) * 1e-9;
+    std.debug.print("hashed {d:.2} GiB in {d:.1} s ({d:.0} MB/s)\n", .{ @as(f64, @floatFromInt(total)) / (1 << 30), s, @as(f64, @floatFromInt(total)) / s / 1e6 });
+    // sorted position of each unique run
+    const at = try gpa.alloc(usize, runs.items.len);
+    defer gpa.free(at);
+    for (order, 0..) |o, i| at[o] = i;
+    try w.writeAll(header);
+    for (m.p.ranks) |rank| for (rank.pieces) |p| if (wanted(m, p, layers)) {
+        const r = p.run;
+        try w.print("{d}\t{s}\t{d}\t{d}\t{d}\t{d}\t{s}\t{x:0>16}\n", .{ rank.rank, m.inv.files[r.file].name, r.offset, r.len, r.stride, r.count, m.inv.tensors[p.tensor].name, out[at[index.get(r).?]] });
+    };
+}
+
+pub const Checked = struct {
+    pieces: usize = 0,
+    differ: usize = 0,
+    missing: usize = 0,
+    /// xxh64 over the loaded pieces' digests in plan order: this rank's loaded contents in one number.
+    loaded: u64 = 0,
+    /// The first piece that differs or is missing.
+    first: ?[]const u8 = null,
+};
+
+/// Rank `rank`'s loaded digests `got` against manifest `text`: every loaded piece must have a line for this rank with
+/// the same file, run and digest. Mismatches are logged; the caller fails on `differ + missing > 0`.
+pub fn check(gpa: std.mem.Allocator, text: []const u8, m: *const describe.Model, rank: u32, got: []const Digest) !Checked {
+    const Line = struct { file: []const u8, run: [4]u64, xxh64: u64 };
+    var map: std.StringHashMapUnmanaged(Line) = .empty;
+    defer map.deinit(gpa);
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        var f: [8][]const u8 = undefined;
+        var it = std.mem.splitScalar(u8, line, '\t');
+        for (&f) |*x| x.* = it.next() orelse return error.BadDigestManifest;
+        if (it.next() != null) return error.BadDigestManifest;
+        if ((std.fmt.parseInt(u32, f[0], 10) catch return error.BadDigestManifest) != rank) continue;
+        var run: [4]u64 = undefined;
+        for (&run, f[2..6]) |*v, s| v.* = std.fmt.parseInt(u64, s, 10) catch return error.BadDigestManifest;
+        try map.put(gpa, f[6], .{ .file = f[1], .run = run, .xxh64 = std.fmt.parseInt(u64, f[7], 16) catch return error.BadDigestManifest });
+    }
+    var out: Checked = .{};
+    var all = std.hash.XxHash64.init(0);
+    const pieces = m.p.ranks[rank].pieces;
+    for (got) |g| {
+        const p = pieces[g.piece];
+        const name = m.inv.tensors[p.tensor].name;
+        all.update(std.mem.asBytes(&g.xxh64));
+        out.pieces += 1;
+        const e = map.get(name) orelse {
+            std.log.err("rank {d}: {s} has no line in the digest manifest", .{ rank, name });
+            out.missing += 1;
+            if (out.first == null) out.first = name;
+            continue;
+        };
+        const r = p.run;
+        if (!std.mem.eql(u8, e.file, m.inv.files[r.file].name) or !std.mem.eql(u64, &e.run, &.{ r.offset, r.len, r.stride, r.count })) {
+            std.log.err("rank {d}: {s}: the manifest's run is not this plan's (another world or checkpoint)", .{ rank, name });
+            out.missing += 1;
+            if (out.first == null) out.first = name;
+            continue;
+        }
+        if (e.xxh64 != g.xxh64) {
+            std.log.err("rank {d}: {s}: loaded bytes hash {x:0>16}, the manifest says {x:0>16}", .{ rank, name, g.xxh64, e.xxh64 });
+            out.differ += 1;
+            if (out.first == null) out.first = name;
+        }
+    }
+    out.loaded = all.final();
+    return out;
+}
+
+/// A tensor read whole outside the rank plan (the vision tower's file, cuda_vision.zig): its checkpoint name, its
+/// length and the xxh64 of its bytes.
+pub const Named = struct { name: []const u8, len: u64, xxh64: u64 };
+
+/// Tensors read whole outside the plan (`got`) against manifest `text`'s lines of rank `rank` whose tensor starts with
+/// `prefix`, by name, len and xxh64 alone: the file and offset columns are not compared, so a side file holding the
+/// checkpoint's bytes under their names matches. Every such line must be one whole run (count 1, stride = len), else
+/// error.BadDigestManifest. A tensor without a line, or a line no tensor matched, is missing. Each mismatch is logged as
+/// a warning; the caller fails (and logs its error) on `differ + missing > 0`.
+pub fn checkNamed(gpa: std.mem.Allocator, text: []const u8, rank: u32, prefix: []const u8, got: []const Named) !Checked {
+    const Line = struct { len: u64, xxh64: u64, seen: bool = false };
+    var map: std.StringHashMapUnmanaged(Line) = .empty;
+    defer map.deinit(gpa);
+    var lines = std.mem.splitScalar(u8, text, '\n');
+    while (lines.next()) |line| {
+        if (line.len == 0 or line[0] == '#') continue;
+        var f: [8][]const u8 = undefined;
+        var it = std.mem.splitScalar(u8, line, '\t');
+        for (&f) |*x| x.* = it.next() orelse return error.BadDigestManifest;
+        if (it.next() != null) return error.BadDigestManifest;
+        if ((std.fmt.parseInt(u32, f[0], 10) catch return error.BadDigestManifest) != rank) continue;
+        if (!std.mem.startsWith(u8, f[6], prefix)) continue;
+        var run: [4]u64 = undefined; // offset, len, stride, count
+        for (&run, f[2..6]) |*v, s| v.* = std.fmt.parseInt(u64, s, 10) catch return error.BadDigestManifest;
+        if (run[3] != 1 or run[2] != run[1]) return error.BadDigestManifest;
+        const gop = try map.getOrPut(gpa, f[6]);
+        if (gop.found_existing) return error.BadDigestManifest;
+        gop.value_ptr.* = .{ .len = run[1], .xxh64 = std.fmt.parseInt(u64, f[7], 16) catch return error.BadDigestManifest };
+    }
+    var out: Checked = .{};
+    var all = std.hash.XxHash64.init(0);
+    for (got) |g| {
+        all.update(std.mem.asBytes(&g.xxh64));
+        out.pieces += 1;
+        const e = map.getPtr(g.name) orelse {
+            std.log.warn("rank {d}: {s} has no line in the digest manifest", .{ rank, g.name });
+            out.missing += 1;
+            if (out.first == null) out.first = g.name;
+            continue;
+        };
+        e.seen = true;
+        if (e.len != g.len or e.xxh64 != g.xxh64) {
+            std.log.warn("rank {d}: {s}: {d} bytes hash {x:0>16}, the manifest says {d} bytes {x:0>16}", .{ rank, g.name, g.len, g.xxh64, e.len, e.xxh64 });
+            out.differ += 1;
+            if (out.first == null) out.first = g.name;
+        }
+    }
+    var it = map.iterator();
+    while (it.next()) |kv| if (!kv.value_ptr.seen) {
+        std.log.warn("rank {d}: the digest manifest's {s} was not read", .{ rank, kv.key_ptr.* });
+        out.missing += 1;
+        if (out.first == null) out.first = kv.key_ptr.*;
+    };
+    out.loaded = all.final();
+    return out;
+}
+
+test "inkling2 digests: named tensors match by name, len and xxh64; a missing or extra one counts, a strided line refuses" {
+    const gpa = std.testing.allocator;
+    const level = std.testing.log_level;
+    std.testing.log_level = .err; // the mismatches below are warned about, as they should be
+    defer std.testing.log_level = level;
+    const text = header ++
+        "0\tmodel-00024.safetensors\t100\t8\t8\t1\tmodel.visual.a\t00000000000000aa\n" ++
+        "0\tmodel-00024.safetensors\t108\t4\t4\t1\tmodel.visual.b\t00000000000000bb\n" ++
+        "0\tmodel-00001.safetensors\t0\t2\t4\t3\tmodel.llm.x\t0000000000000011\n" ++ // another prefix: not looked at
+        "1\tmodel-00024.safetensors\t100\t8\t8\t1\tmodel.visual.c\t00000000000000cc\n"; // another rank
+    const p = "model.visual.";
+    const both = [_]Named{ .{ .name = "model.visual.a", .len = 8, .xxh64 = 0xaa }, .{ .name = "model.visual.b", .len = 4, .xxh64 = 0xbb } };
+    {
+        const c = try checkNamed(gpa, text, 0, p, &both);
+        try std.testing.expectEqual(@as(usize, 2), c.pieces);
+        try std.testing.expectEqual(@as(usize, 0), c.differ + c.missing);
+        try std.testing.expect(c.first == null);
+    }
+    {
+        var one = both;
+        one[1].xxh64 = 0xbc;
+        const c = try checkNamed(gpa, text, 0, p, &one);
+        try std.testing.expectEqual(@as(usize, 1), c.differ);
+        try std.testing.expectEqualStrings("model.visual.b", c.first.?);
+        one[1] = both[1];
+        one[0].len = 9; // the same hash at another length
+        try std.testing.expectEqual(@as(usize, 1), (try checkNamed(gpa, text, 0, p, &one)).differ);
+    }
+    {
+        // a line the file lacks, and a tensor with no line
+        const c = try checkNamed(gpa, text, 0, p, both[0..1]);
+        try std.testing.expectEqual(@as(usize, 1), c.missing);
+        try std.testing.expectEqualStrings("model.visual.b", c.first.?);
+        const extra = [_]Named{ both[0], both[1], .{ .name = "model.visual.z", .len = 1, .xxh64 = 1 } };
+        const d = try checkNamed(gpa, text, 0, p, &extra);
+        try std.testing.expectEqual(@as(usize, 1), d.missing);
+        try std.testing.expectEqual(@as(usize, 0), d.differ);
+        // rank 1's lines are rank 1's: neither tensor has one, and its own line is not read
+        try std.testing.expectEqual(@as(usize, 3), (try checkNamed(gpa, text, 1, p, &both)).missing);
+    }
+    // a prefix line that is not one whole run, or named twice
+    try std.testing.expectError(error.BadDigestManifest, checkNamed(gpa, text ++ "0\tf\t0\t2\t2\t2\tmodel.visual.d\t01\n", 0, p, &both));
+    try std.testing.expectError(error.BadDigestManifest, checkNamed(gpa, text ++ "0\tf\t0\t2\t4\t1\tmodel.visual.d\t01\n", 0, p, &both));
+    try std.testing.expectError(error.BadDigestManifest, checkNamed(gpa, text ++ "0\tf\t9\t8\t8\t1\tmodel.visual.a\t00000000000000aa\n", 0, p, &both));
+}
+
+test "inkling2 digests: streaming xxh64 does not depend on the read size" {
+    var data: [1000]u8 = undefined;
+    for (&data, 0..) |*b, i| b.* = @truncate(i *% 131);
+    var h = std.hash.XxHash64.init(0);
+    var at: usize = 0;
+    while (at < data.len) : (at += 77) h.update(data[at..@min(data.len, at + 77)]);
+    try std.testing.expectEqual(std.hash.XxHash64.hash(0, &data), h.final());
+}
