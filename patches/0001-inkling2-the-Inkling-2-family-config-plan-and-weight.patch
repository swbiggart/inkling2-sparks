+    try std.testing.expect(!std.mem.eql(u8, &Raw.of(ex2a), &Raw.of(ex2b))); // the same choices: refused wrongly
+    try std.testing.expect(!std.mem.eql(u8, &Lc.of(ex1a), &Lc.of(ex1b)));
