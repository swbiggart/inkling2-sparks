+    var whole: [32]u8 = undefined;
+    Sha.hash(aw.written(), &whole, .{});
+    const a = digest(base);
+    try std.testing.expectEqualSlices(u8, &whole, &a); // the whole text, as a short one is hashed
+    try std.testing.expectEqualSlices(u8, &a, &digest(base)); // the same long value: the same digest (ranks agree)
+    try std.testing.expect(!std.mem.eql(u8, &a, &unset));
+    long[1499] = 'b'; // another long value, differing in its last byte
+    _ = env_fns.setenv("TF_INK2_CK_PROFILE", &long, 1);
+    try std.testing.expect(!std.mem.eql(u8, &a, &digest(base)));
+}
