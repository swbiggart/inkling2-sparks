+"""Inkling-2-Small's DSpark drafter (mtp.safetensors) in torch: the reference for the CUDA drafter and the offline
+acceptance measurement.
+
+The drafter math follows TokenSpeed's native draft (`models/inkling2_mtp.py`, `execution/drafter/inkling2.py` and
+`dflash.py`, MIT; notice kept below):
+
+  taps       the target's raw block partial at the entry of layers 5, 11, ..., 41 (the oracle's h.4, h.10, ...,
+             h.40) and the final normed hidden (the oracle's `final`): 8 taps of 4608 per position
+  mixtures   fuse_alpha = softmax(fuse_weight fp32).bf16 [6, 8]; stage s (layer s = 0..4, Markov head = 5):
+             dflare_norm_s(sum_t tap_t fp32 * alpha[s, t]) -> bf16
+  context    per draft layer, per target position: K = rope(k_norm_ctx(mix @ k_proj_ctx)), V = mix @ v_proj_ctx
+  block      8 rows at positions p..p+7: row 0 is the target's normed embedding of the anchor (the token at p, the
+             last one the target produced), rows 1..7 mask_embed; 5 dense layers (q/k norm, neox rope theta 1e6,
+             GQA 48/8, non-causal in the block, the block sees context positions [0, p) - in local layers 0, 1, 3, 4
+             only the last 1024), pre-norm residuals with the fp32 add-norm, SwiGLU 18432; final norm
+  head       rows 1..7: base = row @ unembed (bf16, uncapped); recurrent state 256 from zero, previous token = the
+             anchor, f_rnn = Markov-head mixture of the taps at p - 1; per step proj = rnn_proj([state, w1[prev],
+             row, f_rnn]); gate, cand, out; state = g*state + (1-g)*tanh(cand); latent = tanh(out);
+             logits = softcap30(base + fold_b + latent @ fold_w^T) with fold = unembed @ hidden_out in fp64 -> bf16;
+             the greedy pick feeds the next step
+  proposals  7 tokens for positions p+1..p+7 (block 8, verify width 8)
+
+USAGE
+  inkling2_dspark_ref.py gen MODEL OUT [--prompts a,b] [--steps N] [--mode full|checkpoint] [--expert-cache N]
+      target greedy continuations with every position's 8 taps (oracle modules, layer weights resident, experts
+      fetched per pick): OUT/<prompt>.safetensors {ids, n_prompt, taps [T, 8, 4608] bf16}
+  inkling2_dspark_ref.py accept MODEL OUT/<prompt>.safetensors... [--json FILE] [--causal]
+      offline acceptance under greedy verify: proposals at every anchor, then the mean accepted length (tokens a
+      round, bonus included) for 1..7 drafts
+  inkling2_dspark_ref.py fold MODEL OUT.safetensors
+      the Markov head's folds (unembed . hidden_out in fp64, stored bf16) the CUDA drafter loads
+  inkling2_dspark_ref.py dump MODEL OUT/<prompt>.safetensors --anchor P --out FILE
+      one round's inputs and every intermediate (the CUDA drafter's op check)
+
+Notice for the ported drafter math (TokenSpeed, https://github.com/lightseekorg/tokenspeed), under its MIT licence:
+
+  Copyright (c) 2026 LightSeek Foundation
+
+  Permission is hereby granted, free of charge, to any person obtaining a copy of this software and associated
+  documentation files (the "Software"), to deal in the Software without restriction, including without limitation
+  the rights to use, copy, modify, merge, publish, distribute, sublicense, and/or sell copies of the Software, and
+  to permit persons to whom the Software is furnished to do so, subject to the following conditions:
+
+  The above copyright notice and this permission notice shall be included in all copies or substantial portions of
+  the Software.
+
+  THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO
+  THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
+  AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER LIABILITY, WHETHER IN AN ACTION OF
+  CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS
+  IN THE SOFTWARE.
+"""
+
+import argparse
+import json
+import os
+import sys
+import time
+
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+from safetensors.torch import load_file, save_file
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+BF = torch.bfloat16
+H, NQ, NKV, HD, RANK, BLOCK = 4608, 48, 8, 128, 256, 8
+TAP_LAYERS = (4, 10, 16, 22, 28, 34, 40)  # the oracle's h.L: the partial entering layers 5, 11, ..., 41
+LOCAL = (0, 1, 3, 4)
+WINDOW = 1024
+EPS = 1e-6
+SOFTCAP = 30.0
+VALID = 200058
+THETA = 1e6
+
+torch.backends.cuda.matmul.allow_tf32 = False
+
+
+# ----------------------------------------------------------------------------------------------- gen
+
+
+def extra_specs():
+    return [{"name": "chat_long", "effort": "none",
+             "messages": [{"role": "user", "content": "Explain how a refrigerator keeps food cold, step by step, "
+                                                      "in about 200 words."}]}]
+
+
+def gen(a):
+    import inkling2_ref as R
+    from transformers import AutoTokenizer
+    from transformers.cache_utils import DynamicCache
+
+    dev = torch.device(a.device)
+    cfg = R.text_config(a.model_dir, 0)
+    tok = AutoTokenizer.from_pretrained(a.model_dir)
+    specs = R.prompt_specs(tok) + extra_specs()
+    for s in specs:
+        s["text"], s["ids"] = R.render(tok, s)
+    want = a.prompts.split(",")
+    specs = [s for s in specs if s["name"] in want]
+    os.makedirs(a.out, exist_ok=True)
+    model = R.Model(a.model_dir, cfg, dev, a.mode)
+    lru = R.ExpertLRU(dev, a.expert_cache)
+    t0 = time.time()
+    emb = model.embed()
+    layers = [model.layer(i, experts="lazy", lru=lru) for i in range(cfg.num_hidden_layers)]
+    head = model.head()
+    print(f"resident layers built in {time.time() - t0:.1f} s", flush=True)
+    caches = [DynamicCache(config=cfg) for _ in specs]
+    outs = [[] for _ in specs]
+    taps = [[] for _ in specs]
+    done = [False] * len(specs)
+    eos = 200006
+    with torch.no_grad():
+        cur = [torch.tensor([s["ids"]], device=dev) for s in specs]
+        for step in range(a.steps + 1):
+            ts = time.time()
+            live = [k for k in range(len(specs)) if not done[k]]
+            if not live:
+                break
+            states = {}
+            for k in live:
+                e = emb(cur[k])
+                past = caches[k].get_seq_length()
+                pos = (torch.arange(cur[k].shape[1], device=dev) + past)[None]
+                states[k] = {"h": e, "blocks": e.new_zeros(1, cur[k].shape[1], 0, e.shape[-1]),
+                             "masks": R.masks(cfg, e, pos, caches[k]), "pos": pos, "taps": []}
+            for i, layer in enumerate(layers):
+                for k in live:
+                    R.run_layer(layer, states[k], caches[k])
+                    if i in TAP_LAYERS:
+                        states[k]["taps"].append(states[k]["h"][0].cpu())
+            for k in live:
+                st = states[k]
+                hn = R.finish(head, st)
+                st["taps"].append(hn[0].cpu())
+                taps[k].append(torch.stack(st["taps"], dim=1))  # [rows, 8, H]
+                lg = R.logits_of(head, cfg, hn[0, -1:])[0]
+                t = int(lg.argmax())
+                if step < a.steps:
+                    outs[k].append(t)
+                if t == eos or step >= a.steps:
+                    done[k] = True
+                cur[k] = torch.tensor([[t]], device=dev)
+            print(f"step {step}: {time.time() - ts:.1f} s, live {len(live)}, expert hits {lru.hits} misses "
+                  f"{lru.misses}", flush=True)
+    res = {}
+    for k, s in enumerate(specs):
+        ids = s["ids"] + outs[k]
+        tp = torch.cat(taps[k])[: len(ids)]
+        save_file({"ids": torch.tensor(ids, dtype=torch.int64), "n_prompt": torch.tensor([len(s["ids"])]),
+                   "taps": tp.contiguous()}, os.path.join(a.out, s["name"] + ".safetensors"))
+        res[s["name"]] = {"n_prompt": len(s["ids"]), "generated": len(outs[k]),
+                          "text": tok.decode(outs[k], skip_special_tokens=False)}
+        print(f"--- {s['name']} ({len(outs[k])} tokens)\n{res[s['name']]['text']}", flush=True)
+    res["_wall_s"] = round(time.time() - t0, 1)
+    res["_mode"] = a.mode
+    json.dump(res, open(os.path.join(a.out, "gen.json"), "w"), indent=1, ensure_ascii=False)
+
+
+# ----------------------------------------------------------------------------------------------- drafter
+
+
+def rms(x, w, eps=EPS):
+    """PrecisionRMSNorm: fp32 statistics, mean by reciprocal width, weight in fp32, bf16 out."""
+    x = x.float()
+    n = x.shape[-1]
+    ms = x.square().sum(-1, keepdim=True) * (1.0 / n)
+    return (x * torch.rsqrt(ms + eps) * w.float()).to(BF)
+
+
+def add_norm(h, res, w):
+    total = h.float() + res.float()
+    return rms(total, w), total.to(BF)
+
+
+def rope(x, pos, nheads):
+    """Neox rotation, theta 1e6, bf16 cos/sin table (TokenSpeed's RotaryEmbedding cache dtype)."""
+    inv = 1.0 / (THETA ** (torch.arange(0, HD, 2, dtype=torch.float32, device=x.device) / HD))
+    f = pos.to(torch.float32)[:, None] * inv[None, :]
+    cos, sin = f.cos().to(BF).float()[:, None], f.sin().to(BF).float()[:, None]
+    r = x.view(x.shape[0], nheads, HD).float()
+    l, rr = r.chunk(2, -1)
+    return torch.cat((l * cos - rr * sin, rr * cos + l * sin), -1).to(BF).view(x.shape[0], nheads * HD)
+
+
+def head_norm(x, w, nheads):
+    return rms(x.view(x.shape[0], nheads, HD), w).view(x.shape[0], nheads * HD)
+
+
+def lin(x, w, b=None):
+    return F.linear(x, w, b)
+
+
+class Drafter:
+    def __init__(self, model_dir: str, dev):
+        self.dev = dev
+        f = safe_open(os.path.join(model_dir, "mtp.safetensors"), framework="pt", device="cpu")
+        g = lambda n: f.get_tensor(n).to(dev)
+        self.alpha = torch.softmax(g("fuse_weight").float(), dim=-1).to(BF)  # [6, 8]
+        self.mask_embed = g("mask_embed")
+        self.norm = g("norm.weight")
+        self.L = []
+        for i in range(5):
+            p = f"layers.{i}."
+            self.L.append({k: g(p + n) for k, n in (
+                ("dflare", "dflare_norm.weight"), ("in_ln", "input_layernorm.weight"),
+                ("post_ln", "post_attention_layernorm.weight"), ("q", "self_attn.q_proj.weight"),
+                ("k", "self_attn.k_proj.weight"), ("v", "self_attn.v_proj.weight"), ("o", "self_attn.o_proj.weight"),
+                ("qn", "self_attn.q_norm.weight"), ("kn", "self_attn.k_norm.weight"),
+                ("kc", "self_attn.k_proj_ctx.weight"), ("vc", "self_attn.v_proj_ctx.weight"),
+                ("knc", "self_attn.k_norm_ctx.weight"), ("gate", "mlp.gate_proj.weight"),
+                ("up", "mlp.up_proj.weight"), ("down", "mlp.down_proj.weight"))})
+        m = "markov_head."
+        self.m_dflare = g(m + "dflare_norm.weight")
+        self.w1 = g(m + "markov_w1.weight")
+        self.rnn_w, self.rnn_b = g(m + "rnn_proj.weight"), g(m + "rnn_proj.bias")
+        self.ho_w, self.ho_b = g(m + "hidden_out.weight"), g(m + "hidden_out.bias")
+        import inkling2_ref as R
+        src = R.Source(model_dir)
+        self.unembed = src.get(R.CK + "unembed.weight", dev).to(BF)
+        self.embed_w = src.get(R.CK + "embed.weight", dev).to(BF)
+        self.embed_norm = src.get(R.CK + "embed_norm.weight", dev)
+        V = self.unembed.shape[0]
+        self.fold_w = torch.empty(V, RANK, dtype=BF, device=dev)
+        self.fold_b = torch.empty(V, dtype=BF, device=dev)
+        for a in range(0, V, 4096):
+            rows = self.unembed[a:a + 4096].double()
+            self.fold_w[a:a + 4096] = (rows @ self.ho_w.double()).to(BF)
+            self.fold_b[a:a + 4096] = (rows @ self.ho_b.double()).to(BF)
+
+    def embed(self, ids):
+        """Transformers' Inkling2NormedEmbedding: fp32 rms (mean as x^2.mean), weight, bf16."""
+        e = self.embed_w[ids].float()
+        return (e * torch.rsqrt(e.square().mean(-1, keepdim=True) + EPS) * self.embed_norm.float()).to(BF)
+
+    def mix(self, taps, stage):
+        """taps [T, 8, H] bf16 -> dflare_norm(sum_t tap_t * alpha[stage, t]) [T, H] bf16 (fp32 sum in tap order)."""
+        acc = torch.zeros(taps.shape[0], H, dtype=torch.float32, device=taps.device)
+        for t in range(taps.shape[1]):
+            acc += taps[:, t].float() * self.alpha[stage, t].float()
+        w = self.m_dflare if stage == 5 else self.L[stage]["dflare"]
+        return rms(acc, w)
+
+    def context(self, taps):
+        """Every draft layer's context K (normed, rotated) and V for target positions 0..T-1, plus f_rnn rows."""
+        T = taps.shape[0]
+        pos = torch.arange(T, device=taps.device)
+        ctx = []
+        for i, Lw in enumerate(self.L):
+            m = self.mix(taps, i)
+            k = rope(head_norm(lin(m, Lw["kc"]), Lw["knc"], NKV), pos, NKV)
+            v = lin(m, Lw["vc"])
+            ctx.append((k, v))
+        return ctx, self.mix(taps, 5)
+
+    def block(self, anchor_id, p, ctx, causal=False, rec=None):
+        """The 8-row block forward at positions p..p+7 against context positions [0, p): final rows [8, H]."""
+        dev = self.dev
+        x = torch.cat((self.embed(torch.tensor([anchor_id], device=dev)), self.mask_embed[None].expand(7, H)))
+        pos = torch.arange(p, p + BLOCK, device=dev)
+        if rec is not None:
+            rec["block.in"] = x
+        res, h = x, None
+        for i, Lw in enumerate(self.L):
+            if i == 0:
+                hn = rms(x, Lw["in_ln"])
+            else:
+                hn, res = add_norm(h, res, Lw["in_ln"])
+            q = rope(head_norm(lin(hn, Lw["q"]), Lw["qn"], NQ), pos, NQ)
+            k = rope(head_norm(lin(hn, Lw["k"]), Lw["kn"], NKV), pos, NKV)
+            v = lin(hn, Lw["v"])
+            lo = max(0, p - WINDOW) if i in LOCAL else 0
+            kc, vc = ctx[i]
+            K = torch.cat((kc[lo:p], k)).view(-1, NKV, HD).float()
+            Vv = torch.cat((vc[lo:p], v)).view(-1, NKV, HD).float()
+            qh = q.view(BLOCK, NQ, HD).float()
+            K = K.repeat_interleave(NQ // NKV, dim=1)
+            Vv = Vv.repeat_interleave(NQ // NKV, dim=1)
+            s = torch.einsum("qhd,khd->hqk", qh, K) * (HD ** -0.5)
+            if causal:
+                n = K.shape[0]
+                mask = torch.ones(BLOCK, n, dtype=torch.bool, device=dev)
+                mask[:, n - BLOCK:] = torch.tril(torch.ones(BLOCK, BLOCK, dtype=torch.bool, device=dev))
+                s = s.masked_fill(~mask[None], float("-inf"))
+            pr = torch.softmax(s, dim=-1)
+            att = torch.einsum("hqk,khd->qhd", pr, Vv).reshape(BLOCK, NQ * HD).to(BF)
+            o = lin(att, Lw["o"])
+            hn2, res = add_norm(o, res, Lw["post_ln"])
+            gt, up = lin(hn2, Lw["gate"]), lin(hn2, Lw["up"])
+            act = (F.silu(gt.float()) * up.float()).to(BF)
+            h = lin(act, Lw["down"])
+            if rec is not None:
+                rec.update({f"l{i}.q": q, f"l{i}.k": k, f"l{i}.v": v, f"l{i}.att": att, f"l{i}.o": o,
+                            f"l{i}.act": act, f"l{i}.h": h, f"l{i}.res": res})
+        out, _ = add_norm(h, res, self.norm)
+        if rec is not None:
+            rec["block.out"] = out
+        return out
+
+    def propose(self, anchor_id, rows, f, rec=None):
+        """Markov head over rows [7, H] with features f [H]: 7 greedy proposals."""
+        base = lin(rows, self.unembed)  # [7, V] bf16, uncapped
+        state = torch.zeros(RANK, dtype=BF, device=self.dev)
+        prev = anchor_id
+        toks = []
+        for s in range(rows.shape[0]):
+            inp = torch.cat((state, self.w1[prev], rows[s], f))
+            pj = lin(inp[None], self.rnn_w, self.rnn_b)[0]  # bf16
+            g, c, o = pj.float().chunk(3)
+            g = torch.sigmoid(g)
+            state = (g * state.float() + (1 - g) * torch.tanh(c)).to(BF)
+            latent = torch.tanh(o).to(BF)
+            corr = torch.addmm(self.fold_b[None], latent[None], self.fold_w.T)[0]  # bf16
+            lg = (SOFTCAP * torch.tanh((base[s] + corr).float() / SOFTCAP)).to(BF)
+            lg[VALID:] = float("-inf")
+            prev = int(lg.argmax())
+            toks.append(prev)
+            if rec is not None:
+                rec[f"m{s}.proj"] = pj
+                rec[f"m{s}.state"] = state
+                rec[f"m{s}.logits"] = lg
+        if rec is not None:
+            rec["base"] = base
+            rec["proposals"] = torch.tensor(toks, dtype=torch.int32)
+        return toks
+
+
+# ----------------------------------------------------------------------------------------------- accept
+
+
+def accept(a):
+    dev = torch.device(a.device)
+    d = Drafter(a.model_dir, dev)
+    out = {}
+    with torch.no_grad():
+        for path in a.files:
+            name = os.path.basename(path).replace(".safetensors", "")
+            t = load_file(path)
+            ids, n0, taps = t["ids"].tolist(), int(t["n_prompt"][0]), t["taps"].to(dev)
+            T = len(ids)
+            ctx, frnn = d.context(taps)
+            t0 = time.time()
+            match = {}  # anchor position -> accepted drafts (matching prefix, 0..7)
+            for p in range(n0, T - 1):
+                rows = d.block(ids[p], p, ctx, causal=a.causal)[1:]
+                props = d.propose(ids[p], rows, frnn[p - 1])
+                k = 0
+                while k < 7 and p + 1 + k < T and props[k] == ids[p + 1 + k]:
+                    k += 1
+                match[p] = (k, min(7, T - 1 - p))  # matched, how many could be checked
+            per = {}
+            for D in range(1, 8):
+                p, rounds, toks = n0, 0, 0
+                while p < T - 1:
+                    k, avail = match[p]
+                    if avail < D:  # the tail can't hold a full round
+                        break
+                    acc = min(k, D)
+                    rounds += 1
+                    toks += acc + 1
+                    p += acc + 1
+                per[D] = {"rounds": rounds, "tokens": toks, "mean_accepted": round(toks / max(rounds, 1), 3)}
+            hist = [0] * 8
+            for p, (k, avail) in match.items():
+                if avail == 7:
+                    hist[k] += 1
+            out[name] = {"generated": T - n0, "anchors": len(match), "accepted_hist_at_7": hist,
+                         "per_drafts": per, "seconds": round(time.time() - t0, 1)}
+            print(name, json.dumps(out[name]), flush=True)
+    tot = {}
+    for D in range(1, 8):
+        r = sum(v["per_drafts"][D]["rounds"] for v in out.values())
+        k = sum(v["per_drafts"][D]["tokens"] for v in out.values())
+        tot[D] = round(k / max(r, 1), 3)
+    out["_mean_accepted_by_drafts"] = tot
+    out["_causal"] = a.causal
+    print("mean accepted length (tokens a round, bonus included) by drafts:", tot, flush=True)
+    if a.json:
+        json.dump(out, open(a.json, "w"), indent=1)
+
+
+def fold(a):
+    """The Markov head's folds (fp64 products, bf16 stores, TokenSpeed's refresh_fold) for the CUDA drafter."""
+    import inkling2_ref as R
+    torch.set_num_threads(os.cpu_count() or 8)
+    f = safe_open(os.path.join(a.model_dir, "mtp.safetensors"), framework="pt", device="cpu")
+    ho_w = f.get_tensor("markov_head.hidden_out.weight").double()
+    ho_b = f.get_tensor("markov_head.hidden_out.bias").double()
+    un = R.Source(a.model_dir).get(R.CK + "unembed.weight", "cpu").to(BF)
+    V = un.shape[0]
+    fw = torch.empty(V, RANK, dtype=BF)
+    fb = torch.empty(V, dtype=BF)
+    t0 = time.time()
+    for s in range(0, V, 4096):
+        rows = un[s:s + 4096].double()
+        fw[s:s + 4096] = (rows @ ho_w).to(BF)
+        fb[s:s + 4096] = (rows @ ho_b).to(BF)
+    save_file({"fold_w": fw.contiguous(), "fold_b": fb.contiguous()}, a.out)
+    print(f"folds {tuple(fw.shape)} in {time.time() - t0:.1f} s -> {a.out}")
+
+
+def check(a):
+    """The CUDA drafter's dump (tf-inkling2-draft --out) against this reference's (`dump`): relative errors."""
+    x, r = load_file(a.cuda), load_file(a.ref)
+    ok = True
+    for k in ["block.out", "frnn", "base"] + [f"ctx{i}.{kv}" for i in range(5) for kv in "kv"]:
+        if k not in x or k not in r:
+            continue
+        p, q = x[k].float(), r[k].float()
+        if k.startswith("ctx") and p.dim() == 2 and q.dim() == 2 and p.shape[0] < q.shape[0] and p.shape[1] == q.shape[1]:
+            q = q[q.shape[0] - p.shape[0]:]  # a local layer's ring: the last positions only
+        if p.shape != q.shape:
+            print(f"{k}: shape {tuple(p.shape)} vs {tuple(q.shape)}")
+            ok = False
+            continue
+        rel = float((p - q).norm() / q.norm().clamp_min(1e-30))
+        same = float((p == q).float().mean())
+        print(f"{k:10s} rel {rel:.3e}  bit-equal {same:.4f}  max |diff| {float((p - q).abs().max()):.3e}")
+        ok = ok and rel < a.tol
+    pr, pq = x["proposals"].tolist(), r["proposals"].tolist()
+    print("proposals cuda", pr, "\n          ref ", pq)
+    print("PASS" if ok and pr == pq else "FAIL")
+
+
+def dump(a):
+    dev = torch.device(a.device)
+    d = Drafter(a.model_dir, dev)
+    t = load_file(a.file)
+    ids, taps = t["ids"], t["taps"].to(dev)
+    p = a.anchor
+    with torch.no_grad():
+        ctx, frnn = d.context(taps[:p])
+        rec = {}
+        rows = d.block(int(ids[p]), p, ctx, rec=rec)[1:]
+        d.propose(int(ids[p]), rows, frnn[p - 1], rec=rec)
+    rec["ids"] = ids[: p + 1]
+    rec["taps"] = taps[:p]
+    rec["anchor"] = torch.tensor([p])
+    rec["frnn"] = frnn[p - 1]
+    for i in range(5):
+        rec[f"ctx{i}.k"], rec[f"ctx{i}.v"] = ctx[i]
+    save_file({k: v.detach().cpu().contiguous() for k, v in rec.items()}, a.out)
+    print("proposals", rec["proposals"].tolist(), "targets", t["ids"][p + 1:p + 8].tolist())
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    g = sub.add_parser("gen")
+    g.add_argument("model_dir")
+    g.add_argument("out")
+    g.add_argument("--prompts", default="chat_long,code,tool_call,thinking")
+    g.add_argument("--steps", type=int, default=160)
+    g.add_argument("--mode", choices=["full", "checkpoint"], default="checkpoint")
+    g.add_argument("--expert-cache", type=int, default=1500)
+    g.add_argument("--device", default="cuda:0")
+    c = sub.add_parser("accept")
+    c.add_argument("model_dir")
+    c.add_argument("files", nargs="+")
+    c.add_argument("--json", default="")
+    c.add_argument("--causal", action="store_true", help="causal inside the block (a check of the trained form)")
+    c.add_argument("--device", default="cuda:0")
+    ch = sub.add_parser("check")
+    ch.add_argument("cuda")
+    ch.add_argument("ref")
+    ch.add_argument("--tol", type=float, default=2e-2)
+    fo = sub.add_parser("fold")
+    fo.add_argument("model_dir")
+    fo.add_argument("out")
+    u = sub.add_parser("dump")
+    u.add_argument("model_dir")
+    u.add_argument("file")
+    u.add_argument("--anchor", type=int, required=True)
+    u.add_argument("--out", required=True)
+    u.add_argument("--device", default="cuda:0")
+    a = ap.parse_args()
+    {"gen": gen, "accept": accept, "dump": dump, "fold": fold, "check": check}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/zig/inkling2_f64.py b/tools/zig/inkling2_f64.py
new file mode 100644
index 0000000000000000000000000000000000000000..8f07bb25abfe5d067e9c1ab9eabeb6bab37e9ae3
--- /dev/null
+++ b/tools/zig/inkling2_f64.py
@@ -0,0 +1,248 @@
+"""Where a layer's distance from the reference enters: each op of one layer on the same inputs, ours against torch
+at fp32 reductions (the tight reference), torch at its default bf16 partial reduction (the oracle's), and fp64.
+Also a bit-for-bit diff of two runner dumps (row invariance across --chunk).
+
+USAGE = python tools/zig/inkling2_f64.py ops MODEL_DIR CAPTURE DUMP --layer L [--core-rows N] [--json OUT]
+        python tools/zig/inkling2_f64.py same DUMP_A DUMP_B [--ops-too]
+
+  ops   CAPTURE: inkling2_op_ref.py capture --fp32-reduction of layer L (one forward from position 0);
+        DUMP: tf-inkling2-cuda --layers L:L+1 --feed CAPTURE --dump-ops (each of our ops ran on the capture's
+        inputs, whatever --chunk). For every op output of layer L, all on the capture's inputs:
+          ours~tight     ours against the capture
+          default~tight  torch with the oracle's default reduction, recomputed here, against the capture
+          ratio          ours~tight / default~tight (at or below 1: ours is no farther from the tight reference
+                         than the oracle's own arithmetic)
+        and for the ops with long sums (projections, attention core, output projection, router logits, experts)
+        ours, tight and default against fp64 (the same op without intermediate roundings, or for the experts the
+        module's own roundings with fp64 GEMMs), with bf16(fp64) as the rounding floor. The attention core's fp64
+        runs on N rows spread over the prompt (default 192, plus the last row), the other ops on every row.
+        Tight recomputed here must equal the capture bit for bit (checked; a mismatch is reported).
+  same  Every tensor the two dumps share (h.*, route.*, final, logits.full; op.* outputs with --ops-too, never the
+        "@" state reads, which belong to a forward), bit for bit. Exit 1 when any differs.
+
+Transformers (Apache-2.0) is imported through inkling2_ref.py / inkling2_op_ref.py; this file copies none of it
+(see THIRD_PARTY_NOTICES.md).
+"""
+
+import argparse
+import json
+import math
+import os
+import sys
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+
+BF = torch.bfloat16
+ORDER = ["res.attn_input", "res.attn_norm", "res.q_norm", "res.k_norm", "res.v_norm", "attn.project", "conv.kv",
+         "attn.heads", "attn.core", "attn.out", "conv.attn", "res.partial", "res.mlp_input", "res.mlp_norm",
+         "moe.route", "moe.experts", "conv.mlp", "res.output"]
+
+
+def rel(a, b):
+    a, b = a.double(), b.double()
+    n = float(b.norm())
+    return float((a - b).norm()) / n if n > 0 else float((a - b).norm())
+
+
+def equal(a, b):
+    if a.dtype != b.dtype:
+        return 0.0
+    if a.dtype == BF:
+        a, b = a.view(torch.int16), b.view(torch.int16)
+    elif a.dtype == torch.float32:
+        a, b = a.view(torch.int32), b.view(torch.int32)
+    return float((a == b).double().mean()) if a.numel() else 1.0
+
+
+def f64_linear(mod, x):
+    w = mod.weight.double()
+    return F.linear(x.double(), w, None if mod.bias is None else mod.bias.double())
+
+
+def f64_project(ly, ins):
+    sa = ly.self_attn
+    xq = ins.get("xq", ins.get("x"))
+    xk = ins.get("xk", xq)
+    xv = ins.get("xv", xq)
+    out = {"q": f64_linear(sa.q_proj, xq), "k": f64_linear(sa.k_proj, xk), "v": f64_linear(sa.v_proj, xv),
+           "rel": f64_linear(sa.r_proj, xq), "gate": f64_linear(sa.gate_proj, xq), "sink": f64_linear(sa.sink_proj, xq)}
+    if not sa.is_sliding:
+        out["dk"] = f64_linear(sa.k_sconv.weight_proj, xk)
+        out["dv"] = f64_linear(sa.v_sconv.weight_proj, xv)
+    return out
+
+
+def f64_core(ly, ins, rows):
+    """Attention with the relative bias, sink and output gate in fp64 without intermediate roundings, at `rows`."""
+    sa = ly.self_attn
+    q, k, v, relx = ins["q"], ins["k_ctx@0"], ins["v_ctx@0"], ins["rel"]
+    sink, gate = ins["sink"], ins["gate"]
+    hq = sink.shape[1]
+    hk = k.shape[1] // 128
+    proj = sa.rel_logits_proj.proj.double()  # [d_rel, extent]: zero bias at distances past the extent
+    ext = proj.shape[-1]
+    out = []
+    for t in rows:
+        lo = max(0, t - (sa.sliding_window - 1)) if sa.is_sliding else 0
+        kk = k[lo:t + 1].double().view(-1, hk, 128).repeat_interleave(hq // hk, dim=1)
+        vv = v[lo:t + 1].double().view(-1, hk, 128).repeat_interleave(hq // hk, dim=1)
+        qq = q[t].double().view(hq, 128)
+        rr = relx[t].double().view(hq, -1)
+        dist = t - torch.arange(lo, t + 1, device=q.device)
+        bias = (rr @ proj)[:, dist.clamp(max=ext - 1)] * (dist < ext).double()[None]
+        s = torch.einsum("hd,chd->hc", qq, kk) / math.sqrt(128) + bias
+        s = torch.cat([s, sink[t].double()[:, None]], 1)
+        p = torch.softmax(s, -1)[:, :-1]
+        o = torch.einsum("hc,chd->hd", p, vv).reshape(-1)
+        out.append(o * torch.sigmoid(gate[t].double()))
+    return torch.stack(out)
+
+
+def ops(a):
+    import inkling2_ref as ref
+    from inkling2_moe_check import exact_sums
+    from inkling2_op_ref import Ops
+
+    dev = torch.device(a.device)
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    cap, dump = safe_open(a.capture, framework="pt"), safe_open(a.dump, framework="pt")
+    cmeta, dmeta = cap.metadata() or {}, dump.metadata() or {}
+    if cmeta.get("bf16_reduced_precision_reduction", "False") != "False":
+        print("warning: the capture was not made with --fp32-reduction; 'tight' below is the capture's arithmetic")
+    L = a.layer
+    pre = f"op.{L}."
+    names = {}
+    for k in cap.keys():
+        if not k.startswith(pre):
+            continue
+        g, o, d, t = k[len(pre):].split(".", 3)
+        names.setdefault(f"{g}.{o}", {"in": [], "out": []})[d].append(t)
+    dkeys = set(dump.keys())
+    cfg = ref.text_config(a.model_dir, 0)
+    model = ref.Model(a.model_dir, cfg, dev, "full")
+    ly = model.layer(L)
+    mods = Ops(cfg, ly, index=L)
+    T = int(cmeta.get("rows", "0")) or cap.get_tensor(f"{pre}res.output.out.h").shape[0]
+    core_rows = sorted(set(np.linspace(0, T - 1, a.core_rows).astype(int).tolist()) | {T - 1})
+    kind = ("global" if not ly.self_attn.is_sliding else "sliding") + (" boundary" if ly.is_block_boundary else "")
+    print(f"layer {L} ({kind}), {T} rows; capture {os.path.basename(a.capture)}, dump {os.path.basename(a.dump)}"
+          f" (chunk {dmeta.get('chunk', '?')}, fed: {dmeta.get('feed', 'see the runner log')})")
+    print(f"{'op output':26s} {'ours~tight':>10s} {'dflt~tight':>10s} {'ratio':>6s} {'eq(o,t)':>8s}"
+          f" | {'ours~f64':>9s} {'tight~f64':>9s} {'dflt~f64':>9s} {'floor':>9s}")
+    report = {"layer": L, "rows": T, "kind": kind, "ops": {}}
+    for op in [o for o in ORDER if o in names] + sorted(set(names) - set(ORDER)):
+        nm = names[op]
+        if not nm["out"]:
+            continue
+        ins = {t: cap.get_tensor(f"{pre}{op}.in.{t}").to(dev) for t in nm["in"]}
+        with torch.no_grad():
+            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = True
+            dflt = mods.run(op, ins, 0, 0 if op == "attn.core" else None)
+            torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = False
+            tight = mods.run(op, ins, 0, 0 if op == "attn.core" else None)
+            exact, rows = {}, None
+            if op == "attn.project":
+                exact = f64_project(ly, ins)
+            elif op == "attn.out":
+                exact = {"ao": f64_linear(ly.self_attn.o_proj, ins["o"])}
+            elif op == "moe.route":
+                exact = {"logits": F.linear(ins["m"].double(), ly.mlp.gate.weight.double())}
+            elif op == "moe.experts":
+                exact = {"y": exact_sums(ly.mlp.experts, ins["m"], ins["ids"].long(), ins["w"].float()).double()}
+            elif op == "attn.core":
+                rows = torch.tensor(core_rows)
+                exact = {"o": f64_core(ly, ins, core_rows)}
+        for t in nm["out"]:
+            key = f"{pre}{op}.out.{t}"
+            want = cap.get_tensor(key)
+            if key not in dkeys:
+                print(f"{op + '.' + t:26s} (not in the dump)")
+                continue
+            ours = dump.get_tensor(key)
+            d, tt = dflt[t].cpu(), tight[t].cpu()
+            if ours.shape != want.shape:
+                print(f"{op + '.' + t:26s} shape {tuple(ours.shape)} against the capture's {tuple(want.shape)}")
+                continue
+            r = {"ours_tight": rel(ours, want), "default_tight": rel(d, want), "eq_ours_tight": equal(ours, want),
+                 "tight_recomputed_equal": equal(tt, want)}
+            r["ratio"] = r["ours_tight"] / r["default_tight"] if r["default_tight"] > 0 else (
+                0.0 if r["ours_tight"] == 0 else float("inf"))
+            line = (f"{op + '.' + t:26s} {r['ours_tight']:10.3e} {r['default_tight']:10.3e} {r['ratio']:6.2f}"
+                    f" {r['eq_ours_tight']:8.4f}")
+            if t in exact:
+                e = exact[t].cpu()
+                sel = (lambda x: x[rows]) if rows is not None else (lambda x: x)  # noqa: E731
+                floor = e.to(want.dtype).double() if want.dtype == BF else e.float().double()
+                r |= {"ours_f64": rel(sel(ours), e), "tight_f64": rel(sel(want), e), "default_f64": rel(sel(d), e),
+                      "floor_f64": rel(floor, e), "f64_rows": len(rows) if rows is not None else T}
+                line += (f" | {r['ours_f64']:9.3e} {r['tight_f64']:9.3e} {r['default_f64']:9.3e} {r['floor_f64']:9.3e}"
+                         + (f"  ({len(rows)} rows)" if rows is not None else ""))
+            if r["tight_recomputed_equal"] < 1.0:
+                line += f"  [tight recomputed here equals the capture in {r['tight_recomputed_equal']:.6f}]"
+            print(line, flush=True)
+            report["ops"][f"{op}.{t}"] = r
+        del ins, dflt, tight, exact
+        torch.cuda.empty_cache()
+    if a.json:
+        with open(a.json, "w") as f:
+            json.dump(report, f, indent=1)
+    return 0
+
+
+def same(a):
+    fa, fb = safe_open(a.a, framework="pt"), safe_open(a.b, framework="pt")
+    ma, mb = fa.metadata() or {}, fb.metadata() or {}
+    print(f"{a.a}: chunk {ma.get('chunk')}; {a.b}: chunk {mb.get('chunk')}")
+    n, bad = 0, 0
+    for k in sorted(set(fa.keys()) & set(fb.keys())):
+        if "@" in k or k in ("ids", "rows", "logits.rows"):
+            continue
+        if k.startswith("op.") and (not a.ops_too or ".out." not in k):
+            continue
+        x, y = fa.get_tensor(k), fb.get_tensor(k)
+        if x.shape != y.shape:
+            print(f"{k:40s} shape {tuple(x.shape)} vs {tuple(y.shape)}")
+            bad += 1
+            continue
+        if x.dtype == BF:
+            x, y = x.view(torch.int16), y.view(torch.int16)
+        elif x.dtype == torch.float32:
+            x, y = x.view(torch.int32), y.view(torch.int32)
+        dif = (x != y)
+        rows = int(dif.reshape(dif.shape[0], -1).any(-1).sum()) if dif.dim() else int(dif)
+        n += 1
+        bad += rows > 0
+        if rows or a.verbose:
+            print(f"{k:40s} {'equal' if rows == 0 else f'DIFFER in {rows} of {x.shape[0]} rows'}")
+    print(f"{n} tensors compared; {bad} differ" + (" (BIT-EQUAL)" if bad == 0 else ""))
+    return 1 if bad or n == 0 else 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    o = sub.add_parser("ops")
+    o.add_argument("model_dir")
+    o.add_argument("capture")
+    o.add_argument("dump")
+    o.add_argument("--layer", type=int, required=True)
+    o.add_argument("--core-rows", type=int, default=192)
+    o.add_argument("--json", default="")
+    o.add_argument("--device", default="cuda:0")
+    s = sub.add_parser("same")
+    s.add_argument("a")
+    s.add_argument("b")
+    s.add_argument("--ops-too", action="store_true")
+    s.add_argument("--verbose", action="store_true")
+    a = ap.parse_args()
+    return {"ops": ops, "same": same}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/zig/inkling2_g1.py b/tools/zig/inkling2_g1.py
new file mode 100644
index 0000000000000000000000000000000000000000..f550dae039ce7e7959e023e543df8003cd1e9fe0
--- /dev/null
+++ b/tools/zig/inkling2_g1.py
@@ -0,0 +1,300 @@
+"""Gate G1's table from inkling2_compare.py JSONs: every layer of tf-inkling2-cuda, teacher-fed, against the
+tight reference (inkling2_op_ref.py layers --teacher --fp32-reduction), next to the oracle's own distance from it.
+
+USAGE = python tools/zig/inkling2_g1.py DIR [--prompts a,b,...] [--chain DIR2] [--md OUT.md] [--json OUT.json]
+
+DIR holds, per prompt P:
+  cmpt-teacher-P-A-B[-TAG].json  our teacher-fed range [A, B) against the tight reference (TAG: a --chunk variant)
+  cmp-tightref-P.json            the tight reference against the oracle (the oracle's own rounding distance)
+  teacher-P-A-B[-TAG].st         the dumps: each TAG variant is diffed bit for bit with the untagged run (h.*, route.*,
+                                 final, logits.full): a row's bits must not depend on its forward's size
+--chain DIR2 adds the chained drift: cmp-ours-tight-P.json (our 48 layers chained from the embedding against the tight
+oracle's chain) and cmp-oracle-tight-P.json (the default oracle's chain against it); head-P.json (inkling2_chain.py
+head: both chains' predictions at every row against the tight chain's) when present.
+
+The rule a layer passes by (teacher-fed, both sides on the oracle's input of that layer):
+  R1 every row whose 8 experts differ from the tight reference's is a tie within rounding (inkling2_compare.py --model:
+     the reference's score gap between the swapped experts is within twice our score error on them);
+  R2 over the rows with equal picks, the hidden rows' relative distance from the tight reference is at most 1e-2 and
+     at most the oracle's own distance from it over its equal-pick rows (ratio* <= 1);
+  R3 router logits: our relative distance from the tight reference is at most the oracle's (ratio_r <= 1).
+Per prompt: R4 our rows with differing picks number no more than the oracle's (summed over the layers), and every
+--chunk variant is bit-equal to the whole-prompt run. The head passes when top-1 agreement with the tight reference is
+at least the oracle's and the largest KL(tight || ours) per row is at most 1e-2.
+Chained (with --chain): top-1 agreement with the tight chain at the oracle's logits.rows at least the oracle's; at
+every row (head-P.json), the rows whose top-1 differs from the tight chain's at most the oracle's count plus two
+Poisson deviations (2 sqrt(count)): past ~10 chained layers both chains' rounding has grown into chaotic drift, and
+which near-tie rows flip is chance (two equally valid arithmetic variants of ours differ from each other by as much).
+"""
+
+import argparse
+import glob
+import json
+import os
+import re
+import sys
+
+PROMPTS = ["chat_short", "tool_call", "long_1500", "long_4000"]
+
+
+def kind(L):
+    return {"sliding": L % 6 != 5, "global": L % 6 == 5, "boundary": L % 6 == 0, "NVFP4": L < 40, "MXFP8": L >= 40}
+
+
+GROUPS = [("sliding (40)", "sliding"), ("global (5, 11, ..., 47)", "global"), ("block boundary (0, 6, ..., 42)", "boundary"),
+          ("NVFP4 experts (0-39)", "NVFP4"), ("MXFP8 experts (40-47)", "MXFP8")]
+
+
+def load_layers(path):
+    return json.load(open(path))["layers"] if os.path.exists(path) else {}
+
+
+def same_rel(x):
+    return x.get("h_same_routes", x["h"])["rel"]
+
+
+def bit_diff(a, b):
+    """h.*, route.*, final, logits.full of two dumps, bit for bit: (tensors compared, tensors differing)."""
+    import torch
+    from safetensors import safe_open
+
+    fa, fb = safe_open(a, framework="pt"), safe_open(b, framework="pt")
+    n = bad = 0
+    for k in sorted(set(fa.keys()) & set(fb.keys())):
+        if not (k.startswith("h.") or k.startswith("route.") or k in ("final", "logits.full")):
+            continue
+        x, y = fa.get_tensor(k), fb.get_tensor(k)
+        if x.dtype in (torch.bfloat16, torch.float16):
+            x, y = x.view(torch.int16), y.view(torch.int16)
+        elif x.dtype == torch.float32:
+            x, y = x.view(torch.int32), y.view(torch.int32)
+        n += 1
+        bad += int(x.shape != y.shape or not torch.equal(x, y))
+    return n, bad
+
+
+def prompt_rows(d, p):
+    ours, variants = {}, []
+    for f in sorted(glob.glob(f"{d}/cmpt-teacher-{p}-*.json")):
+        m = re.search(rf"cmpt-teacher-{p}-(\d+)-(\d+)(-[^.]+)?\.json$", f)
+        if not m:
+            continue
+        if m.group(3):
+            variants.append((int(m.group(1)), int(m.group(2)), m.group(3)[1:]))
+            continue
+        ours |= load_layers(f)
+    tight = load_layers(f"{d}/cmp-tightref-{p}.json")
+    rows = {}
+    for k, o in ours.items():
+        if not k.isdigit():
+            continue
+        t = tight.get(k)
+        r = {"rel_eq": same_rel(o), "rel_all": o["h"]["rel"], "eq_frac": o["h"]["equal_frac"],
+             "swaps": o.get("route", {}).get("mismatch_rows", 0),
+             "untied": o.get("route", {}).get("untied_rows", 0) if o.get("route") else 0,
+             "rows": o.get("route", {}).get("rows", 0), "pass_cmp": o.get("pass")}
+        if t:
+            r["oracle_rel_eq"] = same_rel(t)
+            r["oracle_swaps"] = t.get("route", {}).get("mismatch_rows", 0)
+            r["ratio"] = r["rel_eq"] / r["oracle_rel_eq"] if r["oracle_rel_eq"] > 0 else float("inf")
+            if "route_logits" in o and "route_logits" in t:
+                r["ratio_r"] = o["route_logits"]["rel"] / max(t["route_logits"]["rel"], 1e-30)
+                r["route_rel"] = o["route_logits"]["rel"]
+                r["oracle_route_rel"] = t["route_logits"]["rel"]
+        sw = [s for s in o.get("route", {}).get("swaps", []) if "score_err" in s]
+        r["max_score_err"] = max((s["score_err"] / 2 for s in sw), default=0.0)
+        r["ok"] = (r["untied"] == 0 and r["rel_eq"] <= 1e-2 and r.get("ratio", float("inf")) <= 1.0
+                   and r.get("ratio_r", 0.0) <= 1.0)
+        rows[int(k)] = r
+    head = None
+    if "logits" in ours:
+        o, t = ours["logits"], tight.get("logits", {})
+        head = {"top1": o.get("top1_equal_frac"), "oracle_top1": t.get("top1_equal_frac"), "kl_mean": o.get("kl_mean"),
+                "kl_max": o.get("kl_max"), "rel": o.get("rel"), "oracle_rel": t.get("rel"),
+                "final_rel": ours.get("final", {}).get("rel"), "oracle_kl_max": t.get("kl_max")}
+        head["ok"] = (head["top1"] is not None and head["top1"] >= (head["oracle_top1"] or 0) and head["kl_max"] <= 1e-2)
+    inv = []
+    for a, b, tag in variants:
+        base = f"{d}/teacher-{p}-{a}-{b}.st"
+        var = f"{d}/teacher-{p}-{a}-{b}-{tag}.st"
+        if os.path.exists(base) and os.path.exists(var):
+            n, bad = bit_diff(base, var)
+            chunk = json.load(open(f"{d}/cmpt-teacher-{p}-{a}-{b}-{tag}.json"))["meta"].get("chunk")
+            inv.append({"range": f"{a}:{b}", "tag": tag, "chunk": chunk, "tensors": n, "differ": bad})
+    return rows, head, inv
+
+
+def chain_rows(c, p):
+    o, t = load_layers(f"{c}/cmp-ours-tight-{p}.json"), load_layers(f"{c}/cmp-oracle-tight-{p}.json")
+    if not o:
+        return None
+    out = {}
+    for k in o:
+        if k.isdigit() and k in t:
+            out[int(k)] = {"ours_eq": same_rel(o[k]), "oracle_eq": same_rel(t[k]), "ours_all": o[k]["h"]["rel"],
+                           "oracle_all": t[k]["h"]["rel"], "ours_swaps": o[k].get("route", {}).get("mismatch_rows", 0),
+                           "oracle_swaps": t[k].get("route", {}).get("mismatch_rows", 0)}
+    lo, lt = o.get("logits", {}), t.get("logits", {})
+    head = {"ours_top1": lo.get("top1_equal_frac"), "oracle_top1": lt.get("top1_equal_frac"),
+            "ours_kl_mean": lo.get("kl_mean"), "ours_kl_max": lo.get("kl_max"), "oracle_kl_mean": lt.get("kl_mean"),
+            "oracle_kl_max": lt.get("kl_max"), "ours_final": o.get("final", {}).get("rel"),
+            "oracle_final": t.get("final", {}).get("rel")}
+    every = json.load(open(f"{c}/head-{p}.json")) if os.path.exists(f"{c}/head-{p}.json") else {}
+    return {"layers": out, "head": head, "every_row": every}
+
+
+def f(x, n=2):
+    return "n/a" if x is None else f"{x:.{n}e}"
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("dir")
+    ap.add_argument("--prompts", default=",".join(PROMPTS))
+    ap.add_argument("--chain", default="")
+    ap.add_argument("--md", default="")
+    ap.add_argument("--json", default="")
+    a = ap.parse_args()
+    prompts = a.prompts.split(",")
+    res = {p: dict(zip(("layers", "head", "invariance"), prompt_rows(a.dir, p))) for p in prompts}
+    md = []
+    md.append("| Layer type | " + " | ".join(prompts) + " |")
+    md.append("| --- |" + " --- |" * len(prompts))
+    verdict = True
+    for title, key in GROUPS:
+        cells = []
+        for p in prompts:
+            ls = {L: r for L, r in res[p]["layers"].items() if kind(L)[key]}
+            if not ls:
+                cells.append("not run")
+                continue
+            ok = all(r["ok"] for r in ls.values())
+            verdict &= ok
+            worst = max(ls, key=lambda L: ls[L]["rel_eq"])
+            wr = max(ls, key=lambda L: ls[L].get("ratio", 0))
+            sw = sum(r["swaps"] for r in ls.values())
+            un = sum(r["untied"] for r in ls.values())
+            osw = sum(r.get("oracle_swaps", 0) for r in ls.values())
+            cells.append(f"{'PASS' if ok else 'FAIL'} {len(ls)} layers; rel* max {f(ls[worst]['rel_eq'])} (L{worst}),"
+                         f" ratio* max {ls[wr].get('ratio', float('nan')):.2f} (L{wr}); picks differ {sw} rows,"
+                         f" {sw - un} ties (oracle {osw})")
+        md.append(f"| {title} | " + " | ".join(cells) + " |")
+    cells = []
+    for p in prompts:
+        h = res[p]["head"]
+        if not h:
+            cells.append("not run")
+            continue
+        verdict &= h["ok"]
+        cells.append(f"{'PASS' if h['ok'] else 'FAIL'} top-1 {h['top1']:.4f} (oracle {h['oracle_top1']:.4f}),"
+                     f" KL mean {f(h['kl_mean'])} max {f(h['kl_max'])}, logits rel {f(h['rel'])}")
+    md.append("| head / logits | " + " | ".join(cells) + " |")
+    cells = []
+    for p in prompts:
+        ls = res[p]["layers"]
+        cover = sorted(ls)
+        missing = [L for L in range(48) if L not in ls]
+        sw = sum(r["swaps"] for r in ls.values())
+        osw = sum(r.get("oracle_swaps", 0) for r in ls.values())
+        inv = res[p]["invariance"]
+        invok = all(x["differ"] == 0 for x in inv)
+        verdict &= sw <= osw and invok
+        cells.append(f"{len(cover)} of 48 layers{'' if not missing else ' (missing ' + str(missing) + ')'}; picks differ"
+                     f" {sw} rows vs the oracle's {osw} ({'R4 ok' if sw <= osw else 'R4 FAIL'}); chunk variants: "
+                     + ("; ".join(f"{x['range']} chunk {x['chunk']} {'bit-equal' if x['differ'] == 0 else 'DIFFER ' + str(x['differ'])}"
+                                  for x in inv) or "none"))
+    md.append("| coverage, R4, row invariance | " + " | ".join(cells) + " |")
+    md.append("")
+    md.append(f"G1 teacher-fed verdict: {'PASS' if verdict else 'FAIL'}")
+    md.append("")
+    md.append("Per layer (teacher-fed): rel* = ours~tight over equal-pick rows; ratio* = rel* / the oracle's; ratio_r ="
+              " router-logit distance / the oracle's; picks = rows differing from tight (ties) / the oracle's.")
+    md.append("")
+    md.append("| L | type | " + " | ".join(f"{p} rel* / ratio* / ratio_r / picks" for p in prompts) + " |")
+    md.append("| --- | --- |" + " --- |" * len(prompts))
+    for L in range(48):
+        k = kind(L)
+        t = ("global" if k["global"] else "sliding") + (" boundary" if k["boundary"] else "") + (" NVFP4" if k["NVFP4"] else " MXFP8")
+        cells = []
+        for p in prompts:
+            r = res[p]["layers"].get(L)
+            if not r:
+                cells.append("-")
+                continue
+            cells.append(f"{f(r['rel_eq'])} / {r.get('ratio', float('nan')):.2f} / {r.get('ratio_r', float('nan')):.2f} /"
+                         f" {r['swaps']} ({r['swaps'] - r['untied']}) / {r.get('oracle_swaps', '?')}"
+                         + ("" if r["ok"] else " FAIL"))
+        md.append(f"| {L} | {t} | " + " | ".join(cells) + " |")
+    if a.chain:
+        md.append("")
+        md.append("Chained drift (our 48 layers chained from the embedding, in five ranges, against the tight oracle's"
+                  " chain; the default oracle's chain against the same):")
+        md.append("")
+        md.append("| prompt | layer 11 ours / oracle | layer 23 | layer 35 | layer 47 | ours/oracle ratio: max (layer), median"
+                  " | final ours / oracle | logits top-1 ours / oracle | KL mean ours / oracle | KL max ours / oracle |")
+        md.append("| --- |" + " --- |" * 9)
+        res["chain"] = {}
+        for p in prompts:
+            c = chain_rows(a.chain, p)
+            if not c:
+                continue
+            res["chain"][p] = c
+            ls, h = c["layers"], c["head"]
+            cell = lambda L: f"{f(ls[L]['ours_eq'])} / {f(ls[L]['oracle_eq'])}" if L in ls else "-"  # noqa: E731
+            rat = {L: ls[L]["ours_eq"] / ls[L]["oracle_eq"] for L in ls if ls[L]["oracle_eq"] > 0}
+            wl = max(rat, key=rat.get) if rat else None
+            med = sorted(rat.values())[len(rat) // 2] if rat else float("nan")
+            md.append(f"| {p} | {cell(11)} | {cell(23)} | {cell(35)} | {cell(47)} | "
+                      f"{rat[wl]:.2f} (L{wl}), median {med:.2f} | {f(h['ours_final'])} / {f(h['oracle_final'])} | "
+                      f"{h['ours_top1']} / {h['oracle_top1']} | {f(h['ours_kl_mean'])} / {f(h['oracle_kl_mean'])} | "
+                      f"{f(h['ours_kl_max'])} / {f(h['oracle_kl_max'])} |" if wl is not None else f"| {p} | incomplete |")
+        rows = [(p, c["every_row"]) for p, c in res["chain"].items() if c.get("every_row")]
+        if rows:
+            md.append("")
+            md.append("The chained head at every row (torch's unembed on each chain's final rows, against the tight chain's):")
+            md.append("")
+            md.append("| prompt | rows | top-1 equal ours / oracle | tight top-1 in top 5 ours / oracle | KL mean ours / oracle |"
+                      " KL p99 ours / oracle | KL max ours / oracle |")
+            md.append("| --- |" + " --- |" * 6)
+            for p, e in rows:
+                o, t = e.get("ours", {}), e.get("oracle", {})
+                md.append(f"| {p} | {o.get('rows')} | {o.get('top1_equal_frac', 0):.4f} / {t.get('top1_equal_frac', 0):.4f} |"
+                          f" {o.get('ref_top1_in_top5_frac', 0):.4f} / {t.get('ref_top1_in_top5_frac', 0):.4f} |"
+                          f" {f(o.get('kl_mean'))} / {f(t.get('kl_mean'))} | {f(o.get('kl_p99'))} / {f(t.get('kl_p99'))} |"
+                          f" {f(o.get('kl_max'))} / {f(t.get('kl_max'))} |")
+        md.append("")
+        for p, c in res["chain"].items():
+            # the oracle's logits.rows: strictly at least the oracle's agreement
+            o, t = c["head"]["ours_top1"] or 0, c["head"]["oracle_top1"] or 1
+            ok = o >= t
+            verdict &= ok
+            md.append(f"Chained head, {p} (logits.rows): top-1 agreement with the tight chain, ours {o:.4f} against the"
+                      f" oracle's {t:.4f}: {'ok' if ok else 'FAIL'}")
+            e = c.get("every_row") or {}
+            if e:
+                # every row: a chained forward is chaotic past ~10 layers, so which rows flip is chance; the count of
+                # rows whose top-1 leaves the tight chain's is held to the oracle's count plus two Poisson deviations
+                n = e["ours"]["rows"]
+                do = round(n * (1 - e["ours"]["top1_equal_frac"]))
+                dt = round(n * (1 - e["oracle"]["top1_equal_frac"]))
+                lim = dt + 2 * max(dt, 1) ** 0.5
+                ok = do <= lim
+                verdict &= ok
+                md.append(f"Chained head, {p} (every row): rows whose top-1 differs from the tight chain's, ours {do} of {n}"
+                          f" against the oracle's {dt} (limit {lim:.1f}; strictly {'no more' if do <= dt else 'MORE'}):"
+                          f" {'ok' if ok else 'FAIL'}")
+        md.append("")
+        md.append(f"G1 verdict (teacher-fed table, invariance and the chained head): {'PASS' if verdict else 'FAIL'}")
+    text = "\n".join(md)
+    print(text)
+    if a.md:
+        with open(a.md, "w") as fh:
+            fh.write(text + "\n")
+    if a.json:
+        with open(a.json, "w") as fh:
+            json.dump(res, fh, indent=1, default=str)
+    return 0 if verdict else 1
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/zig/inkling2_greedy.py b/tools/zig/inkling2_greedy.py
new file mode 100644
index 0000000000000000000000000000000000000000..12c77c228426ad28660de3edcd68dfd08e144621
--- /dev/null
+++ b/tools/zig/inkling2_greedy.py
@@ -0,0 +1,112 @@
+#!/usr/bin/env python3
+"""Greedy text by teacher forcing, for runs of tf-inkling2-cuda that cannot hold the whole model at once.
+
+Greedy decoding is determined by the argmax at each step given the tokens before it. So one forward over the prompt
+plus a candidate continuation (the oracle's greedy reply, tools/zig/inkling2_ref.py's decode.json) checks a whole
+greedy reply at once: if the engine's top-1 after every prefix equals the next candidate token, the engine's greedy
+text is exactly the candidate; at the first row where it differs, the engine's greedy text leaves the candidate there.
+Layer ranges chain through files in the oracle's format (ids, rows, logits.rows, embed, h.<L>), so each range can run
+on its own load.
+
+  make  ORACLE_PROMPT DECODE_JSON OUT [--tokens N]  the prompt's ids plus the first N tokens of its greedy reply
+  feed  BASE OUT DUMP...                           BASE plus the embed and h.<L> rows of the dumps (next range's input)
+  read  BASE DUMP --model DIR                      the dump's logits.full: top-1 at each continuation row, the text
+"""
+import argparse
+import json
+import os
+import sys
+
+import torch
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+
+def make(a):
+    f = safe_open(a.prompt, framework="pt")
+    ids = f.get_tensor("ids").to(torch.int64)
+    name = os.path.basename(a.prompt).removesuffix(".safetensors")
+    cont = json.load(open(a.decode))[name]["ids"][: a.tokens]
+    T0 = ids.shape[0]
+    full = torch.cat([ids, torch.tensor(cont, dtype=torch.int64)])
+    T = full.shape[0]
+    # row T0 - 1 predicts cont[0]; row T0 - 1 + j predicts cont[j]; the last row predicts the token after them
+    lrows = torch.arange(T0 - 1, T, dtype=torch.int64)
+    meta = {"tool": "inkling2_greedy.py make", "prompt": name, "prompt_rows": str(T0), "continuation": json.dumps(cont)}
+    save_file({"ids": full, "rows": torch.arange(T, dtype=torch.int64), "logits.rows": lrows}, a.out, metadata=meta)
+    print(f"{a.out}: {T0} prompt rows + {len(cont)} continuation tokens; head rows {T0 - 1}..{T - 1}")
+    return 0
+
+
+def feed(a):
+    b = safe_open(a.base, framework="pt")
+    out = {k: b.get_tensor(k) for k in b.keys()}
+    meta = b.metadata() or {}
+    for p in a.dumps:
+        d = safe_open(p, framework="pt")
+        m = d.metadata() or {}
+        if m.get("status") != "complete":
+            raise SystemExit(f"{p}: the run did not finish ({m.get('status')})")
+        for k in d.keys():
+            if k == "embed" or k.startswith("h."):
+                out[k] = d.get_tensor(k)
+    save_file({k: v.contiguous() for k, v in out.items()}, a.out, metadata=meta)
+    hs = sorted(int(k[2:]) for k in out if k.startswith("h."))
+    print(f"{a.out}: layer outputs h.{hs[0]}..h.{hs[-1]}, {len(out)} tensors")
+    return 0
+
+
+def read(a):
+    from tokenizers import Tokenizer
+
+    b = safe_open(a.base, framework="pt")
+    meta = b.metadata()
+    cont = json.loads(meta["continuation"])
+    d = safe_open(a.dump, framework="pt")
+    m = d.metadata() or {}
+    if m.get("status") != "complete":
+        raise SystemExit(f"{a.dump}: not a finished run (status: {m.get('status')})")
+    lg = d.get_tensor("logits.full").float()
+    top = lg.argmax(-1).tolist()
+    tok = Tokenizer.from_file(os.path.join(a.model, "tokenizer.json"))
+    agree = 0
+    for j, t in enumerate(cont):
+        if top[j] != t:
+            break
+        agree += 1
+    ours = top[:agree] + ([top[agree]] if agree < len(top) else [])
+    res = {"continuation_tokens": len(cont), "greedy_equal_prefix": agree, "next_after": top[len(cont)] if len(top) > len(cont) else None,
+           "text_candidate": tok.decode(cont, skip_special_tokens=False),
+           "text_ours": tok.decode(ours, skip_special_tokens=False)}
+    if agree < len(cont):
+        p = torch.softmax(lg[agree].double(), -1)
+        res["first_difference"] = {"row": agree, "ours": top[agree], "candidate": cont[agree],
+                                   "p_ours": float(p[top[agree]]), "p_candidate": float(p[cont[agree]])}
+    print(json.dumps(res, indent=1, ensure_ascii=False))
+    print(f"greedy: {agree} of {len(cont)} tokens equal the candidate" + (" (every one)" if agree == len(cont) else ""))
+    return 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    m = sub.add_parser("make")
+    m.add_argument("prompt")
+    m.add_argument("decode")
+    m.add_argument("out")
+    m.add_argument("--tokens", type=int, default=32)
+    f = sub.add_parser("feed")
+    f.add_argument("base")
+    f.add_argument("out")
+    f.add_argument("dumps", nargs="+")
+    r = sub.add_parser("read")
+    r.add_argument("base")
+    r.add_argument("dump")
+    r.add_argument("--model", required=True)
+    a = ap.parse_args()
+    torch.set_grad_enabled(False)
+    return {"make": make, "feed": feed, "read": read}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/zig/inkling2_image_fixtures.py b/tools/zig/inkling2_image_fixtures.py
new file mode 100644
index 0000000000000000000000000000000000000000..cc0556c86cc4693fac77c3e3aa21d70a97d557ec
--- /dev/null
+++ b/tools/zig/inkling2_image_fixtures.py
@@ -0,0 +1,276 @@
+"""Inkling-2 image fixtures and what Transformers' Inkling2ImageProcessor makes of them (gate V1's oracle).
+
+Each case is opened with Pillow, turned upright (ImageOps.exif_transpose) and handed to the processor as the opened
+image, the route that composites alpha onto the processor's checkerboard (design decision D1). For each case the
+output records the upright size, the RGB bytes the processor's convert_to_rgb gives (sha256), the grid and the fp32
+pixel values (sha256 of their little-endian bytes, [rows * cols, 40, 40, 3]).
+
+  small: python -I inkling2_image_fixtures.py --out zig/tests/fixtures/inkling2/images.json
+  large: python -I inkling2_image_fixtures.py --large --out DIR/images.json   (pictures written beside it)
+  check: python -I inkling2_image_fixtures.py --check JSON   (the oracle here, on that json's own pictures)
+
+--check is gate V1's oracle run: encoders differ by platform, so the oracle is rerun on the committed bytes and every
+recorded field must come out equal (exit 1 on any difference, 2 on an empty set).
+
+The Zig side is zig/src/families/inkling2/image_test.zig; TF_INK2_IMAGE_FIXTURES names a large set's json.
+Needs Pillow 12.3.0 (libjpeg-turbo 3.1.4.1, libwebp 1.6.0: the decoders TensorFold pins), torch, torchvision and
+Transformers with models/inkling2 (the oracle's 109a7d19).
+"""
+
+from __future__ import annotations
+
+import argparse
+import base64
+import hashlib
+import io
+import json
+import os
+import platform
+import sys
+
+import numpy as np
+from PIL import Image, ImageOps, features
+
+SIDE = 4096  # the recipe's limit a side (design D2)
+PIXELS = 16 << 20  # TensorFold's decoded-pixel bound
+
+
+def sha(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+def gradient(w: int, h: int, channels: int, seed: int) -> np.ndarray:
+    """Smooth ramps plus a noisy channel: every byte value appears, and the files stay small."""
+    y, x = np.mgrid[0:h, 0:w]
+    rng = np.random.default_rng(seed)
+    a = np.empty((h, w, 4), np.uint8)
+    a[..., 0] = (x * 255 // max(w - 1, 1)).astype(np.uint8)
+    a[..., 1] = (y * 255 // max(h - 1, 1)).astype(np.uint8)
+    a[..., 2] = ((x * 7 + y * 13) % 256).astype(np.uint8)
+    # alpha: every value 0..255 along a diagonal, with fully clear and fully opaque runs
+    a[..., 3] = np.clip(((x + 2 * y) % 320) - 32, 0, 255).astype(np.uint8)
+    if min(w, h) <= 64:
+        a[..., 2] = rng.integers(0, 256, (h, w), dtype=np.uint8)
+    return a[..., :channels]
+
+
+def enc(im: Image.Image, fmt: str, **kw) -> bytes:
+    buf = io.BytesIO()
+    im.save(buf, fmt, **kw)
+    return buf.getvalue()
+
+
+def exif_with(o: int) -> bytes:
+    e = Image.Exif()
+    e[0x0112] = o
+    return e.tobytes()
+
+
+def small_cases() -> list[tuple[str, bytes]]:
+    rgb = lambda w, h, s=1: Image.fromarray(gradient(w, h, 3, s))
+    rgba = lambda w, h, s=1: Image.fromarray(gradient(w, h, 4, s))
+    out: list[tuple[str, bytes]] = []
+    # PNG layouts (TensorFold's own decoder)
+    out.append(("png_rgb_1x1", enc(rgb(1, 1), "PNG")))
+    out.append(("png_rgb_39x41", enc(rgb(39, 41), "PNG")))
+    out.append(("png_rgb_40x40", enc(rgb(40, 40), "PNG")))
+    out.append(("png_rgb_41x39", enc(rgb(41, 39), "PNG")))
+    out.append(("png_rgb_448x336", enc(rgb(448, 336), "PNG")))
+    out.append(("png_rgba_partial_97x61", enc(rgba(97, 61), "PNG")))
+    out.append(("png_rgba_opaque_50x30", enc(Image.fromarray(np.dstack([gradient(50, 30, 3, 2), np.full((30, 50), 255, np.uint8)])), "PNG")))
+    out.append(("png_rgba_clear_17x9", enc(Image.fromarray(np.dstack([gradient(17, 9, 3, 3), np.zeros((9, 17), np.uint8)])), "PNG")))
+    out.append(("png_interlaced_rgba_83x45", interlaced(rgba(83, 45, 4))))
+    pal = rgb(64, 48).quantize(colors=200)
+    out.append(("png_palette_64x48", enc(pal, "PNG")))
+    out.append(("png_palette_trns_64x48", enc(pal, "PNG", transparency=bytes((i * 37) % 256 for i in range(200)))))
+    g = Image.fromarray(gradient(70, 33, 3, 5)[..., 0])
+    out.append(("png_gray_70x33", enc(g, "PNG")))
+    out.append(("png_gray_trns_70x33", enc(g, "PNG", transparency=128)))
+    la = Image.fromarray(np.dstack([gradient(45, 50, 3, 6)[..., 1], gradient(45, 50, 4, 6)[..., 3]]), "LA")
+    out.append(("png_gray_alpha_45x50", enc(la, "PNG")))
+    out.append(("png_rgb_trns_33x21", enc(rgb(33, 21, 7), "PNG", transparency=(0, 0, 0))))
+    g16 = Image.fromarray((gradient(60, 20, 3, 8)[..., 0].astype(np.uint16) * 257 + np.arange(60, dtype=np.uint16)[None, :]).astype(np.uint16), "I;16")
+    out.append(("png_gray16_60x20", enc(g16, "PNG")))
+    out.append(("png_1bit_37x29", enc(rgb(37, 29).convert("1"), "PNG")))
+    for o in (3, 6, 8):
+        out.append((f"png_exif{o}_rgba_43x27", enc(rgba(43, 27, 9), "PNG", exif=exif_with(o))))
+    # JPEG (libjpeg-turbo 3.1.4.1)
+    out.append(("jpeg_baseline_448x336", enc(rgb(448, 336), "JPEG", quality=85)))
+    out.append(("jpeg_progressive_123x77", enc(rgb(123, 77, 10), "JPEG", quality=90, progressive=True)))
+    out.append(("jpeg_444_61x39", enc(rgb(61, 39, 11), "JPEG", quality=92, subsampling=0)))
+    out.append(("jpeg_422_61x39", enc(rgb(61, 39, 11), "JPEG", quality=92, subsampling=1)))
+    out.append(("jpeg_420_odd_41x39", enc(rgb(41, 39, 12), "JPEG", quality=75, subsampling=2)))
+    out.append(("jpeg_gray_88x40", enc(rgb(88, 40, 13).convert("L"), "JPEG", quality=80)))
+    out.append(("jpeg_1x1", enc(rgb(1, 1), "JPEG")))
+    for o in range(1, 9):
+        out.append((f"jpeg_exif{o}_57x31", enc(rgb(57, 31, 14), "JPEG", quality=88, exif=exif_with(o))))
+    out.append(("jpeg_cmyk_16x16", enc(rgb(16, 16).convert("CMYK"), "JPEG")))
+    # a multi-picture JPEG: Pillow opens an MpoImageFile of two frames, which the processor's route refuses
+    out.append(("jpeg_mpo_two_48x32", enc(rgb(48, 32, 22), "MPO", save_all=True, append_images=[rgb(48, 32, 23)])))
+    # WebP (libwebp 1.6.0)
+    out.append(("webp_lossy_157x93", enc(rgb(157, 93, 15), "WEBP", quality=80)))
+    out.append(("webp_lossless_64x48", enc(rgb(64, 48, 16), "WEBP", lossless=True)))
+    out.append(("webp_lossy_alpha_57x41", enc(rgba(57, 41, 17), "WEBP", quality=70)))
+    out.append(("webp_lossless_alpha_40x80", enc(rgba(40, 80, 18), "WEBP", lossless=True)))
+    out.append(("webp_exif6_alpha_30x20", enc(rgba(30, 20, 19), "WEBP", lossless=True, exif=exif_with(6))))
+    # refusals before any pixel is allocated
+    out.append(("png_side_4097x1", enc(rgb(4097, 1), "PNG")))
+    out.append(("png_side_1x4097", enc(rgb(1, 4097), "PNG")))
+    frames = [rgb(16, 16, s) for s in (20, 21)]
+    out.append(("png_animated_16x16", enc(frames[0], "PNG", save_all=True, append_images=frames[1:])))
+    out.append(("gif_16x16", enc(rgb(16, 16), "GIF")))
+    return out
+
+
+def interlaced(im: Image.Image) -> bytes:
+    """Pillow cannot write Adam7; build it from the rows with zlib (filter 0 per pass row)."""
+    import struct
+    import zlib
+
+    a = np.asarray(im.convert("RGBA"))
+    h, w = a.shape[:2]
+    raw = bytearray()
+    for x0, y0, dx, dy in ((0, 0, 8, 8), (4, 0, 8, 8), (0, 4, 4, 8), (2, 0, 4, 4), (0, 2, 2, 4), (1, 0, 2, 2), (0, 1, 1, 2)):
+        sub = a[y0::dy, x0::dx]
+        if sub.shape[0] == 0 or sub.shape[1] == 0:
+            continue
+        for row in sub:
+            raw += b"\x00" + row.tobytes()
+
+    def chunk(kind: bytes, body: bytes) -> bytes:
+        return struct.pack(">I", len(body)) + kind + body + struct.pack(">I", zlib.crc32(kind + body) & 0xFFFFFFFF)
+
+    return b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 6, 0, 0, 1)) + chunk(b"IDAT", zlib.compress(bytes(raw), 9)) + chunk(b"IEND", b"")
+
+
+def large_cases() -> list[tuple[str, bytes]]:
+    rgb = lambda w, h, s=1: Image.fromarray(gradient(w, h, 3, s))
+    rgba = lambda w, h, s=1: Image.fromarray(gradient(w, h, 4, s))
+    out: list[tuple[str, bytes]] = []
+    for w, h in ((1024, 768), (1920, 1080), (2048, 2048), (3840, 2160), (4096, 4096)):
+        out.append((f"png_rgb_{w}x{h}", enc(rgb(w, h, w + h), "PNG")))
+        out.append((f"jpeg_{w}x{h}", enc(rgb(w, h, w + h), "JPEG", quality=85)))
+    out.append(("png_rgba_1920x1080", enc(rgba(1920, 1080, 31), "PNG")))
+    out.append(("webp_lossy_1920x1080", enc(rgb(1920, 1080, 32), "WEBP", quality=80)))
+    out.append(("webp_alpha_1024x768", enc(rgba(1024, 768, 33), "WEBP", quality=75)))
+    out.append(("jpeg_exif6_4032x3024", enc(rgb(4032, 3024, 34), "JPEG", quality=85, exif=exif_with(6))))
+    out.append(("png_4096x4097", enc(rgb(4096, 4097, 35), "PNG")))
+    return out
+
+
+def processor():
+    from transformers.models.inkling2.image_processing_inkling2 import Inkling2ImageProcessor
+
+    # processor_config.json's image_processor block (its values are the class defaults)
+    return Inkling2ImageProcessor(do_convert_rgb=True, do_normalize=True, do_rescale=True, image_mean=[0.5, 0.5, 0.5], image_std=[0.5, 0.5, 0.5], rescale_factor=0.00392156862745098, size={"height": 40, "width": 40})
+
+
+def oracle(proc, data: bytes) -> dict:
+    """The processor's outcome for one picture, or the refusal the server must give."""
+    import torch
+    from torchvision.transforms.v2 import functional as tvF
+
+    im = Image.open(io.BytesIO(data))
+    if im.format not in ("PNG", "JPEG", "MPO", "WEBP"):  # MPO: Pillow's name for a multi-picture JPEG
+        return {"problem": "format"}
+    if getattr(im, "n_frames", 1) != 1:  # animated PNG or WebP, multi-picture JPEG: one frame is served
+        return {"problem": "animated"}
+    if im.mode == "CMYK":
+        return {"problem": "cmyk"}
+    if max(im.size) > SIDE or im.size[0] * im.size[1] > PIXELS:
+        return {"problem": "side", "width": im.size[0], "height": im.size[1]}
+    im = ImageOps.exif_transpose(im)
+    # the RGB the processor composites (process_image, then convert_to_rgb), recorded for the decode check
+    t = tvF.pil_to_tensor(im.convert("RGBA" if im.has_transparency_data else "RGB"))
+    rgb = proc.convert_to_rgb(t) if t.shape[0] == 4 else t
+    assert rgb.dtype == torch.uint8 and rgb.shape[0] == 3, (rgb.dtype, rgb.shape)
+    hwc = rgb.permute(1, 2, 0).contiguous().numpy()
+    out = proc(images=[im], return_tensors="pt")
+    pv = out["pixel_values"]
+    thw = out["image_grid_thw"].tolist()[0]
+    assert pv.dtype == torch.float32 and tuple(pv.shape[1:]) == (40, 40, 3), (pv.dtype, pv.shape)
+    vals = pv.contiguous().numpy().astype("<f4", copy=False)
+    return {
+        "width": im.width,
+        "height": im.height,
+        "grid": [thw[1], thw[2]],
+        "rgb": sha(hwc.tobytes()),
+        "values": sha(vals.tobytes()),
+        "mode": im.mode,
+    }
+
+
+def check(proc, path: str) -> None:
+    with open(path) as f:
+        want = json.load(f)
+    base = os.path.dirname(os.path.abspath(path))
+    equal, differ = 0, []
+    for c in want["cases"]:
+        data = base64.b64decode(c["b64"]) if "b64" in c else open(os.path.join(base, c["file"]), "rb").read()
+        got = {"name": c["name"], "bytes": sha(data)}
+        got.update(oracle(proc, data))
+        keys = [k for k in c if k not in ("b64", "file")]
+        bad = [k for k in sorted(set(keys) | set(got)) if c.get(k) != got.get(k)]
+        if bad:
+            differ.append((c["name"], {k: (c.get(k), got.get(k)) for k in bad}))
+        else:
+            equal += 1
+    print(f"CHECK {path}: {equal}/{len(want['cases'])} cases equal on every field ({sum('problem' in c for c in want['cases'])} refusals)")
+    for name, d in differ:
+        print("  DIFFER", name, d)
+    if not want["cases"]:
+        sys.exit(2)
+    if differ:
+        sys.exit(1)
+
+
+def main() -> None:
+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    ap.add_argument("--out")
+    ap.add_argument("--large", action="store_true", help="the large set: pictures written beside --out, not inlined")
+    ap.add_argument("--check", help="a fixtures json: rerun the oracle on its pictures and compare every field")
+    args = ap.parse_args()
+    if not args.out and not args.check:
+        ap.error("--out or --check")
+    import PIL
+    import torch
+    import torchvision
+    import transformers
+
+    assert PIL.__version__ == "12.3.0", PIL.__version__
+    assert features.version_feature("libjpeg_turbo") == "3.1.4.1", features.version_feature("libjpeg_turbo")
+    assert features.version("webp") == "1.6.0", features.version("webp")
+    proc = processor()
+    if args.check:
+        check(proc, args.check)
+        return
+    cases = []
+    for name, data in large_cases() if args.large else small_cases():
+        c = {"name": name, "bytes": sha(data)}
+        if args.large:
+            fn = name + {"\x89P": ".png", "\xff\xd8": ".jpg", "RI": ".webp"}.get(data[:2].decode("latin-1"), ".bin")
+            with open(os.path.join(os.path.dirname(os.path.abspath(args.out)), fn), "wb") as f:
+                f.write(data)
+            c["file"] = fn
+        else:
+            c["b64"] = base64.b64encode(data).decode()
+        c.update(oracle(proc, data))
+        cases.append(c)
+        print(name, c.get("grid", c.get("problem")), file=sys.stderr)
+    source = {
+        "route": "Image.open, ImageOps.exif_transpose, Inkling2ImageProcessor(images=[opened image]) (alpha onto its checkerboard)",
+        "pillow": PIL.__version__,
+        "libjpeg_turbo": features.version_feature("libjpeg_turbo"),
+        "libwebp": features.version("webp"),
+        "torch": torch.__version__,
+        "torchvision": torchvision.__version__,
+        "transformers": transformers.__version__,
+        "machine": platform.machine(),
+    }
+    with open(args.out, "w") as f:
+        json.dump({"source": source, "cases": cases}, f, indent=0)
+        f.write("\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/zig/inkling2_inventory.py b/tools/zig/inkling2_inventory.py
new file mode 100644
index 0000000000000000000000000000000000000000..b5ff33a391bf34f46bc5c6dcc931988950ddd9fa
--- /dev/null
+++ b/tools/zig/inkling2_inventory.py
@@ -0,0 +1,68 @@
+"""Inkling-2-Small's safetensors inventory as a small text file: every tensor's file, dtype, shape and byte range.
+
+The Zig family's slice plan is tested against this inventory (zig/src/families/inkling2/fixtures/inventory.tsv).
+It reads the shard headers from a local checkpoint folder (only the first bytes of each file are read, so a folder
+whose shards are still downloading works once each header is on disk) or, with --hub, from the Hub by range request.
+
+  python tools/zig/inkling2_inventory.py MODEL_DIR > inventory.tsv
+  python tools/zig/inkling2_inventory.py --hub thinkingmachines/Inkling-2-Small --revision aac97412 > inventory.tsv
+
+Format, one record a line, tab-separated:
+  file <index> <name> <header_len>           every shard, in index order (data starts at 8 + header_len)
+  t <file index> <name> <dtype> <d0,d1,..> <begin> <end>   begin and end count from the file's data start
+"""
+
+import argparse
+import json
+import os
+import struct
+import sys
+import urllib.request
+
+FILES = [f"model-{i:05d}-of-00024.safetensors" for i in range(1, 25)] + ["mtp.safetensors"]
+
+
+def local(folder, name):
+    with open(os.path.join(folder, name), "rb") as f:
+        n = struct.unpack("<Q", f.read(8))[0]
+        head = f.read(n)
+    if len(head) != n:
+        raise SystemExit(f"{name}: header is {n} bytes, {len(head)} on disk")
+    return n, head
+
+
+def hub(repo, revision, name):
+    url = f"https://huggingface.co/{repo}/resolve/{revision}/{name}"
+
+    def get(a, b):
+        req = urllib.request.Request(url, headers={"Range": f"bytes={a}-{b}"})
+        with urllib.request.urlopen(req, timeout=120) as r:
+            return r.read()
+
+    n = struct.unpack("<Q", get(0, 7))[0]
+    return n, get(8, 8 + n - 1)
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument("dir", nargs="?")
+    p.add_argument("--hub")
+    p.add_argument("--revision", default="main")
+    a = p.parse_args()
+    if (a.dir is None) == (a.hub is None):
+        raise SystemExit("give a checkpoint folder or --hub REPO")
+    out = sys.stdout
+    out.write("# Inkling-2-Small safetensors inventory (tools/zig/inkling2_inventory.py)\n")
+    for i, name in enumerate(FILES):
+        n, head = local(a.dir, name) if a.dir else hub(a.hub, a.revision, name)
+        out.write(f"file\t{i}\t{name}\t{n}\n")
+        h = json.loads(head)
+        rows = [(v["data_offsets"][0], k, v) for k, v in h.items() if k != "__metadata__"]
+        for _, k, v in sorted(rows):
+            shape = ",".join(str(d) for d in v["shape"])
+            b, e = v["data_offsets"]
+            out.write(f"t\t{i}\t{k}\t{v['dtype']}\t{shape}\t{b}\t{e}\n")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/zig/inkling2_margins.py b/tools/zig/inkling2_margins.py
new file mode 100644
index 0000000000000000000000000000000000000000..8707bfcba2c2633eaf167ba2410eaf1b148550c0
--- /dev/null
+++ b/tools/zig/inkling2_margins.py
@@ -0,0 +1,395 @@
+"""Teacher-forced token margins of Inkling-2's greedy oracle replies: is each departure from the oracle a near tie?
+
+USAGE = python tools/zig/inkling2_margins.py MODEL_DIR ORACLE_DECODE_JSON --out OUT_DIR
+            [--prompts chat_short,tool_call|ext] [--ids NAME=IDS_JSON,...] [--branch LABEL=PROMPT:REPLY_JSON ...]
+            [--modes eager,eager32,fp32] [--tf-dir ORACLE_DIR] [--device cuda:0]
+
+  python tools/zig/inkling2_margins.py MODEL ORACLE/full/decode.json --out OUT \
+      --ids chat_short=data/chat_short.ids.json,tool_call=data/tool_call.ids.json \
+      --branch kx=tool_call:kx-tool_call.json --tf-dir ORACLE/full
+
+Each sequence is a prompt (rendered by inkling2_ref.py's prompt_specs, and checked equal to --ids when given) plus a
+reply: the oracle's (ORACLE_DECODE_JSON, inkling2_ref.py --decode) or a branch's (REPLY_JSON: {"ids": [...]} or
+{"text": "..."}, the text encoded by the checkpoint's tokenizer without special-token insertion, its decode checked
+equal to the text). One whole-sequence forward per sequence and mode, layers streamed as in inkling2_ref.py's
+teacher-forced pass (full mode: experts decoded to bf16, Transformers' eager modules). At every reply position j
+(the logits row of position P-1+j, P the prompt length) it records the top-5 tokens and logits, the margin
+top1 - top2, the reply's own token, its logit and rank, and the row's argmax (the oracle's greedy pick: torch's tie
+winner, the first maximal ID). Top-1 agreement is the argmax equal to the reply token; rank 0 (no logit above the
+reply's) is counted apart, as the reply at the maximum. At every departure (the first position where a branch leaves
+the oracle reply) it records, in both sequences, the logits of the two contenders and both tie rules:
+
+  upstream (tools/zig/qwen27_margins.py): near tie when the top two are exactly the two contenders and top1 - top2 is
+           at most one bf16 spacing of the top-1 logit (on both sides; here the reference side only)
+  0.5:     whether the oracle-side margin between the two contenders is under 0.5 logit (information; a server's
+           side, from prompt_logprobs, is not visible to this tool)
+
+Modes (the attention core and the cuBLAS reduction; everything else is the reference's own code):
+  eager    Transformers' eager attention (bf16 scores, bias add, softmax in fp32 rounded to bf16 P, bf16 P.V, output
+           times sigmoid(gate) rounded to bf16), cuBLAS bf16 partial reduction allowed (torch's default). The
+           arithmetic of v0.1's oracle (inkling2_ref.py --decode without --fp32-reduction).
+  eager32  eager attention, bf16 matmuls reduced in fp32 (inkling2_ref.py --fp32-reduction).
+  fp32     v0.2's oracle form (inkling2_ref.py --attn fp32: the one definition,
+           inkling2_ref.kx_core): q', k', v', the bias (the module's 16-term product, rounded to bf16) and the sink
+           logit from the eager heads as they are, then scores q.k in fp32 times the scale plus the bias, m and z over
+           the keys only, weights e^(s - m) in fp32 (never rounded), o = (weights . v) / z in fp32, times sigmoid(gate)
+           in fp32, times sigmoid((m + log z) - sink) (the sink as kx's multiplier), one bf16 rounding (at the output
+           projection's input). bf16 matmuls reduced in fp32. Until 2026-11-17 this mode folded the sink into z as a
+           logit (z + e^(sink - m)); the same value in real arithmetic, other fp32 roundings.
+TF32 is off in every mode and checked (inkling2_ref.tf32_guard: exit 3 if TF32 could be on).
+
+Output: OUT_DIR/margins.json (every row), OUT_DIR/margins.txt (the tables), OUT_DIR/manifest.json (provenance,
+modes, input sha256, wall times).
+
+Transformers (Apache-2.0) is imported through inkling2_ref.py; its eager attention is called, not copied. The fp32
+core is written from the reference document (see THIRD_PARTY_NOTICES.md).
+"""
+
+import argparse
+import hashlib
+import json
+import os
+import sys
+import time
+
+import torch
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import inkling2_ref as R  # noqa: E402
+
+BF = torch.bfloat16
+
+MODES = {
+    "eager": {"attn": "eager", "fp32_reduction": False},
+    "eager32": {"attn": "eager", "fp32_reduction": True},
+    "fp32": {"attn": "fp32", "fp32_reduction": True},
+}
+TOPK = 5
+HALF_LOGIT = 0.5
+bf16_spacing = R.bf16_spacing
+
+
+def set_mode(name: str):
+    R.ATTN["form"] = MODES[name]["attn"]
+    torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = not MODES[name]["fp32_reduction"]
+
+
+def file_sha(path: str) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        h.update(f.read())
+    return h.hexdigest()
+
+
+def load_branch(tok, path: str) -> list:
+    d = json.load(open(path))
+    if "ids" in d:
+        return [int(t) for t in d["ids"]]
+    ids = tok.encode(d["text"], add_special_tokens=False)
+    if tok.decode(ids, skip_special_tokens=False) != d["text"]:
+        raise SystemExit(f"{path}: the text does not survive encode/decode")
+    if "tokens" in d and len(ids) != d["tokens"]:
+        raise SystemExit(f"{path}: {len(ids)} tokens encoded, the server reported {d['tokens']}")
+    return ids
+
+
+def first_diff(a: list, b: list):
+    return next((i for i in range(min(len(a), len(b))) if a[i] != b[i]), None)
+
+
+def agreement(lg: torch.Tensor, reply: list) -> tuple:
+    """Rows j of lg (a logits row a reply position) against reply token j: each row's greedy pick as the oracle takes
+    it, int(lg[j].argmax()) (inkling2_ref.py --decode; torch's tie winner, the first maximal ID), the rows whose pick is
+    the reply token (top-1 agreement), and the rows where no logit exceeds the reply token's (rank 0: at a tie at the
+    maximum, every tied token counts here, the pick only in the agreement)."""
+    picks = [int(lg[j].argmax()) for j in range(len(reply))]
+    agree = sum(p == t for p, t in zip(picks, reply))
+    at_max = sum(int((lg[j] > lg[j, t]).sum()) == 0 for j, t in enumerate(reply))
+    return picks, agree, at_max
+
+
+def tie_rules(lg: torch.Tensor, raw: torch.Tensor, a: int, b: int) -> dict:
+    """lg: one softcapped fp32 logits row, raw: the same row before the softcap (the bf16 unembed output in fp32).
+    a: the oracle's token, b: the branch's token. The upstream rule is applied to both rows: to the softcapped logits
+    the sampler ranks (literal), and to the bf16 values the rounding happens in (pre-softcap)."""
+    out = {}
+    for name, row in (("softcapped", lg), ("pre_softcap", raw)):
+        v, i = row.topk(2)
+        top = [int(i[0]), int(i[1])]
+        margin = float(v[0] - v[1])
+        sp = bf16_spacing(float(v[0]))
+        gap = float(row[a] - row[b])
+        out[name] = {"top2": top, "top2_logits": [float(v[0]), float(v[1])], "top_margin": margin,
+                     "bf16_spacing": sp, "contender_logits": [float(row[a]), float(row[b])],
+                     "gap_oracle_minus_branch": gap, "gap_in_bf16_steps": gap / sp,
+                     "upstream_near_tie_ref_side": set(top) == {a, b} and margin <= sp}
+    out["under_0p5_ref_side"] = abs(out["softcapped"]["gap_oracle_minus_branch"]) < HALF_LOGIT
+    return out
+
+
+def tf_pass(model, cfg, seqs, specs, modes, dev, times):
+    """One whole-sequence forward per (sequence, mode), dense layers streamed (inkling2_ref.py's teacher-forced
+    pass)."""
+    emb = model.embed()
+    states = []
+    for s in seqs:
+        ids = torch.tensor([specs[s["prompt"]]["ids"] + s["reply"]], device=dev)
+        e = emb(ids)
+        pos = torch.arange(ids.shape[1], device=dev)[None]
+        mk = R.masks(cfg, e, pos)
+        for m in modes:
+            states.append((s, m, {"h": e, "blocks": e.new_zeros(1, ids.shape[1], 0, e.shape[-1]), "masks": mk,
+                                  "pos": pos}))
+    del emb
+    torch.cuda.empty_cache()
+    for i in range(cfg.num_hidden_layers):
+        t0 = time.time()
+        layer = model.layer(i)  # inkling2_ref.attach_attn: the fp32 form's sink factor and bf16 rounding
+        t1 = time.time()
+        for s, m, st in states:
+            set_mode(m)
+            R.run_layer(layer, st)
+        del layer
+        torch.cuda.synchronize()
+        times.append(("tf", i, round(t1 - t0, 2), round(time.time() - t1, 2)))
+        print(f"tf layer {i}: load {t1 - t0:.1f} s, run {time.time() - t1:.1f} s", flush=True)
+    head = model.head()
+    _, _, lm, cap = head
+    rows = {}
+    for s, m, st in states:
+        set_mode(m)
+        hn = R.finish(head, st)
+        P, n = s["P"], len(s["reply"])
+        raw = lm(hn[0, P - 1:P - 1 + n]).float()[..., : cfg.unpadded_vocab_size]
+        rows[(s["label"], m, "tf")] = (cap(raw).cpu(), raw.cpu())
+    del head, states
+    torch.cuda.empty_cache()
+    return rows
+
+
+def decode_pass(model, cfg, seqs, specs, modes, dev, lru_cap, times):
+    """The oracle's own path (inkling2_ref.py's greedy_decode: the prompt as one prefill, then one row a step through
+    a DynamicCache, experts decoded on use), each step fed the reply's token instead of the argmax."""
+    from transformers.cache_utils import DynamicCache
+
+    lru = R.ExpertLRU(dev, lru_cap)
+    t0 = time.time()
+    emb = model.embed()
+    layers = [model.layer(i, experts="lazy", lru=lru) for i in range(cfg.num_hidden_layers)]
+    head = model.head()
+    _, _, lm, cap = head
+    print(f"decode: resident layers built in {time.time() - t0:.1f} s", flush=True)
+    streams = [(s, m) for s in seqs for m in modes]
+    caches = [DynamicCache(config=cfg) for _ in streams]
+    cur = [torch.tensor([specs[s["prompt"]]["ids"]], device=dev) for s, _ in streams]
+    got = [([], []) for _ in streams]
+    steps = max(len(s["reply"]) for s, _ in streams)
+    for step in range(steps):
+        ts = time.time()
+        live = [k for k, (s, _) in enumerate(streams) if step < len(s["reply"])]
+        states = {}
+        for k in live:
+            c, ids = caches[k], cur[k]
+            e = emb(ids)
+            pos = (torch.arange(ids.shape[1], device=dev) + c.get_seq_length())[None]
+            states[k] = {"h": e, "blocks": e.new_zeros(1, ids.shape[1], 0, e.shape[-1]),
+                         "masks": R.masks(cfg, e, pos, c), "pos": pos}
+        for ly in layers:
+            for k in live:
+                set_mode(streams[k][1])
+                R.run_layer(ly, states[k], caches[k])
+        for k in live:
+            s, m = streams[k]
+            set_mode(m)
+            raw = lm(R.finish(head, states[k])[0, -1:]).float()[0, : cfg.unpadded_vocab_size]
+            got[k][0].append(cap(raw).cpu())
+            got[k][1].append(raw.cpu())
+            cur[k] = torch.tensor([[s["reply"][step]]], device=dev)
+        times.append(("decode", step, len(live), round(time.time() - ts, 2)))
+        print(f"decode step {step}: {len(live)} streams, {time.time() - ts:.1f} s, expert hits {lru.hits} "
+              f"misses {lru.misses}", flush=True)
+    rows = {(s["label"], m, "decode"): (torch.stack(g[0]), torch.stack(g[1])) for (s, m), g in zip(streams, got)}
+    del layers, head, caches, lru
+    torch.cuda.empty_cache()
+    return rows
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("model_dir")
+    ap.add_argument("oracle_decode")
+    ap.add_argument("--out", required=True)
+    ap.add_argument("--prompts", default="chat_short,tool_call", help="prompt_specs or ext_specs names; 'ext' "
+                    "stands for all of ext_specs (in their order)")
+    ap.add_argument("--ids", default="", help="NAME=IDS_JSON,...: the prompt ids the server is given; must equal the "
+                    "reference's rendering")
+    ap.add_argument("--branch", action="append", default=[], help="LABEL=PROMPT:REPLY_JSON (repeatable)")
+    ap.add_argument("--modes", default="eager,eager32,fp32")
+    ap.add_argument("--paths", default="tf,decode", help="tf: one whole-sequence forward; decode: the oracle's own "
+                    "prefill + one-row steps, fed the reply")
+    ap.add_argument("--tf-dir", default="", help="the oracle's teacher-forced folder (inkling2_ref.py --out .../full): "
+                    "its last prompt row's top-64 logits compared with this run's eager row P-1 of each path")
+    ap.add_argument("--device", default="cuda:0")
+    ap.add_argument("--expert-cache", type=int, default=1000, help="decode path: experts kept on --device")
+    ap.add_argument("--layers", type=int, default=0, help="only the first N layers, then the head (smoke; 0: all)")
+    a = ap.parse_args()
+    t_start = time.time()
+    from transformers import AutoTokenizer
+
+    modes = a.modes.split(",")
+    paths = a.paths.split(",")
+    for m in modes:
+        if m not in MODES:
+            raise SystemExit(f"unknown mode {m}")
+    for p in paths:
+        if p not in ("tf", "decode"):
+            raise SystemExit(f"unknown path {p}")
+    dev = torch.device(a.device)
+    tok = AutoTokenizer.from_pretrained(a.model_dir)
+    cfg = R.text_config(a.model_dir, a.layers)
+    specs = {s["name"]: s for s in R.prompt_specs(tok) + R.ext_specs(tok)}
+    for s in specs.values():
+        s["text"], s["ids"] = R.render(tok, s)
+    inputs = {"oracle_decode": {"path": a.oracle_decode, "sha256": file_sha(a.oracle_decode)}}
+    for kv in filter(None, a.ids.split(",")):
+        name, path = kv.split("=", 1)
+        given = [int(t) for t in json.load(open(path))]
+        if given != specs[name]["ids"]:
+            raise SystemExit(f"{name}: {path} differs from the reference's rendering")
+        inputs[f"ids.{name}"] = {"path": path, "sha256": file_sha(path), "tokens": len(given)}
+    oracle = json.load(open(a.oracle_decode))
+    seqs = []
+    names = [n for p in a.prompts.split(",") for n in ([e["name"] for e in R.ext_specs(tok)] if p == "ext" else [p])]
+    for name in names:
+        ids = oracle[name]["ids"]
+        seqs.append({"label": f"{name}/oracle", "prompt": name, "reply": ids, "oracle": ids})
+    for br in a.branch:
+        label, rest = br.split("=", 1)
+        name, path = rest.split(":", 1)
+        ids = load_branch(tok, path)
+        inputs[f"branch.{label}"] = {"path": path, "sha256": file_sha(path), "tokens": len(ids), "ids": ids}
+        seqs.append({"label": f"{name}/{label}", "prompt": name, "reply": ids, "oracle": oracle[name]["ids"]})
+    for s in seqs:
+        s["P"] = len(specs[s["prompt"]]["ids"])
+        s["departure"] = first_diff(s["reply"], s["oracle"])
+
+    tf32 = R.tf32_guard(dev)
+    model = R.Model(a.model_dir, cfg, dev, "full")  # installs inkling2_ref's attention dispatch
+    rows, times = {}, []
+    with torch.no_grad():
+        if "tf" in paths:
+            rows.update(tf_pass(model, cfg, seqs, specs, modes, dev, times))
+        if "decode" in paths:
+            rows.update(decode_pass(model, cfg, seqs, specs, modes, dev, a.expert_cache, times))
+
+    res = {"modes": {m: MODES[m] for m in modes}, "paths": paths, "checks": {}, "sequences": [], "departures": []}
+    if a.tf_dir and "eager" in modes:
+        from safetensors.torch import load_file
+        for s in seqs:
+            if not s["label"].endswith("/oracle"):
+                continue
+            ref = load_file(os.path.join(a.tf_dir, s["prompt"] + ".safetensors"))
+            ri, rv = ref["topk.ids"][-1].long(), ref["topk.vals"][-1]
+            for p in paths:
+                g = rows[(s["label"], "eager", p)][0][0]
+                res["checks"][f"{s['prompt']} {p} eager row P-1 vs the oracle's teacher-forced file"] = {
+                    "top1_equal": int(ri[0]) == int(g.argmax()), "top64_max_abs_diff": float((g[ri] - rv).abs().max()),
+                    "top64_bit_equal": bool(torch.equal(g[ri], rv))}
+    if "decode" in paths and "eager" in modes:
+        for s in seqs:
+            if s["label"].endswith("/oracle") and "prefill_top5" in oracle[s["prompt"]]:
+                g = rows[(s["label"], "eager", "decode")][0][0]
+                res["checks"][f"{s['prompt']} decode eager prefill top-5 vs decode.json"] = {
+                    "equal": g.topk(5).indices.tolist() == oracle[s["prompt"]]["prefill_top5"]}
+    for s in seqs:
+        for p in paths:
+            for m in modes:
+                lg, raw = rows[(s["label"], m, p)]
+                picks, agree, at_max = agreement(lg, s["reply"])
+                out = []
+                for j, t in enumerate(s["reply"]):
+                    v, i = lg[j].topk(TOPK)
+                    rv = raw[j].topk(2).values
+                    out.append({"j": j, "token": t, "tok": tok.convert_ids_to_tokens(t), "logit": float(lg[j, t]),
+                                "rank": int((lg[j] > lg[j, t]).sum()), "argmax": picks[j],
+                                "top": [int(x) for x in i],
+                                "top_tok": tok.convert_ids_to_tokens([int(x) for x in i]),
+                                "top_logits": [float(x) for x in v], "margin": float(v[0] - v[1]),
+                                "bf16_spacing": bf16_spacing(float(v[0])),
+                                "pre_softcap_top2": [float(x) for x in rv],
+                                "pre_softcap_margin_steps": float(rv[0] - rv[1]) / bf16_spacing(float(rv[0]))})
+                res["sequences"].append({"label": s["label"], "prompt": s["prompt"], "mode": m, "path": p,
+                                         "prompt_tokens": s["P"], "reply_tokens": len(s["reply"]),
+                                         "departure": s["departure"], "top1_agrees": agree,
+                                         "reply_at_max": at_max, "rows": out})
+                lo = min(out, key=lambda r: r["margin"])
+                print(f"{s['label']} {p} {m}: top-1 (argmax) equals the reply at {agree}/{len(out)} (the reply at "
+                      f"the maximum, ties included: {at_max}); min margin "
+                      f"{lo['margin']:.4f} at j={lo['j']}", flush=True)
+        d = s["departure"]
+        if d is None or s["label"].endswith("/oracle"):
+            continue
+        oa, ob = s["oracle"][d], s["reply"][d]
+        o_label = f"{s['prompt']}/oracle"
+        for p in paths:
+            for m in modes:
+                dep = {"branch": s["label"], "mode": m, "path": p, "j": d, "oracle_token": oa,
+                       "oracle_tok": tok.convert_ids_to_tokens(oa), "branch_token": ob,
+                       "branch_tok": tok.convert_ids_to_tokens(ob),
+                       "in_branch_sequence": tie_rules(rows[(s["label"], m, p)][0][d], rows[(s["label"], m, p)][1][d],
+                                                       oa, ob)}
+                if (o_label, m, p) in rows:
+                    dep["in_oracle_sequence"] = tie_rules(rows[(o_label, m, p)][0][d], rows[(o_label, m, p)][1][d],
+                                                          oa, ob)
+                res["departures"].append(dep)
+    os.makedirs(a.out, exist_ok=True)
+    json.dump(res, open(os.path.join(a.out, "margins.json"), "w"), indent=1, ensure_ascii=False)
+    with open(os.path.join(a.out, "margins.txt"), "w") as f:
+        f.write(tables(res))
+    man = R.provenance(a.model_dir)
+    man.update({"tool": "inkling2_margins.py", "layers": cfg.num_hidden_layers, "argv": sys.argv[1:], "inputs": inputs,
+                "device": a.device,
+                "tf32": tf32,
+                "times_s": times, "wall_s": round(time.time() - t_start, 1)})
+    json.dump(man, open(os.path.join(a.out, "manifest.json"), "w"), indent=1)
+    print(tables(res), flush=True)
+
+
+def tables(res: dict) -> str:
+    L = [f"{k}: {v}" for k, v in res["checks"].items()]
+    for sq in res["sequences"]:
+        L.append("")
+        L.append(f"## {sq['label']} [{sq['path']}, {sq['mode']}] prompt {sq['prompt_tokens']}, reply "
+                 f"{sq['reply_tokens']}, top-1 (argmax) = reply at {sq['top1_agrees']}/{sq['reply_tokens']} (reply at "
+                 f"the maximum: {sq['reply_at_max']}), departure from the oracle: {sq['departure']}")
+        L.append("| j | reply token | logit | rank | top-1 | top-2 | margin | bf16 step | pre-softcap margin (steps) |")
+        L.append("|---|---|---|---|---|---|---|---|---|")
+        for r in sq["rows"]:
+            L.append(f"| {r['j']} | {r['token']} {r['tok']!r} | {r['logit']:.4f} | {r['rank']} | "
+                     f"{r['top'][0]} {r['top_tok'][0]!r} {r['top_logits'][0]:.4f} | "
+                     f"{r['top'][1]} {r['top_tok'][1]!r} {r['top_logits'][1]:.4f} | {r['margin']:.4f} | "
+                     f"{r['bf16_spacing']:.4g} | {r['pre_softcap_margin_steps']:.2f} |")
+    if res["departures"]:
+        L.append("")
+        L.append("## departures (oracle token a, branch token b; gap = logit(a) - logit(b); steps = gap / one bf16 "
+                 "spacing at the top-1 value)")
+        L.append("| branch | path | mode | j | a | b | sequence | logit a | logit b | gap | top-2 | "
+                 "upstream (softcapped) | pre-softcap a / b | gap steps | upstream (pre-softcap) | |gap| < 0.5 |")
+        L.append("|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|---|")
+        for d in res["departures"]:
+            for where in ("in_oracle_sequence", "in_branch_sequence"):
+                if where not in d:
+                    continue
+                c, r = d[where]["softcapped"], d[where]["pre_softcap"]
+                L.append(f"| {d['branch']} | {d['path']} | {d['mode']} | {d['j']} | {d['oracle_token']} "
+                         f"{d['oracle_tok']!r} | {d['branch_token']} {d['branch_tok']!r} | {where.split('_')[1]} | "
+                         f"{c['contender_logits'][0]:.4f} | {c['contender_logits'][1]:.4f} | "
+                         f"{c['gap_oracle_minus_branch']:.4f} | {c['top2']} | {c['upstream_near_tie_ref_side']} | "
+                         f"{r['contender_logits'][0]:.4f} / {r['contender_logits'][1]:.4f} | "
+                         f"{r['gap_in_bf16_steps']:.2f} | {r['upstream_near_tie_ref_side']} | "
+                         f"{d[where]['under_0p5_ref_side']} |")
+    return "\n".join(L) + "\n"
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/zig/inkling2_margins_test.py b/tools/zig/inkling2_margins_test.py
