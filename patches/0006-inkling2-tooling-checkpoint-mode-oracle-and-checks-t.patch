index 0000000000000000000000000000000000000000..0b28689e95b76181b3b5cbd419de732fd88ada06
--- /dev/null
+++ b/tools/zig/inkling2_op_ref.py
@@ -0,0 +1,529 @@
+"""Inkling-2's forward op by op in torch, in tf-inkling2-cuda's op names and layouts: the per-op oracle.
+
+Every op of the CUDA forward (zig/src/families/inkling2/cuda_forward.zig) is one function here, built from the
+Transformers modules the oracle uses (tools/zig/inkling2_ref.py loads them; Transformers is Apache-2.0 and is
+imported; `tau_of` and `dyn_conv` adapt parts of it and carry its notice). Tensors are [rows, columns] as the
+runner dumps them: op.<scope>.<group>.<op>.<in|out>.<t> with scope the layer number or "model"; a convolution state
+or gathered cache rows carry "@<first row>".
+
+USAGE = python tools/zig/inkling2_op_ref.py capture MODEL_DIR ORACLE_PROMPT --layers A:B --out CAPTURE [--head]
+            [--fp32-reduction] [--attn eager|fp32]
+        python tools/zig/inkling2_op_ref.py check MODEL_DIR DUMP [--tol-rel 0.01] [--ops a,b] [--fp32-reduction]
+            [--attn eager|fp32]
+        python tools/zig/inkling2_op_ref.py layers MODEL_DIR ORACLE_PROMPT --layers A:B --out FILE [--head]
+            [--teacher] [--fp32-reduction] [--attn eager|fp32]
+
+  --attn   attn.core's form: Transformers' eager attention (default; v0.1's oracle) or fp32, v0.2's oracle form
+           (inkling2_ref.py --attn fp32: inkling2_ref.kx_core and kx_output, the kx kernels' rounding points, the
+           sink as a multiplier). fp32 turns --fp32-reduction on. Every run sets TF32 off and exits 3 if it is not
+           (inkling2_ref.tf32_guard).
+
+  capture  From the oracle's input of layer A (h.<A-1> or embed, and the block states below A), run layers
+           A..B-1 (and with --head the final mix, norm, unembed and softcap at logits.rows) op by op in torch,
+           and save every op's inputs and outputs. The chain's layer outputs are checked against the oracle's
+           h.<L> (bit-equal expected: the same modules on the same inputs). Feed it to the runner
+           (--feed CAPTURE): each op then runs on torch's inputs, and ops without a kernel pass with torch's
+           outputs; inkling2_compare.py --ops compares the runner's op outputs with the capture. With
+           --fp32-reduction (as for layers) the capture is the tight per-op reference.
+  check    For a runner dump made with --dump-ops, recompute each op from the inputs the runner recorded and
+           compare with the runner's outputs (an op tested on exactly what it was given).
+  layers   The same op chain keeping only what crosses layers, in the oracle's format (ids, rows, h.<L>,
+           route.*.<L>, final, logits.rows, logits.full; every row), so the file serves inkling2_compare.py both
+           as a dump and as an oracle. --teacher starts every layer from the oracle's input (as tf-inkling2-cuda
+           --teacher does; with --head the final mix runs on the oracle's h.47 and blocks and the unembed on its
+           final rows). --fp32-reduction turns off cuBLAS's bf16 partial reduction (torch's
+           allow_bf16_reduced_precision_reduction, on in the oracle): the same layer on the same input with its
+           bf16 matmuls reduced in fp32, a tighter reference that tells the oracle's own rounding from ours.
+
+Lane recipe (one op group alone), e.g. G-conv on layer 5 with the chat_short prompt:
+  python tools/zig/inkling2_op_ref.py capture MODEL ORACLE/full/chat_short.safetensors --layers 5:6 --out cap5.st
+  tf-inkling2-cuda MODEL ORACLE/full/chat_short.safetensors run5.st --layers 5:6 --feed cap5.st --dump-ops
+  python tools/zig/inkling2_compare.py run5.st ORACLE/full/chat_short.safetensors --ops cap5.st
+The compare lists every implemented op's output against torch; ops listed as fed stubs are skipped.
+"""
+
+import argparse
+import math
+import os
+import sys
+import time
+
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import inkling2_ref as ref  # noqa: E402
+
+BF = torch.bfloat16
+H = 4608
+D = 128
+WINDOW = 1024
+
+
+# ----------------------------------------------------------------------------------------------- the ops
+
+
+# tau_of and dyn_conv: adapted from huggingface/transformers src/transformers/models/inkling2/modeling_inkling2.py
+# at 109a7d19 (the attention's log-scaling tau and Inkling2DynamicShortConvolution.forward), Copyright 2026 the
+# HuggingFace Team, Apache License 2.0; modified for TensorFold: split into ops, the per-token taps and the
+# convolution state passed in (see THIRD_PARTY_NOTICES.md).
+def tau_of(cfg, pos):
+    t = 1.0 + cfg.log_scaling_alpha * torch.log(((pos + 1).float() / cfg.log_scaling_n_floor).clamp(min=1.0))
+    return t[:, None, None]
+
+
+def short_conv(mod, x, state):
+    """Inkling2ShortConvolution over [state; x] (state: the 3 input rows before x), the last R rows. A zero state
+    (a stream's start) runs the module on x alone, exactly as Transformers' teacher-forced pass does."""
+    if not state.any():
+        return mod(x[None])[0]
+    ext = torch.cat([state.to(x.dtype), x], 0)[None]
+    return mod(ext)[0, state.shape[0]:]
+
+
+def dyn_conv(mod, x, dyn, state):
+    """Inkling2DynamicShortConvolution's forward with its per-token taps given (`dyn` = weight_proj's output)."""
+    if not state.any():
+        state = state[:0]
+    n = state.shape[0]
+    ext = torch.cat([state.to(x.dtype), x], 0)[None]
+    dext = torch.cat([dyn.new_zeros(n, dyn.shape[1]), dyn], 0)[None]
+    batch_size, seq_len, hidden_size = ext.shape
+    k = mod.conv_kernel_size
+    dynamic_weights = dext.float().view(batch_size, seq_len, mod.num_heads, 1, k)
+    weights = mod.static_weight.float().T.view(mod.num_heads, -1, k) + dynamic_weights
+    hidden = ext.float()
+    residual = hidden
+    context = hidden.transpose(1, 2)
+    context = F.pad(context, (k - 1, 0))[..., -(seq_len + k - 1):]
+    windows = context.unfold(-1, k, 1).flip(-1).transpose(1, 2)
+    windows = windows.reshape(batch_size, seq_len, mod.num_heads, -1, k)
+    out = (windows * weights).sum(-1).reshape(batch_size, seq_len, hidden_size)
+    out = (out + residual) / math.sqrt(2 * k + 1)
+    return out.to(x.dtype)[0, n:]
+
+
+def stack_blocks(ins):
+    bl = [ins[f"block{i}"] for i in range(8) if f"block{i}" in ins]
+    cand = ins["cand"]
+    if not bl:
+        return cand.new_zeros(1, cand.shape[0], 0, H).to(BF)
+    return torch.stack(bl, dim=-2)[None]
+
+
+class Ops:
+    """The ops of one layer (or the model head) over its Transformers modules."""
+
+    def __init__(self, cfg, layer=None, head=None, index=None):
+        self.cfg, self.ly, self.head, self.L = cfg, layer, head, index
+
+    def run(self, op, ins, pos0, kv_lo=None):
+        ly, cfg = self.ly, self.cfg
+        R = next(v.shape[0] for k, v in ins.items() if "@" not in k)
+        pos = torch.arange(pos0, pos0 + R, device=next(iter(ins.values())).device)
+        if op == "res.attn_input":
+            outs = ly.attention_input(stack_blocks(ins), ins["cand"][None])
+            return {f"x{j}": o[0] for j, o in enumerate(outs)}
+        if op == "res.mlp_input":
+            return {"x": ly.mlp_input(stack_blocks(ins), ins["cand"][None])[0][0]}
+        if op == "res.final_input":
+            fi = self.head[0]
+            return {"x": fi(stack_blocks(ins), ins["cand"][None])[0][0]}
+        if op in ("res.attn_norm", "res.q_norm", "res.k_norm", "res.v_norm", "res.mlp_norm"):
+            mod = {"res.attn_norm": "input_layernorm", "res.q_norm": "q_input_layernorm", "res.k_norm": "k_input_layernorm",
+                   "res.v_norm": "v_input_layernorm", "res.mlp_norm": "post_attention_layernorm"}[op]
+            return {"y": getattr(ly, mod)(ins["x"]).to(BF)}
+        if op == "attn.project":
+            sa = ly.self_attn
+            xq = ins.get("xq", ins.get("x"))
+            xk = ins.get("xk", xq)
+            xv = ins.get("xv", xq)
+            out = {"q": sa.q_proj(xq), "k": sa.k_proj(xk), "v": sa.v_proj(xv), "rel": sa.r_proj(xq),
+                   "gate": sa.gate_proj(xq), "sink": sa.sink_proj(xq)}
+            if not sa.is_sliding:
+                out["dk"] = sa.k_sconv.weight_proj(xk)
+                out["dv"] = sa.v_sconv.weight_proj(xv)
+            return out
+        if op == "conv.kv":
+            sa = ly.self_attn
+            sk = state_of(ins, "state_k", pos0)
+            sv = state_of(ins, "state_v", pos0)
+            if sa.is_sliding:
+                return {"kc": short_conv(sa.k_sconv, ins["k"], sk), "vc": short_conv(sa.v_sconv, ins["v"], sv)}
+            return {"kc": dyn_conv(sa.k_sconv, ins["k"], ins["dk"], sk), "vc": dyn_conv(sa.v_sconv, ins["v"], ins["dv"], sv)}
+        if op in ("conv.attn", "conv.mlp"):
+            mod = ly.post_attention_convolution if op == "conv.attn" else ly.post_mlp_convolution
+            return {"y": short_conv(mod, ins["x"], state_of(ins, "state", pos0))}
+        if op == "attn.heads":
+            sa = ly.self_attn
+            hq, hk = sa.num_heads, sa.num_key_value_heads
+            q = sa.q_l2_clip(ins["q"].view(R, hq, D))
+            k = sa.k_l2_clip(ins["kc"].view(R, hk, D))
+            v = sa.v_norm(ins["vc"].view(R, hk, D).float()).to(BF)
+            rel = sa.rel_l2_clip(ins["rel"].view(R, hq, -1))
+            if not sa.is_sliding:
+                t = tau_of(cfg, pos)
+                q = (q.float() * t).to(q.dtype)
+                rel = (rel.float() * t).to(rel.dtype)
+            return {"q": q.reshape(R, -1), "k": k.reshape(R, -1), "v": v.reshape(R, -1), "rel": rel.reshape(R, -1)}
+        if op == "attn.core":
+            return {"o": self.core(ins, pos0, R, kv_lo)}
+        if op == "attn.out":
+            return {"ao": ly.self_attn.o_proj(ins["o"])}
+        if op == "res.partial":
+            a = ins["a"].float()
+            return {"partial": a if ly.is_block_boundary else ins["h_in"].float() + a}
+        if op == "moe.route":
+            logits, w, idx = ly.mlp.gate(ins["m"])
+            order = idx.argsort(-1)
+            return {"ids": idx.gather(-1, order).to(torch.int32), "w": w.gather(-1, order).float(), "logits": logits.float()}
+        if op == "moe.experts":
+            return {"y": ly.mlp.experts(ins["m"], ins["ids"].long(), ins["w"].float())}
+        if op == "res.output":
+            return {"h": (ins["partial"] + ins["mconv"].float()).to(BF)}
+        if op == "head.final_norm":
+            return {"y": self.head[1](ins["x"]).to(BF)}
+        if op == "head.unembed":
+            return {"logits": self.head[2](ins["y"])}
+        if op == "head.softcap":
+            return {"out": self.head[3](ins["logits"].float())[..., : cfg.unpadded_vocab_size]}
+        raise KeyError(f"no torch form for {op}")
+
+    def core(self, ins, pos0, R, kv_lo):
+        sa = self.ly.self_attn
+        hq, hk = sa.num_heads, sa.num_key_value_heads
+        kx = find_whole(ins, "k_ctx", pos0)
+        vx = find_whole(ins, "v_ctx", pos0)
+        if kx is None:  # a capture of one forward from position 0: the context is this forward's own rows
+            kx, vx, kv_lo = ins["k"], ins["v"], pos0
+        C = kx.shape[0]
+        lo = pos0 + R - C if kv_lo is None else kv_lo
+        dev = kx.device
+        qpos = torch.arange(pos0, pos0 + R, device=dev)
+        kpos = torch.arange(lo, lo + C, device=dev)
+        q = ins["q"].view(R, hq, D).transpose(0, 1)[None]
+        k = kx.view(C, hk, D).transpose(0, 1)[None]
+        v = vx.view(C, hk, D).transpose(0, 1)[None]
+        rel = ins["rel"].view(R, hq, -1)[None]
+        bias = sa.rel_logits_proj(rel, qpos, kpos)
+        dist = qpos[:, None] - kpos[None, :]
+        ok = dist >= 0
+        if sa.is_sliding:
+            ok = ok & (dist < sa.sliding_window)
+        mask = torch.zeros(R, C, dtype=q.dtype, device=dev).masked_fill(~ok, torch.finfo(q.dtype).min)[None, None]
+        sinks = ins["sink"][None].transpose(1, 2).unsqueeze(-1)
+        if ref.ATTN["form"] == "fp32":
+            from transformers.models.inkling2.modeling_inkling2 import repeat_kv
+
+            g = sa.num_key_value_groups
+            y, phi = ref.kx_core(q, repeat_kv(k, g), repeat_kv(v, g), bias, ok[None, None], sa.scaling, sinks)
+            return ref.kx_output(y[0].transpose(0, 1).reshape(R, -1), ins["gate"], phi[0].transpose(0, 1))
+        eager_attention_forward = ref.hf_eager()
+        o, _ = eager_attention_forward(sa, q, k, v, mask, dropout=0.0, scaling=sa.scaling, sliding_window=sa.sliding_window,
+                                       position_bias=bias, sinks=sinks)
+        o = o.reshape(R, -1).contiguous()
+        return (o.float() * torch.sigmoid(ins["gate"].float())).to(o.dtype)
+
+
+def find_whole(ins, name, pos0):
+    return ins.get(f"{name}@{pos0}")
+
+
+def state_of(ins, name, pos0):
+    s = find_whole(ins, name, pos0)
+    if s is not None:
+        return s
+    x = next(v for k, v in ins.items() if "@" not in k)
+    return x.new_zeros(3, x.shape[1])
+
+
+# ----------------------------------------------------------------------------------------------- capture
+
+
+class Capture:
+    def __init__(self, dev):
+        self.t, self.dev = {}, dev
+
+    def put(self, scope, op, d, ts):
+        for k, v in ts.items():
+            self.t[f"op.{scope}.{op}.{d}.{k}"] = v.detach().contiguous().cpu()
+
+    def op(self, ops, scope, op, ins, pos0=0, kv_lo=None):
+        self.put(scope, op, "in", ins)
+        with torch.no_grad():
+            outs = ops.run(op, ins, pos0, kv_lo)
+        self.put(scope, op, "out", outs)
+        return outs
+
+
+def equal_report(name, got, want):
+    g, w = got.float().cpu(), want.float().cpu()
+    eq = float((got.cpu() == want.cpu()).float().mean())
+    rel = float((g - w).norm() / w.norm().clamp(min=1e-30))
+    print(f"  {name}: equal {eq:.6f}  max_abs {float((g - w).abs().max()):.3e}  rel {rel:.3e}", flush=True)
+    return eq
+
+
+def layer_chain(cap, ops, L, h, blocks, cfg):
+    """One decoder layer as the runner's op sequence; returns h_out and the blocks after it."""
+    ly = ops.ly
+    s = str(L)
+    zero = lambda c: h.new_zeros(3, c)  # noqa: E731
+    if ly.attention_input is not None:
+        ins = {f"block{i}": b for i, b in enumerate(blocks)} | {"cand": h}
+        xs = list(cap.op(ops, s, "res.attn_input", ins).values())
+    else:
+        xs = [h]
+    sliding = ly.self_attn.is_sliding
+    if sliding:
+        xn = [cap.op(ops, s, "res.attn_norm", {"x": xs[0]})["y"]] * 3
+        p = cap.op(ops, s, "attn.project", {"x": xn[0]})
+    else:
+        if len(xs) == 1:
+            xs = xs * 3
+        xn = [cap.op(ops, s, f"res.{n}_norm", {"x": x})["y"] for n, x in zip("qkv", xs)]
+        p = cap.op(ops, s, "attn.project", {"xq": xn[0], "xk": xn[1], "xv": xn[2]})
+    kvc = p["k"].shape[1]
+    ins = {"k": p["k"], "v": p["v"], "state_k@0": zero(kvc), "state_v@0": zero(kvc)}
+    if not sliding:
+        ins |= {"dk": p["dk"], "dv": p["dv"]}
+    c = cap.op(ops, s, "conv.kv", ins)
+    hd = cap.op(ops, s, "attn.heads", {"q": p["q"], "kc": c["kc"], "vc": c["vc"], "rel": p["rel"]})
+    o = cap.op(ops, s, "attn.core", {"q": hd["q"], "rel": hd["rel"], "sink": p["sink"], "gate": p["gate"],
+                                     "k_ctx@0": hd["k"], "v_ctx@0": hd["v"]}, kv_lo=0)["o"]
+    ao = cap.op(ops, s, "attn.out", {"o": o})["ao"]
+    a = cap.op(ops, s, "conv.attn", {"x": ao, "state@0": zero(H)})["y"]
+    part = cap.op(ops, s, "res.partial", {"h_in": h, "a": a})["partial"]
+    if ly.is_block_boundary:
+        blocks = blocks + [h]
+    ins = {f"block{i}": b for i, b in enumerate(blocks)} | {"cand": part}
+    mx = cap.op(ops, s, "res.mlp_input", ins)["x"]
+    m = cap.op(ops, s, "res.mlp_norm", {"x": mx})["y"]
+    r = cap.op(ops, s, "moe.route", {"m": m})
+    y = cap.op(ops, s, "moe.experts", {"m": m, "ids": r["ids"], "w": r["w"]})["y"]
+    cm = cap.op(ops, s, "conv.mlp", {"x": y, "state@0": zero(H)})["y"]
+    h_out = cap.op(ops, s, "res.output", {"partial": part, "mconv": cm})["h"]
+    return h_out, blocks, r
+
+
+def capture(a):
+    dev = torch.device(a.device)
+    lo, hi = (int(x) for x in a.layers.split(":"))
+    cfg = ref.text_config(a.model_dir, 0)
+    model = ref.Model(a.model_dir, cfg, dev, "full")
+    o = safe_open(a.oracle, framework="pt")
+    T = o.get_tensor("ids").shape[0]
+    if o.get_tensor("rows").shape[0] != T:
+        raise SystemExit("the oracle keeps sampled rows of this prompt: capture needs a prompt of at most 512 rows")
+    rows_of = lambda n: o.get_tensor(n).to(dev)  # noqa: E731
+    h = rows_of("embed") if lo == 0 else rows_of(f"h.{lo - 1}")
+    blocks = [rows_of("embed") if b == 0 else rows_of(f"h.{b - 1}") for b in range(0, lo, 6)]
+    cap = Capture(dev)
+    worst = 1.0
+    for L in range(lo, hi):
+        t0 = time.time()
+        ly = model.layer(L)
+        t1 = time.time()
+        h, blocks, r = layer_chain(cap, Ops(cfg, ly, index=L), L, h, blocks, cfg)
+        torch.cuda.synchronize()
+        print(f"layer {L}: load {t1 - t0:.1f} s, ops {time.time() - t1:.1f} s; against the oracle:", flush=True)
+        worst = min(worst, equal_report(f"h.{L}", h, rows_of(f"h.{L}")))
+        equal_report(f"route.ids.{L}", r["ids"], rows_of(f"route.ids.{L}"))
+        del ly
+        torch.cuda.empty_cache()
+    if a.head:
+        if hi != cfg.num_hidden_layers:
+            raise SystemExit("--head needs the last layer")
+        head = model.head()
+        ops = Ops(cfg, head=head)
+        ins = {f"block{i}": b for i, b in enumerate(blocks)} | {"cand": h}
+        x = cap.op(ops, "model", "res.final_input", ins)["x"]
+        y = cap.op(ops, "model", "head.final_norm", {"x": x})["y"]
+        equal_report("final", y, rows_of("final"))
+        lr = o.get_tensor("logits.rows").to(dev)
+        lg = cap.op(ops, "model", "head.unembed", {"y": y[lr]})["logits"]
+        out = cap.op(ops, "model", "head.softcap", {"logits": lg})["out"]
+        equal_report("logits.full", out, rows_of("logits.full"))
+    meta = {"tool": "inkling2_op_ref.py capture", "oracle": os.path.basename(a.oracle), "layers": a.layers,
+            "rows": str(T), "worst_layer_equal_frac": f"{worst:.6f}",
+            "bf16_reduced_precision_reduction": str(torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction)}
+    save_file(cap.t, a.out, metadata=meta)
+    print(f"{len(cap.t)} tensors to {a.out}; worst layer bit-equal fraction {worst:.6f}")
+    return 0 if worst == 1.0 else 1
+
+
+# ----------------------------------------------------------------------------------------------- layers
+
+
+class NoCapture(Capture):
+    def put(self, scope, op, d, ts):
+        pass
+
+
+def layers(a):
+    dev = torch.device(a.device)
+    lo, hi = (int(x) for x in a.layers.split(":"))
+    cfg = ref.text_config(a.model_dir, 0)
+    model = ref.Model(a.model_dir, cfg, dev, "full")
+    o = safe_open(a.oracle, framework="pt")
+    ids = o.get_tensor("ids")
+    T = ids.shape[0]
+    if o.get_tensor("rows").shape[0] != T:
+        raise SystemExit("the oracle keeps sampled rows of this prompt: run inkling2_ref.py --all-rows")
+    rows_of = lambda n: o.get_tensor(n).to(dev)  # noqa: E731
+
+    def state(L):
+        h = rows_of("embed") if L == 0 else rows_of(f"h.{L - 1}")
+        return h, [rows_of("embed") if b == 0 else rows_of(f"h.{b - 1}") for b in range(0, L, 6)]
+
+    h, blocks = state(lo)
+    cap = NoCapture(dev)
+    out = {"ids": ids, "rows": torch.arange(T)}
+    for L in range(lo, hi):
+        if a.teacher and L > lo:
+            h, blocks = state(L)
+        t0 = time.time()
+        ly = model.layer(L)
+        t1 = time.time()
+        h, blocks, r = layer_chain(cap, Ops(cfg, ly, index=L), L, h, blocks, cfg)
+        torch.cuda.synchronize()
+        print(f"layer {L}: load {t1 - t0:.1f} s, ops {time.time() - t1:.1f} s; against the oracle:", flush=True)
+        equal_report(f"h.{L}", h, rows_of(f"h.{L}"))
+        equal_report(f"route.ids.{L}", r["ids"], rows_of(f"route.ids.{L}"))
+        out[f"h.{L}"] = h.cpu()
+        for k, n in (("ids", "route.ids"), ("w", "route.w"), ("logits", "route.logits")):
+            out[f"{n}.{L}"] = r[k].cpu()
+        del ly
+        torch.cuda.empty_cache()
+    if a.head:
+        if hi != cfg.num_hidden_layers:
+            raise SystemExit("--head needs the last layer")
+        if a.teacher:
+            h, blocks = state(hi)
+        head = model.head()
+        ops = Ops(cfg, head=head)
+        ins = {f"block{i}": b for i, b in enumerate(blocks)} | {"cand": h}
+        with torch.no_grad():
+            y = ops.run("head.final_norm", {"x": ops.run("res.final_input", ins, 0)["x"]}, 0)["y"]
+        equal_report("final", y, rows_of("final"))
+        lr = o.get_tensor("logits.rows").to(dev)
+        src = rows_of("final") if a.teacher else y
+        with torch.no_grad():
+            lg = ops.run("head.unembed", {"y": src[lr]}, 0)["logits"]
+            lo_ = ops.run("head.softcap", {"logits": lg}, 0)["out"]
+        equal_report("logits.full", lo_, rows_of("logits.full"))
+        out |= {"final": y.cpu(), "logits.rows": lr.cpu(), "logits.full": lo_.cpu()}
+    meta = {"tool": "inkling2_op_ref.py layers", "prompt": os.path.basename(a.oracle), "layers": a.layers,
+            "rows": str(T), "rows_done": str(T), "status": "complete", "chunk": str(T),
+            "inputs": "oracle at every layer" if a.teacher else "oracle at the first layer, then chained",
+            "bf16_reduced_precision_reduction": str(torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction)}
+    save_file({k: v.contiguous() for k, v in out.items()}, a.out, metadata=meta)
+    print(f"{len(out)} tensors to {a.out}")
+    return 0
+
+
+# ----------------------------------------------------------------------------------------------- check
+
+
+def check(a):
+    from inkling2_compare import Store, line, op_parts, stats
+
+    dev = torch.device(a.device)
+    dump = Store(a.dump)
+    f = safe_open(a.dump, framework="pt")
+    T = int(dump.meta.get("rows", "0"))
+    chunk = int(dump.meta.get("chunk", "0")) or T
+    want = set(a.ops.split(",")) if a.ops else None
+    by = {}
+    for k in dump.keys:
+        p = op_parts(k)
+        if p is not None:
+            by.setdefault((p[0], p[1]), {"in": [], "out": []})[p[2]].append(p[3])
+    cfg = ref.text_config(a.model_dir, 0)
+    model = ref.Model(a.model_dir, cfg, dev, "full")
+    bad, n = [], 0
+    layers = sorted({s for s, _ in by if s != "model"}, key=int)
+    for scope in layers + (["model"] if any(s == "model" for s, _ in by) else []):
+        mods = Ops(cfg, layer=model.layer(int(scope)), index=int(scope)) if scope != "model" else Ops(cfg, head=model.head())
+        for (s, op), names in sorted(by.items()):
+            if s != scope or not names["out"] or not names["in"] or (want and op not in want):
+                continue
+            selected = op in ("head.unembed", "head.softcap")  # the head's selected rows, in one piece
+            n_rows = f.get_slice(f"op.{s}.{op}.out.{names['out'][0]}").get_shape()[0] if selected else T
+            for start in range(0, n_rows, n_rows if selected else chunk):
+                R = n_rows if selected else min(chunk, T - start)
+                ins = {}
+                for t in names["in"]:
+                    v = f.get_tensor(f"op.{s}.{op}.in.{t}").to(dev)
+                    if "@" in t:
+                        if t.endswith(f"@{start}"):
+                            ins[t] = v
+                    else:
+                        ins[t] = v[start:start + R]
+                with torch.no_grad():
+                    got = mods.run(op, ins, start)
+                for t in names["out"]:
+                    ours = f.get_tensor(f"op.{s}.{op}.out.{t}")[start:start + R]
+                    ref_t = got[t].cpu()
+                    if ref_t.dtype == BF:
+                        st = stats(ours.view(torch.int16).numpy().view("uint16"), ref_t.view(torch.int16).numpy().view("uint16"), "bf16")
+                    else:
+                        st = stats(ours.numpy(), ref_t.numpy(), str(ref_t.dtype).replace("torch.", ""))
+                    n += 1
+                    ok = st["equal_frac"] == 1.0 if "rel" not in st else st["rel"] <= a.tol_rel
+                    print(line(f"op.{s}.{op}.{t}@{start}", st) + ("" if ok else "  FAIL"))
+                    if not ok:
+                        bad.append(f"{s}.{op}.{t}")
+        torch.cuda.empty_cache()
+    if n == 0:
+        print("nothing to check: run the runner with --dump-ops")
+        return 2
+    print(f"{n} op outputs recomputed; " + (f"FAIL {len(bad)}: {', '.join(bad[:12])}" if bad else "all within tolerance"))
+    return 1 if bad else 0
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    c = sub.add_parser("capture")
+    c.add_argument("model_dir")
+    c.add_argument("oracle")
+    c.add_argument("--layers", required=True, help="A:B")
+    c.add_argument("--out", required=True)
+    c.add_argument("--head", action="store_true")
+    c.add_argument("--fp32-reduction", action="store_true", help="bf16 matmuls reduced in fp32")
+    c.add_argument("--attn", choices=["eager", "fp32"], default="eager", help="attn.core's form (fp32: v0.2's)")
+    c.add_argument("--device", default="cuda:0")
+    y = sub.add_parser("layers")
+    y.add_argument("model_dir")
+    y.add_argument("oracle")
+    y.add_argument("--layers", required=True, help="A:B")
+    y.add_argument("--out", required=True)
+    y.add_argument("--head", action="store_true")
+    y.add_argument("--teacher", action="store_true", help="every layer from the oracle's input")
+    y.add_argument("--fp32-reduction", action="store_true", help="bf16 matmuls reduced in fp32")
+    y.add_argument("--attn", choices=["eager", "fp32"], default="eager", help="attn.core's form (fp32: v0.2's)")
+    y.add_argument("--device", default="cuda:0")
+    k = sub.add_parser("check")
+    k.add_argument("model_dir")
+    k.add_argument("dump")
+    k.add_argument("--tol-rel", type=float, default=1e-2)
+    k.add_argument("--ops", default="", help="only these ops (comma-separated, e.g. conv.kv,attn.heads)")
+    k.add_argument("--fp32-reduction", action="store_true", help="bf16 matmuls reduced in fp32")
+    k.add_argument("--attn", choices=["eager", "fp32"], default="eager", help="attn.core's form (fp32: v0.2's)")
+    k.add_argument("--device", default="cuda:0")
+    a = ap.parse_args()
+    ref.tf32_guard(torch.device(a.device))
+    ref.ATTN["form"] = a.attn
+    if a.attn == "fp32":
+        a.fp32_reduction = True
+    if getattr(a, "fp32_reduction", False):
+        torch.backends.cuda.matmul.allow_bf16_reduced_precision_reduction = False
+    print(f"attn.core: {a.attn}; bf16 matmuls reduced in fp32: {bool(getattr(a, 'fp32_reduction', False))}", flush=True)
+    return {"capture": capture, "check": check, "layers": layers}[a.cmd](a)
+
+
+if __name__ == "__main__":
+    sys.exit(main())
diff --git a/tools/zig/inkling2_rank.sh b/tools/zig/inkling2_rank.sh
new file mode 100755
index 0000000000000000000000000000000000000000..f8123b37d6e2c47fa5b0c179290a366769923693
--- /dev/null
+++ b/tools/zig/inkling2_rank.sh
@@ -0,0 +1,35 @@
+#!/usr/bin/env bash
+# inkling2_rank.sh RANK LOG SECONDS CMD...: one host's rank of a multi-host run (tf-inkling2-cuda --world W --rank R)
+# over NCCL on RoCE, with the settings the four-GB10 switchless ring needs (Ring algorithm, cuMem and runtime connect
+# on, a per-rank graph file INK2_HOME/nccl/graph-rankR.xml). NCCL bootstraps on the LAN at MASTER:NCCL_PORT (default
+# 29521). CMD runs under `timeout SECONDS` with its output in LOG; MemAvailable is sampled every 0.5 s into LOG.mem and
+# its value before, minimum and after are printed at the end. The exit status is CMD's.
+# The NCCL settings follow MiaAI-Lab's four-Spark DeepSeek recipe (scripts/nodes.sh) and upstream's
+# docs/recipes/glm-5.3-flash-cuda.md (see THIRD_PARTY_NOTICES.md).
+# Needs INK2_HOME (bin; lib with libnccl.so.2 and libcublasLt.so.13; nccl), MASTER, NCCL_IB_HCA, NCCL_SOCKET_IFNAME.
+set -u
+r=$1; log=$2; secs=$3; shift 3
+d=${INK2_HOME:?INK2_HOME=the rank folder root}
+export LD_LIBRARY_PATH=$d/lib
+export CUDA_VISIBLE_DEVICES=${CUDA_VISIBLE_DEVICES:-0}
+export NCCL_COMM_ID=${MASTER:?MASTER=rank 0 LAN address}:${NCCL_PORT:-29521}
+export NCCL_SOCKET_IFNAME=${NCCL_SOCKET_IFNAME:?NCCL_SOCKET_IFNAME=the LAN netdev}
+export NCCL_IB_HCA=${NCCL_IB_HCA:?NCCL_IB_HCA=the RoCE HCAs}
+export NCCL_IB_DISABLE=0
+export NCCL_IB_GID_INDEX=${NCCL_IB_GID_INDEX:-3} NCCL_IB_MERGE_NICS=0 NCCL_CROSS_NIC=1 NCCL_IB_SUBNET_AWARE_ROUTING=1 NCCL_IB_SUBNET_PREFIX_LEN=24
+export NCCL_ALGO=Ring NCCL_CUMEM_ENABLE=1 NCCL_RUNTIME_CONNECT=1 NCCL_P2P_DISABLE=1 NCCL_SHM_DISABLE=1
+export NCCL_MIN_NCHANNELS=4 NCCL_MAX_NCHANNELS=4
+[ -f "$d/nccl/graph-rank$r.xml" ] && export NCCL_GRAPH_FILE=$d/nccl/graph-rank$r.xml
+export NCCL_DEBUG=${NCCL_DEBUG:-WARN}
+mkdir -p "$(dirname "$log")"
+grep MemAvailable /proc/meminfo > "$log.mem"
+( while :; do echo "$(date +%s.%N | cut -c1-14) $(awk '/MemAvailable/{print $2}' /proc/meminfo)"; sleep 0.5; done ) >> "$log.mem" &
+mon=$!
+start=$(date +%s.%N)
+timeout "$secs" "$@" > "$log" 2>&1
+rc=$?
+kill $mon 2>/dev/null; wait $mon 2>/dev/null
+end=$(date +%s.%N)
+min=$(awk 'NR>1 && ($2 < m || m == "") {m = $2} END {print m}' "$log.mem")
+echo "rank $r exit $rc in $(echo "$end - $start" | bc) s; MemAvailable before $(head -1 "$log.mem" | awk '{print $2}') kB, min $min kB, after $(awk '/MemAvailable/{print $2}' /proc/meminfo) kB"
+exit $rc
diff --git a/tools/zig/inkling2_ref.py b/tools/zig/inkling2_ref.py
new file mode 100644
index 0000000000000000000000000000000000000000..9fb5cb9c32afa58b664f925f1eac4671c15152e1
--- /dev/null
+++ b/tools/zig/inkling2_ref.py
@@ -0,0 +1,1613 @@
+"""Inkling-2-Small's text model streamed a layer at a time through Transformers' own Inkling2 modules: the oracle.
+
+The checkpoint (366 GiB, NVFP4 and MXFP8 experts) fits neither the GPUs nor host memory, so the reference loads one
+decoder layer at a time onto one GPU, runs every prompt through it, and keeps only what crosses layers: each prompt's
+hidden rows and block-residual states (the inputs of layers 0, 6, 12, ...). The layer itself is Transformers'
+`Inkling2SlidingDecoderLayer` / `Inkling2FullDecoderLayer` with the checkpoint's tensors assigned, called exactly as
+`Inkling2TextModel.forward` calls it (same masks from `masking_utils`, same block-state bookkeeping, same final
+`final_input`, norm, unembed and softcap). The short convolutions and attention need no state across layers in a
+teacher-forced pass; in --decode they live in a `DynamicCache` per prompt as in Transformers' own generation.
+
+USAGE = python tools/zig/inkling2_ref.py MODEL_DIR --out OUT_DIR [--mode full|checkpoint] [--layers N]
+            [--prompts a,b] [--all-rows] [--fp32-reduction] [--attn eager|fp32]
+            [--decode 48 --decode-prompts a,b,c,d]
+
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT                  # 48 layers, full mode
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --mode checkpoint
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --layers 6 --prompts chat_short
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --prompts long_4000 --all-rows   # every row (layer feeds)
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --fp32-reduction   # bf16 GEMMs reduced in fp32 (tight)
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --decode 48 \
+      --decode-prompts chat_short,code,tool_call,long_1500 --skip-forward                    # greedy text (gate G0)
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --mode checkpoint --decode 768 --structured all \
+      --grammar-lib LIBTFGRAMMAR --xgrammar-check --cases-out DIR       # grammar-masked greedy (structured output)
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --attn fp32 --decode 48 \
+      --decode-prompts chat_short,code,tool_call,long_1500 --skip-forward     # v0.2's oracle (fp32 attention)
+  python tools/zig/inkling2_ref.py MODEL_DIR --out OUT --attn fp32 --decode 64 --decode-prompts ext --skip-forward
+
+Attention (--attn): `eager` is Transformers' own eager attention (bf16 scores and bias add, softmax in fp32 rounded to
+bf16 P, bf16 P.V, the output times sigmoid(gate) rounded to bf16): v0.1's oracle. `fp32` is v0.2's oracle,
+fp32 attention at the rounding points of the kx kernels (kortexa-ai's tf_ik_attention arithmetic):
+q'', k', v', the relative bias (rounded to bf16), the sink and gate logits come from Transformers' modules as they
+are; scores q.k in fp32 times the fp32 scale plus the bias; m and z over the keys only; weights e^(s - m) in fp32,
+never rounded; o = (weights . v) / z in fp32; then Y = (o * sigmoid(gate)) * sigmoid((m + log z) - sink) (the sink as
+a multiplier, kx's form), rounded to bf16 once, at the output projection's input. `fp32` turns --fp32-reduction on.
+Every run sets TF32 off (matmul and cudnn, float32 matmul precision "highest"), prints the settings with an fp32 GEMM
+probe, and exits 3 if TF32 could be on (a flag reads back on, NVIDIA_TF32_OVERRIDE set to anything but 0, or the probe
+is TF32-sized).
+With --decode, decode.json keeps each step's margins on the oracle's own path (the logits row its pick came from:
+`margins[j]` = {top1, top2 (token ids), top1_logit, top2_logit, gap (softcapped top1 - top2), gap_pre (the same two
+tokens before the softcap), step (one bf16 spacing at top1_logit)}; masked rows for --structured), which v0.2's token
+gate reads (recipe/inkling2-tp4/smoke.py yardstick and oracle, tools/zig/inkling2_tokengate.py). `--decode-prompts ext`
+names the extended set (ext_specs: seven prompts beside prompt_specs' eight, part of the token gate's positions).
+
+Structured output (--structured): six OpenAI chat requests (structured_specs: json_object; a json_schema with nesting,
+enums and arrays; tool_choice required; a named function; thinking on with a schema; a schema forcing a long string)
+rendered by the chat template, then greedy under the kind-5 grammar the server compiles for each (st_reply / st_tools:
+an optional free thinking part, then the text part or the call(s), each closed by <|end_message|>, then a stop). Each
+step's pick is the argmax over the tokens the grammar allows; a case ends when its grammar does (after a stop id, kept
+as the last token). Masks come from libtfgrammar (--grammar-lib, the server's library, through its C ABI) or from
+Python xgrammar 0.2.8 with its compiler cache off; both use tf_grammar.cc's vocabulary (tokenizer.json's model.vocab
+and added tokens, text_config.vocab_size wide) and the server's stop ids. --xgrammar-check compares every mask of the
+first with the second, byte for byte. Writes OUT_DIR/<mode>/structured.json and, with --cases-out, one <case>.json per
+case (request, grammar text, prompt ids, reply ids and their sha256, the masks' sha256).
+
+Modes (what the experts compute; everything else is the same Transformers code in both):
+  full        Stored expert weights decoded to bf16 (NVFP4: e2m1 x e4m3 per 16 x amax/outer_scale_denominator per
+              expert; MXFP8: e4m3 x 2^(ue8m0-127) per 32), bf16 activations, Transformers' `Inkling2Experts` eager loop
+              (each pick's down projection times its weight, summed in fp32 in expert-id order, one bf16 rounding).
+              This is what Transformers itself computes: its forward never quantizes activations (its NVFP4 loader is
+              not in the release it supports; its MXFP8 path either dequantizes or uses FP8 GEMM kernels).
+  checkpoint  Activations quantized as hf_quant_config.json requires, following TokenSpeed's Torch reference
+              (`torch_block_scaled_moe_routes`, ported below): NVFP4 per token (outer amax/1536, an e4m3 scale per 16
+              chosen between the 6- and 4-target candidates by reconstruction MAE), MXFP8 per 32 (ue8m0 rounded up);
+              fp32 GEMMs on the decoded values; capped SwiGLU in fp32 with the routing weight applied before the bf16
+              store and the second quantization; route rows bf16, folded in fp32 slot order, one bf16 rounding.
+              The router is Transformers' in both modes (same picks, same weights); in checkpoint mode its picks are
+              put in TokenSpeed's slot order (descending sigmoid(logit) + bias, ties to the lower id), the order of
+              TokenSpeed's fold. --decode reads each routed expert's raw tensors on first use (--expert-cache).
+
+Accumulation order of the expert sum (what a kernel must follow to reproduce a layer's bits):
+  full        per row, fp32, the picks in ascending expert id (Transformers' eager loop over experts), weight applied
+              in fp32 to the bf16 down projection, one bf16 rounding of the sum
+  checkpoint  per row, fp32, the picks in slot order (route.slot_ids), each route row already bf16, one bf16 rounding
+
+Output: OUT_DIR/<mode>/ (with --layers N: OUT_DIR/<mode>-L<N>/)
+  manifest.json      checkpoint revision and shard sha256 (the Hub's LFS ids), sha256 of the json/tokenizer files,
+                     Transformers version and commit, torch, GPU, mode, dtypes, layers, prompts (messages, rendered
+                     text, token ids), row sampling, sha256 of every output file, wall times
+  <prompt>.safetensors, one per prompt:
+    ids            int64 [T]            prompt token ids
+    rows           int64 [R]            rows kept for the hidden states: all rows when T <= 512 or --all-rows, else
+                                        the first and last 64, every 16th row, and rows 1020..1031, 2044..2051,
+                                        3068..3075
+    embed          bf16 [R, 4608]       normed embedding (layer 0's input)
+    h.<L>          bf16 [R, 4608]       decoder layer L's output (layer L+1's input; the input of layers 0, 6, ...
+                                        is what enters the block residual)
+    route.ids.<L>  int32 [T, 8]         layer L's selected experts, ascending id, every row
+    route.w.<L>    f32 [T, 8]           their routing weights (route_scale 8 included), same order
+    route.slot_ids.<L> int32 [T, 8]     the same picks in the slot order the experts received them (checkpoint mode:
+                                        TokenSpeed's order, which its fold follows; full mode: Transformers' router
+                                        order, which its expert-id-order sum does not use)
+    route.slot_w.<L>   f32 [T, 8]       their routing weights, slot order
+    route.logits.<L> f32 [R, 384]       router logits (before sigmoid and bias) of the kept rows
+    final          bf16 [R, 4608]       after final_input and the final norm
+    logits.rows    int64 [F]            rows with full logits: the last 8, and every 256th row
+    logits.full    f32 [F, 200058]      softcapped logits (unpadded vocabulary)
+    topk.ids       int32 [T, 64]        top-64 token ids of every row, descending
+    topk.vals      f32 [T, 64]          their softcapped logits
+  decode.json        with --decode: greedy continuation ids and text per prompt, and the prefill's top-1 against
+                     the teacher-forced pass
+
+Logits follow Transformers: the unembed is a bf16 Linear, so each logit is rounded to bf16 before the fp32 softcap
+(the checkpoint's manifest declares an fp32 unembed output, which TokenSpeed keeps). One bf16 step of a logit near 30
+is 0.125, so the same row computed in a GEMM of another shape (the decode's single row against the teacher-forced
+chunk) can differ by up to that much; hidden rows and routes are bit-equal between those paths.
+
+Transformers must contain models/inkling2 (main from commit 109a7d19, November 2026; the 5.22 release does not).
+Adapted and ported parts keep their notices. Transformers (Apache-2.0) is imported at run time, and parts of it are
+adapted here, each marked with its notice: the weight renames and gate/up de-interleave (`LAYER_RENAMES`,
+`deinterleave`), `LazyExperts.forward`, and the decoder loop (`masks`, `run_layer`, `finish`). The checkpoint-mode
+expert numerics are ported from TokenSpeed (MIT, notice above `_ts_fp4_round`).
+"""
+
+import argparse
+import hashlib
+import json
+import math
+import os
+import re
+import sys
+import time
+from collections import OrderedDict
+
+import torch
+import torch.nn.functional as F
+from safetensors import safe_open
+from safetensors.torch import save_file
+
+BF = torch.bfloat16
+CK = "model.llm."
+GLOBAL_STATIC = {  # config fields that Transformers' Inkling2 hardcodes; the checkpoint must agree
+    "q_bias": False, "o_bias": False, "pre_norm_pre_affine": False, "final_norm_pre_affine": False,
+    "use_value_norm_no_gamma": True, "attn_res_normalize_values": True, "n_shared_experts": 0, "use_gate_bias": True,
+}
+
+torch.backends.cuda.matmul.allow_tf32 = False
+torch.backends.cudnn.allow_tf32 = False
+
+
+# ----------------------------------------------------------------------------------------------- attention forms
+
+ATTN = {"form": "eager"}  # the core Transformers' Inkling2 attention modules run: "eager" (their own) or "fp32"
+_HF_EAGER = []  # Transformers' eager_attention_forward, kept when install_attn patches the module's name
+TF32_PROBE_LIMIT = 1e-5  # an fp32 GEMM's normwise error is ~1e-7; with TF32 inputs (10-bit mantissas) it is ~5e-4
+
+
+def bf16_spacing(value: float) -> float:
+    """One bf16 step at |value| (tools/zig/qwen27_margins.py's rule)."""
+    if not math.isfinite(value):
+        raise ValueError("nonfinite logit")
+    m = abs(value)
+    if m < 2.0 ** -126:
+        return 2.0 ** -133
+    return 2.0 ** (math.frexp(m)[1] - 1 - 7)
+
+
+def kx_core(q, k, v, bias, allowed, scaling, sinks):
+    """v0.2's fp32 attention at the kx kernels' rounding points (module docstring, --attn fp32).
+
+    q [B, H, Q, D], k and v [B, H, K, D] (bf16; key and value heads already repeated to H), bias [B, H, Q, K] (the
+    relative bias, rounded to bf16 here if it is not already) or None, allowed: bool, broadcastable to [B, H, Q, K]
+    (True: the key is in the row's window) or None (every key), sinks [B, H, Q, 1]. Returns y = O / Z [B, H, Q, D]
+    and phi = sigmoid((m + log Z) - sink) [B, H, Q, 1], both fp32: the output is bf16((y * sigmoid(gate)) * phi)."""
+    s = torch.matmul(q.float(), k.float().transpose(-1, -2)) * scaling
+    if bias is not None:
+        s = s + bias.to(BF).float()
+    if allowed is not None:
+        s = s.masked_fill(~allowed, float("-inf"))
+    m = s.amax(-1, keepdim=True)
+    w = torch.exp(s - m)
+    z = w.sum(-1, keepdim=True)
+    y = torch.matmul(w, v.float()) / z
+    phi = 1.0 / (1.0 + torch.exp(-((m + torch.log(z)) - sinks.float())))
+    return y, phi
+
+
+def kx_output(o, gate, phi):
+    """o [R, H * D] fp32 (y, row-major heads), gate [R, H * D], phi [R, H, 1]: bf16((o * sigmoid(gate)) * phi), the
+    order of the module's own gate multiply (Inkling2*Attention.forward) followed by the sink factor."""
+    R = o.shape[0]
+    g = o.float() * torch.sigmoid(gate.float())
+    return (g.view(R, phi.shape[1], -1) * phi).reshape(R, -1).to(BF)
+
+
+def hf_eager():
+    """Transformers' own eager_attention_forward, whether or not install_attn has patched the module."""
+    from transformers.models.inkling2 import modeling_inkling2 as M
+
+    return _HF_EAGER[0] if _HF_EAGER else M.eager_attention_forward
+
+
+def _attention(module, query, key, value, attention_mask, scaling, dropout=0.0, position_bias=None, sinks=None,
+               **kwargs):
+    """Inkling2's attention core by ATTN["form"]: Transformers' eager as it is, or kx_core (fp32: returns y in fp32 and
+    leaves phi on the module for its output projection's pre-hook, attach_attn)."""
+    if ATTN["form"] != "fp32":
+        return _HF_EAGER[0](module, query, key, value, attention_mask, scaling=scaling, dropout=dropout,
+                            position_bias=position_bias, sinks=sinks, **kwargs)
+    from transformers.models.inkling2.modeling_inkling2 import repeat_kv
+
+    k = repeat_kv(key, module.num_key_value_groups)
+    v = repeat_kv(value, module.num_key_value_groups)
+    allowed = None
+    if attention_mask is not None:
+        if attention_mask.dtype == torch.bool:
+            allowed = attention_mask
+        else:  # additive: 0 where allowed, the dtype's minimum elsewhere
+            allowed = attention_mask == 0
+            if not bool((allowed | (attention_mask <= -1e30)).all()):
+                raise RuntimeError("an additive attention mask with values other than 0 and the dtype's minimum")
+    y, phi = kx_core(query, k, v, position_bias, allowed, scaling, sinks)
+    module._ink2_phi = phi.transpose(1, 2)  # [B, Q, H, 1]
+    return y.transpose(1, 2).contiguous(), None
+
+
+def install_attn():
+    """Route Transformers' Inkling2 attention through _attention (its forward looks eager_attention_forward up at call
+    time). With ATTN["form"] "eager" every call goes to Transformers' function unchanged."""
+    from transformers.models.inkling2 import modeling_inkling2 as M
+
+    if not _HF_EAGER:
+        _HF_EAGER.append(M.eager_attention_forward)
+        M.eager_attention_forward = _attention
+
+
+def attach_attn(layer):
+    """The fp32 form's sink factor and one bf16 rounding at the output projection's input (the module has multiplied
+    y by sigmoid(gate) in fp32). Under eager the input is already bf16 and the hook changes nothing."""
+    attn = layer.self_attn
+
+    def hook(module, args):
+        phi = attn.__dict__.pop("_ink2_phi", None)
+        x = args[0]
+        if phi is None:
+            return None if x.dtype == BF else (x.to(BF),) + tuple(args[1:])
+        B, Q = x.shape[:2]
+        x = (x.view(B, Q, phi.shape[2], -1) * phi).reshape(B, Q, -1)
+        return (x.to(BF),) + tuple(args[1:])
+
+    attn.o_proj.register_forward_pre_hook(hook)
+    return layer
+
+
+def tf32_guard(dev) -> dict:
+    """TF32 off, read back, printed, and probed: exit 3 if TF32 could be on (an "fp32" oracle that runs TF32 is not
+    v0.2's form). NVIDIA_TF32_OVERRIDE other than 0 is refused by name (cuBLAS reads it below torch's flags)."""
+    torch.backends.cuda.matmul.allow_tf32 = False
+    torch.backends.cudnn.allow_tf32 = False
+    torch.set_float32_matmul_precision("highest")
+    env = os.environ.get("NVIDIA_TF32_OVERRIDE")
+    st = {"matmul.allow_tf32": torch.backends.cuda.matmul.allow_tf32,
+          "cudnn.allow_tf32": torch.backends.cudnn.allow_tf32,
+          "float32_matmul_precision": torch.get_float32_matmul_precision(),
+          "NVIDIA_TF32_OVERRIDE": env if env is not None else "unset"}
+    bad = [k for k in ("matmul.allow_tf32", "cudnn.allow_tf32") if st[k]]
+    if st["float32_matmul_precision"] != "highest":
+        bad.append("float32_matmul_precision")
+    if env not in (None, "0"):
+        bad.append(f"NVIDIA_TF32_OVERRIDE={env}")
+    g = torch.Generator().manual_seed(20261117)
+    a = torch.randn(256, 256, generator=g).float()
+    want = a.double() @ a.double()
+    got = (a.to(dev) @ a.to(dev)).double().cpu()
+    st["fp32_gemm_probe_rel"] = float((got - want).norm() / want.norm())
+    if not st["fp32_gemm_probe_rel"] <= TF32_PROBE_LIMIT:
+        bad.append("fp32 GEMM probe")
+    st["ok"] = not bad
+    print("TF32 guard: " + " ".join(f"{k}={v}" for k, v in st.items() if k not in ("ok", "fp32_gemm_probe_rel"))
+          + f" fp32 GEMM probe rel {st['fp32_gemm_probe_rel']:.2e} (limit {TF32_PROBE_LIMIT:g}): "
+          + ("OK" if not bad else "REFUSED (" + ", ".join(bad) + ")"), flush=True)
+    if bad:
+        sys.exit(3)
+    return st
+
+
+# ----------------------------------------------------------------------------------------------- checkpoint access
+
+
+class Source:
+    """A safetensors folder read by name, shards opened lazily; whole tensors or slices on the first axis."""
+
+    def __init__(self, folder: str):
+        self.folder = folder
+        self.where = json.load(open(os.path.join(folder, "model.safetensors.index.json")))["weight_map"]
+        self.files = {}
+
+    def _f(self, name: str):
+        shard = self.where[name]
+        if shard not in self.files:
+            self.files[shard] = safe_open(os.path.join(self.folder, shard), framework="pt", device="cpu")
+        return self.files[shard]
+
+    def get(self, name: str, device="cpu") -> torch.Tensor:
+        return self._f(name).get_tensor(name).to(device)
+
+    def rows(self, name: str, a: int, b: int, device="cpu") -> torch.Tensor:
+        return self._f(name).get_slice(name)[a:b].to(device)
+
+    def names(self, prefix: str) -> list[str]:
+        return sorted(n for n in self.where if n.startswith(prefix))
