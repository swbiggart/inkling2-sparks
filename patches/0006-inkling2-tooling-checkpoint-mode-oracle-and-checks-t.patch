+
+def hf_leaf(leaf: str) -> str:
+    for pat, rep in LAYER_RENAMES:
+        if re.match(pat, leaf):
+            return re.sub(pat, rep, leaf)
+    raise KeyError(f"no Transformers name for layer tensor {leaf}")
