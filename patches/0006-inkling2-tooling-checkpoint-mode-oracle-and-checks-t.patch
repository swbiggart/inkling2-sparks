+def catalogue_text(n_items: int) -> str:
+    """A library catalogue (the extended set's long prompt; a different shape from inventory_text)."""
+    first = ["Quiet", "Northern", "Paper", "Hidden", "Salt", "Winter", "Copper", "Glass", "Distant", "Silent"]
+    second = ["Harbour", "Orchard", "Lantern", "Meadow", "Bridge", "Garden", "Archive", "River", "Tower", "Valley"]
+    authors = ["A. Lindqvist", "B. Okafor", "C. Moreau", "D. Tanaka", "E. Novak", "F. Haddad", "G. Ruiz"]
+    lines = []
