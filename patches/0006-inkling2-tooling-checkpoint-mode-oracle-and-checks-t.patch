+    # the layers' own outputs are read with hooks (which change nothing)
+    routes, louts = {}, {}
+    hooks = []
+    for i, layer in enumerate(model.model.layers):
+        hooks.append(layer.mlp.gate.register_forward_hook(lambda mod, inp, out, i=i: routes.update({i: out})))
