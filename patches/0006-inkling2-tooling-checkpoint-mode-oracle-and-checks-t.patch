+def ext_specs(tok) -> list[dict]:
+    """The extended oracle set (part of v0.2's token gate): seven prompts beside prompt_specs, each a different shape
+    (thinking, a tool call, code, JSON, a non-English reply, a multi-turn chat, a prompt of at least 2,000 tokens)."""
+    specs = [
+        {"name": "ext_thinking", "effort": "medium",
+         "messages": [{"role": "user", "content": "Three friends split a restaurant bill of $84. Ana pays twice as "
+                                                   "much as Ben, and Ben pays $6 more than Cleo. How much does each "
+                                                   "pay? Think it through."}]},
+        {"name": "ext_tool", "effort": "low", "tools": UNITS,
+         "messages": [{"role": "user", "content": "How many kilometres is a marathon of 26.2 miles?"}]},
+        {"name": "ext_code", "effort": "none",
+         "messages": [{"role": "system", "content": "You are a careful C programmer."},
+                      {"role": "user", "content": "Write a C function that reverses a NUL-terminated string in "
+                                                  "place, with a short comment."}]},
+        {"name": "ext_json", "effort": "none",
+         "messages": [{"role": "user", "content": "Give the chemical symbol, atomic number and group name of sodium "
+                                                   "as a JSON object with the keys symbol, number and group. Reply "
+                                                   "with the JSON only."}]},
+        {"name": "ext_german", "effort": "none",
+         "messages": [{"role": "user", "content": "Erkläre in zwei Sätzen, warum der Himmel am Tag blau ist."}]},
+        {"name": "ext_multi_turn", "effort": "none",
+         "messages": [{"role": "user", "content": "I keep two beehives on a small farm."},
+                      {"role": "assistant", "content": "That sounds lovely. How are the bees doing this season?"},
+                      {"role": "user", "content": "Very well. Suggest three names for my honey, one line each."}]},
+    ]
+    n = 40
+    while True:
+        content = (f"Below is a library catalogue.\n\n{catalogue_text(n)}\n\n"
+                   f"Question: which book is on shelf {'ABCDEFGH'[(27 * 5) % 8]}{1 + (27 * 3) % 9} in room "
+                   f"{1 + (27 * 11) % 6}, and who wrote it? Answer briefly.")
+        spec = {"name": "ext_long", "effort": "none", "messages": [{"role": "user", "content": content}]}
+        if len(render(tok, spec)[1]) >= 2100:
+            break
+        n += 4
+    specs.append(spec)
