+
+    half = (n + 1) // 2
+    dm = {"model.embed_tokens": 0, "model.norm": 1, "model.final_input": 1, "lm_head": 1}
+    dm.update({f"model.layers.{i}": 0 if i < half else 1 for i in range(n)})
