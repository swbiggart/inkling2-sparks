+                     f"{180 + (k * 29) % 420} pages, published {1950 + (k * 13) % 74}, room {1 + (k * 11) % 6}, "
+                     f"shelf {'ABCDEFGH'[(k * 5) % 8]}{1 + (k * 3) % 9}.")
