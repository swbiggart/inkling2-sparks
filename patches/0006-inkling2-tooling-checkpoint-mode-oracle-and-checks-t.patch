+                with open(os.path.join(d, "decode.json"), "w") as f:  # v0.1's oracle file: no margins, strict
+                    json.dump({n: {"ids": e["ids"], "text": ""} for n, (_, e) in gs.items()}, f)
+                rc, text = run_smoke(args)
