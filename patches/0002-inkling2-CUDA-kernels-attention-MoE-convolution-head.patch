new file mode 100644
index 0000000000000000000000000000000000000000..6135749828d41b2a64980f3350e5d44e1b73d8bc
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_moe_main.zig
@@ -0,0 +1,609 @@
+//! tf-inkling2-moe: G-moe's two ops (moe.route, moe.experts; cuda_moe.zig) alone on one layer's real weights and
+//! any number of input rows, at several forward sizes. It checks that a row's bits do not depend on how many rows
+//! a call holds (a decode row, 8- and 16-row windows, a whole 2,048-row prompt chunk) or on the kernels' row
+//! tiles, and writes the outputs for tools/zig/inkling2_moe_check.py, which compares them with torch.
+//!
+//! Input (safetensors): m bf16 [N, 4608] (the mlp norm's output rows); optional ids i32 [N, 8] and w f32 [N, 8],
+//! torch's routes, which a second experts pass takes (the experts op on torch's exact inputs, as under --feed).
+//! Output: ids, w, logits, y (our routes, our experts on them) and y_fed (our experts on torch's routes), from the
+//! first chunk size; the other chunk sizes are compared with it here, bit for bit.
+//!
+//! --mode checkpoint runs the checkpoint-mode experts (cuda_moe.zig; ids and w then leave in slot order), --world W
+//! --rank R loads that rank's slice of the layer (its experts [lo, hi): y is then the rank's partial, bf16), and
+//! --reps N repeats every forward size N times and reports the fastest pass, timed by CUDA events around each
+//! experts call (route not included).
+//!
+//! --split W (checkpoint mode): split experts (plan.Layout.split), all W ranks' slices of the layer on this card as
+//! virtual ranks: every rank's splitUp, then (MoE-A: the shared buffer holds every rank's h) every rank's splitDown,
+//! then the columns (MoE-B) into y. The time reported is one rank's own work (after that pass, rank 0's two halves and
+//! the columns layout again, alone between two CUDA events), the exchanges excluded; with --slowest 1 every rank's is
+//! timed alone and the slowest rank's time a call is reported too (whole experts, --world W: every rank's slice is
+//! loaded and its experts call timed alone; y stays rank 0's partial). --against FILE compares y (and y_fed) with
+//! another run's output (W = 1 checkpoint mode: the split must be bit-equal to it). --split W --only R loads only rank
+//! R's slice (a Spark's rank folder holds only its own) and times its two halves and the columns alone, once a call,
+//! its weights cold as in a decode step; the other ranks' h and y are zero, so y is not the layer's output (it still
+//! has a row's bits fixed for the invariance checks). --rows N takes the input's first N rows.
+//!
+//! --force takes a list (--force 0,1,3): every forward size runs with each shape in turn. Every pass of a repeat runs
+//! each configuration once, in order, so the variants alternate and drift on the card spreads over all of them.
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const ic = @import("inkling2_cuda");
+
+const moe = ic.moe;
+const Mat = ic.ops.Mat;
+const H = ic.weights.hidden;
+const K8 = moe.topk;
+const NE = moe.experts_total;
+
+const usage =
+    \\usage: tf-inkling2-moe <model dir> <input.safetensors> <out.safetensors> --layer L [options]
+    \\  --chunks A,B,..   forward sizes to run (0: all rows in one; default 0,1,8,16); the first is written
+    \\  --rt both         also run the whole input with every warp shape (full: 1 and 4 row tiles; checkpoint:
+    \\                    16x8, 16x32, 64x32, 64x128 staged and the window tiles 4..): they must agree
+    \\  --mode M          full (default: TF_INK2_MODE, else full) or checkpoint
+    \\  --world W         load rank --rank's slice of W (default 1, rank 0)
+    \\  --rank R
+    \\  --reps N          each forward size N times, the fastest pass reported (default 1)
+    \\  --force S,..      every forward size with row tiles S (full) or unit shape S (checkpoint: 0-5, or U:D for the
+    \\                    up and down GEMMs); a list runs
+    \\                    each in turn, alternating within every repeat
+    \\  --split W         split experts over W virtual ranks (checkpoint mode; every rank's slice loaded)
+    \\  --only R          with --split: only rank R's slice, run as every virtual rank (its time; y not the layer's)
+    \\  --codes 1         with --split (every rank): MoE-A as codes (cuda_moe.zig splitAmax, splitQuant, splitDownCodes;
+    \\                    TF_INK2_XCODES): y must be bit-equal to the bf16 gather's (--against its run)
+    \\  --rows N          the input's first N rows (default all)
+    \\  --fed 0           ignore the input's torch routes (no y_fed pass)
+    \\  --against FILE    compare y (and y_fed) row by row with FILE's (another run's output), bit for bit
+    \\  --slowest 1       time every rank's work alone (--split W, or --world W --rank 0) and report the slowest
+    \\  --scratch-gib G   device scratch (default 2)
+    \\  --k1 1|both       split experts in K1's forms (cuda_moe.zig Form.k1: one launch for the plan and the tokens'
+    \\                    quantization, the fold inside the down GEMM, K1's shapes) for calls of 1-8 rows
+    \\The GPU is the first visible device (set CUDA_VISIBLE_DEVICES).
+    \\
+;
+
+const Opts = struct {
+    dir: []const u8,
+    input: []const u8,
+    out: []const u8,
+    layer: ?u32 = null,
+    chunks: []const usize = &.{ 0, 1, 8, 16 },
+    rt_both: bool = false,
+    scratch_gib: usize = 2,
+    mode: ?moe.Mode = null,
+    world: u32 = 1,
+    rank: u32 = 0,
+    reps: usize = 1,
+    /// every forward size with each of these row-tile counts (full) or shapes (checkpoint); empty: the default
+    force: []const u32 = &.{},
+    /// split experts over this many virtual ranks (0: whole experts)
+    split: u32 = 0,
+    /// --split: only this rank's slice, as every virtual rank
+    only: ?u32 = null,
+    /// --k1 1: the split experts' K1 forms; 2 (both): each configuration also in K1's forms
+    k1: u8 = 0,
+    /// --split: MoE-A as codes
+    codes: bool = false,
+    /// the input's first rows (null: all)
+    rows: ?usize = null,
+    /// run the input's torch routes too when it has them
+    fed: bool = true,
+    against: ?[]const u8 = null,
+    slowest: bool = false,
+};
+
+fn parse(a: std.mem.Allocator, args: []const [:0]const u8) !?Opts {
+    if (args.len < 4) return null;
+    var o: Opts = .{ .dir = args[1], .input = args[2], .out = args[3] };
+    var i: usize = 4;
+    while (i + 1 < args.len) : (i += 2) {
+        const k = args[i];
+        const v = args[i + 1];
+        if (std.mem.eql(u8, k, "--layer")) {
+            o.layer = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--chunks")) {
+            var list: std.ArrayList(usize) = .empty;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| try list.append(a, try std.fmt.parseInt(usize, x, 10));
+            if (list.items.len == 0) return null;
+            o.chunks = list.items;
+        } else if (std.mem.eql(u8, k, "--rt")) {
+            o.rt_both = std.mem.eql(u8, v, "both");
+        } else if (std.mem.eql(u8, k, "--scratch-gib")) {
+            o.scratch_gib = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--mode")) {
+            o.mode = std.meta.stringToEnum(moe.Mode, v) orelse return null;
+        } else if (std.mem.eql(u8, k, "--world")) {
+            o.world = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--rank")) {
+            o.rank = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--force")) {
+            var list: std.ArrayList(u32) = .empty;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| {
+                // checkpoint: U:D forces the up and down GEMMs' shapes apart
+                const colon = std.mem.indexOfScalar(u8, x, ':');
+                const up = try std.fmt.parseInt(u32, x[0 .. colon orelse x.len], 10);
+                try list.append(a, if (colon) |c| moe.ckPair(up, try std.fmt.parseInt(u32, x[c + 1 ..], 10)) else up);
+            }
+            o.force = list.items;
+        } else if (std.mem.eql(u8, k, "--split")) {
+            o.split = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--k1")) {
+            o.k1 = if (std.mem.eql(u8, v, "both")) 2 else if (std.mem.eql(u8, v, "1")) 1 else if (std.mem.eql(u8, v, "0")) 0 else return error.BadK1;
+        } else if (std.mem.eql(u8, k, "--only")) {
+            o.only = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--codes")) {
+            o.codes = std.mem.eql(u8, v, "1");
+        } else if (std.mem.eql(u8, k, "--fed")) {
+            o.fed = !std.mem.eql(u8, v, "0");
+        } else if (std.mem.eql(u8, k, "--rows")) {
+            o.rows = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--against")) {
+            o.against = v;
+        } else if (std.mem.eql(u8, k, "--slowest")) {
+            o.slowest = std.mem.eql(u8, v, "1");
+        } else if (std.mem.eql(u8, k, "--reps")) {
+            o.reps = @max(1, try std.fmt.parseInt(usize, v, 10));
+        } else return null;
+    }
+    if (i != args.len or o.layer == null or o.rank >= o.world or (o.only != null and (o.split < 2 or o.only.? >= o.split or o.slowest or o.against != null)) or o.split == 1 or (o.split > 1 and o.world != 1) or (o.codes and (o.split < 2 or o.only != null)) or (o.slowest and o.split == 0 and (o.world == 1 or o.rank != 0))) return null;
+    return o;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    const o = (parse(a, args) catch null) orelse {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    };
+    return run(a, init.gpa, init.io, o) catch |e| {
+        std.debug.print("FAIL tf-inkling2-moe: {t}\n", .{e});
+        return 1;
+    };
+}
+
+/// One run's outputs on the host.
+const Host = struct {
+    ids: []u8,
+    w: []u8,
+    logits: []u8,
+    y: []u8,
+    yf: []u8,
+
+    fn alloc(a: std.mem.Allocator, n: usize, fed: bool) !Host {
+        return .{
+            .ids = try a.alloc(u8, n * K8 * 4),
+            .w = try a.alloc(u8, n * K8 * 4),
+            .logits = try a.alloc(u8, n * NE * 4),
+            .y = try a.alloc(u8, n * H * 2),
+            .yf = if (fed) try a.alloc(u8, n * H * 2) else &.{},
+        };
+    }
+};
+
+/// Device buffers of N rows.
+const Bufs = struct {
+    m: Mat,
+    ids: Mat,
+    w: Mat,
+    logits: Mat,
+    y: Mat,
+    fids: Mat,
+    fw: Mat,
+    yf: Mat,
+};
+
+/// The mean number of distinct experts a call of C rows routes to (ids i32 [n, 8]): the weights a call reads.
+fn distinct(ids: []const u8, n: usize, C: usize) f64 {
+    var total: usize = 0;
+    var calls: usize = 0;
+    var start: usize = 0;
+    while (start < n) : (start += C) {
+        var seen: std.StaticBitSet(NE) = .empty;
+        for (start..@min(start + C, n)) |r| for (0..K8) |j| {
+            const e = std.mem.readInt(i32, ids[(r * K8 + j) * 4 ..][0..4], .little);
+            if (e >= 0 and e < NE) seen.set(@intCast(e));
+        };
+        total += seen.count();
+        calls += 1;
+    }
+    return @as(f64, @floatFromInt(total)) / @as(f64, @floatFromInt(calls));
+}
+
+fn rowsDiffer(x: []const u8, y: []const u8, n: usize) usize {
+    const per = x.len / n;
+    var bad: usize = 0;
+    for (0..n) |r| bad += @intFromBool(!std.mem.eql(u8, x[r * per ..][0..per], y[r * per ..][0..per]));
+    return bad;
+}
+
+fn run(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    const clock = std.Io.Clock.awake;
+    const L = o.layer.?;
+    var input = try ink.st.Reader.open(gpa, io, o.input);
+    defer input.close();
+    const em = input.find("m") orelse return error.InputHasNoM;
+    if (em.dtype != .bf16 or em.rank != 2 or em.dim(1) != H) return error.BadInput;
+    const N: usize = @min(@as(usize, @intCast(em.dim(0))), o.rows orelse std.math.maxInt(usize));
+    if (N == 0) return error.BadInput;
+    const fed = o.fed and input.find("ids") != null and input.find("w") != null;
+    var d: ink.Diag = .{};
+    var model = ink.describe.Model.fromDir(gpa, io, o.dir, if (o.split > 1) .{ .world = o.split, .layout = .split } else .{ .world = o.world }, &d) catch |e| {
+        std.debug.print("FAIL tf-inkling2-moe: {t}: {s}\n", .{ e, d.text() });
+        return 1;
+    };
+    defer model.deinit();
+    if (L >= model.c.text.layers) return error.BadLayer;
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    if (o.mode) |md| k.moe.mode = md;
+    const ckm = k.moe.mode == .checkpoint;
+    if (o.split > 1 and !ckm) {
+        std.debug.print("--split runs in checkpoint mode only (--mode checkpoint)\n", .{});
+        return 2;
+    }
+    var gemms: ic.ops.Gemms = .{ .gpa = gpa }; // no cuBLASLt: these ops do not use it
+    defer gemms.deinit();
+    var scratch = try ic.ops.Scratch.init(&driver, o.scratch_gib << 30);
+    defer scratch.deinit();
+    var t0 = clock.now(io).toNanoseconds();
+    const prep = [_]ic.weights.Prepare{moe.prepare};
+    var w = try ic.weights.load(gpa, io, &driver, o.dir, &model, .{ .rank = o.only orelse o.rank, .lo = L, .hi = L + 1 }, &prep);
+    defer w.deinit();
+    const l = w.layer(L);
+    // --split or --slowest: ranks 1 .. W-1's slices too (rank 0's is `w`)
+    const nranks: u32 = if (o.split > 1) o.split else if (o.slowest) o.world else 1;
+    // --split W --only R: rank R's slice is every virtual rank
+    const one_rank = o.only != null;
+    var others: [ink.plan.max_world]ic.weights.Weights = undefined;
+    var nothers: usize = 0;
+    defer for (others[0..nothers]) |*x| x.deinit();
+    var split_layers: [ink.plan.max_world]*const ic.weights.Layer = undefined;
+    split_layers[0] = l;
+    for (1..nranks) |r| {
+        if (one_rank) {
+            split_layers[r] = l;
+            continue;
+        }
+        others[r - 1] = try ic.weights.load(gpa, io, &driver, o.dir, &model, .{ .rank = @intCast(r), .lo = L, .hi = L + 1 }, &prep);
+        nothers += 1;
+        split_layers[r] = others[r - 1].layer(L);
+    }
+    var held: u64 = w.bytes;
+    for (others[0..nothers]) |*x| held += x.bytes;
+    std.debug.print("layer {d} ({s}, {s} experts {d}..{d}, rank {d} of {d}{s}, {s} mode) loaded: {d:.2} GiB in {d:.1} s; {d} input rows{s}\n", .{ L, if (l.global) "global" else "sliding", @tagName(l.experts.format), l.experts.lo, l.experts.hi - 1, o.only orelse o.rank, @max(o.world, o.split), if (o.split > 1) try std.fmt.allocPrint(a, ", split over {d} virtual ranks (w13 rows {d}, w2 rows {d} of each expert a rank){s}", .{ o.split, l.experts.n13, l.experts.n2, if (one_rank) "; only this rank's slice, as every virtual rank" else "" }) else "", @tagName(k.moe.mode), @as(f64, @floatFromInt(held)) / (1 << 30), secs(clock.now(io).toNanoseconds() - t0), N, if (fed) ", torch routes given" else "" });
+    var ev0 = try cuda.Event.init(&driver, true);
+    defer ev0.deinit();
+    var ev1 = try cuda.Event.init(&driver, true);
+    defer ev1.deinit();
+
+    // device buffers
+    var own: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    defer for (own.items) |*b| b.free();
+    const sizes = [_]usize{ N * H * 2, N * K8 * 4, N * K8 * 4, N * NE * 4, N * H * 2, N * K8 * 4, N * K8 * 4, N * H * 2 };
+    var ptr: [sizes.len]u64 = undefined;
+    for (sizes, 0..) |n, i| {
+        try own.append(a, try cuda.DeviceBuffer.alloc(&driver, n));
+        ptr[i] = own.items[i].ptr;
+    }
+    const B: Bufs = .{
+        .m = Mat.of(ptr[0], N, H, .bf16),
+        .ids = Mat.of(ptr[1], N, K8, .i32),
+        .w = Mat.of(ptr[2], N, K8, .f32),
+        .logits = Mat.of(ptr[3], N, NE, .f32),
+        .y = Mat.of(ptr[4], N, H, .bf16),
+        .fids = Mat.of(ptr[5], N, K8, .i32),
+        .fw = Mat.of(ptr[6], N, K8, .f32),
+        .yf = Mat.of(ptr[7], N, H, .bf16),
+    };
+    {
+        const host = try gpa.alloc(u8, N * H * 2);
+        defer gpa.free(host);
+        try input.readInto(em, 0, host);
+        try own.items[0].upload(0, host);
+        if (fed) {
+            for ([_][]const u8{ "ids", "w" }, [_]usize{ 5, 6 }, [_]ink.st.DType{ .i32, .f32 }) |name, bi, dt| {
+                const e = input.find(name).?;
+                if (e.dtype != dt or e.rank != 2 or e.dim(0) < N or e.dim(1) != K8) return error.BadInput;
+                const hb = try gpa.alloc(u8, N * K8 * 4);
+                defer gpa.free(hb);
+                try input.readInto(e, 0, hb);
+                try own.items[bi].upload(0, hb);
+            }
+        }
+    }
+    const c: ic.ops.Ctx = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch };
+    var sp: ?Virt = null;
+    if (nranks > 1) {
+        const split_sizes = [4]usize{ if (o.split > 1) N * K8 * moe.intermediate * 2 else 0, N * H * 2, if (o.split > 1) moe.splitPlanBytes(N) * nranks else 0, N * H * 2 };
+        var sb: [4]u64 = undefined;
+        for (split_sizes, &sb) |n, *x| {
+            try own.append(a, try cuda.DeviceBuffer.alloc(&driver, n));
+            x.* = own.items[own.items.len - 1].ptr;
+        }
+        sp = .{ .world = nranks, .split = o.split > 1, .layers = split_layers[0..nranks], .h = sb[0], .y = sb[1], .plan = sb[2], .plan_bytes = if (o.split > 1) moe.splitPlanBytes(N) else 0, .y_rerun = sb[3], .one = one_rank };
+        if (o.codes) {
+            try own.ensureUnusedCapacity(a, 1); // the list's slot first: a failed append cannot lose the buffer
+            own.appendAssumeCapacity(try cuda.DeviceBuffer.alloc(&driver, nranks * (moe.codesSlot(false, nranks, N * K8) + N * K8 * 4)));
+            sp.?.codes = own.items[own.items.len - 1].ptr;
+        }
+    }
+    var ev2 = try cuda.Event.init(&driver, true);
+    defer ev2.deinit();
+    var ev3 = try cuda.Event.init(&driver, true);
+    defer ev3.deinit();
+    const evs = [4]*cuda.Event{ &ev0, &ev1, &ev2, &ev3 };
+
+    var first: ?Host = null;
+    var bad_total: usize = 0;
+    const Cfg = struct { chunk: usize, rt: ?u32, k1: bool = false, route_ns: i96 = 0, exp_ns: i96 = 0, max_ns: i96 = 0, fed_ns: i96 = 0 };
+    var configs: std.ArrayList(Cfg) = .empty;
+    // a checkpoint shape that cannot run this layer's GEMMs (moe.ckFits) is skipped
+    const nvl = l.experts.format == .nvfp4;
+    for (o.force) |sh| if (ckm and !moe.ckFits(sh, nvl)) std.debug.print("shape {d} skipped: it does not fit this layer's GEMMs\n", .{sh});
+    for (o.chunks) |ch| {
+        if (o.force.len == 0) try configs.append(a, .{ .chunk = ch, .rt = null });
+        for (o.force) |sh| if (!ckm or moe.ckFits(sh, nvl)) try configs.append(a, .{ .chunk = ch, .rt = sh });
+    }
+    if (o.rt_both) {
+        if (ckm) {
+            for (0..moe.ck_shapes) |sh| if (moe.ckFits(@intCast(sh), nvl)) try configs.append(a, .{ .chunk = 0, .rt = @intCast(sh) });
+        } else {
+            try configs.append(a, .{ .chunk = 0, .rt = 1 });
+            try configs.append(a, .{ .chunk = 0, .rt = 4 });
+        }
+    }
+    // --k1: every configuration in K1's forms (1), or each followed by its K1 twin (2)
+    if (o.k1 == 1) {
+        for (configs.items) |*cfg| cfg.k1 = true;
+    } else if (o.k1 == 2) {
+        var both: std.ArrayList(Cfg) = .empty;
+        for (configs.items) |cfg| {
+            try both.append(a, cfg);
+            var t = cfg;
+            t.k1 = true;
+            try both.append(a, t);
+        }
+        configs = both;
+    }
+    // every repeat runs each configuration once, in order (the variants alternate); the last one checks the outputs
+    for (0..o.reps) |rep| for (configs.items) |*cfg| {
+        const C = if (cfg.chunk == 0) N else @min(cfg.chunk, N);
+        var r_ns: i96 = 0;
+        var e_ns: i96 = 0;
+        var x_ns: i96 = 0;
+        var f_ns: i96 = 0;
+        var start: usize = 0;
+        while (start < N) : (start += C) {
+            const R = @min(C, N - start);
+            scratch.reset();
+            t0 = clock.now(io).toNanoseconds();
+            try moe.route(&c, l, B.m.slice(start, R), B.ids.slice(start, R), B.w.slice(start, R), B.logits.slice(start, R));
+            try stream.synchronize();
+            r_ns += clock.now(io).toNanoseconds() - t0;
+            scratch.reset();
+            const t = try timed(&c, evs, l, sp, B.m.slice(start, R), B.ids.slice(start, R), B.w.slice(start, R), B.y.slice(start, R), cfg.rt, .{ .k1 = cfg.k1 });
+            e_ns += t[0];
+            x_ns += t[1];
+            if (fed) {
+                scratch.reset();
+                f_ns += (try timed(&c, evs, l, sp, B.m.slice(start, R), B.fids.slice(start, R), B.fw.slice(start, R), B.yf.slice(start, R), cfg.rt, .{ .k1 = cfg.k1 }))[0];
+            }
+        }
+        if (rep == 0 or e_ns < cfg.exp_ns) {
+            cfg.route_ns = r_ns;
+            cfg.exp_ns = e_ns;
+            cfg.fed_ns = f_ns;
+        }
+        if (rep == 0 or x_ns < cfg.max_ns) cfg.max_ns = x_ns;
+        if (rep + 1 < o.reps) continue;
+        const h = try Host.alloc(a, N, fed);
+        try own.items[1].download(0, h.ids);
+        try own.items[2].download(0, h.w);
+        try own.items[3].download(0, h.logits);
+        try own.items[4].download(0, h.y);
+        if (fed) try own.items[7].download(0, h.yf);
+        const calls = (N + C - 1) / C;
+        const shape_names = [_][]const u8{ ", 16x8 a warp", ", 16x32 a warp", ", 64x32 a warp", ", 64x128 staged" };
+        const tag = if (cfg.rt) |r| (if (ckm) (if (r >> 16 != 0) try std.fmt.allocPrint(a, ", shapes {d}:{d}", .{ moe.ckUnpair(r)[0], moe.ckUnpair(r)[1] }) else if (r < shape_names.len) shape_names[r] else try std.fmt.allocPrint(a, ", shape {d}", .{r})) else if (r == 1) ", 1 row tile" else ", 4 row tiles") else "";
+        std.debug.print("forwards of {d} rows ({d} calls{s}{s}): route {d:.3} ms, experts {d:.4} ms a call (mean, CUDA events, best of {d}); scratch peak {d} MiB; {d:.2} distinct experts a call", .{ C, calls, tag, if (cfg.k1) ", k1" else "", ms(cfg.route_ns) / @as(f64, @floatFromInt(calls)), ms(cfg.exp_ns) / @as(f64, @floatFromInt(calls)), o.reps, scratch.peak >> 20, distinct(h.ids, N, C) });
+        if (o.slowest) std.debug.print(", the slowest of {d} ranks {d:.4} ms a call", .{ nranks, ms(cfg.max_ns) / @as(f64, @floatFromInt(calls)) });
+        if (fed) std.debug.print(", experts on torch's routes {d:.3} ms", .{ms(cfg.fed_ns) / @as(f64, @floatFromInt(calls))});
+        std.debug.print("\n", .{});
+        if (first) |f| {
+            const bi = rowsDiffer(h.ids, f.ids, N);
+            const bw = rowsDiffer(h.w, f.w, N);
+            const bl = rowsDiffer(h.logits, f.logits, N);
+            const by = rowsDiffer(h.y, f.y, N);
+            const bf = if (fed) rowsDiffer(h.yf, f.yf, N) else 0;
+            bad_total += bi + bw + bl + by + bf;
+            std.debug.print("  against the first: rows differing ids {d}, w {d}, logits {d}, y {d}, y_fed {d} (of {d}) {s}\n", .{ bi, bw, bl, by, bf, N, if (bi + bw + bl + by + bf == 0) "BIT-EQUAL" else "DIFFER" });
+        } else first = h;
+    };
+    const f = first.?;
+    if (o.against) |path| {
+        var ref = try ink.st.Reader.open(gpa, io, path);
+        defer ref.close();
+        for ([_][]const u8{ "ids", "w", "y", "y_fed" }, [_][]u8{ f.ids, f.w, f.y, f.yf }) |name, mine| {
+            if (mine.len == 0) continue;
+            const e = ref.find(name) orelse return error.AgainstHasNoTensor;
+            if (e.dim(0) != N) return error.AgainstRows;
+            const theirs = try a.alloc(u8, mine.len);
+            try ref.readInto(e, 0, theirs);
+            const bad = rowsDiffer(mine, theirs, N);
+            bad_total += bad;
+            std.debug.print("against {s}: {s} rows differing {d} of {d} {s}\n", .{ std.fs.path.basename(path), name, bad, N, if (bad == 0) "BIT-EQUAL" else "DIFFER" });
+        }
+    }
+    var out = ink.st.Writer.init(gpa);
+    defer out.deinit();
+    try out.add("ids", .i32, &.{ N, K8 }, f.ids);
+    try out.add("w", .f32, &.{ N, K8 }, f.w);
+    try out.add("logits", .f32, &.{ N, NE }, f.logits);
+    try out.add("y", .bf16, &.{ N, H }, f.y);
+    if (fed) try out.add("y_fed", .bf16, &.{ N, H }, f.yf);
+    try out.setMeta("tool", "tf-inkling2-moe");
+    try out.setMeta("layer", try std.fmt.allocPrint(a, "{d}", .{L}));
+    try out.setMeta("format", @tagName(l.experts.format));
+    try out.setMeta("mode", @tagName(k.moe.mode));
+    try out.setMeta("world", try std.fmt.allocPrint(a, "{d}", .{o.world}));
+    try out.setMeta("split", try std.fmt.allocPrint(a, "{d}", .{o.split}));
+    try out.setMeta("rank", try std.fmt.allocPrint(a, "{d}", .{o.rank}));
+    try out.setMeta("experts", try std.fmt.allocPrint(a, "{d}:{d}", .{ l.experts.lo, l.experts.hi }));
+    try out.setMeta("chunk", try std.fmt.allocPrint(a, "{d}", .{if (o.chunks[0] == 0) N else o.chunks[0]}));
+    try out.write(io, o.out);
+    std.debug.print("{s}: {d} rows written to {s}; row invariance{s} {s}\n", .{ if (bad_total == 0) "PASS" else "FAIL", N, o.out, if (o.against != null) " and the --against rows" else "", if (bad_total == 0) "bit-equal" else "BROKEN" });
+    return if (bad_total == 0) 0 else 1;
+}
+
+/// Virtual ranks: every rank's layer slice; split experts' shared exchange buffers (h [W][R * 8][I/W], y [W][R][H/W]),
+/// or whole experts' spare output (y, the other ranks' partials).
+const Virt = struct {
+    world: u32,
+    split: bool,
+    layers: []const *const ic.weights.Layer,
+    h: u64,
+    y: u64,
+    /// each virtual rank's route plan (cuda_moe.zig splitPlanBytes(N) apart, as each rank's exchange holds its own:
+    /// the K1 forms keep their fold counters there)
+    plan: u64,
+    plan_bytes: usize = 0,
+    /// the timing pass's columns (its result is not the one compared)
+    y_rerun: u64 = 0,
+    /// --codes: MoE-A as codes: the gather's slots [W][codesSlot] (shared, as h), then every rank's amax [W][R * 8]
+    codes: u64 = 0,
+    /// --only: one rank's slice as every rank; only virtual rank 0 runs, once, between the events (its weights cold,
+    /// as in a decode step); the call's h ([W][R * 8][I/W]) and y ([W][R][H/W]) are zeroed first, so y (not the
+    /// layer's) still has a row's bits fixed
+    one: bool = false,
+};
+
+fn since(ev: [4]*cuda.Event) !i96 {
+    try ev[1].synchronize();
+    return @intFromFloat(@as(f64, try cuda.Event.elapsedMs(ev[0].*, ev[1].*)) * 1e6);
+}
+
+/// One experts call (the layer's mode; `force` the full mode's row tiles or the checkpoint mode's warp shape) between
+/// two CUDA events: its device time in ns, rank 0's and the slowest rank's. Split experts: every rank's two halves and
+/// the columns (the result), then each rank's own work again alone between the events (the same values rewritten).
+/// Whole experts over virtual ranks: each rank's call alone (rank 0's into y).
+fn timed(c: *const ic.ops.Ctx, ev: [4]*cuda.Event, l: *const ic.weights.Layer, v: ?Virt, m: Mat, ids: Mat, w: Mat, y: Mat, force: ?u32, form: moe.Form) ![2]i96 {
+    const s = v orelse {
+        try ev[0].record(c.stream);
+        if (c.k.moe.mode == .checkpoint) {
+            try moe.expertsCk(c, l, m, ids, w, y, force);
+        } else {
+            try moe.expertsTiled(c, l, m, ids, w, y, force);
+        }
+        try ev[1].record(c.stream);
+        const t = try since(ev);
+        return .{ t, t };
+    };
+    const R = m.rows;
+    var out: [2]i96 = .{ 0, 0 };
+    if (!s.split) {
+        for (s.layers, 0..) |lr, r| {
+            c.scratch.reset();
+            const yr = if (r == 0) y else Mat.of(s.y, R, H, .bf16);
+            try ev[0].record(c.stream);
+            if (c.k.moe.mode == .checkpoint) try moe.expertsCk(c, lr, m, ids, w, yr, force) else try moe.expertsTiled(c, lr, m, ids, w, yr, force);
+            try ev[1].record(c.stream);
+            const t = try since(ev);
+            if (r == 0) out[0] = t;
+            out[1] = @max(out[1], t);
+        }
+        return out;
+    }
+    const seg = moe.intermediate / s.world;
+    if (s.one) {
+        try c.d.check(c.d.api.cuMemsetD8Async(s.h, 0, R * K8 * moe.intermediate * 2, c.stream.handle), "cuMemsetD8Async");
+        try c.d.check(c.d.api.cuMemsetD8Async(s.y, 0, R * H * 2, c.stream.handle), "cuMemsetD8Async");
+        c.scratch.reset();
+        try ev[0].record(c.stream);
+        try moe.splitUp(c, s.layers[0], m, ids, w, s.h, s.plan, force, form);
+        c.scratch.reset();
+        try moe.splitDown(c, s.layers[0], R, s.h, s.plan, s.y, force, form);
+        try moe.splitColumns(c, s.y, s.world, y);
+        try ev[1].record(c.stream);
+        const t = try since(ev);
+        return .{ t, t };
+    }
+    // every rank's slices poisoned first (0xFF bytes: NaN bf16), so a slice a rank never writes cannot pass
+    try c.d.check(c.d.api.cuMemsetD8Async(s.h, 0xFF, R * K8 * moe.intermediate * 2, c.stream.handle), "cuMemsetD8Async");
+    try c.d.check(c.d.api.cuMemsetD8Async(s.y, 0xFF, R * H * 2, c.stream.handle), "cuMemsetD8Async");
+    for (s.layers, 0..) |lr, r| {
+        c.scratch.reset();
+        try moe.splitUp(c, lr, m, ids, w, s.h + r * R * K8 * seg * 2, s.plan + r * s.plan_bytes, force, form);
+    }
+    if (s.codes != 0) {
+        try codesPass(c, s, R, force, form);
+    } else for (s.layers, 0..) |lr, r| {
+        c.scratch.reset();
+        try moe.splitDown(c, lr, R, s.h, s.plan + r * s.plan_bytes, s.y + r * R * (H / s.world) * 2, force, form);
+    }
+    // the result compared: this first all-up, all-down pass's columns (the timing pass below writes y_rerun)
+    try moe.splitColumns(c, s.y, s.world, y);
+    // each rank's own work alone: the same values again
+    for (s.layers, 0..) |lr, r| {
+        c.scratch.reset();
+        try ev[0].record(c.stream);
+        try moe.splitUp(c, lr, m, ids, w, s.h + r * R * K8 * seg * 2, s.plan + r * s.plan_bytes, force, form);
+        c.scratch.reset();
+        if (s.codes != 0) try codesRank(c, s, R, r, force, form) else try moe.splitDown(c, lr, R, s.h, s.plan + r * s.plan_bytes, s.y + r * R * (H / s.world) * 2, force, form);
+        try moe.splitColumns(c, s.y, s.world, Mat.of(s.y_rerun, R, H, .bf16));
+        try ev[1].record(c.stream);
+        const t = try since(ev);
+        if (r == 0) out[0] = t;
+        out[1] = @max(out[1], t);
+    }
+    return out;
+}
+
+/// --codes: after every rank's splitUp, MoE-A as codes over the virtual ranks (the shared buffers stand for the
+/// gathers): each rank's segment amax, its quantized slot, then each rank's down pass from the codes.
+fn codesPass(c: *const ic.ops.Ctx, s: Virt, R: usize, force: ?u32, form: moe.Form) !void {
+    const W = s.world;
+    const seg = moe.intermediate / W;
+    const routes = R * K8;
+    const amaxes = s.codes + W * moe.codesSlot(false, W, routes);
+    for (s.layers, 0..) |lr, r| try moe.splitAmax(c, lr, R, W, s.h + r * routes * seg * 2, amaxes + r * routes * 4);
+    for (s.layers, 0..) |lr, r| {
+        const nv = lr.experts.format == .nvfp4;
+        try moe.splitQuant(c, lr, R, W, s.h + r * routes * seg * 2, amaxes, s.codes + r * moe.codesSlot(nv, W, routes));
+    }
+    for (s.layers, 0..) |lr, r| {
+        c.scratch.reset();
+        try moe.splitDownCodes(c, lr, R, .{ .parts = s.codes, .world = W, .amaxes = amaxes }, s.plan + r * s.plan_bytes, s.y + r * R * (H / W) * 2, force, form);
+    }
+}
+
+/// --codes, one rank's own work after codesPass (the other ranks' slots and amaxes still in the shared buffers).
+fn codesRank(c: *const ic.ops.Ctx, s: Virt, R: usize, r: usize, force: ?u32, form: moe.Form) !void {
+    const W = s.world;
+    const routes = R * K8;
+    const lr = s.layers[r];
+    const nv = lr.experts.format == .nvfp4;
+    const amaxes = s.codes + W * moe.codesSlot(false, W, routes);
+    const h = s.h + r * routes * (moe.intermediate / W) * 2;
+    try moe.splitAmax(c, lr, R, W, h, amaxes + r * routes * 4);
+    try moe.splitQuant(c, lr, R, W, h, amaxes, s.codes + r * moe.codesSlot(nv, W, routes));
+    try moe.splitDownCodes(c, lr, R, .{ .parts = s.codes, .world = W, .amaxes = amaxes }, s.plan + r * s.plan_bytes, s.y + r * R * (H / W) * 2, force, form);
+}
+
+fn secs(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-9;
+}
+
+fn ms(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-6;
+}
diff --git a/zig/src/families/inkling2/cuda_ops.zig b/zig/src/families/inkling2/cuda_ops.zig
new file mode 100644
index 0000000000000000000000000000000000000000..dd6667053ccb6003593e2fae077b50e4900e00be
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_ops.zig
@@ -0,0 +1,308 @@
+//! What every Inkling-2 op group's entry points take: device matrices (`Mat`), the op context (`Ctx`: driver,
+//! stream, every group's kernels, cuBLASLt plans, a per-op scratch arena), and the scaffold's own helpers (bf16
+//! Linear via cuBLASLt, RMS norm rows via norms.cu, device copies). An entry point that has no kernel yet returns
+//! `error.NotImplemented`; the forward (cuda_forward.zig) stops there by name, or under --feed takes torch's outputs.
+//!
+//! Layout rules for every `Mat` an entry point receives: row-major, `rows` rows of `cols` elements, `ld` elements
+//! between rows (ld == cols unless a header says otherwise), 256-byte aligned base (the scaffold's buffers are), rows
+//! are token rows in position order. Head-shaped tensors are flattened: [R, heads * dim], head h at columns
+//! h*dim .. h*dim+dim-1 (Transformers' `.view(*shape, heads, dim)`).
+const std = @import("std");
+const cuda = @import("cuda");
+const kernels_mod = @import("cuda_kernels.zig");
+
+pub const Kernels = kernels_mod.Kernels;
+
+pub const Dt = enum {
+    bf16,
+    f32,
+    i32,
+    u8,
+
+    pub fn size(d: Dt) usize {
+        return switch (d) {
+            .bf16 => 2,
+            .f32, .i32 => 4,
+            .u8 => 1,
+        };
+    }
+};
+
+/// A row-major device matrix.
+pub const Mat = struct {
+    ptr: u64 = 0,
+    rows: usize = 0,
+    cols: usize = 0,
+    ld: usize = 0,
+    dt: Dt = .bf16,
+
+    pub fn of(ptr: u64, rows: usize, cols: usize, dt: Dt) Mat {
+        return .{ .ptr = ptr, .rows = rows, .cols = cols, .ld = cols, .dt = dt };
+    }
+
+    /// Bytes from the first row's start to the last row's end.
+    pub fn bytes(m: Mat) usize {
+        if (m.rows == 0) return 0;
+        return ((m.rows - 1) * m.ld + m.cols) * m.dt.size();
+    }
+
+    pub fn row(m: Mat, i: usize) u64 {
+        return m.ptr + i * m.ld * m.dt.size();
+    }
+
+    /// Rows `lo` .. `lo + n`.
+    pub fn slice(m: Mat, lo: usize, n: usize) Mat {
+        return .{ .ptr = m.row(lo), .rows = n, .cols = m.cols, .ld = m.ld, .dt = m.dt };
+    }
+
+    pub fn dense(m: Mat) bool {
+        return m.ld == m.cols;
+    }
+
+    pub fn is(m: Mat, rows: usize, cols: usize, dt: Dt) bool {
+        return m.rows == rows and m.cols == cols and m.dt == dt;
+    }
+};
+
+/// The completed block-residual sources of a forward's rows: `count` matrices [R, hidden] bf16, block i at
+/// `ptr + i * stride` bytes (Transformers' `block_states[..., i, :]`): the inputs of layers 0, 6, 12, ... below the
+/// current layer (block 0 is the normed embedding).
+pub const Blocks = struct {
+    ptr: u64,
+    stride: usize,
+    count: usize,
+    rows: usize,
+    hidden: usize,
+
+    pub fn at(b: Blocks, i: usize) Mat {
+        return Mat.of(b.ptr + i * b.stride, b.rows, b.hidden, .bf16);
+    }
+};
+
+/// cuBLASLt plans by shape (a torch Linear: bf16 X [m, k] . W [n, k]^T, fp32 accumulate, bf16 or fp32 out).
+pub const Gemms = struct {
+    gpa: std.mem.Allocator,
+    lt: ?cuda.cublaslt.Library = null,
+    plans: std.AutoHashMapUnmanaged([4]u64, cuda.cublaslt.Linear) = .empty,
+    workspace: ?cuda.DeviceBuffer = null,
+
+    pub const workspace_bytes: usize = 32 << 20;
+
+    pub fn init(gpa: std.mem.Allocator, d: *const cuda.Driver) !Gemms {
+        var g: Gemms = .{ .gpa = gpa };
+        g.lt = try cuda.cublaslt.Library.open();
+        errdefer g.lt.?.close();
+        g.workspace = try cuda.DeviceBuffer.alloc(d, workspace_bytes);
+        return g;
+    }
+
+    pub fn deinit(g: *Gemms) void {
+        var it = g.plans.valueIterator();
+        while (it.next()) |p| p.deinit();
+        g.plans.deinit(g.gpa);
+        if (g.workspace) |*w| w.free();
+        if (g.lt) |*l| l.close();
+        g.* = undefined;
+    }
+
+    fn plan(g: *Gemms, m: usize, n: usize, k: usize, out: cuda.cublaslt.DataType) !*const cuda.cublaslt.Linear {
+        const key = [4]u64{ m, n, k, @intCast(@intFromEnum(out)) };
+        if (g.plans.getPtr(key)) |p| return p;
+        var p = try cuda.cublaslt.Linear.init(&g.lt.?, m, n, k, out, workspace_bytes);
+        errdefer p.deinit();
+        try g.plans.put(g.gpa, key, p);
+        return g.plans.getPtr(key).?;
+    }
+};
+
+/// The op context every entry point takes.
+pub const Ctx = struct {
+    d: *const cuda.Driver,
+    stream: cuda.Stream,
+    k: *const Kernels,
+    gemms: *Gemms,
+    scratch: *Scratch,
+    /// While a forward is captured: its launches on ring views of pool runs (`launchOn`).
+    runs: ?*RunLog = null,
+
+    /// `bytes` of device scratch (256-byte aligned) valid until the op returns; the forward resets it per op.
+    pub fn tmp(c: *const Ctx, bytes: usize) !u64 {
+        return c.scratch.take(bytes);
+    }
+
+    /// out [m, n] (bf16 or fp32) = x [m, k] bf16 . w [n, k]^T bf16: Transformers' bf16 `nn.Linear` (cuBLASLt, fp32
+    /// accumulate, one rounding). x and out dense. Measured: bit-equal to torch at the same m, but cuBLASLt picks
+    /// its algorithm by m, so a row's bits change with the forward's row count (8-row forwards against one of 25:
+    /// rel 2e-3, a third of the bf16 values 1 ulp or more off). Not row-invariant: the G1 seam gate needs a
+    /// projection whose reduction order does not depend on m (one algorithm a shape, or a tiled kernel of ours).
+    pub fn linear(c: *const Ctx, x: Mat, w: u64, n: usize, out: Mat) !void {
+        if (x.dt != .bf16 or !x.dense() or !out.dense() or out.rows != x.rows or out.cols != n) return error.BadLinearShape;
+        if (x.rows == 0) return;
+        const dt: cuda.cublaslt.DataType = switch (out.dt) {
+            .bf16 => .bf16,
+            .f32 => .f32,
+            else => return error.BadLinearShape,
+        };
+        const p = try c.gemms.plan(x.rows, n, x.cols, dt);
+        const ws = c.gemms.workspace.?;
+        try p.run(x.ptr, w, out.ptr, ws.ptr, ws.len, c.stream.handle);
+    }
+
+    /// y [R, width] bf16 = bf16(x * rsqrt(mean(x^2) + eps) * gain), x bf16 or fp32, gain fp32 [width] (0: none):
+    /// Transformers' `Inkling2RMSNorm` (fp32 math, gain after the normalisation) then `.to(bf16)`.
+    pub fn rms(c: *const Ctx, x: Mat, gain: u64, y: Mat, eps: f32) !void {
+        if (!x.dense() or !y.dense() or x.rows != y.rows or x.cols != y.cols or y.dt != .bf16) return error.BadNormShape;
+        const kind: cuda.norms.Kind = switch (x.dt) {
+            .bf16 => .bf16,
+            .f32 => .f32,
+            else => return error.BadNormShape,
+        };
+        try c.k.norms.rms(c.stream, x.ptr, kind, if (gain == 0) null else gain, y.ptr, .bf16, x.rows, x.cols, eps);
+    }
+
+    /// `n` bytes from `src` to `dst` on the op stream.
+    pub fn copy(c: *const Ctx, dst: u64, src: u64, n: usize) !void {
+        if (n == 0) return;
+        const view: cuda.DeviceBuffer = .{ .d = c.d, .ptr = dst, .len = n, .borrowed = true };
+        try view.copyFrom(0, src, n, c.stream.handle);
+    }
+
+    /// Rows of `src` into `dst` (same shape and dtype; any ld).
+    pub fn copyRows(c: *const Ctx, dst: Mat, src: Mat) !void {
+        if (dst.rows != src.rows or dst.cols != src.cols or dst.dt != src.dt) return error.BadCopyShape;
+        if (dst.dense() and src.dense()) return c.copy(dst.ptr, src.ptr, src.bytes());
+        for (0..src.rows) |i| try c.copy(dst.row(i), src.row(i), src.cols * src.dt.size());
+    }
+
+    pub fn zero(c: *const Ctx, ptr: u64, n: usize) !void {
+        if (n == 0) return;
+        const view: cuda.DeviceBuffer = .{ .d = c.d, .ptr = ptr, .len = n, .borrowed = true };
+        try view.fill8(0, c.stream.handle);
+    }
+
+    /// A launch whose arguments may name a ring view of a stream's run of pool pages (`run`: the run's first page;
+    /// `k`, `v` the view's bases): while a forward is captured (`runs` set) it is recorded, so a replay can point the
+    /// node at the stream's run when that moves (cuda_engine.zig Graph).
+    pub fn launchOn(c: *const Ctx, run: ?u32, k: u64, v: u64, f: cuda.Function, cfg: cuda.launch.Config, a: *cuda.Args) !void {
+        try cuda.launch.launch(f, cfg, c.stream, a);
+        if (run) |r| if (c.runs) |log| try log.add(f, cfg, a, k, v, r);
+    }
+};
+
+/// The launches of a captured forward that read or write a ring view of a stream's run of pool pages
+/// (Ctx.launchOn): each with its arguments and the argument slots holding the view's bases.
+pub const RunLog = struct {
+    pub const Launch = struct {
+        f: cuda.Function,
+        cfg: cuda.launch.Config,
+        args: cuda.Args,
+        /// the run's first page when captured
+        run: u32,
+        /// argument indices that hold a base (k or v), `n` of them
+        at: [4]u8 = @splat(0),
+        n: u8 = 0,
+    };
+
+    gpa: std.mem.Allocator,
+    items: std.ArrayList(Launch) = .empty,
+
+    pub fn deinit(l: *RunLog) void {
+        l.items.deinit(l.gpa);
+    }
+
+    fn add(l: *RunLog, f: cuda.Function, cfg: cuda.launch.Config, a: *const cuda.Args, k: u64, v: u64, run: u32) !void {
+        var x: Launch = .{ .f = f, .cfg = cfg, .args = a.*, .run = run };
+        for (0..a.count) |i| {
+            const val = a.integer(i) orelse continue;
+            if (a.sizes[i] != 8 or (val != k and val != v)) continue;
+            if (x.n == x.at.len) return error.RunLaunchArgs;
+            x.at[x.n] = @intCast(i);
+            x.n += 1;
+        }
+        if (x.n == 0) return error.RunLaunchArgs;
+        try l.items.append(l.gpa, x);
+    }
+};
+
+/// A bump arena of device memory, reset by the forward before every op. It keeps the most any op took (`peak`), and
+/// by forward kind (`kind`, set by whoever starts the forward; `peaks`); a new high is logged once it passes the last
+/// logged one by an eighth. What a forward will take is cuda_scratch.zig's `need` (checked before a step's header).
+pub const Scratch = struct {
+    buf: cuda.DeviceBuffer,
+    used: usize = 0,
+    peak: usize = 0,
+    kind: Kind = .other,
+    peaks: [kinds]usize = @splat(0),
+    logged: usize = 0,
+
+    /// The forward a take belongs to: a prompt chunk (more than a verify window's rows, one stream), a decode row,
+    /// a verify window (2-8 rows), several streams' rows (batched), or anything else (op checks, tools).
+    pub const Kind = enum { prompt, decode, window, batched, other };
+    pub const kinds = @typeInfo(Kind).@"enum".field_names.len;
+
+    pub fn init(d: *const cuda.Driver, bytes: usize) !Scratch {
+        return .{ .buf = try cuda.DeviceBuffer.alloc(d, bytes) };
+    }
+
+    pub fn deinit(s: *Scratch) void {
+        s.buf.free();
+    }
+
+    pub fn reset(s: *Scratch) void {
+        s.used = 0;
+    }
+
+    pub fn take(s: *Scratch, bytes: usize) !u64 {
+        const at = std.mem.alignForward(usize, s.used, 256);
+        if (at + bytes > s.buf.len) {
+            std.log.err("inkling2: op scratch of {d} MiB is short of {d} MiB ({t} forward; raise TF_INK2_SCRATCH_GIB)", .{ s.buf.len >> 20, (at + bytes) >> 20, s.kind });
+            return error.ScratchFull;
+        }
+        s.used = at + bytes;
+        if (s.used > s.peak) s.rise();
+        const k = @intFromEnum(s.kind);
+        s.peaks[k] = @max(s.peaks[k], s.used);
+        return s.buf.ptr + at;
+    }
+
+    fn rise(s: *Scratch) void {
+        s.peak = s.used;
+        if (s.peak <= s.logged + s.logged / 8) return;
+        s.logged = s.peak;
+        std.log.info("inkling2: op scratch peak {d:.1} MiB of {d} MiB ({t} forward)", .{ mib(s.peak), s.buf.len >> 20, s.kind });
+    }
+
+    /// The peaks by forward kind, one log line.
+    pub fn report(s: *const Scratch, rank: u32) void {
+        std.log.info("inkling2 rank {d}: op scratch peaks (MiB of {d}): prompt {d:.1}, decode {d:.1}, window {d:.1}, batched {d:.1}, other {d:.1}", .{ rank, s.buf.len >> 20, mib(s.peaks[0]), mib(s.peaks[1]), mib(s.peaks[2]), mib(s.peaks[3]), mib(s.peaks[4]) });
+    }
+};
+
+pub fn mib(b: usize) f64 {
+    return @as(f64, @floatFromInt(b)) / (1 << 20);
+}
+
+test "inkling2 cuda ops: Mat rows, slices and byte spans" {
+    const m: Mat = .{ .ptr = 4096, .rows = 3, .cols = 10, .ld = 16, .dt = .bf16 };
+    try std.testing.expectEqual(@as(usize, (2 * 16 + 10) * 2), m.bytes());
+    try std.testing.expectEqual(@as(u64, 4096 + 2 * 16 * 2), m.row(2));
+    const s = m.slice(1, 2);
+    try std.testing.expectEqual(@as(u64, 4096 + 32), s.ptr);
+    try std.testing.expect(!s.dense());
+    try std.testing.expect(Mat.of(0, 4, 384, .f32).is(4, 384, .f32));
+    const b: Blocks = .{ .ptr = 1 << 20, .stride = 4 * 4608 * 2, .count = 2, .rows = 4, .hidden = 4608 };
+    try std.testing.expectEqual(@as(u64, (1 << 20) + 4 * 4608 * 2), b.at(1).ptr);
+}
+
+test "inkling2 cuda ops: the scratch's peaks by forward kind" {
+    var s: Scratch = .{ .buf = .{ .d = undefined, .ptr = 1 << 20, .len = 64 << 20, .borrowed = true } };
+    s.kind = .prompt;
+    _ = try s.take(1000);
+    _ = try s.take(10);
+    try std.testing.expectEqual(@as(usize, 1024 + 10), s.peaks[0]);
+    s.reset();
+    s.kind = .decode;
+    try std.testing.expectEqual(@as(u64, (1 << 20)), try s.take(300));
+    try std.testing.expectEqual(@as(usize, 300), s.peaks[1]);
+    try std.testing.expectEqual(@as(usize, 1034), s.peak);
+}
diff --git a/zig/src/families/inkling2/cuda_res.zig b/zig/src/families/inkling2/cuda_res.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e909090de9ddc3e66676b5efdbcf9b33de06c2e8
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_res.zig
@@ -0,0 +1,158 @@
+//! G-res: the block attention residual (6-layer blocks) and the norms around it. Kernel image: inkling2_res.cu.
+//!
+//! Math (Transformers modeling_inkling2.py, Apache-2.0: Inkling2BlockAttentionResidual, the decoder layers'
+//! forward, Inkling2RMSNorm). H = 4608, R = the forward's rows, every row independent.
+//!
+//! `mix` (layer ops res.attn_input, res.mlp_input; model op res.final_input):
+//!   sources s_0 .. s_{nb-1} = blocks (bf16 [R, H] each), s_nb = cand (bf16 or fp32 [R, H]); all taken as fp32.
+//!   n_i = s_i * rsqrt(mean_H(s_i^2) + 1e-6)                       (Inkling2UnweightedRMSNorm on fp32: no gain)
+//!   for query j (queries fp32 [nq, H]):  score_i = (q_j . n_i) * H^-0.5,  p = softmax_i(score)
+//!   out[j][r] = sum_i p_i * n_i                                    (fp32 [R, H]; torch SDPA, fp32 throughout)
+//!   attn_input of layer L > 0: blocks = the completed blocks below L, cand = h_in (bf16), nq = 1 (sliding) or 3
+//!     (global: out[0] feeds the q norm, out[1] the k norm, out[2] the v norm). Layer 0 has none (x = h_in).
+//!   mlp_input of layer L: blocks after the boundary push (see `partial`), cand = partial (fp32), nq = 1.
+//!   final_input: the 8 blocks (inputs of layers 0, 6, ..., 42), cand = h_out(47) (bf16), nq = 1.
+//!   Oracle tensors: op.<L>.res.attn_input.out.x0/x1/x2, op.<L>.res.mlp_input.out.x, op.model.res.final_input.out.x
+//!   (inkling2_op_ref.py capture); the layer's h.<L> and final at the end of the chain.
+//!   Kernel (tf_ink2_res_mix_bf16 / _f32, by the candidate's dtype): a CTA a row, 576 threads of 8 columns. Pass 1
+//!   per source: the sum of squares (square, then add), mean as a product with fp32(1/H), rsqrtf, n_i elementwise,
+//!   the nq dots with fp32 FMAs; pass 2 rereads the sources and accumulates p_ji * n_i in source order. Every sum
+//!   is a thread's 8 columns in order, a warp xor tree, then the 18 warps in order: a row's bits do not depend on R.
+//!   Against torch (SDPA's own order): rel 1.4e-7 to 3.2e-7, max abs <= 2.7e-5, 99.97% equal after a bf16 round.
+//!
+//! `norm` (res.attn_norm, res.q_norm / k_norm / v_norm, res.mlp_norm, head.final_norm, the embed norm):
+//!   y = bf16(gain * (x * rsqrt(mean_H(x^2) + 1e-6))), x bf16 or fp32, gain fp32 [H] (stored bf16, converted
+//!   exactly). Implemented on norms.cu's tf_rms_rows (the scaffold's slow path: fp32 math, gain after; a block a
+//!   row, its bits independent of the row count).
+//!
+//! `partial` (res.partial, decoder layer: `residual = hidden_states = conv_out.float()`, then on a non-boundary
+//!   layer `block_residual.float() + hidden_states`):
+//!   out fp32 [R, H] = boundary ? f32(a) : f32(h_in) + f32(a)     (a = the post-attention conv's bf16 output)
+//!   On a boundary layer (L % 6 == 0) the scaffold pushes h_in onto the blocks before mlp_input (a device copy).
+//!
+//! `output` (res.output, `(residual + hidden_states).to(bf16)`):
+//!   out bf16 [R, H] = bf16(partial + f32(mconv))                 (mconv = the post-MLP conv's bf16 output)
+//!   `partial` and `output` are elementwise kernels (tf_ink2_res_partial / _output), bit-equal to torch.
+//!
+//! State: none across tokens; the blocks live with the forward's rows (cuda_state.zig `Act.blocks`).
+//! Test alone: `tf-inkling2-cuda ... --feed <capture> --dump-ops` then `inkling2_compare.py --ops`, or
+//! `inkling2_op_ref.py check` on a --dump-ops dump (see docs in tools/zig/inkling2_op_ref.py).
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+
+const Ctx = ops.Ctx;
+const Mat = ops.Mat;
+const Blocks = ops.Blocks;
+
+pub const eps: f32 = 1e-6;
+/// inkling2_res.cu's row width and threads a row (8 columns a thread).
+pub const width = 4608;
+const mix_threads = width / 8;
+const mix_most_blocks = 8;
+const mix_most_queries = 3;
+const elem_threads = 256;
+
+/// inkling2_res.cu's functions.
+pub const Kernels = struct {
+    g: @import("cuda_kernels.zig").Group("res"),
+    mix_bf16: cuda.Function,
+    mix_f32: cuda.Function,
+    partial_fn: cuda.Function,
+    output_fn: cuda.Function,
+    rank_sum_fn: cuda.Function,
+    rank_sum_rows_fn: cuda.Function,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        var g = try @import("cuda_kernels.zig").Group("res").load(d);
+        errdefer g.unload();
+        return .{
+            .g = g,
+            .mix_bf16 = try g.mod.function("tf_ink2_res_mix_bf16"),
+            .mix_f32 = try g.mod.function("tf_ink2_res_mix_f32"),
+            .partial_fn = try g.mod.function("tf_ink2_res_partial"),
+            .output_fn = try g.mod.function("tf_ink2_res_output"),
+            .rank_sum_fn = try g.mod.function("tf_ink2_res_rank_sum"),
+            .rank_sum_rows_fn = try g.mod.function("tf_ink2_res_rank_sum_rows"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.g.unload();
+    }
+};
+
+/// out[j] fp32 [R, H] for j < nq; see the header. One CTA a row: a row's bits do not depend on R.
+pub fn mix(c: *const Ctx, blocks: Blocks, cand: Mat, queries: u64, nq: usize, out: []const Mat) !void {
+    const R = cand.rows;
+    if (nq == 0 or nq > mix_most_queries or out.len < nq or queries == 0) return error.BadMixShape;
+    if (blocks.count > mix_most_blocks or blocks.hidden != width or (blocks.count > 0 and blocks.rows != R)) return error.BadMixShape;
+    if (blocks.stride % 2 != 0 or blocks.ptr % 16 != 0 or blocks.stride % 16 != 0) return error.Misaligned;
+    if (cand.cols != width or !cand.dense() or (cand.dt != .bf16 and cand.dt != .f32) or cand.ptr % 16 != 0) return error.BadMixShape;
+    for (out[0..nq]) |o| if (!o.is(R, width, .f32) or !o.dense() or o.ptr % 16 != 0) return error.BadMixShape;
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(blocks.ptr);
+    a.add(@as(i64, @intCast(blocks.stride / 2)));
+    a.add(@as(i32, @intCast(blocks.count)));
+    a.add(cand.ptr);
+    a.add(queries);
+    a.add(@as(i32, @intCast(nq)));
+    for (0..mix_most_queries) |j| a.add(if (j < nq) out[j].ptr else @as(u64, 0));
+    a.add(eps);
+    a.add(@as(f32, @floatCast(1.0 / @sqrt(@as(f64, width)))));
+    const f = if (cand.dt == .f32) c.k.res.mix_f32 else c.k.res.mix_bf16;
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = mix_threads } }, c.stream, &a);
+}
+
+/// y bf16 = gain-weighted RMS norm of x (bf16 or fp32).
+pub fn norm(c: *const Ctx, x: Mat, gain: u64, y: Mat) !void {
+    try c.rms(x, gain, y, eps);
+}
+
+/// out fp32 = boundary ? f32(a) : f32(h_in) + f32(a).
+pub fn partial(c: *const Ctx, h_in: Mat, a: Mat, boundary: bool, out: Mat) !void {
+    const R = a.rows;
+    if (!a.is(R, width, .bf16) or !h_in.is(R, width, .bf16) or !out.is(R, width, .f32)) return error.BadResidualShape;
+    if (!a.dense() or !h_in.dense() or !out.dense()) return error.BadResidualShape;
+    try elementwise(c, c.k.res.partial_fn, .{ h_in.ptr, a.ptr, out.ptr, @as(i32, @intFromBool(boundary)) }, R * width);
+}
+
+/// out bf16 = bf16(partial + f32(mconv)).
+pub fn output(c: *const Ctx, partial_: Mat, mconv: Mat, out: Mat) !void {
+    const R = partial_.rows;
+    if (!partial_.is(R, width, .f32) or !mconv.is(R, width, .bf16) or !out.is(R, width, .bf16)) return error.BadResidualShape;
+    if (!partial_.dense() or !mconv.dense() or !out.dense()) return error.BadResidualShape;
+    try elementwise(c, c.k.res.output_fn, .{ partial_.ptr, mconv.ptr, out.ptr }, R * width);
+}
+
+/// W > 1: out bf16 [R, H] = bf16(sum over ranks in rank order of parts[r]), parts fp32 [world][R][H] at `parts`.
+pub fn rankSum(c: *const Ctx, parts: u64, world: usize, out: Mat) !void {
+    const R = out.rows;
+    if (!out.is(R, width, .bf16) or !out.dense() or world == 0) return error.BadResidualShape;
+    try elementwise(c, c.k.res.rank_sum_fn, .{ parts, @as(i32, @intCast(world)), out.ptr }, R * width);
+}
+
+/// rankSum over some rows: out bf16 [n, H] = bf16(sum over ranks in rank order of the fp32 [n, H] rows at
+/// `parts + r * stride` bytes); the same kernel arithmetic as rankSum, so a row's bits are the whole sum's.
+pub fn rankSumRows(c: *const Ctx, parts: u64, world: usize, stride: usize, out: Mat) !void {
+    const R = out.rows;
+    if (!out.is(R, width, .bf16) or !out.dense() or world == 0 or stride % 4 != 0) return error.BadResidualShape;
+    try elementwise(c, c.k.res.rank_sum_rows_fn, .{ parts, @as(i32, @intCast(world)), @as(i64, @intCast(stride / 4)), out.ptr }, R * width);
+}
+
+/// An 8-elements-a-thread kernel over n elements: `args` then n.
+fn elementwise(c: *const Ctx, f: cuda.Function, args: anytype, n: usize) !void {
+    if (n == 0) return;
+    if (n % 8 != 0) return error.BadResidualShape;
+    var a: cuda.Args = .{};
+    inline for (args) |v| a.add(v);
+    a.add(@as(i64, @intCast(n)));
+    const threads = n / 8;
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((threads + elem_threads - 1) / elem_threads) }, .block = .{ .x = elem_threads } }, c.stream, &a);
+}
+
+/// Runs once per loaded layer (cuda_weights.zig `Prepare`): repack what the group's kernels want.
+pub fn prepare(w: *@import("cuda_weights.zig").Weights, l: *@import("cuda_weights.zig").Layer) anyerror!void {
+    _ = .{ w, l };
+}
