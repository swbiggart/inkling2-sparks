diff --git a/zig/src/cuda/mxfp8.zig b/zig/src/cuda/mxfp8.zig
index 7c57aa50dfb9113e15af1bea7262d549f5f9a089..e324676976e9bd07ef45d5b46c8db82dc8d0cdea 100644
--- a/zig/src/cuda/mxfp8.zig
+++ b/zig/src/cuda/mxfp8.zig
@@ -39,3 +39,201 @@ test "every scale byte lands in its independent 32-input group, including padded
     const w = weight(1, 2, n, k);
     try std.testing.expect(w.mode == .mxfp8 and w.npad == 256 and w.scale == 1.0);
 }
+
+/// The value of e4m3 code `c` (sign bit 7, exponent bits 6-3 biased 7, mantissa bits 2-0; 0x7F and 0xFF NaN).
+pub fn e4m3Value(c: u8) f32 {
+    if (c & 0x7F == 0x7F) return std.math.nan(f32);
+    const e: i32 = (c >> 3) & 15;
+    const m: f32 = @floatFromInt(c & 7);
+    const v: f32 = if (e == 0) std.math.ldexp(m, -9) else std.math.ldexp(8.0 + m, e - 10);
+    return if (c & 0x80 != 0) -v else v;
+}
+
+/// The finite positive codes' values, increasing with the code (0 .. 0x7E).
+const e4m3_values: [0x7F]f32 = blk: {
+    @setEvalBranchQuota(10000);
+    var t: [0x7F]f32 = undefined;
+    for (&t, 0..) |*v, c| v.* = e4m3Value(c);
+    break :blk t;
+};
+
+/// x's nearest e4m3 code (ties to the even code), saturating at +-448; x finite.
+pub fn e4m3Round(x: f32) u8 {
+    const a = @abs(x);
+    const sign: u8 = if (x < 0) 0x80 else 0;
+    if (!(a < 448.0)) return sign | 0x7E;
+    // the last code whose value is <= a
+    var lo: u8 = 0;
+    var hi: u8 = 0x7E;
+    while (lo < hi) {
+        const mid: u8 = lo + (hi - lo + 1) / 2;
+        if (e4m3_values[mid] <= a) lo = mid else hi = mid - 1;
+    }
+    const below = e4m3_values[lo];
+    const above = e4m3_values[lo + 1];
+    const c: u8 = if (a - below < above - a) lo else if (a - below > above - a) lo + 1 else if (lo & 1 == 0) lo else lo + 1;
+    return sign | c;
+}
+
+/// bf16 [n, k] (little-endian bytes) to e4m3 codes [n, k] and one UE8M0 scale byte a 32 inputs [n, k/32] (row-major,
+/// packScales' input): the scale is the smallest power of two 2^s with amax / 2^s <= 448 (no input saturates), byte
+/// s + 127 (127: an all-zero group); each code the nearest e4m3 of x / 2^s. Weight-only, for a drafter's projections.
+/// A non-finite input (bf16 infinity or NaN) is refused. Groups are independent: worker threads take contiguous
+/// ranges of them, so every byte equals one serial pass's.
+pub fn quantize(codes: []u8, scales: []u8, w: []const u8, n: usize, k: usize) Error!void {
+    return quantizeOn(std.Thread.getCpuCount() catch 1, codes, scales, w, n, k);
+}
+
+pub const Error = error{NonFiniteMxfp8Input};
+const max_workers = 16;
+
+fn quantizeOn(cpus: usize, codes: []u8, scales: []u8, w: []const u8, n: usize, k: usize) Error!void {
+    std.debug.assert(k % group == 0 and w.len == n * k * 2 and codes.len == n * k and scales.len == n * (k / group));
+    const ng = scales.len;
+    const workers = @min(max_workers, @max(1, cpus), @max(1, ng / 4096));
+    const per = (ng + workers - 1) / workers;
+    var results: [max_workers]Error!void = @splat({});
+    var threads: [max_workers]?std.Thread = @splat(null);
+    for (1..workers) |t| threads[t] = std.Thread.spawn(.{}, run, .{ &results[t], codes, scales, w, @min(ng, t * per), @min(ng, (t + 1) * per) }) catch null;
+    run(&results[0], codes, scales, w, 0, @min(ng, per));
+    for (1..workers) |t| if (threads[t]) |th| th.join() else run(&results[t], codes, scales, w, @min(ng, t * per), @min(ng, (t + 1) * per));
+    for (results[0..workers]) |r| try r;
+}
+
+fn run(out: *Error!void, codes: []u8, scales: []u8, w: []const u8, first: usize, last: usize) void {
+    out.* = groups(codes, scales, w, first, last);
+}
+
+/// Groups [first, last) of the row-major [n, k/32] scale order; group i holds inputs [32 i, 32 i + 32).
+fn groups(codes: []u8, scales: []u8, w: []const u8, first: usize, last: usize) Error!void {
+    for (first..last) |gi| {
+        var amax: f32 = 0;
+        for (0..group) |i| {
+            const bits = std.mem.readInt(u16, w[2 * (gi * group + i) ..][0..2], .little);
+            if (bits & 0x7F80 == 0x7F80) return error.NonFiniteMxfp8Input;
+            amax = @max(amax, @abs(@as(f32, @bitCast(@as(u32, bits) << 16))));
+        }
+        var s: i32 = 0;
+        if (amax > 0) {
+            s = @as(i32, @intFromFloat(@ceil(std.math.log2(amax / 448.0))));
+            while (s < 127 and std.math.ldexp(amax, -s) > 448.0) s += 1;
+            while (s > -127 and std.math.ldexp(amax, -(s - 1)) <= 448.0) s -= 1;
+        }
+        s = std.math.clamp(s, -127, 127);
+        scales[gi] = @intCast(s + 127);
+        const inv = std.math.ldexp(@as(f32, 1.0), -s);
+        for (0..group) |i| {
+            const at = gi * group + i;
+            const bits = std.mem.readInt(u16, w[2 * at ..][0..2], .little);
+            codes[at] = e4m3Round(@as(f32, @bitCast(@as(u32, bits) << 16)) * inv);
+        }
+    }
+}
+
+test "e4m3 round: every finite code is its own value's code, halfway ties go to the even code, saturation at 448" {
+    for (0..0x7F) |c| {
+        const v = e4m3Value(@intCast(c));
+        try std.testing.expectEqual(@as(u8, @intCast(c)), e4m3Round(v));
+        try std.testing.expectEqual(@as(u8, @intCast(c)) | 0x80, e4m3Round(-v) | if (c == 0) @as(u8, 0x80) else 0);
+    }
+    try std.testing.expectEqual(@as(f32, 448), e4m3Value(0x7E));
+    try std.testing.expectEqual(@as(f32, -448), e4m3Value(0xFE));
+    try std.testing.expect(std.math.isNan(e4m3Value(0x7F)) and std.math.isNan(e4m3Value(0xFF)));
+    try std.testing.expectEqual(@as(u8, 0x7E), e4m3Round(1000));
+    // 1.0 is 0x38, 1.125 is 0x39: 1.0625 ties to the even 0x38; 1.1875 (between 0x39 and 0x3A) to 0x3A
+    try std.testing.expectEqual(@as(u8, 0x38), e4m3Round(1.0625));
+    try std.testing.expectEqual(@as(u8, 0x3A), e4m3Round(1.1875));
+}
+
+test "quantize: scales cover each group's largest input, codes within half an e4m3 step, zeros stay zero" {
+    const a = std.testing.allocator;
+    const n = 3;
+    const k = 64;
+    const w = try a.alloc(u8, n * k * 2);
+    defer a.free(w);
+    var prng = std.Random.DefaultPrng.init(5);
+    for (0..n * k) |i| {
+        const x: f32 = if (i / k == 2 and i % k < 32) 0 else (prng.random().float(f32) - 0.5) * 0.08;
+        std.mem.writeInt(u16, w[2 * i ..][0..2], @truncate(@as(u32, @bitCast(x)) >> 16), .little);
+    }
+    const codes = try a.alloc(u8, n * k);
+    defer a.free(codes);
+    const scales = try a.alloc(u8, n * (k / group));
+    defer a.free(scales);
+    try quantize(codes, scales, w, n, k);
+    try std.testing.expectEqual(@as(u8, 127), scales[2 * 2]);
+    for (0..n) |r| for (0..k / group) |g| {
+        const sc = std.math.pow(f32, 2, @as(f32, @floatFromInt(@as(i32, scales[r * 2 + g]) - 127)));
+        var amax: f32 = 0;
+        for (0..group) |i| {
+            const at = r * k + g * group + i;
+            const x: f32 = @bitCast(@as(u32, std.mem.readInt(u16, w[2 * at ..][0..2], .little)) << 16);
+            amax = @max(amax, @abs(x));
+            const back = e4m3Value(codes[at]) * sc;
+            // relative step of e4m3 is 2^-3; half of it, or the subnormal step's half
+            try std.testing.expect(@abs(back - x) <= @max(@abs(x) * 0.0625, sc * std.math.pow(f32, 2, -10)) * 1.0001);
+        }
+        if (amax > 0) {
+            try std.testing.expect(amax / sc <= 448 and amax / sc > 224);
+        }
+    };
+}
+
+test "quantize: worker threads give one serial pass's bytes" {
+    const a = std.testing.allocator;
+    const n = 1000;
+    const k = 512;
+    const w = try a.alloc(u8, n * k * 2);
+    defer a.free(w);
+    var prng = std.Random.DefaultPrng.init(11);
+    for (0..n * k) |i| {
+        const x: f32 = (prng.random().float(f32) - 0.5) * std.math.ldexp(@as(f32, 1.0), @as(i32, @intCast(i / 4096 % 40)) - 30);
+        std.mem.writeInt(u16, w[2 * i ..][0..2], @truncate(@as(u32, @bitCast(x)) >> 16), .little);
+    }
+    const c1 = try a.alloc(u8, n * k);
+    defer a.free(c1);
+    const s1 = try a.alloc(u8, n * (k / group));
+    defer a.free(s1);
+    try quantizeOn(1, c1, s1, w, n, k);
+    for ([_]usize{ 2, 3, 7, 16 }) |cpus| {
+        const c2 = try a.alloc(u8, n * k);
+        defer a.free(c2);
+        const s2 = try a.alloc(u8, n * (k / group));
+        defer a.free(s2);
+        try quantizeOn(cpus, c2, s2, w, n, k);
+        try std.testing.expectEqualSlices(u8, c1, c2);
+        try std.testing.expectEqualSlices(u8, s1, s2);
+    }
+}
+
+test "quantize: infinities and NaNs of either sign are refused, in any worker's range" {
+    const a = std.testing.allocator;
+    const n = 512;
+    const k = 512;
+    const w = try a.alloc(u8, n * k * 2);
+    defer a.free(w);
+    const codes = try a.alloc(u8, n * k);
+    defer a.free(codes);
+    const scales = try a.alloc(u8, n * (k / group));
+    defer a.free(scales);
+    for ([_]u16{ 0x7F80, 0xFF80, 0x7FC0, 0xFFC1, 0x7F81 }) |bad| for ([_]usize{ 0, n * k / 2 + 5, n * k - 1 }) |at| {
+        @memset(w, 0);
+        std.mem.writeInt(u16, w[2 * at ..][0..2], bad, .little);
+        for ([_]usize{ 1, 7 }) |cpus| try std.testing.expectError(error.NonFiniteMxfp8Input, quantizeOn(cpus, codes, scales, w, n, k));
+    };
+    // 8,192 groups: two workers of 4,096 groups, so worker one is a spawned thread; its range holds the only
+    // invalid weight, and its error reaches the caller
+    const ng = n * (k / group);
+    try std.testing.expect(@min(max_workers, ng / 4096) == 2);
+    for ([_]usize{ ng / 2, ng / 2 + 1234, ng - 1 }) |gi| {
+        @memset(w, 0);
+        std.mem.writeInt(u16, w[2 * (gi * group + 17) ..][0..2], 0xFFC0, .little);
+        for ([_]usize{ 2, 16 }) |cpus| try std.testing.expectError(error.NonFiniteMxfp8Input, quantizeOn(cpus, codes, scales, w, n, k));
+    }
+    // the largest finite bf16, (2 - 2^-7) 2^127, is accepted: scale 2^120, code 256 (255 rounded)
+    @memset(w, 0);
+    std.mem.writeInt(u16, w[0..2], 0x7F7F, .little);
+    try quantize(codes, scales, w, n, k);
+    try std.testing.expectEqual(@as(u8, 127 + 120), scales[0]);
+    try std.testing.expectEqual(@as(u8, 0x78), codes[0]);
+}
diff --git a/zig/src/families/inkling2/cuda_argmax_check.zig b/zig/src/families/inkling2/cuda_argmax_check.zig
new file mode 100644
index 0000000000000000000000000000000000000000..0bc0979219cc6f1c6df96e80c5d0054eee85e009
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_argmax_check.zig
@@ -0,0 +1,228 @@
+//! tf-inkling2-decode --exp argmax (rank 0; B2 C4, greedy argmax on the device):
+//!   op check: cuda_head.zig argmax (tf_ink2_head_argmax) against the host's greedy loop (lanes/gpu_rule.zig argmax:
+//!     `best = 0; if (v > row[best]) best = i`) on 10,000 rows of the unpadded vocabulary in batches of 1 to 32 rows:
+//!     random rows, ties of the largest value (the first must win), a NaN at column 0 (it wins), NaNs elsewhere (they
+//!     never win, also where the largest value was), all -inf (0), +inf, -0 against +0, constant rows, the largest
+//!     value last, few distinct values, all NaN.
+//!   tail A/B: verify windows of 1 and 8 rows on slot 0 (forward + head as a captured graph, keep 1 after each, as
+//!     the price table), alternating a head that downloads its fp32 logits and draws on the host (2c's tail) with
+//!     one that downloads only the device's argmax rows (Engine.want_logits false), N times a width: medians of each,
+//!     their paired difference, and the parts (the download, the host draw loop). Every full head's argmax rows must
+//!     equal the host's argmax of its logits.
+const std = @import("std");
+const cuda = @import("cuda");
+const engine = @import("cuda_engine.zig");
+const follow = @import("cuda_follow.zig");
+const head = @import("cuda_head.zig");
+const ops = @import("cuda_ops.zig");
+
+/// The host's greedy draw (lanes/gpu_rule.zig argmax, the lanes' `draw` for a greedy row), the op check's reference.
+pub fn hostArgmax(values: []const f32) u32 {
+    var best: usize = 0;
+    for (values, 0..) |v, i| {
+        if (v > values[best]) best = i;
+    }
+    return @intCast(best);
+}
+
+const rows_total = 10_000;
+const kinds = 13;
+
+/// Row `i` of the op check's rows (kind i % kinds) into `row`.
+fn fill(rng: std.Random, row: []f32, i: usize) void {
+    const U = row.len;
+    const nan = std.math.nan(f32);
+    const inf = std.math.inf(f32);
+    for (row) |*v| v.* = (rng.float(f32) - 0.5) * 60.0; // the softcap's range
+    const k = i % kinds;
+    switch (k) {
+        0 => {}, // random: one largest value (almost surely)
+        1 => { // the largest value again at 1-4 other columns, one of them sometimes column 0
+            const m = hostArgmax(row);
+            for (0..1 + rng.uintLessThan(usize, 4)) |_| row[rng.uintLessThan(usize, U)] = row[m];
+            if (rng.boolean()) row[0] = row[m];
+        },
+        2 => row[0] = nan, // a NaN at column 0 wins
+        3 => { // NaNs at ~1 % of the columns, one where the largest value was, never column 0
+            const m = hostArgmax(row);
+            for (0..U / 100) |_| row[1 + rng.uintLessThan(usize, U - 1)] = nan;
+            if (m != 0) row[m] = nan;
+        },
+        4 => @memset(row, -inf), // all -inf: 0
+        5 => { // all -inf with NaNs past column 0: 0
+            @memset(row, -inf);
+            for (0..16) |_| row[1 + rng.uintLessThan(usize, U - 1)] = nan;
+        },
+        6 => { // +inf at two columns (the first wins), a NaN between them sometimes
+            const a = rng.uintLessThan(usize, U);
+            const b = rng.uintLessThan(usize, U);
+            row[a] = inf;
+            row[b] = inf;
+            if (rng.boolean()) row[(a + b) / 2] = nan;
+        },
+        7 => for (row) |*v| { // -1, -0 and +0 only: the first zero of either sign
+            v.* = switch (rng.uintLessThan(u8, 3)) {
+                0 => -1.0,
+                1 => -0.0,
+                else => 0.0,
+            };
+        },
+        8 => @memset(row, 1.25), // constant: 0
+        9 => row[U - 1] = 31.0, // the largest value in the last column
+        10 => for (row) |*v| { // eight distinct values: many ties
+            v.* = @floatFromInt(rng.uintLessThan(u8, 8));
+        },
+        11 => @memset(row, nan), // all NaN: 0
+        12 => { // the largest value a subnormal against zeros, and NaN past it
+            for (row) |*v| v.* = if (rng.boolean()) 0.0 else -std.math.floatTrueMin(f32);
+            row[rng.uintLessThan(usize, U)] = std.math.floatTrueMin(f32);
+            row[1 + rng.uintLessThan(usize, U - 1)] = nan;
+        },
+        else => unreachable,
+    }
+}
+
+/// The op check on rank 0 (no other rank moves): every row's device argmax equals the host loop's.
+pub fn opCheck(gpa: std.mem.Allocator, e: *engine.Engine) !bool {
+    const U = e.vocab();
+    const n_most = engine.head_rows;
+    const host = try gpa.alloc(f32, n_most * U);
+    defer gpa.free(host);
+    var buf = try cuda.DeviceBuffer.alloc(e.d, n_most * U * 4 + n_most * 4);
+    defer buf.free();
+    const out_ptr = buf.ptr + n_most * U * 4;
+    var prng = std.Random.DefaultPrng.init(0x1c4_a7a3);
+    const rng = prng.random();
+    const c = e.opCtx();
+    const batches = [_]usize{ 32, 1, 8, 7, 3, 32, 2 };
+    var differ: usize = 0;
+    var by_kind: [kinds]usize = @splat(0);
+    var done: usize = 0;
+    var b: usize = 0;
+    while (done < rows_total) : (b += 1) {
+        const n = @min(batches[b % batches.len], rows_total - done);
+        for (0..n) |r| fill(rng, host[r * U ..][0..U], done + r);
+        try buf.upload(0, std.mem.sliceAsBytes(host[0 .. n * U]));
+        try head.argmax(&c, ops.Mat.of(buf.ptr, n, U, .f32), out_ptr);
+        try e.stream.synchronize();
+        var got: [engine.head_rows]u32 = undefined;
+        try cuda.memory.download(e.d, out_ptr, std.mem.sliceAsBytes(got[0..n]));
+        for (0..n) |r| {
+            const want = hostArgmax(host[r * U ..][0..U]);
+            if (got[r] != want) {
+                if (differ < 8) std.debug.print("  argmax row {d} (kind {d}): device {d}, host {d}\n", .{ done + r, (done + r) % kinds, got[r], want });
+                differ += 1;
+            }
+            by_kind[(done + r) % kinds] += 1;
+        }
+        done += n;
+    }
+    // the kernel's time on the stream: 1 and 8 rows of the last batch's columns, 200 launches each
+    var ev: [2]cuda.Event = .{ try cuda.Event.init(e.d, true), try cuda.Event.init(e.d, true) };
+    defer for (&ev) |*x| x.deinit();
+    var us: [2]f64 = undefined;
+    for ([_]usize{ 1, 8 }, &us) |n, *u| {
+        try ev[0].record(e.stream);
+        for (0..200) |_| try head.argmax(&c, ops.Mat.of(buf.ptr, n, U, .f32), out_ptr);
+        try ev[1].record(e.stream);
+        try e.stream.synchronize();
+        u.* = @as(f64, try cuda.Event.elapsedMs(ev[0], ev[1])) * 1000 / 200;
+    }
+    std.debug.print("argmax kernel: {d:.1} us at 1 row, {d:.1} us at 8 rows (200 launches each)\n", .{ us[0], us[1] });
+    const pass = differ == 0;
+    std.debug.print("{s} argmax op check: {d} rows of {d} columns in {d} launches of 1-32 rows, {d} differ from the host's greedy loop (kinds 0-{d}: random, ties, NaN at 0, NaNs elsewhere, all -inf, -inf with NaNs, +inf, -0/+0, constant, last, few values, all NaN, subnormal; {d} rows each at least)\n", .{ if (pass) "PASS" else "FAIL", done, U, b, differ, kinds - 1, std.mem.min(usize, &by_kind) });
+    return pass;
+}
+
+fn ms(ns: u64) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-6;
+}
+
+fn median(xs: []f64) f64 {
+    std.mem.sort(f64, xs, {}, std.sort.asc(f64));
+    const m = xs.len / 2;
+    return if (xs.len % 2 == 1) xs[m] else (xs[m - 1] + xs[m]) / 2;
+}
+
+/// Positions slot 0 takes past its decode for `tail` (a keep of 1 after each window).
+pub fn tailPositions(reps: usize) usize {
+    return 4 * (reps + 1) + 8;
+}
+
+/// The tail A/B (see the header) on slot 0, continuing past its decode (the price table's slot).
+pub fn tail(gpa: std.mem.Allocator, x: follow.Leader, seq: []const u32, reps: usize) !bool {
+    const e = x.e;
+    if (!e.argmax_on) {
+        std.debug.print("argmax tail: TF_INK2_GPU_ARGMAX=0, nothing to compare\n", .{});
+        return true;
+    }
+    const U = e.vocab();
+    const slot: u32 = 0;
+    var pos = e.pos(slot);
+    var rows: [8]u32 = undefined;
+    for (&rows, 0..) |*r, i| r.* = seq[(pos + i) % seq.len];
+    const t = try gpa.alloc(f64, 6 * reps);
+    defer gpa.free(t);
+    var mism: usize = 0;
+    var heads: usize = 0;
+    var ok = true;
+    for ([_]usize{ 1, 8 }) |R| {
+        // warm-up: each kind once (captures the window's graph)
+        for (0..2) |_| {
+            try x.forward(slot, pos, rows[0..R], .{ .lo = 0, .n = R });
+            try x.keep(slot, 1);
+            pos += 1;
+        }
+        const full = t[0..reps];
+        const only = t[reps .. 2 * reps];
+        const dl = t[2 * reps .. 3 * reps];
+        const dl_max = t[3 * reps .. 4 * reps];
+        const draw = t[4 * reps .. 5 * reps];
+        const diff = t[5 * reps .. 6 * reps];
+        for (0..reps) |i| {
+            for (0..2) |j| {
+                const want = (i + j) % 2 == 0; // alternate which comes first
+                const c0 = e.counts;
+                e.want_logits = want;
+                defer e.want_logits = true;
+                const t0 = std.Io.Clock.awake.now(e.io).toNanoseconds();
+                try x.forward(slot, pos, rows[0..R], .{ .lo = 0, .n = R });
+                var tok: [8]u32 = undefined;
+                if (want) {
+                    const lg = try e.logits();
+                    const d0 = std.Io.Clock.awake.now(e.io).toNanoseconds();
+                    for (0..R) |r| tok[r] = hostArgmax(lg[r * U ..][0..U]);
+                    draw[i] = ms(@intCast(std.Io.Clock.awake.now(e.io).toNanoseconds() - d0));
+                    const dev = try e.argmaxRows();
+                    for (0..R) |r| mism += @intFromBool(dev[r] != tok[r]);
+                    heads += R;
+                } else @memcpy(tok[0..R], (try e.argmaxRows())[0..R]);
+                const dt = ms(@intCast(std.Io.Clock.awake.now(e.io).toNanoseconds() - t0));
+                const k: usize = @intFromBool(want);
+                if (want) full[i] = dt else only[i] = dt;
+                const dns = e.counts.head_ns[k] - c0.head_ns[k];
+                if (want) dl[i] = ms(dns) else dl_max[i] = ms(dns);
+                try x.keep(slot, 1);
+                pos += 1;
+            }
+            diff[i] = full[i] - only[i];
+        }
+        std.debug.print("argmax tail, {d} row(s), {d} pairs (median ms): forward+head+draw with the logits {d:.3} (download {d:.3}, host draws {d:.3}), argmax rows only {d:.3} (download {d:.3}); saved {d:.3} (paired median)\n", .{ R, reps, median(full), median(dl), median(draw), median(only), median(dl_max), median(diff) });
+    }
+    ok = mism == 0;
+    std.debug.print("{s} argmax tail: the device's argmax equals the host's on every full head's rows ({d} rows, {d} differ)\n", .{ if (ok) "PASS" else "FAIL", heads, mism });
+    return ok;
+}
+
+test "inkling2 argmax check: the host's greedy loop on the rows the device must match" {
+    const nan = std.math.nan(f32);
+    const inf = std.math.inf(f32);
+    try std.testing.expectEqual(@as(u32, 0), hostArgmax(&.{ nan, 5, 7 })); // a NaN at column 0 wins
+    try std.testing.expectEqual(@as(u32, 2), hostArgmax(&.{ 1, nan, 7, nan })); // NaNs elsewhere never do
+    try std.testing.expectEqual(@as(u32, 0), hostArgmax(&.{ -inf, -inf, nan })); // all -inf: 0
+    try std.testing.expectEqual(@as(u32, 1), hostArgmax(&.{ -1, -0.0, 0.0 })); // -0 equals +0: the first
+    try std.testing.expectEqual(@as(u32, 1), hostArgmax(&.{ 3, 9, 9, 9 })); // ties: the first
+    var prng = std.Random.DefaultPrng.init(1);
+    var row: [64]f32 = undefined;
+    for (0..kinds) |k| fill(prng.random(), &row, k); // every kind fills a row
+}
