+    var wk = try Work.init(gpa, 64);
+    defer wk.deinit(gpa);
+    const buf = try gpa.alloc(u16, d + 2 * 64 * d + d_rel);
+    defer gpa.free(buf);
+    var q64: [d]f64 = undefined;
+    const kv64 = try gpa.alloc(f64, 2 * 64 * d);
+    defer gpa.free(kv64);
