+//! tf-inkling2-attn --op-check --forms kx, --bench --forms kx[,v01], --limb: the kx core's forms (cuda_attn.zig
+//! `coreKx`, inkling2_kx_fp32.cuh) on pseudo-random inputs at a rank's head shape.
+//!
+//! --op-check --forms kx, for each S of --kx-s: every forward (kind x position x rows) through every variant, each
+//! global one also on the pool's pages (NaN until written, page ids shuffled, the table's unused entries on a NaN scrub
+//! page), and every row of every run against `kx-solo` (the row alone at its own position, R = 1, default dispatch):
+//!   kx           the forward's default dispatch
+//!   kx-tile      C 1 (sliding: kx-tile; global: kx-split C 1 or kx-split-walk)
+//!   kx-dec2/4    C 2 / 4
+//!   kx-split     global, kx-split wherever its scratch fits (G 128); -g7 (7 splits a grid column: many rounds a
+//!                CTA), -c1, -c4
+//!   kx-walk      global, kx-split-walk at every R
+//!   kx-devpos    eager launches of the captured plan (the position read on the device, the grid over the slot's
+//!                splits), up to 8 rows; -g7, -c1, -unpack (was `kx-graph`: no CUDA graph is involved)
+//!   kx-graph     the captured plan as the engine runs it (Engine.graphStep): `core` captured from the stream into a
+//!                CUDA graph and instantiated once a (variant, kind, keys, R), its inputs and output at fixed
+//!                addresses, then replayed at every later forward's position (the inputs copied in and the position
+//!                written on the stream first, as a step's header and projections land before its replay); -g7, -c1,
+//!                -unpack
+//!   kx-nosplit   global keys through the tile kernel (window 0, no split): only where pos0 + R <= S
+//!   kx-unpack    the default dispatch with GQA packing off (the query heads of a kv head in separate CTAs);
+//!                kx-pack: packing on at every R
+//!   e2614fe      kortexa-ai e2614fe's tf_ik_attention (ring and contiguous keys): rows equal, information only
+//! Every row byte-equal (NaN canonical), the pool's other runs still NaN afterwards, and `attn exceptions: rows 0`
+//! (the NaN pool and the scrub page are never loaded). Inputs are per position (a row sees the same q', rel', sink and
+//! gate in every forward), held only at the positions the forwards read.
+//!
+//! Then the graph walks (`graphWalk`, inputs of their own): each kx-graph variant at rows 1 and 8 captured once and
+//! replayed at every position across tile, page, split and grid-wrap boundaries (global; sliding: the window's edge and
+//! the ring's wraps), on the contiguous keys, the pool's pages, a ring view of a run of pages (one row, as
+//! State.kvFor gives a one-row forward: recorded by Ctx.launchOn into a RunLog, its nodes found and repointed after
+//! the run moves as cuda_engine.zig's Graph.follow does) and a page table that moves; every replay's rows against
+//! kx-solo and against an eager launch of the same form. Planted controls that must fail: a replay with a stale
+//! device position, with the K/V pointers left on the old run, and with the page table left on the old pages.
+//!
+//! --bench --forms kx[,v01]: `core` alone, the variants alternated in rounds; a time is a layer's (global layers as
+//! a served step: `--layers` layers a call, each its own pages), median, p10 and p90 over the rounds. Global layers:
+//! captured and eager pos-pointer (R <= 8) or eager, v01 against kx at each --kx-s; sliding layers: v01 eager, and v01
+//! and kx at each --kx-c captured and eager pos-pointer (R <= 8) or eager. `captured`: launches of a CUDA graph holding
+//! `graph_calls` of the cell's calls (captured once, so its launch is spread as in a step's graph); `eager pos-pointer`:
+//! the same calls launched eagerly with the position read on the device (what this column measured before).
+//!
+//! --limb: planted inputs in a 16-row block (cases L1-L7) on kx's forms and on the e2614fe control.
+const std = @import("std");
+const cuda = @import("cuda");
+const ic = @import("inkling2_cuda");
+const ck = @import("cuda_attn_check.zig");
+
+const attn = ic.attn;
+const Mat = ic.ops.Mat;
+const D = ic.weights.head_dim;
+const dr = ic.weights.d_rel;
+const Kind = ck.Kind;
+const Opts = ck.Opts;
+
+/// The positions the forwards read, merged into ranges and packed: row `at[i] + pos - lo[i]` holds position pos.
+const Rows = struct {
+    lo: []usize,
+    hi: []usize,
+    at: []usize,
+    total: usize,
+
+    fn init(a: std.mem.Allocator, positions: []const usize, most: usize, P: usize) !Rows {
+        const sorted = try a.dupe(usize, positions);
+        std.mem.sort(usize, sorted, {}, std.sort.asc(usize));
+        var lo: std.ArrayList(usize) = .empty;
+        var hi: std.ArrayList(usize) = .empty;
+        for (sorted) |p0| {
+            const end = @min(P, p0 + most);
+            if (hi.items.len > 0 and p0 <= hi.items[hi.items.len - 1]) {
+                hi.items[hi.items.len - 1] = @max(hi.items[hi.items.len - 1], end);
+            } else {
+                try lo.append(a, p0);
+                try hi.append(a, end);
+            }
+        }
+        const at = try a.alloc(usize, lo.items.len);
+        var total: usize = 0;
+        for (lo.items, hi.items, at) |l, h, *x| {
+            x.* = total;
+            total += h - l;
+        }
+        return .{ .lo = lo.items, .hi = hi.items, .at = at, .total = total };
+    }
+
+    fn row(r: Rows, pos: usize) usize {
+        for (r.lo, r.hi, r.at) |l, h, x| if (pos >= l and pos < h) return x + pos - l;
+        unreachable;
+    }
+};
+
+/// A forward's per-row inputs: q', rel', sink and gate.
+const In = struct {
+    q: Mat,
+    rel: Mat,
+    sink: Mat,
+    gate: Mat,
+
+    fn slice(i: In, r: usize, R: usize) In {
+        return .{ .q = i.q.slice(r, R), .rel = i.rel.slice(r, R), .sink = i.sink.slice(r, R), .gate = i.gate.slice(r, R) };
+    }
+};
+
+/// The device state of a check or bench: the op-check tool's buffers and pool (cuda_attn_check.zig), the packed
+/// per-position inputs.
+const Env = struct {
+    x: ck.Ctx,
+    rows: Rows,
+    q: Mat,
+    rel: Mat,
+    sink: Mat,
+    gate: Mat,
+
+    fn kvOf(e: *const Env, kind: Kind, pg: bool) attn.Kv {
+        if (kind == .global) return if (pg) e.x.kvp else .{ .k = e.x.b.k, .v = e.x.b.v, .slots = e.x.context, .heads = e.x.l.hk, .window = 0 };
+        return .{ .k = e.x.b.k, .v = e.x.b.v, .slots = attn.window - 1 + ic.engine.prompt_rows, .heads = e.x.l.hk, .window = attn.window };
+    }
+
+    /// The packed inputs of R rows from pos0.
+    fn inputs(e: *const Env, pos0: usize, R: usize) In {
+        const all: In = .{ .q = e.q, .rel = e.rel, .sink = e.sink, .gate = e.gate };
+        return all.slice(e.rows.row(pos0), R);
+    }
+
+    /// `core` for R rows at pos0 (form, kx options; `devpos`: the captured plan launched eagerly, the position read
+    /// on the device: after setPos(pos0) or devPos(pos0)).
+    fn core(e: *const Env, form: attn.Form, opt: attn.KxOpt, devpos: bool, kv: attn.Kv, global: bool, pos0: usize, R: usize, out: Mat) !void {
+        try e.coreIn(form, opt, devpos, kv, global, pos0, e.inputs(pos0, R), out.slice(0, R));
+    }
+
+    /// `core` on the inputs `in` (R = in.q.rows) into `out`.
+    fn coreIn(e: *const Env, form: attn.Form, opt: attn.KxOpt, devpos: bool, kv: attn.Kv, global: bool, pos0: usize, in: In, out: Mat) !void {
+        const k = &e.x.k.attn;
+        k.form = form;
+        k.kxo = opt;
+        k.rows = attn.max_rows;
+        k.grid = attn.grid_splits;
+        k.fold_min = attn.fold_splits;
+        e.x.l.global = global;
+        const dev: ?attn.Dev = if (devpos) .{ .posp = e.x.b.posp, .positions = e.x.context } else null;
+        e.x.scratch.reset();
+        try attn.core(&e.x.c, e.x.l, pos0, dev, in.q, in.rel, in.sink, in.gate, kv, out);
+    }
+
+    /// The device position pos0, written on the stream (it lands before the stream's next launch, as a step's header
+    /// copy lands before its replay).
+    fn devPos(e: *const Env, pos0: usize) !void {
+        const view: cuda.DeviceBuffer = .{ .d = e.x.c.d, .ptr = e.x.b.posp, .len = 4, .borrowed = true };
+        try view.fill32(@intCast(pos0), e.x.c.stream.handle);
+    }
+
+    /// e2614fe's tf_ik_attention on contiguous or ring keys (the bias table from tf_kx_relative).
+    fn control(e: *const Env, kv: attn.Kv, global: bool, pos0: usize, R: usize, out: Mat) !void {
+        e.x.l.global = global;
+        e.x.scratch.reset();
+        const r = e.rows.row(pos0);
+        const bias = try e.x.c.tmp(attn.kxBiasBytes(R, e.x.l.hq));
+        try attn.kxRelative(&e.x.c, e.x.l, e.rel.slice(r, R), bias);
+        try attn.kxControl(&e.x.c, e.x.l, pos0, e.q.slice(r, R), bias, e.sink.slice(r, R), e.gate.slice(r, R), kv, out.slice(0, R));
+    }
+
+    fn sync(e: *const Env) !void {
+        try e.x.c.stream.synchronize();
+    }
+
+    fn download(e: *const Env, m: Mat, R: usize, out: []u8) !void {
+        try cuda.memory.download(e.x.c.d, m.ptr, out[0 .. R * m.cols * 2]);
+    }
+};
+
+/// What a run of the tool holds alive (freed by deinit).
+const Own = struct {
+    driver: cuda.Driver,
+    ctx: cuda.Context,
+    stream: cuda.Stream,
+    k: ic.kernels.Kernels,
+    gemms: ic.ops.Gemms,
+    scratch: ic.ops.Scratch,
+    b: ck.Bufs = .{},
+    l: ic.weights.Layer,
+    pool: ?ck.Pool = null,
+
+    fn deinit(o: *Own, gpa: std.mem.Allocator) void {
+        if (o.pool) |pl| gpa.free(pl.table);
+        o.b.deinit(gpa);
+        o.scratch.deinit();
+        o.gemms.deinit();
+        o.k.unload();
+        o.stream.deinit();
+        o.ctx.deinit();
+        o.driver.close();
+    }
+};
+
+/// The op scratch the variants take at this shape: kx's need at each S (eager and captured), kx-split forced up to
+/// its cap, and v0.1's need (bench).
+fn scratchBytes(k: *ic.kernels.Kernels, o: Opts, most: usize) usize {
+    var need: usize = attn.kx_split_cap + attn.kxBiasBytes(most, o.hq);
+    for (o.kx_s) |s| need = @max(need, attn.kxNeed(.{ .s = s, .g = o.kx_g }, o.hq, o.context, @max(most, 1), attn.max_rows));
+    if (o.v01 and o.bench) {
+        const form = k.attn.form;
+        k.attn.form = .v01;
+        k.attn.fold_min = 0;
+        need = @max(need, attn.scratchNeed(&k.attn, o.hq, o.hk, o.context, @max(most, 1), attn.max_rows));
+        k.attn.fold_min = attn.fold_splits;
+        k.attn.form = form;
+    }
+    return need;
+}
+
+/// The packed inputs at `positions` (each the `most` positions from it) into env: rows, q', rel', sink, gate.
+fn makeInputs(gpa: std.mem.Allocator, a: std.mem.Allocator, b: *ck.Bufs, d: *const cuda.Driver, env: *Env, o: Opts, positions: []const usize, most: usize, rng: std.Random) !void {
+    const rows = try Rows.init(a, positions, most, o.context);
+    const nr = @max(rows.total, 1);
+    env.rows = rows;
+    env.q = Mat.of(try b.zeroed(gpa, d, nr * o.hq * D * 2), nr, o.hq * D, .bf16);
+    env.rel = Mat.of(try b.zeroed(gpa, d, nr * o.hq * dr * 2), nr, o.hq * dr, .bf16);
+    env.sink = Mat.of(try b.zeroed(gpa, d, nr * o.hq * 2), nr, o.hq, .bf16);
+    env.gate = Mat.of(try b.zeroed(gpa, d, nr * o.hq * D * 2), nr, o.hq * D, .bf16);
+    // the same generator use as cuda_attn_check.zig's fillInputs, range by range
+    for (rows.lo, rows.hi, rows.at) |lo, hi, at| {
+        const n = hi - lo;
+        try ck.Bufs.randomInto(gpa, d, rng, env.q.row(at), n * o.hq * D, 1.5);
+        try ck.Bufs.randomInto(gpa, d, rng, env.rel.row(at), n * o.hq * dr, 1.0);
+        try ck.Bufs.randomInto(gpa, d, rng, env.sink.row(at), n * o.hq, 3.0);
+        try ck.Bufs.randomInto(gpa, d, rng, env.gate.row(at), n * o.hq * D, 3.0);
+    }
+}
+
+/// Loads the kernels, the caches (keys and values at every position), the pool (global layers) and the packed inputs.
+fn setup(gpa: std.mem.Allocator, a: std.mem.Allocator, own: *Own, env: *Env, o: Opts, positions: []const usize, most: usize, rng: std.Random) !void {
+    own.driver = try cuda.Driver.open();
+    errdefer own.driver.close();
+    own.ctx = try cuda.Context.init(&own.driver, 0);
+    errdefer own.ctx.deinit();
+    own.stream = try cuda.Stream.init(&own.driver, true);
+    errdefer own.stream.deinit();
+    own.k = try ic.kernels.Kernels.load(&own.driver);
+    errdefer own.k.unload();
+    if (own.k.attn.kx == null) return error.KxNotBuilt;
+    own.gemms = try ic.ops.Gemms.init(gpa, &own.driver);
+    errdefer own.gemms.deinit();
+    own.scratch = try ic.ops.Scratch.init(&own.driver, scratchBytes(&own.k, o, most) + (16 << 20));
+    errdefer own.scratch.deinit();
+    own.b = .{};
+    own.pool = null;
+    const d = &own.driver;
+    const b = &own.b;
+    const P = o.context;
+    try makeInputs(gpa, a, b, d, env, o, positions, most, rng);
+    b.proj = try b.random(gpa, d, rng, dr * attn.rel_extent, 1.0);
+    b.k = try b.random(gpa, d, rng, P * o.hk * D, 1.5);
+    b.v = try b.random(gpa, d, rng, P * o.hk * D, 2.0);
+    b.posp = try b.zeroed(gpa, d, 256);
+    own.l = .{ .index = 0, .global = false, .boundary = false, .hq = @intCast(o.hq), .hk = @intCast(o.hk), .nq = 1, .experts = .{ .format = .nvfp4, .lo = 0, .hi = 0 } };
+    own.l.rel_proj = b.proj;
+    env.x = .{ .c = .{ .d = d, .stream = own.stream, .k = &own.k, .gemms = &own.gemms, .scratch = &own.scratch }, .k = &own.k, .scratch = &own.scratch, .b = b, .l = &own.l, .kv = undefined, .context = P, .grid = attn.grid_splits };
+}
+
+/// How a variant runs: eager launches; eager launches of the captured plan, the position read on the device
+/// (`devpos`); or a CUDA graph of the captured plan, replayed (`graph`).
+const Mode = enum { eager, devpos, graph };
+
+const Var = struct {
+    name: []const u8,
+    opt: attn.KxOpt,
+    mode: Mode = .eager,
+    global_only: bool = false,
+    /// compared only where the forward's keys lie in one split (kx-nosplit; global: pos0 + R <= S)
+    nosplit: bool = false,
+};
+
+fn variants(s: usize, g: usize) [n_var]Var {
+    const first = [_]Var{
+        .{ .name = "kx", .opt = .{ .s = s, .g = g } },
+        .{ .name = "kx-tile", .opt = .{ .s = s, .g = g, .c = 1 } },
+        .{ .name = "kx-dec2", .opt = .{ .s = s, .g = g, .c = 2 } },
+        .{ .name = "kx-dec4", .opt = .{ .s = s, .g = g, .c = 4 } },
+        .{ .name = "kx-split", .opt = .{ .s = s, .g = g, .global = .split } },
+        .{ .name = "kx-split-g7", .opt = .{ .s = s, .g = 7, .global = .split } },
+        .{ .name = "kx-split-c1", .opt = .{ .s = s, .g = g, .c = 1, .global = .split } },
+        .{ .name = "kx-split-c4", .opt = .{ .s = s, .g = g, .c = 4, .global = .split } },
+        .{ .name = "kx-walk", .opt = .{ .s = s, .g = g, .global = .walk } },
+        .{ .name = "kx-devpos", .opt = .{ .s = s, .g = g }, .mode = .devpos },
+        .{ .name = "kx-devpos-g7", .opt = .{ .s = s, .g = 7 }, .mode = .devpos },
+        .{ .name = "kx-devpos-c1", .opt = .{ .s = s, .g = g, .c = 1 }, .mode = .devpos },
+        .{ .name = "kx-nosplit", .opt = .{ .s = s, .g = g, .global = .tile }, .nosplit = true },
+        .{ .name = "kx-unpack", .opt = .{ .s = s, .g = g, .pack = false } },
+        .{ .name = "kx-pack", .opt = .{ .s = s, .g = g, .pack = true } },
+        .{ .name = "kx-devpos-unpack", .opt = .{ .s = s, .g = g, .pack = false }, .mode = .devpos },
+    };
+    return first ++ graphVariants(s, g);
+}
+
+/// The engine's captured forms, replayed from CUDA graphs: the default dispatch (Engine.graphStep's), a 7-split grid
+/// (many rounds a CTA column), C 1, GQA packing off.
+fn graphVariants(s: usize, g: usize) [n_graph]Var {
+    return .{
+        .{ .name = "kx-graph", .opt = .{ .s = s, .g = g }, .mode = .graph },
+        .{ .name = "kx-graph-g7", .opt = .{ .s = s, .g = 7 }, .mode = .graph },
+        .{ .name = "kx-graph-c1", .opt = .{ .s = s, .g = g, .c = 1 }, .mode = .graph },
+        .{ .name = "kx-graph-unpack", .opt = .{ .s = s, .g = g, .pack = false }, .mode = .graph },
+    };
+}
+const n_graph = 4;
+const n_var = 16 + n_graph;
+
+/// A plan as text: its kx form, C, S, span and grid.
+fn planText(buf: []u8, p: attn.Plan) []const u8 {
+    const pk: []const u8 = if (p.pack) " pk" else "";
+    return switch (p.kx) {
+        .tile => std.fmt.bufPrint(buf, "{s} C{d}{s}", .{ if (p.c == 1) "kx-tile" else "kx-dec", p.c, pk }) catch "kx-tile",
+        .split => std.fmt.bufPrint(buf, "kx-split S={d} C{d} span {d} grid {d}{s}", .{ p.s, p.c, p.span, p.grid, pk }) catch "kx-split",
+        .walk => std.fmt.bufPrint(buf, "kx-split-walk S={d} span {d}{s}", .{ p.s, p.span, pk }) catch "kx-split-walk",
+        .none => @tagName(p.form),
+    };
+}
+
+const Counts = struct { tile: usize = 0, dec: usize = 0, split: usize = 0, walk: usize = 0 };
+
+/// tf-inkling2-attn --op-check --forms kx / --bench --forms kx.
+pub fn run(gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    const rl = o.rows orelse if (o.bench) &[_]usize{ 1, 2, 3, 4, 5, 6, 7, 8 } else &[_]usize{ 1, 2, 3, 4, 5, 6, 7, 8, 16, 2048 };
+    var most: usize = 1;
+    for (rl) |R| most = @max(most, R);
+    var prng = std.Random.DefaultPrng.init(o.seed);
+    const rng = prng.random();
+    var own: Own = undefined;
+    var env: Env = undefined;
+    try setup(gpa, a, &own, &env, o, o.positions, most, rng);
+    defer own.deinit(gpa);
+    const global = std.mem.indexOfScalar(Kind, o.kinds, .global) != null;
+    var failed: usize = 0;
+    if (global) {
+        own.pool = try ck.makePool(gpa, &own.driver, rng, &env.x, o);
+        if (!o.bench) failed += try ck.checkPool(gpa, &own.driver, &env.x, o, own.pool.?);
+    }
+    var cb: [160]u8 = undefined;
+    own.k.attn.kxo = .{ .s = o.kx_s[0], .g = o.kx_g };
+    own.k.attn.form = .kx;
+    std.debug.print("{s}\n", .{own.k.attn.census(&cb)});
+    if (o.bench) {
+        try bench(gpa, io, &env, o, rl, own.pool);
+        own.k.attn.printExceptions(&own.driver);
+        return 0;
+    }
+    var rig = try Rig.init(gpa, a, &own, &env, o);
+    defer rig.deinit(gpa);
+    for (o.kx_s) |s| failed += try opCheck(gpa, &env, o, rl, most, s, &rig);
+    if (global) failed += try ck.checkPool(gpa, &own.driver, &env.x, o, own.pool.?);
+    own.k.attn.printExceptions(&own.driver);
+    return if (failed == 0) 0 else 1;
+}
+
+/// The kx matrix at one S, then its graph walks: returns 1 when any row of any run differs from its kx-solo row, or
+/// a walk fails (a replay differs from kx-solo or from the eager launch of its form, or a control does not fail).
+fn opCheck(gpa: std.mem.Allocator, env: *Env, o: Opts, rl: []const usize, most: usize, s: usize, rig: *Rig) !usize {
+    const vs = variants(s, o.kx_g);
+    const row_bytes = o.hq * D * 2;
+    const nout = 2 * vs.len + 2;
+    var bufs: [2 * n_var + 2]Mat = undefined;
+    var own_bufs: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    defer {
+        for (own_bufs.items) |*b| b.free();
+        own_bufs.deinit(gpa);
+    }
+    for (bufs[0..nout]) |*m| {
+        var b = try cuda.DeviceBuffer.alloc(env.x.c.d, most * row_bytes);
+        errdefer b.free();
+        try own_bufs.append(gpa, b);
+        m.* = Mat.of(b.ptr, most, o.hq * D, .bf16);
+    }
+    const solo_m = bufs[nout - 2];
+    const ctl_m = bufs[nout - 1];
+    const host = try gpa.alloc(u8, nout * most * row_bytes);
+    defer gpa.free(host);
+    var solo: std.AutoHashMapUnmanaged(usize, []u8) = .empty;
+    defer {
+        var it = solo.valueIterator();
+        while (it.next()) |v| gpa.free(v.*);
+        solo.deinit(gpa);
+    }
+    // the kx-graph variants' graphs: one a (variant, keys, R) of a kind, captured at its first forward
+    var caps: std.AutoHashMapUnmanaged(usize, Cap) = .empty;
+    defer {
+        dropCaps(gpa, &caps);
+        caps.deinit(gpa);
+    }
+    var g_caps: usize = 0;
+    var g_nodes: usize = 0;
+    var g_replays: usize = 0;
+    var g_moved: usize = 0;
+    var forwards: usize = 0;
+    var runs: usize = 0;
+    var paged_runs: usize = 0;
+    var differ: usize = 0;
+    var ctl_eq: usize = 0;
+    var ctl_rows: usize = 0;
+    var cnt: Counts = .{};
+    const P = env.x.context;
+    // a sliding row at p <= window - 1 (window start 0) has a global row's bytes at S = kx_sliding_split
+    var low: std.AutoHashMapUnmanaged(usize, []u8) = .empty;
+    defer {
+        var it = low.valueIterator();
+        while (it.next()) |v| gpa.free(v.*);
+        low.deinit(gpa);
+    }
+    var cross_rows: usize = 0;
+    var cross_eq: usize = 0;
+    for (o.kinds) |kind| {
+        {
+            // the sliding rows kept for the cross-check (the solo rows of the kind before this one)
+            var it = solo.iterator();
+            while (it.next()) |x| {
+                if (kind == .global and x.key_ptr.* <= attn.window - 1 and !low.contains(x.key_ptr.*)) try low.put(gpa, x.key_ptr.*, x.value_ptr.*) else gpa.free(x.value_ptr.*);
+            }
+            solo.clearRetainingCapacity();
+        }
+        dropCaps(gpa, &caps);
+        const glob = kind == .global;
+        for (o.positions) |pos0| for (rl) |R| {
+            if (pos0 + R > P) continue;
+            // the solo rows this forward needs that are not yet held: R = 1 forwards, default dispatch
+            var t0: usize = 0;
+            while (t0 < R) {
+                var n: usize = 0;
+                while (t0 + n < R and n < most and !solo.contains(pos0 + t0 + n)) : (n += 1) {
+                    try env.core(.kx, .{ .s = s, .g = o.kx_g }, false, env.kvOf(kind, false), glob, pos0 + t0 + n, 1, solo_m.slice(n, 1));
+                }
+                if (n == 0) {
+                    t0 += 1;
+                    continue;
+                }
+                try env.sync();
+                const tmp = try gpa.alloc(u8, n * row_bytes);
+                defer gpa.free(tmp);
+                try cuda.memory.download(env.x.c.d, solo_m.ptr, tmp);
+                for (0..n) |i| try solo.put(gpa, pos0 + t0 + i, try gpa.dupe(u8, tmp[i * row_bytes ..][0..row_bytes]));
+                t0 += n;
+            }
+            // the variants (each global one also paged)
+            var list: [2 * n_var]struct { v: Var, vi: usize, pg: bool } = undefined;
+            var nl: usize = 0;
+            for (vs, 0..) |v, vi| {
+                if (v.global_only and !glob) continue;
+                if (v.mode != .eager and R > attn.max_rows) continue;
+                if (v.nosplit and (if (glob) pos0 + R > s else env.kvOf(kind, false).lo(pos0) / attn.kx_sliding_split != (pos0 + R - 1) / attn.kx_sliding_split)) continue;
+                for (0..@as(usize, if (glob) 2 else 1)) |pg| {
+                    list[nl] = .{ .v = v, .vi = vi, .pg = pg == 1 };
+                    nl += 1;
+                }
+            }
+            try env.sync();
+            try env.x.setPos(pos0);
+            for (list[0..nl], 0..) |e, j| {
+                const kv = env.kvOf(kind, e.pg);
+                if (e.v.mode == .graph) {
+                    const key = (2 * e.vi + @intFromBool(e.pg)) * (attn.max_rows + 1) + R;
+                    const gop = try caps.getOrPut(gpa, key);
+                    if (!gop.found_existing) {
+                        gop.value_ptr.* = capture(gpa, env, rig.stage, e.v.opt, kv, glob, pos0, R) catch |err| {
+                            _ = caps.remove(key);
+                            return err;
+                        };
+                        g_caps += 1;
+                        g_nodes += gop.value_ptr.nodes;
+                    }
+                    const cp = gop.value_ptr;
+                    try replay(env, cp, rig.stage, env.inputs(pos0, R), pos0);
+                    try env.x.c.copy(bufs[j].ptr, rig.stage.out.ptr, R * row_bytes);
+                    g_replays += 1;
+                    g_moved += @intFromBool(cp.pos != pos0);
+                } else try env.core(.kx, e.v.opt, e.v.mode == .devpos, kv, glob, pos0, R, bufs[j]);
+                const p = attn.plan(&env.x.k.attn, R, pos0, if (e.v.mode != .eager) attn.Dev{ .posp = 1, .positions = P } else null, kv, o.hq, o.hk);
+                switch (p.kx) {
+                    .tile => if (p.c == 1) {
+                        cnt.tile += 1;
+                    } else {
+                        cnt.dec += 1;
+                    },
+                    .split => cnt.split += 1,
+                    .walk => cnt.walk += 1,
+                    .none => {},
+                }
+                if (e.pg) paged_runs += 1;
+            }
+            try env.control(env.kvOf(kind, false), glob, pos0, R, ctl_m);
+            try env.sync();
+            for (0..nl) |j| try env.download(bufs[j], R, host[j * most * row_bytes ..]);
+            try env.download(ctl_m, R, host[(nout - 1) * most * row_bytes ..]);
+            var bad: usize = 0;
+            for (list[0..nl], 0..) |e, j| {
+                runs += 1;
+                for (0..R) |t| {
+                    const want = solo.get(pos0 + t).?;
+                    if (!std.mem.eql(u8, want, host[(j * most + t) * row_bytes ..][0..row_bytes])) {
+                        if (bad < 4) std.debug.print("  DIFFER S={d} {t} pos0 {d} rows {d}: {s}{s} row {d} against kx-solo\n", .{ s, kind, pos0, R, e.v.name, if (e.pg) " paged" else "", t });
+                        bad += 1;
+                    }
+                }
+            }
+            // e2614fe (information): kx's bits wherever its exception path and the merge do not enter
+            for (0..R) |t| {
+                ctl_rows += 1;
+                ctl_eq += @intFromBool(std.mem.eql(u8, solo.get(pos0 + t).?, host[((nout - 1) * most + t) * row_bytes ..][0..row_bytes]));
+            }
+            var pb: [96]u8 = undefined;
+            env.x.k.attn.form = .kx;
+            env.x.k.attn.kxo = .{ .s = s, .g = o.kx_g };
+            std.debug.print("FORM S={d} {t} pos0 {d} rows {d}: {s}; {d} runs, {d} rows differ\n", .{ s, kind, pos0, R, planText(&pb, attn.plan(&env.x.k.attn, R, pos0, null, env.kvOf(kind, false), o.hq, o.hk)), nl, bad });
+            forwards += 1;
+            if (bad > 0) differ += 1;
+        };
+        try printSoloDigest(gpa, s, kind, &solo);
+        if (kind == .global and s == attn.kx_sliding_split) {
+            var it = low.iterator();
+            while (it.next()) |x| if (solo.get(x.key_ptr.*)) |g| {
+                cross_rows += 1;
+                if (std.mem.eql(u8, g, x.value_ptr.*)) cross_eq += 1 else if (cross_rows - cross_eq <= 4) std.debug.print("  DIFFER S={d} sliding p {d} against global (window start 0)\n", .{ s, x.key_ptr.* });
+            };
+        }
+    }
+    if (s == attn.kx_sliding_split and cross_rows > 0) {
+        std.debug.print("{s} cross-check S={d}: sliding rows at p <= {d} against global rows: {d}/{d} equal\n", .{ if (cross_eq == cross_rows) "PASS" else "FAIL", s, attn.window - 1, cross_eq, cross_rows });
+        if (cross_eq != cross_rows) differ += 1;
+    }
+    dropCaps(gpa, &caps);
+    std.debug.print("kx vs e2614fe: {d}/{d} rows equal (info)\n", .{ ctl_eq, ctl_rows });
+    std.debug.print("forms run: kx-tile {d}, kx-dec {d}, kx-split {d}, kx-split-walk {d}\n", .{ cnt.tile, cnt.dec, cnt.split, cnt.walk });
+    std.debug.print("GRAPH S={d} matrix: {d} CUDA graphs captured and instantiated ({d} nodes; kx-graph, -g7, -c1, -unpack; contiguous and paged), {d} replays ({d} at a position other than the capture's), each among the runs above\n", .{ s, g_caps, g_nodes, g_replays, g_moved });
+    const walk_bad = try graphWalk(gpa, &rig.walk, o, s, rig);
+    const ok = differ == 0 and walk_bad == 0;
+    std.debug.print("{s} op-check kx: heads {d}/{d}, S {d}, G {d}, context {d}: {d} forwards, {d} runs ({d} paged), every row against kx-solo, {d} differ{s}\n", .{ if (ok) "PASS" else "FAIL", o.hq, o.hk, s, o.kx_g, P, forwards, runs, paged_runs, differ, if (walk_bad > 0) "; the graph walk FAILED" else "" });
+    return if (ok) 0 else 1;
+}
+
+fn dropCaps(gpa: std.mem.Allocator, caps: *std.AutoHashMapUnmanaged(usize, Cap)) void {
+    var it = caps.valueIterator();
+    while (it.next()) |c| c.deinit(gpa);
+    caps.clearRetainingCapacity();
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// CUDA graphs of `core` (the engine's captured form, Engine.graphOf / graphStep)
+
+/// A captured forward's inputs and output at fixed addresses (up to attn.max_rows rows): a replay copies a position's
+/// rows in first, as a step's projections write the activations its graph reads.
+const Stage = struct {
+    in: In,
+    out: Mat,
+
+    fn make(gpa: std.mem.Allocator, b: *ck.Bufs, d: *const cuda.Driver, hq: usize) !Stage {
+        const n = attn.max_rows;
+        return .{
+            .in = .{
+                .q = Mat.of(try b.zeroed(gpa, d, n * hq * D * 2), n, hq * D, .bf16),
+                .rel = Mat.of(try b.zeroed(gpa, d, n * hq * dr * 2), n, hq * dr, .bf16),
+                .sink = Mat.of(try b.zeroed(gpa, d, n * hq * 2), n, hq, .bf16),
+                .gate = Mat.of(try b.zeroed(gpa, d, n * hq * D * 2), n, hq * D, .bf16),
+            },
+            .out = Mat.of(try b.zeroed(gpa, d, n * hq * D * 2), n, hq * D, .bf16),
+        };
+    }
+};
+
+/// A launch of a captured forward on a ring view of a run (Ctx.launchOn into a RunLog) and its node in the graph.
+const RunNode = struct { node: cuda.graph.Node, at: ic.ops.RunLog.Launch };
+
+/// `core` for R rows captured from the stream into a CUDA graph (the plan of a captured step: Dev{posp, positions})
+/// and instantiated; `pos` the position it was captured at; `runs` its launches on a ring view of a run.
+const Cap = struct {
+    graph: cuda.graph.Graph,
+    exec: cuda.graph.Exec,
+    R: usize,
+    pos: usize,
+    /// the graph's nodes (kernels and copies)
+    nodes: usize,
+    runs: []RunNode,
+
+    fn deinit(c: *Cap, gpa: std.mem.Allocator) void {
+        c.exec.deinit();
+        c.graph.deinit();
+        gpa.free(c.runs);
+    }
+};
+
+/// Captures `core` (kx form `opt`, keys `kv`) for R rows at pos0 on the stage, as Engine.graphOf does a step's: the
+/// stream in relaxed capture, a RunLog while kv is a ring view of a run (Ctx.runs), the nodes it recorded found in
+/// the graph (Engine.runNodes), instantiated and uploaded. The template graph is kept (its node handles repoint the
+/// executable graph, as the engine keeps it while it holds run nodes).
+fn capture(gpa: std.mem.Allocator, e: *Env, st: Stage, opt: attn.KxOpt, kv: attn.Kv, global: bool, pos0: usize, R: usize) !Cap {
+    try e.sync();
+    var log: ic.ops.RunLog = .{ .gpa = gpa };
+    defer log.deinit();
+    e.x.c.runs = if (kv.run != null) &log else null;
+    defer e.x.c.runs = null;
+    const stream = e.x.c.stream;
+    try cuda.graph.beginCapture(stream, .relaxed);
+    const body = e.coreIn(.kx, opt, true, kv, global, pos0, st.in.slice(0, R), st.out.slice(0, R));
+    var g = cuda.graph.endCapture(stream) catch |err| {
+        try body;
+        return err;
+    };
+    errdefer g.deinit();
+    try body;
+    const runs = try runNodes(gpa, e.x.c.d, g, &log);
+    errdefer gpa.free(runs);
+    var exec = try g.instantiate();
+    errdefer exec.deinit();
+    try exec.upload(stream);
+    return .{ .graph = g, .exec = exec, .R = R, .pos = pos0, .nodes = try g.nodeCount(), .runs = runs };
+}
+
+/// The graph's nodes of the launches `log` recorded, found by kernel and the first base argument (as
+/// cuda_engine.zig's Engine.runNodes); error.RunNodes unless each is found once.
+fn runNodes(gpa: std.mem.Allocator, d: *const cuda.Driver, graph: cuda.graph.Graph, log: *const ic.ops.RunLog) ![]RunNode {
+    if (log.items.items.len == 0) return &.{};
+    const out = try gpa.alloc(RunNode, log.items.items.len);
+    errdefer gpa.free(out);
+    for (out, log.items.items) |*o, x| o.* = .{ .node = null, .at = x };
+    const all = try gpa.alloc(cuda.graph.Node, try graph.nodeCount());
+    defer gpa.free(all);
+    const nodes = try graph.nodes(all);
+    var found: usize = 0;
+    for (nodes) |node| {
+        var p: cuda.abi.KernelNodeParams = std.mem.zeroes(cuda.abi.KernelNodeParams);
+        if (d.api.cuGraphKernelNodeGetParams_v2(node, &p) != cuda.abi.success) continue; // not a kernel node
+        const params = p.params orelse continue;
+        for (out) |*o| {
+            if (o.node != null or o.at.f.handle != p.func) continue;
+            const i = o.at.at[0];
+            const got = @as(*align(1) const u64, @ptrCast(params[i] orelse continue)).*;
+            if (got != o.at.args.integer(i).?) continue;
+            o.node = node;
+            found += 1;
+            break;
+        }
+    }
+    if (found != out.len) return error.RunNodes;
+    return out;
+}
+
+/// Before a replay after the stream's run moved to `now`: every recorded node pointed at it, its base arguments moved
+/// by whole pages of `step` bytes (cuda_engine.zig's Graph.follow). Returns the nodes changed.
+fn follow(c: *Cap, now: u32, step: usize) !usize {
+    var n: usize = 0;
+    for (c.runs) |*r| {
+        if (now == r.at.run) continue;
+        const delta = (@as(i64, now) - @as(i64, r.at.run)) * @as(i64, @intCast(step));
+        for (r.at.at[0..r.at.n]) |i| {
+            const was = r.at.args.integer(i).?;
+            const to: u64 = @intCast(@as(i64, @intCast(was)) + delta);
+            @memcpy(r.at.args.storage[r.at.args.offsets[i]..][0..8], std.mem.asBytes(&to));
+        }
+        try c.exec.setKernel(r.node, r.at.f, r.at.cfg, &r.at.args);
+        r.at.run = now;
+        n += 1;
+    }
+    return n;
+}
+
+/// A replay of `c` on the rows `src` (copied onto the stage) at device position pos0 (null: the device position left
+/// as it is), all on the stream.
+fn replay(e: *const Env, c: *const Cap, st: Stage, src: In, pos0: ?usize) !void {
+    const to = st.in.slice(0, c.R);
+    for ([_]Mat{ to.q, to.rel, to.sink, to.gate }, [_]Mat{ src.q, src.rel, src.sink, src.gate }) |dst, from| {
+        if (from.rows != c.R) return error.BadAttnShape;
+        try e.x.c.copy(dst.ptr, from.ptr, from.bytes());
+    }
+    if (pos0) |p| try e.devPos(p);
+    try c.exec.launchOn(e.x.c.stream);
+}
+
+/// What the graph replays use besides the matrix: the stage, the walks' inputs (from a generator of their own, so the
+/// matrix's inputs and its DIGEST lines stay as they were) and, with global layers, the arena of the run and
+/// page-table moves.
+const Rig = struct {
+    stage: Stage,
+    walk: Env,
+    arena: ?Arena,
+    prng: std.Random.DefaultPrng,
+
+    fn init(gpa: std.mem.Allocator, a: std.mem.Allocator, own: *Own, env: *const Env, o: Opts) !Rig {
+        const d = &own.driver;
+        var r: Rig = .{ .stage = try Stage.make(gpa, &own.b, d, o.hq), .walk = env.*, .arena = null, .prng = std.Random.DefaultPrng.init(o.seed ^ 0x9e37_79b9_7f4a_7c15) };
+        var starts: std.ArrayList(usize) = .empty;
+        for (o.kx_s) |s| for (o.kinds) |kind| {
+            var bb: [max_bounds]usize = undefined;
+            for (walkBounds(&bb, kind, s, o.kx_g, o.context)) |b| try starts.append(a, b - walk_before);
+        };
+        try makeInputs(gpa, a, &own.b, d, &r.walk, o, starts.items, walk_span, r.prng.random());
+        if (std.mem.indexOfScalar(Kind, o.kinds, .global) != null) r.arena = try Arena.init(gpa, &own.b, d, o);
+        return r;
+    }
+
+    fn deinit(r: *Rig, gpa: std.mem.Allocator) void {
+        if (r.arena) |*x| x.deinit(gpa);
+    }
+};
+
+/// The run and page-table moves' own pool, laid out as the served pool (cuda_pages.zig: a region a layer's keys or
+/// values, page id i at i x run_bytes in each): 2 entries + 2 pages, the last the scrub page, NaN until written.
+/// `ids`: the stream's pages in position order (all the scrub page until placed); `table` the device page table
+/// (entries + 8 i32, the spare entries on the scrub page) and `host` its host copy; `new` the next placement.
+const Arena = struct {
+    base: u64,
+    pages: usize,
+    run_bytes: usize,
+    entries: usize,
+    hk: usize,
+    ids: []u32,
+    new: []u32,
+    host: []i32,
+    table: u64,
+
+    fn init(gpa: std.mem.Allocator, b: *ck.Bufs, d: *const cuda.Driver, o: Opts) !Arena {
+        const entries = (o.context + attn.split_keys - 1) / attn.split_keys;
+        const pages = 2 * entries + 2;
+        const run_bytes = attn.split_keys * o.hk * D * 2;
+        const base = try b.filled(gpa, d, 2 * pages * run_bytes, 0xff);
+        const table = try b.zeroed(gpa, d, (entries + 8) * 4);
+        const ids = try gpa.alloc(u32, entries);
+        errdefer gpa.free(ids);
+        const new = try gpa.alloc(u32, entries);
+        errdefer gpa.free(new);
+        const host = try gpa.alloc(i32, entries + 8);
+        @memset(ids, @intCast(pages - 1));
+        return .{ .base = base, .pages = pages, .run_bytes = run_bytes, .entries = entries, .hk = o.hk, .ids = ids, .new = new, .host = host, .table = table };
+    }
+
+    fn deinit(a: *Arena, gpa: std.mem.Allocator) void {
+        gpa.free(a.ids);
+        gpa.free(a.new);
+        gpa.free(a.host);
+    }
+
+    fn scrub(a: *const Arena) u32 {
+        return @intCast(a.pages - 1);
+    }
+
+    fn region(a: *const Arena, r: usize) u64 {
+        return a.base + r * a.pages * a.run_bytes;
+    }
+
+    fn placed(a: *const Arena) bool {
+        return a.ids[0] != a.scrub();
+    }
+
+    /// The stream's keys and values through the page table.
+    fn paged(a: *const Arena) attn.Kv {
+        return .{ .k = a.region(0), .v = a.region(1), .slots = a.entries * attn.split_keys, .heads = a.hk, .window = 0, .pages = a.table, .page = a.run_bytes / 2 };
+    }
+
+    fn isRun(a: *const Arena) bool {
+        for (a.ids[1..], a.ids[0 .. a.ids.len - 1]) |x, prev| if (x != prev + 1) return false;
+        return a.placed();
+    }
+
+    /// State.kvFor's view of a one-row forward on a run: the run's first page the base, a slot a position (P).
+    fn ring(a: *const Arena, P: usize) attn.Kv {
+        const start = a.ids[0];
+        const off = @as(u64, start) * a.run_bytes;
+        return .{ .k = a.region(0) + off, .v = a.region(1) + off, .slots = P, .heads = a.hk, .window = 0, .run = start };
+    }
+
+    /// The next placement: the run from page `start`.
+    fn toRun(a: *Arena, start: usize) void {
+        for (a.new, 0..) |*x, i| x.* = @intCast(start + i);
+    }
+
+    /// The next placement: `entries` pages of a permutation of the pool's (the scrub page aside), none an entry's
+    /// present page.
+    fn toShuffle(a: *Arena, gpa: std.mem.Allocator, rng: std.Random) !void {
+        const all = try gpa.alloc(u32, a.pages - 1);
+        defer gpa.free(all);
+        for (all, 0..) |*x, i| x.* = @intCast(i);
+        rng.shuffle(u32, all);
+        @memcpy(a.new, all[0..a.entries]);
+        for (a.new, a.ids, 0..) |*x, old, i| if (x.* == old) {
+            const j = (i + 1) % a.entries;
+            std.mem.swap(u32, x, &a.new[j]);
+        };
+    }
+
+    /// The stream's rows (from the contiguous cache) moved to the pages `new`, on the stream; the old pages it leaves
+    /// zeroed (finite: a stale read gives wrong bytes and no exception); the device table follows when `commit`.
+    fn place(a: *Arena, gpa: std.mem.Allocator, e: *const Env, commit: bool) !void {
+        var keep = try std.DynamicBitSet.initEmpty(gpa, a.pages);
+        defer keep.deinit();
+        for (a.new) |id| keep.set(id);
+        const c = &e.x.c;
+        for (a.ids) |id| if (id != a.scrub() and !keep.isSet(id)) for (0..2) |r| try c.zero(a.region(r) + id * a.run_bytes, a.run_bytes);
+        const row = a.hk * D * 2;
+        const P = e.x.context;
+        for (a.new, 0..) |id, i| {
+            const n = @min(attn.split_keys, P - i * attn.split_keys) * row;
+            for ([_]u64{ e.x.b.k, e.x.b.v }, 0..) |src, r| try c.copy(a.region(r) + id * a.run_bytes, src + i * attn.split_keys * row, n);
+        }
+        @memcpy(a.ids, a.new);
+        if (commit) try a.commitTable(e);
+    }
+
+    /// The device page table onto `ids` (the stream idle first; the upload returns once landed).
+    fn commitTable(a: *Arena, e: *const Env) !void {
+        for (a.host, 0..) |*t, i| t.* = @intCast(if (i < a.entries) a.ids[i] else a.scrub());
+        try e.sync();
+        const view: cuda.DeviceBuffer = .{ .d = e.x.c.d, .ptr = a.table, .len = a.host.len * 4, .borrowed = true };
+        try view.upload(0, std.mem.sliceAsBytes(a.host));
+    }
+};
+
+const walk_before = 10;
+const walk_after = 2;
+/// The positions a walk's inputs cover from b - walk_before: its replays' rows and a control's next row.
+const walk_span = walk_before + walk_after + attn.max_rows + 2;
+const max_bounds = 8;
+
+/// The boundaries a walk crosses: global layers a kx tile (64 keys), a page (256), the key split S and 2 S, the grid's
+/// wrap at 7 S (-g7) and G S, 2 G S, and the slot's end; sliding layers a tile, the window's edge (1024: the first row
+/// not seeing position 0), the ring's wraps (slots, 2 and 3 slots, the last before the context's half) and the
+/// slot's end. A walk replays at every position from b - walk_before to b + walk_after.
+fn walkBounds(buf: *[max_bounds]usize, kind: Kind, s: usize, g: usize, P: usize) []usize {
+    const slots = attn.window - 1 + ic.engine.prompt_rows;
+    const cand: [max_bounds]usize = if (kind == .global)
+        .{ 64, attn.split_keys, s, 2 * s, 7 * s, g * s, 2 * g * s, P -| walk_before }
+    else
+        .{ 64, attn.window, slots, 2 * slots, 3 * slots, (P / 2) / slots * slots, P -| walk_before, attn.window + attn.kx_sliding_split };
+    var n: usize = 0;
+    for (cand) |b| {
+        if (b < walk_before or b + walk_before > P or std.mem.indexOfScalar(usize, buf[0..n], b) != null) continue;
+        buf[n] = b;
+        n += 1;
+    }
+    std.mem.sort(usize, buf[0..n], {}, std.sort.asc(usize));
+    return buf[0..n];
+}
+
+/// The keys a walk's graph reads: the contiguous cache (sliding: the ring), the pool's shuffled pages, a ring view of
+/// a run of the arena's pages (one row: the served fallback), the arena's page table.
+const KvForm = enum { contiguous, pool, run, table };
+
+/// One S's graph walks: the kx-solo rows they compare with and their tallies.
+const Walk = struct {
+    gpa: std.mem.Allocator,
+    w: *Env,
+    rig: *Rig,
+    s: usize,
+    g: usize,
+    kind: Kind = .global,
+    rb: usize,
+    twin: Mat,
+    one: Mat,
+    host: []u8,
+    solo: std.AutoHashMapUnmanaged(usize, []u8) = .empty,
+    caps: usize = 0,
+    nodes: usize = 0,
+    replays: usize = 0,
+    moved: usize = 0,
+    rows: usize = 0,
+    bad_solo: usize = 0,
+    bad_twin: usize = 0,
+    bad_log: usize = 0,
+    run_moves: usize = 0,
+    repointed: usize = 0,
+    table_moves: usize = 0,
+    ctl: usize = 0,
+    ctl_failed: usize = 0,
+    printed: usize = 0,
+
+    fn clearSolo(k: *Walk) void {
+        var it = k.solo.valueIterator();
+        while (it.next()) |v| k.gpa.free(v.*);
+        k.solo.clearRetainingCapacity();
+    }
+
+    /// Row p alone (R = 1, default dispatch, eager, contiguous keys).
+    fn soloRow(k: *Walk, p: usize) ![]const u8 {
+        if (k.solo.get(p)) |r| return r;
+        try k.w.core(.kx, .{ .s = k.s, .g = k.g }, false, k.w.kvOf(k.kind, false), k.kind == .global, p, 1, k.one);
+        try k.w.sync();
+        const r = try k.gpa.alloc(u8, k.rb);
+        errdefer k.gpa.free(r);
+        try cuda.memory.download(k.w.x.c.d, k.one.ptr, r);
+        try k.solo.put(k.gpa, p, r);
+        return r;
+    }
+
+    /// Replays `cp` at p, then the eager launch of the same form (the captured plan, the position read on the
+    /// device) on the same keys `kv`; each row of the replay against kx-solo and against that launch.
+    fn replayAt(k: *Walk, cp: *const Cap, v: Var, f: KvForm, kv: attn.Kv, p: usize) !void {
+        const R = cp.R;
+        for (0..R) |t| _ = try k.soloRow(p + t);
+        try replay(k.w, cp, k.rig.stage, k.w.inputs(p, R), p);
+        try k.w.core(.kx, v.opt, true, kv, k.kind == .global, p, R, k.twin);
+        try k.w.sync();
+        const rb = k.rb;
+        try cuda.memory.download(k.w.x.c.d, k.rig.stage.out.ptr, k.host[0 .. R * rb]);
+        try cuda.memory.download(k.w.x.c.d, k.twin.ptr, k.host[attn.max_rows * rb ..][0 .. R * rb]);
+        var bad: usize = 0;
+        var bad_t: usize = 0;
+        for (0..R) |t| {
+            const got = k.host[t * rb ..][0..rb];
+            bad += @intFromBool(!std.mem.eql(u8, got, k.solo.get(p + t).?));
+            bad_t += @intFromBool(!std.mem.eql(u8, got, k.host[(attn.max_rows + t) * rb ..][0..rb]));
+        }
+        k.replays += 1;
+        k.moved += @intFromBool(p != cp.pos);
+        k.rows += R;
+        k.bad_solo += @intFromBool(bad > 0);
+        k.bad_twin += @intFromBool(bad_t > 0);
+        if ((bad > 0 or bad_t > 0) and k.printed < 8) {
+            k.printed += 1;
+            std.debug.print("  GRAPH DIFFER S={d} {t} {s} {t} rows {d} pos0 {d} (captured at {d}): {d} rows differ from kx-solo, {d} from the eager launch of the form\n", .{ k.s, k.kind, v.name, f, R, p, cp.pos, bad, bad_t });
+        }
+    }
+
+    /// A planted control (it must differ from kx-solo): `cp` launched on p's rows, the device position written only
+    /// when `write_pos`.
+    fn control(k: *Walk, cp: *const Cap, v: Var, p: usize, write_pos: bool, what: []const u8) !void {
+        const R = cp.R;
+        for (0..R) |t| _ = try k.soloRow(p + t);
+        try replay(k.w, cp, k.rig.stage, k.w.inputs(p, R), if (write_pos) p else null);
+        try k.w.sync();
+        try cuda.memory.download(k.w.x.c.d, k.rig.stage.out.ptr, k.host[0 .. R * k.rb]);
+        var differs: usize = 0;
+        for (0..R) |t| differs += @intFromBool(!std.mem.eql(u8, k.host[t * k.rb ..][0..k.rb], k.solo.get(p + t).?));
+        k.ctl += 1;
+        k.ctl_failed += @intFromBool(differs > 0);
+        std.debug.print("GRAPH control S={d} {t} {s} rows {d} pos0 {d}, {s}: {d}/{d} rows differ from kx-solo, {s}\n", .{ k.s, k.kind, v.name, R, p, what, differs, R, if (differs > 0) "failed as required" else "DID NOT FAIL" });
+    }
+
+    /// One graph (variant v, keys f, R rows) captured at ps[0] and replayed at every position of ps, then once more
+    /// at ps[0]; then f's moves and controls.
+    fn walkOne(k: *Walk, v: Var, f: KvForm, R: usize, ps: []const usize) !void {
+        const w = k.w;
+        const P = w.x.context;
+        const ar: ?*Arena = if (k.rig.arena) |*x| x else null;
+        if ((f == .run and !ar.?.isRun()) or (f == .table and !ar.?.placed())) {
+            ar.?.toRun(1);
+            try ar.?.place(k.gpa, w, true);
+        }
+        const kv = switch (f) {
+            .contiguous => w.kvOf(k.kind, false),
+            .pool => w.kvOf(k.kind, true),
+            .run => ar.?.ring(P),
+            .table => ar.?.paged(),
+        };
+        var cp = try capture(k.gpa, w, k.rig.stage, v.opt, kv, k.kind == .global, ps[0], R);
+        defer cp.deinit(k.gpa);
+        k.caps += 1;
+        k.nodes += cp.nodes;
+        // a one-row forward on a run: RunLog holds kx-split's and the merge's launches, both found in the graph
+        if (f == .run and cp.runs.len != 2) {
+            k.bad_log += 1;
+            std.debug.print("  GRAPH S={d} {s} on a run: {d} launches recorded on the run (want 2: kx-split, merge)\n", .{ k.s, v.name, cp.runs.len });
+        }
+        for (ps) |p| if (p + R <= P) try k.replayAt(&cp, v, f, kv, p);
+        try k.replayAt(&cp, v, f, kv, ps[0]);
+        const pm = ps[ps.len / 2];
+        switch (f) {
+            .contiguous => if (R == 1 and std.mem.eql(u8, v.name, "kx-graph")) {
+                // the device position left at pm while pm + 1's rows are staged
+                try k.replayAt(&cp, v, f, kv, pm);
+                try k.control(&cp, v, pm + 1, false, "stale device position");
+            },
+            .run => {
+                // the run moves to pages disjoint from it: first the replay with the K/V pointers still on the old
+                // run, then the recorded nodes repointed (Graph.follow) and the walk again; then a move by one page
+                const a = ar.?;
+                const was = a.ids[0];
+                a.toRun(if (was <= 1) a.entries + 1 else 0);
+                try a.place(k.gpa, w, true);
+                k.run_moves += 1;
+                try k.control(&cp, v, pm, true, "K/V pointers left on the old run");
+                for (0..2) |m| {
+                    if (m == 1) {
+                        a.toRun(if (a.ids[0] == 0) 1 else a.ids[0] - 1);
+                        try a.place(k.gpa, w, true);
+                        k.run_moves += 1;
+                    }
+                    const moved = try follow(&cp, a.ids[0], a.run_bytes);
+                    k.repointed += moved;
+                    if (moved != cp.runs.len) k.bad_log += 1;
+                    const kv2 = a.ring(P);
+                    for (ps) |p| if (p + R <= P) try k.replayAt(&cp, v, f, kv2, p);
+                }
+            },
+            .table => {
+                // the stream's pages move to other ids: first the replay with the device table still on the old
+                // pages, then the table written and the walk again
+                const a = ar.?;
+                try a.toShuffle(k.gpa, k.rig.prng.random());
+                try a.place(k.gpa, w, false);
+                k.table_moves += 1;
+                try k.control(&cp, v, pm, true, "page table left on the old pages");
+                try a.commitTable(w);
+                for (ps) |p| if (p + R <= P) try k.replayAt(&cp, v, f, kv, p);
+            },
+            .pool => {},
+        }
+    }
+};
+
+/// The graph walks at one S (see the header): returns 1 on any difference, a control that does not fail, or a run
+/// launch not recorded or not repointed.
+fn graphWalk(gpa: std.mem.Allocator, w: *Env, o: Opts, s: usize, rig: *Rig) !usize {
+    const P = w.x.context;
+    const rb = o.hq * D * 2;
+    var twin_buf = try cuda.DeviceBuffer.alloc(w.x.c.d, attn.max_rows * rb);
+    defer twin_buf.free();
+    var one_buf = try cuda.DeviceBuffer.alloc(w.x.c.d, rb);
+    defer one_buf.free();
+    var k: Walk = .{ .gpa = gpa, .w = w, .rig = rig, .s = s, .g = o.kx_g, .rb = rb, .twin = Mat.of(twin_buf.ptr, attn.max_rows, o.hq * D, .bf16), .one = Mat.of(one_buf.ptr, 1, o.hq * D, .bf16), .host = try gpa.alloc(u8, 2 * attn.max_rows * rb) };
+    defer gpa.free(k.host);
+    defer {
+        k.clearSolo();
+        k.solo.deinit(gpa);
+    }
+    var ps: std.ArrayList(usize) = .empty;
+    defer ps.deinit(gpa);
+    var forms: [4]usize = @splat(0);
+    for (o.kinds) |kind| {
+        k.clearSolo();
+        k.kind = kind;
+        const glob = kind == .global;
+        var bb: [max_bounds]usize = undefined;
+        const bounds = walkBounds(&bb, kind, s, o.kx_g, P);
+        if (bounds.len == 0) continue;
+        ps.clearRetainingCapacity();
+        for (bounds) |b| for (b - walk_before..b + walk_after + 1) |p| {
+            if (ps.items.len == 0 or p > ps.items[ps.items.len - 1]) try ps.append(gpa, p);
+        };
+        std.debug.print("GRAPH S={d} {t} walk: boundaries {any}, {d} positions from {d} to {d}\n", .{ s, kind, bounds, ps.items.len, ps.items[0], ps.items[ps.items.len - 1] });
+        for ([_]usize{ 1, attn.max_rows }) |R| for (graphVariants(s, o.kx_g)) |v| {
+            if (v.global_only and !glob) continue;
+            for (std.enums.values(KvForm), 0..) |f, fi| {
+                if (!glob and f != .contiguous) continue;
+                if ((f == .run or f == .table) and rig.arena == null) continue;
+                if (f == .run and R != 1) continue;
+                try k.walkOne(v, f, R, ps.items);
+                forms[fi] += 1;
+            }
+        };
+    }
+    const ok = k.bad_solo == 0 and k.bad_twin == 0 and k.bad_log == 0 and k.ctl_failed == k.ctl and k.ctl > 0;
+    std.debug.print("{s} graph replay kx: S {d}: {d} CUDA graphs captured and instantiated ({d} nodes; contiguous {d}, pool pages {d}, ring on a run {d}, moving page table {d}), {d} replays ({d} at a position other than the capture's, {d} rows), against kx-solo: {d} replays differ, against the eager launch of the same form: {d} differ; run moves {d} ({d} graph nodes repointed from the RunLog, {d} not recorded or not repointed), page-table moves {d}; controls {d}/{d} failed as required\n", .{ if (ok) "PASS" else "FAIL", s, k.caps, k.nodes, forms[0], forms[1], forms[2], forms[3], k.replays, k.moved, k.rows, k.bad_solo, k.bad_twin, k.run_moves, k.repointed, k.bad_log, k.table_moves, k.ctl_failed, k.ctl });
+    return if (ok) 0 else 1;
+}
+
+/// `DIGEST op-check`: sha256 over a kind's kx-solo rows in position order (the bytes every variant matched), so two
+/// builds' outputs can be compared without the rows.
+fn printSoloDigest(gpa: std.mem.Allocator, s: usize, kind: Kind, solo: *const std.AutoHashMapUnmanaged(usize, []u8)) !void {
+    const keys = try gpa.alloc(usize, solo.count());
+    defer gpa.free(keys);
+    var it = solo.keyIterator();
+    var i: usize = 0;
+    while (it.next()) |k| : (i += 1) keys[i] = k.*;
+    std.mem.sort(usize, keys, {}, std.sort.asc(usize));
+    var h = std.crypto.hash.sha2.Sha256.init(.{});
+    for (keys) |k| {
+        h.update(std.mem.asBytes(&k));
+        h.update(solo.get(k).?);
+    }
+    var dg: [32]u8 = undefined;
+    h.final(&dg);
+    std.debug.print("DIGEST op-check S={d} {t}: kx-solo {d} rows sha256 {s}\n", .{ s, kind, keys.len, std.fmt.bytesToHex(dg, .lower) });
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// --bench
+
+/// The bench's variants at a cell (a captured one twice: eager pos-pointer and graph).
+const max_bv = 48;
+/// A captured cell's CUDA graph holds this many of the cell's calls: its one launch is spread over them, as a step's
+/// graph spreads its launch over its layers.
+const graph_calls = 8;
+
+/// Time quantiles of each of n closures (us a call), alternated in rounds of `per` calls: median, p10, p90 of the
+/// rounds' means.
+fn timeQ(io: std.Io, e: *const Env, n: usize, f: anytype, reps: usize) ![max_bv][3]f64 {
+    const clock = std.Io.Clock.awake;
+    const per = 10;
+    const rounds = @max((reps + per - 1) / per, 3);
+    if (rounds > 256) return error.TooManyReps;
+    if (n > max_bv) return error.TooManyVariants;
+    var t: [max_bv][256]f64 = undefined;
+    for (0..n) |j| for (0..3) |_| try f.call(j);
+    try e.sync();
+    for (0..rounds) |r| for (0..n) |j| {
+        const t0 = clock.now(io).toNanoseconds();
+        for (0..per) |_| try f.call(j);
+        try e.sync();
+        t[j][r] = @as(f64, @floatFromInt(clock.now(io).toNanoseconds() - t0)) * 1e-3 / per;
+    };
+    var q: [max_bv][3]f64 = @splat(@splat(0));
+    for (0..n) |j| {
+        const x = t[j][0..rounds];
+        std.mem.sort(f64, x, {}, std.sort.asc(f64));
+        q[j] = .{ x[rounds / 2], x[(rounds - 1) / 10], x[rounds - 1 - (rounds - 1) / 10] };
+    }
+    return q;
+}
+
+fn packName(pk: ?bool) []const u8 {
+    return if (pk) |x| (if (x) "-p1" else "-p0") else "";
+}
+
+const BVar = struct { name: []const u8, form: attn.Form, opt: attn.KxOpt = .{}, mode: Mode = .eager };
+
+/// The BENCH line's label of a mode.
+fn modeLabel(m: Mode) []const u8 {
+    return switch (m) {
+        .eager => "eager",
+        .devpos => "eager pos-pointer",
+        .graph => "captured",
+    };
+}
+
+/// v at a cell: captured (R <= 8) as eager pos-pointer launches and as graph launches, else eager.
+fn push(bv: *[max_bv]BVar, n: *usize, v: BVar, captured: bool) !void {
+    const modes: []const Mode = if (captured) &.{ .devpos, .graph } else &.{.eager};
+    for (modes) |m| {
+        if (n.* == max_bv) return error.TooManyVariants;
+        bv[n.*] = v;
+        bv[n.*].mode = m;
+        n.* += 1;
+    }
+}
+
+/// A CUDA graph of `graph_calls` of the cell's call j launched as eager pos-pointer (f.eager), captured from the
+/// stream (relaxed, as Engine.graphOf), instantiated and uploaded.
+fn captureCalls(e: *const Env, f: anytype, j: usize) !cuda.graph.Exec {
+    try e.sync();
+    const stream = e.x.c.stream;
+    try cuda.graph.beginCapture(stream, .relaxed);
+    const body: anyerror!void = blk: {
+        for (0..graph_calls) |_| f.eager(j) catch |err| break :blk err;
+        break :blk {};
+    };
+    var g = cuda.graph.endCapture(stream) catch |err| {
+        try body;
+        return err;
+    };
+    defer g.deinit();
+    try body;
+    var x = try g.instantiate();
+    errdefer x.deinit();
+    try x.upload(stream);
+    return x;
+}
+
+fn bench(gpa: std.mem.Allocator, io: std.Io, env: *Env, o: Opts, rl: []const usize, pool: ?ck.Pool) !void {
+    var served: ?ck.Served = null;
+    if (pool) |pl| {
+        if (o.paged) served = try ck.Served.make(gpa, env.x.c.d, &env.x, o, pl);
+    }
+    const out = Mat.of(try env.x.b.zeroed(gpa, env.x.c.d, (std.mem.max(usize, rl)) * o.hq * D * 2), std.mem.max(usize, rl), o.hq * D, .bf16);
+    var names: [max_bv][32]u8 = undefined;
+    for (o.kinds) |kind| for (o.positions) |pos0| for (rl) |R| {
+        if (pos0 + R > env.x.context) continue;
+        const glob = kind == .global;
+        const captured = R <= attn.max_rows;
+        var bv: [max_bv]BVar = undefined;
+        var n: usize = 0;
+        if (glob) {
+            if (o.v01) try push(&bv, &n, .{ .name = "v01", .form = .v01 }, captured);
+            if (o.kx) for (o.kx_s) |s| for (o.kx_p) |pk| for (o.kx_gc) |gc| {
+                var cb: [8]u8 = undefined;
+                const cn = if (gc) |c| std.fmt.bufPrint(&cb, "-c{d}", .{c}) catch "" else "";
+                if (n == max_bv) return error.TooManyVariants;
+                try push(&bv, &n, .{ .name = try std.fmt.bufPrint(&names[n], "kx-s{d}{s}{s}", .{ s, packName(pk), cn }), .form = .kx, .opt = .{ .s = s, .g = o.kx_g, .pack = pk, .c = gc } }, captured);
+            };
+        } else {
+            if (o.v01) {
+                try push(&bv, &n, .{ .name = "v01", .form = .v01 }, false);
+                if (captured) try push(&bv, &n, .{ .name = "v01-captured", .form = .v01 }, true);
+            }
+            if (o.kx) for (o.kx_c) |c| for (o.kx_p) |pk| for (o.kx_f) |gf| {
+                if (n == max_bv) return error.TooManyVariants;
+                const fname = if (gf == .auto) "" else @tagName(gf);
+                try push(&bv, &n, .{ .name = try std.fmt.bufPrint(&names[n], "kx-c{d}{s}{s}{s}", .{ c, packName(pk), if (gf == .auto) "" else "-", fname }), .form = .kx, .opt = .{ .s = o.kx_s[0], .g = o.kx_g, .c = c, .pack = pk, .global = gf } }, captured);
+            };
+        }
+        try env.sync();
+        try env.x.setPos(pos0);
+        const layers: usize = if (glob and served != null) served.?.n else 1;
+        var execs: [max_bv]?cuda.graph.Exec = @splat(null);
+        defer for (&execs) |*x| if (x.*) |*ex| ex.deinit();
+        const F = struct {
+            e: *const Env,
+            sv: ?*const ck.Served,
+            list: []const BVar,
+            execs: *const [max_bv]?cuda.graph.Exec,
+            kind: Kind,
+            pos0: usize,
+            R: usize,
+            out: Mat,
+            /// call j's eager launches (devpos: the captured plan, the position read on the device)
+            fn eager(f: @This(), j: usize) !void {
+                const v = f.list[j];
+                const dev = v.mode != .eager;
+                if (f.sv) |s| {
+                    for (0..s.n) |l| try f.e.core(v.form, v.opt, dev, s.paged[l], true, f.pos0, f.R, f.out);
+                } else try f.e.core(v.form, v.opt, dev, f.e.kvOf(f.kind, false), f.kind == .global, f.pos0, f.R, f.out);
+            }
+            fn call(f: @This(), j: usize) !void {
+                if (f.list[j].mode == .graph) return f.execs[j].?.launchOn(f.e.x.c.stream);
+                return f.eager(j);
+            }
+        };
+        const f: F = .{ .e = env, .sv = if (glob and served != null) &served.? else null, .list = bv[0..n], .execs = &execs, .kind = kind, .pos0 = pos0, .R = R, .out = out };
+        for (bv[0..n], 0..) |v, j| if (v.mode == .graph) {
+            execs[j] = try captureCalls(env, f, j);
+        };
+        const q = try timeQ(io, env, n, f, o.reps);
+        for (bv[0..n], 0..) |v, j| {
+            var pb: [96]u8 = undefined;
+            env.x.k.attn.form = v.form;
+            env.x.k.attn.kxo = v.opt;
+            const kv = if (glob and served != null) served.?.paged[0] else env.kvOf(kind, false);
+            const p = attn.plan(&env.x.k.attn, R, pos0, if (v.mode != .eager) attn.Dev{ .posp = 1, .positions = env.x.context } else null, kv, o.hq, o.hk);
+            const pt = if (v.form == .kx) planText(&pb, p) else (if (p.form == .split) (if (p.rows) "split+rows" else "split") else @tagName(p.form));
+            const L: f64 = @floatFromInt(layers * @as(usize, if (v.mode == .graph) graph_calls else 1));
+            std.debug.print("BENCH\t{t}\tpos0 {d}\trows {d}\t{s}\t{s}\tmedian {d:.2}\tp10 {d:.2}\tp90 {d:.2}\tus a layer\t{s}\n", .{ kind, pos0, R, modeLabel(v.mode), v.name, q[j][0] / L, q[j][1] / L, q[j][2] / L, pt });
+        }
+    };
+}
+
+// ---------------------------------------------------------------------------------------------------------------
+// --limb
+
+const Case = enum { L1, L2, L3, L4, L5, L6, L7 };
+const case_names = [_][]const u8{ "L1 peaked", "L2 subnormal q", "L3 subnormal K, V", "L4 NaN q", "L5 NaN V", "L6 +Inf K", "L7 out of range" };
+/// The cases the e2614fe control must fail (a row differs from its solo or its clean run).
+const control_cases = [_]Case{ .L1, .L2, .L3, .L5, .L7 };
+
+const lim_ctx = 4352; // 17 pages; the global block's rows 4088 .. 4103 leave the last page's rows 4104 .. 4351 unused
+const lim_used = 4104;
+const lim_global = 4088;
+const lim_rows = 16;
+const lim_sliding_cross = 1272;
+
+/// The host's copies of the planted check's inputs (every position): q, rel (packed rows = positions), keys, values.
+const Host = struct {
+    q: []u16,
+    rel: []u16,
+    k: []u16,
+    v: []u16,
+};
+
+/// The planted inputs of case c into h (from the pristine copy `base`); `clean`: the case's comparison run instead
+/// (subnormals as +0, non-finite plants absent). pos0: the block's first position.
+fn plant(h: *Host, base: *const Host, c: Case, clean: bool, pos0: usize, hq: usize, hk: usize, global: bool) void {
+    @memcpy(h.q, base.q);
+    @memcpy(h.rel, base.rel);
+    @memcpy(h.k, base.k);
+    @memcpy(h.v, base.v);
+    const qa = struct {
+        fn at(p: usize, head: usize, e: usize, n: usize) usize {
+            return (p * n + head) * D + e;
+        }
+    }.at;
+    switch (c) {
+        .L1 => {
+            // row 3, head 0: q'' = 22.625 e0, its rel' 0 (bias 0); its own key 22.625 e0, every other key of its
+            // window -22.625 e0 (kv head 0): scores +45.25 and -45.25, the others' weights e^-90.5 (subnormal)
+            const r3 = pos0 + 3;
+            @memset(h.q[qa(r3, 0, 0, hq)..][0..D], 0);
+            h.q[qa(r3, 0, 0, hq)] = 0x41b5;
+            @memset(h.rel[(r3 * hq + 0) * dr ..][0..dr], 0);
+            const lo = if (global) 0 else r3 -| (attn.window - 1);
+            for (lo..r3 + 1) |p| {
+                @memset(h.k[qa(p, 0, 0, hk)..][0..D], 0);
+                h.k[qa(p, 0, 0, hk)] = if (p == r3) 0x41b5 else 0xc1b5;
+            }
+        },
+        .L2 => {
+            h.q[qa(pos0 + 5, 0, 0, hq)] = if (clean) 0 else 0x0001;
+            h.q[qa(pos0 + 5, 0, 1, hq)] = if (clean) 0 else 0x8001;
+        },
+        .L3 => {
+            h.k[qa(pos0 + 8, 0, 3, hk)] = if (clean) 0 else 0x0001;
+            h.v[qa(pos0 + 8, 0, 3, hk)] = if (clean) 0 else 0x0001;
+        },
+        .L4 => if (!clean) {
+            h.q[qa(pos0 + 7, 0, 0, hq)] = 0x7fc0;
+        },
+        .L5 => if (!clean) {
+            h.v[qa(pos0 + 12, 0, 5, hk)] = 0x7fc0;
+        },
+        .L6 => {
+            // rows 10-15 of kv group 0: q''[0] > 0 (so q[0] * +Inf is +Inf in every form), in both runs
+            for (10..16) |t| for (0..hq / hk) |head| {
+                h.q[qa(pos0 + t, head, 0, hq)] = 0x3f80;
+            };
+            if (!clean) h.k[qa(pos0 + 10, 0, 0, hk)] = 0x7f80;
+        },
+        .L7 => if (!clean) {
+            // keys no row of the block reads: below the block's window start inside its first tile (sliding),
+            // past its last row (every kind); every kv head
+            const last = pos0 + lim_rows - 1;
+            if (!global) {
+                const lo = pos0 -| (attn.window - 1);
+                for (lo / 64 * 64..lo) |p| for (0..hk) |g| {
+                    h.k[qa(p, g, 0, hk)] = 0x7fc0;
+                    h.v[qa(p, g, 1, hk)] = 0x0001;
+                };
+            }
+            for (last + 1..@min(last + 40, lim_ctx)) |p| for (0..hk) |g| {
+                h.k[qa(p, g, 2, hk)] = if (p % 2 == 0) 0x7fc0 else 0x0001;
+                h.v[qa(p, g, 2, hk)] = if (p % 2 == 0) 0x0001 else 0x7fc0;
+            };
+        },
+    }
+}
+
+const Block = struct { kind: Kind, pg: bool, pos0: usize };
+
+fn limbBlocks(c: Case) [4]Block {
+    const sl: usize = if (c == .L7) 1100 else 1000; // L7's plant below the window start needs lo(pos0) > 0
+    // sliding at 1272: rows 1272 .. 1287 cross a window start split boundary (lo 255 -> 256 at row 1279) and a last
+    // split boundary (p 1279 -> 1280) at once
+    return .{ .{ .kind = .sliding, .pg = false, .pos0 = sl }, .{ .kind = .sliding, .pg = false, .pos0 = lim_sliding_cross }, .{ .kind = .global, .pg = false, .pos0 = lim_global }, .{ .kind = .global, .pg = true, .pos0 = lim_global } };
+}
+
+fn finite16(x: u16) bool {
+    return x & 0x7f80 != 0x7f80;
+}
+
+const Limb = struct {
+    gpa: std.mem.Allocator,
+    env: *Env,
+    own: *Own,
+    o: Opts,
+    h: Host,
+    base: Host,
+    out: [4]Mat,
+    host: [4][]u16,
+
+    /// The host's inputs onto the device: q, rel (packed rows = positions), keys and values (contiguous; the pool's
+    /// rows 0 .. lim_used - 1 rewritten from them, its last page's rows past them NaN, or (L7 plant) 0x0001).
+    fn upload(l: *Limb, c: Case, clean: bool) !void {
+        const d = l.env.x.c.d;
+        try put(d, l.env.q.ptr, l.h.q);
+        try put(d, l.env.rel.ptr, l.h.rel);
+        try put(d, l.env.x.b.k, l.h.k);
+        try put(d, l.env.x.b.v, l.h.v);
+        const pl = l.own.pool.?;
+        try ck.writePool(&l.env.x, l.env.x.kvp, lim_used);
+        // the last page's unused rows: NaN, or (L7) 0x0001
+        const row = l.o.hk * D;
+        const id: usize = @intCast(pl.table[lim_used / attn.split_keys]);
+        const n = (attn.split_keys - lim_used % attn.split_keys) * row;
+        const fill = try l.gpa.alloc(u16, n);
+        defer l.gpa.free(fill);
+        @memset(fill, if (c == .L7 and !clean) 0x0001 else 0xffff);
+        for ([_]usize{ ck.run_k, ck.run_v }) |r| try put(d, pl.run(r, id) + (lim_used % attn.split_keys) * row * 2, fill);
+    }
+
+    /// kx's default dispatch (16 rows) and its other forms on block b, every row against its solo; the default run's
+    /// outputs in host[0], its counter deltas returned.
+    fn kxRun(l: *Limb, b: Block, s: usize, bad: *usize) ![3]u64 {
+        const e = l.env;
+        const kv = e.kvOf(b.kind, b.pg);
+        const glob = b.kind == .global;
+        const forms = if (glob) [_]attn.KxOpt{ .{ .s = s }, .{ .s = s, .global = .walk }, .{ .s = s, .c = 1 } } else [_]attn.KxOpt{ .{ .s = s }, .{ .s = s, .global = .walk }, .{ .s = s, .c = 4, .pack = false } };
+        try e.sync();
+        const c0 = try l.own.k.attn.kx.?.counts(e.x.c.d);
+        try e.core(.kx, forms[0], false, kv, glob, b.pos0, lim_rows, l.out[0]);
+        try e.sync();
+        const c1 = try l.own.k.attn.kx.?.counts(e.x.c.d);
+        for (forms[1..], 1..) |f, i| try e.core(.kx, f, false, kv, glob, b.pos0, lim_rows, l.out[i]);
+        try e.sync();
+        const w = l.o.hq * D;
+        for (0..3) |i| try cuda.memory.download(e.x.c.d, l.out[i].ptr, std.mem.sliceAsBytes(l.host[i][0 .. lim_rows * w]));
+        for (0..lim_rows) |t| {
+            try e.core(.kx, forms[0], false, kv, glob, b.pos0 + t, 1, l.out[3]);
+            try e.sync();
+            try cuda.memory.download(e.x.c.d, l.out[3].ptr, std.mem.sliceAsBytes(l.host[3][0..w]));
+            for (0..3) |i| if (!std.mem.eql(u16, l.host[3][0..w], l.host[i][t * w ..][0..w])) {
+                bad.* += 1;
+            };
+        }
+        var dl: [3]u64 = undefined;
+        for (&dl, c1, c0) |*x, y, z| x.* = y -% z;
+        return dl;
+    }
+
+    /// The e2614fe control on block b (contiguous or ring keys): whether a row differs from its solo, and its
+    /// 16-row outputs in host[1].
+    fn controlRun(l: *Limb, b: Block) !bool {
+        const e = l.env;
+        const kv = e.kvOf(b.kind, false);
+        const glob = b.kind == .global;
+        const w = l.o.hq * D;
+        try e.control(kv, glob, b.pos0, lim_rows, l.out[1]);
+        try e.sync();
+        try cuda.memory.download(e.x.c.d, l.out[1].ptr, std.mem.sliceAsBytes(l.host[1][0 .. lim_rows * w]));
+        var differs = false;
+        for (0..lim_rows) |t| {
+            try e.control(kv, glob, b.pos0 + t, 1, l.out[3]);
+            try e.sync();
+            try cuda.memory.download(e.x.c.d, l.out[3].ptr, std.mem.sliceAsBytes(l.host[3][0..w]));
+            differs = differs or !std.mem.eql(u16, l.host[3][0..w], l.host[1][t * w ..][0..w]);
+        }
+        return differs;
+    }
+};
+
+fn put(d: *const cuda.Driver, dst: u64, src: []const u16) !void {
+    const view: cuda.DeviceBuffer = .{ .d = d, .ptr = dst, .len = src.len * 2, .borrowed = true };
+    try view.upload(0, std.mem.sliceAsBytes(src));
+}
+
+/// tf-inkling2-attn --limb: cases L1-L7 on kx (sliding ring at 1000, L7 at 1100, and at 1272 across two split
+/// boundaries; global at 4088 contiguous and paged) at each --kx-s, and the e2614fe control.
+pub fn limb(gpa: std.mem.Allocator, io: std.Io, o0: Opts) !u8 {
+    _ = io;
+    var o = o0;
+    o.context = lim_ctx;
+    var arena = std.heap.ArenaAllocator.init(gpa);
+    defer arena.deinit();
+    const a = arena.allocator();
+    var prng = std.Random.DefaultPrng.init(o.seed);
+    const rng = prng.random();
+    var own: Own = undefined;
+    var env: Env = undefined;
+    try setup(gpa, a, &own, &env, o, &.{0}, lim_ctx, rng);
+    defer own.deinit(gpa);
+    own.pool = try ck.makePool(gpa, &own.driver, rng, &env.x, o);
+    const d = &own.driver;
+    const nq = lim_ctx * o.hq * D;
+    const nk = lim_ctx * o.hk * D;
+    var l: Limb = .{ .gpa = gpa, .env = &env, .own = &own, .o = o, .h = undefined, .base = undefined, .out = undefined, .host = undefined };
+    for ([_]*Host{ &l.h, &l.base }) |h| h.* = .{ .q = try a.alloc(u16, nq), .rel = try a.alloc(u16, lim_ctx * o.hq * dr), .k = try a.alloc(u16, nk), .v = try a.alloc(u16, nk) };
+    try cuda.memory.download(d, env.q.ptr, std.mem.sliceAsBytes(l.base.q));
+    try cuda.memory.download(d, env.rel.ptr, std.mem.sliceAsBytes(l.base.rel));
+    try cuda.memory.download(d, env.x.b.k, std.mem.sliceAsBytes(l.base.k));
+    try cuda.memory.download(d, env.x.b.v, std.mem.sliceAsBytes(l.base.v));
+    for (&l.out, &l.host) |*m, *h| {
+        m.* = Mat.of(try env.x.b.zeroed(gpa, d, lim_rows * o.hq * D * 2), lim_rows, o.hq * D, .bf16);
+        h.* = try a.alloc(u16, lim_rows * o.hq * D);
+    }
+    const clean_out = try a.alloc(u16, lim_rows * o.hq * D);
+    const w = o.hq * D;
+    const group = o.hq / o.hk;
+    var cb: [160]u8 = undefined;
+    own.k.attn.form = .kx;
+    own.k.attn.kxo = .{ .s = o.kx_s[0] };
+    std.debug.print("{s}\n", .{own.k.attn.census(&cb)});
+    var passed: usize = 0;
+    var ctl_failed: usize = 0;
+    // DIGEST limb: sha256 over every case's clean run and kx default-dispatch run, in run order
+    var dh = std.crypto.hash.sha2.Sha256.init(.{});
+    for (std.enums.values(Case), 0..) |c, ci| {
+        var ok = true;
+        var why: [256]u8 = undefined;
+        var ww: std.Io.Writer = .fixed(&why);
+        for (o.kx_s) |s| for (limbBlocks(c)) |b| {
+            const glob = b.kind == .global;
+            // the clean run (cases with one)
+            const has_clean = c != .L1;
+            if (has_clean) {
+                plant(&l.h, &l.base, c, true, b.pos0, o.hq, o.hk, glob);
+                try l.upload(c, true);
+                try env.core(.kx, .{ .s = s }, false, env.kvOf(b.kind, b.pg), glob, b.pos0, lim_rows, l.out[0]);
+                try env.sync();
+                try cuda.memory.download(d, l.out[0].ptr, std.mem.sliceAsBytes(clean_out));
+                dh.update(std.mem.sliceAsBytes(clean_out));
+            }
+            plant(&l.h, &l.base, c, false, b.pos0, o.hq, o.hk, glob);
+            try l.upload(c, false);
+            var bad: usize = 0;
+            const dl = try l.kxRun(b, s, &bad);
+            const got = l.host[0][0 .. lim_rows * w];
+            dh.update(std.mem.sliceAsBytes(got));
+            var req = true;
+            switch (c) {
+                .L1 => req = dl[1] > 0,
+                .L2, .L3 => req = dl[2] > 0 and std.mem.eql(u16, got, clean_out),
+                .L4 => {
+                    req = dl[0] == 1;
+                    for (0..lim_rows) |t| for (0..o.hq) |h| {
+                        const x = got[t * w + h * D ..][0..D];
+                        const y = clean_out[t * w + h * D ..][0..D];
+                        if (t == 7 and h == 0) {
+                            for (x) |v| req = req and v == 0x7fc0;
+                        } else req = req and std.mem.eql(u16, x, y);
+                    };
+                },
+                .L5 => for (0..lim_rows) |t| for (0..o.hq) |h| {
+                    const x = got[t * w + h * D ..][0..D];
+                    if (t < 12) {
+                        req = req and std.mem.eql(u16, x, clean_out[t * w + h * D ..][0..D]);
+                    } else for (x, 0..) |v, col| {
+                        req = req and if (h < group and col == 5) v == 0x7fc0 else finite16(v);
+                    }
+                },
+                .L6 => for (0..lim_rows) |t| for (0..o.hq) |h| {
+                    const x = got[t * w + h * D ..][0..D];
+                    if (t < 10) {
+                        req = req and std.mem.eql(u16, x, clean_out[t * w + h * D ..][0..D]);
+                    } else for (x) |v| {
+                        req = req and if (h < group) v == 0x7fc0 else finite16(v);
+                    }
+                },
+                .L7 => req = dl[0] == 0 and dl[2] == 0 and std.mem.eql(u16, got, clean_out),
+            }
+            if (bad > 0 or !req) {
+                ok = false;
+                ww.print(" [S={d} {t}{s} pos0 {d}: {d} row/form pairs differ from solo, case rule {s}; counters {d}/{d}/{d}]", .{ s, b.kind, if (b.pg) " paged" else "", b.pos0, bad, if (req) "held" else "FAILED", dl[0], dl[1], dl[2] }) catch {};
+            }
+        };
+        if (ok) passed += 1;
+        std.debug.print("LIMB {s}: {s}{s}\n", .{ case_names[ci], if (ok) "PASS" else "FAIL", ww.buffered() });
+        // the control: e2614fe's block-wide fallback must couple a row to its block-mates (or to the stale bytes)
+        if (std.mem.indexOfScalar(Case, &control_cases, c) != null) {
+            var failed_as_required = false;
+            for (limbBlocks(c)) |b| {
+                if (b.pg or (c == .L7 and b.kind == .global)) continue;
+                const glob = b.kind == .global;
+                var clean_ctl: ?[]u16 = null;
+                if (c != .L1) {
+                    plant(&l.h, &l.base, c, true, b.pos0, o.hq, o.hk, glob);
+                    try l.upload(c, true);
+                    try env.control(env.kvOf(b.kind, false), glob, b.pos0, lim_rows, l.out[2]);
+                    try env.sync();
+                    try cuda.memory.download(d, l.out[2].ptr, std.mem.sliceAsBytes(l.host[2][0 .. lim_rows * w]));
+                    clean_ctl = l.host[2][0 .. lim_rows * w];
+                }
+                plant(&l.h, &l.base, c, false, b.pos0, o.hq, o.hk, glob);
+                try l.upload(c, false);
+                var differs = try l.controlRun(b);
+                if (clean_ctl) |cc| {
+                    // rows the plant cannot reach in the case's semantics must equal the clean run
+                    const reach: usize = switch (c) {
+                        .L2, .L3, .L7 => 0, // whole output = the clean run
+                        .L5 => 12, // rows 0-11
+                        else => lim_rows,
+                    };
+                    for (0..lim_rows) |t| if (t < reach or reach == 0) {
+                        differs = differs or !std.mem.eql(u16, l.host[1][t * w ..][0..w], cc[t * w ..][0..w]);
+                    };
+                }
+                failed_as_required = failed_as_required or differs;
+            }
+            if (failed_as_required) ctl_failed += 1;
+            std.debug.print("LIMB control {s} (e2614fe): {s}\n", .{ case_names[ci], if (failed_as_required) "failed as required" else "DID NOT FAIL" });
+        }
+    }
+    const n_cases = std.enums.values(Case).len;
+    var dg: [32]u8 = undefined;
+    dh.final(&dg);
+    std.debug.print("DIGEST limb: kx sha256 {s}\n", .{std.fmt.bytesToHex(dg, .lower)});
+    own.k.attn.printExceptions(d);
+    std.debug.print("LIMB summary: {d}/{d} PASS, control {d}/{d} failed as required\n", .{ passed, n_cases, ctl_failed, control_cases.len });
+    return if (passed == n_cases and ctl_failed == control_cases.len) 0 else 1;
+}
diff --git a/zig/src/families/inkling2/cuda_attn_main.zig b/zig/src/families/inkling2/cuda_attn_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..68557ed220e5d8589f27425c8ece99fbecee9b0b
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_attn_main.zig
@@ -0,0 +1,323 @@
+//! tf-inkling2-attn: G-attn's ops alone on one GPU (cuda_attn.zig `heads` and `core`) over a whole prompt at several
+//! forward sizes, from an inkling2_op_ref.py / inkling2_attn_check.py capture of the prompt from position 0.
+//!
+//! For layer L the capture gives torch's op inputs and outputs: attn.project in (x, or xq, xk, xv), attn.heads in
+//! (q, kc, vc, rel) and out (q, k, v, rel), attn.core in (sink, gate), attn.out in (o). Each forward size N (and each
+//! form of `core`) gets a fresh stream: forwards of N rows run `project` and `output` on torch's inputs, `heads` on
+//! torch's inputs, write torch's k', v' to the cache (cuda_state.zig `kvWrite`) and run `core` on torch's q', rel',
+//! sink and gate, so each op is measured alone and every run sees the same inputs: a row's outputs must have the
+//! same bits at every N and form. Outputs go to OUT as <op>.<form>.<N>.<tensor> (op project, heads, core, out),
+//! compared by tools/zig/inkling2_attn_check.py compare. --pos-offset P runs `heads` alone at
+//! positions P .. P + T - 1 (log scaling active past 128,000); `core` needs a stream from position 0.
+//! --op-check and --bench (cuda_attn_check.zig): `core`'s paths against each other on pseudo-random inputs.
+//! --oracle (cuda_attn_oracle.zig): `core`'s forms and kx against relbias_attention_ref.zig on synthetic inputs;
+//! --oracle --capture (cuda_attn_oracle_real.zig): the same on one real layer's inputs (a core-inputs file).
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const ic = @import("inkling2_cuda");
+const check = @import("cuda_attn_check.zig");
+const oracle = @import("cuda_attn_oracle.zig");
+const oracle_real = @import("cuda_attn_oracle_real.zig");
+
+const attn = ic.attn;
+const Mat = ic.ops.Mat;
+const D = ic.weights.head_dim;
+
+const usage =
+    \\usage: tf-inkling2-attn <model dir> <capture.safetensors> <out.safetensors> --layer L [options]
+    \\  --chunks N,N,...   forward sizes (default 1,8,16,2048)
+    \\  --forms F,F        core's forms: kx (the default), v01 (v0.1's core, its own plan), fused, split (v0.1's forced)
+    \\  --rows T           the prompt's first T rows (default all the capture holds)
+    \\  --pos-offset P     positions P .. P + T - 1 (default 0)
+    \\  --scratch-gib G    device scratch an op may take (default 2)
+    \\The GPU is the first visible device (set CUDA_VISIBLE_DEVICES).
+    \\
+;
+
+const Opts = struct {
+    dir: []const u8,
+    cap: []const u8,
+    out: []const u8,
+    layer: ?u32 = null,
+    chunks: []const usize = &.{ 1, 8, 16, 2048 },
+    forms: []const attn.Form = &.{.kx},
+    rows: usize = 0,
+    pos_offset: usize = 0,
+    scratch_gib: usize = 2,
+};
+
+fn parse(a: std.mem.Allocator, args: []const [:0]const u8) !?Opts {
+    if (args.len < 4) return null;
+    var o: Opts = .{ .dir = args[1], .cap = args[2], .out = args[3] };
+    var i: usize = 4;
+    while (i + 1 < args.len) : (i += 2) {
+        const k = args[i];
+        const v = args[i + 1];
+        if (std.mem.eql(u8, k, "--layer")) {
+            o.layer = try std.fmt.parseInt(u32, v, 10);
+        } else if (std.mem.eql(u8, k, "--chunks")) {
+            var list: std.ArrayList(usize) = .empty;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| try list.append(a, try std.fmt.parseInt(usize, x, 10));
+            o.chunks = list.items;
+        } else if (std.mem.eql(u8, k, "--forms")) {
+            var list: std.ArrayList(attn.Form) = .empty;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| try list.append(a, std.meta.stringToEnum(attn.Form, x) orelse return null);
+            o.forms = list.items;
+        } else if (std.mem.eql(u8, k, "--rows")) {
+            o.rows = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--pos-offset")) {
+            o.pos_offset = try std.fmt.parseInt(usize, v, 10);
+        } else if (std.mem.eql(u8, k, "--scratch-gib")) {
+            o.scratch_gib = try std.fmt.parseInt(usize, v, 10);
+        } else return null;
+    }
+    if (i != args.len or o.layer == null) return null;
+    for (o.chunks) |n| if (n == 0) return null;
+    return o;
+}
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    if (args.len >= 2 and std.mem.eql(u8, args[1], "--oracle") and oracle_real.wanted(args)) {
+        const ro = (oracle_real.parse(a, args) catch null) orelse {
+            std.debug.print("{s}", .{oracle_real.usage});
+            return 2;
+        };
+        return oracle_real.run(init.gpa, init.io, ro) catch |e| {
+            std.debug.print("FAIL tf-inkling2-attn --oracle --capture: {t}\n", .{e});
+            return 1;
+        };
+    }
+    if (args.len >= 2 and std.mem.eql(u8, args[1], "--oracle")) {
+        const oo = (oracle.parse(a, args) catch null) orelse {
+            std.debug.print("{s}", .{oracle.usage});
+            return 2;
+        };
+        return oracle.run(init.gpa, init.io, oo) catch |e| {
+            std.debug.print("FAIL tf-inkling2-attn --oracle: {t}\n", .{e});
+            return 1;
+        };
+    }
+    if (args.len >= 2 and (std.mem.eql(u8, args[1], "--op-check") or std.mem.eql(u8, args[1], "--bench") or std.mem.eql(u8, args[1], "--limb"))) {
+        const co = (check.parse(a, args) catch null) orelse {
+            std.debug.print("{s}", .{check.usage});
+            return 2;
+        };
+        return check.run(init.gpa, init.io, co) catch |e| {
+            std.debug.print("FAIL tf-inkling2-attn: {t}\n", .{e});
+            return 1;
+        };
+    }
+    const o = (parse(a, args) catch null) orelse {
+        std.debug.print("{s}{s}{s}{s}", .{ usage, check.usage, oracle.usage, oracle_real.usage });
+        return 2;
+    };
+    return run(a, init.gpa, init.io, o) catch |e| {
+        std.debug.print("FAIL tf-inkling2-attn: {t}\n", .{e});
+        return 1;
+    };
+}
+
+/// A whole-prompt device tensor read from the capture (its first T rows).
+fn upload(gpa: std.mem.Allocator, d: *const cuda.Driver, r: *const ink.st.Reader, name: []const u8, T: usize, cols: usize, own: *std.ArrayList(cuda.DeviceBuffer)) !Mat {
+    const e = r.find(name) orelse {
+        std.log.err("the capture has no {s}", .{name});
+        return error.MissingTensor;
+    };
+    if (e.dtype != .bf16 or e.rank != 2 or e.dim(1) != cols or e.dim(0) < T) return error.UnexpectedCaptureTensor;
+    const host = try gpa.alloc(u8, T * cols * 2);
+    defer gpa.free(host);
+    try r.readInto(e, 0, host);
+    var b = try cuda.DeviceBuffer.fromHost(d, host);
+    errdefer b.free();
+    try own.append(gpa, b);
+    return Mat.of(b.ptr, T, cols, .bf16);
+}
+
+fn alloc(gpa: std.mem.Allocator, d: *const cuda.Driver, rows: usize, cols: usize, own: *std.ArrayList(cuda.DeviceBuffer)) !Mat {
+    var b = try cuda.DeviceBuffer.alloc(d, rows * cols * 2);
+    errdefer b.free();
+    try b.fill8(0, null);
+    try own.append(gpa, b);
+    return Mat.of(b.ptr, rows, cols, .bf16);
+}
+
+fn rowsOf(r: *const ink.st.Reader, name: []const u8) ?usize {
+    const e = r.find(name) orelse return null;
+    return @intCast(e.dim(0));
+}
+
+fn run(a: std.mem.Allocator, gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    const clock = std.Io.Clock.awake;
+    const L = o.layer.?;
+    var cap = try ink.st.Reader.open(gpa, io, o.cap);
+    defer cap.close();
+    var d: ink.Diag = .{};
+    var model = ink.describe.Model.fromDir(gpa, io, o.dir, .{ .world = 1 }, &d) catch |e| {
+        std.debug.print("FAIL tf-inkling2-attn: {t}: {s}\n", .{ e, d.text() });
+        return 1;
+    };
+    defer model.deinit();
+    var nb: [96]u8 = undefined;
+    const avail = rowsOf(&cap, try std.fmt.bufPrint(&nb, "op.{d}.attn.heads.in.q", .{L})) orelse {
+        std.debug.print("the capture has no layer {d} attention\n", .{L});
+        return 2;
+    };
+    const T = if (o.rows == 0) avail else @min(o.rows, avail);
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    var gemms = try ic.ops.Gemms.init(gpa, &driver);
+    defer gemms.deinit();
+    var scratch = try ic.ops.Scratch.init(&driver, o.scratch_gib << 30);
+    defer scratch.deinit();
+    var t0 = clock.now(io).toNanoseconds();
+    var w = try ic.weights.load(gpa, io, &driver, o.dir, &model, .{ .lo = L, .hi = L + 1 }, &ic.forward.prepare);
+    defer w.deinit();
+    const l = w.layer(L);
+    std.debug.print("layer {d} ({s}) loaded in {d:.1} s; {d} rows at positions {d}..{d}\n", .{ L, if (l.global) "global" else "sliding", secs(clock.now(io).toNanoseconds() - t0), T, o.pos_offset, o.pos_offset + T - 1 });
+    const hq: usize = l.hq;
+    const hk: usize = l.hk;
+    const dr = ic.weights.d_rel;
+    var own: std.ArrayList(cuda.DeviceBuffer) = .empty;
+    defer {
+        for (own.items) |*b| b.free();
+        own.deinit(gpa);
+    }
+    const p = "op.{d}.attn.{s}.{s}.{s}";
+    const in_q = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "in", "q" }), T, hq * D, &own);
+    const in_kc = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "in", "kc" }), T, hk * D, &own);
+    const in_vc = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "in", "vc" }), T, hk * D, &own);
+    const in_rel = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "in", "rel" }), T, hq * dr, &own);
+    const t_q = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "out", "q" }), T, hq * D, &own);
+    const t_k = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "out", "k" }), T, hk * D, &own);
+    const t_v = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "out", "v" }), T, hk * D, &own);
+    const t_rel = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "heads", "out", "rel" }), T, hq * dr, &own);
+    const sink = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "core", "in", "sink" }), T, hq, &own);
+    const gate = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "core", "in", "gate" }), T, hq * D, &own);
+    const hd: attn.Heads = .{ .q = try alloc(gpa, &driver, T, hq * D, &own), .k = try alloc(gpa, &driver, T, hk * D, &own), .v = try alloc(gpa, &driver, T, hk * D, &own), .rel = try alloc(gpa, &driver, T, hq * dr, &own) };
+    const o_out = try alloc(gpa, &driver, T, hq * D, &own);
+    // the projections: attn.project on torch's normed sources, attn.out on torch's o
+    const H = ic.weights.hidden;
+    const src_names: []const []const u8 = if (l.global) &.{ "xq", "xk", "xv" } else &.{"x"};
+    var xs: [3]Mat = undefined;
+    for (src_names, 0..) |n, i| xs[i] = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "project", "in", n }), T, H, &own);
+    if (!l.global) xs[1] = xs[0];
+    if (!l.global) xs[2] = xs[0];
+    const in_o = try upload(gpa, &driver, &cap, try std.fmt.bufPrint(&nb, p, .{ L, "out", "in", "o" }), T, hq * D, &own);
+    const taps = ic.weights.taps;
+    const pj: attn.Proj = .{
+        .q = try alloc(gpa, &driver, T, hq * D, &own),
+        .k = try alloc(gpa, &driver, T, hk * D, &own),
+        .v = try alloc(gpa, &driver, T, hk * D, &own),
+        .rel = try alloc(gpa, &driver, T, hq * dr, &own),
+        .gate = try alloc(gpa, &driver, T, hq * D, &own),
+        .sink = try alloc(gpa, &driver, T, hq, &own),
+        .dk = if (l.global) try alloc(gpa, &driver, T, hk * taps, &own) else .{},
+        .dv = if (l.global) try alloc(gpa, &driver, T, hk * taps, &own) else .{},
+    };
+    const ao = try alloc(gpa, &driver, T, H, &own);
+    // the cache: room for every position (global) or the ring the forward needs (sliding), as cuda_state.zig sizes it
+    const kv_max = try alloc(gpa, &driver, T, hk * D, &own);
+    const vv_max = try alloc(gpa, &driver, T, hk * D, &own);
+    const c: ic.ops.Ctx = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch };
+    var wr = ink.st.Writer.init(gpa);
+    defer wr.deinit();
+    for (o.forms) |form| {
+        k.attn.form = form;
+        for (o.chunks) |n0| {
+            const N = @min(n0, T);
+            const slots = if (l.global) T else @min(T, attn.window - 1 + N);
+            const kv: attn.Kv = .{ .k = kv_max.ptr, .v = vv_max.ptr, .slots = slots, .heads = hk, .window = if (l.global) 0 else attn.window };
+            try c.zero(kv.k, T * hk * D * 2);
+            try c.zero(kv.v, T * hk * D * 2);
+            try c.zero(o_out.ptr, o_out.bytes());
+            try stream.synchronize();
+            var heads_ns: i96 = 0;
+            var proj_ns: i96 = 0;
+            var core_ns: i96 = 0;
+            var start: usize = 0;
+            var forwards: usize = 0;
+            while (start < T) : (start += N) {
+                const R = @min(N, T - start);
+                const pos0 = o.pos_offset + start;
+                scratch.reset();
+                t0 = clock.now(io).toNanoseconds();
+                try attn.heads(&c, l, pos0, null, in_q.slice(start, R), in_kc.slice(start, R), in_vc.slice(start, R), in_rel.slice(start, R), .{ .q = hd.q.slice(start, R), .k = hd.k.slice(start, R), .v = hd.v.slice(start, R), .rel = hd.rel.slice(start, R) });
+                try stream.synchronize();
+                const t1 = clock.now(io).toNanoseconds();
+                heads_ns += t1 - t0;
+                const sl = struct {
+                    fn of(m: Mat, a0: usize, n: usize) Mat {
+                        return if (m.rows == 0) m else m.slice(a0, n);
+                    }
+                };
+                try attn.project(&c, l, xs[0].slice(start, R), xs[1].slice(start, R), xs[2].slice(start, R), .{
+                    .q = pj.q.slice(start, R),
+                    .k = pj.k.slice(start, R),
+                    .v = pj.v.slice(start, R),
+                    .rel = pj.rel.slice(start, R),
+                    .gate = pj.gate.slice(start, R),
+                    .sink = pj.sink.slice(start, R),
+                    .dk = sl.of(pj.dk, start, R),
+                    .dv = sl.of(pj.dv, start, R),
+                });
+                try attn.output(&c, l, in_o.slice(start, R), ao.slice(start, R));
+                try stream.synchronize();
+                proj_ns += clock.now(io).toNanoseconds() - t1;
+                scratch.reset();
+                forwards += 1;
+                // a stream at an offset has no keys before it: only `heads` (the log scaling) is tested there
+                if (o.pos_offset > 0) continue;
+                try ic.state.kvWrite(&c, kv, pos0, null, t_k.slice(start, R), t_v.slice(start, R));
+                try stream.synchronize();
+                const t2 = clock.now(io).toNanoseconds();
+                try attn.core(&c, l, pos0, null, t_q.slice(start, R), t_rel.slice(start, R), sink.slice(start, R), gate.slice(start, R), kv, o_out.slice(start, R));
+                try stream.synchronize();
+                core_ns += clock.now(io).toNanoseconds() - t2;
+            }
+            const used = attn.formOf(form, @min(N, T), attn.splits(kv, o.pos_offset + T - @min(N, T), @min(N, T)).count, hq);
+            std.debug.print("form {t} (last forward {t}), forwards of {d}: {d} forwards; project+out {d:.3} ms, heads {d:.3} ms, core {d:.3} ms ({d:.3} ms a forward); scratch peak {d} MiB\n", .{ form, used, N, forwards, ms(proj_ns), ms(heads_ns), ms(core_ns), ms(core_ns) / @as(f64, @floatFromInt(forwards)), scratch.peak >> 20 });
+            const outs = [_]struct { []const u8, []const u8, Mat }{
+                .{ "heads", "q", hd.q },       .{ "heads", "k", hd.k },         .{ "heads", "v", hd.v },         .{ "heads", "rel", hd.rel },
+                .{ "core", "o", o_out },       .{ "project", "q", pj.q },       .{ "project", "k", pj.k },       .{ "project", "v", pj.v },
+                .{ "project", "rel", pj.rel }, .{ "project", "gate", pj.gate }, .{ "project", "sink", pj.sink }, .{ "project", "dk", pj.dk },
+                .{ "project", "dv", pj.dv },   .{ "out", "ao", ao },
+            };
+            for (outs) |x| {
+                if (o.pos_offset > 0 and std.mem.eql(u8, x[0], "core")) continue;
+                if (x[2].rows == 0) continue;
+                const host = try gpa.alloc(u8, x[2].bytes());
+                try cuda.memory.download(&driver, x[2].ptr, host);
+                const name = try std.fmt.allocPrint(a, "{s}.{t}.{d}.{s}", .{ x[0], form, N, x[1] });
+                try wr.addOwned(name, .bf16, &.{ x[2].rows, x[2].cols }, host);
+            }
+        }
+    }
+    try wr.setMeta("tool", "tf-inkling2-attn");
+    try wr.setMeta("layer", try std.fmt.allocPrint(a, "{d}", .{L}));
+    try wr.setMeta("rows", try std.fmt.allocPrint(a, "{d}", .{T}));
+    try wr.setMeta("pos_offset", try std.fmt.allocPrint(a, "{d}", .{o.pos_offset}));
+    try wr.setMeta("capture", std.fs.path.basename(o.cap));
+    try wr.write(io, o.out);
+    std.debug.print("wrote {s}\n", .{o.out});
+    k.attn.printExceptions(&driver);
+    return 0;
+}
+
+fn secs(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-9;
+}
+
+fn ms(ns: i96) f64 {
+    return @as(f64, @floatFromInt(ns)) * 1e-6;
+}
diff --git a/zig/src/families/inkling2/cuda_attn_oracle.zig b/zig/src/families/inkling2/cuda_attn_oracle.zig
new file mode 100644
index 0000000000000000000000000000000000000000..af02f4f964ec0c37fed9725a5733dce760011ff6
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_attn_oracle.zig
@@ -0,0 +1,564 @@
+//! tf-inkling2-attn --oracle: the fork's attention cores (v0.1 eager as `fused`, `rows` and `prev`; kx's forms as `kx`
+//! (default dispatch), `kx-c1` (column split 1), `kx-split` (kx-split wherever it fits) and `kx-walk`) on synthetic
+//! inputs at the real model's shapes against relbias_attention_ref.zig (oracle spec section 6). Every (row, query
+//! head) gets the reference's float64 point and the range the fp32 form allows (replayForm), kx's own form's range
+//! (kxForm sliding, kxSplitForm at --kx-s global, q'' with subnormal elements as +0 as kx loads them) and
+//! kxFallbackForm's, and the fork's eager core replayed on the host in its own order
+//! (k_exp 1, 1 +- 2^-22). Each forward runs at 48/8 (W = 1) and as the four 12/2 rank slices (W = 4), on the engine's
+//! layouts: sliding layers a ring of 1023 + prompt_rows slots, global layers a slot a position.
+//!
+//! Per case (kind, profile, p0, R) a line per run (implementation x layout): outputs, inside replayForm, inside kx's
+//! forms, the range's decided / ranged / nonfinite, the most bf16 steps and fp32 ulps outside and from the point, the
+//! NaN / Inf class mismatches, outputs equal to the eager replay and the most steps from it (head-scale steps: bf16
+//! steps at max over columns of sigmoid(gate) * sum p |v|, the head's output before cancellation); then the byte equality
+//! of runs whose plans differ, slices against unsplit, and (kx-fallback) rows without the plant against kx-safe.
+//! The masked-value panel puts a NaN value row at three places and reports which rows each form changes.
+//! Exit 1 when eager runs with different plans differ, an implementation's rank slices differ from its unsplit run, kx's
+//! forms differ from each other, kx is outside its own form, or the reference's escape fires or it refuses a head.
+const std = @import("std");
+const cuda = @import("cuda");
+const ic = @import("inkling2_cuda");
+const host = @import("cuda_attn_oracle_host.zig");
+const rb = @import("core").relbias_attention_ref;
+
+const attn = ic.attn;
+const Mat = ic.ops.Mat;
+const D = host.D;
+const HQ = host.HQ;
+const HK = host.HK;
+const Profile = host.Profile;
+const Kind = host.Kind;
+const Acc = host.Acc;
+
+pub const usage =
+    \\usage: tf-inkling2-attn --oracle [options]   (synthetic inputs against relbias_attention_ref.zig, no model)
+    \\  --profiles P,...   clip, diffuse, planted, kx-safe, kx-fallback (default all; kx-fallback needs kx-safe before it)
+    \\  --kinds K,...      sliding, global (default both)
+    \\  --positions P,...  forwards' first positions (default 0,1,31,255,256,1022,1023,1024,1025,2047,4095,16384,131072)
+    \\  --rows R,...       forward rows, at most 64 (default 1,8,16,64)
+    \\  --threads N        host threads for the ranges (default 32)
+    \\  --panel 0|1        the masked-value panel (default 1)
+    \\  --kx-s S           kx's key split (default cuda_attn.zig kx_split_keys)
+    \\The GPU is the first visible device (CUDA_VISIBLE_DEVICES).
+    \\
+;
+
+pub const Opts = struct {
+    profiles: []const Profile = &.{ .clip, .diffuse, .planted, .@"kx-safe", .@"kx-fallback" },
+    kinds: []const Kind = &.{ .sliding, .global },
+    positions: []const usize = &.{ 0, 1, 31, 255, 256, 1022, 1023, 1024, 1025, 2047, 4095, 16384, 131072 },
+    rows: []const usize = &.{ 1, 8, 16, 64 },
+    threads: usize = 32,
+    panel: bool = true,
+    s: usize = attn.kx_split_keys,
+};
+
+fn enums(comptime T: type, a: std.mem.Allocator, v: []const u8) !?[]T {
+    var out: std.ArrayList(T) = .empty;
+    var it = std.mem.splitScalar(u8, v, ',');
+    while (it.next()) |x| try out.append(a, std.meta.stringToEnum(T, x) orelse return null);
+    return out.items;
+}
+
+pub fn ints(a: std.mem.Allocator, v: []const u8) ![]usize {
+    var out: std.ArrayList(usize) = .empty;
+    var it = std.mem.splitScalar(u8, v, ',');
+    while (it.next()) |x| try out.append(a, try std.fmt.parseInt(usize, x, 10));
+    return out.items;
+}
+
+pub fn parse(a: std.mem.Allocator, args: []const [:0]const u8) !?Opts {
+    var o: Opts = .{};
+    var i: usize = 2;
+    while (i + 1 < args.len) : (i += 2) {
+        const k = args[i];
+        const v = args[i + 1];
+        const eql = std.mem.eql;
+        if (eql(u8, k, "--profiles")) o.profiles = (try enums(Profile, a, v)) orelse return null else if (eql(u8, k, "--kinds")) o.kinds = (try enums(Kind, a, v)) orelse return null else if (eql(u8, k, "--positions")) o.positions = try ints(a, v) else if (eql(u8, k, "--rows")) o.rows = try ints(a, v) else if (eql(u8, k, "--threads")) o.threads = try std.fmt.parseInt(usize, v, 10) else if (eql(u8, k, "--panel")) o.panel = !eql(u8, v, "0") else if (eql(u8, k, "--kx-s")) o.s = try std.fmt.parseInt(usize, v, 10) else return null;
+    }
+    if (i != args.len or o.threads == 0 or std.mem.indexOfScalar(usize, &attn.kx_splits, o.s) == null) return null;
+    for (o.rows) |R| if (R == 0 or R > max_rows) return null;
+    return o;
+}
+
+const max_rows = 64;
+pub const ring = attn.window - 1 + ic.engine.prompt_rows;
+comptime {
+    std.debug.assert(host.sliding_split == attn.kx_sliding_split);
+}
+/// Layouts: 0 the unsplit 48/8, 1 + r rank r's 12/2 (q heads 12r .. 12r + 11, kv heads 2r, 2r + 1).
+pub const layouts = 5;
+pub const Impl = enum { fused, rows, prev, kx, @"kx-c1", @"kx-split", @"kx-walk" };
+
+/// kx's forms (each must give kx's bytes).
+pub fn isKx(i: Impl) bool {
+    return @backingInt(i) >= @backingInt(Impl.kx);
+}
+
+pub fn ix(i: Impl) usize {
+    return @backingInt(i);
+}
+pub const impls = std.enums.values(Impl);
+/// Runs: an implementation on the unsplit layout (2i) and on the four slices put together (2i + 1).
+const runs = 2 * impls.len;
+
+pub fn shape(li: usize) [3]usize {
+    return if (li == 0) .{ HQ, HK, 0 } else .{ HQ / 4, HK / 4, li - 1 };
+}
+
+/// The device side: a layout's inputs, caches and an output per implementation.
+const Dev = struct {
+    q: [layouts]Mat,
+    rel: [layouts]Mat,
+    sink: [layouts]Mat,
+    gate: [layouts]Mat,
+    k: [layouts]u64,
+    v: [layouts]u64,
+    out: [layouts][impls.len]Mat,
+    proj: u64,
+    slots: usize,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+
+    fn buf(x: *Dev, gpa: std.mem.Allocator, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try b.fill8(0, null);
+        try x.own.append(gpa, b);
+        return b.ptr;
+    }
+
+    fn mat(x: *Dev, gpa: std.mem.Allocator, d: *const cuda.Driver, cols: usize) !Mat {
+        return Mat.of(try x.buf(gpa, d, max_rows * cols * 2), max_rows, cols, .bf16);
+    }
+
+    fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, slots: usize) !Dev {
+        var x: Dev = undefined;
+        x.own = .empty;
+        errdefer x.deinit(gpa);
+        x.slots = slots;
+        x.proj = try x.buf(gpa, d, 16 * host.E * 2);
+        for (0..layouts) |li| {
+            const s = shape(li);
+            x.q[li] = try x.mat(gpa, d, s[0] * D);
+            x.rel[li] = try x.mat(gpa, d, s[0] * 16);
+            x.sink[li] = try x.mat(gpa, d, s[0]);
+            x.gate[li] = try x.mat(gpa, d, s[0] * D);
+            x.k[li] = try x.buf(gpa, d, @max(slots, ring) * s[1] * D * 2);
+            x.v[li] = try x.buf(gpa, d, @max(slots, ring) * s[1] * D * 2);
+            for (&x.out[li]) |*m| m.* = try x.mat(gpa, d, s[0] * D);
+        }
+        return x;
+    }
+
+    fn deinit(x: *Dev, gpa: std.mem.Allocator) void {
+        for (x.own.items) |*b| b.free();
+        x.own.deinit(gpa);
+    }
+
+    fn kv(x: *const Dev, li: usize, kind: Kind) attn.Kv {
+        return .{ .k = x.k[li], .v = x.v[li], .slots = if (kind == .global) x.slots else ring, .heads = shape(li)[1], .window = if (kind == .global) 0 else attn.window };
+    }
+};
+
+pub fn put(d: *const cuda.Driver, dst: u64, bytes: []const u8) !void {
+    const view: cuda.DeviceBuffer = .{ .d = d, .ptr = dst, .len = bytes.len, .borrowed = true };
+    try view.upload(0, bytes);
+}
+
+/// The rows of `src` ([HK][cap][D], positions from ..) for layout li's kv heads into its cache's slots (ring or a
+/// slot a position), through `stage`.
+pub fn putCache(d: *const cuda.Driver, in: *const host.Inputs, src: []const u16, dst: u64, kv: attn.Kv, li: usize, stage: []u16) !void {
+    const s = shape(li);
+    const hk = s[1];
+    const n = in.npos;
+    for (0..n) |i| for (0..hk) |lg| {
+        const g = s[2] * hk + lg;
+        @memcpy(stage[(i * hk + lg) * D ..][0..D], src[(g * in.cap + i) * D ..][0..D]);
+    };
+    const row = hk * D * 2;
+    var i: usize = 0;
+    while (i < n) { // contiguous runs of slots
+        const slot = (in.from + i) % kv.slots;
+        const len = @min(n - i, kv.slots - slot);
+        try put(d, dst + slot * row, std.mem.sliceAsBytes(stage[i * hk * D ..][0 .. len * hk * D]));
+        i += len;
+    }
+}
+
+/// Layout li's q'', r'', sink and gate (its query heads' columns) through `stage`.
+fn putRows(d: *const cuda.Driver, in: *const host.Inputs, x: *const Dev, li: usize, stage: []u16) !void {
+    const s = shape(li);
+    const h0 = s[2] * s[0];
+    for ([_]struct { []const u16, usize, Mat }{ .{ in.q, D, x.q[li] }, .{ in.rel, 16, x.rel[li] }, .{ in.sink, 1, x.sink[li] }, .{ in.gate, D, x.gate[li] } }) |t| {
+        const w = s[0] * t[1];
+        for (0..in.R) |r| @memcpy(stage[r * w ..][0..w], t[0][(r * HQ + h0) * t[1] ..][0..w]);
+        try put(d, t[2].ptr, std.mem.sliceAsBytes(stage[0 .. in.R * w]));
+    }
+}
+
+/// Implementation `impl` (its `attn.core` form, set as `Ctx.runOn` sets it; kx's at key split S) on layout li's shape
+/// for the forward of q.rows rows at p0, with the bias projection at `proj`; its plan.
+pub fn runCore(c: *const ic.ops.Ctx, k: *ic.kernels.Kernels, scratch: *ic.ops.Scratch, impl: Impl, S: usize, li: usize, kind: Kind, proj: u64, kv: attn.Kv, p0: usize, q: Mat, rel: Mat, sink: Mat, gate: Mat, out: Mat) !?attn.Plan {
+    const ka = &k.attn;
+    ka.rows = if (impl == .prev) 0 else attn.max_rows;
+    ka.form = switch (impl) {
+        .fused => .fused,
+        .rows, .prev => .v01,
+        else => .kx,
+    };
+    ka.kxo = switch (impl) {
+        .@"kx-c1" => .{ .s = S, .c = 1 },
+        .@"kx-split" => .{ .s = S, .global = .split },
+        .@"kx-walk" => .{ .s = S, .global = .walk },
+        else => .{ .s = S },
+    };
+    ka.grid = attn.grid_splits;
+    ka.fold_min = attn.fold_splits;
+    const s = shape(li);
+    var l: ic.weights.Layer = .{ .index = 0, .global = kind == .global, .boundary = false, .hq = @intCast(s[0]), .hk = @intCast(s[1]), .nq = 1, .experts = .{ .format = .nvfp4, .lo = 0, .hi = 0 } };
+    l.rel_proj = proj;
+    scratch.reset();
+    try attn.core(c, &l, p0, null, q, rel, sink, gate, kv, out);
+    return attn.plan(ka, q.rows, p0, null, kv, s[0], s[1]);
+}
+
+const Gpu = struct {
+    c: ic.ops.Ctx,
+    k: *ic.kernels.Kernels,
+    scratch: *ic.ops.Scratch,
+    x: *Dev,
+    kx: bool,
+    s: usize,
+
+    /// Implementation `impl` on layout li for the forward of R rows at p0; its plan.
+    fn run(g: *const Gpu, impl: Impl, li: usize, kind: Kind, p0: usize, R: usize) !?attn.Plan {
+        const x = g.x;
+        return runCore(&g.c, g.k, g.scratch, impl, g.s, li, kind, x.proj, x.kv(li, kind), p0, x.q[li].slice(0, R), x.rel[li].slice(0, R), x.sink[li].slice(0, R), x.gate[li].slice(0, R), x.out[li][ix(impl)].slice(0, R));
+    }
+
+    /// Every implementation on every layout; outputs into outs[run] as [R][HQ][D] (slices put together).
+    fn all(g: *const Gpu, in: *const host.Inputs, plans: *[runs]?attn.Plan, outs: *[runs][]u16, tmp: []u16) !void {
+        for (0..layouts) |li| for (impls) |impl| {
+            if (isKx(impl) and !g.kx) continue;
+            const p = try g.run(impl, li, in.kind, in.p0, in.R);
+            if (li <= 1) plans[2 * ix(impl) + @min(li, 1)] = p;
+        };
+        try g.c.stream.synchronize();
+        for (0..layouts) |li| for (impls) |impl| {
+            if (isKx(impl) and !g.kx) continue;
+            const s = shape(li);
+            const w = s[0] * D;
+            try cuda.memory.download(g.c.d, g.x.out[li][ix(impl)].ptr, std.mem.sliceAsBytes(tmp[0 .. in.R * w]));
+            const o = outs[2 * ix(impl) + @min(li, 1)];
+            for (0..in.R) |r| @memcpy(o[(r * HQ + s[2] * s[0]) * D ..][0..w], tmp[r * w ..][0..w]);
+        };
+    }
+};
+
+/// A pool of host threads over `n` items: f(ctx, item, worker).
+pub fn parallel(threads: usize, n: usize, ctx: anytype, comptime f: anytype) !void {
+    const W = struct {
+        fn go(next: *std.atomic.Value(usize), total: usize, c: @TypeOf(ctx), w: usize) void {
+            while (true) {
+                const i = next.fetchAdd(1, .monotonic);
+                if (i >= total) return;
+                f(c, i, w);
+            }
+        }
+    };
+    var next = std.atomic.Value(usize).init(0);
+    var ts: [128]std.Thread = undefined;
+    const m = @min(threads, ts.len, @max(n, 1));
+    for (ts[0..m], 0..) |*t, w| t.* = try std.Thread.spawn(.{}, W.go, .{ &next, n, ctx, w });
+    for (ts[0..m]) |t| t.join();
+}
+
+/// The host check of one forward: each (row, head) item's ranges against every run's outputs, per worker.
+const Check = struct {
+    in: *const host.Inputs,
+    outs: *const [runs][]u16,
+    have: [runs]bool,
+    kx: bool,
+    s: usize,
+    work: []rb.Work,
+    accs: [][runs]Acc,
+
+    fn item(c: *const Check, i: usize, w: usize) void {
+        const t = i / HQ;
+        const h = i % HQ;
+        var r: host.Ref = .{};
+        r.make(c.in.head(t, h), c.in.geo(), c.kx, c.s, &c.work[w]);
+        for (0..runs) |ri| if (c.have[ri]) {
+            r.check(c.outs[ri][(t * HQ + h) * D ..][0..D], isKx(impls[ri / 2]), &c.accs[w][ri]);
+        };
+    }
+};
+
+fn fillKv(in: *const host.Inputs, i: usize, _: usize) void {
+    in.fillKv(i);
+}
+
+fn fillRow(in: *const host.Inputs, i: usize, _: usize) void {
+    in.fillRow(i);
+}
+
+fn label(ri: usize) [2][]const u8 {
+    return .{ @tagName(impls[ri / 2]), if (ri % 2 == 0) "48/8" else "12/2x4" };
+}
+
+pub fn planText(buf: []u8, p: ?attn.Plan) []const u8 {
+    const x = p orelse return "kx";
+    if (x.form == .kx) return switch (x.kx) {
+        .tile => std.fmt.bufPrint(buf, "kx-{s}{d}", .{ if (x.c == 1) "tile/c" else "dec/c", x.c }) catch "kx-tile",
+        .split => std.fmt.bufPrint(buf, "kx-split/S{d}/c{d}/{d}", .{ x.s, x.c, x.span }) catch "kx-split",
+        .walk => std.fmt.bufPrint(buf, "kx-walk/S{d}/{d}", .{ x.s, x.span }) catch "kx-walk",
+        .none => "kx",
+    };
+    if (x.form != .split) return @tagName(x.form);
+    return std.fmt.bufPrint(buf, "split{s}{s}/{d}", .{ if (x.rows) "+rows" else "", if (x.fold) "+fold" else "", x.span }) catch "split";
+}
+
+fn line(in: *const host.Inputs, ri: usize, plan: ?attn.Plan, a: Acc, eq: []const u8) void {
+    const lb = label(ri);
+    var pb: [48]u8 = undefined;
+    const pt = planText(&pb, plan);
+    std.debug.print("CASE\t{s}\t{s}\t{t}\t{s}\t{t}\t{d}\t{d}\t{d}\t{d}\t{d}/{d}/{d}\t{d}/{d}/{d}\t{d}\t{d:.2}\t{d:.2}\t{d}\t{d:.1}\t{d:.2}\t{d}\t{d}\t{d}\t{d:.2}\t{d}\t{s}\n", .{ lb[0], pt, in.kind, lb[1], in.profile, in.p0, in.R, a.outputs, a.inside, a.kx_in[0], a.kx_in[1], a.kx_in[2], a.stats.decided, a.stats.ranged, a.stats.nonfinite, a.out_steps, a.out_ulps, a.hs_out, a.pt_steps, a.pt_ulps, a.hs_pt, a.class_bad, a.eager_eq, a.eager_steps, a.eager_hs, a.escape, eq });
+    std.debug.print("JSON {{\"impl\":\"{s}\",\"form\":\"{s}\",\"kind\":\"{t}\",\"heads\":\"{s}\",\"profile\":\"{t}\",\"p0\":{d},\"R\":{d},\"outputs\":{d},\"inside_replay\":{d},\"inside_kxform\":{d},\"inside_kxfallback\":{d},\"inside_kx_either\":{d},\"decided\":{d},\"ranged\":{d},\"nonfinite\":{d},\"max_steps_outside\":{d},\"max_ulps32_outside\":{d:.3},\"max_head_steps_outside\":{d:.3},\"max_steps_from_point\":{d},\"max_ulps32_from_point\":{d:.3},\"max_head_steps_from_point\":{d:.3},\"class_mismatch\":{d},\"got_nonfinite\":{d},\"eager_equal\":{d},\"eager_max_steps\":{d},\"eager_max_head_steps\":{d:.3},\"escape\":{d},\"refused\":{d},", .{ lb[0], pt, in.kind, lb[1], in.profile, in.p0, in.R, a.outputs, a.inside, a.kx_in[0], a.kx_in[1], a.kx_in[2], a.stats.decided, a.stats.ranged, a.stats.nonfinite, a.out_steps, a.out_ulps, a.hs_out, a.pt_steps, a.pt_ulps, a.hs_pt, a.class_bad, a.got_nonfinite, a.eager_eq, a.eager_steps, a.eager_hs, a.escape, a.refused });
+    std.debug.print("\"hist_out_head_steps\":[{d},{d},{d},{d},{d},{d}],\"bytes_equal\":\"{s}\"}}\n", .{ a.hist[0], a.hist[1], a.hist[2], a.hist[3], a.hist[4], a.hist[5], eq });
+}
+
+/// Host and device state of a run of the tool.
+const State = struct {
+    gpa: std.mem.Allocator,
+    o: Opts,
+    gpu: Gpu,
+    in: host.Inputs,
+    stage: []u16,
+    outs: [runs][]u16,
+    keep: [runs][]u16,
+    work: []rb.Work,
+    accs: [][runs]Acc,
+    sum: [runs][2][5]Acc = @splat(@splat(@splat(.{}))),
+    failed: usize = 0,
+    /// DIGEST oracle: sha256 a run (implementation x layout) over every case's and panel step's outputs, in run order
+    digest: [runs]std.crypto.hash.sha2.Sha256 = @splat(std.crypto.hash.sha2.Sha256.init(.{})),
+    /// the forward whose kx-safe runs `keep` holds (null: none, or the panel's)
+    kept: ?host.Forward = null,
+
+    /// Inputs for (profile, kind, p0, R) on the host, then on every layout.
+    fn prepare(s: *State, profile: Profile, kind: Kind, p0: usize, R: usize) !void {
+        const in = &s.in;
+        in.profile = profile;
+        in.kind = kind;
+        in.p0 = p0;
+        in.R = R;
+        const lo = rb.keyLo(in.geo(), p0);
+        in.from = if (kind == .global) 0 else lo / 64 * 64; // kx loads 64-key tiles from its first row's window
+        in.npos = p0 + R - in.from;
+        try parallel(s.o.threads, 2 * HK, in, fillKv);
+        in.plant();
+        try parallel(s.o.threads, R * HQ, in, fillRow);
+        const x = s.gpu.x;
+        try put(s.gpu.c.d, x.proj, std.mem.sliceAsBytes(in.proj));
+        for (0..layouts) |li| {
+            const kv = x.kv(li, kind);
+            try putCache(s.gpu.c.d, in, in.k, kv.k, kv, li, s.stage);
+            try putCache(s.gpu.c.d, in, in.v, kv.v, kv, li, s.stage);
+            try putRows(s.gpu.c.d, in, x, li, s.stage);
+        }
+    }
+
+    /// The runs' outputs of this forward (R rows) into their digests.
+    fn hash(s: *State, R: usize) void {
+        for (&s.digest, 0..) |*h, ri| if (s.gpu.kx or !isKx(impls[ri / 2])) {
+            h.update(std.mem.sliceAsBytes(s.outs[ri][0 .. R * HQ * D]));
+        };
+    }
+
+    /// The checks of rows `rows` of the current outputs; per-run totals.
+    fn check(s: *State, rows: usize, only_unsplit: bool) ![runs]Acc {
+        var have: [runs]bool = undefined;
+        for (&have, 0..) |*h, ri| h.* = (s.gpu.kx or !isKx(impls[ri / 2])) and (!only_unsplit or ri % 2 == 0);
+        for (s.accs) |*a| a.* = @splat(.{});
+        const c: Check = .{ .in = &s.in, .outs = &s.outs, .have = have, .kx = s.gpu.kx, .s = s.gpu.s, .work = s.work, .accs = s.accs };
+        try parallel(s.o.threads, rows * HQ, &c, Check.item);
+        var tot: [runs]Acc = @splat(.{});
+        for (s.accs) |a| for (&tot, a) |*t, x| t.add(x);
+        return tot;
+    }
+
+    fn case(s: *State, profile: Profile, kind: Kind, p0: usize, R: usize) !void {
+        try s.prepare(profile, kind, p0, R);
+        var plans: [runs]?attn.Plan = @splat(null);
+        try s.gpu.all(&s.in, &plans, &s.outs, s.stage);
+        s.hash(R);
+        const tot = try s.check(R, false);
+        // byte equality: eager runs pairwise (trivial where layout and plan agree), each slice run against unsplit
+        var eb: [512]u8 = undefined;
+        var w: std.Io.Writer = .fixed(&eb);
+        const n = R * HQ * D;
+        var differ: usize = 0;
+        var equal: usize = 0;
+        var trivial: usize = 0;
+        for (0..6) |a| for (a + 1..6) |b| {
+            if (a % 2 == b % 2 and std.meta.eql(plans[a], plans[b])) {
+                trivial += 1;
+            } else if (std.mem.eql(u16, s.outs[a][0..n], s.outs[b][0..n])) equal += 1 else differ += 1;
+        };
+        w.print("eager pairs: {d} equal, {d} differ, {d} same plan; slices=unsplit:", .{ equal, differ, trivial }) catch {};
+        var slices: [impls.len]usize = @splat(0);
+        for (impls, 0..) |impl, i| if (!isKx(impl) or s.gpu.kx) {
+            slices[i] = host.vectorsDiffer(s.outs[2 * i], s.outs[2 * i + 1], R * HQ);
+            w.print(" {t} {d}", .{ impl, slices[i] }) catch {};
+        };
+        // kx's forms against kx's unsplit run: the same bytes
+        var kx_differ: usize = 0;
+        if (s.gpu.kx) {
+            for (impls, 0..) |impl, i| if (isKx(impl)) {
+                kx_differ += host.vectorsDiffer(s.outs[2 * ix(.kx)], s.outs[2 * i], R * HQ);
+            };
+            w.print("; kx forms=kx: {d} differ", .{kx_differ}) catch {};
+            if (kx_differ > 0) s.failed += 1;
+        }
+        if (profile == .@"kx-fallback" and R > 1) { // rows without the plant against kx-safe's run of them
+            try host.checkBaseline(s.kept, .{ .kind = kind, .p0 = p0, .R = R });
+            w.print("; rows coupled to the plant:", .{}) catch {};
+            for (impls, 0..) |impl, i| if (!isKx(impl) or s.gpu.kx) {
+                var moved: usize = 0;
+                for (0..R) |t| if (t % 16 != 0) {
+                    moved += @intFromBool(!std.mem.eql(u16, s.outs[2 * i][t * HQ * D ..][0 .. HQ * D], s.keep[2 * i][t * HQ * D ..][0 .. HQ * D]));
+                };
+                w.print(" {t} {d}/{d}", .{ impl, moved, R - (R + 15) / 16 }) catch {};
+            };
+        }
+        s.failed += host.byteFailures(differ, &slices);
+        for (tot, 0..) |a, ri| if (a.outputs > 0) {
+            line(&s.in, ri, plans[ri], a, w.buffered());
+            s.sum[ri][@backingInt(kind)][@backingInt(profile)].add(a);
+            if (a.escape > 0 or a.refused > 0) s.failed += 1;
+            // kx's own form for every profile (a subnormal q'' loads as +0, so kx-fallback's rows stay on the tiles)
+            if (isKx(impls[ri / 2]) and a.kx_in[0] != a.outputs) s.failed += 1;
+        };
+        if (profile == .@"kx-safe") {
+            for (s.keep, s.outs) |k, o| @memcpy(k[0..n], o[0..n]);
+            s.kept = .{ .kind = kind, .p0 = p0, .R = R };
+        }
+    }
+
+    /// The masked-value panel: sliding, p0 1024, 8 rows, kx-safe, 48/8: a NaN value row (every kv head) at a stale
+    /// ring slot, at position 0 (before every window, inside kx's first tile), at position 1028 (rows 0-3 cannot see it).
+    fn panel(s: *State) !void {
+        try s.prepare(.@"kx-safe", .sliding, 1024, 8);
+        var plans: [runs]?attn.Plan = @splat(null);
+        try s.gpu.all(&s.in, &plans, &s.outs, s.stage);
+        const n = 8 * HQ * D;
+        for (s.keep, s.outs) |k, o| @memcpy(k[0..n], o[0..n]);
+        s.kept = null;
+        const row = HK * D;
+        const nan = try s.gpa.alloc(u16, row);
+        defer s.gpa.free(nan);
+        @memset(nan, 0x7fc0);
+        const old = try s.gpa.alloc(u16, row);
+        defer s.gpa.free(old);
+        const places = [_]struct { []const u8, usize, ?u64 }{ .{ "stale slot 2000", 2000, null }, .{ "position 0", 0, 0 }, .{ "position 1028", 1028, 1028 } };
+        for (places) |pl| {
+            const at = s.gpu.x.v[0] + pl[1] * row * 2;
+            try cuda.memory.download(s.gpu.c.d, at, std.mem.sliceAsBytes(old));
+            try put(s.gpu.c.d, at, std.mem.sliceAsBytes(nan));
+            if (pl[2]) |p| for (0..HK) |g| @memset(s.in.vRow(g, p), 0x7fc0);
+            try s.gpu.all(&s.in, &plans, &s.outs, s.stage);
+            s.hash(8);
+            const tot = try s.check(8, true);
+            for (impls, 0..) |impl, i| if (!isKx(impl) or s.gpu.kx) {
+                var changed: [8]u8 = @splat('.');
+                for (0..8) |t| {
+                    const got = s.outs[2 * i][t * HQ * D ..][0 .. HQ * D];
+                    if (!std.mem.eql(u16, got, s.keep[2 * i][t * HQ * D ..][0 .. HQ * D])) changed[t] = 'c';
+                    for (got) |x| if (x & 0x7f80 == 0x7f80 and x & 0x7f != 0) {
+                        changed[t] = 'N';
+                        break;
+                    };
+                }
+                var pb: [48]u8 = undefined;
+                const a = tot[2 * i];
+                std.debug.print("PANEL\t{s}\t{t}\t{s}\trows {s}\tinside {d}/{d}\tclass mismatch {d}\tnonfinite points {d}\n", .{ pl[0], impl, planText(&pb, plans[2 * i]), &changed, a.inside, a.outputs, a.class_bad, a.stats.nonfinite });
+            };
+            try put(s.gpu.c.d, at, std.mem.sliceAsBytes(old));
+            if (pl[2] != null) for (0..HK) |g| s.in.fillKv(HK + g); // the host's values again
+        }
+    }
+};
+
+pub fn run(gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    try host.checkProfiles(o.profiles); // before any GPU work: kx-fallback compares with kx-safe's run of its forward
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    var gemms = try ic.ops.Gemms.init(gpa, &driver);
+    defer gemms.deinit();
+    var top: usize = 1024 + 8;
+    var most: usize = 1;
+    for (o.positions) |p| for (o.rows) |R| {
+        top = @max(top, p + R);
+        most = @max(most, R);
+    };
+    const kx = k.attn.kx != null;
+    const form = k.attn.form;
+    k.attn.form = .v01;
+    var need = @max(attn.kx_split_cap, attn.kxNeed(.{ .s = o.s }, HQ, top, max_rows, 0), attn.kxNeed(.{ .s = o.s }, HQ / 4, top, max_rows, 0));
+    for ([_][2]usize{ .{ HQ, HK }, .{ HQ / 4, HK / 4 } }) |s| need = @max(need, attn.scratchNeed(&k.attn, s[0], s[1], top, max_rows, 0));
+    k.attn.form = form;
+    var scratch = try ic.ops.Scratch.init(&driver, need + (16 << 20));
+    defer scratch.deinit();
+    var x = try Dev.init(gpa, &driver, top);
+    defer x.deinit(gpa);
+    var st: State = .{ .gpa = gpa, .o = o, .gpu = .{ .c = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch }, .k = &k, .scratch = &scratch, .x = &x, .kx = kx, .s = o.s }, .in = try host.Inputs.alloc(gpa, top, max_rows), .stage = undefined, .outs = undefined, .keep = undefined, .work = undefined, .accs = undefined };
+    defer st.in.free(gpa);
+    st.stage = try gpa.alloc(u16, @max(top * HK * D, max_rows * HQ * D));
+    defer gpa.free(st.stage);
+    for (&st.outs, &st.keep) |*a, *b| {
+        a.* = try gpa.alloc(u16, max_rows * HQ * D);
+        b.* = try gpa.alloc(u16, max_rows * HQ * D);
+    }
+    defer for (st.outs, st.keep) |a, b| {
+        gpa.free(a);
+        gpa.free(b);
+    };
+    const nt = @min(o.threads, 128);
+    st.work = try gpa.alloc(rb.Work, nt);
+    defer gpa.free(st.work);
+    for (st.work) |*wk| wk.* = try rb.Work.init(gpa, top + 1);
+    defer for (st.work) |*wk| wk.deinit(gpa);
+    st.accs = try gpa.alloc([runs]Acc, nt);
+    defer gpa.free(st.accs);
+    st.o.threads = nt;
+    k.attn.kxo = .{ .s = o.s };
+    var cb: [160]u8 = undefined;
+    std.debug.print("{s}\n", .{k.attn.census(&cb)});
+    std.debug.print("oracle: kx {s} (S {d}); slots {d} (global), {d} (sliding ring); scratch {d:.1} MiB; {d} host threads\n", .{ if (kx) "loaded" else "not built", o.s, top, ring, @as(f64, @floatFromInt(need)) / (1 << 20), nt });
+    std.debug.print("CASE\timpl\tform\tkind\theads\tprofile\tp0\tR\toutputs\tinside_replay\tinside_kxform/kxfallback/either\tdecided/ranged/nonfinite\tmax_steps_out\tmax_ulps32_out\tmax_head_steps_out\tmax_steps_pt\tmax_ulps32_pt\tmax_head_steps_pt\tclass_bad\teager_equal\teager_max_steps\teager_max_head_steps\tescape\tbytes_equal\n", .{});
+    const clock = std.Io.Clock.awake;
+    const t0 = clock.now(io).toNanoseconds();
+    if (o.panel) try st.panel();
+    for (o.kinds) |kind| for (o.positions) |p0| for (o.rows) |R| for (o.profiles) |pf| try st.case(pf, kind, p0, R);
+    std.debug.print("SUM\timpl\theads\tkind\tprofile\toutputs\tinside_replay\tpct\tinside_kxform\tinside_kxfallback\tinside_kx_either\tmax_steps_out\tmax_ulps32_out\tmax_head_steps_out\tmax_steps_pt\tmax_head_steps_pt\teager_equal_pct\teager_max_steps\teager_max_head_steps\tclass_bad\tescape\toutside_by_head_steps(<=.5,1,2,4,16,more)\n", .{});
+    for (st.sum, 0..) |per, ri| for (per, 0..) |pk, ki| for (pk, 0..) |a, pi| if (a.outputs > 0) {
+        const lb = label(ri);
+        const f: f64 = @floatFromInt(a.outputs);
+        std.debug.print("SUM\t{s}\t{s}\t{t}\t{t}\t{d}\t{d}\t{d:.3}\t{d}\t{d}\t{d}\t{d}\t{d:.2}\t{d:.2}\t{d}\t{d:.2}\t{d:.3}\t{d}\t{d:.2}\t{d}\t{d}\t{d},{d},{d},{d},{d},{d}\n", .{ lb[0], lb[1], @as(Kind, @fromBackingInt(@intCast(ki))), @as(Profile, @fromBackingInt(@intCast(pi))), a.outputs, a.inside, 100 * @as(f64, @floatFromInt(a.inside)) / f, a.kx_in[0], a.kx_in[1], a.kx_in[2], a.out_steps, a.out_ulps, a.hs_out, a.pt_steps, a.hs_pt, 100 * @as(f64, @floatFromInt(a.eager_eq)) / f, a.eager_steps, a.eager_hs, a.class_bad, a.escape, a.hist[0], a.hist[1], a.hist[2], a.hist[3], a.hist[4], a.hist[5] });
+    };
+    for (&st.digest, 0..) |*h, ri| if (kx or !isKx(impls[ri / 2])) {
+        var dg: [32]u8 = undefined;
+        h.final(&dg);
+        const lb = label(ri);
+        std.debug.print("DIGEST oracle\t{s}\t{s}\tsha256 {s}\n", .{ lb[0], lb[1], std.fmt.bytesToHex(dg, .lower) });
+    };
+    k.attn.printExceptions(&driver);
+    std.debug.print("{s} oracle: {d} failed cases; {d:.0} s\n", .{ if (st.failed == 0) "PASS" else "FAIL", st.failed, @as(f64, @floatFromInt(clock.now(io).toNanoseconds() - t0)) * 1e-9 });
+    return if (st.failed == 0) 0 else 1;
+}
diff --git a/zig/src/families/inkling2/cuda_attn_oracle_host.zig b/zig/src/families/inkling2/cuda_attn_oracle_host.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8704dbf87ec6216e7dfe24dacb4eac2455271285
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_attn_oracle_host.zig
@@ -0,0 +1,574 @@
+//! tf-inkling2-attn --oracle, the host half: the synthetic inputs (contract_relbias_attention_host.zig's generator at
+//! the real model, a forward's rows sharing one cache), the fork's eager core replayed in its own order, and each
+//! output's check against relbias_attention_ref.zig's ranges. No GPU.
+const std = @import("std");
+const core = @import("core");
+const rb = core.relbias_attention_ref;
+const ar = core.attention_range;
+const bfr = core.bf16_round;
+
+pub const D = 128;
+pub const E = 1024;
+pub const HQ = 48;
+pub const HK = 8;
+pub const NREP = HQ / HK;
+
+pub const Profile = enum { clip, diffuse, planted, @"kx-safe", @"kx-fallback" };
+pub const Kind = enum { sliding, global };
+const Tag = enum(u64) { q = 1, k, v, rel, proj, gate, sink, dir, sign };
+
+fn mix(x0: u64) u64 {
+    var x = x0 +% 0x9e3779b97f4a7c15;
+    x = (x ^ (x >> 30)) *% 0xbf58476d1ce4e5b9;
+    x = (x ^ (x >> 27)) *% 0x94d049bb133111eb;
+    return x ^ (x >> 31);
+}
+
+/// A value stream per (seed, tensor, position, global head): a rank slice draws exactly the unsplit layout's values.
+fn stream(seed: u64, tag: Tag, pos: u64, head: u64) std.Random.DefaultPrng {
+    return std.Random.DefaultPrng.init(mix(mix(mix(seed ^ @backingInt(tag)) ^ pos) ^ head));
+}
+
+fn bits(x: f64) u16 {
+    return bfr.bits(@floatCast(x));
+}
+
+/// Gaussians of deviation sd, scaled to `norm` when given, rounded to bf16.
+fn normal(seed: u64, tag: Tag, pos: u64, head: u64, norm: ?f64, sd: f64, out: []u16) void {
+    var prng = stream(seed, tag, pos, head);
+    var buf: [D]f64 = undefined;
+    var ss: f64 = 0;
+    for (buf[0..out.len]) |*x| {
+        x.* = prng.random().floatNorm(f64) * sd;
+        ss += x.* * x.*;
+    }
+    const k = if (norm) |nm| nm / @sqrt(ss) else 1;
+    for (out, buf[0..out.len]) |*o, x| o.* = bits(x * k);
+}
+
+/// One forward's inputs: keys and values of positions from .. from + npos - 1 for every kv head ([HK][cap][D]), and
+/// per row t (position p0 + t) and query head: q'', r'', gate [R][HQ][..], sink [R][HQ].
+pub const Inputs = struct {
+    profile: Profile,
+    kind: Kind,
+    p0: u64,
+    R: usize,
+    from: u64,
+    npos: usize,
+    cap: usize,
+    k: []u16,
+    v: []u16,
+    q: []u16,
+    rel: []u16,
+    gate: []u16,
+    sink: []u16,
+    proj: []u16,
+
+    pub fn alloc(gpa: std.mem.Allocator, cap: usize, rows: usize) !Inputs {
+        var in: Inputs = undefined;
+        in.cap = cap;
+        in.k = try gpa.alloc(u16, HK * cap * D);
+        errdefer gpa.free(in.k);
+        in.v = try gpa.alloc(u16, HK * cap * D);
+        errdefer gpa.free(in.v);
+        in.q = try gpa.alloc(u16, rows * HQ * D);
+        errdefer gpa.free(in.q);
+        in.rel = try gpa.alloc(u16, rows * HQ * rb.d_rel);
+        errdefer gpa.free(in.rel);
+        in.gate = try gpa.alloc(u16, rows * HQ * D);
+        errdefer gpa.free(in.gate);
+        in.sink = try gpa.alloc(u16, rows * HQ);
+        errdefer gpa.free(in.sink);
+        in.proj = try gpa.alloc(u16, rb.d_rel * E);
+        return in;
+    }
+
+    pub fn free(in: *Inputs, gpa: std.mem.Allocator) void {
+        for ([_][]u16{ in.k, in.v, in.q, in.rel, in.gate, in.sink, in.proj }) |x| gpa.free(x);
+    }
+
+    pub fn geo(in: *const Inputs) rb.Geo {
+        return .{ .window = if (in.kind == .sliding) 1024 else 0, .extent = E };
+    }
+
+    /// The shape's seed: contract_relbias_attention_host.zig's at the real model; kx-fallback draws kx-safe's values.
+    fn seed(in: *const Inputs) u64 {
+        const p: u64 = if (in.profile == .@"kx-fallback") 3 else @backingInt(in.profile);
+        return mix(p << 16 | @as(u64, @backingInt(in.kind)) << 8 | HQ);
+    }
+
+    fn norm(in: *const Inputs) f64 {
+        return switch (in.profile) {
+            .clip, .planted => 22.6,
+            .diffuse => 3,
+            .@"kx-safe", .@"kx-fallback" => 12,
+        };
+    }
+
+    pub fn kRow(in: *const Inputs, g: usize, pos: u64) []u16 {
+        return in.k[(g * in.cap + @as(usize, @intCast(pos - in.from))) * D ..][0..D];
+    }
+
+    pub fn vRow(in: *const Inputs, g: usize, pos: u64) []u16 {
+        return in.v[(g * in.cap + @as(usize, @intCast(pos - in.from))) * D ..][0..D];
+    }
+
+    /// Row t, query head h as the reference takes it (keys from the row's window start).
+    pub fn head(in: *const Inputs, t: usize, h: usize) rb.Head {
+        const pos = in.p0 + t;
+        const lo = rb.keyLo(in.geo(), pos);
+        const g = h / NREP;
+        const a = (g * in.cap + @as(usize, @intCast(lo - in.from))) * D;
+        const n: usize = @intCast(pos - lo + 1);
+        const i = t * HQ + h;
+        return .{ .pos = pos, .base = lo, .q = in.q[i * D ..][0..D], .k = in.k[a..][0 .. n * D], .v = in.v[a..][0 .. n * D], .rel = in.rel[i * rb.d_rel ..][0..rb.d_rel], .proj = in.proj, .sink = in.sink[i], .gate = in.gate[i * D ..][0..D] };
+    }
+
+    /// Keys and values of kv head g (item g) or the values (item HK + g), positions from .. from + npos - 1.
+    pub fn fillKv(in: *const Inputs, item: usize) void {
+        const g = item % HK;
+        const s = in.seed();
+        for (0..in.npos) |i| {
+            const j = in.from + i;
+            if (item < HK) normal(s, .k, j, g, in.norm(), 1, in.kRow(g, j)) else normal(s, .v, j, g, null, 1, in.vRow(g, j));
+        }
+    }
+
+    /// planted: keys at distances 1022 .. 1025 from the first row share the group's direction with its q heads
+    /// (values s_g twice, then -s_g); the bias columns, as the host test sets them.
+    pub fn plant(in: *const Inputs) void {
+        const s = in.seed();
+        var col: [rb.d_rel]u16 = undefined;
+        for (0..E) |c| {
+            normal(s, .proj, c, 0, if (in.norm() == 12) 0.5 else null, 0.25, &col); // kx-safe: |bias| <= 4
+            for (col, 0..) |x, i| in.proj[i * E + c] = x;
+        }
+        if (in.profile != .planted) return;
+        const cols: []const usize = if (in.kind == .sliding) &.{ 1022, 1023 } else &.{E - 1};
+        for (cols) |c| for (0..rb.d_rel) |i| {
+            in.proj[i * E + c] = if (in.kind == .sliding) 0 else bits(6);
+        };
+        for (0..HK) |g| {
+            var sign = stream(s, .sign, in.p0, g);
+            var sg: [D]f64 = undefined;
+            for (&sg) |*x| x.* = if (sign.random().boolean()) 4 else -4;
+            for ([_]u64{ 1022, 1023, 1024, 1025 }) |dist| if (in.p0 >= dist and in.p0 - dist >= in.from) {
+                const j = in.p0 - dist;
+                normal(s, .dir, in.p0, g, 22.6, 1, in.kRow(g, j));
+                for (in.vRow(g, j), sg) |*o, x| o.* = bits(if (dist < 1024) x else -x);
+            };
+        }
+    }
+
+    /// Row t, head h: q'', r'', gate, then the sink from the row's float64 max (keys, values and proj filled).
+    pub fn fillRow(in: *const Inputs, item: usize) void {
+        const t = item / HQ;
+        const h = item % HQ;
+        const i = t * HQ + h;
+        const pos = in.p0 + t;
+        const s = in.seed();
+        const q = in.q[i * D ..][0..D];
+        if (in.profile == .planted) normal(s, .dir, in.p0, h / NREP, 22.6, 1, q) else normal(s, .q, pos, h, in.norm(), 1, q);
+        if (in.profile == .@"kx-fallback" and t % 16 == 0) q[0] = 0x0001; // a subnormal: kx's 16-row block falls back
+        normal(s, .rel, pos, h, 8, 1, in.rel[i * rb.d_rel ..][0..rb.d_rel]);
+        var gs = stream(s, .gate, pos, h);
+        for (in.gate[i * D ..][0..D]) |*x| x.* = bits(gs.random().float(f64) * 8 - 4);
+        const hd = in.head(t, h);
+        var m: f64 = -std.math.inf(f64);
+        for (0..@as(usize, @intCast(pos - hd.base + 1))) |j| {
+            var sc: f64 = 0;
+            for (hd.q, hd.k[j * D ..][0..D]) |x, y| sc += @as(f64, bfr.value(x)) * bfr.value(y);
+            m = @max(m, sc * rb.scale32 + rb.bias(hd.rel, hd.proj, E, pos - hd.base - j));
+        }
+        var ss = stream(s, .sink, pos, h);
+        in.sink[i] = bits(if (in.profile == .planted and h % 2 == 0) m + 1 else m + ss.random().float(f64) * 6 - 4);
+    }
+};
+
+fn expk(x: f32, k_exp: f64) f32 {
+    return @floatCast(@exp(@as(f64, x)) * k_exp);
+}
+
+/// The fork's eager core (inkling2_attn.cu) for one (row, head) in its own order, expf as fp32(exp64(x) * k_exp):
+/// six bf16 points; 32-key absolute tiles with a rescale at each tile's max, 256-key splits folded from (sink, 1)
+/// in order; P = bf16(expf(s - m) / z); o a fmaf chain a split, the splits added in order; out = bf16(bf16(o) * G).
+pub fn eagerFork(h: rb.Head, g: rb.Geo, k_exp: f64, s: []f32, out: []u16) void {
+    const lo = rb.keyLo(g, h.pos);
+    const n: usize = @intCast(h.pos - lo + 1);
+    const at: usize = @intCast(lo - h.base);
+    for (s[0..n], 0..) |*sj, j| {
+        var acc: f32 = 0;
+        for (h.q, h.k[(at + j) * D ..][0..D]) |x, y| acc = @mulAdd(f32, bfr.value(x), bfr.value(y), acc);
+        var sc = bfr.round32(bfr.round32(acc) * rb.scale32);
+        const dist = n - 1 - j;
+        if (dist < g.extent) sc = bfr.round32(sc + rb.bias(h.rel, h.proj, g.extent, dist));
+        sj.* = sc;
+    }
+    var m: f32 = bfr.value(h.sink);
+    var z: f32 = 1;
+    var u = lo / 256;
+    while (u <= h.pos / 256) : (u += 1) {
+        var ms = -std.math.inf(f32);
+        var zs: f32 = 0;
+        var kt = @max(u * 256, lo / 32 * 32);
+        while (kt <= @min(u * 256 + 255, h.pos)) : (kt += 32) {
+            const a: usize = @intCast(@max(kt, lo) - lo);
+            const b: usize = @intCast(@min(kt + 31, h.pos) - lo + 1);
+            var tm = -std.math.inf(f32);
+            for (s[a..b]) |x| tm = fmax(tm, x);
+            if (tm == -std.math.inf(f32)) continue;
+            const mn = fmax(ms, tm);
+            zs = zs * expk(ms - mn, k_exp);
+            for (s[a..b]) |x| zs = zs + expk(x - mn, k_exp);
+            ms = mn;
+        }
+        if (zs > 0) {
+            const mn = fmax(m, ms);
+            z = z * expk(m - mn, k_exp) + zs * expk(ms - mn, k_exp);
+            m = mn;
+        }
+    }
+    for (s[0..n]) |*x| x.* = bfr.round32(expk(x.* - m, k_exp) / z);
+    for (out[0..D], h.gate, 0..) |*o, gb, e| {
+        var acc: f32 = 0;
+        u = lo / 256;
+        while (u <= h.pos / 256) : (u += 1) {
+            var os: f32 = 0;
+            for (@max(u * 256, lo)..@min(u * 256 + 255, h.pos) + 1) |p| {
+                const j: usize = @intCast(p - lo);
+                os = @mulAdd(f32, s[j], bfr.value(h.v[(at + j) * D + e]), os);
+            }
+            acc = acc + os;
+        }
+        o.* = bfr.bits(bfr.round32(acc) * (1.0 / (1.0 + expk(-bfr.value(gb), k_exp))));
+    }
+}
+
+fn fmax(a: f32, b: f32) f32 {
+    return if (std.math.isNan(a)) b else if (std.math.isNan(b)) a else @max(a, b);
+}
+
+/// bf16 bits in value order, -0 just below +0.
+fn key(b: u16) i32 {
+    return if (b & 0x8000 != 0) -@as(i32, b & 0x7fff) - 1 else b;
+}
+
+fn isNan16(b: u16) bool {
+    return b & 0x7f80 == 0x7f80 and b & 0x7f != 0;
+}
+
+/// bf16 steps between two outputs in value order (NaN against NaN 0, NaN against a value maxInt).
+pub fn steps(a: u16, b: u16) u32 {
+    if (isNan16(a) or isNan16(b)) return if (isNan16(a) and isNan16(b)) 0 else std.math.maxInt(u32);
+    return @abs(key(a) - key(b));
+}
+
+/// One fp32 ulp at |x| (2^-149 below the normal range).
+fn ulp32(x: f64) f64 {
+    if (x == 0 or !std.math.isFinite(x)) return 0x1p-149;
+    return @max(std.math.ldexp(@as(f64, 1), std.math.frexp(x).exponent - 24), 0x1p-149);
+}
+
+/// What one run (an implementation on a layout) gave, over its outputs.
+pub const Acc = struct {
+    outputs: usize = 0,
+    inside: usize = 0,
+    stats: ar.Stats = .{},
+    class_bad: usize = 0,
+    got_nonfinite: usize = 0,
+    out_steps: u32 = 0,
+    out_ulps: f64 = 0,
+    pt_steps: u32 = 0,
+    pt_ulps: f64 = 0,
+    /// |got - point| (outside: past the range) in bf16 steps at the head's largest |point| (the head's scale)
+    hs_out: f64 = 0,
+    hs_pt: f64 = 0,
+    /// inside kx's own form (kxForm sliding, kxSplitForm global; its subnormal q'' as +0), inside kxFallbackForm,
+    /// inside either
+    kx_in: [3]usize = .{ 0, 0, 0 },
+    eager_eq: usize = 0,
+    eager_steps: u32 = 0,
+    eager_hs: f64 = 0,
+    /// outputs outside by head-scale steps past the range: <= 0.5, 1, 2, 4, 16, more
+    hist: [hist_edges.len + 1]usize = @splat(0),
+    escape: usize = 0,
+    /// (row, head) vectors whose replayForm range (or, for kx, either own form's) core refused (error.OutsideDomain)
+    refused: usize = 0,
+    /// finite outputs by |got - point| in head-scale steps, bins of 1/pt_scale up to pt_bins / pt_scale (the real-layer check's
+    /// p50 and p99), the last bin everything above
+    pt_hist: [pt_bins]u32 = @splat(0),
+    /// the largest finite |score| any (row, head) had (the real-layer check's precondition)
+    smax: f64 = 0,
+
+    pub fn add(a: *Acc, b: Acc) void {
+        inline for (.{ "outputs", "inside", "class_bad", "got_nonfinite", "eager_eq", "escape", "refused" }) |f| @field(a, f) += @field(b, f);
+        inline for (.{ "decided", "ranged", "nonfinite" }) |f| @field(a.stats, f) += @field(b.stats, f);
+        inline for (.{ "out_steps", "out_ulps", "pt_steps", "pt_ulps", "hs_out", "hs_pt", "eager_steps", "eager_hs" }) |f| @field(a, f) = @max(@field(a, f), @field(b, f));
+        for (&a.kx_in, b.kx_in) |*x, y| x.* += y;
+        for (&a.hist, b.hist) |*x, y| x.* += y;
+        for (&a.pt_hist, b.pt_hist) |*x, y| x.* += y;
+        a.smax = @max(a.smax, b.smax);
+    }
+
+    /// The q-quantile (0 .. 1) of |got - point| in head-scale steps (a bin's upper edge).
+    pub fn quantile(a: *const Acc, q: f64) f64 {
+        var total: u64 = 0;
+        for (a.pt_hist) |x| total += x;
+        if (total == 0) return 0;
+        const want: u64 = @intFromFloat(@ceil(q * @as(f64, @floatFromInt(total))));
+        var run: u64 = 0;
+        for (a.pt_hist, 0..) |x, i| {
+            run += x;
+            if (run >= @max(want, 1)) return @as(f64, @floatFromInt(i + 1)) / pt_scale;
+        }
+        return @as(f64, @floatFromInt(pt_bins)) / pt_scale;
+    }
+};
+
+pub const hist_edges = [_]f64{ 0.5, 1, 2, 4, 16 };
+pub const pt_scale = 512.0;
+pub const pt_bins = 2048;
+
+/// (row, head) vectors of D outputs whose bytes differ between the outputs `a` and `b` of two runs.
+pub fn vectorsDiffer(a: []const u16, b: []const u16, vectors: usize) usize {
+    var n: usize = 0;
+    for (0..vectors) |v| n += @intFromBool(!std.mem.eql(u16, a[v * D ..][0..D], b[v * D ..][0..D]));
+    return n;
+}
+
+/// Failed checks among a case's byte comparisons: eager run pairs whose layout or plan differ and whose bytes do
+/// (one), and any implementation, kx included, whose slices put together differ from its unsplit run (one): the
+/// rank slices must give the unsplit heads' bytes whatever ranges the outputs sit in.
+pub fn byteFailures(eager_differ: usize, slices: []const usize) usize {
+    var slice_differ: usize = 0;
+    for (slices) |x| slice_differ += x;
+    return @as(usize, @intFromBool(eager_differ > 0)) + @intFromBool(slice_differ > 0);
+}
+
+/// kx-fallback's coupling check reads kx-safe's run of the same forward, which the case loop (profiles innermost)
+/// has made only when kx-safe comes earlier in the list: every kx-fallback needs a kx-safe before it.
+pub fn checkProfiles(profiles: []const Profile) error{FallbackNeedsKxSafe}!void {
+    var safe = false;
+    for (profiles) |p| switch (p) {
+        .@"kx-safe" => safe = true,
+        .@"kx-fallback" => if (!safe) return error.FallbackNeedsKxSafe,
+        else => {},
+    };
+}
+
+/// A forward: the kx-safe run a coupling check reads must be of this exact one.
+pub const Forward = struct { kind: Kind, p0: u64, R: usize };
+
+/// The saved kx-safe run (`saved`, null when none or when the panel overwrote it) must be of forward `now`.
+pub fn checkBaseline(saved: ?Forward, now: Forward) error{FallbackNeedsKxSafe}!void {
+    if (!std.meta.eql(saved orelse return error.FallbackNeedsKxSafe, now)) return error.FallbackNeedsKxSafe;
+}
+
+/// max over columns of sigmoid(gate) * sum_j p_j |v_j| / sum p, from the logit-form weights core left in `w`.
+fn magnitude(h: rb.Head, lo: u64, n: usize, w: []const f64) f64 {
+    const at: usize = @intCast(lo - h.base);
+    const sink = bfr.value(h.sink) != -std.math.inf(f32);
+    var l: f64 = 0;
+    for (w[0 .. n + @intFromBool(sink)]) |x| l += x;
+    var col: [D]f64 = @splat(0);
+    for (0..n) |j| for (&col, h.v[(at + j) * D ..][0..D]) |*c, x| {
+        c.* += w[j] * @abs(@as(f64, bfr.value(x)));
+    };
+    var top: f64 = 0;
+    for (col, h.gate) |c, gb| top = @max(top, c / l / (1 + @exp(-@as(f64, bfr.value(gb)))));
+    return top;
+}
+
+/// kx's sliding-layer key split (cuda_attn.zig kx_sliding_split): absolute 256-key splits from the window start's.
+pub const sliding_split: u64 = 256;
+
+/// Ranges and replays of one (row, head), shared by every run's outputs of it.
+pub const Ref = struct {
+    pt: [3][D]f64 = undefined,
+    hf: [3][D]f64 = undefined,
+    eager: [3][D]u16 = undefined,
+    escape: [3]bool = .{ false, false, false },
+    /// core refused the form (error.OutsideDomain: an fp32 sum may overflow, or a class is undecided)
+    refused: [3]bool = .{ false, false, false },
+    /// the head's output scale before cancellation: max over columns of sigmoid(gate) * sum_j p_j |v_j| (float64)
+    scale: f64 = 0,
+    /// the largest finite |score| of the head (replayForm's pass)
+    smax: f64 = 0,
+
+    /// replayForm (0) always; kx's own form (1: kxSplitForm at S global, at sliding_split sliding, on q'' with its
+    /// subnormal elements as +0, as kx loads them) and kxFallbackForm (2) when `kx`; the eager replays at k_exp 1,
+    /// 1 +- 2^-22.
+    pub fn make(r: *Ref, h: rb.Head, g: rb.Geo, kx: bool, S: u64, wk: *rb.Work) void {
+        const lo = rb.keyLo(g, h.pos);
+        const n: usize = @intCast(h.pos - lo + 1);
+        const forms = [3]rb.Form{ rb.replayForm(n, D), rb.kxSplitForm(lo, h.pos, D, if (g.window == 0) S else sliding_split), rb.kxFallbackForm(n, D) };
+        var qf: [D]u16 = undefined;
+        for (&qf, h.q[0..D]) |*o, x| o.* = if (x & 0x7f80 == 0 and x & 0x7f != 0) 0 else x;
+        var hk = h;
+        hk.q = &qf;
+        for (forms, 0..) |f, i| {
+            if (i > 0 and !kx) break;
+            rb.core(if (i == 1) hk else h, g, f, wk, &r.pt[i], &r.hf[i]) catch {
+                r.refused[i] = true; // no range: the outputs meet NaN points and the case fails on `refused`
+                @memset(&r.pt[i], std.math.nan(f64));
+                @memset(&r.hf[i], std.math.inf(f64));
+                continue;
+            };
+            if (i == 0) {
+                r.scale = magnitude(h, lo, n, wk.w);
+                r.smax = wk.smax;
+            }
+            rb.gated(h.gate, &r.pt[i], &r.hf[i]);
+            for (r.pt[i], r.hf[i]) |p, s| if (std.math.isFinite(p) and std.math.isInf(s)) {
+                r.escape[i] = true;
+            };
+        }
+        for ([_]f64{ 1, 1 + 0x1p-22, 1 - 0x1p-22 }, &r.eager) |k, *o| eagerFork(h, g, k, wk.e, o);
+    }
+
+    /// `got` (D outputs of an implementation) into `a`; `kx` also counts kx's own forms.
+    pub fn check(r: *const Ref, got: []const u16, kx: bool, a: *Acc) void {
+        if (r.escape[0]) a.escape += 1;
+        if (r.refused[0] or (kx and (r.refused[1] or r.refused[2]))) a.refused += 1;
+        a.smax = @max(a.smax, r.smax);
+        var top: f64 = r.scale;
+        if (!(top > 0 and std.math.isFinite(top))) for (r.pt[0]) |p| if (std.math.isFinite(p)) {
+            top = @max(top, @abs(p));
+        };
+        const hstep = ulp32(top) * 0x1p16; // a bf16 step at the head's scale
+        for (got, 0..) |x, e| {
+            const p = r.pt[0][e];
+            const s = r.hf[0][e];
+            a.outputs += 1;
+            if (ar.within(p, s, x, &a.stats)) a.inside += 1;
+            const st = rb.outside(p, s, x);
+            if (st == std.math.maxInt(u32)) a.class_bad += 1 else a.out_steps = @max(a.out_steps, st);
+            const v: f64 = bfr.value(x);
+            if (!std.math.isFinite(v)) a.got_nonfinite += 1;
+            if (std.math.isFinite(p) and std.math.isFinite(v)) {
+                const u = ulp32(p);
+                // past the range's ends rounded to bf16 (the output's own rounding is allowed, as ar.within allows it)
+                const lo = bfr.bf16(p - s);
+                const hi = bfr.bf16(p + s);
+                const past = if (std.math.isFinite(s)) @max(0, lo - v, v - hi) else 0;
+                a.out_ulps = @max(a.out_ulps, past / u);
+                a.pt_ulps = @max(a.pt_ulps, @abs(v - p) / u);
+                a.hs_out = @max(a.hs_out, past / hstep);
+                if (past > 0) a.hist[
+                    for (hist_edges, 0..) |edge, b| {
+                        if (past / hstep <= edge) break b;
+                    } else hist_edges.len
+                ] += 1;
+                a.hs_pt = @max(a.hs_pt, @abs(v - p) / hstep);
+                const hs = @abs(v - p) / hstep * pt_scale;
+                if (hs >= 0) a.pt_hist[@intFromFloat(@min(@as(f64, pt_bins - 1), @floor(hs)))] += 1;
+                a.pt_steps = @max(a.pt_steps, steps(x, bfr.bits(@floatCast(p))));
+            }
+            if (kx) {
+                var st2: ar.Stats = .{};
+                const in = [2]bool{ ar.within(r.pt[1][e], r.hf[1][e], x, &st2), ar.within(r.pt[2][e], r.hf[2][e], x, &st2) };
+                for (in, 0..) |b, i| a.kx_in[i] += @intFromBool(b);
+                a.kx_in[2] += @intFromBool(in[0] or in[1]);
+            }
+            var near: u32 = std.math.maxInt(u32);
+            var far: f64 = std.math.inf(f64);
+            for (r.eager) |ev| {
+                near = @min(near, steps(x, ev[e]));
+                far = @min(far, @abs(v - bfr.value(ev[e])));
+            }
+            if (near == 0) a.eager_eq += 1 else if (near != std.math.maxInt(u32)) a.eager_steps = @max(a.eager_steps, near);
+            if (std.math.isFinite(far)) a.eager_hs = @max(a.eager_hs, far / hstep);
+        }
+    }
+};
+
+test "the fork-order eager replay equals the reference's eager replay where one tile and one split hold every key" {
+    const gpa = std.testing.allocator;
+    var in = try Inputs.alloc(gpa, 64, 1);
+    defer in.free(gpa);
+    in.profile = .clip;
+    in.kind = .global;
+    in.p0 = 20;
+    in.R = 1;
+    in.from = 0;
+    in.npos = 21;
+    for (0..2 * HK) |i| in.fillKv(i);
+    in.plant();
+    var wk = try rb.Work.init(gpa, 64);
+    defer wk.deinit(gpa);
+    var y: [D]f32 = undefined;
+    var a: [D]u16 = undefined;
+    var b: [D]u16 = undefined;
+    var differ: usize = 0;
+    for (0..HQ) |h| {
+        in.fillRow(h);
+        const hd = in.head(0, h);
+        rb.replay(hd, in.geo(), .eager, 1, &wk, &y);
+        rb.round(&y, &a);
+        eagerFork(hd, in.geo(), 1, wk.e, &b);
+        for (a, b) |x, z| differ += @intFromBool(x != z);
+    }
+    // one tile: the replay's z starts at the sink's weight and adds the keys; the fork's folds (sink, 1) with the
+    // tile's pair, so z may differ by a rounding and a P by a step: few outputs only
+    try std.testing.expect(differ * 100 < HQ * D);
+}
+
+test "a head the reference refuses counts as refused, not as a range" {
+    const gpa = std.testing.allocator;
+    var q: [D]u16 = @splat(0);
+    var v: [2 * D]u16 = @splat(0x7f00); // 2^127: two such values overflow the fp32 sum
+    var k: [2 * D]u16 = @splat(0);
+    var rel: [rb.d_rel]u16 = @splat(0);
+    const proj = try gpa.alloc(u16, rb.d_rel * E);
+    defer gpa.free(proj);
+    @memset(proj, 0);
+    var gate: [D]u16 = @splat(0);
+    const h: rb.Head = .{ .pos = 1, .base = 0, .q = &q, .k = &k, .v = &v, .rel = &rel, .proj = proj, .sink = 0xff80, .gate = &gate };
+    var wk = try rb.Work.init(gpa, 4);
+    defer wk.deinit(gpa);
+    var r: Ref = .{};
+    r.make(h, .{ .window = 0, .extent = E }, true, 1024, &wk);
+    try std.testing.expect(r.refused[0] and r.refused[1] and r.refused[2]);
+    var a: Acc = .{};
+    r.check(&r.eager[0], false, &a);
+    try std.testing.expectEqual(@as(usize, 1), a.refused);
+    try std.testing.expectEqual(@as(usize, 0), a.inside);
+    @memset(v[D..], 0x3f80); // the second value 1: the sums stay finite, and the reference gives a range
+    r = .{};
+    r.make(h, .{ .window = 0, .extent = E }, true, 1024, &wk);
+    try std.testing.expect(!r.refused[0] and !r.refused[1] and !r.refused[2]);
+    a = .{};
+    r.check(&r.eager[0], false, &a);
+    try std.testing.expectEqual(@as(usize, 0), a.refused);
+}
+
+test "a slice run one bf16 step off its unsplit run fails the case" {
+    var unsplit: [2 * HQ * D]u16 = @splat(0x3f80);
+    var split = unsplit;
+    split[HQ * D + 5] = 0x3f81; // row 1, head 0, column 5: one bf16 step, a value a wide range may well hold
+    const slices = [4]usize{ 0, 0, 0, vectorsDiffer(&unsplit, &split, 2 * HQ) }; // fused, rows, prev, kx
+    try std.testing.expectEqual(@as(usize, 1), slices[3]);
+    try std.testing.expectEqual(@as(usize, 1), byteFailures(0, &slices));
+    try std.testing.expectEqual(@as(usize, 1), byteFailures(0, &.{ 1, 0, 0, 0 }));
+    try std.testing.expectEqual(@as(usize, 2), byteFailures(3, &slices));
+    try std.testing.expectEqual(@as(usize, 1), byteFailures(3, &.{ 0, 0, 0, 0 }));
+    try std.testing.expectEqual(@as(usize, 0), byteFailures(0, &.{ 0, 0, 0, 0 }));
+}
+
+test "kx-fallback is refused unless kx-safe comes before it in the profile list" {
+    try checkProfiles(&.{ .clip, .diffuse, .planted, .@"kx-safe", .@"kx-fallback" });
+    try checkProfiles(&.{ .@"kx-safe", .clip, .@"kx-fallback" });
+    try checkProfiles(&.{ .clip, .@"kx-safe" });
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkProfiles(&.{ .@"kx-fallback", .@"kx-safe" }));
+    try checkProfiles(&.{ .@"kx-safe", .@"kx-fallback", .clip, .@"kx-fallback" }); // clip leaves kx-safe's run
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkProfiles(&.{.@"kx-fallback"}));
+}
+
+test "the coupling check takes kx-safe's run of the same forward only" {
+    const f: Forward = .{ .kind = .sliding, .p0 = 1024, .R = 8 };
+    try checkBaseline(f, f);
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkBaseline(null, f));
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkBaseline(.{ .kind = .global, .p0 = 1024, .R = 8 }, f));
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkBaseline(.{ .kind = .sliding, .p0 = 1023, .R = 8 }, f));
+    try std.testing.expectError(error.FallbackNeedsKxSafe, checkBaseline(.{ .kind = .sliding, .p0 = 1024, .R = 16 }, f));
+}
diff --git a/zig/src/families/inkling2/cuda_attn_oracle_real.zig b/zig/src/families/inkling2/cuda_attn_oracle_real.zig
new file mode 100644
index 0000000000000000000000000000000000000000..3952a1ebc584d6e4d7c98afd46d5fd092f0d7277
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_attn_oracle_real.zig
@@ -0,0 +1,619 @@
+//! tf-inkling2-attn --oracle --capture: the fork's attention cores (v0.1 eager as `fused`, `rows` and `prev`; kx's
+//! forms `kx`, `kx-c1`, `kx-split`, `kx-walk`) on one real layer's inputs against relbias_attention_ref.zig, with the
+//! synthetic run's report (cuda_attn_oracle.zig) a forward size, and the real-layer verdict (the `REF`
+//! line): kx inside its own form (kxForm sliding, kxSplitForm global) at 100%, kx's forms, forward sizes and rank
+//! slices byte-equal, the most head-scale steps from the float64 point under the bound registered before any data
+//! (1.10 sliding, 1.50 global), kx's p50 and p99 no further from it than v0.1's (`fused`), the inputs inside the
+//! bound's preconditions, and no kx exception recompute.
+//!
+//! The input is an inkling2_attn_check.py core-inputs file: torch's q'', r'', sink, gate and the keys and values of
+//! positions 0 .. T - 1 (torch's attn.heads and attn.project outputs; no prep kernel runs here, so this checks the core
+//! only: the fork's heads match torch's bit for bit on long_4000 L4/L5, but its project outputs, and so its sink and
+//! gate, do not), torch's core output o, the layer's rel_logits_proj.proj and its kind.
+//! The prompt runs from position 0 in forwards of N rows for each N of --chunks, on the engine's layouts (sliding: a
+//! ring of 1023 + prompt_rows slots written forward by forward; global: a slot a position), at 48/8 and as the four
+//! 12/2 rank slices. Every (row, head) is checked as the synthetic run checks it, torch's o too. (e2614fe's path a
+//! 16-row block, read from planted runs and predicted by cuda_attn_oracle_real_host.zig, no longer applies: v0.2's kx
+//! has no block-wide fallback, and only non-finite inputs reach its per-row path.) Every run's bytes get a SHA-256
+//! (DIGEST lines) to compare GPUs. Exit 1 on the synthetic run's rules: eager runs that differ (any form, layout or
+//! forward size), rank slices that differ from their unsplit run, kx outside both of its forms, an escape or a refusal.
+const std = @import("std");
+const cuda = @import("cuda");
+const ink = @import("inkling2");
+const ic = @import("inkling2_cuda");
+const host = @import("cuda_attn_oracle_host.zig");
+const real = @import("cuda_attn_oracle_real_host.zig");
+const syn = @import("cuda_attn_oracle.zig");
+const rb = @import("core").relbias_attention_ref;
+
+const attn = ic.attn;
+const Mat = ic.ops.Mat;
+const D = host.D;
+const HQ = host.HQ;
+const HK = host.HK;
+const Impl = syn.Impl;
+const impls = syn.impls;
+const layouts = syn.layouts;
+
+comptime {
+    std.debug.assert(real.prompt_rows == ic.engine.prompt_rows and syn.ring == attn.window - 1 + real.prompt_rows);
+}
+
+pub const usage =
+    \\usage: tf-inkling2-attn --oracle --capture FILE --layer L [options]   (a real layer's inputs, no model)
+    \\  FILE               inkling2_attn_check.py core-inputs' output for layer L
+    \\  --chunks N,...     forward sizes from position 0, each 1 to 2048 (default 1,64); kx's path is read at the first
+    \\                     multiple of 16
+    \\  --first T          the prompt's first T rows (default all)
+    \\  --threads N        host threads for the ranges (default 32)
+    \\  --check 0|1        the ranges and replays on the host (default 1; 0: GPU runs, bytes and digests only)
+    \\  --dump FILE        every run's outputs, bf16 [T, 6144] each, to a safetensors file
+    \\  --forms F,...      the cores: v01 (fused, rows, prev), kx (kx, kx-c1, kx-split, kx-walk), or any of those
+    \\                     names (default v01,kx)
+    \\  --kx-s S           kx's key split (default cuda_attn.zig kx_split_keys)
+    \\
+;
+
+pub const Opts = struct {
+    capture: []const u8 = "",
+    layer: ?u32 = null,
+    chunks: []const usize = &.{ 1, 64 },
+    first: usize = 0,
+    threads: usize = 32,
+    check: bool = true,
+    dump: ?[]const u8 = null,
+    forms: std.EnumSet(Impl) = .full,
+    s: usize = attn.kx_split_keys,
+};
+
+/// The --oracle arguments name a capture.
+pub fn wanted(args: []const [:0]const u8) bool {
+    for (args) |x| if (std.mem.eql(u8, x, "--capture")) return true;
+    return false;
+}
+
+pub fn parse(a: std.mem.Allocator, args: []const [:0]const u8) !?Opts {
+    var o: Opts = .{};
+    var i: usize = 2;
+    while (i + 1 < args.len) : (i += 2) {
+        const k = args[i];
+        const v = args[i + 1];
+        const eql = std.mem.eql;
+        if (eql(u8, k, "--capture")) {
+            o.capture = v;
+        } else if (eql(u8, k, "--layer")) {
+            o.layer = try std.fmt.parseInt(u32, v, 10);
+        } else if (eql(u8, k, "--chunks")) {
+            o.chunks = try syn.ints(a, v);
+        } else if (eql(u8, k, "--first")) {
+            o.first = try std.fmt.parseInt(usize, v, 10);
+        } else if (eql(u8, k, "--threads")) {
+            o.threads = try std.fmt.parseInt(usize, v, 10);
+        } else if (eql(u8, k, "--check")) {
+            o.check = !eql(u8, v, "0");
+        } else if (eql(u8, k, "--dump")) {
+            o.dump = v;
+        } else if (eql(u8, k, "--kx-s")) {
+            o.s = try std.fmt.parseInt(usize, v, 10);
+            if (std.mem.indexOfScalar(usize, &attn.kx_splits, o.s) == null) return null;
+        } else if (eql(u8, k, "--forms")) {
+            o.forms = .empty;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| {
+                if (eql(u8, x, "v01")) {
+                    for ([_]Impl{ .fused, .rows, .prev }) |m| o.forms.insert(m);
+                } else if (eql(u8, x, "kx")) {
+                    for (impls) |m| if (syn.isKx(m)) o.forms.insert(m);
+                } else o.forms.insert(std.meta.stringToEnum(Impl, x) orelse return null);
+            }
+        } else return null;
+    }
+    if (i != args.len or o.capture.len == 0 or o.layer == null or o.threads == 0 or o.chunks.len == 0) return null;
+    for (o.chunks) |n| if (!real.chunkOk(n)) {
+        std.log.err("--chunks {d}: a forward is 1 to {d} rows (the engine's prompt_rows: the sliding ring keeps 1023 + {d} slots, and a longer forward overwrites keys its own rows attend)", .{ n, real.prompt_rows, real.prompt_rows });
+        return null;
+    };
+    return o;
+}
+
+/// The eager plans a run took, as cuda_attn_oracle.zig prints them.
+const Plans = struct {
+    text: [24][48]u8 = undefined,
+    len: [24]usize = undefined,
+    n: usize = 0,
+
+    fn add(p: *Plans, s: []const u8) void {
+        for (0..p.n) |i| if (std.mem.eql(u8, p.text[i][0..p.len[i]], s)) return;
+        if (p.n == p.text.len) return;
+        @memcpy(p.text[p.n][0..s.len], s);
+        p.len[p.n] = s.len;
+        p.n += 1;
+    }
+};
+
+/// An implementation on the unsplit layout or the four slices put together, at a forward size; or torch's o (impl
+/// null, chunk 0), or a kx run with a planted row a block (impl null, `forced`). Outputs [T][HQ][D].
+const Run = struct {
+    name: []const u8,
+    impl: ?Impl,
+    split: bool = false,
+    chunk: usize,
+    forced: ?usize = null,
+    out: []u16,
+    plans: Plans = .{},
+    acc: host.Acc = .{},
+
+    fn checked(r: *const Run) bool {
+        return r.forced == null;
+    }
+};
+
+const Dev = struct {
+    q: [layouts]Mat,
+    rel: [layouts]Mat,
+    sink: [layouts]Mat,
+    gate: [layouts]Mat,
+    k: [layouts]u64,
+    v: [layouts]u64,
+    out: [layouts][impls.len]Mat,
+    qf: Mat,
+    proj: u64,
+    slots: usize,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+
+    fn buf(x: *Dev, gpa: std.mem.Allocator, d: *const cuda.Driver, bytes: usize) !u64 {
+        var b = try cuda.DeviceBuffer.alloc(d, bytes);
+        errdefer b.free();
+        try b.fill8(0, null);
+        try x.own.append(gpa, b);
+        return b.ptr;
+    }
+
+    fn mat(x: *Dev, gpa: std.mem.Allocator, d: *const cuda.Driver, rows: usize, cols: usize) !Mat {
+        return Mat.of(try x.buf(gpa, d, rows * cols * 2), rows, cols, .bf16);
+    }
+
+    fn init(gpa: std.mem.Allocator, d: *const cuda.Driver, T: usize, kind: host.Kind) !Dev {
+        var x: Dev = undefined;
+        x.own = .empty;
+        errdefer x.deinit(gpa);
+        x.slots = if (kind == .global) T else syn.ring;
+        x.proj = try x.buf(gpa, d, rb.d_rel * host.E * 2);
+        x.qf = try x.mat(gpa, d, T, HQ * D);
+        for (0..layouts) |li| {
+            const s = syn.shape(li);
+            x.q[li] = try x.mat(gpa, d, T, s[0] * D);
+            x.rel[li] = try x.mat(gpa, d, T, s[0] * rb.d_rel);
+            x.sink[li] = try x.mat(gpa, d, T, s[0]);
+            x.gate[li] = try x.mat(gpa, d, T, s[0] * D);
+            x.k[li] = try x.buf(gpa, d, x.slots * s[1] * D * 2);
+            x.v[li] = try x.buf(gpa, d, x.slots * s[1] * D * 2);
+            for (&x.out[li]) |*m| m.* = try x.mat(gpa, d, T, s[0] * D);
+        }
+        return x;
+    }
+
+    fn deinit(x: *Dev, gpa: std.mem.Allocator) void {
+        for (x.own.items) |*b| b.free();
+        x.own.deinit(gpa);
+    }
+
+    fn kv(x: *const Dev, li: usize, kind: host.Kind) attn.Kv {
+        return .{ .k = x.k[li], .v = x.v[li], .slots = x.slots, .heads = syn.shape(li)[1], .window = if (kind == .global) 0 else attn.window };
+    }
+};
+
+/// Layer L's tensor `t` of the core's inputs (or `o`, its output) from the capture: its first T rows into out.
+fn read(r: *const ink.st.Reader, L: u32, t: []const u8, T: usize, cols: usize, out: []u16) !void {
+    var nb: [96]u8 = undefined;
+    const name = try std.fmt.bufPrint(&nb, "op.{d}.attn.core.{s}.{s}", .{ L, if (std.mem.eql(u8, t, "o")) "out" else "in", t });
+    const e = r.find(name) orelse {
+        std.log.err("the capture has no {s} (make it with inkling2_attn_check.py core-inputs)", .{name});
+        return error.MissingTensor;
+    };
+    if (e.dtype != .bf16 or e.rank != 2 or e.dim(1) != cols or e.dim(0) < T) return error.UnexpectedCaptureTensor;
+    try r.readInto(e, 0, std.mem.sliceAsBytes(out[0 .. T * cols]));
+}
+
+const State = struct {
+    gpa: std.mem.Allocator,
+    o: Opts,
+    T: usize,
+    kind: host.Kind,
+    in: host.Inputs,
+    c: ic.ops.Ctx,
+    k: *ic.kernels.Kernels,
+    scratch: *ic.ops.Scratch,
+    kx: bool,
+    dev: Dev,
+    stage: []u16,
+    tmp: []u16,
+    runs: std.ArrayList(Run) = .empty,
+    preds: []real.Pred = &.{},
+    flags: []u8 = &.{},
+    failed: usize = 0,
+
+    fn find(st: *State, impl: Impl, split: bool, chunk: usize) *Run {
+        return st.maybe(impl, split, chunk) orelse unreachable;
+    }
+
+    fn maybe(st: *State, impl: Impl, split: bool, chunk: usize) ?*Run {
+        for (st.runs.items) |*r| if (r.impl == impl and r.split == split and r.chunk == chunk) return r;
+        return null;
+    }
+
+    /// The run has this implementation (asked for, and kx's built when it is one of kx's forms).
+    fn want(st: *const State, impl: Impl) bool {
+        return st.o.forms.contains(impl) and (st.kx or !syn.isKx(impl));
+    }
+
+    fn forcedRun(st: *State, v: usize) ?*Run {
+        for (st.runs.items) |*r| if (r.forced == v) return r;
+        return null;
+    }
+
+    fn putCols(st: *State, li: usize) !void {
+        const s = syn.shape(li);
+        const h0 = s[2] * s[0];
+        const x = &st.dev;
+        for ([_]struct { []const u16, usize, Mat }{ .{ st.in.q, D, x.q[li] }, .{ st.in.rel, rb.d_rel, x.rel[li] }, .{ st.in.sink, 1, x.sink[li] }, .{ st.in.gate, D, x.gate[li] } }) |t| {
+            const w = s[0] * t[1];
+            for (0..st.T) |r| @memcpy(st.stage[r * w ..][0..w], t[0][(r * HQ + h0) * t[1] ..][0..w]);
+            try syn.put(st.c.d, t[2].ptr, std.mem.sliceAsBytes(st.stage[0 .. st.T * w]));
+        }
+    }
+
+    /// Positions p0 .. p0 + R - 1's keys and values into layout li's cache, as the engine writes a forward's.
+    fn putKv(st: *State, li: usize, p0: usize, R: usize) !void {
+        var view = st.in;
+        view.from = p0;
+        view.npos = R;
+        const kv = st.dev.kv(li, st.kind);
+        try syn.putCache(st.c.d, &view, st.in.k[p0 * D ..], kv.k, kv, li, st.stage);
+        try syn.putCache(st.c.d, &view, st.in.v[p0 * D ..], kv.v, kv, li, st.stage);
+    }
+
+    /// The prompt in forwards of N rows: every implementation on every layout, or (forced v) kx on 48/8 with qf.
+    fn pass(st: *State, N: usize, forced: ?usize) !void {
+        const x = &st.dev;
+        var p0: usize = 0;
+        while (p0 < st.T) : (p0 += @min(N, st.T)) {
+            const R = @min(N, st.T - p0);
+            try st.c.stream.synchronize(); // the uploads below are not ordered with the stream's kernels
+            for (0..layouts) |li| if (forced == null or li == 0) try st.putKv(li, p0, R);
+            for (0..layouts) |li| for (impls) |impl| {
+                if (!st.want(impl) or (forced != null and (li != 0 or impl != .kx))) continue;
+                const q = if (forced != null) x.qf else x.q[li];
+                const plan = try syn.runCore(&st.c, st.k, st.scratch, impl, st.o.s, li, st.kind, x.proj, x.kv(li, st.kind), p0, q.slice(p0, R), x.rel[li].slice(p0, R), x.sink[li].slice(p0, R), x.gate[li].slice(p0, R), x.out[li][syn.ix(impl)].slice(p0, R));
+                var pb: [48]u8 = undefined;
+                if (forced == null) st.find(impl, li > 0, N).plans.add(syn.planText(&pb, plan));
+            };
+        }
+        try st.c.stream.synchronize();
+        for (0..layouts) |li| for (impls) |impl| {
+            if (!st.want(impl) or (forced != null and (li != 0 or impl != .kx))) continue;
+            const s = syn.shape(li);
+            const w = s[0] * D;
+            try cuda.memory.download(st.c.d, x.out[li][syn.ix(impl)].ptr, std.mem.sliceAsBytes(st.tmp[0 .. st.T * w]));
+            const dst = if (forced) |v| st.forcedRun(v).?.out else st.find(impl, li > 0, N).out;
+            for (0..st.T) |r| @memcpy(dst[(r * HQ + s[2] * s[0]) * D ..][0..w], st.tmp[r * w ..][0..w]);
+        };
+    }
+};
+
+/// The host check of every (row, head): its ranges against every checked run, kx's own forms and its predicted path.
+const Check = struct {
+    st: *const State,
+    work: []rb.Work,
+    scores: [][]f64,
+    accs: []host.Acc,
+    obs: ?usize,
+    n: usize, // the forward size the predictions are for: kx's path read (`obs`)
+
+    fn item(c: *const Check, i: usize, w: usize) void {
+        const st = c.st;
+        const t = i / HQ;
+        const h = i % HQ;
+        var r: host.Ref = .{};
+        r.make(st.in.head(t, h), st.in.geo(), st.kx, st.o.s, &c.work[w]);
+        const n = st.runs.items.len;
+        for (st.runs.items, 0..) |x, ri| if (x.checked()) {
+            var a: host.Acc = .{};
+            r.check(x.out[i * D ..][0..D], if (x.impl) |im| syn.isKx(im) else false, &a);
+            if (c.obs == ri) st.flags[i] = @as(u8, @intFromBool(a.kx_in[0] == D)) | @as(u8, @intFromBool(a.kx_in[1] == D)) << 1;
+            c.accs[w * n + ri].add(a);
+        };
+        if (st.kx and c.obs != null) st.preds[i] = real.kxRow(&st.in, t, h, c.scores[w], c.n, st.dev.slots);
+    }
+};
+
+fn pct(a: usize, b: usize) f64 {
+    return if (b == 0) 0 else 100 * @as(f64, @floatFromInt(a)) / @as(f64, @floatFromInt(b));
+}
+
+fn report(r: *const Run, label: []const u8, L: u32, kind: host.Kind) void {
+    const a = r.acc;
+    var pb: [24 * 49]u8 = undefined;
+    var w: std.Io.Writer = .fixed(&pb);
+    for (0..r.plans.n) |i| w.print("{s}{s}", .{ if (i > 0) "," else "", r.plans.text[i][0..r.plans.len[i]] }) catch {};
+    std.debug.print("RUN\t{s}\t{d}\t{t}\t{s}\t{d}\t{d}\t{d:.3}\t{d:.3}\t{d:.2}\t{d:.2}\t{d:.3}\t{d:.3}\t{d:.2}\t{d}/{d}/{d}\t{d}\t{d}\t{d}\t{s}\n", .{ label, L, kind, r.name, a.outputs, a.inside, pct(a.inside, a.outputs), pct(a.kx_in[2], a.outputs), a.hs_out, a.hs_pt, pct(a.eager_eq, a.outputs), pct(a.stats.ranged, a.outputs), a.eager_hs, a.hist[0] + a.hist[1], a.hist[2] + a.hist[3], a.hist[4] + a.hist[5], a.class_bad, a.escape, a.refused, w.buffered() });
+    std.debug.print("JSON {{\"prompt\":\"{s}\",\"layer\":{d},\"kind\":\"{t}\",\"run\":\"{s}\",\"chunk\":{d},\"outputs\":{d},\"inside_replay\":{d},\"inside_kxform\":{d},\"inside_kxfallback\":{d},\"inside_kx_either\":{d},\"decided\":{d},\"ranged\":{d},\"nonfinite\":{d},\"max_steps_outside\":{d},\"max_ulps32_outside\":{d:.3},\"max_head_steps_outside\":{d:.3},\"max_steps_from_point\":{d},\"max_head_steps_from_point\":{d:.3},\"class_mismatch\":{d},\"got_nonfinite\":{d},\"eager_equal\":{d},\"eager_max_steps\":{d},\"eager_max_head_steps\":{d:.3},\"escape\":{d},\"refused\":{d},", .{ label, L, kind, r.name, r.chunk, a.outputs, a.inside, a.kx_in[0], a.kx_in[1], a.kx_in[2], a.stats.decided, a.stats.ranged, a.stats.nonfinite, a.out_steps, a.out_ulps, a.hs_out, a.pt_steps, a.hs_pt, a.class_bad, a.got_nonfinite, a.eager_eq, a.eager_steps, a.eager_hs, a.escape, a.refused });
+    std.debug.print("\"hist_out_head_steps\":[{d},{d},{d},{d},{d},{d}],\"plans\":\"{s}\"}}\n", .{ a.hist[0], a.hist[1], a.hist[2], a.hist[3], a.hist[4], a.hist[5], w.buffered() });
+}
+
+/// Byte comparisons between runs; the failures they count. Returns the (row, head) vectors of kx's runs (every form,
+/// forward size and layout) that differ from kx's unsplit run at the first size.
+fn compare(st: *State) usize {
+    const T = st.T;
+    const n = T * HQ;
+    const o = st.o;
+    var eref: ?Impl = null;
+    for ([_]Impl{ .fused, .rows, .prev }) |m| if (eref == null and st.want(m)) {
+        eref = m;
+    };
+    var differ: usize = 0;
+    if (eref) |er| {
+        const ref = st.find(er, false, o.chunks[0]).out;
+        for (st.runs.items) |r| if (r.impl) |impl| if (!syn.isKx(impl)) {
+            const d = host.vectorsDiffer(ref, r.out, n);
+            differ += d;
+            std.debug.print("BYTES\teager\t{s}\tvs {t}.48x8.{d}\t{d} of {d} vectors differ\n", .{ r.name, er, o.chunks[0], d, n });
+        };
+    }
+    var slices: usize = 0;
+    for (impls) |impl| if (st.want(impl)) for (o.chunks) |N| {
+        const d = host.vectorsDiffer(st.find(impl, false, N).out, st.find(impl, true, N).out, n);
+        slices += d;
+        std.debug.print("BYTES\tslices\t{t}.{d}\t12/2x4 vs 48/8\t{d} of {d} vectors differ\n", .{ impl, N, d, n });
+    };
+    st.failed += host.byteFailures(differ, &.{slices});
+    var kx_differ: usize = 0;
+    if (st.want(.kx)) for (st.runs.items) |r| if (r.impl) |impl| if (syn.isKx(impl)) {
+        const d = host.vectorsDiffer(st.find(.kx, false, o.chunks[0]).out, r.out, n);
+        kx_differ += d;
+        std.debug.print("BYTES\tkx\t{s}\tvs kx.48x8.{d}\t{d} of {d} vectors differ\n", .{ r.name, o.chunks[0], d, n });
+    };
+    if (kx_differ > 0) st.failed += 1;
+    const torch = st.runs.items[st.runs.items.len - 1].out;
+    var eq: usize = 0;
+    if (eref) |er| {
+        const ref = st.find(er, false, o.chunks[0]).out;
+        for (torch, ref) |a, b| eq += @intFromBool(a == b);
+        std.debug.print("BYTES\ttorch\ttorch.o\tvs {t}.48x8.{d}\t{d} of {d} vectors differ; {d} of {d} outputs equal\n", .{ er, o.chunks[0], host.vectorsDiffer(ref, torch, n), n, eq, n * D });
+    }
+    if (st.want(.kx)) {
+        const kr = st.find(.kx, false, o.chunks[0]).out;
+        eq = 0;
+        for (torch, kr) |a, b| eq += @intFromBool(a == b);
+        std.debug.print("BYTES\ttorch\ttorch.o\tvs kx.48x8.{d}\t{d} of {d} vectors differ; {d} of {d} outputs equal\n", .{ o.chunks[0], host.vectorsDiffer(kr, torch, n), n, eq, n * D });
+    }
+    return kx_differ;
+}
+
+/// Inputs outside the real-layer bound's domain: subnormal or non-finite q'', r'', sink, gate, keys or values.
+fn badInputs(in: *const host.Inputs, T: usize) usize {
+    var bad: usize = 0;
+    for ([_][]const u16{ in.q[0 .. T * HQ * D], in.rel[0 .. T * HQ * rb.d_rel], in.sink[0 .. T * HQ], in.gate[0 .. T * HQ * D], in.k, in.v }) |xs| for (xs) |x| {
+        bad += @intFromBool(x & 0x7f80 == 0x7f80 or (x & 0x7f80 == 0 and x & 0x7f != 0));
+    };
+    return bad;
+}
+
+/// The real-layer verdict for this layer: one `REF` line.
+fn refLine(st: *State, L: u32, kx_differ: usize, rows0: bool) void {
+    var kxa: host.Acc = .{};
+    var nk: usize = 0;
+    for (st.runs.items) |r| if (r.impl) |impl| if (syn.isKx(impl)) {
+        kxa.add(r.acc);
+        nk += 1;
+    };
+    const kx0 = st.find(.kx, false, st.o.chunks[0]);
+    const v01 = st.maybe(.fused, false, st.o.chunks[0]);
+    const B: f64 = if (st.kind == .global) 1.50 else 1.10;
+    const own = pct(kxa.kx_in[0], kxa.outputs);
+    const p50 = [2]f64{ kx0.acc.quantile(0.5), if (v01) |r| r.acc.quantile(0.5) else std.math.inf(f64) };
+    const p99 = [2]f64{ kx0.acc.quantile(0.99), if (v01) |r| r.acc.quantile(0.99) else std.math.inf(f64) };
+    const bad_in = badInputs(&st.in, st.T);
+    const pre = st.T <= 128000 and kxa.smax <= 256 and bad_in == 0;
+    const ok = kxa.kx_in[0] == kxa.outputs and kxa.class_bad == 0 and kxa.refused == 0 and kxa.escape == 0 and kxa.hs_pt <= B and p50[0] <= p50[1] and p99[0] <= p99[1] and pre and kx_differ == 0 and rows0;
+    if (!ok) st.failed += 1;
+    std.debug.print("REF L{d} kx: inside own {d:.2}%, max {d:.3} <= B {d:.2}, p50 {d:.4} <= {d:.4}, p99 {d:.4} <= {d:.4}; inside replayForm {d:.3}%; class mismatches {d}, refused {d}, escapes {d}; {d} kx runs byte-equal ({d} vectors differ); preconditions: positions < {d}, max |s| {d:.1} <= 256, {d} subnormal or non-finite inputs; exception recomputes {s}: {s}\n", .{ L, own, kxa.hs_pt, B, p50[0], p50[1], p99[0], p99[1], pct(kxa.inside, kxa.outputs), kxa.class_bad, kxa.refused, kxa.escape, nk, kx_differ, st.T, kxa.smax, bad_in, if (rows0) "0" else "NOT 0", if (ok) "PASS" else "FAIL" });
+}
+
+/// kx's path a (16-row block, head) at forward size N (a multiple of 16): read from the planted runs, predicted
+/// from the inputs when the host check ran, and kx inside the form of the path it took.
+fn paths(st: *State, N: usize) void {
+    const T = st.T;
+    const nat = st.find(.kx, false, N).out;
+    const f = [2][]const u16{ st.forcedRun(0).?.out, st.forcedRun(1).?.out };
+    var seen: [3]usize = @splat(0);
+    var cross: [3][4]usize = @splat(@splat(0)); // seen x (q or kv test, limb sure, limb maybe, none)
+    var own: [2][2]usize = @splat(@splat(0)); // (fast, fallback) x (vectors, inside the path's form)
+    const nb = (T + 15) / 16;
+    for (0..nb) |b| for (0..HQ) |h| {
+        const s = real.seen(nat, f, T, b, h);
+        seen[@backingInt(s)] += 1;
+        if (!st.o.check) continue;
+        var p: real.Pred = .{};
+        for (16 * b..@min(16 * b + 16, T)) |t| p.join(st.preds[t * HQ + h]);
+        cross[@backingInt(s)][if (p.q_bad or p.kv_bad) 0 else if (p.limb == .sure) @as(usize, 1) else if (p.limb == .maybe) 2 else 3] += 1;
+        if (s == .unseen) continue;
+        const k = @backingInt(s);
+        for (16 * b..@min(16 * b + 16, T)) |t| {
+            own[k][0] += 1;
+            own[k][1] += @intFromBool(st.flags[t * HQ + h] >> @intCast(k) & 1 == 1);
+        }
+    };
+    std.debug.print("KXPATH\tforwards of {d}\t(block, head) pairs {d}: fast {d}, fallback (or fast with the fallback's bytes) {d}, unseen {d}\n", .{ N, nb * HQ, seen[0], seen[1], seen[2] });
+    if (!st.o.check) return;
+    for (cross, [_][]const u8{ "fast", "fallback", "unseen" }) |row, name| std.debug.print("KXPATH\tseen {s}\tpredicted: q/kv test {d}, limb sure {d}, limb maybe {d}, none {d}\n", .{ name, row[0], row[1], row[2], row[3] });
+    std.debug.print("KXPATH\town form\tfast blocks: {d}/{d} vectors inside kxForm; fallback blocks: {d}/{d} inside kxFallbackForm\n", .{ own[0][1], own[0][0], own[1][1], own[1][0] });
+    var lo: f64 = 0;
+    var deep: [5]usize = @splat(0);
+    for (st.preds) |p| {
+        lo = @min(lo, p.xmin);
+        for ([_]f64{ -20, -40, -60, -70.7, -87.3 }, &deep) |edge, *c| c.* += @intFromBool(p.xmin < edge);
+    }
+    std.debug.print("KXPATH\tscores\tlowest s - m over every (row, head) {d:.2}; (row, head) pairs with a key below m - 20 / 40 / 60 / 70.7 / 87.3: {d} / {d} / {d} / {d} / {d} of {d}\n", .{ lo, deep[0], deep[1], deep[2], deep[3], deep[4], st.preds.len });
+    if (st.o.chunks[0] == 1 and N != 1) { // single-row forwards (decode) against the blocks
+        const one = st.find(.kx, false, 1).out;
+        var moved: [4]usize = @splat(0);
+        for (0..T * HQ) |i| if (!std.mem.eql(u16, one[i * D ..][0..D], nat[i * D ..][0..D])) {
+            const p = st.preds[i];
+            moved[if (p.q_bad or p.kv_bad) 0 else if (p.limb == .sure) @as(usize, 1) else if (p.limb == .maybe) 2 else 3] += 1;
+        };
+        std.debug.print("KXPATH\tforwards of 1 vs {d}\tvectors that differ, by the row's own prediction: q/kv test {d}, limb sure {d}, limb maybe {d}, none {d}\n", .{ N, moved[0], moved[1], moved[2], moved[3] });
+    }
+}
+
+fn hex(out: []const u16) [64]u8 {
+    var d: [32]u8 = undefined;
+    std.crypto.hash.sha2.Sha256.hash(std.mem.sliceAsBytes(out), &d, .{});
+    return std.fmt.bytesToHex(d, .lower);
+}
+
+pub fn run(gpa: std.mem.Allocator, io: std.Io, o: Opts) !u8 {
+    const L = o.layer.?;
+    var cap = try ink.st.Reader.open(gpa, io, o.capture);
+    defer cap.close();
+    const kind = std.meta.stringToEnum(host.Kind, cap.metaValue("kind") orelse "") orelse return error.CaptureHasNoKind;
+    if (cap.metaValue("layer")) |l| if (try std.fmt.parseInt(u32, l, 10) != L) return error.CaptureOfAnotherLayer;
+    const oracle = cap.metaValue("oracle") orelse "";
+    const label = if (std.mem.endsWith(u8, oracle, ".safetensors")) oracle[0 .. oracle.len - 12] else oracle;
+    var nb: [96]u8 = undefined;
+    const qe = cap.find(try std.fmt.bufPrint(&nb, "op.{d}.attn.core.in.q", .{L})) orelse return error.MissingTensor;
+    const T: usize = if (o.first == 0) @intCast(qe.dim(0)) else @min(o.first, @as(usize, @intCast(qe.dim(0))));
+    var in = try host.Inputs.alloc(gpa, T, T);
+    defer in.free(gpa);
+    in.profile = .clip; // unused: the inputs are the capture's
+    in.kind = kind;
+    in.p0 = 0;
+    in.R = T;
+    in.from = 0;
+    in.npos = T;
+    const torch = try gpa.alloc(u16, T * HQ * D);
+    defer gpa.free(torch);
+    const tmp = try gpa.alloc(u16, T * HQ * D);
+    defer gpa.free(tmp);
+    try read(&cap, L, "q", T, HQ * D, in.q);
+    try read(&cap, L, "rel", T, HQ * rb.d_rel, in.rel);
+    try read(&cap, L, "sink", T, HQ, in.sink);
+    try read(&cap, L, "gate", T, HQ * D, in.gate);
+    try read(&cap, L, "proj", rb.d_rel, host.E, in.proj);
+    try read(&cap, L, "o", T, HQ * D, torch);
+    try read(&cap, L, "k_ctx@0", T, HK * D, tmp);
+    real.transpose(tmp, T, T, in.k);
+    try read(&cap, L, "v_ctx@0", T, HK * D, tmp);
+    real.transpose(tmp, T, T, in.v);
+
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    var gemms = try ic.ops.Gemms.init(gpa, &driver);
+    defer gemms.deinit();
+    var most: usize = 1;
+    for (o.chunks) |N| most = @max(most, @min(N, T));
+    const kx = k.attn.kx != null;
+    k.attn.kxo = .{ .s = o.s };
+    var cb: [160]u8 = undefined;
+    std.debug.print("{s}\n", .{k.attn.census(&cb)});
+    const form = k.attn.form;
+    k.attn.form = .v01;
+    var need = @max(attn.kx_split_cap, attn.kxNeed(.{ .s = o.s }, HQ, T, most, 0), attn.kxNeed(.{ .s = o.s }, HQ / 4, T, most, 0));
+    for ([_][2]usize{ .{ HQ, HK }, .{ HQ / 4, HK / 4 } }) |s| need = @max(need, attn.scratchNeed(&k.attn, s[0], s[1], T, most, 0));
+    k.attn.form = form;
+    var scratch = try ic.ops.Scratch.init(&driver, need + (16 << 20));
+    defer scratch.deinit();
+    var st: State = .{ .gpa = gpa, .o = o, .T = T, .kind = kind, .in = in, .c = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch }, .k = &k, .scratch = &scratch, .kx = kx, .dev = try Dev.init(gpa, &driver, T, kind), .stage = try gpa.alloc(u16, T * HQ * D), .tmp = tmp };
+    defer st.dev.deinit(gpa);
+    defer gpa.free(st.stage);
+    var arena: std.heap.ArenaAllocator = .init(gpa);
+    defer arena.deinit();
+    const aa = arena.allocator();
+    defer st.runs.deinit(gpa);
+    defer for (st.runs.items) |r| if (r.impl != null or r.forced != null) gpa.free(r.out);
+    // e2614fe's path reading (planted runs) does not apply to v0.2's kx: no forced runs
+    const obs: ?usize = null;
+    for (impls) |impl| if (st.want(impl)) for ([_]bool{ false, true }) |split| for (o.chunks) |N| {
+        const name = try std.fmt.allocPrint(aa, "{t}.{s}.{d}", .{ impl, if (split) "12x2x4" else "48x8", N });
+        try st.runs.append(gpa, .{ .name = name, .impl = impl, .split = split, .chunk = N, .out = try gpa.alloc(u16, T * HQ * D) });
+    };
+    if (obs) |N| for (0..2) |v| try st.runs.append(gpa, .{ .name = try std.fmt.allocPrint(aa, "kx.forced{d}.{d}", .{ v, N }), .impl = null, .chunk = N, .forced = v, .out = try gpa.alloc(u16, T * HQ * D) });
+    try st.runs.append(gpa, .{ .name = "torch.o", .impl = null, .chunk = 0, .out = torch });
+
+    std.debug.print("oracle --capture: {s} layer {d} ({t}), {d} rows; kx {s} (S {d}); chunks", .{ label, L, kind, T, if (kx) "loaded" else "not built", o.s });
+    for (o.chunks) |N| std.debug.print(" {d}", .{N});
+    std.debug.print("; kx path read at {?d}; scratch {d:.1} MiB; slots {d}\n", .{ obs, @as(f64, @floatFromInt(need)) / (1 << 20), st.dev.slots });
+    const clock = std.Io.Clock.awake;
+    const t0 = clock.now(io).toNanoseconds();
+    try syn.put(&driver, st.dev.proj, std.mem.sliceAsBytes(in.proj));
+    for (0..layouts) |li| try st.putCols(li);
+    for (o.chunks) |N| try st.pass(N, null);
+    if (obs) |N| for (0..2) |v| {
+        @memcpy(st.stage, in.q);
+        real.plant(st.stage, T, v);
+        try stream.synchronize();
+        try syn.put(&driver, st.dev.qf.ptr, std.mem.sliceAsBytes(st.stage));
+        try st.pass(N, v);
+    };
+    const t1 = clock.now(io).toNanoseconds();
+    std.debug.print("GPU runs {d:.1} s\n", .{@as(f64, @floatFromInt(t1 - t0)) * 1e-9});
+    for (st.runs.items) |r| std.debug.print("DIGEST\t{s}\t{d}\t{s}\t{s}\n", .{ label, L, r.name, hex(r.out) });
+    if (o.dump) |path| {
+        var wr = ink.st.Writer.init(gpa);
+        defer wr.deinit();
+        for (st.runs.items) |r| try wr.add(r.name, .bf16, &.{ T, HQ * D }, std.mem.sliceAsBytes(r.out));
+        try wr.setMeta("tool", "tf-inkling2-attn --oracle --capture");
+        try wr.setMeta("capture", std.fs.path.basename(o.capture));
+        try wr.write(io, path);
+        std.debug.print("wrote {s}\n", .{path});
+    }
+    const kx_differ = compare(&st);
+    const ex = try k.attn.kxExceptions(&driver);
+    if (o.check) {
+        const nt = @min(o.threads, 128);
+        st.preds = try gpa.alloc(real.Pred, T * HQ);
+        defer gpa.free(st.preds);
+        st.flags = try gpa.alloc(u8, T * HQ);
+        defer gpa.free(st.flags);
+        @memset(st.flags, 0);
+        const work = try gpa.alloc(rb.Work, nt);
+        defer gpa.free(work);
+        for (work) |*wk| wk.* = try rb.Work.init(gpa, T + 1);
+        defer for (work) |*wk| wk.deinit(gpa);
+        const scores = try gpa.alloc([]f64, nt);
+        defer gpa.free(scores);
+        for (scores) |*s| s.* = try gpa.alloc(f64, T + 64);
+        defer for (scores) |s| gpa.free(s);
+        const accs = try gpa.alloc(host.Acc, nt * st.runs.items.len);
+        defer gpa.free(accs);
+        @memset(accs, .{});
+        var oi: ?usize = null;
+        if (obs) |N| for (st.runs.items, 0..) |r, ri| if (r.impl == .kx and !r.split and r.chunk == N) {
+            oi = ri;
+        };
+        const c: Check = .{ .st = &st, .work = work, .scores = scores, .accs = accs, .obs = oi, .n = obs orelse T };
+        try syn.parallel(nt, T * HQ, &c, Check.item);
+        for (st.runs.items, 0..) |*r, ri| for (0..nt) |w| r.acc.add(accs[w * st.runs.items.len + ri]);
+        std.debug.print("RUN\tprompt\tlayer\tkind\trun\toutputs\tinside_replay\tpct\tkx_either_pct\tmax_head_steps_out\tmax_head_steps_pt\teager_equal_pct\tranged_pct\teager_max_head_steps\toutside_by_head_steps(<=1/1-4/>4)\tclass_bad\tescape\trefused\tplans\n", .{});
+        for (st.runs.items) |*r| if (r.checked()) {
+            report(r, label, L, kind);
+            const a = r.acc;
+            if (a.escape > 0 or a.refused > 0) st.failed += 1;
+            if (r.impl) |im| if (syn.isKx(im) and a.kx_in[0] != a.outputs) {
+                st.failed += 1;
+            };
+        };
+        if (obs) |N| paths(&st, N);
+        if (st.want(.kx)) refLine(&st, L, kx_differ, ex[0] == 0);
+        std.debug.print("host checks {d:.1} s\n", .{@as(f64, @floatFromInt(clock.now(io).toNanoseconds() - t1)) * 1e-9});
+    } else if (obs) |N| paths(&st, N);
+    k.attn.printExceptions(&driver);
+    std.debug.print("{s} oracle --capture {s} layer {d}: {d} failed checks\n", .{ if (st.failed == 0) "PASS" else "FAIL", label, L, st.failed });
+    return if (st.failed == 0) 0 else 1;
+}
diff --git a/zig/src/families/inkling2/cuda_attn_oracle_real_host.zig b/zig/src/families/inkling2/cuda_attn_oracle_real_host.zig
new file mode 100644
index 0000000000000000000000000000000000000000..7550697391691b7438e32776de37a0f32ae2394f
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_attn_oracle_real_host.zig
@@ -0,0 +1,308 @@
+//! tf-inkling2-attn --oracle --capture, the host half: a real layer's keys and values into the oracle's layout, the
+//! exception tests of kx's fast path (inkling2_kx_attention.cuh) predicted from the inputs, and kx's path read from
+//! its outputs. No GPU.
+//!
+//! kx runs a query head over a 16-row block of a forward. The block leaves the fast path for the per-row fallback when
+//! (1) a q element of its rows is not finite or is subnormal, (2) a key or value of its loaded 64-key tiles (from the
+//! first row's window start rounded down to 64, to its last row) is, or (3) a weight p = expf(s - m) of a tile, m the
+//! row's running max over the tiles so far, does not split exactly into three bf16 limbs: p nonzero below 2^-126
+//! always fails; below 2^-102 it fails or not by its low bits; at or above 2^-102 it never fails. (1) and (2) are
+//! decided from the inputs' bits, (2) on what the tiles' cache slots hold when the forward runs; (3) from float64
+//! scores, as a band.
+const std = @import("std");
+const host = @import("cuda_attn_oracle_host.zig");
+const rb = @import("core").relbias_attention_ref;
+const bfr = @import("core").bf16_round;
+
+const D = host.D;
+const HQ = host.HQ;
+
+/// A capture's [T][HK * D] rows (positions 0 .. T - 1) into `dst` as the oracle's [HK][cap][D].
+pub fn transpose(src: []const u16, T: usize, cap: usize, dst: []u16) void {
+    for (0..T) |p| for (0..host.HK) |g| {
+        @memcpy(dst[(g * cap + p) * D ..][0..D], src[(p * host.HK + g) * D ..][0..D]);
+    };
+}
+
+/// The engine's rows a forward (cuda_engine.zig `prompt_rows`; cuda_attn_oracle_real.zig asserts they agree). The
+/// sliding ring keeps 1023 + prompt_rows slots and a forward's keys and values are all written before its first query
+/// runs, so a forward of more rows overwrites keys that its own rows still attend: --capture refuses such forwards.
+pub const prompt_rows = 2048;
+
+/// A forward size --chunks takes: 1 to prompt_rows rows.
+pub fn chunkOk(n: usize) bool {
+    return n > 0 and n <= prompt_rows;
+}
+
+/// A bf16 that kx's tests reject: not finite, or subnormal.
+pub fn odd(b: u16) bool {
+    const e = (b >> 7) & 0xff;
+    return e == 0xff or (e == 0 and b & 0x7f != 0);
+}
+
+/// Test (3) for one weight: sure (p nonzero below 2^-126 at every probe), maybe (some probe below 2^-102), none.
+pub const Band = enum(u2) { none, maybe, sure };
+
+/// x = s - m, its fp32 uncertainty d: p = fp32(exp(x)) at x - d, x, x + d.
+pub fn band(x: f64, d: f64) Band {
+    var sub: usize = 0;
+    var low: usize = 0;
+    for ([3]f64{ x - d, x, x + d }) |y| {
+        const p: f32 = @floatCast(@exp(y));
+        if (p != 0 and p < 0x1p-126) sub += 1 else if (p != 0 and p < 0x1p-102) low += 1;
+    }
+    return if (sub == 3) .sure else if (sub + low > 0) .maybe else .none;
+}
+
+/// kx's tests for one (row, query head) as its own 16-row block would see them; a block takes the OR of its rows
+/// (their loaded tiles are the union of the rows' ranges). `xmin`: the lowest s - m over the row's keys.
+pub const Pred = struct {
+    q_bad: bool = false,
+    kv_bad: bool = false,
+    limb: Band = .none,
+    xmin: f64 = 0,
+
+    pub fn sure(p: Pred) bool {
+        return p.q_bad or p.kv_bad or p.limb == .sure;
+    }
+
+    pub fn join(a: *Pred, b: Pred) void {
+        a.q_bad = a.q_bad or b.q_bad;
+        a.kv_bad = a.kv_bad or b.kv_bad;
+        a.limb = @fromBackingInt(@intCast(@max(@backingInt(a.limb), @backingInt(b.limb))));
+        a.xmin = @min(a.xmin, b.xmin);
+    }
+};
+
+/// The position whose key and value slot `j % slots` holds once positions 0 .. end - 1 are written in order (j < end):
+/// j itself on a slot a position, and on the sliding ring a later position of the same forward for a key that a
+/// forward writes over (only keys before every window of the forward, when the forward is at most prompt_rows).
+pub fn owner(j: usize, end: usize, slots: usize) usize {
+    return j + (end - 1 - j) / slots * slots;
+}
+
+/// Row t (position in.p0 + t, keys from in.from <= the row's first tile) and query head h, the prompt (in.p0 ..
+/// in.p0 + in.R - 1, in.p0 a multiple of n) run in forwards of n rows on a cache of `slots` slots; `s` holds a score a
+/// key. Tests (1) and (2) read what the loaded tiles hold when the row's forward runs: a key or value slot holds its
+/// owner's (`owner`, the forward's last position + 1 as `end`); the scores take the window's keys by position.
+pub fn kxRow(in: *const host.Inputs, t: usize, h: usize, s: []f64, n: usize, slots: usize) Pred {
+    const pos = in.p0 + t;
+    const win: u64 = if (in.kind == .sliding) 1023 else 0; // kx's window is the largest distance (Kv.window - 1)
+    const first = if (win > 0 and pos > win) pos - win else 0;
+    const g = h / host.NREP;
+    const i = t * HQ + h;
+    var p: Pred = .{};
+    const q = in.q[i * D ..][0..D];
+    for (q) |x| p.q_bad = p.q_bad or odd(x);
+    const end = @min(in.p0 + (t / n + 1) * n, in.p0 + in.R);
+    for (first / 64 * 64..pos + 1) |j| {
+        const o = owner(j, end, slots);
+        for (in.kRow(g, o)) |x| p.kv_bad = p.kv_bad or odd(x);
+        for (in.vRow(g, o)) |x| p.kv_bad = p.kv_bad or odd(x);
+    }
+    const rel = in.rel[i * rb.d_rel ..][0..rb.d_rel];
+    for (first..pos + 1) |j| {
+        var dot: f64 = 0;
+        for (q, in.kRow(g, j)) |a, b| dot += @as(f64, bfr.value(a)) * bfr.value(b);
+        const dist = pos - j;
+        s[j - first] = dot * rb.scale32 + (if (dist < host.E) rb.bias(rel, in.proj, host.E, dist) else 0);
+    }
+    var m = -std.math.inf(f64);
+    var b = first / 64 * 64;
+    while (b <= pos) : (b += 64) {
+        const lo = @max(b, first);
+        const hi = @min(b + 63, pos);
+        for (lo..hi + 1) |j| m = @max(m, s[j - first]);
+        for (lo..hi + 1) |j| {
+            const x = s[j - first] - m;
+            p.xmin = @min(p.xmin, x);
+            const w = band(x, 1e-4 * (1 + @abs(s[j - first]) + @abs(m)));
+            p.limb = @fromBackingInt(@intCast(@max(@backingInt(p.limb), @backingInt(w))));
+        }
+    }
+    return p;
+}
+
+/// kx's path for a 16-row block, read from its outputs.
+pub const Seen = enum(u2) { fast, fallback, unseen };
+
+/// Block b (rows 16b .. of a prompt of T rows run in forwards of a multiple of 16 from position 0) and query head h,
+/// from kx's run `natural` and two runs whose rows t % 16 == v (v = 0, 1) hold a subnormal q element, which sends
+/// every block to the per-row fallback. The fallback gives a row the same bytes whatever its block holds, so: fast
+/// when a row that variant leaves alone has other bytes in `natural`; fallback when every such row has the same
+/// bytes (or the fast path happens to give them); unseen when no row can be compared.
+pub fn seen(natural: []const u16, forced: [2][]const u16, T: usize, b: usize, h: usize) Seen {
+    const r0 = 16 * b;
+    const r1 = @min(r0 + 16, T);
+    var compared: usize = 0;
+    for (r0..r1) |t| {
+        const v: usize = if (t % 16 == 0) 1 else 0;
+        if (r0 + v >= r1) continue; // the variant plants nothing in this block
+        const at = (t * HQ + h) * D;
+        compared += 1;
+        if (!std.mem.eql(u16, natural[at..][0..D], forced[v][at..][0..D])) return .fast;
+    }
+    return if (compared == 0) .unseen else .fallback;
+}
+
+/// The q of a run that sends every block to the fallback: rows t % 16 == v get a subnormal first element per head.
+pub fn plant(q: []u16, T: usize, v: usize) void {
+    var t = v;
+    while (t < T) : (t += 16) for (0..HQ) |h| {
+        q[(t * HQ + h) * D] = 0x0001;
+    };
+}
+
+test "test (3)'s band: subnormal weights always fail, small normal ones may, the rest and zero never" {
+    try std.testing.expectEqual(Band.none, band(0, 1e-4));
+    try std.testing.expectEqual(Band.none, band(-60, 1e-4));
+    try std.testing.expectEqual(Band.maybe, band(-75, 1e-4)); // 2^-108: normal, low bits below 2^-126
+    try std.testing.expectEqual(Band.sure, band(-95, 1e-4)); // 2^-137: an fp32 subnormal
+    try std.testing.expectEqual(Band.maybe, band(-103.97, 1e-2)); // the last subnormal or zero
+    try std.testing.expectEqual(Band.none, band(-200, 1e-4)); // p = 0: weight 0, no limb
+    try std.testing.expect(odd(0x0001) and odd(0x8001) and odd(0x7f80) and odd(0xff80) and odd(0x7fc0));
+    try std.testing.expect(!odd(0) and !odd(0x8000) and !odd(0x0080) and !odd(0x3f80));
+}
+
+fn tiny(gpa: std.mem.Allocator, kind: host.Kind, n: usize) !host.Inputs {
+    var in = try host.Inputs.alloc(gpa, n, n);
+    in.kind = kind;
+    in.profile = .clip;
+    in.p0 = 0;
+    in.R = n;
+    in.from = 0;
+    in.npos = n;
+    for ([_][]u16{ in.k, in.v, in.q, in.rel, in.gate, in.sink, in.proj }) |x| @memset(x, 0);
+    return in;
+}
+
+test "kxRow: q, a key or value of a loaded tile, and a score 90 under the max each send the row to the fallback" {
+    const gpa = std.testing.allocator;
+    var in = try tiny(gpa, .global, 4);
+    defer in.free(gpa);
+    var s: [8]f64 = undefined;
+    try std.testing.expect(!kxRow(&in, 3, 7, &s, in.R, in.R).sure());
+    in.q[(3 * HQ + 7) * D] = 0x4200; // 32
+    in.kRow(1, 2)[0] = 0x4200; // q.k = 1024 at key 2: score 90.5, the other keys 0
+    const p = kxRow(&in, 3, 7, &s, in.R, in.R);
+    try std.testing.expectEqual(Band.sure, p.limb);
+    try std.testing.expect(p.xmin < -90 and !p.q_bad and !p.kv_bad);
+    try std.testing.expectEqual(Band.none, kxRow(&in, 2, 7, &s, in.R, in.R).limb); // row 2's q is 0: every score 0
+    in.kRow(1, 2)[0] = 0;
+    in.q[(3 * HQ + 7) * D + 5] = 0x0001;
+    try std.testing.expect(kxRow(&in, 3, 7, &s, in.R, in.R).q_bad and !kxRow(&in, 3, 6, &s, in.R, in.R).q_bad and !kxRow(&in, 3, 0, &s, in.R, in.R).q_bad);
+    in.q[(3 * HQ + 7) * D + 5] = 0;
+    in.vRow(1, 0)[9] = 0x7f80;
+    try std.testing.expect(kxRow(&in, 3, 7, &s, in.R, in.R).kv_bad and kxRow(&in, 0, 6, &s, in.R, in.R).kv_bad and !kxRow(&in, 3, 0, &s, in.R, in.R).kv_bad);
+}
+
+test "kxRow: a sliding row's loaded tiles start at its window start rounded down to 64, before the window" {
+    const gpa = std.testing.allocator;
+    var in = try tiny(gpa, .sliding, 1101);
+    defer in.free(gpa);
+    const s = try gpa.alloc(f64, 1101);
+    defer gpa.free(s);
+    in.kRow(0, 70)[3] = 0x7f80; // row 1100's window starts at 77, its first tile at 64
+    try std.testing.expect(kxRow(&in, 1100, 0, s, in.R, in.R).kv_bad);
+    try std.testing.expectEqual(@as(u64, 77), rb.keyLo(in.geo(), 1100)); // the reference's window leaves key 70 out
+    try std.testing.expect(!kxRow(&in, 1100, 6, s, in.R, in.R).kv_bad); // kv head 1
+    in.kRow(0, 70)[3] = 0;
+    in.kRow(0, 63)[3] = 0x7f80; // before the first tile
+    try std.testing.expect(!kxRow(&in, 1100, 0, s, in.R, in.R).kv_bad);
+}
+
+test "seen: a row that differs from the forced run means the fast path; a block of one row cannot be read" {
+    const gpa = std.testing.allocator;
+    const T = 17;
+    const n = T * HQ * D;
+    const nat = try gpa.alloc(u16, n);
+    defer gpa.free(nat);
+    const f0 = try gpa.alloc(u16, n);
+    defer gpa.free(f0);
+    const f1 = try gpa.alloc(u16, n);
+    defer gpa.free(f1);
+    @memset(nat, 0x3f80);
+    @memset(f0, 0x3f80);
+    @memset(f1, 0x3f80);
+    try std.testing.expectEqual(Seen.fallback, seen(nat, .{ f0, f1 }, T, 0, 3));
+    f0[(5 * HQ + 3) * D + 100] = 0x3f81; // row 5 is compared with variant 0
+    try std.testing.expectEqual(Seen.fast, seen(nat, .{ f0, f1 }, T, 0, 3));
+    try std.testing.expectEqual(Seen.fallback, seen(nat, .{ f0, f1 }, T, 0, 2));
+    f1[(5 * HQ + 3) * D + 100] = 0x3f81; // variant 1 is not read for row 5
+    f0[(5 * HQ + 3) * D + 100] = 0x3f80;
+    try std.testing.expectEqual(Seen.fallback, seen(nat, .{ f0, f1 }, T, 0, 3));
+    f1[(0 * HQ + 3) * D] = 0x3f81; // row 0 is read through variant 1
+    try std.testing.expectEqual(Seen.fast, seen(nat, .{ f0, f1 }, T, 0, 3));
+    try std.testing.expectEqual(Seen.unseen, seen(nat, .{ f0, f1 }, T, 1, 3)); // rows 16 .. 16: variant 1 plants row 17
+    plant(f0, T, 1);
+    try std.testing.expectEqual(@as(u16, 0x0001), f0[(1 * HQ + 47) * D]);
+    try std.testing.expectEqual(@as(u16, 0x3f80), f0[(2 * HQ + 47) * D]);
+}
+
+/// Whether every row of a T-row prompt run in forwards of n rows from position 0 finds each key of its sliding window
+/// (distances 0 .. 1023) in its slot of a ring of `slots`, a forward's keys written before any of its rows runs.
+fn ringKeeps(gpa: std.mem.Allocator, T: usize, n: usize, slots: usize) !bool {
+    const held = try gpa.alloc(usize, slots);
+    defer gpa.free(held);
+    @memset(held, std.math.maxInt(usize));
+    var p0: usize = 0;
+    while (p0 < T) : (p0 += n) {
+        const end = @min(p0 + n, T);
+        for (p0..end) |p| held[p % slots] = p;
+        for (p0..end) |pos| for ((if (pos > 1023) pos - 1023 else 0)..pos + 1) |j| {
+            if (held[j % slots] != j) return false;
+        };
+    }
+    return true;
+}
+
+test "--chunks: a forward the sliding ring cannot hold whole is refused" {
+    const gpa = std.testing.allocator;
+    const slots = 1023 + prompt_rows;
+    try std.testing.expect(!chunkOk(0));
+    for ([_]usize{ 1, 64, 2047, 2048, 2049, 3071, 4096 }) |n| {
+        // two whole forwards of every n: the second forward of 2049 writes position 4097 over key 1026, which its
+        // first row (2049) attends; a forward of 4096 writes position 3071 over key 0 before row 0 runs
+        try std.testing.expectEqual(try ringKeeps(gpa, 2 * slots, n, slots), chunkOk(n));
+    }
+}
+
+test "kxRow: a loaded slot the forward overwrote is tested as it is held, not by its position" {
+    const gpa = std.testing.allocator;
+    const T = 4096;
+    const slots = 1023 + prompt_rows;
+    var in = try tiny(gpa, .sliding, T);
+    defer in.free(gpa);
+    const s = try gpa.alloc(f64, 1100);
+    defer gpa.free(s);
+    in.vRow(0, 4095)[5] = 0x0001; // a subnormal value at position 4095, in slot 4095 % 3071 = 1024
+    // forwards of 2048: the second writes 2048 .. 4095, then block 128 (rows 2048 .. 2063, first key 1025) loads the
+    // tile from 1024, whose slot holds position 4095
+    var p: Pred = .{};
+    for (2048..2064) |t| p.join(kxRow(&in, t, 0, s, 2048, slots));
+    try std.testing.expect(p.kv_bad and kxRow(&in, 2048, 0, s, 2048, slots).kv_bad);
+    try std.testing.expect(!kxRow(&in, 2048, 6, s, 2048, slots).kv_bad); // kv head 1
+    try std.testing.expect(!kxRow(&in, 2047, 0, s, 2048, slots).kv_bad); // the first forward: slot 1024 holds 1024
+    try std.testing.expect(!kxRow(&in, 2048, 0, s, 64, slots).kv_bad); // forwards of 64: 4095 not yet written
+    try std.testing.expect(kxRow(&in, 4095, 0, s, 64, slots).kv_bad); // its own row
+    try std.testing.expect(!kxRow(&in, 2048, 0, s, 2048, T).kv_bad); // a slot a position
+    try std.testing.expectEqual(@as(usize, 4095), owner(1024, 4096, slots));
+}
+
+test "owner: the position a slot holds, against a ring written forward by forward" {
+    const gpa = std.testing.allocator;
+    const slots = 1023 + prompt_rows;
+    const held = try gpa.alloc(usize, slots);
+    defer gpa.free(held);
+    for ([_]usize{ 1, 64, 2048 }) |n| {
+        @memset(held, std.math.maxInt(usize));
+        var end: usize = 0;
+        while (end < 7000) {
+            const next = @min(end + n, 7000);
+            for (end..next) |q| held[q % slots] = q;
+            end = next;
+            var j = end -| 3 * slots;
+            while (j < end) : (j += 7) try std.testing.expectEqual(held[j % slots], owner(j, end, slots));
+        }
+    }
+}
diff --git a/zig/src/families/inkling2/cuda_conv.zig b/zig/src/families/inkling2/cuda_conv.zig
new file mode 100644
index 0000000000000000000000000000000000000000..8744efceaa22bbab6e6c9c97a7803748b913bb35
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_conv.zig
@@ -0,0 +1,371 @@
+//! G-conv: the four short depthwise 4-tap causal convolutions of a layer: K and V (static taps in sliding layers;
+//! static plus per-token taps in global layers), after attention and after the MLP. Kernel image: inkling2_conv.cu.
+//! Math: Transformers modeling_inkling2.py (Apache-2.0), Inkling2ShortConvolution and
+//! Inkling2DynamicShortConvolution; their conv weights are kept in fp32 (stored bf16, exact).
+//!
+//! Every convolution reads raw bf16 input rows x_t (t = pos0 .. pos0 + R - 1) and, for t - j < pos0, the stream's
+//! state: bf16 [3, C], row 0 = the input at pos0 - 3, row 2 = at pos0 - 1 (zeros before position 0). Entry points
+//! only read the state; the scaffold commits it afterwards (cuda_state.zig `convCommit`: the last 3 input rows).
+//! All arithmetic fp32, one bf16 rounding of the output.
+//!
+//! Static form (sliding K and V: C = hk*128, taps `l.k_conv` / `l.v_conv` [C, 4]; post-attention and post-MLP:
+//!   C = 4608, taps `l.attn_conv` / `l.mlp_conv` [C, 4]; tap 3 multiplies the current row):
+//!   y_t[c] = (x_t[c] + sum_{j=0..3} w[c][j] * x_{t-3+j}[c]) / sqrt(5)
+//! Dynamic form (global K and V: C = hk*128, static taps `l.k_conv` / `l.v_conv` [4, C] with lag 0 = current row,
+//!   per-token taps dk / dv bf16 [R, hk*4] from attn.project, row t, column head*4 + lag, head = c / 128):
+//!   y_t[c] = (x_t[c] + sum_{lag=0..3} (static[lag][c] + f32(d_t[c/128*4 + lag])) * x_{t-lag}[c]) / sqrt(9)
+//! The division is torch's on CUDA: a tensor divided by a Python scalar is multiplied by the scalar's fp32
+//! reciprocal (measured: 1.4 M of 4.2 M fp32 quotients by 3 differ from true division), so the kernels multiply by
+//! `inv(5)` / `inv(9)`. The sums are torch's in fp32 (inkling2_conv.cu): the static taps oldest row first (bf16 x
+//! bf16 products are exact in fp32, so only the order counts; cuDNN's conv1d matched at rows 1 to 4000), the dynamic
+//! lags as (p0 + p2) + (p1 + p3), the order torch's sum(-1) takes at every row count tried (1 to 4000).
+//!
+//! `kv` (conv.kv, L4): kc = conv(k), vc = conv(v), both bf16 [R, hk*128]; global layers use dk, dv.
+//! `post` (conv.attn L16 with `l.attn_conv`, conv.mlp L21 with `l.mlp_conv`): out bf16 [R, 4608].
+//! A row's bits depend only on its own four input rows and taps (one thread walks rows of two channels), so they
+//! do not depend on the forward's row count or on how a prompt is chunked.
+//! Oracle tensors: op.<L>.conv.<kv|attn|mlp>.out.* (inkling2_op_ref.py capture). Test alone: the runner with
+//! --feed <capture> --dump-ops, then inkling2_compare.py --ops; a chunked run (--chunk) checks the state seam, and
+//! inkling2_compare.py with another run's dump as --ops compares two chunkings' op outputs bit for bit.
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const weights = @import("cuda_weights.zig");
+
+const Ctx = ops.Ctx;
+const Mat = ops.Mat;
+const Layer = weights.Layer;
+
+/// Rows of state a stream keeps a convolution.
+pub const state_rows = 3;
+
+/// inkling2_conv.cu's threads a block (two channels a thread) and rows a thread walks.
+const threads = 128;
+pub const rows_a_thread = 16;
+
+/// fp32(1) / fp32(sqrt(n)): what torch multiplies by for `t / math.sqrt(n)` on a CUDA tensor.
+pub fn inv(n: f64) f32 {
+    const s: f32 = @floatCast(@sqrt(n));
+    return 1.0 / s;
+}
+
+/// inkling2_conv.cu's functions.
+pub const Kernels = struct {
+    group: Group,
+    static_fn: cuda.Function,
+    dynamic_fn: cuda.Function,
+    commit_fn: cuda.Function,
+    /// A verify window's commit keeping its inputs, and `keep`'s rollback of a whole slot (cuda_state.zig).
+    commit_spec_fn: cuda.Function,
+    keep_fn: cuda.Function,
+    /// conv.kv and the K and V commits as one launch (kvCommit)
+    kv_commit_fn: cuda.Function,
+    /// The same for every segment of a batched forward in one launch (kvCommitSegs, postCommitSegs)
+    kv_commit_segs_fn: cuda.Function,
+
+    const Group = @import("cuda_kernels.zig").Group("conv");
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        var g = try Group.load(d);
+        errdefer g.unload();
+        return .{
+            .group = g,
+            .static_fn = try g.mod.function("tf_ink2_conv_static"),
+            .dynamic_fn = try g.mod.function("tf_ink2_conv_dynamic"),
+            .commit_fn = try g.mod.function("tf_ink2_conv_commit"),
+            .commit_spec_fn = try g.mod.function("tf_ink2_conv_commit_spec"),
+            .keep_fn = try g.mod.function("tf_ink2_conv_keep"),
+            .kv_commit_fn = try g.mod.function("tf_ink2_conv_kv_commit"),
+            .kv_commit_segs_fn = try g.mod.function("tf_ink2_conv_kv_commit_segs"),
+        };
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.group.unload();
+        k.* = undefined;
+    }
+};
+
+/// One convolution's rows: x [R, C] in, y [R, C] out (bf16, any even ld), the stream's state [3, C], static taps,
+/// and in the dynamic form the per-token taps d [R, C/128*4].
+const Conv = struct {
+    x: Mat,
+    y: Mat,
+    state: u64,
+    taps: u64,
+    d: ?Mat = null,
+};
+
+fn bf16Rows(m: Mat, rows: usize, cols: usize) bool {
+    return m.ptr != 0 and m.is(rows, cols, .bf16) and m.ld >= cols and m.ld % 2 == 0 and m.ptr % 4 == 0;
+}
+
+fn run(c: *const Ctx, v: Conv) !void {
+    const R = v.x.rows;
+    const C = v.x.cols;
+    if (C == 0 or C % 2 != 0 or !bf16Rows(v.x, R, C) or !bf16Rows(v.y, R, C)) return error.BadConvShape;
+    if (v.state == 0 or v.state % 4 != 0 or v.taps == 0) return error.BadConvShape;
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(v.x.ptr);
+    a.add(@as(i64, @intCast(v.x.ld)));
+    a.add(v.state);
+    a.add(v.taps);
+    const f = if (v.d) |d| blk: {
+        if (C % weights.head_dim != 0 or v.taps % 4 != 0) return error.BadConvShape;
+        const width = C / weights.head_dim * weights.taps;
+        if (d.ptr == 0 or !d.is(R, width, .bf16) or d.ld < width) return error.BadConvShape;
+        a.add(d.ptr);
+        a.add(@as(i64, @intCast(d.ld)));
+        break :blk c.k.conv.dynamic_fn;
+    } else c.k.conv.static_fn;
+    a.add(v.y.ptr);
+    a.add(@as(i64, @intCast(v.y.ld)));
+    a.add(@as(i32, @intCast(R)));
+    a.add(@as(i32, @intCast(C)));
+    a.add(inv(if (v.d != null) 2 * weights.taps + 1 else weights.taps + 1));
+    const grid: cuda.Dim3 = .{
+        .x = @intCast(std.math.divCeil(usize, C, 2 * threads) catch unreachable),
+        .y = @intCast(std.math.divCeil(usize, R, rows_a_thread) catch unreachable),
+        .z = 1,
+    };
+    try cuda.launch.launch(f, .{ .grid = grid, .block = .{ .x = threads } }, c.stream, &a);
+}
+
+/// L4: the K and V convolutions (see the header). dk, dv are empty in sliding layers.
+pub fn kv(c: *const Ctx, l: *const Layer, k: Mat, v: Mat, dk: Mat, dv: Mat, state_k: u64, state_v: u64, kc: Mat, vc: Mat) !void {
+    const C = @as(usize, l.hk) * weights.head_dim;
+    if (k.cols != C or v.cols != C) return error.BadConvShape;
+    try run(c, .{ .x = k, .y = kc, .state = state_k, .taps = l.k_conv, .d = if (l.global) dk else null });
+    try run(c, .{ .x = v, .y = vc, .state = state_v, .taps = l.v_conv, .d = if (l.global) dv else null });
+}
+
+/// inkling2_conv.cu KvCommit: K's and V's convolution and commit (index 0 K, 1 V).
+const KvCommitArgs = extern struct {
+    x: [2]u64,
+    ldx: [2]i64,
+    s: [2]u64,
+    w: [2]u64,
+    d: [2]u64 = .{ 0, 0 },
+    ldd: [2]i64 = .{ 0, 0 },
+    y: [2]u64,
+    ldy: [2]i64,
+    h: [2]u64 = .{ 0, 0 },
+};
+
+/// `kv` and then the K and V state commits (cuda_state.zig convCommit, or convCommitSpec where `hist_k` / `hist_v`
+/// are not 0) as one launch, for a forward of up to `rows_a_thread` rows (one thread walks all of its channels'
+/// rows, so it can commit them after it read them): the same output bits and the same state and history bytes.
+pub fn kvCommit(c: *const Ctx, l: *const Layer, k: Mat, v: Mat, dk: Mat, dv: Mat, state_k: u64, state_v: u64, hist_k: u64, hist_v: u64, kc: Mat, vc: Mat) !void {
+    const R = k.rows;
+    const p = try kvArgs(l, k, v, dk, dv, state_k, state_v, hist_k, hist_v, kc, vc);
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(p);
+    a.add(@as(i32, @intCast(R)));
+    a.add(@as(i32, @intCast(k.cols)));
+    a.add(inv(if (l.global) 2 * weights.taps + 1 else weights.taps + 1));
+    const grid: cuda.Dim3 = .{ .x = @intCast(std.math.divCeil(usize, k.cols, 2 * threads) catch unreachable), .y = 1, .z = 2 };
+    try cuda.launch.launch(c.k.conv.kv_commit_fn, .{ .grid = grid, .block = .{ .x = threads } }, c.stream, &a);
+}
+
+/// kvCommit's checks and arguments.
+fn kvArgs(l: *const Layer, k: Mat, v: Mat, dk: Mat, dv: Mat, state_k: u64, state_v: u64, hist_k: u64, hist_v: u64, kc: Mat, vc: Mat) !KvCommitArgs {
+    const C = @as(usize, l.hk) * weights.head_dim;
+    const R = k.rows;
+    if (k.cols != C or v.cols != C or v.rows != R or R > rows_a_thread) return error.BadConvShape;
+    if ((hist_k != 0 or hist_v != 0) and R > 8) return error.BadConvShape;
+    for ([_]Mat{ k, v, kc, vc }) |m| if (!bf16Rows(m, R, C)) return error.BadConvShape;
+    for ([_]u64{ state_k, state_v }) |st| if (st == 0 or st % 4 != 0) return error.BadConvShape;
+    if (C % 2 != 0 or l.k_conv == 0 or l.v_conv == 0) return error.BadConvShape;
+    var p: KvCommitArgs = .{
+        .x = .{ k.ptr, v.ptr },
+        .ldx = .{ @intCast(k.ld), @intCast(v.ld) },
+        .s = .{ state_k, state_v },
+        .w = .{ l.k_conv, l.v_conv },
+        .y = .{ kc.ptr, vc.ptr },
+        .ldy = .{ @intCast(kc.ld), @intCast(vc.ld) },
+        .h = .{ hist_k, hist_v },
+    };
+    if (l.global) {
+        const width = C / weights.head_dim * weights.taps;
+        for ([_]Mat{ dk, dv }, 0..) |d, i| {
+            if (d.ptr == 0 or !d.is(R, width, .bf16) or d.ld < width) return error.BadConvShape;
+            p.d[i] = d.ptr;
+            p.ldd[i] = @intCast(d.ld);
+        }
+    }
+    return p;
+}
+
+/// `post` and then its state commit (convCommit, or convCommitSpec where `hist` is not 0) as one launch, for a
+/// forward of up to `rows_a_thread` rows (tf_ink2_conv_kv_commit with one convolution): the same bits and bytes.
+pub fn postCommit(c: *const Ctx, taps: u64, x: Mat, state: u64, hist: u64, out: Mat) !void {
+    const C = weights.hidden;
+    const R = x.rows;
+    const p = try postArgs(taps, x, state, hist, out);
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(p);
+    a.add(@as(i32, @intCast(R)));
+    a.add(@as(i32, @intCast(C)));
+    a.add(inv(weights.taps + 1));
+    const grid: cuda.Dim3 = .{ .x = @intCast(std.math.divCeil(usize, C, 2 * threads) catch unreachable), .y = 1, .z = 1 };
+    try cuda.launch.launch(c.k.conv.kv_commit_fn, .{ .grid = grid, .block = .{ .x = threads } }, c.stream, &a);
+}
+
+/// postCommit's checks and arguments (index 0).
+fn postArgs(taps: u64, x: Mat, state: u64, hist: u64, out: Mat) !KvCommitArgs {
+    const C = weights.hidden;
+    const R = x.rows;
+    if (x.cols != C or R > rows_a_thread or (hist != 0 and R > 8)) return error.BadConvShape;
+    if (!bf16Rows(x, R, C) or !bf16Rows(out, R, C) or state == 0 or state % 4 != 0 or taps == 0) return error.BadConvShape;
+    return .{
+        .x = .{ x.ptr, 0 },
+        .ldx = .{ @intCast(x.ld), 0 },
+        .s = .{ state, 0 },
+        .w = .{ taps, 0 },
+        .y = .{ out.ptr, 0 },
+        .ldy = .{ @intCast(out.ld), 0 },
+        .h = .{ hist, 0 },
+    };
+}
+
+/// Segments a segs launch carries at most (inkling2_conv.cu MS; cuda_forward.zig max_segs).
+pub const max_segs = 8;
+
+/// One stream's rows of a batched forward for kvCommitSegs / postCommitSegs: rows row0 .. row0 + rows of the
+/// forward's matrices, the stream's state (index 0 K, 1 V; postCommitSegs uses index 0) and its history, or 0.
+pub const Seg = struct {
+    row0: usize,
+    rows: usize,
+    state: [2]u64,
+    hist: [2]u64 = .{ 0, 0 },
+};
+
+/// inkling2_conv.cu KvCommitSegs: the shared matrices of KvCommitArgs, then each segment's rows, states and histories.
+const KvCommitSegsArgs = extern struct {
+    x: [2]u64,
+    ldx: [2]i64,
+    w: [2]u64,
+    d: [2]u64 = .{ 0, 0 },
+    ldd: [2]i64 = .{ 0, 0 },
+    y: [2]u64,
+    ldy: [2]i64,
+    s: [max_segs][2]u64 = @splat(.{ 0, 0 }),
+    h: [max_segs][2]u64 = @splat(.{ 0, 0 }),
+    row0: [max_segs]i32 = @splat(0),
+    rows: [max_segs]i32 = @splat(0),
+
+    /// Segment j's entry from the arguments kvCommit or postCommit would take for its rows alone.
+    fn put(t: *KvCommitSegsArgs, j: usize, g: Seg, q: KvCommitArgs) void {
+        t.s[j] = q.s;
+        t.h[j] = q.h;
+        t.row0[j] = @intCast(g.row0);
+        t.rows[j] = @intCast(g.rows);
+    }
+};
+
+/// The segments in row order, not overlapping, each inside `R` rows, at most max_segs; the empty ones left out.
+fn segsFit(segs: []const Seg, R: usize) !void {
+    if (segs.len > max_segs) return error.BadConvShape;
+    var end: usize = 0;
+    for (segs) |g| {
+        if (g.rows == 0) continue;
+        if (g.row0 < end or g.row0 + g.rows > R) return error.BadConvShape;
+        end = g.row0 + g.rows;
+    }
+}
+
+/// kvCommit for every segment of a batched forward in one launch (blockIdx.y a segment): k, v, dk, dv, kc and vc
+/// are the whole forward's rows, and each segment gets kvCommit's checks on its own rows, so each stream's output
+/// and state bytes are those of its own kvCommit. Segments never share a state (a slot runs once a forward) and
+/// their rows are disjoint, so the one launch does what the launches a segment do, in any order.
+pub fn kvCommitSegs(c: *const Ctx, l: *const Layer, k: Mat, v: Mat, dk: Mat, dv: Mat, kc: Mat, vc: Mat, segs: []const Seg) !void {
+    const R = @min(k.rows, v.rows, kc.rows, vc.rows);
+    try segsFit(segs, if (l.global) @min(R, dk.rows, dv.rows) else R);
+    var t: KvCommitSegsArgs = .{
+        .x = .{ k.ptr, v.ptr },
+        .ldx = .{ @intCast(k.ld), @intCast(v.ld) },
+        .w = .{ l.k_conv, l.v_conv },
+        .y = .{ kc.ptr, vc.ptr },
+        .ldy = .{ @intCast(kc.ld), @intCast(vc.ld) },
+    };
+    if (l.global) {
+        t.d = .{ dk.ptr, dv.ptr };
+        t.ldd = .{ @intCast(dk.ld), @intCast(dv.ld) };
+    }
+    var n: usize = 0;
+    for (segs) |g| {
+        if (g.rows == 0) continue;
+        const r = g.row0;
+        const sdk = if (l.global) dk.slice(r, g.rows) else dk;
+        const sdv = if (l.global) dv.slice(r, g.rows) else dv;
+        t.put(n, g, try kvArgs(l, k.slice(r, g.rows), v.slice(r, g.rows), sdk, sdv, g.state[0], g.state[1], g.hist[0], g.hist[1], kc.slice(r, g.rows), vc.slice(r, g.rows)));
+        n += 1;
+    }
+    if (n == 0) return;
+    const C = k.cols;
+    var a: cuda.Args = .{};
+    a.add(t);
+    a.add(@as(i32, @intCast(C)));
+    a.add(inv(if (l.global) 2 * weights.taps + 1 else weights.taps + 1));
+    const grid: cuda.Dim3 = .{ .x = @intCast(std.math.divCeil(usize, C, 2 * threads) catch unreachable), .y = @intCast(n), .z = 2 };
+    try cuda.launch.launch(c.k.conv.kv_commit_segs_fn, .{ .grid = grid, .block = .{ .x = threads } }, c.stream, &a);
+}
+
+/// postCommit for every segment of a batched forward in one launch (see kvCommitSegs): x and out are the whole
+/// forward's rows, each segment's state and history at index 0.
+pub fn postCommitSegs(c: *const Ctx, taps: u64, x: Mat, out: Mat, segs: []const Seg) !void {
+    try segsFit(segs, @min(x.rows, out.rows));
+    var t: KvCommitSegsArgs = .{
+        .x = .{ x.ptr, 0 },
+        .ldx = .{ @intCast(x.ld), 0 },
+        .w = .{ taps, 0 },
+        .y = .{ out.ptr, 0 },
+        .ldy = .{ @intCast(out.ld), 0 },
+    };
+    var n: usize = 0;
+    for (segs) |g| {
+        if (g.rows == 0) continue;
+        t.put(n, g, try postArgs(taps, x.slice(g.row0, g.rows), g.state[0], g.hist[0], out.slice(g.row0, g.rows)));
+        n += 1;
+    }
+    if (n == 0) return;
+    var a: cuda.Args = .{};
+    a.add(t);
+    a.add(@as(i32, @intCast(weights.hidden)));
+    a.add(inv(weights.taps + 1));
+    const grid: cuda.Dim3 = .{ .x = @intCast(std.math.divCeil(usize, weights.hidden, 2 * threads) catch unreachable), .y = @intCast(n), .z = 1 };
+    try cuda.launch.launch(c.k.conv.kv_commit_segs_fn, .{ .grid = grid, .block = .{ .x = threads } }, c.stream, &a);
+}
+
+/// L16 / L21: a static 4-tap convolution of 4608 channels with `taps` [4608, 4] (see the header).
+pub fn post(c: *const Ctx, taps: u64, x: Mat, state: u64, out: Mat) !void {
+    if (x.cols != weights.hidden) return error.BadConvShape;
+    try run(c, .{ .x = x, .y = out, .state = state, .taps = taps });
+}
+
+/// Runs once per loaded layer (cuda_weights.zig `Prepare`): the taps are used as stored.
+pub fn prepare(w: *weights.Weights, l: *Layer) anyerror!void {
+    _ = .{ w, l };
+}
+
+test "inkling2 cuda conv: the segs launch's arguments" {
+    // inkling2_conv.cu KvCommitSegs: 7 pairs of 8 bytes, 2 x 8 pointer pairs, 2 x 8 ints; well under the 4 KB of
+    // kernel parameters
+    try std.testing.expectEqual(@as(usize, 432), @sizeOf(KvCommitSegsArgs));
+    try std.testing.expectEqual(@as(usize, 112), @offsetOf(KvCommitSegsArgs, "s"));
+    try std.testing.expectEqual(@as(usize, 368), @offsetOf(KvCommitSegsArgs, "row0"));
+    const ok = [_]Seg{ .{ .row0 = 0, .rows = 2, .state = .{ 4, 4 } }, .{ .row0 = 2, .rows = 0, .state = .{ 4, 4 } }, .{ .row0 = 2, .rows = 3, .state = .{ 4, 4 } } };
+    try segsFit(&ok, 5);
+    try std.testing.expectError(error.BadConvShape, segsFit(&ok, 4));
+    const overlap = [_]Seg{ .{ .row0 = 0, .rows = 2, .state = .{ 4, 4 } }, .{ .row0 = 1, .rows = 1, .state = .{ 4, 4 } } };
+    try std.testing.expectError(error.BadConvShape, segsFit(&overlap, 8));
+}
+
+test "inkling2 cuda conv: torch's reciprocals of sqrt(5) and sqrt(9)" {
+    // fp32(sqrt(5)) = 2.236068 (0x400F1BBD); its fp32 reciprocal 0x3EE4F92E; 1 / fp32(3) = 0x3EAAAAAB
+    try std.testing.expectEqual(@as(u32, 0x3EE4F92E), @as(u32, @bitCast(inv(5))));
+    try std.testing.expectEqual(@as(u32, 0x3EAAAAAB), @as(u32, @bitCast(inv(9))));
+}
diff --git a/zig/src/families/inkling2/cuda_fuse.zig b/zig/src/families/inkling2/cuda_fuse.zig
new file mode 100644
index 0000000000000000000000000000000000000000..e7fcba17ff4d8dad0487d0d6bb26212a63324865
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_fuse.zig
@@ -0,0 +1,289 @@
+//! G-fuse: stateless neighbours of the forward as one launch each, and their one-row latency forms. Kernel image:
+//! inkling2_fuse.cu. Each entry point runs the same expressions in the same order as the ops it replaces, so its
+//! outputs are the same bits (checked by `tf-inkling2-fuse`, each form against the unfused sequence at 1, 2, 8 and
+//! 2048 rows), and it writes every tensor those ops wrote (the mix outputs too), so later ops read the same memory.
+//!
+//!   attnIn  = res.mix (attn_input) + res.norm (attn_norm, or q/k/v_norm)       2 launches (4 global) -> 1
+//!   mlpIn   = res.partial + state.pushBlock + res.mix (mlp_input) + res.norm     3 (4 at a boundary)   -> 1
+//!   route   = moe.route's logits, then select + slot order (checkpoint mode)    3 -> 2
+//!   proj    = a layer's projections of 1-16 rows (cuda_attn.zig `projectOne`)  6 -> 1 (8 -> 3 global); 2-16
+//!             rows add one copy launch
+//!   conv    = conv.kv + the K and V state commits, 1-16 rows (cuda_conv.zig `kvCommit`)          4 -> 1
+//!             conv.attn, conv.mlp + their commits (`postCommit`)                              2 -> 1 each
+//!
+//! Every form is row-invariant (a CTA a row, or a warp a row), so it also holds under any row count.
+//!
+//! Two forms of each (TF_INK2_FUSE, `Mode`), never while the forward's hooks record or feed ops:
+//!   - the latency forms (tf_ink2_lat_*; the default, for calls of up to `lat_rows` rows: decode steps, verify
+//!     windows): 576 threads a row, every source loaded once up front and kept in registers, a barrier a phase, the
+//!     softmax on one warp's lanes; select's 8 rounds on two warp reductions each. At one row on GB10 (48 layers'
+//!     worth, tf-inkling2-fuse) the three cost 27 us a layer against the release's 43; in the W = 4 decode step on
+//!     the Sparks they save 1.23 +- 0.05 ms a step (tf-inkling2-decode --exp check,fuse, against an A/A control of
+//!     -0.08 +- 0.06). Prompt chunks keep the release's ops.
+//!   - `proj` (in the default): a sliding layer's q, k, v, rel, gate and sink of one row as one lane-matmul launch
+//!     on the six packed weights as one, each member's outputs a view of its row, the same sums (the members' K
+//!     slices pinned; the 32- and 64-column tiles sum alike); a global layer's eight as three, one a source (q, rel,
+//!     gate, sink from xq; k and its window projection from xk; v and its from xv: the packing order puts each
+//!     source's side by side). Windows of 2-16 rows run the same launches into one buffer, each group's rows
+//!     dense, then one launch (tf_ink2_proj_split) copies each projection's columns to its own rows. In the W = 4
+//!     decode step on the Sparks it saves a further 1.41 ms a step for the sliding layers (tf-inkling2-decode --exp
+//!     check,fuse --ab 600:
+//!     2.64 +- 0.04 ms with it against the release's ops, 1.21-1.24 without it; A/A -0.06 +- 0.04; logits
+//!     bit-equal 600/600) and 0.08 ms more for the global ones (2.71-2.73 against 2.64). It applies only where a group's K
+//!     slices agree (W = 4's rank shape; at W = 1 and 2 q and gate take fewer slices than k and v, and the launches
+//!     stay). Windows (--ab-rows, 300 steps): 1.39 ms a 2-row window (2.61 +- 0.05 against 1.22 +- 0.05 without),
+//!     1.52 ms an 8-row one (2.74 +- 0.06 against 1.22 +- 0.06), logits of every row bit-equal 300/300.
+//!   - `conv` (in the default): conv.kv and the K and V state commits (cuda_state.zig convCommit, or
+//!     convCommitSpec on a slot with drafts) as one launch for up to 16 rows (cuda_conv.zig kvCommit,
+//!     tf_ink2_conv_kv_commit: a thread walks all rows of its two channels, so it commits them after it read them;
+//!     the same expressions and bytes). 4 launches a layer to 1; at W = 4 0.11-0.17 ms a step (saved 2.904-2.914
+//!     against 2.745-2.794 without it, 600/600) and 0.15 ms an 8-row window (2.842 against 2.688, 300/300). The
+//!     post-attention and post-MLP convolutions take their commits the same way (cuda_conv.zig postCommit, 2 launches
+//!     to 1 each): 0.12-0.21 ms more a step (3.023-3.086 against 2.881-2.906) and 0.07 ms an 8-row window.
+//!   - the stage-1 fusions (tf_ink2_fuse_*, TF_INK2_FUSE=1): one launch each, but the same latency as the ops they
+//!     replace (one CTA of 1,024 threads, one dependent round trip a source a pass); 0.18 ms slower than the
+//!     release's ops at W = 4 (graph nodes cost about 0.15 us on GB10, so fewer nodes buy little).
+const std = @import("std");
+const cuda = @import("cuda");
+const ops = @import("cuda_ops.zig");
+const res = @import("cuda_res.zig");
+const moe = @import("cuda_moe.zig");
+
+const Ctx = ops.Ctx;
+const Mat = ops.Mat;
+const Blocks = ops.Blocks;
+const H = res.width;
+/// Threads a row: norms.cu's tf_rms_rows block (the norm's sums are its order).
+const row_threads = 1024;
+const most_blocks = 8;
+const most_queries = 3;
+
+/// Which of the forward's stateless ops run in this file's forms (TF_INK2_FUSE): `fused` the stage-1 fusions (attnIn,
+/// mlpIn, route on the tf_ink2_fuse_* kernels), the rest the latency forms one by one. All false: the release's ops.
+pub const Mode = struct {
+    fused: bool = false,
+    attn: bool = false,
+    mlp: bool = false,
+    route: bool = false,
+    /// A layer's projections as one launch a source (cuda_attn.zig `projectOne`), up to attn.one_rows rows.
+    proj: bool = false,
+    /// Each convolution and its state commit as one launch (cuda_conv.zig `kvCommit`, `postCommit`), up to 16 rows.
+    conv: bool = false,
+    /// Split experts in K1's forms (cuda_moe.zig `Form.k1`), up to 8 rows.
+    moe: bool = false,
+    /// With `conv`, in a forward of several streams' rows: each convolution and its commits for every stream in one
+    /// launch (cuda_conv.zig `kvCommitSegs`, `postCommitSegs`) instead of one a stream, and the fused form for any
+    /// forward whose largest stream has up to 16 rows (not only up to 16 rows in all). Like every latency form it
+    /// applies to forwards of at most `lat_rows` (64) rows in all (forRows): above that, each stream's convolutions
+    /// run unfused as in v0.2. Not in the default yet.
+    segs: bool = false,
+
+    pub const none: Mode = .{};
+    pub const lat: Mode = .{ .attn = true, .mlp = true, .route = true, .proj = true, .conv = true };
+
+    /// The forward's attention input runs attnIn (fused or latency form).
+    pub fn attnIn(m: Mode) bool {
+        return m.fused or m.attn;
+    }
+
+    /// The forward's MLP input runs mlpIn (fused or latency form).
+    pub fn mlpIn(m: Mode) bool {
+        return m.fused or m.mlp;
+    }
+
+    /// The forward's router runs `route` here.
+    pub fn router(m: Mode) bool {
+        return m.fused or m.route;
+    }
+
+    /// The forms a call of R rows runs: the latency forms only up to `lat_rows` rows (the stage-1 fusions at any).
+    pub fn forRows(m: Mode, R: usize) Mode {
+        return if (R <= lat_rows) m else .{ .fused = m.fused };
+    }
+
+    /// TF_INK2_FUSE: unset or lat every latency form and proj (the default); 0 none (v0.2's ops); 1 the stage-1
+    /// fusions; else a comma list of attn, mlp, route, proj, conv, moe, segs (attn,mlp,route: v0.2's default).
+    pub fn parse(v: []const u8) !Mode {
+        if (std.mem.eql(u8, v, "0")) return .none;
+        if (std.mem.eql(u8, v, "1")) return .{ .fused = true };
+        if (v.len == 0 or std.mem.eql(u8, v, "lat")) return .lat;
+        var m: Mode = .{};
+        var it = std.mem.splitScalar(u8, v, ',');
+        while (it.next()) |w| {
+            if (std.mem.eql(u8, w, "attn")) m.attn = true else if (std.mem.eql(u8, w, "mlp")) m.mlp = true else if (std.mem.eql(u8, w, "route")) m.route = true else if (std.mem.eql(u8, w, "proj")) m.proj = true else if (std.mem.eql(u8, w, "conv")) m.conv = true else if (std.mem.eql(u8, w, "moe")) m.moe = true else if (std.mem.eql(u8, w, "segs")) m.segs = true else return error.BadInk2Fuse;
+        }
+        return m;
+    }
+};
+
+/// The most rows a call runs the latency forms at (decode steps, verify windows, a few streams' rows); prompt chunks
+/// run the release's ops.
+pub const lat_rows = 64;
+
+/// inkling2_fuse.cu's functions, and the switch.
+pub const Kernels = struct {
+    g: @import("cuda_kernels.zig").Group("fuse"),
+    attn_in: cuda.Function,
+    mlp_in: cuda.Function,
+    route_fn: cuda.Function,
+    lat_attn_in: cuda.Function,
+    lat_mlp_in: cuda.Function,
+    lat_route: cuda.Function,
+    /// cuda_attn.zig projectOne's copy of each projection's columns to its rows (2 or more rows)
+    proj_split: cuda.Function,
+    /// TF_INK2_FUSE (default the latency forms): the forms the forward runs.
+    mode: Mode = .lat,
+
+    pub fn load(d: *const cuda.Driver) !Kernels {
+        var g = try @import("cuda_kernels.zig").Group("fuse").load(d);
+        errdefer g.unload();
+        const k: Kernels = .{
+            .g = g,
+            .attn_in = try g.mod.function("tf_ink2_fuse_attn_in"),
+            .mlp_in = try g.mod.function("tf_ink2_fuse_mlp_in"),
+            .route_fn = try g.mod.function("tf_ink2_fuse_route"),
+            .lat_attn_in = try g.mod.function("tf_ink2_lat_attn_in"),
+            .lat_mlp_in = try g.mod.function("tf_ink2_lat_mlp_in"),
+            .lat_route = try g.mod.function("tf_ink2_lat_route"),
+            .proj_split = try g.mod.function("tf_ink2_proj_split"),
+            .mode = try fromEnv(),
+        };
+        try k.lat_attn_in.allowDynamicShared(lat_staged * most_queries);
+        try k.lat_mlp_in.allowDynamicShared(lat_staged);
+        return k;
+    }
+
+    pub fn unload(k: *Kernels) void {
+        k.g.unload();
+    }
+};
+
+/// TF_INK2_FUSE (see `Mode.parse`).
+pub fn fromEnv() !Mode {
+    return Mode.parse(std.mem.span(std.c.getenv("TF_INK2_FUSE") orelse return .lat));
+}
+
+/// The latency forms' threads a row (the mix's 576) and dynamic shared bytes a staged row (fp32).
+const lat_threads = H / 8;
+const lat_staged: u32 = H * 4;
+
+fn mixScale() f32 {
+    return @floatCast(1.0 / @sqrt(@as(f64, H)));
+}
+
+fn rowsOk(m: Mat, R: usize, dt: ops.Dt) bool {
+    return m.is(R, H, dt) and m.dense() and m.ptr % 16 == 0;
+}
+
+fn blocksOk(b: Blocks, R: usize, most: usize) bool {
+    return b.count <= most and b.hidden == H and (b.count == 0 or b.rows == R) and b.stride % 16 == 0 and b.ptr % 16 == 0;
+}
+
+/// res.attn_input then its norms: xs[j] fp32 = Mix(queries j; blocks, h_in) for j < nq (cuda_res.zig `mix`), then
+/// ys[j] bf16 = norm(xs[nq == 1 ? 0 : j], gains[j]) for j < ys.len (cuda_res.zig `norm`).
+pub fn attnIn(c: *const Ctx, blocks: Blocks, h_in: Mat, queries: u64, nq: usize, xs: []const Mat, gains: []const u64, ys: []const Mat) !void {
+    const R = h_in.rows;
+    const nn = ys.len;
+    if (nq == 0 or nq > most_queries or xs.len < nq or queries == 0 or nn == 0 or nn > most_queries or gains.len < nn) return error.BadFuseShape;
+    if (nq != 1 and nq != nn) return error.BadFuseShape;
+    if (!blocksOk(blocks, R, most_blocks) or !rowsOk(h_in, R, .bf16)) return error.BadFuseShape;
+    for (xs[0..nq]) |x| if (!rowsOk(x, R, .f32)) return error.BadFuseShape;
+    for (ys) |y| if (!rowsOk(y, R, .bf16)) return error.BadFuseShape;
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(blocks.ptr);
+    a.add(@as(i64, @intCast(blocks.stride / 2)));
+    a.add(@as(i32, @intCast(blocks.count)));
+    a.add(h_in.ptr);
+    a.add(queries);
+    a.add(@as(i32, @intCast(nq)));
+    for (0..most_queries) |j| a.add(if (j < nq) xs[j].ptr else @as(u64, 0));
+    a.add(res.eps);
+    a.add(mixScale());
+    a.add(@as(i32, @intCast(nn)));
+    for (0..most_queries) |j| a.add(if (j < nn) gains[j] else @as(u64, 0));
+    for (0..most_queries) |j| a.add(if (j < nn) ys[j].ptr else @as(u64, 0));
+    a.add(res.eps);
+    if (c.k.fuse.mode.attn) return cuda.launch.launch(c.k.fuse.lat_attn_in, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = lat_threads }, .shared = lat_staged * @as(u32, @intCast(nq)) }, c.stream, &a);
+    try cuda.launch.launch(c.k.fuse.attn_in, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = row_threads } }, c.stream, &a);
+}
+
+/// res.partial, the boundary push, res.mlp_input and res.mlp_norm (cuda_forward.zig mlpStage):
+///   part fp32 = boundary ? f32(ac) : f32(h_in) + f32(ac)
+///   boundary: push (the next block, bf16 [R, H]) = h_in; the mix's sources are then `blocks` and h_in
+///   mx fp32 = Mix(query; sources, part); m bf16 = norm(mx, gain)
+/// `blocks` are the completed blocks before the push; the caller counts the pushed one.
+pub fn mlpIn(c: *const Ctx, h_in: Mat, ac: Mat, boundary: bool, part: Mat, blocks: Blocks, push: u64, query: u64, mx: Mat, gain: u64, m: Mat) !void {
+    const R = h_in.rows;
+    if (!rowsOk(h_in, R, .bf16) or !rowsOk(ac, R, .bf16) or !rowsOk(part, R, .f32) or !rowsOk(mx, R, .f32) or !rowsOk(m, R, .bf16)) return error.BadFuseShape;
+    if (!blocksOk(blocks, R, if (boundary) most_blocks - 1 else most_blocks) or query == 0) return error.BadFuseShape;
+    if (boundary and (push == 0 or push % 16 != 0)) return error.BadFuseShape;
+    if (R == 0) return;
+    var a: cuda.Args = .{};
+    a.add(h_in.ptr);
+    a.add(ac.ptr);
+    a.add(@as(i32, @intFromBool(boundary)));
+    a.add(part.ptr);
+    a.add(blocks.ptr);
+    a.add(@as(i64, @intCast(blocks.stride / 2)));
+    a.add(@as(i32, @intCast(blocks.count)));
+    a.add(if (boundary) push else @as(u64, 0));
+    a.add(query);
+    a.add(mx.ptr);
+    a.add(res.eps);
+    a.add(mixScale());
+    a.add(gain);
+    a.add(m.ptr);
+    a.add(res.eps);
+    if (c.k.fuse.mode.mlp) return cuda.launch.launch(c.k.fuse.lat_mlp_in, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = lat_threads }, .shared = lat_staged }, c.stream, &a);
+    try cuda.launch.launch(c.k.fuse.mlp_in, .{ .grid = .{ .x = @intCast(R) }, .block = .{ .x = row_threads } }, c.stream, &a);
+}
+
+/// moe.route in this file's forms: the same logits launch, then in checkpoint mode select and the slot order as one
+/// launch (the latency form with `route`, else the stage-1 fusion); full mode keeps select's ascending order, so it
+/// runs moe.route itself. The same ids, weights and logits as moe.route.
+pub fn route(c: *const Ctx, l: *const @import("cuda_weights.zig").Layer, m: Mat, ids: Mat, wts: Mat, logits: Mat) !void {
+    if (c.k.moe.mode != .checkpoint) return moe.route(c, l, m, ids, wts, logits);
+    const R = m.rows;
+    if (!m.is(R, H, .bf16) or !ids.is(R, moe.topk, .i32) or !wts.is(R, moe.topk, .f32) or !logits.is(R, moe.experts_total, .f32)) return error.BadMoeShape;
+    if (!m.dense() or !ids.dense() or !wts.dense() or !logits.dense()) return error.BadMoeShape;
+    if (R == 0) return;
+    try moe.routeLogits(c, l, m, logits);
+    try selectSlot(c, logits.ptr, l.router_bias, ids, wts);
+}
+
+/// select + slot order as one launch: ids, wts [R, 8] in slot order from logits fp32 [R, 384] and the selection bias
+/// (tf_ink2_lat_route with `route`, else tf_ink2_fuse_route).
+pub fn selectSlot(c: *const Ctx, logits: u64, bias: u64, ids: Mat, wts: Mat) !void {
+    const R = ids.rows;
+    if (R == 0) return;
+    var b: cuda.launch.Args = .{};
+    b.add(logits);
+    b.add(bias);
+    b.add(ids.ptr);
+    b.add(wts.ptr);
+    b.add(@as(i32, @intCast(R)));
+    const f = if (c.k.fuse.mode.route) c.k.fuse.lat_route else c.k.fuse.route_fn;
+    try cuda.launch.launch(f, .{ .grid = .{ .x = @intCast((R + 7) / 8) }, .block = .{ .x = 256 } }, c.stream, &b);
+}
+
+test "inkling2 cuda fuse: the switch" {
+    try std.testing.expect(H == 4608);
+    try std.testing.expect(H / 8 <= row_threads);
+    try std.testing.expectEqual(Mode.lat, try Mode.parse(""));
+    try std.testing.expectEqual(Mode.lat, try Mode.parse("lat"));
+    try std.testing.expectEqual(Mode.none, try Mode.parse("0"));
+    try std.testing.expectEqual(Mode{ .fused = true }, try Mode.parse("1"));
+    try std.testing.expectEqual(Mode{ .attn = true, .route = true }, try Mode.parse("attn,route"));
+    try std.testing.expectEqual(Mode.lat, try Mode.parse("attn,mlp,route,proj,conv"));
+    try std.testing.expect(!(try Mode.parse("attn,mlp,route")).proj);
+    try std.testing.expect(!Mode.lat.segs and (try Mode.parse("attn,mlp,route,proj,conv,segs")).segs);
+    try std.testing.expect((try Mode.parse("attn,mlp,route,proj,conv,segs")).forRows(lat_rows).segs);
+    try std.testing.expect(!(try Mode.parse("attn,mlp,route,proj")).forRows(lat_rows + 1).proj);
+    try std.testing.expectError(error.BadInk2Fuse, Mode.parse("attn,x"));
+    try std.testing.expectError(error.BadInk2Fuse, Mode.parse("logits"));
+    try std.testing.expect(!(Mode{ .route = true }).mlpIn() and (Mode{ .route = true }).router());
+    try std.testing.expectEqual(Mode.lat, Mode.lat.forRows(lat_rows));
+    try std.testing.expectEqual(Mode.none, Mode.lat.forRows(lat_rows + 1));
+    try std.testing.expectEqual(Mode{ .fused = true }, (Mode{ .fused = true }).forRows(2048));
+}
diff --git a/zig/src/families/inkling2/cuda_fuse_main.zig b/zig/src/families/inkling2/cuda_fuse_main.zig
new file mode 100644
index 0000000000000000000000000000000000000000..2df9fea77d237ffe640c106372aa460f295661e8
--- /dev/null
+++ b/zig/src/families/inkling2/cuda_fuse_main.zig
@@ -0,0 +1,671 @@
+//! tf-inkling2-fuse: the op check of G-fuse (cuda_fuse.zig). Each fused op, in both forms (the stage-1 fusion and the
+//! latency form), against the unfused sequence it replaces, on the same pseudo-random inputs at each row count, every
+//! output compared byte for byte (attnIn: the mix outputs and the normed rows; mlpIn: the partial, the pushed block,
+//! the mix output and the normed rows; route: ids and weights in slot order, with rows of tied scores and NaN
+//! logits). The convolutions' batched form (cuda_conv.zig kvCommitSegs, postCommitSegs: every stream's convolution
+//! and commit in one launch) against kvCommit / postCommit a stream: outputs, states and histories, also with streams
+//! that differ in history ownership and at the capacity (8 streams of 8 rows), then kept states after a partial keep
+//! (state.keepAll, Engine.keep's rollback). Then the timing at one row: for each op, a CUDA graph of 48 layers' worth
+//! of each form (the release's ops, the fusion, the latency form), replayed in rotation, us a layer; then all three
+//! ops a layer, each form.
+//! Exit status: 0 every output equal, 1 otherwise or failed, 2 usage. No weights: one GPU (the first visible).
+const std = @import("std");
+const cuda = @import("cuda");
+const ic = @import("inkling2_cuda");
+
+const ops = ic.ops;
+const res = ic.res;
+const fuse = ic.fuse;
+const Mat = ops.Mat;
+const H = res.width;
+const NE = ic.moe.experts_total;
+const K8 = ic.moe.topk;
+
+const usage =
+    \\usage: tf-inkling2-fuse [--rows N[,N...]] [--reps N] [--layers N]
+    \\  --rows    row counts to check (default 1,2,8,2048)
+    \\  --reps    graph replays a variant for the timing (default 200; 0: no timing)
+    \\  --layers  layers a timed graph holds (default 48; a global layer every 6th)
+    \\  --blocks  the timed attention and MLP inputs' block count (default: the layer's, 0 .. 7 by depth)
+    \\
+;
+
+const Opts = struct {
+    rows: [8]usize = .{ 1, 2, 8, 2048, 0, 0, 0, 0 },
+    nrows: usize = 4,
+    reps: usize = 200,
+    layers: usize = 48,
+    blocks: ?usize = null,
+};
+
+fn parse(args: []const [:0]const u8) !?Opts {
+    var o: Opts = .{};
+    var i: usize = 1;
+    while (i + 1 < args.len) : (i += 2) {
+        const k = args[i];
+        const v = args[i + 1];
+        if (std.mem.eql(u8, k, "--rows")) {
+            o.nrows = 0;
+            var it = std.mem.splitScalar(u8, v, ',');
+            while (it.next()) |x| {
+                if (o.nrows == o.rows.len) return null;
+                o.rows[o.nrows] = try std.fmt.parseInt(usize, x, 10);
+                if (o.rows[o.nrows] == 0 or o.rows[o.nrows] > max_rows) return null;
+                o.nrows += 1;
+            }
+        } else if (std.mem.eql(u8, k, "--reps")) o.reps = try std.fmt.parseInt(usize, v, 10) else if (std.mem.eql(u8, k, "--layers")) o.layers = try std.fmt.parseInt(usize, v, 10) else if (std.mem.eql(u8, k, "--blocks")) {
+            o.blocks = try std.fmt.parseInt(usize, v, 10);
+            if (o.blocks.? > 7) return null;
+        } else return null;
+    }
+    if (i != args.len or o.nrows == 0 or o.layers == 0) return null;
+    return o;
+}
+
+const max_rows = 2048;
+
+pub fn main(init: std.process.Init) !u8 {
+    const a = init.arena.allocator();
+    const args = try init.minimal.args.toSlice(a);
+    const o = (parse(args) catch null) orelse {
+        std.debug.print("{s}", .{usage});
+        return 2;
+    };
+    return run(init.gpa, o) catch |e| {
+        std.debug.print("FAIL tf-inkling2-fuse: {t}\n", .{e});
+        return 1;
+    };
+}
+
+/// bf16 bits of x, rounded to nearest even.
+fn bf16(x: f32) u16 {
+    const u: u32 = @bitCast(x);
+    if (std.math.isNan(x)) return @intCast((u >> 16) | 0x40);
+    return @intCast((u + 0x7FFF + ((u >> 16) & 1)) >> 16);
+}
+
+/// Values like the forward's: per-row scale (so the norms differ by row), mostly normal, a few large.
+fn fillRows(rng: std.Random, out: []f32, cols: usize) void {
+    var r: usize = 0;
+    while (r * cols < out.len) : (r += 1) {
+        const scale = @exp(rng.floatNorm(f32) * 1.5);
+        for (out[r * cols ..][0..cols]) |*v| {
+            v.* = rng.floatNorm(f32) * scale;
+            if (rng.uintLessThan(u32, 512) == 0) v.* *= 40;
+        }
+    }
+}
+
+const Bufs = struct {
+    d: *const cuda.Driver,
+    own: std.ArrayList(cuda.DeviceBuffer) = .empty,
+    gpa: std.mem.Allocator,
+
+    fn alloc(b: *Bufs, n: usize) !u64 {
+        try b.own.append(b.gpa, try cuda.DeviceBuffer.alloc(b.d, n));
+        return b.own.items[b.own.items.len - 1].ptr;
+    }
+
+    fn deinit(b: *Bufs) void {
+        for (b.own.items) |*x| x.free();
+        b.own.deinit(b.gpa);
+    }
+};
+
+fn upload(d: *const cuda.Driver, ptr: u64, bytes: []const u8) !void {
+    const view: cuda.DeviceBuffer = .{ .d = d, .ptr = ptr, .len = bytes.len, .borrowed = true };
+    try view.upload(0, bytes);
+}
+
+fn uploadBf16(gpa: std.mem.Allocator, d: *const cuda.Driver, ptr: u64, xs: []const f32) !void {
+    const h = try gpa.alloc(u16, xs.len);
+    defer gpa.free(h);
+    for (h, xs) |*y, x| y.* = bf16(x);
+    try upload(d, ptr, std.mem.sliceAsBytes(h));
+}
+
+/// Device bytes [ptr, ptr + n) of x and y equal (the stream synchronized first); prints the first difference.
+fn same(gpa: std.mem.Allocator, c: *const ops.Ctx, what: []const u8, x: u64, y: u64, n: usize) !bool {
+    try c.stream.synchronize();
+    const hx = try gpa.alloc(u8, n);
+    defer gpa.free(hx);
+    const hy = try gpa.alloc(u8, n);
+    defer gpa.free(hy);
+    try cuda.memory.download(c.d, x, hx);
+    try cuda.memory.download(c.d, y, hy);
+    if (std.mem.eql(u8, hx, hy)) return true;
+    var at: usize = 0;
+    while (hx[at] == hy[at]) at += 1;
+    var nd: usize = 0;
+    for (hx, hy) |p, q| nd += @intFromBool(p != q);
+    std.debug.print("    {s}: {d} of {d} bytes differ, first at byte {d}\n", .{ what, nd, n, at });
+    return false;
+}
+
+const Inputs = struct {
+    blocks: u64, // bf16 [8][max_rows][H], the reference
+    blocks_u: u64, // the unfused run's copy (pushBlock writes it)
+    blocks_f: u64, // the fused run's copy
+    h_in: u64,
+    ac: u64,
+    queries: u64, // fp32 [3][H]
+    gains: [3]u64,
+    mlp_gain: u64,
+    mlp_query: u64,
+    logits: u64, // fp32 [max_rows][NE]
+    bias: u64,
+    stride: usize, // bytes between blocks
+};
+
+const Outs = struct {
+    x: [3]u64,
+    y: [3]u64,
+    part: u64,
+    mx: u64,
+    m: u64,
+    ids: u64,
+    wts: u64,
+};
+
+fn outsAlloc(b: *Bufs) !Outs {
+    var o: Outs = undefined;
+    for (&o.x) |*p| p.* = try b.alloc(max_rows * H * 4);
+    for (&o.y) |*p| p.* = try b.alloc(max_rows * H * 2);
+    o.part = try b.alloc(max_rows * H * 4);
+    o.mx = try b.alloc(max_rows * H * 4);
+    o.m = try b.alloc(max_rows * H * 2);
+    o.ids = try b.alloc(max_rows * K8 * 4);
+    o.wts = try b.alloc(max_rows * K8 * 4);
+    return o;
+}
+
+fn blocksOf(in: *const Inputs, base: u64, n: usize, R: usize) ops.Blocks {
+    return .{ .ptr = base, .stride = in.stride, .count = n, .rows = R, .hidden = H };
+}
+
+fn f32Rows(p: u64, R: usize) Mat {
+    return Mat.of(p, R, H, .f32);
+}
+
+fn bf16Rows(p: u64, R: usize) Mat {
+    return Mat.of(p, R, H, .bf16);
+}
+
+/// The unfused attention input: res.mix then nn norms (cuda_forward.zig attnStage).
+fn attnUnfused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, nb: usize, nq: usize, nn: usize, R: usize) !void {
+    const xs = [3]Mat{ f32Rows(out.x[0], R), f32Rows(out.x[1], R), f32Rows(out.x[2], R) };
+    try res.mix(c, blocksOf(in, in.blocks, nb, R), bf16Rows(in.h_in, R), in.queries, nq, xs[0..nq]);
+    for (0..nn) |j| try res.norm(c, xs[if (nq == 1) 0 else j], in.gains[j], bf16Rows(out.y[j], R));
+}
+
+fn attnFused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, nb: usize, nq: usize, nn: usize, R: usize) !void {
+    const xs = [3]Mat{ f32Rows(out.x[0], R), f32Rows(out.x[1], R), f32Rows(out.x[2], R) };
+    const ys = [3]Mat{ bf16Rows(out.y[0], R), bf16Rows(out.y[1], R), bf16Rows(out.y[2], R) };
+    try fuse.attnIn(c, blocksOf(in, in.blocks, nb, R), bf16Rows(in.h_in, R), in.queries, nq, xs[0..nq], in.gains[0..nn], ys[0..nn]);
+}
+
+/// The unfused MLP input: res.partial, pushBlock's copy, res.mix, res.norm (cuda_forward.zig mlpInput).
+fn mlpUnfused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, nb: usize, boundary: bool, R: usize) !void {
+    const part = f32Rows(out.part, R);
+    try res.partial(c, bf16Rows(in.h_in, R), bf16Rows(in.ac, R), boundary, part);
+    if (boundary) try c.copyRows(bf16Rows(in.blocks_u + nb * in.stride, R), bf16Rows(in.h_in, R));
+    const n = nb + @intFromBool(boundary);
+    try res.mix(c, blocksOf(in, in.blocks_u, n, R), part, in.mlp_query, 1, &.{f32Rows(out.mx, R)});
+    try res.norm(c, f32Rows(out.mx, R), in.mlp_gain, bf16Rows(out.m, R));
+}
+
+fn mlpFused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, nb: usize, boundary: bool, R: usize) !void {
+    try fuse.mlpIn(c, bf16Rows(in.h_in, R), bf16Rows(in.ac, R), boundary, f32Rows(out.part, R), blocksOf(in, in.blocks_f, nb, R), in.blocks_f + nb * in.stride, in.mlp_query, f32Rows(out.mx, R), in.mlp_gain, bf16Rows(out.m, R));
+}
+
+/// The unfused router tail in checkpoint mode: select, then the slot order (cuda_moe.zig route).
+fn routeUnfused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, R: usize) !void {
+    const k = &c.k.moe;
+    var b: cuda.launch.Args = .{};
+    b.add(in.logits);
+    b.add(in.bias);
+    b.add(out.ids);
+    b.add(out.wts);
+    b.add(@as(i32, @intCast(R)));
+    try cuda.launch.launch(k.select, .{ .grid = .{ .x = @intCast((R + 7) / 8) }, .block = .{ .x = 256 } }, c.stream, &b);
+    var s: cuda.launch.Args = .{};
+    s.add(in.logits);
+    s.add(in.bias);
+    s.add(out.ids);
+    s.add(out.wts);
+    s.add(@as(i32, @intCast(R)));
+    try cuda.launch.launch(k.ck_slot, .{ .grid = .{ .x = @intCast((R + 127) / 128) }, .block = .{ .x = 128 } }, c.stream, &s);
+}
+
+fn routeFused(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, R: usize) !void {
+    try fuse.selectSlot(c, in.logits, in.bias, Mat.of(out.ids, R, K8, .i32), Mat.of(out.wts, R, K8, .f32));
+}
+
+/// The forms an op is checked and timed in: the release's ops, the stage-1 fusion, the latency form.
+const Form = enum { release, fused, lat };
+
+fn modeOf(form: Form) fuse.Mode {
+    return switch (form) {
+        .release => .none,
+        .fused => .{ .fused = true },
+        .lat => .lat,
+    };
+}
+
+fn poison(c: *const ops.Ctx, out: *const Outs) !void {
+    for (out.x) |p| try c.zero(p, max_rows * H * 4);
+    for (out.y) |p| try c.zero(p, max_rows * H * 2);
+    try c.zero(out.part, max_rows * H * 4);
+    try c.zero(out.mx, max_rows * H * 4);
+    try c.zero(out.m, max_rows * H * 2);
+    try c.zero(out.ids, max_rows * K8 * 4);
+    try c.zero(out.wts, max_rows * K8 * 4);
+}
+
+fn run(gpa: std.mem.Allocator, o: Opts) !u8 {
+    var driver = try cuda.Driver.open();
+    defer driver.close();
+    var ctx = try cuda.Context.init(&driver, 0);
+    defer ctx.deinit();
+    var stream = try cuda.Stream.init(&driver, true);
+    defer stream.deinit();
+    var k = try ic.kernels.Kernels.load(&driver);
+    defer k.unload();
+    var gemms: ops.Gemms = .{ .gpa = gpa };
+    defer gemms.deinit();
+    var scratch = try ops.Scratch.init(&driver, 64 << 20);
+    defer scratch.deinit();
+    const c: ops.Ctx = .{ .d = &driver, .stream = stream, .k = &k, .gemms = &gemms, .scratch = &scratch };
+    var bufs: Bufs = .{ .d = &driver, .gpa = gpa };
+    defer bufs.deinit();
+
+    // inputs
+    var prng = std.Random.DefaultPrng.init(0x1f05e5);
+    const rng = prng.random();
+    const stride = max_rows * H * 2;
+    var in: Inputs = undefined;
+    in.stride = stride;
+    in.blocks = try bufs.alloc(8 * stride);
+    in.blocks_u = try bufs.alloc(8 * stride);
+    in.blocks_f = try bufs.alloc(8 * stride);
+    in.h_in = try bufs.alloc(max_rows * H * 2);
+    in.ac = try bufs.alloc(max_rows * H * 2);
+    in.queries = try bufs.alloc(3 * H * 4);
+    for (&in.gains) |*g| g.* = try bufs.alloc(H * 4);
+    in.mlp_gain = try bufs.alloc(H * 4);
+    in.mlp_query = try bufs.alloc(H * 4);
+    in.logits = try bufs.alloc(max_rows * NE * 4);
+    in.bias = try bufs.alloc(NE * 4);
+    {
+        const t = try gpa.alloc(f32, 8 * max_rows * H);
+        defer gpa.free(t);
+        fillRows(rng, t, H);
+        try uploadBf16(gpa, &driver, in.blocks, t);
+        fillRows(rng, t[0 .. max_rows * H], H);
+        try uploadBf16(gpa, &driver, in.h_in, t[0 .. max_rows * H]);
+        fillRows(rng, t[0 .. max_rows * H], H);
+        try uploadBf16(gpa, &driver, in.ac, t[0 .. max_rows * H]);
+        // queries and the MLP query: the checkpoint's scale (|q| about 1 a column), gains about 1
+        for (t[0 .. 3 * H]) |*v| v.* = rng.floatNorm(f32) * 0.5;
+        try upload(&driver, in.queries, std.mem.sliceAsBytes(t[0 .. 3 * H]));
+        for (t[0..H]) |*v| v.* = rng.floatNorm(f32) * 0.5;
+        try upload(&driver, in.mlp_query, std.mem.sliceAsBytes(t[0..H]));
+        for ([4]u64{ in.gains[0], in.gains[1], in.gains[2], in.mlp_gain }) |g| {
+            for (t[0..H]) |*v| v.* = @as(f32, @bitCast(@as(u32, bf16(1 + rng.floatNorm(f32) * 0.3)) << 16));
+            try upload(&driver, g, std.mem.sliceAsBytes(t[0..H]));
+        }
+        // router logits: rows of plain draws, rows with many tied scores, rows with NaN logits
+        const lg = t[0 .. max_rows * NE];
+        for (0..max_rows) |r| {
+            const row = lg[r * NE ..][0..NE];
+            switch (r % 8) {
+                3 => for (row) |*v| {
+                    v.* = @floatFromInt(rng.uintLessThan(u32, 3));
+                },
+                5 => for (row, 0..) |*v, e| {
+                    v.* = if (e % 37 == 0) std.math.nan(f32) else rng.floatNorm(f32) * 3;
+                },
+                6 => @memset(row, 0.25),
+                else => for (row) |*v| {
+                    v.* = rng.floatNorm(f32) * 3;
+                },
+            }
+        }
+        try upload(&driver, in.logits, std.mem.sliceAsBytes(lg));
+        for (t[0..NE], 0..) |*v, e| v.* = if (e % 5 == 0) 0 else rng.floatNorm(f32) * 0.1;
+        try upload(&driver, in.bias, std.mem.sliceAsBytes(t[0..NE]));
+    }
+    const u = try outsAlloc(&bufs);
+    const f = try outsAlloc(&bufs);
+
+    var bad: usize = 0;
+    var checks: usize = 0;
+    for (o.rows[0..o.nrows]) |R| for ([_]Form{ .fused, .lat }) |form| {
+        k.fuse.mode = modeOf(form);
+        defer k.fuse.mode = .none;
+        const fname = @tagName(form);
+        // attnIn: sliding (nq 1, one norm) and global (nq 3, three norms), at several block counts
+        for ([_]usize{ 0, 1, 3, 8 }) |nb| for ([_][2]usize{ .{ 1, 1 }, .{ 3, 3 }, .{ 1, 3 } }) |qn| {
+            try poison(&c, &u);
+            try poison(&c, &f);
+            try attnUnfused(&c, &in, &u, nb, qn[0], qn[1], R);
+            try attnFused(&c, &in, &f, nb, qn[0], qn[1], R);
+            var ok = true;
+            for (0..qn[0]) |j| ok = try same(gpa, &c, "mix out", u.x[j], f.x[j], R * H * 4) and ok;
+            for (0..qn[1]) |j| ok = try same(gpa, &c, "norm out", u.y[j], f.y[j], R * H * 2) and ok;
+            std.debug.print("  {s} {s:<5} attn_in  rows {d}, blocks {d}, queries {d}, norms {d}\n", .{ if (ok) "equal " else "DIFFER", fname, R, nb, qn[0], qn[1] });
+            bad += @intFromBool(!ok);
+            checks += 1;
+        };
+        // mlpIn: with and without the boundary push
+        for ([_]usize{ 0, 2, 7, 8 }) |nb| for ([_]bool{ false, true }) |boundary| {
+            if (boundary and nb == 8) continue;
+            try poison(&c, &u);
+            try poison(&c, &f);
+            for ([_]u64{ in.blocks_u, in.blocks_f }) |dst| try c.copy(dst, in.blocks, 8 * stride);
+            try mlpUnfused(&c, &in, &u, nb, boundary, R);
+            try mlpFused(&c, &in, &f, nb, boundary, R);
+            var ok = try same(gpa, &c, "partial", u.part, f.part, R * H * 4);
+            ok = try same(gpa, &c, "blocks", in.blocks_u, in.blocks_f, 8 * stride) and ok;
+            ok = try same(gpa, &c, "mix out", u.mx, f.mx, R * H * 4) and ok;
+            ok = try same(gpa, &c, "norm out", u.m, f.m, R * H * 2) and ok;
+            std.debug.print("  {s} {s:<5} mlp_in   rows {d}, blocks {d}, boundary {s}\n", .{ if (ok) "equal " else "DIFFER", fname, R, nb, if (boundary) "yes" else "no" });
+            bad += @intFromBool(!ok);
+            checks += 1;
+        };
+        // route: select + slot order
+        {
+            try poison(&c, &u);
+            try poison(&c, &f);
+            try routeUnfused(&c, &in, &u, R);
+            try routeFused(&c, &in, &f, R);
+            var ok = try same(gpa, &c, "ids", u.ids, f.ids, R * K8 * 4);
+            ok = try same(gpa, &c, "wts", u.wts, f.wts, R * K8 * 4) and ok;
+            std.debug.print("  {s} {s:<5} route    rows {d} (ties every 8th row from 3 and 6, NaN logits from 5)\n", .{ if (ok) "equal " else "DIFFER", fname, R });
+            bad += @intFromBool(!ok);
+            checks += 1;
+        }
+    };
+    {
+        const cs = try convSegs(gpa, &c, &bufs, rng);
+        bad += cs[0];
+        checks += cs[1];
+    }
+    std.debug.print("{s} tf-inkling2-fuse: {d}/{d} fused ops bit-equal to the unfused sequence (rows", .{ if (bad == 0) "PASS" else "FAIL", checks - bad, checks });
+    for (o.rows[0..o.nrows]) |R| std.debug.print(" {d}", .{R});
+    std.debug.print(")\n", .{});
+    if (o.reps > 0) {
+        for ([_]Op{ .empty, .attn, .attn_global, .mlp, .route, .layer }) |op| try timing(&c, &k, &in, &u, o, op);
+    }
+    return if (bad == 0) 0 else 1;
+}
+
+/// Rows a stream of convSegs' batches: 2 to 8 streams, every width a stream can have (1 to 16; up to 8 with a history).
+const conv_batches = [_][]const usize{
+    &.{ 1, 1 },
+    &.{ 1, 3, 2, 8 },
+    &.{ 1, 1, 1, 1, 1, 1, 1, 1 },
+    &.{ 1, 2, 3, 4, 5, 6, 7, 8 },
+    &.{ 16, 1, 9 },
+};
+
+/// A convSegs batch where the streams differ: each stream's rows, whether it keeps a history, and the rows of its
+/// window it keeps after (state.keepAll, Engine.keep's rollback; 0 for a stream without a history).
+const SegsCase = struct {
+    rows: []const usize,
+    hist: []const bool,
+    keep: []const usize,
+};
+
+const segs_cases = [_]SegsCase{
+    // mixed history ownership: a 16-row stream without one beside an 8-row stream with one, both orders, then three
+    .{ .rows = &.{ 16, 8 }, .hist = &.{ false, true }, .keep = &.{ 0, 5 } },
+    .{ .rows = &.{ 8, 16 }, .hist = &.{ true, false }, .keep = &.{ 3, 0 } },
+    .{ .rows = &.{ 8, 12, 5 }, .hist = &.{ true, false, true }, .keep = &.{ 6, 0, 2 } },
+    // the capacity: max_segs streams of 8 rows (64 rows), every one with a history, keeping 1 to 8 rows
+    .{ .rows = &.{ 8, 8, 8, 8, 8, 8, 8, 8 }, .hist = &.{ true, true, true, true, true, true, true, true }, .keep = &.{ 1, 2, 3, 4, 5, 6, 7, 8 } },
+};
+
+const Conv = enum { sliding, global, post };
+
+/// convSegs' device buffers: [pass] 0 the launches a stream, 1 the batched launch.
+const SegsBufs = struct {
+    x: [2]u64, // K and V inputs (post: x[0])
+    d: [2]u64, // the global layers' per-token taps
+    w: [2]u64, // K and V static taps (post: w[0])
+    y: [2][2]u64, // [pass][K, V] outputs
+    st0: u64, // the starting states
+    st: [2]u64,
+    hs: [2]u64,
+    table: u64, // keepAll's tables: [pass][stream] the stream's K and V KeepEntry
+
+    const hk = 4;
+    const ck = hk * ic.weights.head_dim;
+    const most = ic.conv.max_segs; // streams
+    const rows = 64; // rows in all
+    const ldx = H + 128; // inputs with a row gap, outputs dense
+    const width = hk * ic.weights.taps;
+    const one_state = 3 * H * 2;
+    const one_hist = (3 + 8) * H * 2;
+};
+
+/// The batched convolutions (cuda_conv.zig kvCommitSegs: sliding and global K and V; postCommitSegs) against
+/// kvCommit / postCommit a stream, with and without histories, on the same inputs and starting states: the
+/// outputs, every state and every history byte for byte. Then batches whose streams differ in history ownership,
+/// and the capacity (8 streams of 8 rows, all with histories), each followed by a partial keep: every stream with a
+/// history rolled back to a prefix of its window (state.keepAll), the kept states byte for byte. Returns the
+/// differing and the checked counts.
+fn convSegs(gpa: std.mem.Allocator, c: *const ops.Ctx, bufs: *Bufs, rng: std.Random) ![2]usize {
+    const S = SegsBufs;
+    var b: SegsBufs = undefined;
+    for (&b.x) |*p| p.* = try bufs.alloc(S.rows * S.ldx * 2);
+    for (&b.d) |*p| p.* = try bufs.alloc(S.rows * S.width * 2);
+    for (&b.w) |*p| p.* = try bufs.alloc(4 * H * 2);
+    for (&b.y) |*r| for (r) |*p| {
+        p.* = try bufs.alloc(S.rows * H * 2);
+    };
+    b.st0 = try bufs.alloc(S.most * 2 * S.one_state);
+    for (&b.st) |*p| p.* = try bufs.alloc(S.most * 2 * S.one_state);
+    for (&b.hs) |*p| p.* = try bufs.alloc(S.most * 2 * S.one_hist);
+    b.table = try bufs.alloc(2 * S.most * 2 * @sizeOf(ic.state.KeepEntry));
+    {
+        const t = try gpa.alloc(f32, S.rows * S.ldx);
+        defer gpa.free(t);
+        for (b.x) |p| {
+            fillRows(rng, t, S.ldx);
+            try uploadBf16(gpa, c.d, p, t);
+        }
+        for (b.d) |p| {
+            for (t[0 .. S.rows * S.width]) |*v| v.* = rng.floatNorm(f32) * 0.3;
+            try uploadBf16(gpa, c.d, p, t[0 .. S.rows * S.width]);
+        }
+        for (b.w) |p| {
+            for (t[0 .. 4 * H]) |*v| v.* = rng.floatNorm(f32) * 0.5;
+            try uploadBf16(gpa, c.d, p, t[0 .. 4 * H]);
+        }
+        fillRows(rng, t[0 .. S.most * 2 * 3 * H], H);
+        try uploadBf16(gpa, c.d, b.st0, t[0 .. S.most * 2 * 3 * H]);
+    }
+    const all: [S.most]bool = @splat(true);
+    const none: [S.most]bool = @splat(false);
+    var bad: usize = 0;
+    var checks: usize = 0;
+    for (conv_batches) |batch| for ([_]Conv{ .sliding, .global, .post }) |form| for ([_]bool{ false, true }) |kept| {
+        if (kept and std.mem.max(usize, batch) > 8) continue;
+        const ok = try segsCase(gpa, c, &b, form, batch, (if (kept) &all else &none)[0..batch.len], null);
+        bad += @intFromBool(!ok);
+        checks += 1;
+    };
+    for (segs_cases) |sc| for ([_]Conv{ .sliding, .global, .post }) |form| {
+        const ok = try segsCase(gpa, c, &b, form, sc.rows, sc.hist, sc.keep);
+        bad += @intFromBool(!ok);
+        checks += 1;
+    };
+    return .{ bad, checks };
+}
+
+/// One convSegs batch in `form`: stream j has rows[j] rows and a history where hist[j]; both passes from the same
+/// starting states, then (with `keep`) each stream with a history kept to keep[j] rows of its window in both.
+/// Prints the case's line; true when every output, state, history (and kept state) is equal.
+fn segsCase(gpa: std.mem.Allocator, c: *const ops.Ctx, b: *const SegsBufs, form: Conv, rows: []const usize, hist: []const bool, keep: ?[]const usize) !bool {
+    const S = SegsBufs;
+    const conv = ic.conv;
+    const C: usize = if (form == .post) H else S.ck;
+    var l: ic.weights.Layer = undefined;
+    l.global = form == .global;
+    l.hk = S.hk;
+    l.k_conv = b.w[0];
+    l.v_conv = b.w[1];
+    var segs: [conv.max_segs]conv.Seg = undefined;
+    var R: usize = 0;
+    for (rows, hist, 0..) |n, kept, j| {
+        const sj = [2]u64{ (2 * j) * S.one_state, (2 * j + 1) * S.one_state };
+        const hj = [2]u64{ (2 * j) * S.one_hist, (2 * j + 1) * S.one_hist };
+        segs[j] = .{ .row0 = R, .rows = n, .state = sj, .hist = if (kept) hj else .{ 0, 0 } };
+        R += n;
+    }
+    for (b.st) |p| try c.copy(p, b.st0, S.most * 2 * S.one_state);
+    for (b.hs) |p| try c.zero(p, S.most * 2 * S.one_hist);
+    for (b.y) |r| for (r) |p| try c.zero(p, S.rows * H * 2);
+    for (0..2) |pass| {
+        const in = [2]Mat{ .{ .ptr = b.x[0], .rows = R, .cols = C, .ld = S.ldx }, .{ .ptr = b.x[1], .rows = R, .cols = C, .ld = S.ldx } };
+        const out = [2]Mat{ Mat.of(b.y[pass][0], R, C, .bf16), Mat.of(b.y[pass][1], R, C, .bf16) };
+        const dk = if (form == .global) Mat.of(b.d[0], R, S.width, .bf16) else Mat{};
+        const dv = if (form == .global) Mat.of(b.d[1], R, S.width, .bf16) else Mat{};
+        var at: [conv.max_segs]conv.Seg = undefined;
+        for (segs[0..rows.len], at[0..rows.len], hist) |g, *a, kept| {
+            a.* = g;
+            a.state = .{ b.st[pass] + g.state[0], b.st[pass] + g.state[1] };
+            if (kept) a.hist = .{ b.hs[pass] + g.hist[0], b.hs[pass] + g.hist[1] };
+        }
+        const sg = at[0..rows.len];
+        if (pass == 0) {
+            for (sg) |g| {
+                const r = g.row0;
+                const n = g.rows;
+                switch (form) {
+                    .post => try conv.postCommit(c, b.w[0], in[0].slice(r, n), g.state[0], g.hist[0], out[0].slice(r, n)),
+                    else => try conv.kvCommit(c, &l, in[0].slice(r, n), in[1].slice(r, n), if (l.global) dk.slice(r, n) else dk, if (l.global) dv.slice(r, n) else dv, g.state[0], g.state[1], g.hist[0], g.hist[1], out[0].slice(r, n), out[1].slice(r, n)),
+                }
+            }
+        } else switch (form) {
+            .post => try conv.postCommitSegs(c, b.w[0], in[0], out[0], sg),
+            else => try conv.kvCommitSegs(c, &l, in[0], in[1], dk, dv, out[0], out[1], sg),
+        }
+    }
+    const zs: usize = if (form == .post) 1 else 2;
+    var ok = true;
+    for (0..zs) |z| ok = try same(gpa, c, "out", b.y[0][z], b.y[1][z], R * C * 2) and ok;
+    ok = try same(gpa, c, "states", b.st[0], b.st[1], S.most * 2 * S.one_state) and ok;
+    ok = try same(gpa, c, "histories", b.hs[0], b.hs[1], S.most * 2 * S.one_hist) and ok;
+    if (keep) |kp| {
+        // The rollback Engine.keep runs (state.keepAll over a slot's keep table), one slot a stream: a table of the
+        // stream's convolutions (K and V; post: one), state = hist[keep .. keep + 3) for each.
+        const KE = ic.state.KeepEntry;
+        var table = std.mem.zeroes([2][S.most][2]KE);
+        for (0..2) |pass| for (0..rows.len) |j| for (0..2) |z| {
+            table[pass][j][z] = .{ .state = b.st[pass] + (2 * j + z) * S.one_state, .hist = b.hs[pass] + (2 * j + z) * S.one_hist, .cols = @intCast(C) };
+        };
+        try c.stream.synchronize();
+        try upload(c.d, b.table, std.mem.asBytes(&table));
+        for (0..2) |pass| for (hist, kp, 0..) |kept, n, j| {
+            if (!kept) continue;
+            var slot: ic.state.State = undefined;
+            slot.keep_table = b.table + (pass * S.most + j) * 2 * @sizeOf(KE);
+            slot.keep_entries = @intCast(zs);
+            try ic.state.keepAll(c, &slot, n);
+        };
+        ok = try same(gpa, c, "kept states", b.st[0], b.st[1], S.most * 2 * S.one_state) and ok;
+    }
+    std.debug.print("  {s} segs  conv_{s:<7} streams {d}, rows {any}", .{ if (ok) "equal " else "DIFFER", @tagName(form), rows.len, rows });
+    if (std.mem.allEqual(bool, hist, true)) {
+        std.debug.print(", histories", .{});
+    } else if (std.mem.indexOfScalar(bool, hist, true) != null) std.debug.print(", histories {any}", .{hist});
+    if (keep) |kp| std.debug.print(", keep {any}", .{kp});
+    std.debug.print("\n", .{});
+    return ok;
+}
+
+/// What a timed graph holds, `layers` times at one row: one op (in each form), or all of a layer's (`layer`), or an
+/// empty kernel (`empty`, the floor a launch costs).
+const Op = enum { empty, attn, attn_global, mlp, route, layer };
+
+/// Layer li's launches of `op` in `form` (k.fuse.mode set by the caller), as the forward runs them at one row: a
+/// global layer every 6th, a boundary every 6th (layer 0 has no attention input).
+fn opLayer(c: *const ops.Ctx, in: *const Inputs, out: *const Outs, op: Op, form: Form, li: usize, blocks: ?usize) !void {
+    const global = li % 6 == 5;
+    const boundary = li % 6 == 0;
+    const nb = blocks orelse @min(li / 6, 7);
+    const unf = form == .release;
+    switch (op) {
+        .empty => {
+            var a: cuda.launch.Args = .{};
+            a.add(@as(u64, 0));
+            try cuda.launch.launch(c.k.fuse.g.probe, .{ .grid = .{ .x = 1 }, .block = .{ .x = 32 } }, c.stream, &a);
+        },
+        .attn => if (unf) try attnUnfused(c, in, out, nb, 1, 1, 1) else try attnFused(c, in, out, nb, 1, 1, 1),
+        .attn_global => if (unf) try attnUnfused(c, in, out, nb, 3, 3, 1) else try attnFused(c, in, out, nb, 3, 3, 1),
+        .mlp => if (unf) try mlpUnfused(c, in, out, nb, boundary, 1) else try mlpFused(c, in, out, nb, boundary, 1),
+        .route => if (unf) try routeUnfused(c, in, out, 1) else try routeFused(c, in, out, 1),
+        .layer => {
+            const nq: usize = if (global) 3 else 1;
+            if (li > 0) try (if (unf) attnUnfused(c, in, out, nb, nq, nq, 1) else attnFused(c, in, out, nb, nq, nq, 1));
+            try (if (unf) mlpUnfused(c, in, out, nb, boundary, 1) else mlpFused(c, in, out, nb, boundary, 1));
+            try (if (unf) routeUnfused(c, in, out, 1) else routeFused(c, in, out, 1));
+        },
+    }
+}
+
+/// One CUDA graph a form of `layers` layers' worth of `op` at one row, replayed in rotation `reps` times: launches
+/// and us a layer each form.
+fn timing(c: *const ops.Ctx, k: *ic.kernels.Kernels, in: *const Inputs, out: *const Outs, o: Opts, op: Op) !void {
+    const forms: []const Form = switch (op) {
+        .empty => &.{.release},
+        else => &.{ .release, .fused, .lat },
+    };
+    var ex: [3]cuda.graph.Exec = undefined;
+    var nodes: [3]usize = undefined;
+    var made: usize = 0;
+    defer for (ex[0..made]) |*x| x.deinit();
+    for (forms, 0..) |form, v| {
+        k.fuse.mode = modeOf(form);
+        defer k.fuse.mode = .none;
+        try cuda.graph.beginCapture(c.stream, .relaxed);
+        const captured: anyerror!void = blk: {
+            for (0..o.layers) |li| opLayer(c, in, out, op, form, li, if (op == .layer) null else o.blocks) catch |e| break :blk e;
+        };
+        var g = cuda.graph.endCapture(c.stream) catch |e| {
+            captured catch |first| return first;
+            return e;
+        };
+        defer g.deinit();
+        try captured;
+        nodes[v] = try g.nodeCount();
+        ex[v] = try g.instantiate();
+        made += 1;
+        try ex[v].upload(c.stream);
+    }
+    var e0 = try cuda.Event.init(c.d, true);
+    defer e0.deinit();
+    var e1 = try cuda.Event.init(c.d, true);
+    defer e1.deinit();
+    var ms: [3]f64 = .{ 0, 0, 0 };
+    const n = forms.len;
+    for (0..o.reps + 10) |i| {
+        for (0..n) |j| {
+            const v = (i + j) % n;
+            try e0.record(c.stream);
+            try ex[v].launchOn(c.stream);
+            try e1.record(c.stream);
+            try e1.synchronize();
+            if (i >= 10) ms[v] += try cuda.Event.elapsedMs(e0, e1);
+        }
+    }
+    const reps: f64 = @floatFromInt(o.reps);
+    const L: f64 = @floatFromInt(o.layers);
+    std.debug.print("timing {s:<11} {d} layers at one row, {d} replays:", .{ @tagName(op), o.layers, o.reps });
+    for (forms, 0..) |form, v| std.debug.print(" {s} {d} nodes {d:.2} us a layer;", .{ @tagName(form), nodes[v], ms[v] / reps / L * 1e3 });
+    if (n == 3) std.debug.print(" lat saves {d:.2} us a layer ({d:.3} ms over the graph)", .{ (ms[0] - ms[2]) / reps / L * 1e3, (ms[0] - ms[2]) / reps });
+    std.debug.print("\n", .{});
+}
+
