+extern "C" __global__ void __launch_bounds__(1024)
+    tf_ink2_ck_plan(const int* __restrict__ ids, int routes, int lo, int E, int tile, int* __restrict__ members,
+                    int* __restrict__ items, int* __restrict__ nitems, uint32_t* __restrict__ bm) {
+  __shared__ int cnt[1024];
+  __shared__ int off[1024];
+  __shared__ int wsum[2][32];
+  plan_body(ids, routes, lo, E, tile, members, items, nitems, bm, cnt, off, wsum);
+}
+
+// K1 (cuda_moe.zig Form.k1, calls of up to 8 rows): the plan and the tokens' rows quantized in one launch of 1024-thread
+// blocks: block 0 zeroes the fold counters (ncntr ints, read by the down GEMM's folding form) and runs the plan; block
+// 1 + i quantizes row i (dense x [R, K]). A quantizer's threads past its row's scale blocks take no block and add 0 to
+// the amax (a max: the same value), so every output equals tf_ink2_ck_plan's and tf_ink2_ck_quant_*'s.
+template <bool NV>
+__device__ __forceinline__ void plan_quant(const int* __restrict__ ids, int routes, int lo, int E, int tile,
+                                           int* __restrict__ members, int* __restrict__ items,
+                                           int* __restrict__ nitems, uint32_t* __restrict__ bm,
+                                           int* __restrict__ cntr, int ncntr, const __nv_bfloat16* __restrict__ x,
+                                           int K, uint8_t* __restrict__ q, uint8_t* __restrict__ sc,
+                                           float* __restrict__ amax) {
+  __shared__ int cnt[1024];
+  __shared__ int off[1024];
+  __shared__ int wsum[2][32];
+  __shared__ float red[32];
+  if (blockIdx.x == 0) {
+    for (int i = threadIdx.x; i < ncntr; i += blockDim.x) cntr[i] = 0;
+    plan_body(ids, routes, lo, E, tile, members, items, nitems, bm, cnt, off, wsum);
+    return;
+  }
+  if constexpr (NV)
+    quant_nvfp4_row(x, K, K, 0, blockIdx.x - 1, q, sc, amax, red);
+  else
+    quant_mxfp8_row(x, K, K, 0, blockIdx.x - 1, q, sc);
+}
+
+extern "C" __global__ void __launch_bounds__(1024)
+    tf_ink2_ck_planq_nvfp4(const int* __restrict__ ids, int routes, int lo, int E, int tile,
+                           int* __restrict__ members, int* __restrict__ items, int* __restrict__ nitems,
+                           uint32_t* __restrict__ bm, int* __restrict__ cntr, int ncntr,
+                           const __nv_bfloat16* __restrict__ x, int K, uint8_t* __restrict__ q,
+                           uint8_t* __restrict__ sc, float* __restrict__ amax) {
+  plan_quant<true>(ids, routes, lo, E, tile, members, items, nitems, bm, cntr, ncntr, x, K, q, sc, amax);
+}
+
+extern "C" __global__ void __launch_bounds__(1024)
+    tf_ink2_ck_planq_mxfp8(const int* __restrict__ ids, int routes, int lo, int E, int tile,
+                           int* __restrict__ members, int* __restrict__ items, int* __restrict__ nitems,
+                           uint32_t* __restrict__ bm, int* __restrict__ cntr, int ncntr,
+                           const __nv_bfloat16* __restrict__ x, int K, uint8_t* __restrict__ q,
+                           uint8_t* __restrict__ sc, float* __restrict__ amax) {
+  plan_quant<false>(ids, routes, lo, E, tile, members, items, nitems, bm, cntr, ncntr, x, K, q, sc, amax);
+}
+
+// The router's picks (ascending id, from inkling2_moe.cu tf_ink2_moe_select) put in TokenSpeed's slot order:
+// descending sigmoid(logit) + bias, ties to the lower id (a stable sort of the ascending input). The weights move with
+// their ids (the same values: Transformers' router in both modes). A thread a row.
+extern "C" __global__ void __launch_bounds__(128)
+    tf_ink2_ck_slot_order(const float* __restrict__ logits, const float* __restrict__ bias, int* __restrict__ ids,
+                          float* __restrict__ wts, int R) {
+  const int row = blockIdx.x * blockDim.x + threadIdx.x;
+  if (row >= R) return;
+  int id[TOPK];
+  float w[TOPK], sc[TOPK];
+#pragma unroll
+  for (int k = 0; k < TOPK; ++k) {
+    id[k] = ids[(size_t)row * TOPK + k];
+    w[k] = wts[(size_t)row * TOPK + k];
+    if (id[k] < 0) {
+      sc[k] = -INFINITY;
+      continue;
+    }
+    const float l = __ldg(logits + (size_t)row * 384 + id[k]);
+    sc[k] = __fadd_rn(__fdiv_rn(1.0f, __fadd_rn(1.0f, expf(-l))), __ldg(bias + id[k]));
+  }
+#pragma unroll
+  for (int i = 1; i < TOPK; ++i)
+#pragma unroll
+    for (int j = i; j > 0; --j)
+      if (sc[j] > sc[j - 1]) {
+        const float ts = sc[j], tw = w[j];
+        const int ti = id[j];
+        sc[j] = sc[j - 1], w[j] = w[j - 1], id[j] = id[j - 1];
+        sc[j - 1] = ts, w[j - 1] = tw, id[j - 1] = ti;
+      }
+#pragma unroll
+  for (int k = 0; k < TOPK; ++k) ids[(size_t)row * TOPK + k] = id[k], wts[(size_t)row * TOPK + k] = w[k];
+}
+
+// out [R, N] = the fp32 sum from 0 of the row's route rows d[row * 8 + slot] (bf16 [R * 8, N], the routing weight
+// already inside) in slot order, routes of experts outside [lo, hi) skipped (ids null: none skipped); bf16 once (W = 1, or a split rank's
+// columns), or the fp32 rank partial (whole experts at W > 1). N = 4608, or a split rank's 4608 / W.
+namespace {
+template <bool F32>
+__device__ __forceinline__ void fold_body(const __nv_bfloat16* __restrict__ d, const int* __restrict__ ids, int lo,
+                                          int hi, int N, void* __restrict__ out) {
+  const int row = blockIdx.x;
+  bool here[TOPK];
+#pragma unroll
+  for (int k = 0; k < TOPK; ++k) {
+    if (ids == nullptr) {  // split experts: every route is this rank's
+      here[k] = true;
+      continue;
+    }
+    const int e = __ldg(ids + (size_t)row * TOPK + k);
+    here[k] = e >= lo && e < hi;
+  }
+  for (int c = threadIdx.x; c < N / 2; c += blockDim.x) {
+    float a0 = 0.f, a1 = 0.f;
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+      if (!here[k]) continue;
+      const uint32_t v = __ldg(reinterpret_cast<const unsigned int*>(d + ((size_t)row * TOPK + k) * N) + c);
+      a0 = __fadd_rn(a0, lo_f(v));
+      a1 = __fadd_rn(a1, hi_f(v));
+    }
+    if constexpr (F32) {
+      reinterpret_cast<float2*>(static_cast<float*>(out) + (size_t)row * N)[c] = make_float2(a0, a1);
+    } else {
+      reinterpret_cast<uint32_t*>(static_cast<__nv_bfloat16*>(out) + (size_t)row * N)[c] = pack_bf16(a0, a1);
+    }
+  }
+}
+}  // namespace
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_ck_fold(const __nv_bfloat16* __restrict__ d, const int* __restrict__ ids, int lo, int hi, int N,
+                    __nv_bfloat16* __restrict__ out) {
+  fold_body<false>(d, ids, lo, hi, N, out);
+}
+
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_ck_fold_f32(const __nv_bfloat16* __restrict__ d, const int* __restrict__ ids, int lo, int hi, int N,
+                        float* __restrict__ out) {
+  fold_body<true>(d, ids, lo, hi, N, out);
+}
+
+// Split experts, after the column all-gather: out bf16 [R, W * n] from parts bf16 [W][R][n] (rank w's columns
+// w * n ..). A block a row, 4 bytes a thread a step (a plain copy: no arithmetic).
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_ck_columns(const __nv_bfloat16* __restrict__ parts, int W, int R, int n, __nv_bfloat16* __restrict__ out) {
+  const int row = blockIdx.x;
+  const int half = n / 2;
+  const uint32_t* src = reinterpret_cast<const uint32_t*>(parts);
+  uint32_t* dst = reinterpret_cast<uint32_t*>(out + (size_t)row * W * n);
+  for (int c = threadIdx.x; c < W * half; c += blockDim.x) {
+    const int w = c / half, j = c - w * half;
+    dst[c] = __ldg(src + ((size_t)w * R + row) * half + j);
+  }
+}
+
+// ------------------------------------------------------------------------------------------------- MoE-A as codes
+// Split experts, prompt chunks (cuda_moe.zig splitAmax / splitQuant / splitDownCodes; TF_INK2_XCODES): each rank
+// quantizes its own I/W columns of every route's act row before MoE-A and the ranks gather the codes and scales in
+// place of the bf16 columns. The down pass then reads the same codes, scales and amax the whole-row quantizer above
+// leaves. MXFP8 is block-local (32 values, none straddles ranks: I/W = 576). NVFP4's only cross-block input is the
+// row's amax, a max (exact in any order): each rank gathers every rank's segment amax first, and each 16-value block
+// then takes the same steps as tf_ink2_ck_quant_nvfp4's second loop with that amax.
+
+namespace {
+// tf_ink2_ck_quant_nvfp4's second loop for one row: x the row's K values (dense), the row's amax.
+__device__ __forceinline__ void quant_nvfp4_row(const __nv_bfloat16* x, int K, float amax, uint8_t* codes,
+                                                uint8_t* scales) {
+  const int nb = K / 16;
+  const float encoder = clamp_max(__fdiv_rn(1536.0f, amax), FMAX);
+  const float decoder = __fdiv_rn(1.0f, encoder);
+  const float outer = __fmul_rn(amax, INV_1536);
+  const float enc6 = __fmul_rn(encoder, INV_6), enc4 = __fmul_rn(encoder, 0.25f);
+  for (int b = threadIdx.x; b < nb; b += blockDim.x) {
+    float f[16];
+    unpack16(x + 16 * b, f);
+    float maxima = 0.0f;
+#pragma unroll
+    for (int i = 0; i < 16; ++i) maxima = max_nan(maxima, fabsf(f[i]));
+    uint32_t code[2][16];
+    uint32_t s8[2];
+    float err[2];
+#pragma unroll
+    for (int c = 0; c < 2; ++c) {
+      const float sv = clamp_max(__fmul_rn(maxima, c == 0 ? enc6 : enc4), 448.0f);
+      s8[c] = f2e4m3(sv);
+      const float sf = e4m3f(s8[c]);
+      const float inv = clamp_max(__fdiv_rn(1.0f, __fmul_rn(sf, decoder)), FMAX);
+      float e[16];
+#pragma unroll
+      for (int i = 0; i < 16; ++i) {
+        float r;
+        code[c][i] = fp4_round(__fmul_rn(f[i], inv), r);
+        e[i] = fabsf(__fsub_rn(f[i], __fmul_rn(__fmul_rn(r, sf), outer)));
+      }
+#pragma unroll
+      for (int w = 8; w >= 1; w >>= 1)
+#pragma unroll
+        for (int i = 0; i < w; ++i) e[i] = __fadd_rn(e[2 * i], e[2 * i + 1]);
+      err[c] = e[0];
+    }
+    const int pick = err[1] < err[0] ? 1 : 0;
+    uint32_t w0 = 0u, w1 = 0u;
+#pragma unroll
+    for (int i = 0; i < 8; ++i) w0 |= code[pick][i] << (4 * i), w1 |= code[pick][8 + i] << (4 * i);
+    *reinterpret_cast<uint2*>(codes + 8 * b) = make_uint2(w0, w1);
+    scales[b] = static_cast<uint8_t>(s8[pick]);
+  }
+}
+
+// The row amax over the ranks' segment amaxes [W][rows] (as block_max's: max_nan from 0, any order).
+__device__ __forceinline__ float parts_amax(const float* amaxes, int W, int rows, int row) {
+  float m = 0.0f;
+  for (int w = 0; w < W; ++w) m = max_nan(m, __ldg(amaxes + (size_t)w * rows + row));
+  return m;
+}
+}  // namespace
+
+// A block a row: max_nan(0, |x|) over the row's K values (x dense [rows, K]) into amax[row].
+extern "C" __global__ void __launch_bounds__(512)
+    tf_ink2_ck_seg_amax(const __nv_bfloat16* __restrict__ x, int K, float* __restrict__ amax) {
+  __shared__ float red[16];
+  const int row = blockIdx.x;
+  float m = 0.0f;
+  for (int b = threadIdx.x; b < K / 16; b += blockDim.x) {
+    float f[16];
+    unpack16(x + (size_t)row * K + 16 * b, f);
+#pragma unroll
+    for (int i = 0; i < 16; ++i) m = max_nan(m, fabsf(f[i]));
+  }
+  const float a = block_max(m, red);
+  if (threadIdx.x == 0) amax[row] = a;
+}
+
+// A block a row: the rank's K values of the row (x dense [rows, K]) as NVFP4 with the row's amax over every rank's
+// segment amax (amaxes [W][rows]): codes u8 [rows, K/2], scales e4m3 [rows, K/16].
+extern "C" __global__ void __launch_bounds__(512)
+    tf_ink2_ck_quant_nvfp4_parts(const __nv_bfloat16* __restrict__ x, int K, const float* __restrict__ amaxes, int W,
+                                 int rows, uint8_t* __restrict__ codes, uint8_t* __restrict__ scales) {
+  const int row = blockIdx.x;
+  quant_nvfp4_row(x + (size_t)row * K, K, parts_amax(amaxes, W, rows, row), codes + (size_t)row * (K / 2),
+                  scales + (size_t)row * (K / 16));
+}
+
+// A block a row: every rank's gathered slot (slot w at parts + w * slot bytes: codes [rows][cb] then scales
+// [rows][sb]) laid out as the whole row's codes aq [rows][W * cb] and scales asc [rows][W * sb], rank order; with
+// amaxes (NVFP4), the row's amax into aa[row]. A plain copy (and a max).
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_ck_codes_rows(const uint8_t* __restrict__ parts, long long slot, int W, int rows, int cb, int sb,
+                          const float* __restrict__ amaxes, uint8_t* __restrict__ aq, uint8_t* __restrict__ asc,
+                          float* __restrict__ aa) {
+  const int row = blockIdx.x;
+  const int cw = cb / 4;
+  uint32_t* dq = reinterpret_cast<uint32_t*>(aq + (size_t)row * W * cb);
+  for (int c = threadIdx.x; c < W * cw; c += blockDim.x) {
+    const int w = c / cw, j = c - w * cw;
+    dq[c] = __ldg(reinterpret_cast<const uint32_t*>(parts + (size_t)w * slot + (size_t)row * cb) + j);
+  }
+  uint8_t* ds = asc + (size_t)row * W * sb;
+  for (int c = threadIdx.x; c < W * sb; c += blockDim.x) {
+    const int w = c / sb, j = c - w * sb;
+    ds[c] = __ldg(parts + (size_t)w * slot + (size_t)rows * cb + (size_t)row * sb + j);
+  }
+  if (amaxes != nullptr && threadIdx.x == 0) aa[row] = parts_amax(amaxes, W, rows, row);
+}
+
+// The module's presence check.
+extern "C" __global__ void tf_ink2_ck_probe(int* out) {
+  if (out != nullptr && threadIdx.x == 0 && blockIdx.x == 0) *out = 6;
+}
diff --git a/zig/kernels/cuda/inkling2_conv.cu b/zig/kernels/cuda/inkling2_conv.cu
new file mode 100644
index 0000000000000000000000000000000000000000..5f7ea5f67df7a33ad133f01178f9e9b811a140af
--- /dev/null
+++ b/zig/kernels/cuda/inkling2_conv.cu
@@ -0,0 +1,342 @@
+// Inkling-2's convolution group (G-conv): the four short depthwise 4-tap causal convolutions of a layer (static,
+// and static plus per-token taps in global layers' K and V) over a stream's 3 rows of state. The entry points,
+// shapes and math are in zig/src/families/inkling2/cuda_conv.zig; their kernels go here.
+//
+// Math: Transformers modeling_inkling2.py (Apache-2.0), Inkling2ShortConvolution and
+// Inkling2DynamicShortConvolution, in the fp32 steps torch runs them on CUDA (checked bit for bit against
+// the op captures): the static taps as one fused multiply-add chain, oldest row first (cuDNN's depthwise conv1d
+// with TF32 off; every order tried rounds to the same bf16 on the captures); the dynamic taps as fp32(static) +
+// fp32(dynamic), each product rounded, summed as torch's sum(-1) over the 4 lags sums them, (p0 + p2) + (p1 + p3)
+// with lag 0 the current row (fp32-equal to torch's sum on every global layer's K and V checked, 5, 11, 41 and 47,
+// where the 26 other orders are not); then (sum + x_t) * inv, where inv = fp32(1) / fp32(sqrt(5 or 9)) (torch's CUDA division
+// by a Python scalar multiplies by its fp32 reciprocal); one bf16 rounding.
+//
+// A thread owns two adjacent channels and walks RT rows of the forward, carrying the three rows before each one in
+// registers: a row's bits depend only on its own four input rows and taps, never on the row count or the tiling.
+// Rows before the forward's first come from the stream's state S [3, C] (row 2 = the input one position back).
+
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace {
+
+constexpr int NT = 128;  // threads a block
+constexpr int RT = 16;   // rows a thread walks
+
+__device__ __forceinline__ float2 pair(const __nv_bfloat16* p) {
+    return __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(p));
+}
+
+// Input row r of the forward (r >= 0) or, before it, state row 3 + r; channels c, c + 1.
+__device__ __forceinline__ float2 input(const __nv_bfloat16* __restrict__ X, long long ldx,
+                                        const __nv_bfloat16* __restrict__ S, int C, int r, int c) {
+    return r >= 0 ? pair(X + static_cast<int64_t>(r) * ldx + c) : pair(S + static_cast<int64_t>(3 + r) * C + c);
+}
+
+__device__ __forceinline__ void store(__nv_bfloat16* p, float a, float b) {
+    *reinterpret_cast<__nv_bfloat162*>(p) = __floats2bfloat162_rn(a, b);
+}
+
+}  // namespace
+
+// The module's presence check (cuda_kernels.zig Group): writes the group's number.
+extern "C" __global__ void tf_ink2_conv_probe(int* out) {
+    if (out != nullptr && threadIdx.x == 0 && blockIdx.x == 0) *out = 2;
+}
+
+// Static form: Y[t, c] = bf16(((((W[c,0] x_{t-3} + W[c,1] x_{t-2}) + W[c,2] x_{t-1}) + W[c,3] x_t) + x_t) * inv),
+// W bf16 [C, 4] (conv1d weight, tap 3 = the current row). X [R, C] ld ldx, Y [R, C] ld ldy, S [3, C].
+// Grid (ceil(C / 2NT), ceil(R / RT)), NT threads.
+extern "C" __global__ void __launch_bounds__(NT) tf_ink2_conv_static(
+    const __nv_bfloat16* __restrict__ X, long long ldx, const __nv_bfloat16* __restrict__ S,
+    const __nv_bfloat16* __restrict__ W, __nv_bfloat16* __restrict__ Y, long long ldy, int R, int C, float inv) {
+    const int c = 2 * (blockIdx.x * NT + threadIdx.x);
+    const int r0 = blockIdx.y * RT;
+    if (c >= C || r0 >= R) return;
+    const int r1 = min(R, r0 + RT);
+    float wa[4], wb[4];
+#pragma unroll
+    for (int j = 0; j < 4; ++j) {
+        wa[j] = __bfloat162float(W[static_cast<int64_t>(c) * 4 + j]);
+        wb[j] = __bfloat162float(W[static_cast<int64_t>(c + 1) * 4 + j]);
+    }
+    float2 h0 = input(X, ldx, S, C, r0 - 3, c), h1 = input(X, ldx, S, C, r0 - 2, c), h2 = input(X, ldx, S, C, r0 - 1, c);
+    for (int t = r0; t < r1; ++t) {
+        const float2 x = input(X, ldx, S, C, t, c);
+        float a = __fmul_rn(wa[0], h0.x), b = __fmul_rn(wb[0], h0.y);
+        a = __fmaf_rn(wa[1], h1.x, a);
+        b = __fmaf_rn(wb[1], h1.y, b);
+        a = __fmaf_rn(wa[2], h2.x, a);
+        b = __fmaf_rn(wb[2], h2.y, b);
+        a = __fmaf_rn(wa[3], x.x, a);
+        b = __fmaf_rn(wb[3], x.y, b);
+        store(Y + static_cast<int64_t>(t) * ldy + c, __fmul_rn(__fadd_rn(a, x.x), inv), __fmul_rn(__fadd_rn(b, x.y), inv));
+        h0 = h1;
+        h1 = h2;
+        h2 = x;
+    }
+}
+
+// Dynamic form (global layers' K and V): per lag w = fp32(SW[lag, c]) + fp32(D[t, (c / 128) * 4 + lag]);
+// p_lag = x_{t-lag} w_lag; Y[t, c] = bf16((((p0 + p2) + (p1 + p3)) + x_t) * inv), every product and sum rounded.
+// SW bf16 [4, C] (lag 0 = the current row), D bf16 [R, (C / 128) * 4] ld ldd (weight_proj's output). Grid as above.
+extern "C" __global__ void __launch_bounds__(NT) tf_ink2_conv_dynamic(
+    const __nv_bfloat16* __restrict__ X, long long ldx, const __nv_bfloat16* __restrict__ S,
+    const __nv_bfloat16* __restrict__ SW, const __nv_bfloat16* __restrict__ D, long long ldd,
+    __nv_bfloat16* __restrict__ Y, long long ldy, int R, int C, float inv) {
+    const int c = 2 * (blockIdx.x * NT + threadIdx.x);
+    const int r0 = blockIdx.y * RT;
+    if (c >= C || r0 >= R) return;
+    const int r1 = min(R, r0 + RT);
+    const int head = c >> 7;  // 128 channels a head; c and c + 1 share it
+    float sa[4], sb[4];
+#pragma unroll
+    for (int lag = 0; lag < 4; ++lag) {
+        const float2 s = pair(SW + static_cast<int64_t>(lag) * C + c);
+        sa[lag] = s.x;
+        sb[lag] = s.y;
+    }
+    float2 h0 = input(X, ldx, S, C, r0 - 3, c), h1 = input(X, ldx, S, C, r0 - 2, c), h2 = input(X, ldx, S, C, r0 - 1, c);
+    for (int t = r0; t < r1; ++t) {
+        const float2 x = input(X, ldx, S, C, t, c);
+        const __nv_bfloat16* d = D + static_cast<int64_t>(t) * ldd + head * 4;
+        float dl[4];
+#pragma unroll
+        for (int lag = 0; lag < 4; ++lag) dl[lag] = __bfloat162float(d[lag]);
+        float pa[4], pb[4];  // the lag products, lag 0 = the current row
+        pa[0] = __fmul_rn(x.x, __fadd_rn(sa[0], dl[0]));
+        pb[0] = __fmul_rn(x.y, __fadd_rn(sb[0], dl[0]));
+        pa[1] = __fmul_rn(h2.x, __fadd_rn(sa[1], dl[1]));
+        pb[1] = __fmul_rn(h2.y, __fadd_rn(sb[1], dl[1]));
+        pa[2] = __fmul_rn(h1.x, __fadd_rn(sa[2], dl[2]));
+        pb[2] = __fmul_rn(h1.y, __fadd_rn(sb[2], dl[2]));
+        pa[3] = __fmul_rn(h0.x, __fadd_rn(sa[3], dl[3]));
+        pb[3] = __fmul_rn(h0.y, __fadd_rn(sb[3], dl[3]));
+        const float a = __fadd_rn(__fadd_rn(pa[0], pa[2]), __fadd_rn(pa[1], pa[3]));
+        const float b = __fadd_rn(__fadd_rn(pb[0], pb[2]), __fadd_rn(pb[1], pb[3]));
+        store(Y + static_cast<int64_t>(t) * ldy + c, __fmul_rn(__fadd_rn(a, x.x), inv), __fmul_rn(__fadd_rn(b, x.y), inv));
+        h0 = h1;
+        h1 = h2;
+        h2 = x;
+    }
+}
+
+// The state commit after a forward (cuda_state.zig convCommit): state bf16 [3, C] (dense) becomes the last 3 rows of
+// (state rows, then x rows 0 .. R - 1), x bf16 [R, C] with row stride ldx elements. A thread a column, so the shift is
+// in place. One launch instead of a copy a row.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_conv_commit(
+    unsigned short* __restrict__ state, const unsigned short* __restrict__ x, long long ldx, int R, int C) {
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= C) return;
+    const unsigned short s[3] = {state[c], state[C + c], state[2 * C + c]};
+    unsigned short o[3];
+#pragma unroll
+    for (int i = 0; i < 3; ++i) {
+        const int j = R + i;  // index in (state, x)
+        o[i] = j < 3 ? s[j] : x[(size_t)(j - 3) * ldx + c];
+    }
+#pragma unroll
+    for (int i = 0; i < 3; ++i) state[(size_t)i * C + c] = o[i];
+}
+
+// A verify window's commit on a slot with drafts (cuda_state.zig convCommitSpec): hist bf16 [3 + R, C] (dense)
+// becomes (state rows, then x rows 0 .. R - 1) and state bf16 [3, C] the last 3 rows of it; x bf16 [R, C] (R <= 8)
+// with row stride ldx elements. A thread a column reads all it needs before it writes, so the bytes are those of the
+// three copies this replaces (state to hist, x after it, hist's last 3 rows back to state), in one launch.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_conv_commit_spec(
+    unsigned short* __restrict__ state, unsigned short* __restrict__ hist, const unsigned short* __restrict__ x,
+    long long ldx, int R, int C) {
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= C || R < 1 || R > 8) return;
+    unsigned short h[11];
+#pragma unroll
+    for (int i = 0; i < 3; ++i) h[i] = state[(size_t)i * C + c];
+#pragma unroll
+    for (int i = 0; i < 8; ++i)
+        if (i < R) h[3 + i] = x[(size_t)i * ldx + c];
+#pragma unroll
+    for (int i = 0; i < 11; ++i)
+        if (i < 3 + R) hist[(size_t)i * C + c] = h[i];
+#pragma unroll
+    for (int i = 1; i <= 8; ++i)
+        if (i == R) {
+#pragma unroll
+            for (int j = 0; j < 3; ++j) state[(size_t)j * C + c] = h[i + j];
+        }
+}
+
+// A convolution and its state commit as one launch, for conv.kv's K and V (cuda_conv.zig kvCommit: blockIdx.z 0 is
+// K, 1 is V) or conv.attn / conv.mlp (postCommit: one, static); a forward of R <= RT rows, so one thread walks every
+// row of its two channels. Each thread runs tf_ink2_conv_static's or
+// tf_ink2_conv_dynamic's expressions for its channels (the same bits), having read the state rows it needs, then
+// writes the commit's bytes for its channels: the state becomes the last 3 rows of (state, x rows 0 .. R - 1)
+// (tf_ink2_conv_commit), or, with a history (H not null, R <= 8), the history becomes (state, x) and the state its
+// rows R .. R + 2 (tf_ink2_conv_commit_spec). A thread reads all it needs before it writes; no other thread reads
+// its channels.
+struct KvCommit {
+    const __nv_bfloat16* X[2];
+    long long ldx[2];
+    __nv_bfloat16* S[2];
+    const __nv_bfloat16* W[2];
+    const __nv_bfloat16* D[2];  // the dynamic form's per-token taps (global layers), else null
+    long long ldd[2];
+    __nv_bfloat16* Y[2];
+    long long ldy[2];
+    __nv_bfloat16* H[2];  // the history of a slot with drafts, else null
+};
+
+// One convolution and its commit for channels c, c + 1 (tf_ink2_conv_kv_commit's body): X [R, C] ld ldx, the state
+// S [3, C], taps W (static [C, 4], or with D not null the dynamic form's SW [4, C] and D [R, C / 128 * 4] ld ldd),
+// Y [R, C] ld ldy, the history Hs or null. Both kernels below run it, so their arithmetic is the same code.
+__device__ __forceinline__ void conv_commit(const __nv_bfloat16* __restrict__ X, long long ldx, __nv_bfloat16* __restrict__ S,
+                                            const __nv_bfloat16* __restrict__ W, const __nv_bfloat16* __restrict__ D,
+                                            long long ldd, __nv_bfloat16* __restrict__ Y, long long ldy,
+                                            __nv_bfloat16* Hs, int R, int C, float inv, int c) {
+    float2 h0 = input(X, ldx, S, C, -3, c), h1 = input(X, ldx, S, C, -2, c), h2 = input(X, ldx, S, C, -1, c);
+    if (D == nullptr) {
+        float wa[4], wb[4];
+#pragma unroll
+        for (int j = 0; j < 4; ++j) {
+            wa[j] = __bfloat162float(W[static_cast<int64_t>(c) * 4 + j]);
+            wb[j] = __bfloat162float(W[static_cast<int64_t>(c + 1) * 4 + j]);
+        }
+        for (int t = 0; t < R; ++t) {
+            const float2 x = input(X, ldx, S, C, t, c);
+            float a = __fmul_rn(wa[0], h0.x), b = __fmul_rn(wb[0], h0.y);
+            a = __fmaf_rn(wa[1], h1.x, a);
+            b = __fmaf_rn(wb[1], h1.y, b);
+            a = __fmaf_rn(wa[2], h2.x, a);
+            b = __fmaf_rn(wb[2], h2.y, b);
+            a = __fmaf_rn(wa[3], x.x, a);
+            b = __fmaf_rn(wb[3], x.y, b);
+            store(Y + static_cast<int64_t>(t) * ldy + c, __fmul_rn(__fadd_rn(a, x.x), inv), __fmul_rn(__fadd_rn(b, x.y), inv));
+            h0 = h1;
+            h1 = h2;
+            h2 = x;
+        }
+    } else {
+        const __nv_bfloat16* __restrict__ SW = W;
+        const int head = c >> 7;
+        float sa[4], sb[4];
+#pragma unroll
+        for (int lag = 0; lag < 4; ++lag) {
+            const float2 sw = pair(SW + static_cast<int64_t>(lag) * C + c);
+            sa[lag] = sw.x;
+            sb[lag] = sw.y;
+        }
+        for (int t = 0; t < R; ++t) {
+            const float2 x = input(X, ldx, S, C, t, c);
+            const __nv_bfloat16* d = D + static_cast<int64_t>(t) * ldd + head * 4;
+            float dl[4];
+#pragma unroll
+            for (int lag = 0; lag < 4; ++lag) dl[lag] = __bfloat162float(d[lag]);
+            float pa[4], pb[4];
+            pa[0] = __fmul_rn(x.x, __fadd_rn(sa[0], dl[0]));
+            pb[0] = __fmul_rn(x.y, __fadd_rn(sb[0], dl[0]));
+            pa[1] = __fmul_rn(h2.x, __fadd_rn(sa[1], dl[1]));
+            pb[1] = __fmul_rn(h2.y, __fadd_rn(sb[1], dl[1]));
+            pa[2] = __fmul_rn(h1.x, __fadd_rn(sa[2], dl[2]));
+            pb[2] = __fmul_rn(h1.y, __fadd_rn(sb[2], dl[2]));
+            pa[3] = __fmul_rn(h0.x, __fadd_rn(sa[3], dl[3]));
+            pb[3] = __fmul_rn(h0.y, __fadd_rn(sb[3], dl[3]));
+            const float a = __fadd_rn(__fadd_rn(pa[0], pa[2]), __fadd_rn(pa[1], pa[3]));
+            const float b = __fadd_rn(__fadd_rn(pb[0], pb[2]), __fadd_rn(pb[1], pb[3]));
+            store(Y + static_cast<int64_t>(t) * ldy + c, __fmul_rn(__fadd_rn(a, x.x), inv), __fmul_rn(__fadd_rn(b, x.y), inv));
+            h0 = h1;
+            h1 = h2;
+            h2 = x;
+        }
+    }
+    // the commit: copies of the raw bf16 pairs (state rows, then input rows)
+    const uint32_t* S32 = reinterpret_cast<const uint32_t*>(S);
+    uint32_t* S32w = reinterpret_cast<uint32_t*>(S);
+    const int c2 = c / 2, C2 = C / 2;
+    uint32_t st[3];
+#pragma unroll
+    for (int i = 0; i < 3; ++i) st[i] = S32[(size_t)i * C2 + c2];  // nothing has written them yet
+    const uint32_t* X32 = reinterpret_cast<const uint32_t*>(X);
+    auto row = [&](int j) -> uint32_t {  // row j of (state, x)
+        return j < 3 ? st[j] : X32[((size_t)(j - 3) * ldx + c) / 2];
+    };
+    if (Hs == nullptr) {
+        uint32_t o[3];
+#pragma unroll
+        for (int i = 0; i < 3; ++i) o[i] = row(R + i);
+#pragma unroll
+        for (int i = 0; i < 3; ++i) S32w[(size_t)i * C2 + c2] = o[i];
+    } else {
+        if (R > 8) return;
+        uint32_t* H32 = reinterpret_cast<uint32_t*>(Hs);
+        uint32_t h[11];
+#pragma unroll
+        for (int i = 0; i < 11; ++i)
+            if (i < 3 + R) h[i] = row(i);
+#pragma unroll
+        for (int i = 0; i < 11; ++i)
+            if (i < 3 + R) H32[(size_t)i * C2 + c2] = h[i];
+#pragma unroll
+        for (int i = 1; i <= 8; ++i)
+            if (i == R) {
+#pragma unroll
+                for (int j = 0; j < 3; ++j) S32w[(size_t)j * C2 + c2] = h[i + j];
+            }
+    }
+}
+
+extern "C" __global__ void __launch_bounds__(NT) tf_ink2_conv_kv_commit(KvCommit p, int R, int C, float inv) {
+    const int z = blockIdx.z;
+    const int c = 2 * (blockIdx.x * NT + threadIdx.x);
+    if (c >= C || R < 1 || R > RT) return;
+    conv_commit(p.X[z], p.ldx[z], p.S[z], p.W[z], p.D[z], p.ldd[z], p.Y[z], p.ldy[z], p.H[z], R, C, inv, c);
+}
+
+// tf_ink2_conv_kv_commit for every segment of a batched forward (cuda_conv.zig kvCommitSegs, postCommitSegs):
+// blockIdx.y is segment g, rows row0[g] .. row0[g] + rows[g] - 1 of the shared X, D and Y, against its own state
+// S[g] and history H[g]. A segment of no rows, or of more than the fused form takes, does nothing (the host sends
+// none). Segments never share a state and their rows are disjoint, so this is the launches a segment in one.
+constexpr int MS = 8;  // segments a launch
+struct KvCommitSegs {
+    const __nv_bfloat16* X[2];
+    long long ldx[2];
+    const __nv_bfloat16* W[2];
+    const __nv_bfloat16* D[2];
+    long long ldd[2];
+    __nv_bfloat16* Y[2];
+    long long ldy[2];
+    __nv_bfloat16* S[MS][2];
+    __nv_bfloat16* H[MS][2];
+    int row0[MS];
+    int rows[MS];
+};
+
+extern "C" __global__ void __launch_bounds__(NT) tf_ink2_conv_kv_commit_segs(KvCommitSegs p, int C, float inv) {
+    const int z = blockIdx.z;
+    const int g = blockIdx.y;
+    const int c = 2 * (blockIdx.x * NT + threadIdx.x);
+    const int R = p.rows[g];
+    if (c >= C || R < 1 || R > RT || (p.H[g][z] != nullptr && R > 8)) return;
+    const long long r0 = p.row0[g];
+    const __nv_bfloat16* D = p.D[z] == nullptr ? nullptr : p.D[z] + r0 * p.ldd[z];
+    conv_commit(p.X[z] + r0 * p.ldx[z], p.ldx[z], p.S[g][z], p.W[z], D, p.ldd[z], p.Y[z] + r0 * p.ldy[z], p.ldy[z],
+                p.H[g][z], R, C, inv, c);
+}
+
+// One convolution of a slot's `keep` table (cuda_state.zig KeepEntry): its state bf16 [3, cols] and its history
+// bf16 [3 + 8, cols] (the state before the window, then the window's input rows).
+struct KeepEntry {
+    unsigned long long state;
+    unsigned long long hist;
+    int cols;
+    int pad;
+};
+
+// A slot's rollback (cuda_engine.zig keep, cuda_state.zig keepAll): every convolution of every layer back to after
+// the window's first `keep` rows, state = hist rows keep .. keep + 2, blockIdx.y one entry of `table`. One launch for
+// the slot instead of a copy a convolution; the same bytes.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_conv_keep(const KeepEntry* __restrict__ table, int keep) {
+    const KeepEntry e = table[blockIdx.y];
+    unsigned short* s = reinterpret_cast<unsigned short*>(e.state);
+    const unsigned short* h = reinterpret_cast<const unsigned short*>(e.hist) + (size_t)keep * e.cols;
+    const int n = 3 * e.cols;
+    for (int i = blockIdx.x * blockDim.x + threadIdx.x; i < n; i += gridDim.x * blockDim.x) s[i] = h[i];
+}
diff --git a/zig/kernels/cuda/inkling2_fuse.cu b/zig/kernels/cuda/inkling2_fuse.cu
new file mode 100644
index 0000000000000000000000000000000000000000..d081f96aedac8370aab63e79144603c3de9662d8
--- /dev/null
+++ b/zig/kernels/cuda/inkling2_fuse.cu
@@ -0,0 +1,897 @@
+// Inkling-2's fused stateless neighbours (G-fuse): one launch where the forward ran two to four, each the same
+// expressions in the same order as the kernels it replaces, so the same bits. The entry points, shapes and the
+// kernels each one replaces are in zig/src/families/inkling2/cuda_fuse.zig.
+//
+//   tf_ink2_fuse_attn_in   res.attn_input (inkling2_res.cu tf_ink2_res_mix_bf16) + the attention norms
+//                          (norms.cu tf_rms_rows on the fp32 mix outputs: res.attn_norm, or res.q/k/v_norm)
+//   tf_ink2_fuse_mlp_in    res.partial (tf_ink2_res_partial) + the boundary push (a row copy) + res.mlp_input
+//                          (tf_ink2_res_mix_f32) + res.mlp_norm (tf_rms_rows)
+//   tf_ink2_fuse_route     moe.route's select (inkling2_moe.cu tf_ink2_moe_select) + checkpoint mode's slot order
+//                          (inkling2_ck.cu tf_ink2_ck_slot_order)
+//
+// The row kernels run a CTA a row of norms.cu's 1,024 threads: the mix on the first 576 (inkling2_res.cu's 8 columns
+// a thread, its warps and its sums in its order), each norm on all 1,024 (tf_rms_rows' columns t + 1024 j, its fma
+// chain, its warp trees and rms_scale) over the mix output staged in shared memory. A row's bits do not depend on R.
+//
+// The same ops' latency forms (tf_ink2_lat_*: the decode default) follow at the end.
+
+#include <cuda_bf16.h>
+#include <math.h>
+#include <stdint.h>
+
+#include "common/reduce.cuh"
+
+namespace tf_ink2_fuse {
+
+constexpr int H = 4608;               // hidden
+constexpr int VEC = 8;                // columns a mix thread
+constexpr int MT = H / VEC;           // 576 mix threads a row (inkling2_res.cu's NT)
+constexpr int MWARPS = MT / 32;       // 18
+constexpr int NT = 1024;              // threads a row: norms.cu's tf_rms_rows block
+constexpr int NWARPS = NT / 32;       // 32
+constexpr int NPER = (H + NT - 1) / NT;  // 5 columns a norm thread (t + 1024 j)
+constexpr int MAX_SRC = 9;            // 8 blocks and the candidate
+constexpr int MAX_Q = 3;              // a global layer's q, k, v sources
+
+static_assert(MT % 32 == 0 && MT <= NT, "the mixers are whole warps of the block");
+
+__device__ __forceinline__ void load8(const __nv_bfloat16* p, float* f) {
+    const uint4 u = *reinterpret_cast<const uint4*>(p);
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&u);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const float2 t = __bfloat1622float2(h[i]);
+        f[2 * i] = t.x;
+        f[2 * i + 1] = t.y;
+    }
+}
+
+__device__ __forceinline__ void load8(const float* p, float* f) {
+    const float4 a = reinterpret_cast<const float4*>(p)[0];
+    const float4 b = reinterpret_cast<const float4*>(p)[1];
+    f[0] = a.x, f[1] = a.y, f[2] = a.z, f[3] = a.w, f[4] = b.x, f[5] = b.y, f[6] = b.z, f[7] = b.w;
+}
+
+__device__ __forceinline__ void store8(float* p, const float* f) {
+    reinterpret_cast<float4*>(p)[0] = make_float4(f[0], f[1], f[2], f[3]);
+    reinterpret_cast<float4*>(p)[1] = make_float4(f[4], f[5], f[6], f[7]);
+}
+
+__device__ __forceinline__ float warp_sum(float v) {
+#pragma unroll
+    for (int m = 16; m > 0; m >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xFFFFFFFFu, v, m));
+    return v;
+}
+
+// The mix's warps' sums in warp order (inkling2_res.cu warps_sum).
+__device__ __forceinline__ float mix_warps_sum(const float* sh) {
+    float t = 0.f;
+#pragma unroll
+    for (int w = 0; w < MWARPS; ++w) t = __fadd_rn(t, sh[w]);
+    return t;
+}
+
+struct MixShared {
+    float ss[MAX_SRC][MWARPS];
+    float dot[MAX_SRC][MAX_Q][MWARPS];
+    float inv[MAX_SRC];
+    float p[MAX_Q][MAX_SRC];
+};
+
+// inkling2_res.cu mix_row on threads 0 .. 575 (the rest only meet the barriers): source i's 8 columns of this thread
+// come from `src(i, v)`; acc[j] is out_j's 8 columns c0 .. c0 + 7 (mixers only).
+template <typename Src>
+__device__ __forceinline__ void mix(MixShared& sh, const Src& src, int ns, const float* __restrict__ queries, int nq,
+                                    float eps, float scale, float (&acc)[MAX_Q][VEC]) {
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const bool mixer = t < MT;
+    const int c0 = t * VEC;
+    float q[MAX_Q][VEC];
+#pragma unroll
+    for (int j = 0; j < MAX_Q; ++j)
+        if (mixer && j < nq) load8(queries + j * H + c0, q[j]);
+    // pass 1: each source's inverse RMS and its scores
+#pragma unroll 1
+    for (int i = 0; i < ns; ++i) {
+        float v[VEC];
+        if (mixer) {
+            src(i, v);
+            float ss = 0.f;
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) ss = __fadd_rn(ss, __fmul_rn(v[k], v[k]));
+            ss = warp_sum(ss);
+            if (lane == 0) sh.ss[i][warp] = ss;
+        }
+        __syncthreads();
+        if (mixer) {
+            const float mean = __fmul_rn(mix_warps_sum(sh.ss[i]), 1.0f / H);
+            const float inv = rsqrtf(__fadd_rn(mean, eps));
+            if (t == 0) sh.inv[i] = inv;
+            float d[MAX_Q] = {0.f, 0.f, 0.f};
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) {
+                const float n = __fmul_rn(v[k], inv);
+#pragma unroll
+                for (int j = 0; j < MAX_Q; ++j)
+                    if (j < nq) d[j] = __fmaf_rn(q[j][k], n, d[j]);
+            }
+#pragma unroll
+            for (int j = 0; j < MAX_Q; ++j)
+                if (j < nq) {
+                    const float s = warp_sum(d[j]);
+                    if (lane == 0) sh.dot[i][j][warp] = s;
+                }
+        }
+    }
+    __syncthreads();
+    // the softmax over the sources, one thread a query
+    if (t < nq) {
+        float s[MAX_SRC];
+        float m = -__int_as_float(0x7f800000);
+#pragma unroll
+        for (int i = 0; i < MAX_SRC; ++i)
+            if (i < ns) {
+                s[i] = __fmul_rn(mix_warps_sum(sh.dot[i][t]), scale);
+                m = fmaxf(m, s[i]);
+            }
+        float sum = 0.f;
+#pragma unroll
+        for (int i = 0; i < MAX_SRC; ++i)
+            if (i < ns) {
+                s[i] = expf(__fsub_rn(s[i], m));
+                sum = __fadd_rn(sum, s[i]);
+            }
+#pragma unroll
+        for (int i = 0; i < MAX_SRC; ++i)
+            if (i < ns) sh.p[t][i] = __fdiv_rn(s[i], sum);
+    }
+    __syncthreads();
+    // pass 2: the weighted sum of the normalized sources
+#pragma unroll
+    for (int j = 0; j < MAX_Q; ++j)
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) acc[j][k] = 0.f;
+    if (!mixer) return;
+#pragma unroll 1
+    for (int i = 0; i < ns; ++i) {
+        float v[VEC];
+        src(i, v);
+        const float inv = sh.inv[i];
+        float p[MAX_Q];
+#pragma unroll
+        for (int j = 0; j < MAX_Q; ++j) p[j] = j < nq ? sh.p[j][i] : 0.f;
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) {
+            const float n = __fmul_rn(v[k], inv);
+#pragma unroll
+            for (int j = 0; j < MAX_Q; ++j) acc[j][k] = __fmaf_rn(p[j], n, acc[j][k]);
+        }
+    }
+}
+
+struct NormShared {
+    float x[H];          // the row being normed (fp32, as the mix stored it)
+    float warps[NWARPS];
+    float inv;
+};
+
+// One row of norms.cu tf_rms_rows (fp32 x, bf16 y, the cached path of 8 columns a thread at t + 1024 j) over the
+// mix's out_j (a mixer's acc[j]): y = bf16(x * rms_scale(sum x^2) * w), w null: no gain. Every thread calls.
+__device__ __forceinline__ void norm(NormShared& sh, const float (&acc)[MAX_Q][VEC], int j, const float* __restrict__ w,
+                                     __nv_bfloat16* __restrict__ y, float eps) {
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    __syncthreads();  // an earlier norm's readers of sh are done
+    if (t < MT) {
+#pragma unroll
+        for (int jj = 0; jj < MAX_Q; ++jj)
+            if (jj == j) {
+#pragma unroll
+                for (int k = 0; k < VEC; ++k) sh.x[t * VEC + k] = acc[jj][k];
+            }
+    }
+    __syncthreads();
+    float v[NPER];
+    float part = 0.f;
+#pragma unroll
+    for (int k = 0; k < NPER; ++k) {  // tf_rms_rows' zeros past the row add nothing to a non-negative sum
+        const int i = t + k * NT;
+        v[k] = i < H ? sh.x[i] : 0.f;
+        if (i < H) part = __fmaf_rn(v[k], v[k], part);
+    }
+    // norms.cu inv_rms: the warp's xor tree, then the 32 warps' sums in one more xor tree, then rms_scale
+#pragma unroll
+    for (int m = 16; m > 0; m >>= 1) part = __fadd_rn(part, __shfl_xor_sync(0xFFFFFFFFu, part, m));
+    if (lane == 0) sh.warps[warp] = part;
+    __syncthreads();
+    if (t < 32) {
+        float s = sh.warps[t];
+#pragma unroll
+        for (int m = 16; m > 0; m >>= 1) s = __fadd_rn(s, __shfl_xor_sync(0xFFFFFFFFu, s, m));
+        if (t == 0) sh.inv = tf_common::rms_scale(s, H, eps);
+    }
+    __syncthreads();
+    const float inv = sh.inv;
+#pragma unroll
+    for (int k = 0; k < NPER; ++k) {
+        const int i = t + k * NT;
+        if (i < H) y[i] = __float2bfloat16_rn(w != nullptr ? __fmul_rn(__fmul_rn(v[k], inv), w[i]) : __fmul_rn(v[k], inv));
+    }
+}
+
+// attn_in's sources: the blocks, then the bf16 candidate (h_in).
+struct AttnSrc {
+    const __nv_bfloat16* blocks;
+    long long stride;
+    int nblocks;
+    const __nv_bfloat16* cand;
+    int64_t row;
+    int c0;
+    __device__ __forceinline__ void operator()(int i, float* v) const {
+        if (i < nblocks) load8(blocks + i * stride + row * H + c0, v);
+        else load8(cand + row * H + c0, v);
+    }
+};
+
+// mlp_in's sources: the blocks below the layer, h_in when the layer pushes it (a boundary), then the partial (fp32,
+// this thread's own 8 columns, as tf_ink2_res_partial stored them).
+struct MlpSrc {
+    const __nv_bfloat16* blocks;
+    long long stride;
+    int nblocks;
+    const __nv_bfloat16* pushed;  // null: no push
+    int64_t row;
+    int c0;
+    float part[VEC];
+    __device__ __forceinline__ void operator()(int i, float* v) const {
+        if (i < nblocks) load8(blocks + i * stride + row * H + c0, v);
+        else if (pushed != nullptr && i == nblocks) load8(pushed + row * H + c0, v);
+        else {
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) v[k] = part[k];
+        }
+    }
+};
+
+}  // namespace tf_ink2_fuse
+
+using namespace tf_ink2_fuse;
+
+// The module's presence check (cuda_kernels.zig Group): writes the group's number.
+extern "C" __global__ void tf_ink2_fuse_probe(int* out) {
+    if (out != nullptr && threadIdx.x == 0 && blockIdx.x == 0) *out = 8;
+}
+
+// res.attn_input then its norms. Grid: rows; block: NT. The mix as tf_ink2_res_mix_bf16 (out_j fp32, stored), then
+// nn norms: norm j of out_{nq == 1 ? 0 : j} with gain g_j (null: none) into y_j bf16 [rows, H].
+extern "C" __global__ void __launch_bounds__(NT)
+    tf_ink2_fuse_attn_in(const __nv_bfloat16* blocks, long long block_stride, int nblocks, const __nv_bfloat16* cand,
+                         const float* queries, int nq, float* out0, float* out1, float* out2, float eps, float scale,
+                         int nn, const float* g0, const float* g1, const float* g2, __nv_bfloat16* y0,
+                         __nv_bfloat16* y1, __nv_bfloat16* y2, float norm_eps) {
+    __shared__ MixShared msh;
+    __shared__ NormShared nsh;
+    const int64_t row = blockIdx.x;
+    const int t = threadIdx.x;
+    const AttnSrc src{blocks, block_stride, nblocks, cand, row, t * VEC};
+    float acc[MAX_Q][VEC];
+    mix(msh, src, nblocks + 1, queries, nq, eps, scale, acc);
+    if (t < MT) {
+        float* outs[MAX_Q] = {out0, out1, out2};
+#pragma unroll
+        for (int j = 0; j < MAX_Q; ++j)
+            if (j < nq) store8(outs[j] + row * H + t * VEC, acc[j]);
+    }
+    const float* gs[MAX_Q] = {g0, g1, g2};
+    __nv_bfloat16* ys[MAX_Q] = {y0, y1, y2};
+#pragma unroll
+    for (int j = 0; j < MAX_Q; ++j)
+        if (j < nn) norm(nsh, acc, nq == 1 ? 0 : j, gs[j], ys[j] + row * H, norm_eps);
+}
+
+// res.partial, the boundary push, res.mlp_input and res.mlp_norm. Grid: rows; block: NT.
+//   partial fp32 = boundary ? f32(a) : f32(h_in) + f32(a)                       (tf_ink2_res_partial)
+//   boundary: push (block `nblocks`) = h_in, bit for bit                         (state.pushBlock's row copy)
+//   mx fp32 = Mix(query; blocks 0 .. nblocks - 1 [, h_in], partial)             (tf_ink2_res_mix_f32)
+//   m bf16 = bf16(mx * rms_scale * gain)                                         (tf_rms_rows)
+extern "C" __global__ void __launch_bounds__(NT)
+    tf_ink2_fuse_mlp_in(const __nv_bfloat16* h_in, const __nv_bfloat16* a, int boundary, float* partial,
+                        const __nv_bfloat16* blocks, long long block_stride, int nblocks, __nv_bfloat16* push,
+                        const float* query, float* mx, float eps, float scale, const float* gain, __nv_bfloat16* m,
+                        float norm_eps) {
+    __shared__ MixShared msh;
+    __shared__ NormShared nsh;
+    const int64_t row = blockIdx.x;
+    const int t = threadIdx.x;
+    const int c0 = t * VEC;
+    const int64_t at = row * H + c0;
+    float pv[VEC] = {0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f, 0.f};
+    if (t < MT) {
+        float x[VEC];
+        load8(a + at, pv);
+        if (!boundary) {
+            load8(h_in + at, x);
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) pv[k] = __fadd_rn(x[k], pv[k]);
+        } else {
+            *reinterpret_cast<uint4*>(push + at) = *reinterpret_cast<const uint4*>(h_in + at);
+        }
+        store8(partial + at, pv);
+    }
+    MlpSrc src{blocks, block_stride, nblocks, boundary ? h_in : nullptr, row, c0};
+#pragma unroll
+    for (int k = 0; k < VEC; ++k) src.part[k] = pv[k];
+    float acc[MAX_Q][VEC];
+    mix(msh, src, nblocks + (boundary ? 1 : 0) + 1, query, 1, eps, scale, acc);
+    if (t < MT) store8(mx + at, acc[0]);
+    norm(nsh, acc, 0, gain, m + row * H, norm_eps);
+}
+
+// ------------------------------------------------------------------------------------------------- router
+
+constexpr int NEXP = 384;
+constexpr int TOPK = 8;
+constexpr float ROUTE_SCALE = 8.0f;
+
+// tf_ink2_moe_select (a row a warp: the 8 largest sigmoid(logit) + bias, ties to the lower id, weights
+// s / (sum s + 1e-20) * 8 with the sum in ascending id), then tf_ink2_ck_slot_order on its picks (descending
+// sigmoid(logit) + bias, a stable sort of the ascending ids; a NaN pick, id -1, scores -inf): ids and wts in slot
+// order. Every lane holds the picks, so every lane sorts them the same way; lane k writes slot k.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_fuse_route(const float* __restrict__ logits, const float* __restrict__ bias, int* __restrict__ ids,
+                       float* __restrict__ wts, int R) {
+    const int lane = threadIdx.x & 31;
+    const int row = blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (row >= R) return;
+    constexpr int PER = NEXP / 32;
+    float s[PER], sc[PER];
+#pragma unroll
+    for (int i = 0; i < PER; ++i) {
+        const int e = lane + 32 * i;
+        const float l = logits[(size_t)row * NEXP + e];
+        s[i] = __fdiv_rn(1.0f, __fadd_rn(1.0f, expf(-l)));
+        sc[i] = __fadd_rn(s[i], bias[e]);
+    }
+    uint32_t taken = 0;
+    int pick[TOPK];
+    float ps[TOPK];
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+        float best = -INFINITY;
+        int bid = 0x7FFFFFFF;
+#pragma unroll
+        for (int i = 0; i < PER; ++i)
+            if (!(taken >> i & 1u) && sc[i] > best) best = sc[i], bid = lane + 32 * i;  // ascending id: > keeps the lower
+#pragma unroll
+        for (int off = 16; off > 0; off >>= 1) {
+            const float ob = __shfl_xor_sync(0xFFFFFFFFu, best, off);
+            const int oi = __shfl_xor_sync(0xFFFFFFFFu, bid, off);
+            if (ob > best || (ob == best && oi < bid)) best = ob, bid = oi;
+        }
+        float v = 0.f;
+        if (bid != 0x7FFFFFFF && (bid & 31) == lane) {
+#pragma unroll
+            for (int i = 0; i < PER; ++i)
+                if (i == (bid >> 5)) v = s[i], taken |= 1u << i;
+        }
+        v = __shfl_sync(0xFFFFFFFFu, v, bid & 31);
+        pick[k] = bid == 0x7FFFFFFF ? -1 : bid;
+        ps[k] = v;
+    }
+    // ascending id (insertion sort, the same on every lane; -1 sorts first)
+#pragma unroll
+    for (int i = 1; i < TOPK; ++i) {
+#pragma unroll
+        for (int j = i; j > 0; --j) {
+            if (pick[j] < pick[j - 1]) {
+                const int ti = pick[j];
+                pick[j] = pick[j - 1];
+                pick[j - 1] = ti;
+                const float tv = ps[j];
+                ps[j] = ps[j - 1];
+                ps[j - 1] = tv;
+            }
+        }
+    }
+    float sum = ps[0];
+#pragma unroll
+    for (int k = 1; k < TOPK; ++k) sum = __fadd_rn(sum, ps[k]);
+    const float den = __fadd_rn(sum, 1e-20f);
+    // select's outputs in ascending id, then the slot order's sort keys from the logits, as tf_ink2_ck_slot_order
+    int id[TOPK];
+    float w[TOPK], key[TOPK];
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+        id[k] = pick[k];
+        w[k] = __fmul_rn(__fdiv_rn(ps[k], den), ROUTE_SCALE);
+        if (id[k] < 0) {
+            key[k] = -INFINITY;
+            continue;
+        }
+        const float l = __ldg(logits + (size_t)row * NEXP + id[k]);
+        key[k] = __fadd_rn(__fdiv_rn(1.0f, __fadd_rn(1.0f, expf(-l))), __ldg(bias + id[k]));
+    }
+#pragma unroll
+    for (int i = 1; i < TOPK; ++i)
+#pragma unroll
+        for (int j = i; j > 0; --j)
+            if (key[j] > key[j - 1]) {
+                const float ts = key[j], tw = w[j];
+                const int ti = id[j];
+                key[j] = key[j - 1], w[j] = w[j - 1], id[j] = id[j - 1];
+                key[j - 1] = ts, w[j - 1] = tw, id[j - 1] = ti;
+            }
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+        if (lane == k) {
+            ids[(size_t)row * TOPK + k] = id[k];
+            wts[(size_t)row * TOPK + k] = w[k];
+        }
+    }
+}
+
+// ------------------------------------------------------------------------------------------------- latency forms
+//
+// The same three ops rewritten for one-row latency (cuda_fuse.zig: the default for decode-sized calls), the same
+// expressions in the same order and the same reduction trees as the kernels they replace, so the same bits:
+//
+//   tf_ink2_lat_attn_in   res.attn_input + its norms      every source loaded once, up front, and kept in registers
+//   tf_ink2_lat_mlp_in    res.partial + push + mlp_input  (bf16 packed) for both passes; a barrier a phase (5)
+//                         + mlp_norm                      instead of one a source and four a norm; the softmax on
+//                                                         warp 0's lanes, a lane a (query, source)
+//   tf_ink2_lat_route     select + slot order             the 8 rounds on the lanes' best scores with two warp
+//                                                         reductions a round instead of ten dependent shuffles
+//
+// The row kernels run 576 threads (the mix's 18 warps of 8 columns a thread). The norm's sums are norms.cu's
+// tf_rms_rows on 1,024 threads (columns v + 1024 k, its fma chain, its warp xor tree, the 32 warps' xor tree,
+// rms_scale): thread t is the norm's threads t and t + 576 (t < 448), so warp w is the norm's warps w and w + 18, the
+// same lanes. Every warp then runs the last xor tree itself (the same bits on every lane), so no thread waits for one
+// warp's result. The normed rows are written from the mix's registers (each element y = bf16(x * inv * g) on its own).
+// Measured at one row (tf-inkling2-fuse, 48 layers' worth, GB10): select + slot order 13.0 to 2.5 us, attention input
+// with its norm 5.1-12.7 to 4.6-8.1 us (0 to 7 blocks), MLP input 6.6-14.0 to 5.0-9.3 us; in the W = 4 decode step
+// (tf-inkling2-decode --exp check,fuse) 1.23 +- 0.05 ms a step less than the release's ops.
+
+namespace tf_ink2_lat {
+
+constexpr int H = 4608;
+constexpr int VEC = 8;
+constexpr int NT = H / VEC;             // 576 threads a row
+constexpr int NW = NT / 32;             // 18 warps
+constexpr int VT = 1024;                // the norm's threads (norms.cu tf_rms_rows)
+constexpr int VPER = (H + VT - 1) / VT; // 5 columns a norm thread
+constexpr int MAX_SRC = 9;              // 8 blocks and the candidate
+constexpr int MAX_Q = 3;
+
+static_assert(NT % 32 == 0 && NT < VT && 2 * NT >= VT, "a thread holds one or two of the norm's threads");
+
+__device__ __forceinline__ uint4 ld16(const void* p) { return *reinterpret_cast<const uint4*>(p); }
+
+__device__ __forceinline__ void unpack(const uint4 u, float* f) {
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&u);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const float2 t = __bfloat1622float2(h[i]);
+        f[2 * i] = t.x;
+        f[2 * i + 1] = t.y;
+    }
+}
+
+__device__ __forceinline__ void load8f(const float* p, float* f) {
+    const float4 a = reinterpret_cast<const float4*>(p)[0];
+    const float4 b = reinterpret_cast<const float4*>(p)[1];
+    f[0] = a.x, f[1] = a.y, f[2] = a.z, f[3] = a.w, f[4] = b.x, f[5] = b.y, f[6] = b.z, f[7] = b.w;
+}
+
+__device__ __forceinline__ void store8f(float* p, const float* f) {
+    reinterpret_cast<float4*>(p)[0] = make_float4(f[0], f[1], f[2], f[3]);
+    reinterpret_cast<float4*>(p)[1] = make_float4(f[4], f[5], f[6], f[7]);
+}
+
+__device__ __forceinline__ float xor_sum(float v) {
+#pragma unroll
+    for (int m = 16; m > 0; m >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xFFFFFFFFu, v, m));
+    return v;
+}
+
+// inkling2_res.cu warps_sum: the 18 warps' sums in warp order.
+__device__ __forceinline__ float warps_sum(const float* sh) {
+    float t = 0.f;
+#pragma unroll
+    for (int w = 0; w < NW; ++w) t = __fadd_rn(t, sh[w]);
+    return t;
+}
+
+struct Shared {
+    float ss[MAX_SRC][NW];
+    float dot[MAX_SRC][MAX_Q][NW];
+    float p[MAX_Q][MAX_SRC];
+    float nw[MAX_Q][32];
+};
+
+// A row's sources in registers: bf16 sources 0 .. nbf - 1 packed (8 columns a uint4), then, when F32, one fp32 source
+// (the last, index nbf). Every index is a constant after unrolling (no runtime index into pk, which would put it in
+// local memory): a source is pk[i] unpacked, replaced by f when i is nbf.
+template <bool F32>
+struct Sources {
+    uint4 pk[MAX_SRC];
+    float f[VEC];
+    int nbf;
+    __device__ __forceinline__ int count() const { return nbf + (F32 ? 1 : 0); }
+    __device__ __forceinline__ void get(int i, float* v) const {
+        unpack(pk[i], v);
+        if (F32) {
+            const bool last = i == nbf;
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) v[k] = last ? f[k] : v[k];
+        }
+    }
+};
+
+// One row of inkling2_res.cu mix_row on registers (sources and queries loaded by the caller): acc[j] = out_j's 8
+// columns of this thread. Two barriers and the softmax's one: scores need every warp's sums.
+template <int NQ, bool F32>
+__device__ __forceinline__ void mix(Shared& sh, const Sources<F32>& src, const float (&q)[NQ][VEC], float eps,
+                                    float scale, float (&acc)[NQ][VEC]) {
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+    const int ns = src.count();
+    // each source's sum of squares: this thread's 8 columns in order, then the warp's xor tree
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i)
+        if (i < ns) {
+            float v[VEC];
+            src.get(i, v);
+            float ss = 0.f;
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) ss = __fadd_rn(ss, __fmul_rn(v[k], v[k]));
+            ss = xor_sum(ss);
+            if (lane == 0) sh.ss[i][warp] = ss;
+        }
+    __syncthreads();
+    // the inverse RMS of source i on lane i of every warp (the 18 warps' sums in order), then on every lane
+    float inv_l = 0.f;
+    if (lane < ns) {
+        const float mean = __fmul_rn(warps_sum(sh.ss[lane]), 1.0f / H);
+        inv_l = rsqrtf(__fadd_rn(mean, eps));
+    }
+    float inv[MAX_SRC];
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i) inv[i] = __shfl_sync(0xFFFFFFFFu, inv_l, i);
+    // the scores' sums: q_j . n_i over this thread's columns, then the warp's xor tree
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i)
+        if (i < ns) {
+            float v[VEC];
+            src.get(i, v);
+            float d[NQ];
+#pragma unroll
+            for (int j = 0; j < NQ; ++j) d[j] = 0.f;
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) {
+                const float n = __fmul_rn(v[k], inv[i]);
+#pragma unroll
+                for (int j = 0; j < NQ; ++j) d[j] = __fmaf_rn(q[j][k], n, d[j]);
+            }
+#pragma unroll
+            for (int j = 0; j < NQ; ++j) {
+                const float s = xor_sum(d[j]);
+                if (lane == 0) sh.dot[i][j][warp] = s;
+            }
+        }
+    __syncthreads();
+    // the softmax over the sources on warp 0, lane 9 j + i holding query j's score of source i: its max and its sum
+    // run through the same scores in the same order as mix_row's one thread a query (every lane of the group runs
+    // them on the gathered scores), the exponentials and the divisions one a lane
+    if (warp == 0) {
+        const int j = lane / MAX_SRC, i = lane - j * MAX_SRC;
+        const bool on = j < NQ && i < ns;
+        const float sv = on ? __fmul_rn(warps_sum(sh.dot[i][j]), scale) : 0.f;
+        const int g = j < NQ ? j * MAX_SRC : 0;
+        float m = -__int_as_float(0x7f800000);
+#pragma unroll
+        for (int k = 0; k < MAX_SRC; ++k) {
+            const float o = __shfl_sync(0xFFFFFFFFu, sv, g + k);
+            if (k < ns) m = fmaxf(m, o);
+        }
+        const float e = expf(__fsub_rn(sv, m));
+        float sum = 0.f;
+#pragma unroll
+        for (int k = 0; k < MAX_SRC; ++k) {
+            const float o = __shfl_sync(0xFFFFFFFFu, e, g + k);
+            if (k < ns) sum = __fadd_rn(sum, o);
+        }
+        if (on) sh.p[j][i] = __fdiv_rn(e, sum);
+    }
+    __syncthreads();
+    // the weighted sum of the normalized sources, in source order
+#pragma unroll
+    for (int j = 0; j < NQ; ++j)
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) acc[j][k] = 0.f;
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i)
+        if (i < ns) {
+            float v[VEC];
+            src.get(i, v);
+            float p[NQ];
+#pragma unroll
+            for (int j = 0; j < NQ; ++j) p[j] = sh.p[j][i];
+#pragma unroll
+            for (int k = 0; k < VEC; ++k) {
+                const float n = __fmul_rn(v[k], inv[i]);
+#pragma unroll
+                for (int j = 0; j < NQ; ++j) acc[j][k] = __fmaf_rn(p[j], n, acc[j][k]);
+            }
+        }
+}
+
+// The norms' scales of nx staged rows xs[j] (fp32 [H] each, in shared memory, written before the caller's barrier):
+// inv[j] = tf_rms_rows' rms_scale of row j, the same bits on every thread. One barrier.
+template <int NX>
+__device__ __forceinline__ void norm_scales(Shared& sh, const float* xs, float eps, float (&inv)[NX]) {
+    const int t = threadIdx.x, lane = t & 31, warp = t >> 5;
+#pragma unroll
+    for (int j = 0; j < NX; ++j) {
+        const float* x = xs + j * H;
+#pragma unroll
+        for (int h = 0; h < 2; ++h) {  // the norm's threads t and t + NT
+            const int v = t + h * NT;
+            if (v < VT) {
+                float part = 0.f;
+#pragma unroll
+                for (int k = 0; k < VPER; ++k) {  // tf_rms_rows' zeros past the row add nothing to a non-negative sum
+                    const int i = v + k * VT;
+                    if (i < H) part = __fmaf_rn(x[i], x[i], part);
+                }
+                part = xor_sum(part);
+                if (lane == 0) sh.nw[j][v >> 5] = part;
+            }
+        }
+    }
+    __syncthreads();
+#pragma unroll
+    for (int j = 0; j < NX; ++j) inv[j] = tf_common::rms_scale(xor_sum(sh.nw[j][lane]), H, eps);
+}
+
+// y = bf16(x * inv * g) on this thread's 8 columns (no gain: x * inv), one 16-byte store.
+__device__ __forceinline__ void norm_store(const float* x, float inv, bool g, const float* gv, __nv_bfloat16* y) {
+    float o[VEC];
+    if (g) {
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) o[k] = __fmul_rn(__fmul_rn(x[k], inv), gv[k]);
+    } else {
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) o[k] = __fmul_rn(x[k], inv);
+    }
+    uint4 u;
+    __nv_bfloat16* h = reinterpret_cast<__nv_bfloat16*>(&u);
+#pragma unroll
+    for (int k = 0; k < VEC; ++k) h[k] = __float2bfloat16_rn(o[k]);
+    *reinterpret_cast<uint4*>(y) = u;
+}
+
+// The attention input of one row: NQ mixes (stored), then nn norms of out_{NQ == 1 ? 0 : j}.
+template <int NQ>
+__device__ __forceinline__ void attn_in_row(const __nv_bfloat16* blocks, long long block_stride, int nblocks,
+                                            const __nv_bfloat16* cand, const float* queries, float* out0, float* out1,
+                                            float* out2, float eps, float scale, int nn, const float* g0,
+                                            const float* g1, const float* g2, __nv_bfloat16* y0, __nv_bfloat16* y1,
+                                            __nv_bfloat16* y2, float norm_eps) {
+    __shared__ Shared sh;
+    extern __shared__ float4 xs4[];  // the normed rows, fp32 [NQ][H]
+    float* xs = reinterpret_cast<float*>(xs4);
+    const int64_t row = blockIdx.x;
+    const int t = threadIdx.x;
+    const int c0 = t * VEC;
+    // every load first: the sources, then the queries
+    Sources<false> src;
+    src.nbf = nblocks + 1;
+    const uint4 uc = ld16(cand + row * H + c0);
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i) src.pk[i] = i < nblocks ? ld16(blocks + i * block_stride + row * H + c0) : uc;
+    float q[NQ][VEC];
+#pragma unroll
+    for (int j = 0; j < NQ; ++j) load8f(queries + j * H + c0, q[j]);
+    const float* gs[MAX_Q] = {g0, g1, g2};
+    float gv[MAX_Q][VEC];
+#pragma unroll
+    for (int j = 0; j < MAX_Q; ++j)
+        if (j < nn && gs[j] != nullptr) load8f(gs[j] + c0, gv[j]);
+    float acc[NQ][VEC];
+    mix<NQ>(sh, src, q, eps, scale, acc);
+    float* outs[MAX_Q] = {out0, out1, out2};
+#pragma unroll
+    for (int j = 0; j < NQ; ++j) {
+        store8f(outs[j] + row * H + c0, acc[j]);
+        store8f(xs + j * H + c0, acc[j]);
+    }
+    __syncthreads();
+    float inv[NQ];
+    norm_scales<NQ>(sh, xs, norm_eps, inv);
+    __nv_bfloat16* ys[MAX_Q] = {y0, y1, y2};
+#pragma unroll
+    for (int j = 0; j < MAX_Q; ++j)
+        if (j < nn) {
+            const int x = NQ == 1 ? 0 : j;
+            norm_store(acc[x], inv[x], gs[j] != nullptr, gv[j], ys[j] + row * H + c0);
+        }
+}
+
+// res.partial, the boundary push, res.mlp_input and res.mlp_norm of one row (tf_ink2_fuse_mlp_in's math).
+__device__ __forceinline__ void mlp_in_row(const __nv_bfloat16* h_in, const __nv_bfloat16* a, int boundary,
+                                           float* partial, const __nv_bfloat16* blocks, long long block_stride,
+                                           int nblocks, __nv_bfloat16* push, const float* query, float* mx, float eps,
+                                           float scale, const float* gain, __nv_bfloat16* m, float norm_eps) {
+    __shared__ Shared sh;
+    extern __shared__ float4 xs4[];
+    float* xs = reinterpret_cast<float*>(xs4);
+    const int64_t row = blockIdx.x;
+    const int t = threadIdx.x;
+    const int c0 = t * VEC;
+    const int64_t at = row * H + c0;
+    // every load first: a, h_in, the blocks, the query, the gain
+    const uint4 ua = ld16(a + at);
+    const uint4 uh = ld16(h_in + at);
+    Sources<true> src;
+    src.nbf = nblocks + (boundary ? 1 : 0);
+#pragma unroll
+    for (int i = 0; i < MAX_SRC; ++i) src.pk[i] = i < nblocks ? ld16(blocks + i * block_stride + row * H + c0) : uh;
+    float q[1][VEC];
+    load8f(query + c0, q[0]);
+    float gv[VEC];
+    if (gain != nullptr) load8f(gain + c0, gv);
+    // tf_ink2_res_partial, and the push (state.pushBlock's row copy)
+    unpack(ua, src.f);
+    if (!boundary) {
+        float x[VEC];
+        unpack(uh, x);
+#pragma unroll
+        for (int k = 0; k < VEC; ++k) src.f[k] = __fadd_rn(x[k], src.f[k]);
+    } else {
+        *reinterpret_cast<uint4*>(push + at) = uh;
+    }
+    store8f(partial + at, src.f);
+    float acc[1][VEC];
+    mix<1>(sh, src, q, eps, scale, acc);
+    store8f(mx + at, acc[0]);
+    store8f(xs + c0, acc[0]);
+    __syncthreads();
+    float inv[1];
+    norm_scales<1>(sh, xs, norm_eps, inv);
+    norm_store(acc[0], inv[0], gain != nullptr, gv, m + at);
+}
+
+}  // namespace tf_ink2_lat
+
+// tf_ink2_fuse_attn_in's latency form: the same arguments; grid rows, block 576, dynamic shared nq * H * 4 bytes.
+extern "C" __global__ void __launch_bounds__(tf_ink2_lat::NT)
+    tf_ink2_lat_attn_in(const __nv_bfloat16* blocks, long long block_stride, int nblocks, const __nv_bfloat16* cand,
+                        const float* queries, int nq, float* out0, float* out1, float* out2, float eps, float scale,
+                        int nn, const float* g0, const float* g1, const float* g2, __nv_bfloat16* y0,
+                        __nv_bfloat16* y1, __nv_bfloat16* y2, float norm_eps) {
+    if (nq == 1)
+        tf_ink2_lat::attn_in_row<1>(blocks, block_stride, nblocks, cand, queries, out0, out1, out2, eps, scale, nn, g0,
+                                    g1, g2, y0, y1, y2, norm_eps);
+    else
+        tf_ink2_lat::attn_in_row<3>(blocks, block_stride, nblocks, cand, queries, out0, out1, out2, eps, scale, nn, g0,
+                                    g1, g2, y0, y1, y2, norm_eps);
+}
+
+// tf_ink2_fuse_mlp_in's latency form: the same arguments; grid rows, block 576, dynamic shared H * 4 bytes.
+extern "C" __global__ void __launch_bounds__(tf_ink2_lat::NT)
+    tf_ink2_lat_mlp_in(const __nv_bfloat16* h_in, const __nv_bfloat16* a, int boundary, float* partial,
+                       const __nv_bfloat16* blocks, long long block_stride, int nblocks, __nv_bfloat16* push,
+                       const float* query, float* mx, float eps, float scale, const float* gain, __nv_bfloat16* m,
+                       float norm_eps) {
+    tf_ink2_lat::mlp_in_row(h_in, a, boundary, partial, blocks, block_stride, nblocks, push, query, mx, eps, scale, gain,
+                            m, norm_eps);
+}
+
+// tf_ink2_fuse_route's latency form (select + slot order; the same arguments, a warp a row, 256 threads a block).
+// The picks: the 8 rounds of select, each the largest valid score (not NaN, above -inf), ties to the lower id. A score
+// is a 32-bit key that orders as the float does (-0 read as +0, as > reads them; invalid scores 0, below every valid
+// key); each lane takes its own best untaken (key, id) of its 12 (a tree), the warp the largest key (one reduction)
+// and the lowest id holding it (a second); the winner's lane marks it taken. That is select's pick in every round. The slot order
+// sorts select's picks by the same score descending, ties to the lower id, the empty picks (-1) last: the order the
+// rounds draw them in. The weights are select's: s / (sum s in ascending id + 1e-20) * 8.
+extern "C" __global__ void __launch_bounds__(256)
+    tf_ink2_lat_route(const float* __restrict__ logits, const float* __restrict__ bias, int* __restrict__ ids,
+                      float* __restrict__ wts, int R) {
+    const int lane = threadIdx.x & 31;
+    const int row = blockIdx.x * 8 + (threadIdx.x >> 5);
+    if (row >= R) return;
+    constexpr int PER = NEXP / 32;
+    float l[PER], b[PER];
+#pragma unroll
+    for (int i = 0; i < PER; ++i) {
+        l[i] = logits[(size_t)row * NEXP + lane + 32 * i];
+        b[i] = bias[lane + 32 * i];
+    }
+    float s[PER];
+    uint32_t key[PER];
+#pragma unroll
+    for (int i = 0; i < PER; ++i) {
+        s[i] = __fdiv_rn(1.0f, __fadd_rn(1.0f, expf(-l[i])));
+        const float sc = __fadd_rn(s[i], b[i]);
+        const bool valid = sc > -INFINITY;  // false for NaN
+        const uint32_t u = sc == 0.f ? 0u : __float_as_uint(sc);
+        key[i] = !valid ? 0u : (u & 0x80000000u) ? ~u : (u | 0x80000000u);
+    }
+    int pick[TOPK];
+    uint32_t taken = 0;
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+        // this lane's best untaken: the largest key, ties to the lower i (the lower id); a tree over (key, 15 - i)
+        unsigned long long c[16];
+#pragma unroll
+        for (int i = 0; i < 16; ++i)
+            c[i] = (i < PER && !(taken >> i & 1u)) ? ((unsigned long long)key[i] << 4 | (unsigned long long)(15 - i)) : 0ull;
+#pragma unroll
+        for (int w = 8; w > 0; w >>= 1)
+#pragma unroll
+            for (int i = 0; i < w; ++i) c[i] = c[i] > c[i + w] ? c[i] : c[i + w];
+        const uint32_t bk = (uint32_t)(c[0] >> 4);
+        const int bi = 15 - (int)(c[0] & 15ull);
+        const uint32_t top = __reduce_max_sync(0xFFFFFFFFu, bk);
+        const uint32_t id = (uint32_t)__reduce_min_sync(0xFFFFFFFFu, bk == top ? (uint32_t)(lane + 32 * bi) : 0xFFFFFFFFu);
+        const bool none = top == 0u;
+        pick[k] = none ? -1 : (int)id;
+        if (!none && (int)id == lane + 32 * bi) taken |= 1u << bi;
+    }
+    // the picks' s: lane id & 31's s[id >> 5] (0 for none, as select's)
+    float ps[TOPK];
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) {
+        float v = 0.f;
+#pragma unroll
+        for (int i = 0; i < PER; ++i) v = (pick[k] >= 0 && (pick[k] >> 5) == i) ? s[i] : v;
+        ps[k] = __shfl_sync(0xFFFFFFFFu, v, pick[k] < 0 ? 31 : pick[k] & 31);
+    }
+    // select's sum in ascending id (its insertion sort; -1 sorts first)
+    int sid[TOPK];
+    float sps[TOPK];
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k) sid[k] = pick[k], sps[k] = ps[k];
+#pragma unroll
+    for (int i = 1; i < TOPK; ++i) {
+#pragma unroll
+        for (int j = i; j > 0; --j) {
+            if (sid[j] < sid[j - 1]) {
+                const int ti = sid[j];
+                sid[j] = sid[j - 1];
+                sid[j - 1] = ti;
+                const float tv = sps[j];
+                sps[j] = sps[j - 1];
+                sps[j - 1] = tv;
+            }
+        }
+    }
+    float sum = sps[0];
+#pragma unroll
+    for (int k = 1; k < TOPK; ++k) sum = __fadd_rn(sum, sps[k]);
+    const float den = __fadd_rn(sum, 1e-20f);
+    // lane k < 8 writes slot k: its pick and weight
+    int my_id = -1;
+    float my_ps = 0.f;
+#pragma unroll
+    for (int k = 0; k < TOPK; ++k)
+        if (lane == k) my_id = pick[k], my_ps = ps[k];
+    if (lane < TOPK) {
+        ids[(size_t)row * TOPK + lane] = my_id;
+        wts[(size_t)row * TOPK + lane] = __fmul_rn(__fdiv_rn(my_ps, den), ROUTE_SCALE);
+    }
+}
+
+// cuda_attn.zig projectOne at 2-16 rows: each projection's columns of the one launch's [R, n] output (rows `ld`
+// apart) copied to its own dense rows. Grid (R, members), a bf16 copy, no arithmetic.
+struct ProjSplit {
+    const unsigned short* src[8];
+    unsigned short* dst[8];
+    int n[8];
+    int ld[8];
+};
+
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_proj_split(ProjSplit s) {
+    const int r = blockIdx.x, m = blockIdx.y;
+    const unsigned short* a = s.src[m] + (size_t)r * s.ld[m];
+    unsigned short* b = s.dst[m] + (size_t)r * s.n[m];
+    for (int j = threadIdx.x; j < s.n[m]; j += blockDim.x) b[j] = a[j];
+}
diff --git a/zig/kernels/cuda/inkling2_head.cu b/zig/kernels/cuda/inkling2_head.cu
new file mode 100644
index 0000000000000000000000000000000000000000..0e68b305491678a21d8eab9349d0da400ea1fdfd
--- /dev/null
+++ b/zig/kernels/cuda/inkling2_head.cu
@@ -0,0 +1,245 @@
+// Inkling-2's head group (G-head): the unembed as row-invariant bf16 rows (dense_rows.cu's sums, a bf16 store) and
+// the final logit softcap over the unpadded vocabulary. The embedding and the norms run on upstream kernels. The
+// entry points, shapes and math are in zig/src/families/inkling2/cuda_head.zig.
+//
+// Math: Transformers' modeling_inkling2.py (Apache-2.0, Copyright 2026 the HuggingFace Team),
+// Inkling2ForCausalLM.forward: logits = lm_head(h) (bf16), .float(), Inkling2Softcap (tanh(x / 30) * 30, where
+// torch divides by a Python scalar as a product with fp32(1 / 30)), then the first unpadded_vocab_size columns.
+
+#include <cuda_bf16.h>
+#include <stdint.h>
+
+namespace tf_ink2_head {
+
+constexpr int WARPS = 8;
+constexpr int VEC = 8; // bf16 a 16-byte load
+
+__device__ __forceinline__ void unpack(const uint4& u, float* f) {
+    const __nv_bfloat162* h = reinterpret_cast<const __nv_bfloat162*>(&u);
+#pragma unroll
+    for (int i = 0; i < 4; ++i) {
+        const float2 t = __bfloat1622float2(h[i]);
+        f[2 * i] = t.x;
+        f[2 * i + 1] = t.y;
+    }
+}
+
+// out[r, n] = bf16(x[r] . w[n]) for a tile of RT rows: a warp an output column; lane l sums k = 8 l + 256 j in
+// order, then the fixed xor tree (dense_rows.cu's order), so a row's bits do not depend on RT or the row count.
+template <int RT>
+__device__ __forceinline__ void tile(const __nv_bfloat16* __restrict__ x, int64_t x_stride,
+                                     const __nv_bfloat16* __restrict__ w, __nv_bfloat16* __restrict__ out,
+                                     int64_t out_stride, int rows, int n, int k) {
+    const int lane = threadIdx.x & 31;
+    const int col = blockIdx.x * WARPS + (threadIdx.x >> 5);
+    const int r0 = blockIdx.y * RT;
+    if (col >= n) return;
+    float acc[RT];
+#pragma unroll
+    for (int r = 0; r < RT; ++r) acc[r] = 0.f;
+    const __nv_bfloat16* wr = w + static_cast<int64_t>(col) * k;
+#pragma unroll 4
+    for (int k0 = lane * VEC; k0 < k; k0 += 32 * VEC) {
+        float wf[VEC];
+        unpack(*reinterpret_cast<const uint4*>(wr + k0), wf);
+#pragma unroll
+        for (int r = 0; r < RT; ++r) {
+            if (r0 + r >= rows) break;
+            float xf[VEC];
+            unpack(*reinterpret_cast<const uint4*>(x + (r0 + r) * x_stride + k0), xf);
+#pragma unroll
+            for (int i = 0; i < VEC; ++i) acc[r] = __fmaf_rn(xf[i], wf[i], acc[r]);
+        }
+    }
+#pragma unroll
+    for (int r = 0; r < RT; ++r) {
+        float v = acc[r];
+        for (int m = 16; m > 0; m >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xFFFFFFFFu, v, m));
+        if (lane == 0 && r0 + r < rows) out[(r0 + r) * out_stride + col] = __float2bfloat16_rn(v);
+    }
+}
+
+}  // namespace tf_ink2_head
+
+using namespace tf_ink2_head;
+
+// The module's presence check (cuda_kernels.zig Group): writes the group's number.
+extern "C" __global__ void tf_ink2_head_probe(int* out) {
+    if (out != nullptr && threadIdx.x == 0 && blockIdx.x == 0) *out = 5;
+}
+
+// The unembed: out [rows, n] bf16 = x [rows, k] bf16 . w [n, k]^T. Grid (ceil(n / WARPS), ceil(rows / RT)),
+// WARPS * 32 threads; k % 8 == 0, x and w 16-byte aligned, strides in elements.
+#define TF_INK2_UNEMBED(RT)                                                                                            \
+    extern "C" __global__ void __launch_bounds__(WARPS * 32) tf_ink2_head_unembed_##RT(                               \
+        const __nv_bfloat16* x, long long x_stride, const __nv_bfloat16* w, __nv_bfloat16* out, long long out_stride, \
+        int rows, int n, int k) {                                                                                      \
+        tile<RT>(x, x_stride, w, out, out_stride, rows, n, k);                                                         \
+    }
+
+TF_INK2_UNEMBED(1)
+TF_INK2_UNEMBED(4)
+TF_INK2_UNEMBED(16)
+TF_INK2_UNEMBED(32)
+
+namespace tf_ink2_head {
+
+// The wide form of `tile`: a warp computes C output columns, so each load of x serves C weight rows, for RT rows a
+// tile; the grid is 1D with a column block's row tiles adjacent (row tile fastest), so the block's weight rows come
+// from memory once and from L2 for its other tiles. Every (row, column) is `tile`'s sum in `tile`'s order (lane l: k =
+// 8 l + 256 j, x * w fused, then the same xor tree, a bf16 store), so the output is tf_ink2_head_unembed_<RT>'s, bit
+// for bit, at any row count.
+template <int RT, int C>
+__device__ __forceinline__ void wide(const __nv_bfloat16* __restrict__ x, int64_t x_stride,
+                                     const __nv_bfloat16* __restrict__ w, __nv_bfloat16* __restrict__ out,
+                                     int64_t out_stride, int rows, int n, int k, int ny) {
+    const int lane = threadIdx.x & 31;
+    const int bx = blockIdx.x / ny;
+    const int r0 = (blockIdx.x % ny) * RT;
+    const int c0 = (bx * WARPS + (threadIdx.x >> 5)) * C;
+    if (c0 >= n) return;
+    float acc[C][RT];
+#pragma unroll
+    for (int c = 0; c < C; ++c)
+#pragma unroll
+        for (int r = 0; r < RT; ++r) acc[c][r] = 0.f;
+    const __nv_bfloat16* wr[C];
+#pragma unroll
+    for (int c = 0; c < C; ++c) wr[c] = w + static_cast<int64_t>(min(c0 + c, n - 1)) * k; // past n: column n - 1, not stored
+#pragma unroll 2
+    for (int k0 = lane * VEC; k0 < k; k0 += 32 * VEC) {
+        float wf[C][VEC];
+#pragma unroll
+        for (int c = 0; c < C; ++c) unpack(*reinterpret_cast<const uint4*>(wr[c] + k0), wf[c]);
+#pragma unroll
+        for (int r = 0; r < RT; ++r) {
+            if (r0 + r >= rows) break;
+            float xf[VEC];
+            unpack(*reinterpret_cast<const uint4*>(x + (r0 + r) * x_stride + k0), xf);
+#pragma unroll
+            for (int c = 0; c < C; ++c)
+#pragma unroll
+                for (int i = 0; i < VEC; ++i) acc[c][r] = __fmaf_rn(xf[i], wf[c][i], acc[c][r]);
+        }
+    }
+#pragma unroll
+    for (int c = 0; c < C; ++c)
+#pragma unroll
+        for (int r = 0; r < RT; ++r) {
+            float v = acc[c][r];
+            for (int m = 16; m > 0; m >>= 1) v = __fadd_rn(v, __shfl_xor_sync(0xFFFFFFFFu, v, m));
+            if (lane == 0 && r0 + r < rows && c0 + c < n) out[(r0 + r) * out_stride + c0 + c] = __float2bfloat16_rn(v);
+        }
+}
+
+}  // namespace tf_ink2_head
+
+// The wide unembed (cuda_head.zig unembedWide): the same output as tf_ink2_head_unembed_<RT>. Grid ceil(n / (WARPS * C))
+// * ny blocks (ny = ceil(rows / RT)), WARPS * 32 threads; k % 8 == 0, x and w 16-byte aligned, strides in elements.
+#define TF_INK2_UNEMBED_WIDE(RT, C)                                                                                    \
+    extern "C" __global__ void __launch_bounds__(WARPS * 32) tf_ink2_head_unembed_w##RT##x##C(                        \
+        const __nv_bfloat16* x, long long x_stride, const __nv_bfloat16* w, __nv_bfloat16* out, long long out_stride, \
+        int rows, int n, int k, int ny) {                                                                              \
+        wide<RT, C>(x, x_stride, w, out, out_stride, rows, n, k, ny);                                                  \
+    }
+
+TF_INK2_UNEMBED_WIDE(16, 2)
+TF_INK2_UNEMBED_WIDE(8, 4)
+TF_INK2_UNEMBED_WIDE(14, 4)
+
+// out[r, c] fp32 = tanh(f32(l[r, c]) * fp32(1 / cap)) * cap for c < cols. Grid (ceil(cols / 256), rows), 256 threads.
+extern "C" __global__ void tf_ink2_head_softcap(const __nv_bfloat16* __restrict__ l, long long l_stride,
+                                                float* __restrict__ out, long long out_stride, int cols, float cap) {
+    const int c = blockIdx.x * blockDim.x + threadIdx.x;
+    if (c >= cols) return;
+    const int64_t r = blockIdx.y;
+    const float inv = __fdiv_rn(1.0f, cap);
+    const float x = __bfloat162float(l[r * l_stride + c]);
+    out[r * out_stride + c] = __fmul_rn(tanhf(__fmul_rn(x, inv)), cap);
+}
+
+// Greedy rows on the device (B2 C4): out[r] = lanes/gpu_rule.zig argmax of row r of x [rows, cols] fp32, the first
+// index of the largest value as the host's loop finds it (`best = 0; if (v > row[best]) best = i`): a NaN at column 0
+// wins (nothing compares greater), a NaN elsewhere never does, -0 equals +0 (the first wins), all -inf gives 0. Each
+// thread keeps the first index of its columns' largest non-NaN value; the block reduces (value, index) pairs by
+// "greater value, else lower index", which is that loop's answer whatever the order. Grid rows, 1024 threads.
+extern "C" __global__ void __launch_bounds__(1024) tf_ink2_head_argmax(const float* __restrict__ x, long long stride,
+                                                                       int cols, unsigned* __restrict__ out) {
+    const float* row = x + (int64_t)blockIdx.x * stride;
+    float bv = -__int_as_float(0x7f800000); // -inf
+    int bi = 0x7fffffff;
+    for (int c = threadIdx.x; c < cols; c += blockDim.x) {
+        const float v = row[c];
+        if (v > bv || (v == bv && c < bi)) { // a NaN takes neither branch
+            bv = v;
+            bi = c;
+        }
+    }
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        const float ov = __shfl_down_sync(0xffffffffu, bv, o);
+        const int oi = __shfl_down_sync(0xffffffffu, bi, o);
+        if (ov > bv || (ov == bv && oi < bi)) {
+            bv = ov;
+            bi = oi;
+        }
+    }
+    __shared__ float sv[32];
+    __shared__ int si[32];
+    const int warp = threadIdx.x >> 5, lane = threadIdx.x & 31;
+    if (lane == 0) {
+        sv[warp] = bv;
+        si[warp] = bi;
+    }
+    __syncthreads();
+    if (warp != 0) return;
+    const int nw = (blockDim.x + 31) >> 5;
+    bv = lane < nw ? sv[lane] : -__int_as_float(0x7f800000);
+    bi = lane < nw ? si[lane] : 0x7fffffff;
+#pragma unroll
+    for (int o = 16; o > 0; o >>= 1) {
+        const float ov = __shfl_down_sync(0xffffffffu, bv, o);
+        const int oi = __shfl_down_sync(0xffffffffu, bi, o);
+        if (ov > bv || (ov == bv && oi < bi)) {
+            bv = ov;
+            bi = oi;
+        }
+    }
+    if (lane == 0) out[blockIdx.x] = (cols == 0 || row[0] != row[0] || bi == 0x7fffffff) ? 0u : (unsigned)bi;
+}
+
+// The embedding held by vocabulary rows over ranks (cuda_embed.zig; v0.1 kept it whole on rank 0). Both kernels copy
+// bits; the norm after them is the same kernel on the same rows. Grid (rows, ceil(d / 8 / 256)), 256 threads, 16 bytes
+// a thread (d % 8 == 0, every pointer 16-byte aligned).
+// share: out[r] = w[ids[r] - lo] when lo <= ids[r] < hi (the rank's rows of the table), else zeros.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_head_embed_share(const int* __restrict__ ids,
+                                                                           const __nv_bfloat16* __restrict__ w,
+                                                                           __nv_bfloat16* __restrict__ out, int d,
+                                                                           int lo, int hi) {
+    const int64_t r = blockIdx.x;
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (8 * c >= d) return;
+    const int id = ids[r];
+    uint4 v = make_uint4(0u, 0u, 0u, 0u);
+    if (id >= lo && id < hi) v = *reinterpret_cast<const uint4*>(w + static_cast<int64_t>(id - lo) * d + 8 * c);
+    *reinterpret_cast<uint4*>(out + r * d + 8 * c) = v;
+}
+
+// pick: out[r] = parts[owner(ids[r])][r] from the gathered slots parts [world][rows][d]: the owners are ranks first ..
+// first + owners - 1, each holding canon's share of the vocabulary (plan.zig canon: the first vocab % owners one row
+// more), so owner(id) = first + the share holding id.
+extern "C" __global__ void __launch_bounds__(256) tf_ink2_head_embed_pick(const int* __restrict__ ids,
+                                                                          const __nv_bfloat16* __restrict__ parts,
+                                                                          __nv_bfloat16* __restrict__ out, int d,
+                                                                          int rows, int first, int owners, int vocab) {
+    const int64_t r = blockIdx.x;
+    const int c = blockIdx.y * 256 + threadIdx.x;
+    if (8 * c >= d) return;
+    const int id = ids[r];
+    const int base = vocab / owners, extra = vocab % owners;
+    const int edge = extra * (base + 1);
+    int q = id < edge ? id / (base + 1) : extra + (id - edge) / base;
+    q = q < 0 ? 0 : (q >= owners ? owners - 1 : q);
+    const int64_t slot = static_cast<int64_t>(first + q) * rows + r;
+    *reinterpret_cast<uint4*>(out + r * d + 8 * c) = *reinterpret_cast<const uint4*>(parts + slot * d + 8 * c);
+}
